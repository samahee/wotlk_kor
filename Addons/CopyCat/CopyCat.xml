<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="CopyCat.lua"/>
	<Frame name="CopyCat_core" toplevel="true" enableMouse="true" movable="true" parent="UIParent" hidden="true">
		<Size>
			<AbsDimension x="500" y="45"/>
		</Size>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="5" right="5" top="5" bottom="5"/>
			</BackgroundInsets>
		</Backdrop>
		<Anchors>
			<Anchor point="CENTER">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Button name="CopyCatclose" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="CopyCat_core" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="1" y="1"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<EditBox name="CopyCatText">
				<Size>
					<AbsDimension x="490" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="2"/>
						</Offset>
					</Anchor>
				</Anchors>
				<FontString inherits="GameFontWhite"/>
				<Scripts>
					<OnEnterPressed>
						CopyCat_core:Hide();
					</OnEnterPressed>
					<OnEscapePressed>
						CopyCat_core:Hide();
					</OnEscapePressed>
				</Scripts>
			</EditBox>
		</Frames>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="CopyCatTitle" inherits="GameFontHighlight">
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="6" y="-5"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				CopyCat_OnLoad();
			</OnLoad>
			<OnDragStart>
				if(arg1 == "LeftButton" and IsShiftKeyDown()) then
					CopyCat_core:StartMoving();
				end
			</OnDragStart>
			<OnHide>
				CopyCat_core:StopMovingOrSizing();
			</OnHide>
			<OnDragStop>
				CopyCat_core:StopMovingOrSizing();
			</OnDragStop>
			<OnMouseUp>
				CopyCat_core:StopMovingOrSizing();
			</OnMouseUp>
		</Scripts>
	</Frame>
</Ui>
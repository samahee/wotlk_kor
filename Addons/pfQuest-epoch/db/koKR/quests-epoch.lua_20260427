  [26463] = {
    ["T"] = "방벽",
    ["O"] = "방벽에 있는 조나단 베레스포드와 대화하십시오.",
    ["D"] =
    "때가 왔소, $C $N. 당신은 끊임없이 자신이 진실과 정의의 수호자임을 증명해 왔소. 당신의 다음 시련이 방벽에 있는 조나단 베레스포드와 함께 기다리고 있소. 티리스팔 숲에서 동쪽으로 여행하면 결코 놓칠 수 없을 거요.",
  },
  [26464] = {
    ["T"] = "조나단의 임무",
    ["O"] = "하수인의 스컬지석 20개를 모아 브릴에 있는 메릴 웬딜에게 가져가십시오.",
    ["D"] =
    "역병지대 언데드가 지니고 다니는 스컬지석에는 힘이 담겨 있습니다. 시험의 첫 번째 단계로 이 돌들을 충분히 모아 브릴에 살고 있는 메릴 웬딜이라는 사제에게 가져가야 합니다.\n\n그리고 $n, 이 돌들을 찾으려면 반드시 은빛 여명회 위임장을 지니고 다녀야 한다는 걸 명심하세요. 가루쉬라는 오크가 맥박이 뛰는 사람은 물론이고, 우리처럼 심장이 멈춘 이들에게까지도 이걸 집어 던지고 있으니까요.",
  },
  [26465] = {
    ["T"] = "조나단의 임무",
    ["O"] = "방벽에 있는 조나단 베레스포드에게 비활성 스컬지석을 가져가십시오.",
    ["D"] =
    "돌들을 정화했습니다, $N. 이 작업은 엄청난 위험을 동반하지만, 브릴이라면 충분히 안전하다고 느껴지네요.\n\n이것들을 다시 존에게 가져가세요. 그를 잘 아는데, 분명 이 돌들로 할 수 있는 훨씬 대단한 계획을 염두에 두고 있을 겁니다.",

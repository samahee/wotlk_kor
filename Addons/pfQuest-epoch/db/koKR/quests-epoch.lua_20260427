    ["O"] =
    "막투르는 당신의 약초채집 숙련도를 사용해 미명엽수 20개를 모아 슬픔의 늪의 피난처에 있는 막투르에게 배달하길 원합니다.",
    ["D"] =
    "늪지대엔 많은 위험이 도사리고 있소. 우리 정찰병들도 아주 혹독하게 깨우치게 되었소만. 난 이곳 재규어들처럼 우리 병사들을 안개 속으로 자취를 감추게 해 줄 비약을 만들고 싶소.\n\n약초 다루는 데 솜씨가 있는 것 같군. 미명엽수 20개를 가져다주시오. 내가 비약을 완성하리라.",
  },
  [28528] = {
    ["T"] = "타베사의 의뢰",
    ["O"] =
    "자선단 밉시는 당신의 약초채집 숙련도를 사용해 카드가의 수염 20개를 모아 먼지진흙 습지대의 타베사의 농장에 있는 타베사에게 배달하길 원합니다.",
    ["D"] =
    "아, 정말 큰일 났어요. 저기 늪지대에 사는 마법사 -- 타베사가 -- 카드가의 수염을 요구했는데, 저에겐 하나도 없거든요. 빨리 가져다주지 않으면 그녀가 무슨 짓을 할지 몰라요. 절 두꺼비로 만들어버릴지도 모른다고요!\n\n카드가의 수염 20개를 타베사의 농장으로 가져다주실 수 있나요?",
  },
  [28529] = {
    ["T"] = "대마법사 앤자이럼 룬위버의 의뢰",
    ["O"] =
    "대마법사 앤자이럼 룬위버는 당신의 약초채집 숙련도를 사용해 겨울송곳풀 20개를 모아 알터랙 산맥의 달라란에 있는 대마법사 앤자이럼 룬위버에게 배달하길 원합니다.",
    ["D"] =
    "달라란의 폐허를 탐험하고 있다면 조심하게나, $C.\n\n건물들의 안전을 장담할 수 없으니... 오! 약초상이로군.\n\n나는 도시를 재건하기 위해 진행 중인 작업의 일부를 위해 겨울송곳풀이 필요하다네. 얼라이언스를 돕고 싶다면 내게 좀 가져다주게나.",
  },
  [28530] = {
    ["T"] = "인돈 클리프리치의 의뢰",
    ["O"] =
    "인돈 클리프리치는 당신의 약초채집 숙련도를 사용해 황금가시 20개를 모아 아라시 고원의 피난처에 있는 인돈 클리프리치에게 배달하길 원합니다.",
    ["D"] =
    "동부 내륙지에서 황금가시를 캐러 내려왔는데, 이 일대의 모든 평원을 순찰하는 듯한 랩터들에게 쫓기다 그만 발목을 삐고 말았소. 내가 고향으로 돌아갈 수 있게 내 임무를 마저 끝내주시겠소?",
  },
  [28531] = {
    ["T"] = "로간나스의 의뢰",
    ["O"] =
    "로간나스는 당신의 약초채집 숙련도를 사용해 아서스의 눈물 20개를 모아 페랄라스의 페더문 요새에 있는 로간나스에게 배달하길 원합니다.",
    ["D"] =
    "아서스의 눈물이라... 이토록 아름다운 꽃에 이렇게 슬픈 이름이 붙다니. 예전에는 스트라솔름 백합이라고 불렸지, 아나? 예전 로데론이었던 지역에서는 더 이상 이 꽃이 많이 자라지 않는다고 들었네.\n\n이 약초를 연구하고 싶어. 아서스의 눈물 20개를 가져오면 보상하겠네.",
  },
  [28532] = {
    ["T"] = "블리모 가젯스프링의 의뢰",
    ["O"] =
    "블리모 가젯스프링은 당신의 약초채집 숙련도를 사용해 꿈풀 20개를 모아 아즈샤라의 워블 할로우에 있는 블리모 가젯스프링에게 배달하길 원합니다.",
    ["D"] =
    "나는 3차 대전쟁 때 얼라이언스 군대와 함께 칼림도어로 건너온 몇 안 되는 노움 중 하나야. 우리 부대가 고향으로 돌아갈 때, 난 남았지. 그 악마들을 본 이후로 계속 나를 괴롭히는 생각들을 떨쳐버릴 수가 없어.\n\n여기 워블 할로우에 자리를 잡고 살 목적을 찾게 되어 감사하지만, 아직 내 꿈에는 뭔가가 더 필요해. 꿈풀이 효과적인 약이 될 수 있다고 들었어. 꿈풀... 그 이름부터 딱 들어맞지 않아?",
  },
  [28533] = {
    ["T"] = "글릭스 브루라이트의 의뢰",
    ["O"] =
    "글릭스 브루라이트는 당신의 약초채집 숙련도를 사용해 가시해조 20개를 모아 가시덤불 골짜기의 무법항에 있는 글릭스 브루라이트에게 배달하길 원합니다.",
    ["D"] =
    "이봐, $C. 당신도 짐작했겠지만, 해적으로 가득한 이 항구 마을에서는 수면 보행 물약이나 수중 호흡 물약이 날개 돋친 듯이 팔려나간다네. 불행히도 더 만들 가시해조가 완전히 바닥나 버렸어!\n\n손톱 밑의 흙을 보니 약초 다루는 데 꽤 능숙해 보이는데. 내게 가시해조를 가져다준다면 물약을 팔아 남긴 수익금과 물약 일부를 자네와 나누도록 하지.",
  },
  [28534] = {
    ["T"] = "호르니즈 브림버즐의 의뢰",
    ["O"] =
    "호르니즈 브림버즐은 당신의 약초채집 숙련도를 사용해 무덤이끼 20개를 모아 잊혀진 땅의 코도 무덤에 있는 호르니즈 브림버즐에게 배달하길 원합니다.",
    ["D"] =
    "퍼즐 좋아해, $C? 난 유령이나 무덤과 관련된 퍼즐을 아주 좋아하거든.\n\n이미 뼈의 계곡에 서식하는 켄타우로스 유령들에 대해 조사 중인데, 무덤이끼에 대해서도 더 자세히 알고 싶어. 왜 무덤이끼는 오직 무덤 주변에서만 자라는 걸까? 정말 알고 싶어 미치겠어!\n\n자네가 무덤이끼 한 뭉치만 가져다주면, 내가 이 미스터리를 풀 수 있을지도 몰라!",
  },
  [28535] = {
    ["T"] = "조아킴 스파크루트의 의뢰",
    ["O"] =
    "조아킴 스파크루트는 당신의 약초채집 숙련도를 사용해 보라연꽃 20개를 모아 황야의 땅의 스프링소켓에 있는 조아킴 스파크루트에게 배달하길 원합니다.",
    ["D"] =
    "여기 스프링소켓에 보라연꽃에 관한 갑작스러운 관심이 늘어났어. 대체 왜 그런지는 모르겠지만 나도 그 흐름에 동참하고 싶네.\n\n자네는 시간이 남아도는 약초상이군. 안 그랬으면 스프링소켓에 오지도 않았겠지. 그러니 나가서 보라연꽃을 모아 오라고. 그럼 우리 둘 다 이익을 볼 테니까.",
  },
  [28536] = {
    ["T"] = "연금술사 페슬저그의 의뢰",
    ["O"] =
    "연금술사 페슬저그는 당신의 약초채집 숙련도를 사용해 황금산삼 20개를 모아 타나리스의 가젯잔에 있는 연금술사 페슬저그에게 배달하길 원합니다.",
    ["D"] =
    "여기서 섬세하고 중요한 작업을 하고 있네, $C. 이 실리시드 녀석들은 위협적이라 필요하다면 분자 단위까지 분해해버릴 테야. 하지만 내 작업에 딱 맞는 강장제를 만들려면 황금산삼이 필요하다네. 자네가 나설 차례지!",
  },
  [28537] = {
    ["T"] = "타론 레드페더의 의뢰",
    ["O"] =
    "타론 레드페더는 당신의 약초채집 숙련도를 사용해 그롬의 피 20개를 모아 악령숲의 에메랄드 성소에 있는 타론 레드페더에게 배달하길 원합니다.",
    ["D"] =
    "악령숲의 타락 정도를 확인하는 또 다른 방법은 지역 식물 생태계를 관찰하는 것이오.\n\n불타는 군단과 호드가 이 숲을 지나간 이후에 자라기 시작했다는 소문이 도는 그롬의 피라는 약초가 있다오. 그것을 연구하기 위해 한 뭉치 구해다 주시오.",
  },
  [28538] = {
    ["T"] = "이자벨 픽맨의 의뢰",
    ["O"] =
    "이자벨 픽맨은 당신의 약초채집 숙련도를 사용해 유령버섯 20개를 모아 서부 역병지대의 카엘 다로우에 있는 이자벨 픽맨에게 배달하길 원합니다.",
    ["D"] =
    "유령버섯에 대해 들어본 적 있어? 최근 내가 재료의 범위를 약초까지 확대했는데, 이런 약초가 우리 스칼로맨스의 학생들에게 딱 맞을 것 같거든.\n\n어디서 자라는지는 전혀 모르겠지만, 시험 삼아 한가득 가져오면 후하게 쳐주지.",
  },
  [28539] = {
    ["T"] = "작업반장 스크랜지의 의뢰",
    ["O"] =
    "작업반장 스크랜지는 당신의 약초채집 숙련도를 사용해 화염초 20개를 모아 이글거리는 협곡의 토륨 거점에 있는 작업반장 스크랜지에게 배달하길 원합니다.",
    ["D"] =
    "일은 일이야, $C. 놀이가 아니라고. 자네한테 딱 맞는 따분한 일이 하나 있지.\n\n난 화염초가 필요해. 아주 많이 말이야. 당장 나가서 화염초를 뜯어와. 그리고 절대로 이 일을 즐기려 하지 마!",
  },
  [28540] = {
    ["T"] = "페트라 그로센의 의뢰",
    ["O"] =
    "페트라 그로센은 당신의 약초채집 숙련도를 사용해 태양풀 20개를 모아 운고로 분화구의 마샬의 야영지에 있는 페트라 그로센에게 배달하길 원합니다.",
    ["D"] =
    "다단가는 훌륭한 짐꾼 코도라오. 가젯잔에서부터 우리 보급품을 몽땅 실어 나르며 굶주린 랩터들을 쫓아내 주기도 했지. 이 녀석의 노고에 보상을 해주고 싶소만.\n\n다단가는 태양풀을 좋아하는데 나는 약초상이 아니오. 혹시 날 좀 도와주겠소?",
  },
  [28541] = {
    ["T"] = "제이스 파레인의 의뢰",
    ["O"] =
    "제이스 파레인은 당신의 약초채집 숙련도를 사용해 역병꽃 20개를 모아 동부 역병지대의 희망의 빛 예배당에 있는 제이스 파레인에게 배달하길 원합니다.",
    ["D"] =
    "스컬지의 재앙 이후 이 역병지대에서 자라는 새로운 약초에 대해 들은 바가 있다. 그 이름도 아주 적절하게 역병꽃이라고 불리더군.\n\n이 변형된 약초를 연구하고 싶다네. 나를 위해 좀 구해다 주겠나? 난 희망의 빛 예배당에서 멀리 떨어질 수 없지만, 넌 충분히 강해 보이니까.",
  },
  [28542] = {
    ["T"] = "두라의 의뢰",
    ["O"] =
    "미시키는 당신의 약초채집 숙련도를 사용해 평온꽃 20개를 모아 듀로타의 칼바위 언덕에 있는 두라에게 배달하길 원합니다.",
    ["D"] =
    "수습 약초상이야? 성공할 능력이 있는지 증명해 볼 테야? 기초부터 시작하자. 평온꽃 20개를 채집해서 칼바위 언덕에 있는 두라에게 가져가. 네가 대충 얼버무리면 그 녀석이 바로 알아차릴 거야.",
  },
  [28543] = {
    ["T"] = "크레이의 의뢰",
    ["O"] =
    "루울 이글탈론은 당신의 약초채집 숙련도를 사용해 은엽수 20개를 모아 멀고어의 썬더 블러프에 있는 크레이에게 배달하길 원합니다.",
    ["D"] =
    "내 조카 크레이는 썬더 블러프에서 연금술 수습생으로 일하고 있지. 아내에게 또 은엽수가 부족하다는 전갈을 보냈소.\n\n녀석이 학업을 진지하게 받아들이지 않는 건 걱정되지만 녀석이 실패하는 꼴은 보고 싶지 않구려. 은엽수 20개를 캐서 그 녀석에게 갖다주겠소? 당신이 약초를 가져가면, 그런 친절은 세상에 흔치 않다는 걸 그 애도 이해하게 될 거요.",
  },
  [28544] = {
    ["T"] = "콘스턴스 브리스부아즈의 의뢰",
    ["O"] =
    "파루자는 당신의 약초채집 숙련도를 사용해 뱀뿌리 20개를 모아 티리스팔 숲의 버려진 장원에 있는 콘스턴스 브리스부아즈에게 배달하길 원합니다.",
    ["D"] =
    "저기 버려진 장원에 있는 잘난 척하는 \"의류상\" 콘스턴스가 무슨 \"친환경 패션\" 따위의 헛소리를 작업 중이래. 대체 무슨 소리인지.\n\n어쨌든 그 여자가 뱀뿌리 20개를 구해 달래. 그녀가 또 이끼를 엮어 숄을 짜기 시작하기 전에 얼른 가져다 줘.\n\n\"유행을 선도하는 부패\" 따위의 말이 유행하는 일은 없길 바라.",
  },
  [28545] = {
    ["T"] = "레오 사른의 의뢰",
    ["O"] =
    "연금술사 렌퍼럴은 당신의 약초채집 숙련도를 사용해 마법꽃 20개를 모아 은빛소나무 숲의 언덕마루로 향하는 도로 남쪽에 있는 레오 사른의 야영지로 배달하길 원합니다.",
    ["D"] =
    "무릎에 묻은 풀물을 보아하니 네 녀석은 약초상이로군. 난 사람들이 연금술사와 약초상을 헷갈리는 것도 이해 안 가지만, 더군다나 내가 자기들의 사소한 약초 심부름을 들어줄 시간이 있다고 생각하는 건지 모르겠어. 다행히도 넌 시간과 실력이 다 있어 보이는군.\n\n그 마법부여사에게 마법꽃 20개를 가져다줘 -- 레오 사른이었나, 아무튼 녀석은 언데드 야영지 남쪽 언덕마루로 향하는 도로 근처에 진을 치고 있지.",
  },
  [28546] = {
    ["T"] = "메보크 미지릭스의 의뢰",
    ["O"] =
    "훌라마히는 당신의 약초채집 숙련도를 사용해 찔레가시 20개를 모아 불모의 땅의 톱니항에 있는 메보크 미지릭스에게 배달하길 원합니다.",
    ["D"] =
    "아, 약초상이군! 메보크 미지릭스라는 이상한 고블린이 내게 찔레가시를 구해 달라고 요청했지. 난 신선한 약초가 다 떨어졌고, 다시 그 녀석의 \"긴급한\" 목소리를 상대하긴 싫어.\n\n제발, 찔레가시 20개를 톱니항에 있는 그 녀석에게 갖다주고 내 골칫거리 좀 덜어주게나.",
  },
  [28547] = {
    ["T"] = "도안 카르한의 의뢰",
    ["O"] =
    "도안 카르한은 당신의 약초채집 숙련도를 사용해 찔레가시 20개를 모아 불모의 땅 남쪽 황금길 동쪽의 도안 카르한의 야영지에 배달하길 원합니다.",
    ["D"] =
    "안녕하신가, $R. 나는 평화로운 연구를 위해 불모의 땅에 왔지만, 이곳 마을 사람들은 내게 물건을 파는 것을 경계하고 있소. 물론 이해는 되오만. 실험의 다음 단계를 위해 찔레가시가 필요하오. 식물을 다루는 솜씨가 있어 보이니 당신의 도움을 구하겠소. 물론 대가는 지불하리다.",
  },
  [28548] = {
    ["T"] = "제네우 생크리의 의뢰",
    ["O"] =
    "제네우 생크리는 당신의 약초채집 숙련도를 사용해 생명의 뿌리 20개를 모아 잿빛 골짜기의 조람가르 전초기지에 있는 제네우 생크리에게 배달하길 원합니다.",
    ["D"] =
    "이곳 황혼의 망치단의 활동은 자연의 균형을 어지럽혔고, 정령들을 노예로 삼았으며, 대지의 영혼을 타락시켰소.\n\n나는 정령들에게 공물을 바쳐야 하오. 그러려면 생명의 뿌리 20개가 필요하오. 정령들이 우리 모두에게 등을 돌리기 전에 조람가르 전초기지는 보상을 치러야만 하오.",
  },
  [28549] = {
    ["T"] = "젠질라의 의뢰",
    ["O"] =
    "젠질라는 당신의 약초채집 숙련도를 사용해 야생 철쭉 20개를 모아 돌발톱 산맥의 말라카진에 있는 젠질라에게 배달하길 원합니다.",
    ["D"] =
    "돌발톱 산맥의 거미 이빨은 깊이 파고들고, 그 독침은 지독한 잔여물을 남기지.\n\n야생 철쭉을 우려낸 특제 치료제만이 독을 빼낼 수 있는데 보급품이 바닥을 보이고 있어. 자네가 도울 수 있어! 더 많은 이가 쓰러지기 전에 말라카진으로 야생 철쭉 20개를 가져오게나.",
  },
  [28550] = {
    ["T"] = "아라네 베넘블러드의 의뢰",
    ["O"] =
    "아라네 베넘블러드는 당신의 약초채집 숙련도를 사용해 생명의 뿌리 20개를 모아 힐스브래드 구릉지의 타렌 제분소에 있는 아라네 베넘블러드에게 배달하길 원합니다.",
    ["D"] =
    "연금술사 라이던이 죽음에 집착하는 동안, 난 생명이 훨씬 더... 흥미롭다는 걸 발견했지. 특히 이 모습 덕분에 가능할지도 모를 다른 형태의 생명이 말이야.\n\n섬세한 실험을 위해 생명의 뿌리 20개가 필요해. 부활에 관한 실험이지... 거미로서의 부활! 타렌 제분소의 내게로 약초를 가져오라고.",
  },
  [28551] = {
    ["T"] = "하가르 라이트닝후프의 의뢰",
    ["O"] =
    "용사 문혼은 당신의 약초채집 숙련도를 사용해 왕꽃잎풀 20개를 모아 버섯구름 봉우리의 높새바람 봉우리에 있는 하가르 라이트닝후프에게 배달하길 원합니다.",
    ["D"] =
    "반갑소, $N. 약초상 같아 보이는데. 부탁을 하나 하겠소.\n\n높새바람 봉우리에 있는 내 친구 하가르에게 왕꽃잎풀이 필요하오. 이유는 묻지 마시오, 그저 아주 급박해 보였을 뿐.\n\n왕꽃잎풀 20개를 채집해 그에게 가져다주시오. 그 녀석이 알아서 잘 쓸 거요.",
  },
  [28552] = {
    ["T"] = "로그바의 의뢰",
    ["O"] =
    "로그바는 당신의 약초채집 숙련도를 사용해 미명엽수 20개를 모아 슬픔의 늪의 스토나드에 있는 로그바에게 배달하길 원합니다.",
    ["D"] =
    "늪지대엔 많은 위험이 도사리고 있소. 우리 정찰병들도 아주 혹독하게 깨우치게 되었소만. 난 이곳 재규어들처럼 우리 병사들을 안개 속으로 자취를 감추게 해 줄 비약을 만들고 싶소.\n\n약초 다루는 데 솜씨가 있는 것 같군. 미명엽수 20개를 가져다주시오. 내가 비약을 완성하리라.",
  },
  [28553] = {
    ["T"] = "타베사의 의뢰",
    ["O"] =
    "발라이 로크웨인은 당신의 약초채집 숙련도를 사용해 카드가의 수염 20개를 모아 먼지진흙 습지대의 타베사의 농장에 있는 타베사에게 배달하길 원합니다.",
    ["D"] =
    "이봐, 저 늪지대의 마녀 -- 타베사가 -- 자기 솥에 넣고 끓일 카드가의 수염을 원하고 있어. 빨리 가져다주지 않으면 그녀가 무슨 짓을 할지 몰라. 절 두꺼비로 만들어버릴지도 모른다고!\n\n내가 개구리가 되기 전에... 카드가의 수염 20개를 타베사의 농장에 있는 그녀에게 갖다주지 않겠나?",
  },
  [28554] = {
    ["T"] = "브로킨의 의뢰",
    ["O"] =
    "브로킨은 당신의 약초채집 숙련도를 사용해 겨울송곳풀 20개를 모아 알터랙 산맥의 알터랙 폐허에 있는 브로킨에게 배달하길 원합니다.",
    ["D"] =
    "이봐, $N. 시간 좀 있어?\n\n겨울송곳풀이 없으면 내 유명한 빙결의 기름을 만들 수 없는데, 근처 오우거들이 요새 부쩍 까불거리고 있거든. 겨울송곳풀 20개를 가져다줄 모험심 강한 사람이 필요한데. 그게 바로 댁인가?",
  },
  [28555] = {
    ["T"] = "토건의 의뢰",
    ["O"] =
    "토건은 당신의 약초채집 숙련도를 사용해 황금가시 20개를 모아 아라시 고원의 망치 주둔지에 있는 토건에게 배달하길 원합니다.",
    ["D"] =
    "이 오래된 감옥에 머무는 자들의 영혼을 달래주기 위해 해야 할 일이 많다오. 나의 주술적 의식에는 많은 것이 필요하지. 때로는 피와 이빨이, 때로는 향으로 태울 적절한 약초가 말이오.\n\n다음 의식을 치르려면 황금가시 20개가 필요하오. 그것만 있다면 이 지역에 거주하는 대지와 불의 혼란스러운 정령들을 집중시킬 수 있소.",
  },
  [28556] = {
    ["T"] = "루우의 의뢰",
    ["O"] =
    "루우는 당신의 약초채집 숙련도를 사용해 아서스의 눈물 20개를 모아 페랄라스의 모자케 야영지에 있는 루우에게 배달하길 원합니다.",
    ["D"] =
    "아서스의 눈물이라... 이토록 아름다운 꽃에 이렇게 슬픈 이름이 붙다니. 예전에는 스트라솔름 백합이라고 불렸지, 아나? 예전 로데론이었던 지역에서는 더 이상 이 꽃이 많이 자라지 않는다고 들었네.\n\n이 약초를 연구하고 싶어. 아서스의 눈물 20개를 가져오면 보상하겠네.",
  },
  [28557] = {
    ["T"] = "수습생 윈터의 의뢰",
    ["O"] =
    "수습생 윈터는 당신의 약초채집 숙련도를 사용해 꿈풀 20개를 모아 아즈샤라의 발로르모크에 있는 수습생 윈터에게 배달하길 원합니다.",
    ["D"] =
    "꿈풀... 누군가에겐 무해한 약초일 뿐이지만, 난 잠재력을 보지 -- 훨씬 더 대단한 잠재력을 말이야.\n\n정신에 미치는 효과가 아주... 장래가 밝아 보이더군. 꿈풀 20개를 가져오면 새로운 전염... 아니, 물약 조제를 시작할 수 있을 거야.",
  },
  [28558] = {
    ["T"] = "랠릭 핀의 의뢰",
    ["O"] =
    "아델레 필더는 당신의 가죽세공 숙련도를 사용해 가벼운 가죽 화살통 1개를 만들어 엘윈 숲의 동쪽계곡 벌목지에 있는 랠릭 핀에게 배달하길 원합니다.",
    ["D"] =
    "장차 훌륭한 가죽세공인이 되실 분이군? 주문 몇 개 처리하는 것 좀 도와주겠어?\n\n동쪽계곡 벌목지의 랠릭 핀이 새 화살통을 주문했어. 예전 화살통은 다 떨어져서 화살이 솔기를 뚫고 튀어나온다더군. 그거 꽤 위험하지.\n\n초보자가 맡기에 딱 좋은 일이야. 가벼운 가죽 화살통을 하나 만들어 벌목지에 있는 그에게 전달해 줘. 연습도 하고 봉사도 한다고 생각하라고.",
  },
  [28559] = {
    ["T"] = "토미 조 스톤필드의 의뢰",
    ["O"] =
    "아델레 필더는 당신의 가죽세공 숙련도를 사용해 손바느질한 가죽 바지 2개를 만들어 엘윈 숲의 스톤필드 부인 농장에 있는 토미 조 스톤필드에게 배달하길 원합니다.",
    ["D"] =
    "관심 있다면, 여기 하나 더 있어. 토미 조가 정체불명의 소녀에게 푹 빠져서 \"단정해\" 보일 수 있는 옷을 찾고 있거든.\n\n가죽세공 숙련도를 올리고 싶다면, 이 핑계로 손바느질한 가죽 바지 몇 개 만들어봐. 스톤필드 부인 농장에 있는 그에게 가져다줘. 제대로 차려입으면 그가 뭔가 결심하는 데 도움이 될지도 모르지.",
  },
  [28560] = {
    ["T"] = "오르고른 스트롱브로우의 의뢰",
    ["O"] =
    "그레타 파인스핀들은 당신의 가죽세공 숙련도를 사용해 돋을새김 가죽 조끼 2개를 만들어 던 모로의 남쪽 관문 초소에 있는 오르고른 스트롱브로우에게 배달하길 원합니다.",
    ["D"] =
    "같은 수습생이지? 이 밀린 주문들 처리하는 것 좀 도와주지 않을래?\n\n오르고른이 웃통을 벗은 채 남쪽 관문 초소를 순찰하고 있대. 자기는 \"바람과 레슬링을 하다가 잃어버렸다\"고 하지만. 참 나.\n\n가죽세공을 연마 중이라면, 그를 위해 돋을새김 가죽 조끼 두어 벌 만들어줘. 그가 인정하려 들진 않겠지만, 산 공기가 결코 따뜻한 건 아니거든.",
  },
  [28561] = {
    ["T"] = "그리프 와일드하트의 의뢰",
    ["O"] =
    "그레타 파인스핀들은 당신의 가죽세공 숙련도를 사용해 작은 가죽 탄약 주머니 2개를 만들어 던 모로의 카라노스에 있는 그리프 와일드하트에게 배달하길 원합니다.",
    ["D"] =
    "이건 자네가 맡아줬으면 좋겠어. 그리프 와일드하트가 훈련에 쓸 탄약과 인내심이 거의 바닥을 드러내고 있다더군. 탄약 주머니가 너무 낡아서 눈밭에 화약을 줄줄 흘리고 다닌다지 뭐야.\n\n가죽세공 숙련도를 올릴 생각이 있다면, 작은 가죽 탄약 주머니 두 개를 만들어서 카라노스에 있는 그에게 전달해 줘. 그는 요긴하게 쓸 거야. 그리고 수습 사냥꾼들에게 으르렁거리는 것도 좀 멈추겠지.",
  },
  [28562] = {
    ["T"] = "지나 피더보우의 의뢰",
    ["O"] =
    "나디야 메인위버는 당신의 가죽세공 숙련도를 사용해 튼튼한 가죽 바지 2개를 만들어 텔드랏실의 돌라나르에 있는 지나 피더보우에게 배달하길 원합니다.",
    ["D"] =
    "아, 가죽세공 수습생이로군. 내 공방에 온 걸 환영하네. 네 기술을 연습하러 온 거라면 내가 도와주지.\n\n초보자에게 딱 맞는 간단한 일거리들이 몇 개 있네. 돌라나르의 지나 피더보우는 텔드랏실 깊은 숲에서 훈련을 받고 있지. 그녀가 심하게 움직인 탓에 바지에 구멍이 여러 개 나서 새것이 필요하다더군. 튼튼한 가죽 바지 두 벌을 만들어서 그녀에게 전해주면 도움이 될 게야.",
  },
  [28563] = {
    ["T"] = "수석고고학자 그레이위스커의 의뢰",
    ["O"] =
    "나디야 메인위버는 당신의 가죽세공 숙련도를 사용해 손바느질한 가죽 허리띠 1개를 만들어 텔드랏실의 다르나서스에 있는 달의 신전에 있는 수석고고학자 그레이위스커에게 배달하길 원합니다.",
    ["D"] =
    "나는 다르나서스에 갈 일이 별로 없네만, 네가 도시로 기꺼이 간다면 네가 처리하기 완벽한 주문서가 하나 더 있지.\n\n여기 방문한 드워프가 메네실 항구에서 여기까지 오느라 허리띠가 다 망가졌다는 메모를 보냈네. 그를 위해 손바느질한 가죽 허리띠를 만들어 수석고고학자 그레이위스커에게 전달해 주게. 달의 신전에 가면 그를 찾을 수 있을 게야.",
  },
  [28564] = {
    ["T"] = "정찰병 갈리안의 의뢰",
    ["O"] =
    "민병대원 가리엘은 당신의 가죽세공 숙련도를 사용해 검은 가죽 장화 2개를 만들어 서부 몰락지대의 감시의 언덕에 있는 정찰병 갈리안에게 배달하길 원합니다.",
    ["D"] =
    "나는 민병대의 보급 장교인데, 가죽세공인이 필요하다. 당신 맞지?\n\n정찰병 갈리안이 밤낮으로 감시의 언덕을 순찰하느라 부츠가 솔기부터 해지고 있다. 교체품을 요청하려 해 -- 질기고, 소리가 나지 않고, 장시간 걷기에 좋은 걸로 말이야.\n\n가죽세공 실력이 좀 늘었다면, 검은 가죽 장화 두 켤레를 만들어서 그에게 전해주게.",
  },
  [28565] = {
    ["T"] = "민병대원 에반젤린의 의뢰",
    ["O"] =
    "민병대원 가리엘은 당신의 가죽세공 숙련도를 사용해 고급 가죽 망토 1개를 만들어 서부 몰락지대 남쪽 도로 순찰 중인 민병대원 에반젤린에게 배달하길 원합니다.",
    ["D"] =
    "민병대원 에반젤린은 밤낮으로 남쪽 길을 순찰하는데, 단검 언덕에서 불어오는 바람은 데피아즈단의 칼날처럼 매섭지. 난 그녀에게 지급할 제대로 된 망토를 원한다. 튼튼하고, 날씨에 잘 견디고, 위엄 있는 것으로.\n\n가죽세공 작업을 하고 있다면, 고급 가죽 망토를 만들어 그녀에게 가져다줘. 그녀는 편안함을 요구하진 않겠지만, 충분히 그럴 자격이 있으니까.",
  },
  [28566] = {
    ["T"] = "케를로니안 에버셰이드의 의뢰",
    ["O"] =
    "마브라린은 당신의 가죽세공 숙련도를 사용해 일반 방어구 키트 5개를 만들어 어둠해안의 고대정령의 숲에 있는 케를로니안 에버셰이드에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공인이세요? 오, 엘룬이시여 감사합니다! 숲이 이렇게 위험한 탓에 밀린 주문을 처리하느라 눈코 뜰 새가 없었어요.\n\n케를로니안 에버셰이드는 깨어 있는 상태와 수면 사이를 헤매지만, 무아지경 상태에서도 숲을 방어할 의무가 있죠. 그가 사용하는 가죽 방어구는 닳을 대로 닳아 얇아졌어요. 정작 본인은 꿈속이라 모를지언정, 꿈에서 깨어나면 신경 쓸 거예요.\n\n일반 방어구 키트 5개를 만들어서 그에게 배달해 주실래요? 도착했을 때 그가 잠들어 있을지도 모르지만, 조용히 돕는 것도 결국 돕는 거니까요.",
  },
  [28567] = {
    ["T"] = "그웨니스 블리레곤드의 의뢰",
    ["O"] =
    "마브라린은 당신의 가죽세공 숙련도를 사용해 고급 가죽 튜닉 1개를 만들어 어둠해안의 아우버다인에 있는 그웨니스 블리레곤드에게 배달하길 원합니다.",
    ["D"] =
    "가장 시급한 주문은 아닐지 몰라도, 가장 친절한 주문 중 하나일 거예요.\n\n그웨니스는 아우버다인에서 드루이드의 선적 물품과 보급 기록을 조정하는 걸 돕고 있는데, 지난 계절부터 너덜너덜해진 튜닉을 쭉 입고 있어요. 이젠 좀 더 튼튼하고 편안한 옷을 입을 때가 된 것 같아요.\n\n그녀를 위해 고급 가죽 튜닉 한 벌을 만들어서 전해주시겠어요? 시내의 비행장에 가면 그녀를 찾을 수 있을 거예요.",
  },
  [28568] = {
    ["T"] = "산악경비대 오즈모크의 의뢰",
    ["O"] =
    "카트 샘프슨은 당신의 가죽세공 숙련도를 사용해 가벼운 가죽 바지 2개를 만들어 모단 호수의 텔사마에 있는 산악경비대 오즈모크에게 배달하길 원합니다.",
    ["D"] =
    "오, 가죽세공을 배운 사람이군. 마을에 있는 동안 선행 좀 해볼 텐가? 산악경비대 오즈모크가 강풍 한 번 불면 다 찢어질 듯한 바지를 입고 바위와 눈밭 위를 기어오르고 있어. 순찰 나갈 때마다 그를 치료하는 것도 이젠 지긋지긋하다네.\n\n가죽세공 기술을 올리고 싶다면, 가벼운 가죽 바지 두 벌을 만들어서 텔사마에 있는 그에게 배달해 줘. 그는 불평할지도 모르지만, 거절하진 않을 거야.",
  },
  [28569] = {
    ["T"] = "선임기술자 힌더바이르 7세의 의뢰",
    ["O"] =
    "카트 샘프슨은 당신의 가죽세공 숙련도를 사용해 고급 가죽 허리띠 1개를 만들어 모단 호수의 돌다지 댐에 있는 선임기술자 힌더바이르 7세에게 배달하길 원합니다.",
    ["D"] =
    "선임기술자 힌더바이르가 자꾸 연장을 잃어버리고 있네. 농담이 아냐. 내 말은, 지난주에 그의 허리띠가 툭 끊어지는 바람에 렌치가 댐 위로 떨어져서, 반경 내에 그 소리가 다 울려 퍼졌다니까. 난 댐이 무너지는 줄 알았어!\n\n그가 고급 가죽 허리띠를 만들어 돌다지 댐으로 배달해 달라고 요청했지. 네 가죽세공 실력을 발휘하고 싶다면, 이 일은 너의 시간을 투자할 가치가 있을 게야. 그리고 우리 모두의 안전을 위해서라도.",
  },
  [28570] = {
    ["T"] = "캘라 섀도스피어의 의뢰",
    ["O"] =
    "사냥꾼 캬나는 당신의 가죽세공 숙련도를 사용해 튼튼한 방어구 키트 5개를 만들어 돌발톱 산맥의 거미줄 길을 따라 있는 그녀의 야영지에 있는 캘라 섀도스피어에게 배달하길 원합니다.",
    ["D"] =
    "당신의 도움이 필요합니다, 가죽세공사. 보세요, 제 가장 친한 친구 캘라 섀도스피어가 거미줄 길에 배치되었는데, 그곳은 매일 매복과 맹독, 그리고 더 끔찍한 일들이 벌어지는 곳이죠. 그녀의 장비는 셀 수 없이 수리되었지만, 이제 더는 버티지 못할 겁니다.\n\n튼튼한 방어구 키트를 좀 만들어서 그녀에게 전해 주실 수 있나요? 당신의 시간을 빼앗고 싶진 않지만, 그녀는 그게 몹시 필요합니다.",
  },
  [28571] = {
    ["T"] = "라스의 의뢰",
    ["O"] =
    "라스는 당신의 가죽세공 숙련도를 사용해 무거운 화살통 1개를 만들어 그늘숲의 조용한 강변에 있는 자신의 야영지에 있는 라스에게 배달하길 원합니다.",
    ["D"] =
    "조용한 강변을 따라 늑대들을 추적해 왔지만, 까마귀 언덕 어딘가에서 화살통을 잃어버렸어. 지금쯤 갈가리 찢겨 나갔을 테니 새것이 필요해.\n\n가죽세공을 배웠나? 그렇다면 무거운 화살통 하나 만들어줄 수 있나. 튼튼한 놈으로, 긴 사냥을 마치고 돌아올 때까지 버틸 수 있도록 충분한 양의 화살을 넣을 수 있는 걸로.",
  },
  [28572] = {
    ["T"] = "파수꾼 마이트린의 의뢰",
    ["O"] =
    "하론 다크위브는 당신의 가죽세공 숙련도를 사용해 암흑 가죽 허리띠 2개를 만들어 잿빛 골짜기의 숲의 노래에 있는 파수꾼 마이트린에게 배달하길 원합니다.",
    ["D"] =
    "최근 아주 영광스러운 무용담을 들었소, $C. 악령불 언덕 밖에서 악마들이 남쪽에서 밀려올 때, 파수꾼 마이트린은 꿋꿋하게 그 자리를 지켰소만 대가는 치러야 했지. 그녀의 갑옷은 그을렸고, 허리띠는 완전히 찢겨 나갔소. 무기를 잃어버렸고... 그녀의 존엄성도, 무슨 말인지 알겠소?\n\n다음 전투에 임하기 전에 다시 장비를 갖춰야 할 거요. 당신의 가죽세공 솜씨가 충분하다면 암흑 가죽 허리띠 몇 개를 만들어 숲의 노래에 있는 마이트린에게 전달해 주시오. 지체할 시간이 없소. 악마들이 계속 몰려오고 있다는군.",
  },
  [28573] = {
    ["T"] = "베르너 오스구드의 의뢰",
    ["O"] =
    "클라이드 랜덜은 당신의 가죽세공 숙련도를 사용해 강화된 가죽 장갑 1개를 만들어 붉은마루 산맥의 레이크샤이어에 있는 베르너 오스구드에게 배달하길 원합니다.",
    ["D"] =
    "베르너 오스구드는 수년 동안 레이크샤이어의 마구간에서 일하며, 스톰윈드의 왕이 우릴 전혀 신경 쓰지 않을 때 마을 사람들을 돌보았소. 그래서 내 가족이 이곳으로 온 거요 -- 오크가 쳐들어올 경우를 대비해서... 하지만 지역 정치 이야기로 당신을 지루하게 만들고 싶진 않군. 당신의 도움이 필요하오.\n\n당신에게 베르너를 위한 아주 특별한 강화된 가죽 장갑 한 켤레를 의뢰하고 싶소. 고삐 끄는 걸 정말 좋아하는 새 암망아지를 들였는데 낡은 장갑 때문에 물집이 잡힌다더군. 베르너가 계속 일할 수 있도록 돕는 것이 붉은마루의 모든 사람들을 위한 봉사라고 생각해 주시오.",
  },
  [28574] = {
    ["T"] = "아이나르 스톤그립의 의뢰",
    ["O"] =
    "제임스 할로란은 당신의 가죽세공 숙련도를 사용해 화살장이 장갑 1개를 만들어 저습지 녹색지대 남쪽 교차로에 있는 아이나르 스톤그립에게 배달하길 원합니다.",
    ["D"] =
    "자네가 생가죽을 다루는 걸 봤어. 가죽세공인이지? 자네에게 맡길 일이 있네.\n\n아이나르 스톤그립은 내 최고의 사냥꾼이야 -- 하지만 녀석의 장갑은 닳아서 떨어져 가고 있지. 감싼 손가락과 고집만으로 화살을 매기려는 꼴은 이제 지긋지긋해. 녀석은 절대 새 화살장이 장갑을 요구하지 않을 테니, 내가 대신 부탁하겠네.",
  },
  [28575] = {
    ["T"] = "파수꾼 마나르의 의뢰",
    ["O"] =
    "여관주인 핀미르는 당신의 가죽세공 숙련도를 사용해 녹색 가죽 팔보호구 6개를 만들어 슬픔의 늪의 피난처에 있는 파수꾼 마나르에게 배달하길 원합니다.",
    ["D"] =
    "우리 파수꾼들은 재규어와 악어, 정령들, 그리고 광포한 물고기들로부터 방어막을 형성하고 있소. 그런 생물들과 엮일 때 손목을 보호할 팔보호구가 필요하오. 당신은 가죽과 바늘을 다루는 솜씨가 있는 것 같군. 그들을 도와주시겠소?",
  },
  [28576] = {
    ["T"] = "비블리 푸츠버클의 의뢰",
    ["O"] =
    "자넷 호머스는 당신의 가죽세공 숙련도를 사용해 야만적인 어깨보호구 2개를 만들어 잊혀진 땅의 코르메크의 오두막에 있는 비블리 푸츠버클에게 배달하길 원합니다.",
    ["D"] =
    "나이젤의 야영지처럼 작은 전초기지에서는 우리 모두 한 가지 이상의 일을 맡고 있죠. 예를 들면, 난 메시지를 받고 전달하는 일을 해요. 당신이 흥미로워할 만한 메시지가 하나 있어요.\n\n코르메크의 오두막이라 불리는 빈민가의 어떤 고블린이 가죽세공인을 수소문하고 다닌대요. \"사업상 이유\"로 새 어깨보호구가 필요하다면서요. 그게 무슨 뜻인지는 모르겠지만요.\n\n동전을 좀 벌 수 있는 좋은 기회일지도 모르죠? 고블린들은 주머니가 두둑하니까요... 제가 듣기로는 그렇대요.",
  },
  [28577] = {
    ["T"] = "조라크 라벤홀트 경의 의뢰",
    ["O"] =
    "조라크 라벤홀트 경은 당신의 가죽세공 숙련도를 사용해 서리가죽 망토 1개를 만들어 알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 배달하길 원합니다.",
    ["D"] =
    "내 사람 보는 눈 하나는 뛰어나다네, $C. 내가 짐작건대... 넌 꽤 실력 있는 가죽세공인인 것 같군.\n\n펠리시티의 생일이 다가오고 있어. 그녀는 전혀 기대하지 않겠지만, 뭐라도 하나 주고 싶군. 선물이 실용적이면서도 우아하고, 그리고 아주 살짝 기대하지 못한 것이면 좋겠어.\n\n서리가죽 망토라면 안성맞춤이겠군. 이 일에 흥미가 있나?",
  },
  [28578] = {
    ["T"] = "선임기술자 우룰의 의뢰",
    ["O"] =
    "선임기술자 우룰은 당신의 가죽세공 숙련도를 사용해 흑색 허리띠 2개를 만들어 동부 내륙지의 맹금의 봉우리에 있는 선임기술자 우룰에게 배달하길 원합니다.",
    ["D"] =
    "난 주머니에도 연장이 가득하고, 소매에도 가득해. 심지어 어제는 렌치가 하수도 창살로 굴러떨어질 뻔했다니까. 조카 니오마가 그러는데, 난 제대로 된 허리띠가 필요하다더군 -- 그것도 특히 흑색 허리띠 두 개가.\n\n가죽세공을 훈련받았다면 두 개 만들어서 이리로 가져오게. 내 장비들을 담을 수 있고 압력을 받아도 터지지 않기만 한다면 어떻게 생겼는지는 신경 안 써. 그건 내 소관이니까.",
  },
  [28579] = {
    ["T"] = "보안과장 빌지위즐의 의뢰",
    ["O"] =
    "보안과장 빌지위즐은 당신의 가죽세공 숙련도를 사용해 거북껍질 다리보호구 2개를 만들어 타나리스의 스팀휘들 항구에 있는 보안과장 빌지위즐에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공인인가? 굳은살이 박혀 있군.\n\n이봐, 불평 좀 하게 해 줘 -- 일반 바지는 여기선 버티질 못해. 해적들은 세게 때리고, 태양은 더 세게 내리쬐지. 거북 껍데기로 만든 바지가 필요해. 오우거 이마만큼이나 튼튼하니까 말이야.\n\n자네 가죽세공 실력이 충분하다면 거북껍질 다리보호구 좀 만들어 줘. 튼튼하고, 유연하며, 해적의 공격에도 버틸 수 있는 옷이 필요해. 이상적으로는 그 순서대로 말이지.",
  },
  [28580] = {
    ["T"] = "그레간 브루스퓨의 의뢰",
    ["O"] =
    "프랫 맥그루벤은 당신의 가죽세공 숙련도를 사용해 신속의 화살통 1개를 만들어 페랄라스의 쌍둥이 바위산 근처 야영지에 있는 그레간 브루스퓨에게 배달하길 원합니다.",
    ["D"] =
    "드워프, 그레간은 이곳을 거쳐 간 대부분의 드루이드들보다 페랄라스의 야생에 훨씬 오래 있었지. 그가 신속의 화살통을 새로 보내달라는 전갈을 보냈어. 숲의 습기에 분해되지 않는 재질이 필요하다더군.\n\n날 페더문 밖으로 내보내진 못할 거야, 안 돼 $g형씨:아가씨;! 하지만 당신은 그걸 만들 실력이 있지 않나?",
  },
  [28581] = {
    ["T"] = "크로미의 의뢰",
    ["O"] =
    "레오나드 포터는 당신의 가죽세공 숙련도를 사용해 정련된 거친 가죽 1개를 만들어 서부 역병지대의 안돌할에 있는 크로미에게 배달하길 원합니다.",
    ["D"] =
    "야 -- 진짜 가죽세공인이다! 짙은 바위 소금과 가죽 냄새는 어디서 맡아도 단번에 알 수 있지.\n\n말 나온 김에 말인데... 나 완전 난처한 상황이야. 크로미라는 꼬마 노움한테 정련된 거친 가죽을 만들어 주기로 약속했는데 소금통이 없어졌어. 게다가 반경 수 마일 안에 다른 가죽세공인이라곤 눈을 씻고 찾아봐도 없단 말이지.\n\n네가 좀 대신 해줄래? 문제가 하나 더 있는데, 그녀가 저쪽에 있다는 거야... 안돌할 폐허 안에. 난 전투에 적합한 부류가 아니거든. 넌 꽤 세 보이는데.",
  },
  [28582] = {
    ["T"] = "리키 카트스파크의 의뢰",
    ["O"] =
    "윌리덴 마샬은 당신의 가죽세공 숙련도를 사용해 암색 가죽 장화 2개를 만들어 운고로 분화구의 공포의 터에 있는 리키 카트스파크에게 배달하길 원합니다.",
    ["D"] =
    "오! 저기, 당신 가죽세공인은... 아니겠지?\n\n운수대통인데! 운고로에 있는 고대 엘프 폐허를 연구하는 노움 리키 카트스파크에게 방금 메시지를 받았거든. 동료인 제이사가 부상을 입었고 장화가 엉망진창이래. 무슨 타르와 독에 닿았다던가. 어쨌든 그들에겐 새 암색 가죽 장화 두어 켤레가 필요한 상황이야. 네가 도와줄 수 있겠어?",
  },
  [28583] = {
    ["T"] = "소타르의 의뢰",
    ["O"] =
    "카마리는 당신의 가죽세공 숙련도를 사용해 가벼운 가죽 화살통 1개를 만들어 듀로타의 칼바위 언덕에 있는 소타르에게 배달하길 원합니다.",
    ["D"] =
    "장차 훌륭한 가죽세공인이 되실 분인가? 주문 몇 개 처리하는 것 좀 도와주겠어?\n\n칼바위 언덕에 있는 소타르가 새 화살통 주문을 넣었어. 예전 화살통은 다 떨어져서 화살이 솔기를 뚫고 튀어나온다더군. 그거 꽤 위험하지.\n\n초보자가 맡기에 딱 좋은 일이야. 가벼운 가죽 화살통을 하나 만들어서 마구간에 있는 그에게 가져다줘. 호드를 위한 봉사이자 네 연습이라고 생각해.",
  },
  [28584] = {
    ["T"] = "로카르 블레이드섀도의 의뢰",
    ["O"] =
    "카마리는 당신의 가죽세공 숙련도를 사용해 손바느질한 가죽 바지 2개를 만들어 듀로타의 모래바람 협곡 위 칼바위 언덕 북동쪽 농장에 있는 로카르 블레이드섀도에게 배달하길 원합니다.",
    ["D"] =
    "마음이 있다면 여기 하나 더 있어: 로카르가 칼바위 언덕 북동쪽에서 \"농사\"를 짓고 있다더군. 내 귀에는 수확이라기보다는 발버둥 치는 소리로 들리지만. 어쨌거나 모래바람 협곡을 기어오르다가 바지가 찢어졌다는군.\n\n연습해 볼 의향이 있다면 손바느질한 가죽 바지를 몇 벌 만들어서 가져다줘. 그의 농장은 칼바위 언덕 밖의 골짜기 위쪽에 있어.",
  },
  [28585] = {
    ["T"] = "잔겐 스톤후프의 의뢰",
    ["O"] =
    "초우 스트롱하이드는 당신의 가죽세공 숙련도를 사용해 돋을새김 가죽 조끼 2개를 만들어 멀고어의 썬더 블러프 상층에 있는 잔겐 스톤후프에게 배달하길 원합니다.",
    ["D"] =
    "다른 가죽세공 수습생인가? 밀린 주문들을 좀 도와줄 텐가?\n\n잔겐 스톤후프가 지난번 의식의 불에 돋을새김 가죽 조끼를 태워먹은 후 새것이 필요하다더군. 네가 맡기 꺼리지 않는다면 이건 쉬운 일거리야.",
  },
  [28586] = {
    ["T"] = "멜로르 스톤후프의 의뢰",
    ["O"] =
    "초우 스트롱하이드는 당신의 가죽세공 숙련도를 사용해 작은 가죽 탄약 주머니 2개를 만들어 멀고어의 썬더 블러프의 수렵의 봉우리에 있는 멜로르 스톤후프에게 배달하길 원합니다.",
    ["D"] =
    "잔겐의 형제 멜로르는 위대한 사냥꾼이지. 그 역시 주문을 넣었는데 자네가 이 일을 맡아줬으면 좋겠어.\n\n작은 가죽 탄약 주머니를 두 개 만들어서 썬더 블러프 수렵의 봉우리에 있는 멜로르에게 배달하게. 기계공학자에게 막 새로운 총을 주문해서 새 탄약을 시험해 보고 싶다더군.",
  },
  [28587] = {
    ["T"] = "쉘든 그림스비의 의뢰",
    ["O"] =
    "죽음의경비병 리니아는 당신의 가죽세공 숙련도를 사용해 튼튼한 가죽 바지 2개를 만들어 티리스팔 숲의 보루에 있는 쉘든 그림스비에게 배달하길 원합니다.",
    ["D"] =
    "저기 있는 셸렌을 봐. 요새 막 부활한 포세이큰들의 주문 때문에 정신을 못 차리고 있지. 네가 그녀와 이야기하는 걸 봤는데, 이 중 몇 가지는 네가 맡을 수 있을 거라는 걸 난 안다. 그러니 임무를 하나 내리마.\n\n쉘든 그림스비가 위대한 순찰자 나타노스 매리스를 찾는 임무를 띠고 보루를 향해 떠났지만, 난 그가 실패하리란 걸 알고 있어. 왜냐고? 여행을 감당하지 못할 다 찢어진 바지를 입고 있으니까. 튼튼한 가죽 바지를 두 켤레 만들어주면 그가 은빛여명회 앞에서 망신당하는 걸 피할 수 있을지 두고 보지.",
  },
  [28588] = {
    ["T"] = "올리버 드워의 의뢰",
    ["O"] =
    "죽음의경비병 리니아는 당신의 가죽세공 숙련도를 사용해 손바느질한 가죽 허리띠 1개를 만들어 티리스팔 숲의 브릴에 있는 올리버 드워에게 배달하길 원합니다.",
    ["D"] =
    "올리버 드워를 만난 적 있나? 그는 브릴의 무기제작자인데, 내가 말하긴 그렇지만 실력이 좋아. 무기는 훌륭하지만 옷 입는 꼴은 엉망이지. 한마디로 허리띠가 필요해.\n\n우리가 언데드이긴 하지만 불에는 여전히 타니까. 허리띠가 없어서 바지가 내려가는 바람에 대장간에서 바지에 불이 붙는 꼴은 보고 싶지 않다. 손바느질한 가죽 허리띠를 만들어 사고를 예방하자고.",
  },
  [28589] = {
    ["T"] = "현자 그린혼의 의뢰",
    ["O"] =
    "현자 그린혼은 당신의 가죽세공 숙련도를 사용해 검은 가죽 장화 2개를 만들어 은빛소나무 숲의 공동묘지에 있는 현자 그린혼에게 배달하길 원합니다.",
    ["D"] =
    "안녕하신가, $R. 내 친구 무라와 나는 이 지역 출신이 아닐세. 뭐, 척 보면 알겠지.\n\n은빛소나무 숲이 이렇게... 추울 줄은 몰랐어. 특히 밤에 말이야. 실력이 된다면 검은 가죽 장화 좀 만들어 주겠나? 여기서 수습생을 기다리는 동안 내 발굽이 얼어붙는 걸 막아줄 게야.",
  },
  [28590] = {
    ["T"] = "무라 룬토템의 의뢰",
    ["O"] =
    "현자 그린혼은 당신의 가죽세공 숙련도를 사용해 고급 가죽 망토 1개를 만들어 은빛소나무 숲의 공동묘지에 있는 무라 룬토템에게 배달하길 원합니다.",
    ["D"] =
    "내가 여기서 발굽이 얼어붙을 듯 서 있는 동안, 무라는 바다에서 불어와 언덕진 계곡을 지나 밴시의 비명처럼 휘몰아치는 차가운 바람 때문에 떨고 있다네.\n\n그녀를 위해 비바람을 다 막아줄 수 있는 고급 가죽 망토를 하나 만들어 주겠나?",
  },
  [28591] = {
    ["T"] = "팔라 세이지윈드의 의뢰",
    ["O"] =
    "날팍은 당신의 가죽세공 숙련도를 사용해 일반 방어구 키트 5개를 만들어 불모의 땅의 통곡의 동굴 위쪽에 있는 팔라 세이지윈드에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공인? 그래, 환영에서 본 자가 너로군. 꿈결에 네가 그 기술로 바로 이 산꼭대기에 사는 팔라를 돕는 모습을 보았다. 그녀에겐 일반 방어구 키트 여러 개가 필요하지.\n\n그녀를 도울 텐가?",
  },
  [28592] = {
    ["T"] = "가즈록의 의뢰",
    ["O"] =
    "날팍은 당신의 가죽세공 숙련도를 사용해 고급 가죽 튜닉 1개를 만들어 불모의 땅의 크로스로드에 있는 가즈록에게 배달하길 원합니다.",
    ["D"] =
    "환영 속에서 고급 가죽 튜닉을 든 네 모습도 보았다. 크로스로드의 가즈록을 위한 것일 테지. 랩터 떼와의 전투에서 셔츠가 찢어졌는데 전우들에게 그걸 숨기려 하고 있거든. 네가 새것을 가져다주면 무척 안도할 것이다.",
  },
  [28593] = {
    ["T"] = "마렌 스카이시어의 의뢰",
    ["O"] =
    "루가 레이지토템은 당신의 가죽세공 숙련도를 사용해 가벼운 가죽 바지 2개를 만들어 불모의 땅의 타이더스 계단에 있는 마렌 스카이시어에게 배달하길 원합니다.",
    ["D"] =
    "오, 가죽세공을 훈련받은 자로군. 너의 도움이 필요해. 크룰무가 밀린 일 때문에 어쩔 줄 모르고 있지만 솔직히 인정하질 않아. 수석 훈련을 막 끝마쳐서 불안할 텐데도 태연한 척하려고 애쓰는 거지.\n\n그를 돕고 싶다면, 내가 녀석의 의뢰서를 좀 빼돌려 왔어. 마렌 스카이시어가 가벼운 가죽 바지 두 개를 요청했지. 그걸 만들어서 톱니항 밖 해안가에 있는 그녀의 집으로 배달해 줘.",
  },
  [28594] = {
    ["T"] = "크룰무 풀문의 의뢰",
    ["O"] =
    "루가 레이지토템은 당신의 가죽세공 숙련도를 사용해 고급 가죽 허리띠 1개를 만들어 불모의 땅의 타우라조 야영지에 있는 크룰무 풀문에게 배달하길 원합니다.",
    ["D"] =
    "일 하나 더 해볼 의향이 있나? 흠... 이 메모에는 이름이 적혀있질 않네. 그저 \"고급 가죽 허리띠 하나\"라고 갈겨 써 있을 뿐. 뭐, 어쩔 수 없지. 그냥 허리띠를 만들어서 크룰무에게 가져가. 적절한 배달은 그가 처리할 테니까.",
  },
  [28595] = {
    ["T"] = "카드라크의 의뢰",
    ["O"] =
    "시리스는 당신의 가죽세공 숙련도를 사용해 튼튼한 방어구 키트 5개를 만들어 잿빛 골짜기의 몰샨의 망루에 있는 카드라크에게 배달하길 원합니다.",
    ["D"] =
    "너의 도움이 필요하다, 가죽세공인. 대족장의 지시에 따라 이곳 부대원들의 훈련을 감독하고 있는데 보급품이 부족하다. 토막나무 통나무집의 수요를 충당하는 동안, 우리 정찰병들과 척후병들을 내버려 둘 순 없지.\n\n튼튼한 방어구 키트 몇 개를 만들어 불모의 땅 입구인 몰샨의 망루에 주둔 중인 우리 병력에게 전달해라. 망루가 은빛날개 파수대에게 함락당하도록 놔둘 순 없다. 그랬다간 남쪽의 본대와 끊어지고 말 테니.",
  },
  [28596] = {
    ["T"] = "탈로우의 의뢰",
    ["O"] =
    "조지 칸다테는 당신의 가죽세공 숙련도를 사용해 무거운 화살통 1개를 만들어 힐스브래드 구릉지의 타렌 제분소에 있는 탈로우에게 배달하길 원합니다.",
    ["D"] =
    "탈로우라는 이름의 사냥꾼이 타렌 제분소 외곽을 따라 퓨마를 추적하고 있었는데, 교수대 삼거리 근처 어디선가 화살통을 잃어버렸어. 오우거 녀석들이 분명 다 찢어 놨을 테니 새것이 필요할 거야.\n\n가죽세공을 훈련받았나? 그럼 그를 위해 제대로 된 무거운 화살통을 하나 만들어 줄 수 있겠군. 튼튼한 놈으로, 긴 사냥을 마치고 돌아올 때까지 버틸 수 있도록 화살을 넉넉히 꽂을 수 있는 게 필요할 거야. 그리고 그의 펫은 걱정하지 마. 마을에 있을 땐 그 사나운 녀석을 우리에 가둬두니까.",
  },
  [28597] = {
    ["T"] = "스타른의 의뢰",
    ["O"] =
    "스타른은 당신의 가죽세공 숙련도를 사용해 암흑 가죽 허리띠 2개를 만들어 버섯구름 봉우리의 높새바람 봉우리에 있는 스타른에게 배달하길 원합니다.",
    ["D"] =
    "안녕하시오, $N. 바늘과 가죽 다루는 기술이 좀 있소? 다가오는 높새바람 봉우리 방문을 마치고 집에 돌아가실 부모님께 드릴 선물로 암흑 가죽 허리띠 두 개를 드리고 싶소만, 여기엔 가죽세공인이 없소.\n\n이 의뢰를 받아준다면, 흔쾌히 대가를 지불하고 내 마지막 사냥에서 얻은 가죽도 얹어 주겠소.",
  },
  [28598] = {
    ["T"] = "다른 탈론그립의 의뢰",
    ["O"] =
    "마그그랜 어스바인더는 당신의 가죽세공 숙련도를 사용해 강화된 가죽 장갑 1개를 만들어 돌발톱 산맥의 말라카진에 있는 다른 탈론그립에게 배달하길 원합니다.",
    ["D"] =
    "다른 탈론그립은 전쟁이 끝난 후 계속 말라카진에 주둔 중이라네. 어려운 상황에서도 그는 훌륭한 지휘관이야. 난 대부분의 오크보다 그를 더 존경한다네.\n\n당신에게 다른을 위한 아주 특별한 강화된 가죽 장갑 한 켤레를 의뢰하고 싶소. 그는 최근 겪은 일련의 차질로 인해 자신의 리더십을 자책하고 있소. 그가 명예롭고 귀중한 존재라는 걸 다시 상기시켜 주고 싶다네. 다른이 제 기능을 하도록 돕는 것이 곧 호드 전체에 봉사하는 일이라고 생각해 주게.",
  },
  [28599] = {
    ["T"] = "사만다 스위프트후프의 의뢰",
    ["O"] =
    "브로운은 당신의 가죽세공 숙련도를 사용해 화살장이 장갑 1개를 만들어 가시덤불 골짜기의 주 도로를 순찰 중인 사만다 스위프트후프에게 배달하길 원합니다.",
    ["D"] =
    "자네가 생가죽을 다루는 걸 봤어. 가죽세공인이지? 자네에게 맡길 일이 있네.\n\n사만다 스위프트후프는 다리를 고칠 방법을 찾아 가시덤불 골짜기로 왔어. 하지만 난 그녀가 은신과 저격이라는 사냥꾼의 삶을 받아들이기 시작했다는 걸 알 수 있지. 그녀를 위해 화살장이 장갑 한 켤레를 만들어 줄 수 있나? 내가 직접 하고 싶지만, 이미 이것저것 캐물은 게 많아서 그녀가 날 좋아하는 거라고 오해할까 봐. 뭐 그런 거 말이야.\n\n<기침을 하는 브로운.>",
  },
  [28600] = {
    ["T"] = "톡카르의 의뢰",
    ["O"] =
    "준다르사는 당신의 가죽세공 숙련도를 사용해 녹색 가죽 팔보호구 6개를 만들어 슬픔의 늪의 안개갈대 주둔지에 있는 톡카르에게 배달하길 원합니다.",
    ["D"] =
    "우리 정찰병들은 재규어와 악어, 정령들, 그리고 광포한 물고기들로부터 방어막을 형성하고 있소. 그런 생물들과 엮일 때 손목을 보호할 팔보호구가 필요하오. 당신은 가죽과 바늘을 다루는 솜씨가 있는 것 같군. 그들을 도와주시겠소?",
  },
  [28601] = {
    ["T"] = "비블리 푸츠버클의 의뢰",
    ["O"] =
    "나르브 하이드크래프터는 당신의 가죽세공 숙련도를 사용해 야만적인 어깨보호구 2개를 만들어 잊혀진 땅의 코르메크의 오두막에 있는 비블리 푸츠버클에게 배달하길 원합니다.",
    ["D"] =
    "침묵의 초소처럼 작은 전초기지에서는 잊혀진 땅에 있는 사람들을 돕기 위해 우리 모두 힘을 합치고 있소. 즉, 내게 감당할 수 없을 만큼 많은 주문이 몰려 있어서 당신의 도움이 필요하다는 뜻이오.\n\n코르메크의 오두막이라 불리는 빈민가의 어떤 고블린이 가죽세공인을 수소문하고 다닌다고 하오. \"사업상 이유\"로 새 어깨보호구가 필요하다더군. 그게 무슨 뜻인지는 모르겠지만.\n\n동전을 좀 벌 수 있는 좋은 기회일지도 모르겠군? 고블린들은 주머니가 두둑하니까... 제가 듣기로는 그렇다오.",
  },
  [28602] = {
    ["T"] = "조라크 라벤홀트 경의 의뢰",
    ["O"] =
    "조라크 라벤홀트 경은 당신의 가죽세공 숙련도를 사용해 서리가죽 망토 1개를 만들어 알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 배달하길 원합니다.",
    ["D"] =
    "내 사람 보는 눈 하나는 뛰어나다네, $C. 내가 짐작건대... 넌 꽤 실력 있는 가죽세공인인 것 같군.\n\n펠리시티의 생일이 다가오고 있어. 그녀는 전혀 기대하지 않겠지만, 뭐라도 하나 주고 싶군. 선물이 실용적이면서도 우아하고, 그리고 아주 살짝 기대하지 못한 것이면 좋겠어.\n\n서리가죽 망토라면 안성맞춤이겠군. 이 일에 흥미가 있나?",
  },
  [28603] = {
    ["T"] = "망꾼 롤로의 의뢰",
    ["O"] =
    "텅크는 당신의 가죽세공 숙련도를 사용해 흑색 허리띠 2개를 만들어 아라시 고원의 팔디르의 만에 있는 망꾼 롤로에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공 재료는 잔뜩 있는데, 정작 나한테는 그 기술이 없지 뭔가. 그게 문제야. 왜냐하면 운 나쁘게 주사위를 굴린 탓에, 팔디르의 만에 있는 롤로에게 새 허리띠 두 개를 빚졌거든.\n\n이유는 묻지 마... 그 녀석이 빚을 그렇게 갚길 원했으니까.\n\n아무튼, 허리띠 없이는 그 주변에 얼굴도 내밀 수 없으니 좀 도와줄 수 있겠나?",
  },
  [28604] = {
    ["T"] = "보안과장 빌지위즐의 의뢰",
    ["O"] =
    "보안과장 빌지위즐은 당신의 가죽세공 숙련도를 사용해 거북껍질 다리보호구 2개를 만들어 타나리스의 스팀휘들 항구에 있는 보안과장 빌지위즐에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공인인가? 굳은살이 박혀 있군.\n\n이봐, 불평 좀 하게 해 줘 -- 일반 바지는 여기선 버티질 못해. 해적들은 세게 때리고, 태양은 더 세게 내리쬐지. 거북 껍데기로 만든 바지가 필요해. 오우거 이마만큼이나 튼튼하니까 말이야.\n\n자네 가죽세공 실력이 충분하다면 거북껍질 다리보호구 좀 만들어 줘. 튼튼하고, 유연하며, 해적의 공격에도 버틸 수 있는 옷이 필요해. 이상적으로는 그 순서대로 말이지.",
  },
  [28605] = {
    ["T"] = "그레간 브루스퓨의 의뢰",
    ["O"] =
    "장도르 스위프트스트라이더는 당신의 가죽세공 숙련도를 사용해 신속의 화살통 1개를 만들어 페랄라스의 쌍둥이 바위산 근처 야영지에 있는 그레간 브루스퓨에게 배달하길 원합니다.",
    ["D"] =
    "드워프, 그레간은 이곳을 거쳐 간 대부분의 드루이드들보다 페랄라스의 야생에 훨씬 오래 있었지. 그가 내게 쪽지를 보냈는데...",
  },
  [28612] = {
    ["T"] = "모루울의 의뢰",
    ["O"] =
    "모루울은 당신의 무두질 숙련도를 사용해 녹색 새끼용 비늘 5개를 모아 슬픔의 늪의 피난처에 있는 모루울에게 배달하길 원합니다.",
    ["D"] =
    "아. 이 세계 사람이군. 무두질 도구를 지닌 자여.\n\n이 세계는 낯설소 -- 짐승도, 하늘도, 냄새도 말이오. 하지만 가죽은 여전히 가죽이고, 난 내 기술을 잊지 않았소.\n\n남쪽의 작은 용들에게 흥미가 생겼소. 녹색 새끼용 비늘 5개를 가져다주시오. 그걸로 이 환경에 맞는 방어구를 만들어 보겠소.",
  },
  [28613] = {
    ["T"] = "전투교관 스지게티의 의뢰",
    ["O"] =
    "전투교관 스지게티는 당신의 무두질 숙련도를 사용해 질긴 가죽 20개를 모아 먼지진흙 습지대의 테라모어에 있는 전투교관 스지게티에게 배달하길 원합니다.",
    ["D"] =
    "우리 훈련병들을 보러 왔나? 신병이 들어온다는 건 곧 타박상과 피, 그리고 망가진 장비를 의미하지. 방어구가 버티지 못하면 병사들도 버틸 수 없다네.\n\n우리 부대를 돕고 싶다면 질긴 가죽 20장을 가져오게. 훈련용 장비를 보강하는 데 필요하거든. 타격을 견뎌낼 만큼 튼튼하면서도, 부담 없이 소모할 만큼 저렴해야만 해.",
  },
  [28614] = {
    ["T"] = "스쿼토의 의뢰",
    ["O"] =
    "스쿼토는 당신의 무두질 숙련도를 사용해 랩터 가죽 5개를 모아 아라시 고원의 피난처에 있는 스쿼토에게 배달하길 원합니다.",
    ["D"] =
    "고원엔 랩터들이 득실대. 발톱이 날카롭고 비늘이 덮인 사나운 녀석들이지. 어차피 자주 싸우게 되니까... 그놈들의 가죽을 써먹는 게 낫지 않겠나.\n\n랩터 가죽 5개를 가져다줘. 아주 튼튼해서 장비 만들기 딱이거든. 아까운 가죽을 풀숲에서 썩힐 필욘 없잖아.",
  },
  [28615] = {
    ["T"] = "니오마의 의뢰",
    ["O"] =
    "니오마는 당신의 무두질 숙련도를 사용해 거북 껍질 10개를 모아 동부 내륙지의 맹금의 봉우리에 있는 니오마에게 배달하길 원합니다.",
    ["D"] =
    "저 멀리 동쪽 해안가에 사는 거북들은 느리지만 그 껍질은 정말 특별하지. 튼튼하면서도 유연하고 의외로 다루기도 쉽단다.\n\n요새 트롤들이 순찰을 도는 바람에 재고를 채우러 나갈 수가 없었어. 그쪽으로 가게 되면 거북 껍질 10개만 가져다줄래. 내 솜씨를 더하면 평생 쓸 수 있는 멋진 방어구 조각으로 만들 수 있거든.",
  },
  [28616] = {
    ["T"] = "피즈너클의 의뢰",
    ["O"] =
    "피즈너클은 당신의 무두질 숙련도를 사용해 랩터 가죽 5개를 모아 버섯구름 봉우리의 피즈너클에게 배달하길 원합니다.",
    ["D"] =
    "자네 무두장이지? 나한테 랩터 가죽을 가져다주면 좋은 조건으로 거래하지.",
  },
  [28623] = {
    ["T"] = "비운의 렌릭스의 의뢰",
    ["O"] =
    "비운의 렌릭스는 당신의 무두질 숙련도를 사용해 얇은 가죽 5개를 모아 서부 역병지대의 렌릭스에게 배달하길 원합니다.",
    ["D"] =
    "산 자를 섬기든 죽은 자를 섬기든, 가죽세공 기술은 이 세상에 남기 마련이지. 길고 고요한 야경을 서는 동안 내 기술을 조금 연습하고 싶네.\n\n얇은 가죽 5장을 가져다주게. 그럼 손도 바삐 움직이고 내 정신도 죽은 자들이 아닌 산 자들에게 집중할 수 있을 테니.",
  },
  [28624] = {
    ["T"] = "여관주인 팔레이의 의뢰",
    ["O"] =
    "여관주인 팔레이는 당신의 무두질 숙련도를 사용해 얇은 가죽 20개를 모아 엘윈 숲의 골드샤이어에 있는 여관주인 팔레이에게 배달하길 원합니다.",
    ["D"] =
    "골드샤이어를 지나는 여행자들은 항상 장비 수리를 필요로 하지. 기운 장화 한 켤레, 꿰맨 안장 하나. 이런 것들이 모이다 보니 보급품이 바닥을 보이고 있어.\n\n예리한 칼과 안정된 손길을 가졌다면 얇은 가죽 20장만 가져다주게나. 손님들도 만족하고 내 주머니도 두둑해질 테니.",
  },
  [28625] = {
    ["T"] = "앤드류 브로넬의 의뢰",
    ["O"] =
    "앤드류 브로넬은 당신의 무두질 숙련도를 사용해 일반 가죽 20개를 모아 은빛소나무 숲의 공동묘지에 있는 앤드류 브로넬에게 배달하길 원합니다.",
    ["D"] =
    "죽음의경비대 녀석들은 쉴 새 없이 물건을 요구해, $C. 허리띠가 끊어지고, 장화가 닳아 빠지고, 썩어가는 육체는 가죽마저 손상시키지.\n\n일반 가죽 20장 가져와. 밴시 여왕님의 명령에 우리 병사들이 언제든 대비할 수 있도록 안정적인 공급망이 필요하다.",
  },
  [28626] = {
    ["T"] = "켈드릭 바우처의 의뢰",
    ["O"] =
    "켈드릭 바우처는 당신의 무두질 숙련도를 사용해 일반 무두질 가죽 5개를 모아 티리스팔 숲의 언더시티에 있는 켈드릭 바우처에게 배달하길 원합니다.",
    ["D"] =
    "가죽세공의 예술은 정밀함을 요하고, 정밀함은 고품질의 재료를 요구하지. 특별한 프로젝트를 위해 흠집 없는 가죽이 필요하다네.\n\n일반 무두질 가죽 5장을 가져오게. 자네가 단순한 백정이 아니라 짐승의 가죽을 보존하는 데 필요한 섬세함을 이해하고 있음을 증명해 보아라.",
  },
  [28627] = {
    ["T"] = "선임기술자 노산더의 의뢰",
    ["O"] =
    "선임기술자 노산더는 당신의 무두질 숙련도를 사용해 녹색 새끼용 비늘 5개를 모아 황천의 폭풍의 52번 구역에 있는 선임기술자 노산더에게 배달하길 원합니다.",
    ["D"] =
    "나는 용의 비늘, 특히 작은 비늘들의 속성을 연구해 왔다네. 그 비늘들은... 이론적 응용에 쓸 만한 특유의 공명을 지니고 있지.\n\n우연히 녹색 새끼용 비늘을 발견하거든 5개만 가져다주게. 장담컨대 순전히 과학 발전을 위한 목적이라네.",
  },
  [28628] = {
    ["T"] = "하사관 루카스의 의뢰",
    ["O"] =
    "하사관 루카스는 당신의 무두질 숙련도를 사용해 질긴 가죽 20개를 모아 저주받은 땅의 네더가드 요새에 있는 하사관 루카스에게 배달하길 원합니다.",
    ["D"] =
    "우리 병사들의 방어구는 끊임없이 한계를 시험받고 있지, $C. 저주받은 땅의 짐승들은 무자비하고, 악마들은 더 지독해. 방어 체계를 보강할 재료가 필요하다.\n\n질긴 가죽 20장을 가져와. 갑옷을 기우고 상처를 싸매는 데 쓰일 거다. 네 기여는 잊지 않으마.",
  },
  [28629] = {
    ["T"] = "발다론의 의뢰",
    ["O"] =
    "발다론은 당신의 무두질 숙련도를 사용해 랩터 가죽 5개를 모아 페랄라스의 발다론에게 배달하길 원합니다.",
    ["D"] =
    "정글의 랩터는 사납지만 가죽 하나는 끝내주지. 마법이나 금속으로는 흉내 내기 힘든 타고난 저항력을 지니고 있어.\n\n뛰어난 무두장이라면 랩터 가죽 5장을 가져오게. 그 특성을 연구해 이 사냥터에 어울릴 만한 물건을 만들어보고 싶군.",
  },
  [28630] = {
    ["T"] = "날드스트럼 코퍼핀치의 의뢰",
    ["O"] =
    "날드스트럼 코퍼핀치는 당신의 무두질 숙련도를 사용해 돌연변이 비늘 5개와 완벽한 돌연변이 비늘 1개를 모아 타나리스의 가젯잔에 있는 날드스트럼 코퍼핀치에게 배달하길 원합니다.",
    ["D"] =
    "돌연변이 비늘! 지금 언더마인에서 아주 난리라니까. 줄을 선 구매자들은 많은데 물건이 달려서 말이지.\n\n통곡의 동굴로 뛰어들 만큼 배짱이 있다면, 돌연변이 비늘 5개랑 완벽한 돌연변이 비늘 1개를 가져와. 후하게 쳐줄게. 구매자가 누군지는 묻지 말고.",
  },
  [28631] = {
    ["T"] = "하렌 스위프트후프의 의뢰",
    ["O"] =
    "하렌 스위프트후프는 당신의 무두질 숙련도를 사용해 두꺼운 가죽 5개를 모아 불모의 땅의 타우라조 야영지에 있는 하렌 스위프트후프에게 배달하길 원합니다.",
    ["D"] =
    "튼튼한 텐트에는 튼튼한 가죽이 필요하오, $C. 불모의 땅에서 불어오는 강풍은 보잘것없는 가죽 따위 갈기갈기 찢어버리지.\n\n두꺼운 가죽 5장을 가져다주시오. 긴긴밤 내 동족들에게 훌륭한 피난처와 온기가 되어줄 것이오.",
  },
  [28632] = {
    ["T"] = "대장장이 슬래그트리의 의뢰",
    ["O"] =
    "대장장이 슬래그트리는 당신의 무두질 숙련도를 사용해 거북 껍질 10개를 모아 대장장이 슬래그트리에게 배달하길 원합니다.",
    ["D"] =
    "",
  },
  [28648] = {
    ["T"] = "트렌튼 라이트해머의 의뢰",
    ["O"] =
    "트렌튼 라이트해머는 당신의 채광 숙련도를 사용해 미스릴 광석 20개를 모아 타나리스의 가젯잔에 있는 트렌튼 라이트해머에게 배달하길 원합니다.",
    ["D"] =
    "대장장이 망치를 휘두르는 엘프를 보는 건 흔치 않은 일이지, 게다가 그 솜씨를 인정받는 엘프는 더더욱. 하지만 장미저를 본 순간, 그 비밀을 알아내기 전까진 결코 쉬지 않겠다고 다짐했다.\n\n연구를 계속하려면 미스릴 광석이 필요해. 사막엔 자원이 풍부하지만, 이곳에서만 구할 수 있는 건 아니야. 가서 내가 원하는 걸 찾아 돌아오도록.",
  },
  [28649] = {
    ["T"] = "비고의 의뢰",
    ["O"] =
    "비고는 당신의 채광 숙련도를 사용해 미스릴 주괴 20개를 모아 페랄라스의 글루크의 야영지에 있는 비고에게 배달하길 원합니다.",
    ["D"] =
    "저기 저 멍청이 둘 보여? 딤이랑 덤은 며칠 안으로 대장간 준비가 끝날 거라지만 난 믿지 않아.\n\n미스릴 주괴가 좀 있다면 진행 속도를 높일 수 있을 텐데. 대략 20개쯤이면 충분할 것 같군. 그래. 당연히 대장간을 위해서지. 나 개인을 위한 건 절대 아니야. 어쨌든 가져다주기나 해.",
  },
  [28650] = {
    ["T"] = "켈레크 스카이키퍼의 의뢰",
    ["O"] =
    "켈레크 스카이키퍼는 당신의 채광 숙련도를 사용해 토륨 광석 20개를 모아 악령숲의 에메랄드 성소에 있는 켈레크 스카이키퍼에게 배달하길 원합니다.",
    ["D"] =
    "내 옛 정원 도구들을 되찾는다고 해도 쓸모가 있을지 모르겠소. 이곳의 타락은 너무 깊게 뿌리내려 대지를 가꾸려면 더 단단한 소재의 모종삽이 필요할 것이오.\n\n토륨 광석 20개만 구해준다면 새 도구를 만들 수 있소. 듣자 하니 토륨이 가장 단단한 물질이라더군. 악령숲의 타락을 견뎌낼 수 있는 재료가 있다면 틀림없이 그것일 테요.",
  },
  [28651] = {
    ["T"] = "수석대장장이 버니네이트의 의뢰",
    ["O"] =
    "수석대장장이 버니네이트는 당신의 채광 숙련도를 사용해 검은무쇠 광석 10개를 모아 이글거리는 협곡의 토륨 거점에 있는 수석대장장이 버니네이트에게 배달하길 원합니다.",
    ["D"] =
    "우린 어둠괴철로 도시를 버리고 떠날 때 대장간이며 연장이며... 보급품까지 모조리 남겨두고 와야 했네.\n\n이제 여기서 다시 재건하고 있으니 솜씨 좋은 광부의 도움이 필요해. 검은무쇠 광석을 좀 가져와 주게.",
  },
  [28655] = {
    ["T"] = "레마 슈나이더의 의뢰",
    ["O"] =
    "죽음의경비병 리니아는 당신의 채광 숙련도를 사용해 구리 주괴 20개를 모아 티리스팔 숲 브릴 남쪽 야영지에 있는 죽음의경비병 리니아에게 배달하길 원합니다.",
    ["D"] =
    "최근 죽음의경비병 리니아가 눈에 띄는 족족 징발해 가고 있는데, 이젠 죽음의경비병들이 꾸미는 알 수 없는 계획을 위해 내 구리 주괴까지 내놓으라지 뭡니까. 그렇게 하면 저에겐 재료가 하나도 남지 않아요!\n\n그러니 이렇게 합시다 -- 당신이 나가서 구리 주괴 20개를 채광해 그녀에게 가져가서 내가 보낸 거라 전해주세요. 그러면 쥐꼬리만 한 보상은 당신이 가져도 좋습니다. 아, 후한 보상 말이에요. 저보단 당신에게 더 도움이 될 겁니다.",
  },
  [28656] = {
    ["T"] = "세바스티안 멜로체의 의뢰",
    ["O"] =
    "요한 폭히트는 당신의 채광 숙련도를 사용해 은 주괴 5개를 모아 은빛소나무 숲의 공동묘지에 있는 세바스티안 멜로체에게 배달하길 원합니다.",
    ["D"] =
    "아, 광부로군. 자네에게 맡길 일이 있네.\n\n저기 세바스티안과 나, 우리는 글쎄, 사이가 별로 좋지 않아. 벼룩과 진드기 사건 이후로 이 무덤은 우리 둘이 함께 쓰기엔 너무 비좁게 변해버렸지. 하지만 죽음의 추적자들을 지원하려면 우린 여기에 머물러야 해.\n\n어쨌든, 세바스티안에게 은 주괴 5개를 가져다주게. 이 공동묘지에서 처리해야 할 의뢰가 있는데 딱 알맞은 빛을 내는 재료가 필요하거든. 은이라면 완벽하지. 내가 아니라 자네가 전해주는 편이 녀석이 더 기분 좋게 받아들일 거야.",
  },
  [28657] = {
    ["T"] = "트라우그의 의뢰",
    ["O"] =
    "자안 호크윙은 당신의 채광 숙련도를 사용해 은 광석 10개를 모아 불모의 땅의 크로스로드에 있는 트라우그에게 배달하길 원합니다.",
    ["D"] =
    "아, 광부시군. 맡길 일이 하나 있소.\n\n이곳 대장간의 트라우그에게 특수 주문을 맡기고 싶은데, 은 장식을 새겨 넣어야 하오. 녀석 말로는 은이 다 떨어졌고 언제 다시 들어올지 모른다더군. 혹시 당신이 좀 도와줄 수 있소?",
  },
  [28658] = {
    ["T"] = "현장감독 스프링소켓의 의뢰",
    ["O"] =
    "현장감독 스프링소켓은 당신의 채광 숙련도를 사용해 주석 광석 20개를 모아 잿빛 골짜기의 토막나무 주둔지에 있는 현장감독 스프링소켓에게 배달하길 원합니다.",
    ["D"] =
    "오호, 전문 광부가 오셨군. 있잖아, 구리는 넘치게 많아서 주체할 수 없을 정돈데, 주석이 없으면 청동을 제련할 수가 없어. 문제는 일꾼들을 숲에 우글거리는 괴물들 사이로 내보내기엔 너무 위험하단 거지.\n\n주석 광석을 좀 가져와 줄래?",
  },
  [28669] = {
    ["T"] = "비고의 의뢰",
    ["O"] =
    "비고는 당신의 채광 숙련도를 사용해 미스릴 주괴 20개를 모아 페랄라스의 글루크의 야영지에 있는 비고에게 배달하길 원합니다.",
    ["D"] =
    "저기 저 멍청이 둘 보여? 딤이랑 덤은 며칠 안으로 대장간 준비가 끝날 거라지만 난 믿지 않아.\n\n미스릴 주괴가 좀 있다면 진행 속도를 높일 수 있을 텐데. 대략 20개쯤이면 충분할 것 같군. 그래. 당연히 대장간을 위해서지. 나 개인을 위한 건 절대 아니야. 어쨌든 가져다주기나 해.",
  },
  [28670] = {
    ["T"] = "우타이크의 의뢰",
    ["O"] =
    "우타이크는 당신의 채광 숙련도를 사용해 토륨 광석 20개를 모아 여명의 설원의 눈망루 마을에 있는 우타이크에게 배달하길 원합니다.",
    ["D"] =
    "여명의 설원의 매서운 바람은 우리가 도구를 교체하는 속도보다 더 빠르게 도구를 닳게 만들고 있소.\n\n토륨 광석 20개를 가져다주면, 내가 새 도구를 만들 수 있을 거요. 토륨은 현존하는 금속 중 제일 튼튼하다고 들었소. 극한의 추위를 견딜 수 있는 재료가 있다면, 그건 토륨뿐이오.",
  },
  [28671] = {
    ["T"] = "로크토스 다크바게이너의 의뢰",
    ["O"] =
    "로크토스 다크바게이너는 당신의 채광 숙련도를 사용해 검은무쇠 광석 10개를 모아 검은바위 나락의 험상궂은 주정뱅이 선술집에 있는 로크토스 다크바게이너에게 배달하길 원합니다.",
    ["D"] =
    "검은무쇠 드워프들은 자신들의 비밀을 철저히 지킨다네, $C. 하지만 자신들의 이름을 딴 광석을 다룰 줄 아는 건 그들만이 아니지.\n\n검은무쇠 광석 10개를 가져다주게. 위험하단 건 알지만 토륨 대장조합의 보상은 위험을 감수할 만한 가치가 있을 테니.",
  },
  [28672] = {
    ["T"] = "피짓의 의뢰",
    ["O"] =
    "피짓은 당신의 채광 숙련도를 사용해 토륨 주괴 20개를 모아 아즈샤라의 발로르모크에 있는 피짓에게 배달하길 원합니다.",
    ["D"] =
    "이런 대참사가 있나, $N! 기껏 본진 대장간을 세웠더니 나가 녀석들이 쳐들어와서 박살 내버렸어! 다시 고치려면 기적이 필요할 지경이야.\n\n하지만 자네가 토륨 주괴 20개만 구해다 준다면 도움이 될지도 몰라. 북쪽 황무지에 광석이 넘쳐난다는 소문을 들었거든. 나한테 직접 찾아가 볼 시간만 있었어도.",
  },
  [28673] = {
    ["T"] = "부관 레이너의 의뢰",
    ["O"] =
    "사라 팀버레인은 당신의 재봉술 숙련도를 사용해 푸른색 리넨 셔츠 2개를 만들어 엘윈 숲의 서부 주둔지에 있는 부관 레이너에게 배달하길 원합니다.",
    ["D"] =
    "지난주 놀 매복 공격 덕분에 부관 레이너는 넝마 조각 같은 셔츠를 입고 서부 주둔지를 순찰하고 있어요. 수선하러 오라고 해도 자존심을 세운다니까요.\n\n당신이 기술이 있다면 푸른색 리넨 셔츠 두 벌을 만들어 그에게 가져다줄 수 있을까요? 겉으로는 아닌 척해도 속으로는 그 호의에 감사할 거예요. 그렇다고 그 사람 말에 홀려서...",
  },
  [28695] = {
    ["T"] = "도안 카르한의 의뢰",
    ["O"] =
    "도안 카르한은 당신의 재봉술 숙련도를 사용해 푸른색 리넨 셔츠 2벌을 만들어 수습생들에게 줄 셔츠가 필요하다는 전갈을 보냈습니다.",
    ["D"] =
    "수습생들을 위한 셔츠가 필요하다는 전갈을 보냈습니다.\n\n푸른색 리넨 셔츠 두 벌을 만들어서 그에게 가져다주실 수 있나요? 사소한 일이지만 정말 큰 도움이 될 거예요.",
  },
  [28696] = {
    ["T"] = "스톤필드 할머니의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 소박한 원피스 1벌을 만들어 엘윈 숲의 스톤필드 부인 농장에 있는 스톤필드 할머니에게 배달하길 원합니다.",
    ["D"] =
    "스톤필드 할머니는 강인한 분이시지만 이따금은 고운 옷을 입을 자격이 있으세요.\n\n직접 부탁하진 않으실 테니 제가 대신 부탁드립니다. 소박한 원피스를 만들어 그녀에게 전달해 주세요. 지금까지 고생하신 것에 대한 작은 선물이라고 말씀드리고요.",
  },
  [28697] = {
    ["T"] = "마우린 본스플리터의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 리넨 가방 2개를 만들어 불모의 땅의 크로스로드에 있는 마우린 본스플리터에게 배달하길 원합니다.",
    ["D"] =
    "크로스로드는 북적이는 중심지라, 마우린은 물건 나르느라 늘 고생이 많아요. 그녀가 들고 다니는 낡은 자루들은 거의 다 뜯어지고 있죠.\n\n튼튼한 리넨 가방 두 개를 만들어서 그녀에게 전해주세요. 가방 공간이 늘어나서 아주 기뻐할 겁니다.",
  },
  [28698] = {
    ["T"] = "할파의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 두꺼운 양모 바지 2개를 만들어 멀고어의 썬더 블러프에 있는 할파에게 배달하길 원합니다.",
    ["D"] =
    "할파는 봉우리에 불어오는 찬 바람에 불평하면서도 가죽옷 외엔 아무것도 입으려 하질 않아요. 양모는 너무 가렵다면서요.\n\n그가 틀렸다는 걸 증명해 주세요. 두꺼운 양모 바지 두 벌을 만들어 그에게 가져가 보세요. 한 번 온기를 느끼고 나면 마음이 바뀔 테니까요.",
  },
  [28699] = {
    ["T"] = "여관주인 비울라의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 흰색 리넨 로브 1벌을 만들어 멀고어의 블러드후프 마을에 있는 여관주인 비울라에게 배달하길 원합니다.",
    ["D"] =
    "여관주인 비울라는 여행객들을 맞이하느라 쉴 틈 없이 일하지만 낡은 로브는 이제 수명이 다 한 것 같네요.\n\n흰색 리넨 로브를 만들어서 그녀에게 전해주세요. 그렇게 따스한 환대를 베푸는 사람에게 아주 어울리는 옷이 될 거예요.",
  },
  [28700] = {
    ["T"] = "여관주인 노먼의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 양모 장화 2켤레를 만들어 티리스팔 숲의 언더시티에 있는 여관주인 노먼에게 배달하길 원합니다.",
    ["D"] =
    "여관주인 노먼은 언더시티의 차가운 돌바닥을 밤낮으로 걷고 있어요. 그의 장화는 닳아서 얇아졌고 축축한 기운이 스며들고 있죠.\n\n양모 장화 두 켤레를 만들어 그에게 배달해 주세요. 언데드라도 발이 따뜻해지는 건 좋아할 거예요, 본인은 인정하지 않겠지만요.",
  },
  [28701] = {
    ["T"] = "지터스의 의뢰",
    ["O"] =
    "킬히와나는 당신의 재봉술 숙련도를 사용해 회색 양모 셔츠 4벌을 만들어 그늘숲의 까마귀 언덕에 있는 지터스에게 배달하길 원합니다.",
    ["D"] =
    "지터스는 항상 그림자에 깜짝 놀라는 불안한 친구예요. 자신의 옛 셔츠가 너무 밝아서 그늘숲의 공포스런 존재들에게 표적이 된다고 하더군요.\n\n그를 위해 회색 양모 셔츠 4벌을 만들어 주세요. 우중충한 색깔이 그에게 마음의 평안을 가져다주거나, 적어도 덜 눈에 띄게 해줄 거예요.",
  },
  [28702] = {
    ["T"] = "대학자 자브라시스의 의뢰",
    ["O"] =
    "조셉 그레고리안은 당신의 재봉술 숙련도를 사용해 양모 장화 2켤레를 만들어 은빛소나무 숲의 공동묘지에 있는 대학자 자브라시스에게 배달하길 원합니다.",
    ["D"] =
    "대학자 자브라시스는 공동묘지의 외풍 때문에 정신 집중에 방해된다며 늘 불평을 늘어놓는 까탈스러운 학자입니다.\n\n그를 위해 양모 장화 두 켤레를 만들어 주세요. 발이 따뜻해지면 어쩌면 불평을 그만두고 연구에 집중할지도 모르죠.",
  },
  [28703] = {
    ["T"] = "루퍼트 보흐의 의뢰",
    ["O"] =
    "조셉 그레고리안은 당신의 재봉술 숙련도를 사용해 진주장식 망토 1벌을 만들어 힐스브래드 구릉지의 타렌 제분소에 있는 루퍼트 보흐에게 배달하길 원합니다.",
    ["D"] =
    "루퍼트 보흐는 이 암울한 시대에도 자신이 신사라고 생각한답니다. 그는 자신의... 고상한 취향을 드러낼 수 있는 망토를 찾고 있어요.\n\n진주장식 망토를 만들어 그에게 전해주세요. 조금 사치스럽긴 해도 품질에 걸맞은 대가를 지불할 용의가 있는 사람이니까요.",
  },
  [28704] = {
    ["T"] = "멜난 다크스톤의 의뢰",
    ["O"] =
    "조셉 그레고리안은 당신의 재봉술 숙련도를 사용해 두꺼운 양모 장갑 2켤레를 만들어 티리스팔 숲의 언더시티에 있는 멜난 다크스톤에게 배달하길 원합니다.",
    ["D"] =
    "멜난 다크스톤의 손은 재료를 분류하거나 메모를 갈겨쓰느라 늘 바빠요. 언더시티의 추위가 그의 관절을 뻣뻣하게 만들고 있죠.\n\n그에게 장갑 몇 켤레를 만들어...",
  },
  [28727] = {
    ["T"] = "마법의 전갈",
    ["O"] =
    "마법의 전갈을 읽은 다음 던 모로 놈리건의 G.E.A.R.에 있는 마릭 너리빗과 대화하십시오.",
    ["D"] =
    "당신이 날 돕는 동안 이 전갈이 당신에게 전달하라고 전해졌어. 시간 날 때 한 번 읽어봐. 마법사 훈련관 마릭이 보낸 것 같아. 틈이 나면 G.E.A.R. 안에 있는 그녀를 찾아가 봐.",
  },
  [28728] = {
    ["T"] = "문양이 새겨진 서판",
    ["O"] =
    "문양이 새겨진 서판을 읽은 후 검은창 섬 마을에 있는 마이아와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 마법사 훈련관 마이아가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그녀를 찾아보게.",
  },
  [28729] = {
    ["T"] = "신성한 전갈",
    ["O"] =
    "신성한 전갈을 읽고 던 모로 G.E.A.R.에 있는 사제 훈련관 눌세이 기어스피너와 대화하십시오.",
    ["D"] =
    "당신이 날 돕는 동안 이 전갈이 당신에게 전달하라고 전해졌어. 시간 날 때 한 번 읽어봐. 사제 훈련관 눌세이가 보낸 것 같아. 틈이 나면 G.E.A.R. 안에 있는 그를 찾아가 봐.",
  },
  [28730] = {
    ["T"] = "신성한 서판",
    ["O"] =
    "신성한 서판을 읽은 후 검은창 섬 마을에 있는 켄자이와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 사제 훈련관 켄자이가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그를 찾아보게.",
  },
  [28731] = {
    ["T"] = "암호화된 전갈",
    ["O"] =
    "암호화된 전갈을 읽은 후 던 모로 G.E.A.R.에 있는 윈들 퓨즈스프링과 대화하십시오.",
    ["D"] =
    "당신이 날 돕는 동안 이 전갈이 당신에게 전달하라고 전해졌어. 시간 날 때 한 번 읽어봐. 도적 훈련관 윈들이 보낸 것 같아. 틈이 나면 G.E.A.R. 안에 있는 그를 찾아가 봐.",
  },
  [28732] = {
    ["T"] = "암호화된 서판",
    ["O"] =
    "암호화된 서판을 읽은 후 검은창 섬 마을에 있는 탈카이와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 도적 훈련관 탈카이가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그를 찾아보게.",
  },
  [28735] = {
    ["T"] = "대지의 부름",
    ["O"] =
    "검은창 섬 마을에 있는 이시요에게 대지 수액 2개를 가져다 주십시오.",
    ["D"] =
    "대지의 부름에 응답하려면 대지 수액을 찾아 바쳐야 하네. 마을 남쪽 바위투성이 산에 출몰하는 대지 정령들에게서 얻을 수 있지. 경고하건대, 녀석들은 아주 단단한 생명체라네.\n\n이 기회를 통해 덩치가 다가 아니며 가장 작은 것조차 수많은 것보다 오래 살아남을 수 있음을 깨닫길 바라네.\n\n인내심을 가지게, $N. 강인함을 유지하고 지혜를 구하게나. 이것이 대지가 자네에게 요구하는 것이네. 결국 자네는 대지와 하나가 될 것이네--자네가 존중하는 만큼 대지 또한 자네를 존중할 걸세.",
  },
  [28736] = {
    ["T"] = "룬이 새겨진 서판",
    ["O"] =
    "룬이 새겨진 서판을 읽은 후 검은창 섬 마을에 있는 이시요와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 주술사 훈련관 이시요가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그를 찾아보게.",
  },
  [28737] = {
    ["T"] = "오염된 전갈",
    ["O"] =
    "오염된 전갈을 읽고 던 모로 G.E.A.R.에 있는 알라마 그림과 대화하십시오.",
    ["D"] =
    "당신이 날 돕는 동안 이 전갈이 당신에게 전달하라고 전해졌어. 시간 날 때 한 번 읽어봐. 흑마법사 훈련관 알라마가 보낸 것 같아. 틈이 나면 G.E.A.R. 안에 있는 그를 찾아가 봐... 하지만 내가 널 예의주시하고 있다는 건 명심해. 네가 수련하는 어둠의 마법은 이곳의 많은 이들이 신뢰하지 않으니까.",
  },
  [28738] = {
    ["T"] = "시작",
    ["O"] =
    "던 모로 G.E.A.R.에 있는 알라마 그림에게 깃털 부적 3개를 가져다주십시오.",
    ["D"] =
    "훈련을 시켜주겠다고 약속했으니 슬슬 시작할 때가 되었군. 네가 일찍 성공할수록 -- 혹은 죽거나 -- 내가 내 연구로 더 빨리 돌아갈 수 있을 테니까.\n\n네가 배울 소환 주문 중 가장 간단한 것이 임프 소환이다. 하지만 내 지식을 네게 전수해 주려면 네가 마법을 통제할 수 있는 충분한 능력이 있는지부터 증명해야 한다.\n\n북쪽 서리갈기 동굴에 거주하는 서리갈기 수습 마법사들에게서 깃털 부적 세 개를 가져와라.",
  },
  [28739] = {
    ["T"] = "아즈샤라 우상",
    ["O"] =
    "아즈샤라 우상 3개를 듀로타 검은창 섬 마을에 있는 우와에게 가져다주십시오.",
    ["D"] =
    "호드는 흑마법사들이 다루는 어둠의 방식을 불신하지. 우리 흑마법사들은 용인되고 있을 뿐... 간신히 말이야.\n\n부두교 주술도 비전문가의 손에 들어가면 위험해지기 마련이야. 널 억지로 끌어들일 생각은 없지만, 내 실험을 가로막고 있는 작은 골칫거리 하나를 처리해 달라고 부탁하고 싶군. 물론 네 노고에 대한 대가로 힘을 주마.\n\n남쪽 나가 동굴에서 아즈샤라 우상 세 개를 구해 오너라. 그들의 이교도들이 지니고 다니는 건데, 내 연구에 꽤 쓸만할 거다.",
  },
  [28740] = {
    ["T"] = "오염된 서판",
    ["O"] =
    "오염된 서판을 읽은 후 검은창 섬 마을에 있는 우와와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 흑마법사 훈련관 우와가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그녀를 찾아보게.",
  },
  [28741] = {
    ["T"] = "간단한 전갈",
    ["O"] =
    "간단한 전갈을 읽고 던 모로 G.E.A.R.에 있는 파즈바 기어놉과 대화하십시오.",
    ["D"] =
    "당신이 날 돕는 동안 이 전갈이 당신에게 전달하라고 전해졌어. 시간 날 때 한 번 읽어봐. 전사 훈련관 파즈바가 보낸 것 같아. 틈이 나면 G.E.A.R. 안에 있는 그를 찾아가 봐.",
  },
  [28742] = {
    ["T"] = "간단한 서판",
    ["O"] =
    "간단한 서판을 읽은 후 검은창 섬 마을에 있는 타르세레와 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 전사 훈련관 타르세레가 보낸 것 같군. 내 뒤 언덕 위 마을에서 그녀를 찾아보게.",
  },
  [28743] = {
    ["T"] = "기술자의 도구",
    ["O"] =
    "눈마루 골짜기 남서쪽 야영지에서 그룬델의 팔보호구, 그룬델의 가슴갑옷, 그룬델의 망치를 수집해 앤빌마의 그룬델 하킨에게 가져가십시오.",
    ["D"] =
    "난 트롤 녀석들이 근처에 터를 잡기 전까진 눈마루 골짜기 남서쪽에 있는 멋진 야영지에서 작업하곤 했었어. 정령들이 난동을 부리기 시작하자마자 공구고 뭐고 다 내팽개치고 앤빌마로 꽁지 빠지게 도망쳐왔지. 내 도구들은 지금쯤 여기저기 흩어져 있을 거야.\n\n난 모험가는 아니지만, 넌 기백이 있어 보이는군. 내 물건을 찾아서 여기로 좀 가져다주겠나?",
  },
  [28744] = {
    ["T"] = "원소의 폭동",
    ["O"] =
    "그렐린 화이트비어드가 눈마루 골짜기의 서리 정령 14마리를 처치해달라고 부탁했습니다.",
    ["D"] =
    "나와 내 형제 세니르는 서리갈기 트롤이 제기하는 위협을 조사하기 위해 던 모로의 각기 다른 지역으로 파견되었다네. 원로원은 트로그 문제를 처리하느라 눈코 뜰 새 없이 바빠서 이런 자잘한 성가신 일까지 신경 쓸 겨를이 없지.\n\n내가 본 바에 의하면, 눈마루 골짜기에는 트롤은 없고 그저 통제 불능의 정령 무리뿐일세. 그래도 이 골칫거리는 해결해야겠지. 군대까지 동원할 필요는 없을 거야. 건장한 병사 몇 명이면 충분할 테니까.\n\n혹시 날 좀 도와주겠나? 자네에게 합당한 보상을 지급할 권한을 갖고 있다네.",
  },
  [28745] = {
    ["T"] = "서리술사",
    ["O"] =
    "그렐린 화이트비어드는 당신이 남서쪽 동굴을 탐험하고 서리 정령들을 선동하는 자를 처치하길 원합니다.",
    ["D"] =
    "생각하면 할수록 정령들을 뒤에서 조종하는 누군가가 있다는 확신이 드는군. 어쩌면 내 형제가 찾던 그 트롤의 위협이 이것일지도 몰라?\n\n서리 정령을 잘 상대해 주었으니, 저기 저 동굴로 들어가서 그놈들의 우두머리가 있는지 찾아보게. 녀석을 찾으면, 어떻게 해야 할지 잘 알겠지.",
  },
  [28746] = {
    ["T"] = "피난민의 진퇴양난",
    ["O"] =
    "던 모로 G.E.A.R.의 펠릭스 윈들볼트에게 펠릭스의 상자, 펠릭스의 궤짝, 펠릭스의 나사 한 양동이를 가져다주십시오.",
    ["D"] =
    "우리가 트로그 놈들을 놈리건에서 쫓아냈지만, 일이 끔찍하게 꼬여버리고 말았어! 이제 우리 집은 완전히 방사능에 오염되어버렸고, 우리 노움들은 던 모로 전역으로 뿔뿔이 흩어졌지.\n\n방사능을 피해 서둘러 도망치느라 내 개인 소지품과 도구들을 다 잃어버렸어. 트로그 녀석들이 가져가 버렸거든. 그놈들은 내 궤짝, 상자, 나사 한 양동이까지 모두 빼앗아서 바람이 쌩쌩 부는 서리갈기 산의 G.E.A.R. 외곽에 있는 자신들의 야영지로 가져갔어.\n\n난 모험가가 아니니까 -- 내 물건을 찾아서 이리로 좀 가져다줄래?",
  },
  [28747] = {
    ["T"] = "비상 보급품",
    ["O"] =
    "던 모로 서리갈기 산의 안톤 스파크샤인에게 비상 보급품 배낭을 전달하십시오.",
    ["D"] =
    "내 부탁 하나만 들어줄래? 네가 땜장이 대장 휘슬스크류를 돕는 걸 봤는데, 믿을 만한 사람 같아. 안톤 스파크샤인에게 이 비상 보급품을 가져다줄 사람이 필요해.\n\n그는 G.E.A.R. 외곽, 서리갈기 산 맞은편 야영지에 있어. 어때? 도와줄 수 있어?",
  },
  [28748] = {
    ["T"] = "비상 보급품",
    ["O"] =
    "던 모로 서리갈기 산의 디즈레 윌리카드에게 비상 담요를 전달하십시오.",
    ["D"] =
    "이 비상 담요는 디즈레 윌리카드에게 더 유용할 거야. 이왕 가는 김에 갖다 주지 않을래?\n\n마지막으로 들은 바로는 남동쪽으로 올라가는 길 근처에 주둔하고 있었어.",
  },
  [28749] = {
    ["T"] = "서리갈기 동굴",
    ["O"] =
    "던 모로 서리갈기 산의 레일라 스프로켓스파크를 위해 어린 서리갈기트롤 14마리를 처치하십시오.",
    ["D"] =
    "안톤 스파크샤인은 트로그들을 걱정하고 있어. 물론 타당한 우려야... 하지만 그보단 지평선 너머에서 도사리는 더 오래되고 위험한 적을 걱정해야 할 거야.\n\n서리갈기 트롤들은 오랫동안 재미 삼아 우리 노움들을 사냥해 왔지. 놈리건이 세워졌을 땐 자취를 감췄지만, 도시가 함락되자 북쪽 동굴에 있던 옛 터전으로 돌아왔어.\n\n놈들이 거점에 자리 잡도록 내버려 둘 순 없어. 네가 저들을 쓸어버리는 일에 착수하면 좋겠군.",
  },
  [28750] = {
    ["T"] = "스파크샤인에게 보고",
    ["O"] =
    "던 모로 서리갈기 산의 야영지에 있는 안톤 스파크샤인에게 레일라 스프로켓스파크가 당신을 보냈다고 알리십시오.",
    ["D"] =
    "난 네가 동굴을 소탕하는 모습을 주시하고 있었어. 아주 잘 해냈더군. 네가 계속 우리를 돕고 싶어 하는 것 같으니 이쯤 해서 날 도와주기 위해 찾아왔다고 안톤 스파크샤인에게 전해 줘.",
  },
  [28751] = {
    ["T"] = "카라노스 여행",
    ["O"] =
    "카라노스의 세니르 화이트비어드와 대화하십시오.",
    ["D"] =
    "그 망할 동생 놈은 이 산에서 서리갈기 트롤 놈들이 돌아왔다는 보고서를 한 번도 안 보냈어. 그 녀석의 유일한 보고 내용은 온통 눈마루 골짜기에 있는 정령들 이야기뿐이거든.\n\n그 소동의 근원에 대해 한 번 조사해 보는 게 좋겠어. 카라노스로 가면서 네가 처리한 트롤의 위협에 대해 세니르 화이트비어드에게 보고서를 전달해 줘. 그는 분명 그걸 받아보고 기뻐할 거야.",
  },
  [28752] = {
    ["T"] = "산악인과의 대화",
    ["O"] =
    "카라노스에 있는 산악경비대 탈로스와 대화하십시오.",
    ["D"] =
    "카라노스로 여행을 떠날 셈인가? 그렇다면 그곳에 있는 산악경비대 탈로스와 대화해 보는 게 좋을 거야. 그는 주변 지역의 최신 정보에 대해 밝을 뿐만 아니라, 네가 카라노스 밖으로 떠날 때 필요한 도움을 줄 수 있는 사람들과 널 연결해 줄 수 있을 테니까.",
  },
  [28753] = {
    ["T"] = "거트 굿스티치",
    ["O"] =
    "서리거미줄 10개를 카라노스에 있는 거트 굿스티치에게 가져가십시오.",
    ["D"] =
    "카라노스로 가고 있다고? 자네 여정에 보탬이 될 만한 걸 하나 알려주지.\n\n카라노스에 있는 내 친구가 온갖 짐승의 부산물을 다루는 전문가인데, 서리 거미의 거미줄도 아주 좋아한다네. 산을 내려가다 보면 서리 거미를 잔뜩 볼 수 있을 거야. 거미줄을 좀 모아가면 거트가 전부 다 후하게 쳐서 사줄 걸세.",
  },
  [28754] = {
    ["T"] = "티디 스크랩볼트에게 보내는 편지",
    ["O"] =
    "래즐 스크랩볼트의 편지를 카라노스의 썬더브루 양조장에 있는 티디 스크랩볼트에게 전달하십시오.",
    ["D"] =
    "G.E.A.R.를 떠날 건가? 혹시 그쪽으로 간다면 카라노스에 있는 내 형제에게 편지 한 통 전달해 주지 않을래? 추운 눈마루 토굴길을 무사히 통과했다면 썬더브루 양조장에서 반드시 쉬어가고 싶어질 거야.\n\n도착하거든 티디 스크랩볼트를 찾아봐. 그리고, 고마워!",
  },
  [28755] = {
    ["T"] = "거미 전차 부품",
    ["O"] =
    "눈마루 토굴길에서 거미 전차 부품 화물을 수집해 던 모로에 있는 지르피즈 크랭크블라스트에게 가져다주십시오.",
    ["D"] =
    "$C! 잠시 주목해 줄래. 카라노스에 가느라 바쁜 건 알지만 도움이 필요해.\n\n내가 놈리건에서 간신히 꺼내 온 이 거미 전차의 교체 부품이 도착할 예정이었어. 하지만 배달원이 아직 도착하지 않았고, 난 서리 거미들이 그를 공격한 게 아닐까 걱정스러워.\n\n혹시 눈마루 토굴길에서 그 부품의 흔적이 있는지 찾아봐 줄 수 있어? 만약 찾는다면 잠시 시간 좀 내서 내게 가져다주면 정말 고맙겠어.",
  },
  [28756] = {
    ["T"] = "트로그 도시",
    ["O"] =
    "던 모로 서리갈기 산의 안톤 스파크샤인을 위해 마른 바위턱 트로그 6마리와 야만적인 바위턱 트로그 6마리를 처치하십시오.",
    ["D"] =
    "G.E.A.R.의 당국은 격리된 놈리건 하층에서 시민들을 계속 대피시키는 동안 비상 집결로를 안전하게 유지하기 위해 최선을 다하고 있지만, 트로그들이 너무 많다는 게 문제야! 녀석들이 제 세상인 양 산봉우리를 배회하는 걸 보라고! 저 안쪽뿐만 아니라 이 바깥쪽도 트로그들의 도시가 된 것 같아!\n\n놈들을 쓰러뜨린다고 해서 우리가 잃은 사람들을 되살릴 순 없겠지만, 장기적으로 도시를 되찾는 우리의 노력을 더 수월하게 만들어 줄 거야. 도와줄 텐가?",
  },
  [28757] = {
    ["T"] = "바나나 대박",
    ["O"] =
    "다즈티로가 듀로타의 검은창 섬에 있는 아지사리에게 잘 익은 바나나 10개를 수집해 달라고 요청했습니다.",
    ["D"] =
    "네가 게들이 우리 식량 창고를 공격하는 걸 막아주긴 했지만, 게들이 망쳐버린 식량을 보충하려면 여전히 네 도움이 필요해.\n\n섬으로 나가서 야자수 주변마다 잘 익고 맛있는 바나나가 있는지 찾아봐. 잔뜩 있을 거야. 다 찾으면 마을에 있는 아지사리에게 가져가 봐. 그 녀석이 창고에 있는 맛있는 걸로 바꿔줄 거야.",
  },
  [28758] = {
    ["T"] = "조개껍질 수집",
    ["O"] =
    "검은창 섬 주변의 갯벌과 얕은 물에서 열대 조개껍질 8개를 수집해 아지사리에게 가져다주십시오.",
    ["D"] =
    "네가 나서서 도와주고 있으니, 아지사리가 네가 흥미 있어 할 만한 일을 하나 더 줄게.\n\n여기 조개껍질은 정말 아름다워. 작은 도구나 장신구를 만들기에 좋지. 더 많이 필요해. 검은창 섬 주변의 얕은 물 어디서나 모을 수 있을 거야.",
  },
  [28759] = {
    ["T"] = "호랑이의 발톱",
    ["O"] =
    "어린 호랑이에게서 날카로운 호랑이 발톱 10개를 모아 듀로타 검은창 섬에 있는 사냥꾼 본주루에게 가져가십시오.",
    ["D"] =
    "우리 검은창 부족이 나가들을 몰아내고 이 섬을 차지했지만 지역의 위협은 여전히 남아있어. 호랑이 개체 수가 그 어느 때보다 늘어나서 마을을 나서는 누구든 위협하고 있지.\n\n검은창 부족을 위해 싸워보겠어? 호랑이들을 처치하고 증거로 그놈들의 발톱을 가져와!",
  },
  [28760] = {
    ["T"] = "저주받은 트롤들",
    ["O"] =
    "듀로타 검은창 섬에 있는 의술사 리야를 위해 저주받은 트롤 8마리를 혼내주십시오.",
    ["D"] =
    "새로 온 $C인가? 자네가 이 임무에 제격인 $R 같아 보이는군.\n\n최근 우리 동족 중 일부가 남쪽에 있는 옛 폐허 주변을 서성이고 있어. 행동도 기이해서 이곳 장로들도 이유를 모르고 있지.\n\n거기로 가서 한 번 확인해 봐. 녀석들이 입을 열기 전에 정신이 번쩍 들게 좀 패줘야 할지도 몰라!",
  },
  [28761] = {
    ["T"] = "저주의 근원",
    ["O"] =
    "의술사 리야를 위해 검은창 섬 어딘가에 있는 저주의 근원을 찾으십시오.",
    ["D"] =
    "그래서 저주받은 트롤들이 두루마리를 읽고 부두 저주에 걸렸다는 건가? 우린 그걸 찾아서 이 저주를 풀어야만 해.\n\n자네는 지금까지 아주 믿음직한 $C였지. 섬을 둘러보고 그 두루마리를 찾아보게!\n\n짐작건대, 아마도 부두를 따라 해안 남쪽 끝에 있는 섬 반대편 폐허 근처에 있을 거야. 거기가 저주받은 트롤들이 많이 몰려 있는 곳이거든.",
  },
  [28762] = {
    ["T"] = "장로 가드린에게 보고",
    ["O"] =
    "듀로타 센진 마을의 장로 가드린과 대화하십시오.",
    ["D"] =
    "이 두루마리의 출처에 대해 짚이는 곳이 있지만, 센진 마을에 있는 장로 가드린이 직접 조사해 보는 게 좋겠어.\n\n이 두루마리를 그분께 가져가. 남서쪽으로 물을 건너면 센진 마을이 나올 거야. 해안을 따라 모래톱과 부두를 따라가기만 하면 쉽게 찾을 수 있을 거야.",
  },
  [28763] = {
    ["T"] = "칼바위 언덕에 보고",
    ["O"] =
    "쿨 티라스 인들이 라즈피리의 오두막을 공격했다는 사실을 칼바위 언덕의 책임자에게 보고하십시오.",
    ["D"] =
    "어젯밤 센진 마을의 축제에 참석하려고 떠났다가 오늘 아침 돌아왔더니, 내 오두막이 이렇게... 까맣게 타버린 잿더미가 되어있었어!\n\n누구 짓인지 난 안다, $N. 물 건너 티라가드 요새에 있는 쿨 티라스 인간놈들이야.\n\n호드는 인간들로부터 우릴 지켜주기로 되어 있잖아! 칼바위 언덕에 있는 자에게 어서 가서 이 개자식들을 제자리로 돌려놓기 위한 조치를 취해야 한다고 전해.\n\n거기까지 갈 때 티라가드 쪽으로 가로질러 가는 건 추천하지 않아. 그냥 해안을 따라 센진 마을로 내려간 다음, 내륙 길을 따라 칼바위 언덕으로 가는 게 나을 거야. 원한다면 수레를 타면 더 빨리 갈 수 있어.",
  },
  [28764] = {
    ["T"] = "죽음의 로아",
    ["O"] =
    "동굴과 샘 근처에 있는 브원삼디의 서판을 읽은 후 듀로타 검은창 섬에 있는 마카스갈에게 돌아가십시오.",
    ["D"] =
    "어릴 적에 로아에 대해 들어본 적 있을 테지. 이 강력한 정령들은 우리가 구루바시 제국에서 떨어져 나온 후로 줄곧 검은창 부족을 모른 척해왔어.\n\n하지만 브원삼디는 아니지.\n\n장로들은 소리 내어 말할 수 없는 것들을 전하기 위해 마을 밖 동굴과 마을 남쪽 샘에 서판을 세워두셨어. 자네가 세상 밖으로 나가기 전에 우리가 브원삼디와 맺은 서약에 대해 다시 한번 새겨두길 바라네 -- 그렇지 않으면 언젠가 그를 만났을 때 그의 속임수에 넘어갈지도 모르니까!",
  },
  [28765] = {
    ["T"] = "조류의 위협",
    ["O"] =
    "듀로타 검은창 섬에 있는 사냥꾼 본주루를 위해 멀록 바다전사 12마리를 처치하십시오.",
    ["D"] =
    "적에 대해 말하자면... 나가들은 패배했지만 그 녀석들의 하수인은 여전히 남아있지. 섬 남쪽 해안에 있는 멀록들 얘기야. 저 아래 갯벌로 내려가서 그 문제가 더 퍼지기 전에 처리해 주게. 그놈들은 단순한 짐승보다 훨씬 더 위험해. 다시 이야기할 수 있길 바라네....",
  },
  [28766] = {
    ["T"] = "기이한 껍데기 주머니",
    ["O"] =
    "기이한 껍데기가 들어 있는 주머니를 듀로타 검은창 섬에 있는 사냥꾼 본주루에게 가져다주십시오.",
    ["D"] =
    "이 멀록은 기이한 조개껍질이 가득한 주머니를 가지고 있었습니다. 어디에 쓰는 물건인지는 모르겠지만, 사냥꾼 본주루라면 흥미를 보일지도 모릅니다.",
  },
  [28767] = {
    ["T"] = "나가의 위협",
    ["O"] =
    "바다여제 리아나를 처치하십시오. 그녀의 삼지창을 듀로타 검은창 섬에 있는 사냥꾼 본주루에게 가져다주십시오.",
    ["D"] =
    "이건 단순한 조개껍질이 아니야, $N. 이건 나가들이 수생 동맹국에게 보상을 지급할 때 쓰는 동전이지. 이 멀록들이 자기들끼리 여기까지 흘러 들어왔다기엔 너무 조직적이라고 생각했었어. 분명 배후에 어떤 나가 우두머리가 있을 거야.\n\n이 나가를 처치해야만 해, 그렇지 않으면 녀석들이 섬을 되찾으려고 무리 지어 다시 쳐들어올지도 몰라. 남동쪽 갯벌 근처에 있는 동굴을 수색해 봐. 그 우두머리가 숨어있을 만한 가장 유력한 장소니까.",
  },
  [28768] = {
    ["T"] = "새겨진 양피지",
    ["O"] =
    "새겨진 서판을 읽은 후 검은창 섬 마을에 있는 젠샨과 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 사냥꾼 훈련관 젠샨이 보낸 것 같군. 내 뒤 언덕 위 마을에서 그녀를 찾아보게.",
  },
  [28769] = {
    ["T"] = "새겨진 서판",
    ["O"] =
    "새겨진 서판을 읽은 후 검은창 섬 마을에 있는 젠샨과 대화하십시오.",
    ["D"] =
    "자네가 날 돕고 있는 동안, 자네에게 전해달라며 이 서판이 왔네. 시간 있을 때 한 번 읽어보게나. 사냥꾼 훈련관 젠샨이 보낸 것 같군. 내 뒤 언덕 위 마을에서 그녀를 찾아보게.",
  },
  [30000] = {
    ["T"] = "검은무쇠 곡괭이",
    ["O"] =
    "상자를 찾아서 산의 피를 주어 잠금을 해제하세요. 그 안에 뭐가 들어있을지 누가 알겠어요?",
    ["D"] =
    "<당신이 산 곡괭이를 살펴보니 자루 안에 빈 공간이 있는 것을 발견합니다. 곡괭이 밑부분을 비틀자 종이 한 장과 함께 빈 공간의 덮개가 떨어져 나옵니다.>\n\n\"자랑스럽고 솜씨 좋은 광부가 이 공간을 발견하길 바라며 편지를 남기네, 아니면 당신이 너무 세게 내리쳐서 자루가 부러졌을지도 모르지! 이 곡괭이는 견고하고 믿을만하지만, 당신이 아직 보지 못한 가장 단단한 광물들엔 역부족이라네. 그래서 수년 동안 전설적인 곡괭이 제작법에 매달렸지. 완성하지는 못했고, 이젠 내가 직접 만들기엔 너무 늙어버렸다네. 그렇지만 이 지식을 아무렇게나 넘겨주고 싶지도 않군.\"\n\n\"산의 피를 찾게. 이 피는 검은무쇠 광석을 끊임없이 파내다보면 구할 수 있네. 다른 사람에게 산다고해도 무덤속에서 자네를 질책하진 않을게.그 피를 우리 황제 폐하께서 불의 군주를 소환하시기 전, 내가 살았던 옛집에 있는 궤짝으로 가져오게. 이 단서가 너무 모호하다고 생각한다면 자넨 검은무쇠 부족이 아닐테지!\"",
  },
  [30001] = {
    ["T"] = "더, 더 많은 인정 획득",
    ["O"] =
    "",
    ["D"] =
    "",
  },
  [30002] = {

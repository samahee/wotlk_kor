  [8921] = {
    ["T"] = "엑토플라즘 추출기",
    ["O"] = "가젯잔의 먹스 마나스크램블러에게 정밀한 아케이나이트 변환기 1개, 상급 영원의 정수 4개, 돌비늘 오일 10개, 화산재 25개, 그리고 40골드를 가져가십시오.",
    ["D"] =
    "아, 내 최신 발명품이 필요한 모양이군... 초차원 유령 탐지기 말이네! 안타깝게도 지금 자금과 일손이 바닥났거든.\n\n기꺼이 도와주겠다고? 훌륭해! 첫 번째 작업은 죽음의 물질 자체를 수집할 장치를 만드는 거네! 엑토플라즘 추출기를 만드는 건 쉬운 일이 아닐 거야, $N.\n\n아케이나이트 변환기, 상급 영원의 정수 몇 개, 돌비늘 오일이 필요해. 필터를 만들려면 불타는 평원의 용암 웅덩이에서 얻을 수 있는 화산재도 필요하고.",
  },
  [8922] = {
    ["T"] = "초자연적인 장치",
    ["O"] = "타나리스의 가젯잔 내부에 있는 먹스 마나스크램블러에게 밀봉된 혈액 용기를 가져가십시오.",
    ["D"] =
    "나는 안시온 하몬과... 더 정확히 말하자면 그의 유령과 이야기할 방법을 찾아야 하오!\n\n초자연적인 현상에 기이한 관심을 가진 기계공학자를 알고 있지. 그는 죽은 자와 대화할 수 있는 기계를 만들 수 있다고 주장하오!\n\n당신이 모은 피는 그를 위한 것이었소. 가젯잔으로 가서 그의 서비스에 대한 대가로 이것을 전해주시오!",
  },

  [487] = {
    ["T"] = "다르나서스로 가는 길",
    ["O"] = "돌라나르 외곽에 있는 파수꾼 아마라 나이트워커에게 나무옹이 부적 10개를 가져가십시오.",
    ["D"] =
    "다르나서스로 가는 길은 안전하게 유지되어야 합니다. 돌라나르에서 다르나서스로 향하는 여행자들이 나무옹이일족 펄볼그 중 타락한 자들에게 무자비한 공격을 받고 있다고 보고했습니다.\n\n중요한 소식과 상인들이 매일 이 길을 통해 다르나서스를 오갑니다. 이단자 무리가 사람들을 공포에 떨게 내버려 둘 수는 없습니다.\n\n신성한 숲의 이름으로 무기를 드십시오, 도적. 그들의 소굴은 이 유리한 고지 아래 어딘가에 있습니다. 그들의 신성한 부적을 가져와 내게 보고하십시오.",
  },
  [537] = {
    ["T"] = "어둠의 의회",
    ["O"] = "아르거스재림회 어둠마법사를 처치하고 그들의 마법책 중 하나를 힐스브래드 구릉지의 남녘해안에 있는 집정관 헨리 말레브에게 가져가십시오.",
    ["D"] =
    "당신이 가져온 편지는 스스로를 아르거스재림회의 일원인 나가즈라고 부르는 자가 쓴 것이오. 이 아르거스재림회가 무엇인지는 모르겠지만, 그들이 비밀결사대와 동맹을 맺었다면 분명 위협적인 존재일 것이오.\n\n나는 당신이 그 편지에 언급된 아르거스재림회 어둠마법사를 찾길 바라오. 그들을 찾아서 처치해주시오. 이 나가즈가 누구인지, 혹은 무엇인지 알 수 있게 해줄 그들이 가진 어떤 물건이든 가져와 주시오.\n\n스트란브래드와 그 북쪽의 고지대를 수색하시오. 운이 좋다면 그곳에서 이 아르거스재림회의 사절들을 찾을 수 있을 것이오.",
  },
  [991] = {
    ["T"] = "레이네의 정화",
    ["O"] = "잿빛 골짜기에서 테로니스를 찾으십시오.",
    ["D"] =
    "$N, 나의 오랜 친구 역시 이곳 잿빛 골짜기에서 파수꾼들을 돕고 있지만 아직 돌아오지 않았소.\n그는 우리 백성들에 대한 펄볼그의 공격을 늦출 수 있다고 생각하는 물건을 찾을 단서를 쥐고 있었지--지금은 죽은 사악한 마법사가 만든 막대라오.\n그는 이곳을 떠나기 전, 막대에 쓸 보석을 찾아보겠다고 말했소.\n그는 보석이 서쪽 산기슭의 팔라딤 호수에 있는 제단에 숨겨져 있을지도 모른다고 언급했소. 그곳이 점령당하기 전까지 보석은 그곳에 보관되어 있었지.\n내 친구를 찾아주시오, $N, 부탁하오.",
  },
  [1132] = {
    ["T"] = "피오라 롱이어즈",
    ["O"] = "테라모어에 있는 피오라 롱이어즈와 대화하십시오.",
    ["D"] =
    "오, 다시 바다로 나갈 수 있다면! 바람의 키스를 느끼고, 아주 오래전 축복받은 어머니처럼 파도가 나를 흔들어 주었으면!\n오, 선량한 $c, 내 미래에 바다가 보이니 당신의 행운이 나에게도 있었으면 좋겠소!\n기회의 땅, 칼림도어에 대해 열정적인 영혼들에게 알려주는 것이 내 일이오! 바다 건너에서 행운을 시험해 볼 의향이 있다면, 이곳에서 아름다운 항구 테라모어로 가는 배를 타시오. 그곳에서 내 파트너인 엘프, 피오라 롱이어즈와 대화하시오.\n그녀가 당신의 칼림도어 모험을 시작하게 해줄 것이오!",
  },
  [1218] = {
    ["T"] = "늪지 개구리 다리",
    ["O"] = "먼지진흙 습지대에 있는 \"늪지눈알\" 자를에게 부드러운 향신료 3개를 가져가십시오.",
    ["D"] =
    "난 요리를 좋아해. 훌륭한 늪지 요리지. 튀긴 녹색 개구리 다리 같은 거 말이야.\n그리고 요리를 하려면 향신료가 필요해. 부드러운 향신료. 그럼 스튜를 끓여서 푹 끓인 다음 들이켜고 너한테도 조금 줄게.\n스튜 좋아해?",

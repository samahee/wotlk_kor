    ["D"] =
    "",
  },
  [31003] = {
    ["T"] = "잃어버린 화물 복구",
    ["O"] =
    "잃어버린 배송품을 가젯잔의 노그에게 반환하십시오.",
    ["D"] =
    "운 좋네, 친구! 그 골치 아픈 놈을 제거하고도 내 물건까지 회수해 주다니.\n\n이 작은 꾸러미를 타나리스, 가젯잔에 있는 노그에게 가져다줘. 물론 보상으로 두둑이 챙겨주겠지.",
  },
  [31004] = {
    ["T"] = "신록수호자의 부름",
    ["O"] =
    "저습지에 있는 신록수호자 레시엘과 대화하십시오.",
    ["D"] =
    "반가운 자연의 자손이여.\n\n자네가 자연의 길에 큰 헌신을 보여준 것을 들었네. 우리의 형제인 신록수호자 레시엘이 저습지에서 위대한 임무를 띠고 도움이 필요하다는군.\n\n그는 남서쪽의 늪지에 있네. 그를 찾아 자네의 실력을 빌려주게나.",
  },
  [31005] = {
    ["T"] = "사악한 오염물질",
    ["O"] =
    "오염된 물 10병과 오염된 흙 10줌을 채집하십시오.",
    ["D"] =
    "늪지대는 나날이 오염되고 있고 우리 동족의 노력만으로는 막아내기가 역부족이네. 부패의 원인을 찾아내야 해. 슬라임들이 이 오염의 핵심이라고 확신하네.\n\n나가서 오염된 물 10병과 흙 10줌을 가져와 주게. 그 오염물질이 슬라임들에게서 나온 건지 확인해 보겠어. 서둘러 줘, 자연이 고통받고 있으니까.",
  },
  [31006] = {
    ["T"] = "정화 의식",
    ["O"] =
    "달빛 깃든 그릇에 정화된 물과 흙을 채우고 신록수호자 레시엘에게 가져가십시오.",
    ["D"] =
    "훌륭해, 샘플을 가져왔군. 예상대로 이건 최악의 역병 중 하나야. 하지만 아직 이 땅을 구원할 희망이 남아있어.\n\n자, 달빛 깃든 그릇에 정화된 물과 흙을 모아오게나. 그러면 그 샘플들을 오염의 원천을 파괴할 혼합물로 만들어 줄 테니까.",
  },
  [31007] = {
    ["T"] = "정화된 샘플",
    ["O"] =
    "정화된 달빛 깃든 그릇을 신록수호자 레시엘에게 다시 가져가십시오.",
    ["D"] =
    "수고했네. 이제 혼합물을 완성할 차례야. 이 정화된 샘플들을 나에게 다시 가져오게. 달빛의 힘으로 오염을 정화하는 거야.",
  },
  [31008] = {
    ["T"] = "부패한 코어",
    ["O"] =
    "진흙 괴물을 쓰러뜨리고 부패한 코어를 신록수호자 레시엘에게 가져가십시오.",
    ["D"] =
    "오염의 원천을 발견했네... 저습지 깊숙한 곳을 배회하는 거대한 괴수야. 이 혼합물을 사용해 놈을 유인하고 쓰러뜨려!\n\n놈의 부패한 코어를 내게 가져오면, 우리가 이 지역의 평화를 되찾을 수 있을 거야.",
  },
  [31009] = {
    ["T"] = "오염물 처치",
    ["O"] =
    "달빛이 깃든 칼날로 부패한 코어를 오염의 원천에 파괴하십시오.",
    ["D"] =
    "코어를 가져왔군. 이제 마지막 단계야. 달빛이 깃든 칼날을 들고 오염의 근원에 있는 제단으로 가서 코어를 파괴하게.\n\n이 의식이 끝나면 비로소 자연은 회복의 첫걸음을 내디딜 수 있을 테지.",
  },
  [31010] = {
    ["T"] = "대지의 수호자",
    ["O"] =
    "나이트헤이븐의 데날란과 대화하십시오.",
    ["D"] =
    "자네가 저습지에서 한 일은 아주 인상적이었네. 자네라면 더 막중한 임무를 수행할 자격이 있다고 생각하네.\n\n달숲의 나이트헤이븐에 있는 동료 데날란에게 가보게. 그는 자네와 같은 힘을 지닌 자를 찾고 있다네. 서두르게나, 시간이 부족할지도 모르니.",
  },
  [31011] = {
    ["T"] = "악화되는 역병",
    ["O"] =
    "여명의 설원 눈망루 마을의 현자 타카르와 대화하십시오.",
    ["D"] =
    "우려했던 대로군... 부패가 퍼지고 있어. 멀리 북쪽 여명의 설원까지 말일세. 우리 세나리온 의회의 동맹들이 도움을 청하고 있다네.\n\n눈망루 마을에 주둔 중인 현자 타카르를 찾아가게. 그는 오염에 대해 조사 중이지만, 자네처럼 유능한 영웅의 지원이 필요할 테니.",
  },
  [31012] = {
    ["T"] = "불안한 보고",
    ["O"] =
    "여명의 설원에 있는 이상 징후 세 곳을 조사하고 식물과 동물 샘플을 수집하십시오.",
    ["D"] =
    "달숲에 온 걸 환영하네, 용사여. 자네가 가져온 소식은 참으로 불길하군.\n\n여명의 설원 역병이 반영된 에메랄드의 꿈의 떨림을 우리도 느꼈다네.\n\n그것은 세 곳의 뚜렷한 장소를 중심으로 벌어지고 있는 듯해.\n\n여명의 설원으로 돌아가서 이상 징후들을 조사해 주게. 병든 식물과 동물들의 샘플을 수집하게나. 조심해, 타락이 그들을 알아볼 수 없을 정도로 기괴하게 뒤틀어놓았을지도 모르니.",
  },
  [31013] = {
    ["T"] = "이상 징후 조사",
    ["O"] =
    "수집한 샘플을 가지고 달숲의 수호자 레물로스에게 돌아가십시오.",
    ["D"] =
    "샘플은 구했나? 좋군.\n\n당장 분석을 시작해야 해. 역병이 예상보다 훨씬 빠르게 퍼지고 있네.\n\n이것이 그저 시작에 불과할까 봐 두렵군.",
  },
  [31014] = {
    ["T"] = "언더시티로의 여행",
    ["O"] =
    "차원문을 타고 언더시티로 가서 여군주 실바나스 윈드러너와 대화하십시오.",
    ["D"] =
    "내 생각보다 훨씬 심각하군. 이 샘플들... 이 세계의 것이 아닌 어둠의 마법 냄새가 짙게 배어 있어.\n\n난 그 기원을 해독할 수 없지만, 알 만한 사람을 알고 있네.\n\n언더시티로 가서 여군주 실바나스 윈드러너를 만나게. 비전과 흑마법에 대한 그녀의 지식은 대단하지. 어쩌면 그녀가 이 역병의 근원을 알아낼지도 몰라.\n\n자네를 위해 차원문을 열어두었네. 서두르게.",
  },
  [31015] = {
    ["T"] = "아이언포지로의 여행",
    ["O"] =
    "차원문을 타고 아이언포지로 가서 국왕 마그니 브론즈비어드와 대화하십시오.",
    ["D"] =
    "내 생각보다 훨씬 심각하군. 이 샘플들... 이 세계의 것이 아닌 어둠의 마법 냄새가 짙게 배어 있어.\n\n난 그 기원을 해독할 수 없지만, 알 만한 사람을 알고 있네.\n\n아이언포지로 가서 국왕 마그니 브론즈비어드를 만나게. 대지와 숨겨진 비밀에 대한 그의 지식은 광대하지. 어쩌면 그가 이 역병의 근원을 알아낼지도 몰라.\n\n자네를 위해 차원문을 열어두었네. 서두르게.",
  },
  [31016] = {
    ["T"] = "밴시 여왕의 조언",
    ["O"] =
    "여군주 실바나스 윈드러너에게 샘플을 보여주십시오.",
    ["D"] =
    "내 영토에는 무슨 일로 찾아왔느냐, 호드의 용사여? 내 조언을 구하러 온 것이냐, 아니면 그저 길을 잃은 것이냐?\n\n... 알겠다.\n\n네가 찾아낸 것을 내게 보여라.",
  },
  [31017] = {
    ["T"] = "산왕의 지혜",
    ["O"] =
    "국왕 마그니 브론즈비어드에게 샘플을 보여주십시오.",
    ["D"] =
    "아이언포지에 온 걸 환영하네, 얼라이언스의 용사여. 지상에서 무슨 소식을 가져왔는가?\n\n... 알겠네.\n\n자네가 찾은 것을 내게 보여주게.",
  },
  [31018] = {
    ["T"] = "키린 토의 전문 지식",
    ["O"] =
    "알터랙 산맥으로 가서 달라란 외곽에 있는 대마법사 앤자이럼 룬위버를 만나십시오.",
    ["D"] =
    "이 마법... 익숙하면서도 꼬여 있군. 키린 토의 흔적이 보이지만, 훨씬 더 불길한 무언가에 의해 오염되고 뒤틀렸어.\n\n키린 토를 찾아야 해. 그들은 비전 마법에 관한 최고 전문가들이지. 만약 이 미스터리를 풀 수 있는 이가 있다면 바로 그들일 거야.\n\n알터랙 산맥에 있는 달라란의 폐허로 가라. 대마법사 앤자이럼 룬위버를 찾아. 그는 비전 마법의 대가이니 우리가 찾는 해답을 가지고 있을지도 모른다.",
  },
  [31019] = {
    ["T"] = "키린 토의 전문 지식",
    ["O"] =
    "알터랙 산맥으로 가서 달라란 외곽에 있는 대마법사 앤자이럼 룬위버를 만나십시오.",
    ["D"] =
    "이 마법... 고대적이고 강력하군. 아제로스의 지맥과 공명하고 있지만, 어둠의 영향에 오염되고 더렵혀져 있네.\n\n키린 토를 찾아야 해. 그들은 비전 마법에 관한 최고 전문가들이지. 만약 이 미스터리를 풀 수 있는 이가 있다면 바로 그들일 거야.\n\n알터랙 산맥에 있는 달라란의 폐허로 가라. 대마법사 앤자이럼 룬위버를 찾아. 그는 비전 마법의 대가이니 우리가 찾는 해답을 가지고 있을지도 모른다.",
  },
  [31020] = {
    ["T"] = "지맥 연결 지점",
    ["O"] =
    "저승바람 고개의 지배자의 지하실 근처에 있는 지맥 연결 지점을 조사하십시오.",
    ["D"] =
    "환영하오, 여행자. 이 한때 위대했던 우리 도시의 폐허엔 무슨 일로 찾아왔소?\n\n... 그렇군.\n\n이거 참으로 심각한 문제요. 키린 토도 지맥의 요동을 주시하고 있었지만, 이 정도로 오염된 줄은 몰랐소.\n\n저승바람 고개의 지배자의 지하실 근처에 강력한 지맥 연결 지점이 있소. 만약 역병이 지맥을 타고 퍼지고 있는 거라면, 그곳이 근원지일 가능성이 크오.\n\n그곳으로 가서 연결 지점을 조사하시오. 조심해야 하오, 그 지역은 위험으로 가득 차 있으니까.",
  },
  [31021] = {
    ["T"] = "연결 지점 조사",
    ["O"] =
    "연결 지점에서 발견한 것들을 대마법사 앤자이럼 룬위버에게 가져가십시오.",
    ["D"] =
    "연결 지점에서 무언가를 찾아냈소?\n\n당신의 발견물들을 즉시 분석해 봐야겠소.",
  },
  [31022] = {
    ["T"] = "악마의 개입",
    ["O"] =
    "저승바람 고개의 지배자의 지하실 근처에서 악마 15마리를 처치하십시오.",
    ["D"] =
    "연결 지점 근처에 악마가 존재한다는 건 불길한 징조요. 그 녀석들은 부패한 마법에 이끌려 그 힘을 포식하고 있소.\n\n더 큰 피해를 입히기 전에 놈들을 깨끗이 치워버려야 하오.\n\n연결 지점으로 돌아가서 눈에 띄는 악마를 모조리 베어버리시오. 우린 그 구역을 안전하게 확보해야만 하오.",
  },
  [31023] = {
    ["T"] = "역병의 근원",
    ["O"] =
    "악마들에 관한 소식을 들고 대마법사 앤자이럼 룬위버에게 돌아가십시오.",
    ["D"] =
    "악마들은 다 처리했소? 좋소.\n\n그렇다면 이제 놈들이 왜 거기 있었는지 밝혀내야 하오.\n\n타락이... 단순한 마법적 성질이 아니라, 악마의 성질을 띠고 있소.\n\n우리는 이 악마의 기운의 진정한 원천을 찾아야만 하오.",
  },
  [31024] = {
    ["T"] = "흑마법사의 둥지",
    ["O"] =
    "오그리마 어둠의 틈에 있는 흑마법사의 둥지를 조사하십시오.",
    ["D"] =
    "이 미스터리의 심연으로 더 깊이 들어가야 하오. 암흑 마법을 다루는 자들 중에 이 악마의 역병을 이해할 열쇠를 쥔 자가 있을 것이오.\n\n오그리마의 어둠의 틈으로 가시오. 거기엔 악마 마법의 대가들인 흑마법사들이 있소. 어쩌면 그들이 이 상황의 실마리를 풀어줄지도 모르지.\n\n하지만 명심하시오, 놈들은 아주 비밀스럽고 위험한 자들이오. 부디 발걸음을 조심하시오.",
  },
  [31025] = {
    ["T"] = "흑마법사의 둥지",
    ["O"] =
    "스톰윈드 지하감옥에 있는 도살장 내부의 흑마법사의 둥지를 조사하십시오.",
    ["D"] =
    "이 미스터리의 심연으로 더 깊이 들어가야 하오. 암흑 마법을 다루는 자들 중에 이 악마의 역병을 이해할 열쇠를 쥔 자가 있을 것이오.\n\n스톰윈드 지하감옥의 도살장으로 가시오. 거기엔 악마 마법의 대가들인 흑마법사들이 있소. 어쩌면 그들이 이 상황의 실마리를 풀어줄지도 모르지.\n\n하지만 명심하시오, 놈들은 아주 비밀스럽고 위험한 자들이오. 부디 발걸음을 조심하시오.",
  },
  [31026] = {
    ["T"] = "흑마법사의 지식",
    ["O"] =
    "흑마법사의 둥지에서 칸레타드와 대화하십시오.",
    ["D"] =
    "무엇을 원하느냐, 필멸자여? 내가 바쁜 거 안 보이나?\n\n... 아, 그 역병. 그래, 소문은 들었다.\n\n정말로, 매혹적인 현상이지.\n\n하지만 지식엔 대가가 따르는 법. 넌 무얼 제공할 수 있느냐?",
  },
  [31027] = {
    ["T"] = "지식의 대가",
    ["O"] =
    "저승바람 고개의 악마들에게서 악마의 정수 10개를 모아 칸레타드에게 가져가십시오.",
    ["D"] =
    "내 도움을 원한다면 너의 가치를 증명해라.\n\n악마의 정수 10개를 가져와. 저승바람 고개의 악마들에게서 찾을 수 있을 거다.\n\n그 일을 해내면, 내가 아는 것을 말해주지.",
  },
  [31028] = {
    ["T"] = "드러난 진실",
    ["O"] =
    "칸레타드에게서 얻은 정보를 들고 대마법사 앤자이럼 룬위버에게 돌아가십시오.",
    ["D"] =
    "정수는 구했나? 좋아.\n\n자, 내 말을 똑똑히 들어라. 역병은... 지맥을 통해 흘러들어온 순수한 공허 에너지가 구현된 형태다.\n\n그건 일종의 신호기지. 공허의 지배자들을 불러모으는 신호기.\n\n네가 본 악마들은 그저 선발대일 뿐이야. 훨씬 더 거대한 위협이 다가오고 있다.",
  },
  [31029] = {
    ["T"] = "공허의 포옹",
    ["O"] =
    "심연의 틈으로 가서 공허의 군주를 처치하십시오.",
    ["D"] =
    "정말로 참담한 소식이구려. 공허의 군주라니... 놈이 완전히 현신하게 되면, 온 아제로스를 집어삼키고 말 거요.\n\n너무 늦기 전에 막아야 하오.\n\n에너지 신호가 대해 깊은 곳의 한 위치를 가리키고 있소. 심연의 틈이라 불리는 곳이지.\n\n반드시 그곳으로 가야만 하오, 용사여. 공허의 군주에 맞서 싸워 놈을 무찌르시오.",
  },
  [31030] = {
    ["T"] = "승리",
    ["O"] =
    "알터랙 산맥의 대마법사 앤자이럼 룬위버에게 돌아가십시오.",
    ["D"] =
    "당신이 해냈군! 공허의 군주는 패배했고, 역병도 물러가고 있소.\n\n당신의 용기 덕분에 아제로스는 다시 안전해졌소.\n\n우리는 당신에게 크나큰 빚을 졌소.",
  },
  [31031] = {
    ["T"] = "비전의 역병",
    ["O"] =
    "오그리마로 돌아가 스랄에게 당신의 성공을 알리십시오.",
    ["D"] =
    "다시 한번 감사하오, 모험가여. 당신은 오늘 아제로스를 위해 참으로 위대한 업적을 이루었소.\n\n틀림없이 당신 진영의 지도자들도 당신의 영웅적 행적을 듣고 싶어 할 거요.",
  },
  [31032] = {
    ["T"] = "비전의 역병",
    ["O"] =
    "아이언포지로 돌아가 국왕 마그니 브론즈비어드에게 당신의 성공을 알리십시오.",
    ["D"] =
    "다시 한번 감사하오, 모험가여. 당신은 오늘 아제로스를 위해 참으로 위대한 업적을 이루었소.\n\n틀림없이 당신 진영의 지도자들도 당신의 영웅적 행적을 듣고 싶어 할 거요.",
  },
  [31033] = {
    ["T"] = "불운한 장애물",
    ["O"] =
    "저승바람 고개에서 악마에 대해 알고 있을 만한 사람을 찾으십시오.",
    ["D"] =
    "루멘스톤은 흔적도 없지만 악마 중 하나의 몸에서 서판을 발견했다. 자세히 살펴보니 알아볼 수 없는 악마의 언어로 쓰여 있다:\n\nRikk alar il xi zennrakkan lok Kirasath Raka ruk asj xi veni parn kar lok revola rukadare il 카라잔. Lok kamil buras naztheros arakalada xi daz veni. Rikk lok parn il asj xi Z gular maladath lok buras 칸레타드 il lok kamil. Kiel ashjrethul ante buras gul revos.\nIl kirasath Vorakem Zekulrakkas Archim il Aman Veni Kazzak.\n\n이 메시지를 해독하려면 도움이 필요하다. 몇 가지 환경적인 흔적을 보건대, 최근 지배자의 지하실을 방문한 사람이 우리뿐만이 아닌 듯하다. 운이 좋다면 그들이 아직 저승바람 고개 어딘가에 있을지도 모른다.\n\n탑을 둘러싼 정령들, 오우거들, 그리고 이젠 악마들까지, 그들은 과연 어디에 숨어있을까?",
  },
  [31034] = {
    ["T"] = "도움을 얻기 위한 도움",
    ["O"] =
    "저승바람 고개의 낯선 이는 악마들이 훔쳐 간 루멘스톤을 찾을 수 있는 최선의 선택일 가능성이 큽니다. 마나 회복 버프를 주는 음식과 술을 그에게 가져가야 합니다.",
    ["D"] =
    "도와줄 수는 있지. 하지만 이런 일엔 절차가 있기 마련이지... 먼저 자네가 날 좀 도와줘야겠어.\n\n보다시피, 내 꼴이 말이 아니야. 지하실에서 탈출하느라 한계 이상으로 무리해서 힘을 끌어썼거든.\n\n내 마력을 회복하는 걸 도와주면 자넬 돕도록 하지. 마나 회복력을 오래 지속시켜 줄 음식과 그걸 깔끔하게 넘길 수 있는 술을 좀 가져다주면 기적이 일어날 거야. 자네가 다녀오는 동안 난 서판 해독을 시작하지.",
  },

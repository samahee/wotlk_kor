  [26951] = {
    ["T"] = "시간의 길에 관한 문제",
    ["O"] = "아제로스의 위험한 곳을 수색하여 다른 시간의 왜곡이 있는지 찾으십시오.",
    ["D"] =
    "안돌할의 시간의 왜곡은 제 감각을 간지럽히는 유일한 시간 이상이 아닙니다. 더 큰 문제가 배후에 도사리고 있는 것 같습니다. 시간의 길에 관한 한, 제 감각은 한 번도 틀린 적이 없죠.\n\n친구여, 저와 용군단은 다시 한번 당신의 도움이 필요합니다. 저는 남아서 이 작은 문제를 해결해야 하지만, 세상의 다른 지역들도 시간 기생충들의 영향을 받고 있을지도 모릅니다. 정확히 어디인지 말씀드릴 수는 없지만, 세상에서 가장 위험한 곳을 수색한다면 무언가 찾을 수 있으리라 믿습니다. 무엇을 발견했는지 알려주세요. 행운을 빕니다!",
  },
  [26952] = {
    ["T"] = "시간의 길이 엇갈리다?",
    ["O"] = "크로미의 시간 이동 장치를 사용해 여명의 설원에서 발견한 변형 지형을 조사하여 무엇이 나오는지 확인하십시오.",
    ["D"] =
    "이러한 변형 지형들이 불타는 군단이 아제로스에 강한 세력을 유지하고 있는 지역에만 존재하는 것이 과연 우연의 일치일까요... 아닐까요? 군단이 힘의 거점에 시간의 길을 조작했다는 단서를 남긴 것이 너무 뻔하게 느껴집니다.\n\n전 확신할 수 없어요, $N. 자, 이 시간 이동 장치를 가지고 안돌할의 사일로를 탐색했던 것처럼 여명의 설원의 변형 지형을 조사하세요. 무엇이 튀어나오는지 보죠. 그것이 군단의 소행인지, 아니면 진짜 배후가 누구인지 단서를 줄 것입니다.",
  },
  [26953] = {
    ["T"] = "너덜너덜한 입학 허가서",
    ["O"] = "너덜너덜한 입학 허가서를 서부 역병지대 다로우미어 호수 한가운데에 있는 카엘 다로우 섬으로 가져가십시오.",
    ["D"] =
    "당신은 편지가 들어있는 너덜너덜한 봉투를 발견했습니다.\n\n편지는 카엘 다로우 섬에 위치한 모종의 학술 기관으로 초대하는 내용이 적혀 있으며 고급 양피지로 작성되었습니다. 편지에는 마법과 무기에 대한 이야기가 있지만 구체적인 세부 내용은 나와 있지 않습니다. 수신자의 이름이 없고 편지의 아랫부분도 사라진 상태입니다.\n\n이 교육 기관에 대해 조사해 보시겠습니까?",
  },
  [26954] = {
    ["T"] = "활제작자의 부탁",
    ["O"] = "매리스 농장에서 순찰자 매리스의 기록을 회수하여 서리바람 야영지에 있는 마리엘 듀폰트에게 가져가십시오.",
    ["D"] =
    "$C, 저와 이야기해주셔서 감사합니다. 저는 보잘것없는 사냥꾼으로서 당신의 도움을 구하고자 합니다. 유명한 순찰자 나타노스 매리스는 동부 역병지대라 불리는 곳에 집을 가지고 있었습니다. 스컬지가 오기 전 그는 저의 영웅이었고, 저는 그의 기록이 남아있는지 확인하기 위해 그곳으로 여행할 생각이었습니다. \n\n역병지대의 짐승들은 제가 감당하기에는 너무나 두렵습니다. 저를 대신해 그의 장원 폐허를 수색해 주시겠습니까? 그가 사용하는 석궁을 어떻게 만드는지 알고 싶습니다. 그의 기록을 하나라도 발견하신다면 제게 가져와 주십시오.",
  },
  [26955] = {
    ["T"] = "활제작자의 부탁",
    ["O"] = "히포그리프나 독수리에게서 깃털 20개를 수집하여 서리바람 야영지에 있는 마리엘 듀폰트에게 가져가십시오.",
    ["D"] =
    "이 기록에 따르면, 순찰자 매리스는 자신의 인생 대부분을 보낸 쿠엘탈라스에서 발견한 재료들로 석궁과 화살을 직접 만들었다고 합니다. 쿠엘탈라스가 황폐해진 지금, 우리는 다른 곳에서 비슷한 재료를 찾아야 합니다.\n\n먼저 깃털이 필요합니다. 서부 역병지대, 아즈샤라, 혹은 더 먼 지역에서 서식하는 강력한 히포그리프나 독수리에게서 비슷한 깃털을 얻을 수 있을 거라 생각합니다.",
  },
  [26956] = {
    ["T"] = "활제작자의 부탁",
    ["O"] = "역병지대의 나무 장작더미에서 엘프 심재 10개를 수집하십시오.",
    ["D"] =
    "다음으로 석궁 몸체에 쓸 나무가 필요합니다. 기록에 따르면 나타노스는 하이 엘프들이 라오미르라고 부르는, 혹은 공용어로는 심재라고 부르는 나무를 사용했다고 합니다. 심재는 아주 훌륭한 무기 재료가 될 뿐만 아니라 난로에서도 오랫동안 타오르는 장점이 있죠.\n\n역병지대의 폐허 주변 장작더미에 아직 심재가 남아 있을지도 모릅니다. 한번 뒤져볼 생각이 있으신가요?",
  },
  [26957] = {
    ["T"] = "활제작자의 부탁",
    ["O"] = "검은바위 첨탑에 있는 트롤들에게서 단단히 감긴 석궁시위를 수집하십시오.",
    ["D"] =
    "마지막 재료는 구하기 아주 까다로울 겁니다, $N. 순찰자 매리스는 쿠엘탈라스에서만 만들 수 있는 마법 부여된 엘프의 실을 활시위로 썼습니다.\n\n<마리엘이 한숨을 쉽니다.>\n\n우리가 그 실을 더 구할 방법은 없지만, 검은바위 부족 오크들과 동맹을 맺은 트롤들이 원거리 무기의 달인이라는 소문을 들었습니다. 아마도 그들이 사용하는 활시위가 훌륭한 대체품이 될지도 모릅니다. 그걸 확인하려면 검은바위 첨탑 깊숙한 곳으로 들어가야 할 것입니다.",
  },
  [26958] = {
    ["T"] = "영웅 숭배",
    ["O"] = "동부 역병지대 매리스 농장에 있는 나타노스 블라이트콜러와 대화하십시오.",
    ["D"] =
    "$C, 저와 이야기해주셔서 감사합니다. 저는 당신의 도움을 간절히 바라는 보잘것없는 사냥꾼입니다. 유명한 순찰자 나타노스 매리스가 언데드 상태로 우리 호드의 동맹이 되었다는 소식을 들었습니다. 스컬지가 오기 전 그는 제 영웅이었고, 저는 직접 그를 만나러 그의 집으로 여행할 계획이었습니다. \n\n역병지대의 짐승들은 제가 감당하기에는 너무 두렵습니다. 절 대신해 순찰자 매리스와 이야기해주시겠습니까? 그가 사용하는 석궁을 만드는 방법을 배우고 싶습니다.",
  },
  [26959] = {
    ["T"] = "영웅 숭배",
    ["O"] = "히포그리프나 독수리에게서 깃털 20개를 수집하여 동부 역병지대 매리스 농장에 있는 나타노스 블라이트콜러에게 돌아가십시오.",
    ["D"] =
    "<나타노스가 한숨을 쉽니다.>\n\n언데드의 삶은 가끔 참 지루해. 당장은 별로 할 일이 없군. 네가 재료를 구해 온다면 기초를 알려주지.\n\n먼저 깃털이 필요하다. 서부 역병지대나 그 너머에서 서식하는 강력한 히포그리프나 독수리에게서 얻을 수 있을 거다.",
  },
  [26960] = {
    ["T"] = "영웅 숭배",
    ["O"] = "역병지대의 나무 장작더미에서 엘프 심재 10개를 수집하십시오.",
    ["D"] =
    "간단한 일로 시작했군. 다음 일은 훨씬 쉬울 거다.\n\n쿠엘탈라스에서 자라는 나무의 심재는 최고의 활을 만들지. 쿠엘탈라스는 파괴되었으니 주변을 둘러보며 로데론 폐허에 남겨진 장작더미에서 심재를 찾아봐라. 당장 시작해!",
  },
  [26961] = {
    ["T"] = "영웅 숭배",
    ["O"] = "검은바위 첨탑에 있는 트롤들에게서 단단히 감긴 석궁시위를 수집하십시오.",
    ["D"] =
    "허드렛일은 다 끝났군, $C. 이제 활시위만 있으면 돼. 과거에 나는 쿠엘탈라스에서만 생산되는 마법이 깃든 엘프의 실을 사용했었어. 당연히 넌 대체품을 찾아야겠지.\n\n검은바위 오크와 동맹을 맺은 트롤들이 원거리 무기의 달인이라는 소문을 들었다. 어쩌면 그들이 쓰는 활시위가 괜찮은 대체품이 될 수도 있겠어. 하지만 그건 네가 검은바위 첨탑의 깊은 곳까지 내려가 봐야 알 수 있겠지... 난 네가 돌아올 때까지 기다리진 않을 거다.",
  },
  [26962] = {
    ["T"] = "영웅 숭배",
    ["O"] = "보루에 있는 쉘돈 그림스비에게 순찰자 매리스의 기록을 가져가십시오.",
    ["D"] =
    "좋아, 필요한 건 다 모였군. 이것들을 가지고 뭘 해야 할지 적어 둔 기록이 여기 있다.\n\n이제 네가 왔던 곳으로 돌아가라.",
  },
  [26963] = {
    ["T"] = "학교 첫날",
    ["O"] = "스칼로맨스 학교 교직원과 대화하여 개설된 강좌에 대해 알아보고 해당 서류에 서명하십시오.",
    ["D"] =
    "가장 먼저 명심해야 할 점은, 이곳은 평범한 학술 기관이 아니라는 것입니다. 우리는 느슨한 안내와 함께 자기주도적이고 실용적인 직접 체험 학습을 권장합니다. \"변호사\"로 알려진 아주 고약한 구울 한 명이 학교와 학생들을 \"배상 책임\"과 \"너무 많은 참견꾼들\"로부터 보호하기 위한 서류에 당신의 서명을 받아야 한다고 하더군요. 흠.\n\n마법과 무술은 그 자체로 위험하며, 특히 초보자가 다룰 때 더더욱 위험하다는 것은 사실입니다. 이 필수 절차를 핑계 삼아 아트우드 박사님, 한론 박사님, 요리사 픽맨 선생님, 그리고 감독관 필립스 선생님 등 교직원들과 인사를 나눠보십시오.",
  },
  [26964] = {
    ["T"] = "복장 규정 준수",
    ["O"] = "카엘 다로우에 있는 이자벨라 픽맨에게 부패한 거미줄 8개를 가져가십시오.",
    ["D"] =
    "첫 번째 수업은 가정학입니다. 학교 예산이 빠듯하기 때문에 학생들은 본인의 교복을 만들 원자재를 직접 조달해야 합니다. 다행히 이건 꽤 쉬운 일입니다.\n\n역병지대에 사는 거미들은 엄청나게 부패한 거미줄을 내뿜습니다. 교복을 만들 만큼 충분한 양을 모을 때까지 녀석들을 처치한 뒤, 그 거미줄을 가정학 선생님인 이자벨라 픽맨 선생님께 가져다주세요. 안돌할 폐허 북쪽, 가마솥 들판 주변이나 목재소 위쪽에서도 이 거미들을 찾을 수 있을 겁니다. 서두르세요!",
  },
  [26965] = {
    ["T"] = "복장 규정 준수",
    ["O"] = "샬롯을 처치하고 그녀의 실젖을 이자벨라 픽맨에게 가져가십시오.",
    ["D"] =
    "네가 교복 재료를 구하러 간 사이에 내 베틀의 북이 망가졌단다. 노스렌드에 사람을 보내서 새로 가져와야 한다면 꽤 오래 걸리겠지만, 다행히 여기서 해결할 방법을 알고 있지.\n\n이 지역 거미 군락의 여왕은 현지인들이 샬롯이라 부르는 거대한 짐승이야. 녀석의 실젖이 내 베틀에 딱 맞는 크기일 것 같구나. 펠스톤 농장 북서쪽 동굴에서 그녀를 찾을 수 있단다. 이걸 네 첫 번째 추가 점수 기회로 생각하렴.",
  },
  [26966] = {
    ["T"] = "학교 둘째 날",
    ["O"] = "스칼로맨스 학원 휘장을 장착하십시오.",
    ["D"] =
    "반갑습니다, $N. 첫째 날을 무사히 넘기신 걸 보니 다행이군요. 입학생의 12퍼센트는 그러지 못하니까요.\n\n이제 교복을 구하셨으니 자부심을 가지고 입을 준비가 되셨습니다. 공식적으로 우리 학교의 지도를 받게 된 것을 환영합니다. 유령군단 파이팅!",
  },
  [26967] = {
    ["T"] = "스컬지 식물학",
    ["O"] = "흐느끼는 동굴에서 곰팡이 표본 6개를 구해 아트우드 박사에게 가져가십시오.",
    ["D"] =
    "수업에 온 걸 환영한다, $N. 역병지대를 휩쓴 스컬지는 이 지역에 사는 모든 생물에게 상흔을 남겼단다. 난 네가 흐느끼는 동굴에 사는 진흙괴물들의 진화 과정을 연구했으면 좋겠구나. 숙제는 그 생물들에게서 곰팡이 표본 6개를 구해오는 것이다. 동부 역병지대를 관통하는 길을 따라 동쪽으로 다리가 나올 때까지 간 뒤 강을 따라 북쪽으로 올라가면 동굴이 나온단다.\n\n만약 그들의 대장인 군주 클라크를 만나면 멀찍이 피해 가는 걸 추천하마.",
  },
  [26968] = {
    ["T"] = "스컬지 식물학",
    ["O"] = "북부 산마루 벌목장의 흙더미에서 오염되지 않은 엘윈 숲 흙 표본을 구하십시오.",
    ["D"] =
    "흥미롭군. 네가 가져온 표본은 스컬지 역병으로 만들어진 것치고는 내가 예상했던 것보다 훨씬 더 섬세하구나. 아무래도 수업 계획을 수정해야겠다.\n\n달슨의 눈물 북쪽의 북부 산마루 벌목장에 있는 어리석은 붉은십자군 놈들이 이곳에 건강한 나무를 다시 심으려고 엘윈 숲에서 엄청난 양의 흙을 가져왔다더구나. 이 지역 특유의 끔찍하고 질척이는 흙에 곰팡이 표본을 하나 심을 거지만, 엘윈 숲에서 가져온 흙에 심으면 어떤 일이 일어나는지 지켜보고 싶구나. 그 흙을 좀 가져오렴!",
  },
  [26969] = {
    ["T"] = "스컬지 식물학",
    ["O"] = "준비된 흙에 곰팡이 표본을 심고 그 결과를 관찰하십시오.",
    ["D"] =
    "네가 진짜 식물학을 어떻게 다루는지 한번 볼까. 이 흙 표본과 곰팡이, 그리고 물뿌리개를 광장 위쪽에 있는 빈 화분으로 가져가거라. 화분을 흙으로 채우고 곰팡이를 심으렴. 물뿌리개로 물을 조금 주고 그 결과를 관찰해 봐. 그리고 나에게 보고하거라.",
  },
  [26970] = {
    ["T"] = "썩은 고기로 요리하기",
    ["O"] = "청소부 독수리에게서 유난히 큰 알 4개를 모아 이자벨라 픽맨에게 가져가십시오.",
    ["D"] =
    "네 가정학 교사로서, 네가 스칼로맨스 학원에서 공부하는 동안 스스로 몸을 챙길 수 있도록 돕는 것이 내 임무란다. 학업은 매우 힘들고 심약한 자들에게는 어울리지 않지. 네가 앞으로 겪을 시련을 견뎌낼 수 있도록 특별한 비약을 준비했단다. 우선 안돌할 폐허 북쪽이나 호수 남쪽 가장자리에 서식하는 독수리에게서 유난히 큰 알들을 가져오렴. 둥지에 있는 알은 안 돼! 그건 역병에 걸렸거든. 살아있는 새가 낳은 알이 필요하단다.",
  },
  [26971] = {
    ["T"] = "썩은 고기로 요리하기",
    ["O"] = "부패한 호수 트레샤돈에게서 트레샤돈 타액선을 구해 이자벨라 픽맨에게 돌아가십시오.",
    ["D"] =
    "다로우미어 호수에는 평범한 물고기들과 가끔 트레샤돈이 살곤 했지. 스컬지의 역병이 물고기들을 죽였지만 트레샤돈은 살아남았어. 더군다나 이전보다 훨씬 공격적이고 독성이 강해진 모습으로 변해버렸지. 녀석들의 타액선에는 근육을 키우고 활력을 되찾아 주는 강력한 혼합물이 들어 있단다. 이게 바로 우리의 비밀 재료지!\n\n온전한 타액선을 구할 때까지 트레샤돈들을 사냥하렴. 그럼 이제 혼합을 시작해 볼까!",
  },
  [26972] = {
    ["T"] = "추가 학점",
    ["O"] = "붉은십자군 벌목꾼에게서 암흑 저항 공책 4권을 수집해 학장 블랙우드에게 가져가십시오.",
    ["D"] =
    "$N, 네가 이 학교 수업을 통과할 수 있을지 초조해할 것 같아서 특별한 제안을 하나 하마. 붉은십자군은 그들의 벌목꾼들에게 암흑 마법으로 손상시키기 어려운 특수 공책을 배급한단다. 스컬지의 오염이 묻지 않은 종이에 편지를 써서 고향의 가족에게 보낼 수 있다나 뭐라나. 정말 터무니없는 소리지만--우리 학교의 부주의한 강령술 학생들에게는 완벽한 공책이지.\n\n당연하게도 벌목꾼들은 북쪽의 붉은십자군 제재소에 있단다. 우리 학교의 공책 재고를 채워주면 네 성적표에 보너스 점수를 주마.",
  },
  [26973] = {
    ["T"] = "고급 연금술",
    ["O"] = "채집용 주사기를 사용해 흐느끼는 동굴에서 진흙괴물 표본 세 개를 얻으십시오.",
    ["D"] =
    "흐느끼는 동굴은 변이된 진흙괴물들의 자연 생태를 관찰하기에 아주 매력적인 장소다. 녀석을 애완동물로 삼아보려고 했지만 알맞은 기질을 가진 녀석을 찾기가 너무 어려웠어. 얌전하고, 미끈거리지만 너무 미끈거리지는 않아야 하며, 역겨우면서도... 오, 내가 무슨 말을 하고 있었지? 아, 그래, 연금술 수업 중이었지.\n\n우리가 완벽한 진흙괴물을 애완용으로 사육할 수 있을지 연구가 필요하다. 이 주사기를 가지고 죽은 진흙괴물에게서 표본을 채취해라. 세 개 정도면 충분할 거야.",
  },
  [26974] = {
    ["T"] = "고급 연금술",
    ["O"] = "감독관 필립스에게 말을 걸어 실험을 시작하십시오.",
    ["D"] =
    "표본이 다 모였으니 내 조수인 감독관 필립스에게 다음 실험을 진행하게 하마. 만약 내가 예상한 대로 물질이 반응한다면 필립스를 보호해 줄 누군가가 필요할 거다. 안뜰 벽 밖, 선착장으로 가는 길목 동쪽에서 감독관 필립스를 찾거라.\n\n그리고 $N, 말할 것도 없이 이게 바로 이번 수업의 네 시험이 될 거다.",
  },
  [26975] = {
    ["T"] = "고급 연금술",
    ["O"] = "실험이 끝날 때까지 감독관 필립스를 보호하십시오.",
    ["D"] =
    "여기 서라. 시험 시작 곧 한다. 끈적거리는 거 많아. 진흙괴물 많아. 방어해. 행운 빈다.",
  },
  [26976] = {
    ["T"] = "역사 101",
    ["O"] = "바로브 납골당 지하에 있는 명판의 내용을 베껴 쓰십시오.",
    ["D"] =
    "역사 시간이다. 주위를 둘러보거라, $N. 이 돌들이 말을 할 수 있다면, 우리 학교를 위해 이 땅을 기증한 위대한 바로브 가문의 역사를 어떻게 들려줄 수 있을지 생각해 보렴.\n\n나는 그들의 무덤이 생생하게 남아있을 때 바로브 가문의 역사를 기록하고 싶단다. 존경받는 우리 교수진들이 학교 안에 묻혀있는 반면, 그들의 조상들은 다른 곳에 모셔져 있지. 서쪽 호수 건너편에 슬픔의 언덕 묘지가 있다. 바로브 가문의 선조들을 모신 납골당이 그곳에 있지. 납골당 깊숙한 곳으로 들어가 그곳에 묻힌 모든 자들의 이름을 가져오거라.",
  },
  [26977] = {
    ["T"] = "역사 101",
    ["O"] = "알렉세이 바로브의 유령과 대화하십시오.",
    ["D"] =
    "서둘러 명단을 받아 적는 당신의 등 뒤에서 묘한 소리가 들립니다.\n\n이전에는 없었던 영적인 형체가 나타납니다. 유령이 당신에게 가까이 오라며 손짓합니다. 한번 말을 걸어보시겠습니까?",
  },
  [26978] = {
    ["T"] = "역사 101",
    ["O"] = "이 정보를 가지고 카엘 다로우의 한론 박사에게 돌아가십시오.",
    ["D"] =
    "이제 당신은 제 이야기를 알게 되었으니 기록을 바로잡아 주십시오. 언젠가 암흑스승 간들링이 저를 가두고 있는 구속을 푼다면 제 영혼도 편히 쉴 수 있겠지요. 그 전까지는 세상에 단 한 사람이라도 진실을 알고 있다는 사실에 만족하겠습니다. 빛의 축복이 함께하길, $C. 저는 빛에게 버림받았지만 말이오.",
  },
  [26979] = {
    ["T"] = "졸업반의 장난",
    ["O"] = "하스글렌으로 이어지는 북쪽 길가에 있는 붉은십자군 야외 화장실에서 똥을 좀 구해오십시오.",
    ["D"] =
    "이봐! 1학년! 여기야!\n\n학기가 끝나가고 있는데 난 멋지게 장식하고 싶어. 스칼로맨스 학교에 걸맞은 최고의 졸업반 장난을 칠 거야. 하지만 내가 졸업하려면 정말 공부를 해야 해. 현자 폴켈트는 날짜에 정말 엄격하거든.\n\n네가 나서줄 때가 온 거지. 내게 역사상 가장 완벽한 장난에 필요한 물건을 가져다주면 섭섭지 않게 보답할게! 먼저 냄새나는 게 좀 필요해. 달슨의 눈물 북동쪽, 하스글렌으로 이어지는 길가 방어선 근처에 붉은십자군의 화장실이 있어. 거기서 똥을 좀 가져다줘!",
  },
  [26980] = {
    ["T"] = "졸업반의 장난",
    ["O"] = "붉은십자군 기원사에게서 유황 조각을 수집하십시오.",
    ["D"] =
    "다음으로 순식간에 불을 낼 수 있는 게 필요해. 붉은십자군 기원사들은 화염 마법에 쓸 시약으로 유황 조각을 들고 다녀. 아마 제격일 거야. 그것도 하나 가져다줘. 이 장난은 완전 대박일 거라고!",
  },
  [26981] = {
    ["T"] = "졸업반의 장난",
    ["O"] = "우서 경의 무덤, 보루, 그리고 서리바람 야영지에 똥자루를 놓고 불을 붙이십시오.",
    ["D"] =
    "나 라베니안을 상대로 한 실기 시험에 낙제할 뻔했는데 머리카락이 다시 자란 걸 보고 만회할 기회를 주기로 했어. 그래서 네가 이 장난을 완성해줘야 해.\n\n내가 우서 경의 무덤, 서리바람 야영지, 보루에 똥자루를 갖다 놨어. 가서 불을 붙이고 와, $N. 완전 고전이지! 그리고 혹시 누가 이런 짓을 했냐고 물어보면 내가 했다고 꼭 말해줘.\n\n물론 묻는 사람이 선생님이라면, 네가 한 짓이야.",
  },
  [26982] = {
    ["T"] = "학교 마지막 날",
    ["O"] = "학장 블랙우드와 성적표를 확인하십시오.",
    ["D"] =
    "자 $N, 네가 입문 과정을 모두 수료한 것 같구나. 여전히 살아있고 팔다리가 모두 멀쩡하다는 건 좋은 징조지. 네 성적표를 이리 다오. 네가 얼마나 잘했는지 보자꾸나.",
  },
  [26983] = {
    ["T"] = "티리온 폴드링을 향한 초대",
    ["O"] = "동부 역병지대 경계의 강변에 있는 티리온 폴드링에게 한론 박사의 초대장을 전달하십시오.",
    ["D"] =
    "잠깐만, $N. 가기 전에 할 말이 있다. 내 역사 수업에 통과시켜주지 못해서 미안하구나. 하지만 운이 좋네. 내게 작은 심부름을 하나 해주면 다시 내 눈에 들 기회가 있어.\n\n네가 사람들과 대화하는 데 소질이 있다는 걸 보여줬으니, 스컬지에서 살아남았다고 최근에 알게 된 유명 인사와 대화해 줬으면 좋겠구나. 그의 이름은 티리온 폴드링이고, 한때 로데론 사교계의 저명한 인물이었지. 그의 기사단을 배신하는 기분이 어떤지 인터뷰하고 싶다.\n\n그에게 이 인터뷰 요청서를 전해주거라. 그는 동부 역병지대, 톤드로릴 강 북쪽 끝에 살고 있단다.",
  },
  [26984] = {
    ["T"] = "현장 견학",
    ["O"] = "동부 역병지대 다로우미어 호수 기슭에서 스탈링 교수를 찾으십시오.",
    ["D"] =
    "다로우미어 호수 북쪽 기슭에서 우리의 현장 실습 강사인 스탈링 교수를 만날 수 있을 거다. 그녀가 보충 수업 과정을 소개할 거란다. 입문 과정이 어려웠다고 생각했다면... 이 교육 과정은 완전히 치명적일 테지. 잘 가거라, $N.",
  },
  [26985] = {
    ["T"] = "아카데미 입학",
    ["O"] = "서부 역병지대의 카엘 다로우 섬에 있는 학장 블랙우드와 대화하십시오.",
    ["D"] =
    "반갑습니다. 저는 무술과 마법을 가르치는 전문 학원의 대표자인데, 당신이 마법과 무기를 잘 다루는 것 같군요. 당신을 저희 학교의 입문 과정에 정식으로 초대하여 학교에 적합한 인재인지 확인하고 싶습니다. 이 소개장을 서부 역병지대 카엘 다로우 섬에 있는 학장 블랙우드에게 가져가 시작하십시오.\n\n이 편지를 수락함으로써 방문 학생 규정과 기밀 유지 협약에 동의하게 됩니다. 우리는 배경 조사, 이해충돌 평가, 또는 신들림 검사를 실시할 수 있습니다.\n\n스칼로맨스 학원에서 뵙기를 기대하겠습니다. 유령군단 파이팅!",
  },
  [26986] = {
    ["T"] = "아카데미 입학",
    ["O"] = "서부 역병지대의 카엘 다로우 섬에 있는 학장 블랙우드와 대화하십시오.",
    ["D"] =
    "반갑습니다. 저는 무술과 마법을 가르치는 전문 학원의 대표자인데, 당신이 마법과 무기를 잘 다루는 것 같군요. 당신을 저희 학교의 입문 과정에 정식으로 초대하여 학교에 적합한 인재인지 확인하고 싶습니다. 이 소개장을 서부 역병지대 카엘 다로우에 있는 학장 블랙우드에게 가져가 시작하십시오.\n\n이 편지를 수락함으로써 방문 학생 규정과 기밀 유지 협약에 동의하게 됩니다. 우리는 배경 조사, 이해충돌 평가, 또는 신들림 검사를 실시할 수 있습니다.\n\n스칼로맨스 학원에서 뵙기를 기대하겠습니다. 유령군단 파이팅!",
  },
  [26987] = {
    ["T"] = "귀향",
    ["O"] = "데피아즈단에게서 낸시의 땋은 머리카락을 되찾아 도널드 이스트워스에게 보여주십시오. 그리고 그가 가족에게 돌아오도록 설득해 보십시오.",
    ["D"] =
    "저기요! 잠시만 머물다 가주실 수 있나요?\n\n사과드릴게요. 제 딸이 조금... 겁을 먹었거든요. 데피아즈단이 나타난 후로 정신을 차리기가 너무 힘드네요. 제 남편 도널드가 사랑하는 농장과 가족을 버리고 그들과 합류하기로 했다는 걸 믿으실 수 있나요!? 어떻게 저와 어린 티나를 두고 떠날 수 있죠?\n\n제가 남편의 마음을 돌리려고 설득해 봤지만, 그 후에 그의 새 친구들이 우릴 찾아왔어요. 우린 너무 무서웠죠! 그들은 우리 딸은 다치게 하지 않았지만... 제 머리카락을 자르고 농장에서 쫓아냈어요. 제게 경고하기 위해서였죠. 그들이 저를 모욕할 때의 그 포식자 같은 눈빛은 결코 잊지 못할 거예요. 그들은 제 땋은 머리카락을 전리품으로 가져가며, 다시 참견하면 더 심한 꼴을 당할 거라고 경고했어요.\n\n그 후로 저는 남편에 대한 소문만 들었어요. 그가 그늘숲에서 문브룩으로 가는 불행한 상인들을 노린다고 하더군요. 제발, 그 고집불통 영감이 우리에게 돌아오도록 설득해 주세요. 우린 이제 살 집도 없고 도널드의 새 동료들은 독수리처럼 감시의 언덕을 배회하고 있어요! 데피아즈단 중 한 명에게서 제 머리카락을 찾아 남편에게 보여주신다면, 그의 새 친구들이 어떤 자들인지 경고가 될지도 몰라요.",
  },
  [26988] = {
    ["T"] = "고집불통 사나이",
    ["O"] = "낸시 이스트워스와 대화하십시오.",
    ["D"] =
    "이런 옛말이 있죠. 피할 수 없으면 즐겨라. 스톰윈드의 관료들이 서부 몰락지대 사람들에게 신경 쓰지 않는다면, 우리가 직접 나서야 합니다. 맞아요, 민병대원들이 있긴 하지만, 전 이곳의 진정한 권력을 따를 겁니다.\n\n잘 들으세요. 몇 주 후면 사우스쇼어에 집을 빌릴... 아니, 집을 지을 만큼 돈을 모을 겁니다. 전 위험을 감수해야 했고 낸시도 그걸 받아들여야 해요 -- 그리고 데피아즈단을 조금 더 존중하는 태도를 취해야 하고요.\n\n하지만 제가 낸시를 그리워한다고 전해주세요. 제가 그들을 사랑하고 곧 돌아갈 거라고요. 그리고 돌아갈 땐, 이 저주받은 붉은 복면과 함께 과거를 뒤로하고 떠날 거라고요!\n\n이제, 절 내버려 두세요. 고블린 상인이 곧 다리를 건널 거라는 소식을 들었거든요. 그 일이 벌어질 때 여기에 있고 싶지 않으실 겁니다.",
  },
  [26989] = {
    ["T"] = "엄지 척, 사람 하나 쓰러짐",
    ["O"] = "피투성이가 된 도널드의 엄지손가락을 낸시 이스트워스에게 가져가십시오.",
    ["D"] =
    "푼돈 몇 푼 벌자고 우리 모두의 목숨을 위험에 빠뜨리는 그 늙은 광대를 더 이상 기다리지 않겠어요.\n\n처음엔 머리카락을 잃었지만, 다음번엔 목에 칼이 들어올지, 아니면 더 심한 일을 당할지도 몰라요! 아, 빛이여 우릴 인도하소서! 앞으로 다가올 어두운 시절을 이겨내려면 빛이 필요해요.\n\n티나와 저는 지금 당장 강해지고 자립해야 해요. 우린 떠날 거예요. 설령 제가 티나를 등에 업고 검은바위 산을 넘어야 한다 해도 -- 우린 계속 나아가야 해요. 하지만 우리의 미래를 보장받기 위해 당신에게 마지막으로 한 가지 부탁을 드릴게요. 도널드에게 평생 잊지 못할 교훈을 가르쳐주세요.\n\n데피아즈단이 저를 위협했던 것처럼, 그를 반 죽여놓으세요. 그가 그렇게 잃고 싶어 안달 난 그의 엄지손가락을 제게 가져오세요. 굳이... 그를 죽일 필요까진 없어요. 뼈 몇 개 부러뜨리는 거면 충분해요. 단지 그가 우릴 쫓아오지 못하게만 해주세요 -- 그가 가는 곳엔 불행이 따르니까요.",
  },
  [26990] = {
    ["T"] = "갈퀴발일족의 난동",
    ["O"] = "갈퀴발 놀 8마리와 갈퀴발일족 정찰병 8마리를 처치하고 감시의 언덕에 있는 민병대원 가리엘에게 돌아가십시오.",
    ["D"] =
    "민병대에게 도움이 필요합니다! 갈퀴발 놀들이 서부 몰락지대의 시민들을 공격하고 있습니다! 스톰윈드는 아무런 도움도 보내지 않고 있고, 우리는 스스로를 지켜야만 합니다. 우리를 돕고 싶으시다면 놀들을 상대로 공격을 이끌어 주십시오.\n\n북쪽 장고로드 광산과 펄브라우 호박밭 근처에서 그들의 야영지를 몇 군데 찾을 수 있습니다. 서부 몰락지대는 당신의 도움에 깊이 감사할 것입니다. 자, 어서 가서 이 괴물들을 끝장내 주십시오!",
  },
  [26991] = {
    ["T"] = "갈퀴발일족의 난동",
    ["O"] = "갈퀴발일족 싸움꾼 8마리와 갈퀴발일족 약초채집꾼 8마리를 처치하고 감시의 언덕에 있는 민병대원 가리엘에게 돌아가십시오.",
    ["D"] =
    "네 일이 끝났다고 생각했나? 천만에... 놀들의 야영지는 서부 몰락지대 곳곳에 흩어져 있어. 네 도움은 고맙지만 너무 자만하진 마. 무릎 꿇려야 할 놀들이 아직 많이 남아있으니까.\n\n황금해안 채석장 남쪽으로 가서 서부 몰락지대에 있는 놀들을 더 소탕해줘. 그들 무리의 더 강력한 녀석들이 경계를 서고 있는 야영지들을 찾을 수 있을 거야. 네가 이 임무를 감당할 수 있길 바라 -- 네가 죽는 건 보고 싶지 않거든.",
  },
  [26992] = {
    ["T"] = "갈퀴발일족의 난동",
    ["O"] = "갈퀴발일족 무법자 8마리와 갈퀴발일족 전사 8마리를 처치하고 감시의 언덕에 있는 민병대원 가리엘에게 돌아가십시오.",
    ["D"] =
    "네가 아직 살아있다니 꽤나 인상적인걸. 난 그 놀들이 널 죽일 거라고 생각했는데! 어쨌든, 정찰병들의 보고에 따르면 갈퀴발일족 놀들 중에서도 가장 강력한 녀석들이 여기 남쪽의 먼지 평원에 야영지를 세웠다고 해. 널 도와줄 병사들을 좀 보내주고 싶지만, 우리 병력도 너무 부족한 상태야. 네 혼자 힘으로 가야 할 것 같다.\n\n민병대의 이름으로 가서 그 놀들에게 정의의 심판을 내려줘! 서부 몰락지대는 더 이상 그들을 용납하지 않을 거야!",
  },
  [26993] = {
    ["T"] = "죽음의 들판",
    ["O"] = "낡은 허수아비골렘 10마리를 처치하고 얀센 농장에 있는 농부 펄브로우에게 돌아가십시오.",
    ["D"] =
    "이 땅의 꼬라지를 보쇼! 고블린들에게 기계 괴물을 만들어 이 들판으로 내보낸 데피아즈단 놈들에게 저주를 내리소서! 우리 농부들은 이런 걸 원치 않았소. 이 골렘들이 여기 있는데 내가 어떻게 가족과 불쌍한 늙은말 블랑쉬를 먹여 살릴 수 있단 말이오?\n\n근처에 있는 골렘들을 처치하는 걸 좀 도와주시겠소? 여기 바로 근처나 서쪽의 내 호박 농장 주변에서 놈들을 찾을 수 있을 거요. 제발 우릴 도와주시오! 스톰윈드는 우릴 버렸단 말이오.",
  },
  [26994] = {
    ["T"] = "죽음의 들판",
    ["O"] = "살딘 농장에 있는 농부 살딘과 대화하십시오.",
    ["D"] =
    "이 주변 골렘들을 잘 처리해 주었군. 하지만 이런 일을 겪고 있는 건 나만이 아니야. 내 좋은 친구인 살딘 역시 골렘들이 그의 농장을 파괴하고 있다고 말했었지. 혹시 그도 도와줄 수 있겠나? 그의 농장은 여기서 남쪽으로 가면 바로 나올 거라네.",
  },
  [26995] = {
    ["T"] = "죽음의 들판",
    ["O"] = "허수아비골렘 10마리를 처치하고 살딘 농장에 있는 농부 살딘에게 돌아가십시오.",
    ["D"] =
    "누군가 이 주변을 도와주고 있다니 정말 다행이군. 이 골렘들이 우리 시민들을 겁주고 있고, 이 문제를 빨리 해결하지 못하면 서부 몰락지대는 데피아즈단에게 점령당해 빼앗길까 봐 걱정이라네. 어쨌든 밖으로 나가 골렘들을 처치해 주게! 이 농장 바로 앞이나 서쪽에 있는 몰센 농장에서 놈들을 찾을 수 있을 거야.",
  },
  [26996] = {
    ["T"] = "죽음의 들판",
    ["O"] = "허수아비골렘 보초 10마리를 처치하고 살딘 농장에 있는 농부 살딘에게 돌아가십시오.",
    ["D"] =
    "아까 당신이 처치한 골렘들 말고도 우리 땅을 망치는 녀석들은 더 있다네! 내 농부 중 한 명이 황금해안 채석장 근처 알렉스턴 농장에서 다른 골렘들을 몇 마리 봤다고 하더군. 괜찮다면 골렘들을 좀 더 처치해 주면 정말 고맙겠네.",
  },
  [26997] = {
    ["T"] = "죽음의 들판",
    ["O"] = "허수아비골렘 수확기 10마리를 처치하고 살딘 농장에 있는 농부 살딘에게 돌아가십시오.",
    ["D"] =
    "대부분의 농장들을 되찾았지만, 싸워서 되찾아야 할 농장이 하나 남아 있다네. 감시의 언덕을 지나 여기서 남쪽으로 멀리 가면 죽음의 고토가 나오는데, 그곳엔 가장 강력한 골렘들이 돌아다니며 땅을 잿더미로 만들고 있지. 일꾼 몇 명을 데려가 보려고 했지만 골렘들이 우릴 쫓아냈다네! 자네가 이 일을 맡아 주었으면 좋겠네 $n. 이 골렘들은 장난이 아니야!",
  },
  [26998] = {
    ["T"] = "현상 수배: 약탈자 나르팡",
    ["O"] = "약탈자 나르팡을 처치하고 그의 발을 감시의 언덕에 있는 정찰대장 다누빈에게 가져가십시오.",
    ["D"] =
    "서부 몰락지대 시민들이여, 경고한다! 약탈자 나르팡이라 불리는 위험한 놀이 흩어져 있던 갈퀴발 부족을 규합하여 우리 땅을 위협하고 농장을 약탈하며 사람들을 공격하고 있다!\n\n그의 난동을 끝내줄 당신 같은 용감한 모험가가 필요하다. 나르팡은 감시의 언덕 남쪽 구릉지를 배회하는 것으로 알려져 있다. 용맹의 증표로 그의 발을 감시의 언덕에 있는 정찰대장 다누빈에게 가져오면 섭섭지 않게 보상할 것이다.",
  },
  [26999] = {
    ["T"] = "네크로쉬는 죽어야 한다",
    ["O"] = "족장 네크로쉬를 처치하고 그의 머리를 시장 오크마스터에게 가져가십시오.",
    ["D"] =
    "이제 가장 잔인한 놈, 네크로쉬를 상대할 차례입니다. 덩치도 엄청나고 그만큼 흉포하죠. 놈은 줄루마르에 있는 그 거대한 요새 밖으로 나오는 일이 거의 없습니다.\n\n당신이 쓰러뜨린 세 명의 우두머리들은 하루에 두 번씩 그에게 보고를 올리니 그들이 나타나지 않으면 의심할 것입니다. 당신이 당장 가서 그의 머리를 취해야 한다는 점에 대해서는 누구의 허락을 기다릴 필요도 없습니다.\n\n그곳 방어가 어떻게 되어있는지는 저도 모르니 조심하십시오.\n\n행운을 빕니다, $n.",
  },
  [27000] = {
    ["T"] = "일시적인 승리",
    ["O"] = "불타버린 마을의 승리 소식을 경비대장 스타우트피스트에게 전달하십시오.",
    ["D"] =
    "당신은 경비대장 스타우트피스트가 보낸 분이니 여기서 일어난 일을 그에게 말하는 것이 도리겠죠. 메네실에 있는 그에게 돌아가 우리가 더 이상 지원이 필요하지 않다고 알려주십시오.",
  },
  [27001] = {
    ["T"] = "굴다르 도박",
    ["O"] = "상층 늪지대에 있는 던 굴다르에 도착하여 시장에게 도움을 제안하십시오.",
    ["D"] =
    "이제 우리가 용아귀 부족에게 반격할 차례입니다. 그들의 야영지를 뚫고 던 굴다르 통로로 가주셔야겠습니다.\n\n메네실을 떠나 아까 그 전령을 찾았던 동쪽으로 향한 뒤, 남쪽으로 가십시오.\n\n그곳에 도착하면 서쪽으로 되돌아가 던 굴다르를 마주하게 될 겁니다.\n\n도착하면 불타버린 마을의 시장을 찾아 당신이 돕기 위해 왔다고 말하십시오.",
  },
  [27002] = {
    ["T"] = "최전방에 보고",
    ["O"] = "불타버린 최전선에 있는 사령관 스트롱본에게 보고하십시오.",
    ["D"] =
    "전 예전에 불타버린 마을의 시장이었습니다만 사람들이 던 굴다르 고개에서 실종되기 시작했을 때 그다지 심각하게 받아들이지 않았었죠... 딸꾹.\n\n그러다 놈들이 한밤중에 공격해 왔고 우리가 제대로 대응하기도 전에 마을 절반을 점령해 버렸소... 딸꾹!\n\n스트롱본이라는 이름의 우리 사령관은 아직 최전선에 있습니다. 용아귀 놈들이 우리의 좋은 에일을 가져가지 못하게 제가 여기서 계속 감시할 테니 가서 그에게 당신의 능력을 제공해 주시오... 딸꾹. 마을 동쪽으로 가면 바로 눈앞에 불타버린 마을이 보일 거요... 딸꾹.",
  },
  [27003] = {
    ["T"] = "평정심 유지",
    ["O"] = "미친 듯이 날뛰는 피난민 5명을 진정시키십시오.",
    ["D"] =
    "이런 힘든 상황에서 왜 민간인들은 이성을 잃는 걸까요?\n\n마치 머리 없는 닭처럼 뛰어다니면서 우리의 방어에 방해만 되고 있습니다. 그들에게 말을 걸어 정신을 차리게 한 뒤 안전한 던 굴다르로 향하게 하십시오.",
  },
  [27004] = {
    ["T"] = "그들을 밀어붙여라",
    ["O"] = "불타버린 마을에서 용아귀부족 숙련병 6명과 용아귀부족 수호병 6명을 처치하십시오.",
    ["D"] =
    "우리는 이곳에서 살기 위해 발버둥 치고 있지만, 지원군이 조금만 더 있다면 용아귀 부족을 몰아낼 수 있을 것입니다.\n\n그들의 최전선이 우리 방어의 최후 저지선에 닿아 있습니다. 우린 이곳에서 용아귀 부족을 물리치거나 아니면 죽거나 둘 중 하나입니다.\n\n최전선에 있는 숙련병들과 수호병들을 공격해 물리치고 나면, 진정으로 전세를 역전시킬 방법을 계획할 수 있을 겁니다.",
  },
  [27005] = {
    ["T"] = "전리품",
    ["O"] = "최전선에서 용아귀부족 무기 8개를 훔쳐 오십시오.",
    ["D"] =
    "이 공격을 늦추려면 보급선의 가장 중요한 부분, 즉 그들의 무기를 제거해야 합니다.\n\n저 오크 놈들은 매우 고통스러워 보이는 도끼, 단검, 검 등 거대한 무기 거치대를 가져왔습니다.\n\n최전선에서 그 무기들을 빼내어 우리가 쓸 수 있게 챙길 수만 있다면 용아귀 부족을 쫓아낼 수 있을 겁니다.",
  },
  [27006] = {
    ["T"] = "줄루마르의 눈",
    ["O"] = "줄루마르 근처 상층 늪지대에서 정찰병 발리브루를 찾으십시오.",
    ["D"] =
    "우리는 이 전투를 용아귀 부족의 요새인 줄루마르로 끌고 가야 합니다. 발리브루라는 이름의 우리 정찰병이 그 위에서 길을 감시하고 있으니 용아귀 부족이 군대를 언제 파견할지 알 수 있습니다.\n\n그는 줄루마르 안에서 벌어지는 일들을 꿰뚫고 있죠. 그를 찾으십시오. 그러면 그가 우리가 공격해야 할 정확한 목표 지점으로 당신을 안내할 것입니다.\n\n마지막 보고에 따르면, 그는 용아귀 부족이 던 굴다르에서 도망칠 때 부수고 간 마차 뒤에 숨어 있다고 합니다. 이 끔찍한 파괴라니... 어쩌다 이 지경이 된 걸까요?",
  },
  [27007] = {
    ["T"] = "아픈 곳을 찔러라",
    ["O"] = "줄루마르 외곽에 있는 정찰병 발리브루를 위해 용아귀부족 검귀 6명과 그들의 우두머리 조룩을 처치하십시오.",
    ["D"] =
    "네크로쉬가 마음대로 부릴 수 있는 가장 잔혹한 전사들은 검귀들입니다. 줄루마르 입구의 조잡한 감시탑에서 우리를 노려보는 잔혹한 문지기 조룩이 그들을 훈련시키죠.\n\n훈련의 근원을 차단한다면 머지않아 용아귀 부족은 가장 강한 전사들을 잃게 될 것입니다. 그렇게 되면 그들 사이에서 힘을 차지하기 위해 다투면서 내부 분열이 일어날 겁니다.\n\n강력한 지도력이 없다면 그들은 항상 예전의 방식으로 되돌아가곤 하죠.",
  },
  [27008] = {
    ["T"] = "불타버린 마을의 도살자들",
    ["O"] = "습지대에 있는 정찰병 발리브루를 위해 용아귀부족 학살자 6명과 야수조련사 모르를 처치하십시오.",
    ["D"] =
    "숫자로만 보면 용아귀부족 학살자들이 그들 중에서 가장 많은 '살해'를 기록하고 있습니다.\n\n그들은 야수조련사 모르와 함께 동틀 무렵 말을 타고 나가 길가의 여행자들을 공격하고 습지대의 야생동물들을 사냥합니다.\n\n그들을 쓰러뜨리는 것은, 용아귀 놈들이 자신들의 병사들을 먹여 살리지 못하게 된다는 걸 깨닫게 되었을 때 눈엣가시를 없애는 것 이상의 의미를 가지게 될 것입니다.\n\n용아귀부족 학살자들에게 그들이 한 짓을 똑같이 되돌려주고 그들과 함께 야수조련사도 처치해 주십시오.",
  },
  [27009] = {
    ["T"] = "대피 보고서",
    ["O"] = "최종 대피 보고서를 시장 오크마스터에게 전달하십시오.",
    ["D"] =
    "대피하는 사람들은 이게 마지막일 게 분명합니다. 당신은 나와 이 마을들에 큰 공헌을 해 주셨습니다. 이제 마침내 이 보고서를 시장님께 돌려드릴 수 있게 되었습니다.\n\n이것을 시장님께 가져다주시면 드디어 제 등 뒤에서 잔소리하는 일은 멈추겠군요.",
  },
  [27010] = {
    ["T"] = "대피 보고서",
    ["O"] = "롱뷰 전초기지의 하사관 마운틴뷰에게서 최신 대피 보고서를 받으십시오.",
    ["D"] =
    "용아귀 놈들이 아직 불타버린 마을을 완전히 밀고 들어온 건 아닙니다... 딸꾹. 구출될 수 있는 사람들이 더 있습니다... 딸꾹. 방금 지나쳐 왔던 마을 밖 롱뷰 전초기지에서 하사관 마운틴뷰를 찾으십시오.\n\n아직 떠나지 않은 사람들의 전체 보고서를 달라고 요청하시오. 지금쯤이면 남아있는 사람이 거의 없을 텐데... 딸꾹.",
  },
  [27011] = {
    ["T"] = "골렘 자이로스코프",
    ["O"] = "상층 늪지대의 던 굴다르에 있는 앵거스 시크바텀을 찾으십시오.",
    ["D"] =
    "우리 골렘이 고장 난 후 아버지께서 저를 이곳으로 보내셨고 전 여기서 부품이 오기를 몇 주째 기다리고 있어요.\n\n불행히도 그 이후로 저 망할 용아귀 놈들이 고개를 완전히 장악해버려서 지금은 제가 돌아갈 안전한 방법이 전혀 없습니다.\n\n제발 아버지께 제가 무사히 잘 지내고 있지만, 부품을 가져갈 수 없게 되었다고 전해주세요.\n\n아버지를 만나려면 메네실에서 동쪽으로 향해 용아귀 부족을 만난 뒤, 남쪽 던 굴다르 고개 너머 상층 늪지대로 가야 합니다. 그러고 나서 정서쪽으로 방향을 틀면 던 굴다르에 도착할 겁니다.",
  },
  [27012] = {
    ["T"] = "골렘 자이로스코프",
    ["O"] = "불타버린 마을의 대장간에서 자이로스코프 2개를 구하십시오.",
    ["D"] =
    "절박한 상황에는 절박한 수단이 필요한 법이고, 음... 골렘을 수리하지 않고는 난민들을 돕는 데 기여할 수가 없군요.\n\n용아귀 부족을 상대할 만큼 용감하신 분이니, 던 굴다르 바로 외곽에서 포위당한 불타버린 마을로 들어가 주실 수 있으신가요? 대장장이와 대부분의 주민들이 피난을 떠났다는 건 알지만, 그들이 잡동사니를 좀 남겨두었을지도 모릅니다.\n\n자이로스코프 두 개를 찾아봐 주세요. 그럼 이 골렘을 다시 움직일 수 있을지도 모릅니다.",
  },
  [27013] = {
    ["T"] = "골렘 자이로스코프",
    ["O"] = "앵거스의 농장에서 골렘 수리를 시도하십시오.",
    ["D"] =
    "자, 시작합시다! 이 골렘을 수리해서 움직이게 할 수 있다면 난민들에게 쉽게 식량을 제공할 수 있겠지만, 골렘 없이는 우린 아무것도 도울 수 없어요.\n\n이 자이로스코프들을 가져다가 골렘에 장착해 주세요. 움직이는지 한번 확인해 보자고요!",
  },
  [27014] = {
    ["T"] = "산양 목장 구출",
    ["O"] = "글로리 크램버를 설득하여 상층 늪지대에 있는 그의 집에서 대피시키십시오.",
    ["D"] =
    "불타버린 마을 북쪽의 산양 목장 크램버 일가는 대대로 이곳에서 살아왔고, 전 그 늙은 괴짜 글로리가 이사 가길 꺼린다는 걸 알아요.\n\n마치 저주받은 산처럼 몸집이 크고 그만큼 고집도 센 사람이죠. 절대 꼼짝하지 않을 겁니다!\n\n전 그들에게 떠나라고 설득해 봤지만 들은 척도 안 하더군요. 당신이 한 번 설득해 보는 건 어때요?",
  },
  [27015] = {
    ["T"] = "극단적인 조치",
    ["O"] = "불타버린 마을에 있는 숙련병들과 수호병들에게서 조잡한 용아귀 복장을 만들 재료를 회수하십시오.",
    ["D"] =
    "아버지는 심술궂고, 거만하고, 고집불통인 바보 노인입니다. 지평선 너머로 연기가 피어오르는 게 보여요. 저는 전에도 농장 주위를 몰래 돌아다니는 용아귀 놈들을 본 적이 있고, 불타버린 마을에서 들려오는 비명을 아주 똑똑히 들을 수 있습니다.\n\n하지만 아니, 아버지는 공격이 일어났다는 걸 인정하려 하지 않아요. 왜냐하면 직접 보지 못했으니까요. 계속 이게 다 사기극이고 앰버스틸 가문이 차지하려는 속셈이라고 횡설수설하고 계세요.\n\n이럴 땐 극단적인 조치가 필요합니다. 불타버린 마을로 가서 장비들을 모아 용아귀부족으로 위장할 부품들을 충분히 모아오세요. 제게 계획이 있습니다....",
  },
  [27016] = {
    ["T"] = "극단적인 조치",
    ["O"] = "용아귀부족으로 위장하여 두 곳의 산양 방목장과 마구간에 불을 지르십시오.",
    ["D"] =
    "이제 당신에게 좀 극단적인 부탁을 하나 해야겠네요, $c. 아까 구한 위장복을 입고 이 방목장에서 저 방목장으로 돌아다니며 불을 지르고 산양들을 쫓아내 주세요.\n\n네... 알아요... 너무 극단적이라는 거. 하지만 아버지는 우리가 실제로 위험에 처하기 전까진 믿지 않으실 거예요. 용아귀 놈들보다 당신이 하는 게 낫습니다.",
  },
  [27017] = {
    ["T"] = "고원지대 대피",
    ["O"] = "루시 일가를 설득해 대피시키십시오.",
    ["D"] =
    "불타버린 마을의 남쪽에서 루시 가족을 찾을 수 있을 겁니다. 이곳에 사는 유일한 인간들이죠.\n\n그들은 서부 몰락지대를 떠난 후 땅과 연못이 있는 작고 예쁜 집을 샀습니다. 이 지역에서 가장 훌륭한 작물을 재배하는 사람들이에요.\n\n그들이 이쪽으로 오는 걸 못 봤습니다. 대피가 시급하다는 걸 다시 한번 알려줘야 할 것 같네요.\n\n제발, $n. 가서 그들과 이야기하고 용아귀 부족이 들이닥치기 전에 그들을 빠져나오게 하십시오.",
  },
  [27018] = {
    ["T"] = "일이 끝날 때까지",
    ["O"] = "개린의 옥수수 작물 10개를 수집하십시오.",
    ["D"] =
    "우리가 길을 나서서 이곳을 빠져나가려면 식량이 필요해요. 다행히 마지막 작물들이 수확할 준비가 거의 다 되었지만, 가족들이 떠날 준비를 하게 하면서 수확까지 할 수는 없습니다.\n\n근처 밭에서 옥수수를 수확해 가져갈 수 있게 준비해 주시면, 더 이상 귀찮게 하지 않고 곧바로 떠나겠습니다.",
  },
  [27019] = {
    ["T"] = "영웅이 찾기",
    ["O"] = "고원 외곽 연못에서 사라의 인형 '영웅이'를 찾으십시오.",
    ["D"] =
    "난 아무 데도 안 가! 연못 근처에서 내 인형 영웅이랑 놀고 있었는데 심술궂은 늙은 초록 괴물이 돌려주지 않았어.\n\n아빠는 우리가 떠날 거라고 하지만, 난 영웅이를 두고 가지 않을 거야!\n\n내 인형 찾아줘!",
  },
  [27020] = {
    ["T"] = "여기서 나가자",
    ["O"] = "사디라 아이언비트를 불타버린 마을 밖으로 안전하게 호위하십시오.",
    ["D"] =
    "콰쾅! 전 폭발에 관한 건 뭐든지 꿰고 있는 전문가랍니다. 이건 제 수집품들이죠.\n\n용아귀 놈들이 너무 빨리 진격해 와서 전 지금 적진 뒤에 갇혀 버렸습니다. 저를 하사관에게 데려다주시면 이 폭발물들 중 몇 개를 유용하게 쓸 수 있을 거라 확신합니다.\n\n남겨진 것들은 뭐, 우리가 가면서 다 폭파해버려야죠. 그래야 용아귀 놈들이 우릴 상대로 쓰지 못할 테니까요.\n\n제가 안전해지면, 던 굴다르에 계신 니시 이모님께 제 소식을 전해주십시오. 분명 걱정하고 계실 텐데, 저에겐 날려버릴 오크 놈들이 있거든요!",
  },
  [27021] = {
    ["T"] = "메네실로 보내는 전갈",
    ["O"] = "발스탁 아이언조에게 불타버린 마을의 쪽지를 전달하십시오.",
    ["D"] =
    "당신 앞에 있는 전령이 피투성이가 된 쪽지를 당신 손에 쥐여주고는 간신히 발스탁이라는 이름을 내뱉은 후 의식을 잃습니다.\n\n메네실 항구에서 그 쪽지의 수신자를 찾으십시오.",
  },
  [27022] = {
    ["T"] = "전령을 죽이지 마시오",
    ["O"] = "부상당한 불타버린 마을 전령을 치료하십시오.",
    ["D"] =
    "이 쪽지를 제게 전하려던 전령은 목숨을 걸었소. 당신 말에 의하면 그에게 아직 숨이 붙어 있는 것 같군.\n\n그를 늪에서 죽게 내버려 둘 순 없소. 자, 이걸 받으시오. 이걸 사용해 그 정찰병의 생기를 조금 회복시키면 그가 무사히 여기까지 올 수 있을 거요.",
  },
  [27023] = {
    ["T"] = "새끼용 조련사들",
    ["O"] = "용아귀부족 어둠손 6명과 그들의 우두머리 정복자 샤로그를 처치하십시오.",
    ["D"] =
    "용아귀 부족 놈들은 모든 용을 경멸한다고 주장하지만, 그렇다고 그들을 자신들의 의지대로 부리는 일을 멈추지는 않죠.\n\n줄루마르 내의 어둠손들은 그들 중에서도 가장 뛰어난 용 조련사들입니다. 이 지식은 가장 숙련된 조련사 정복자 샤로그의 직접적인 지도를 통해 그들에게 전수됩니다.\n\n줄루마르 북쪽, 습지대가 내려다보이는 거대한 마법사 탑에서 그와 그의 제자들을 찾을 수 있을 겁니다.",
  },
  [27024] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "아메스아란에서 여행하는 학자를 찾으십시오.",
    ["D"] =
    "반갑습니다, 여행자여. 저는 엘룬의 자매회 사제 티라에스라고 합니다. 이곳에 파견되어 중요한 연구를 완수해야 하지만, 안타깝게도 임무가 난관에 부딪힌 것 같군요.\n\n고대의 전쟁 이전, 칼도레이 제국의 전성기 시절, 지금의 조람 해안과 어둠해안 남부에 하지리라는 도시가 있었습니다. 최근 아스트라나르를 지나간 한 떠돌이 학자의 말에 따르면, 제국 몰락 이전의 기록을 찾기 위해 나가들이 그 폐허에서 작업 중이라고 합니다. 저는 그 기록들을 되찾고 싶습니다.\n\n사제로서의 임무 때문에 아스트라나르를 떠날 수 없지만, 당신은 자유롭게 이동할 수 있지요. 저를 도와주실 의향이 있다면 그 떠돌이 학자를 찾아주십시오. 그녀는 어둠해안의 아메스아란 쪽으로 향한다고 했습니다.",
  },
  [27025] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "애샬렌이 수호물을 해제할 때까지 아메스아란에서 그녀를 지키십시오.",
    ["D"] =
    "제 이름은 애샬렌, 잃어버린 마법을 연구하는 학자입니다. 티라에스가 찾는 물건이 어디 있는지 알 것 같습니다만, 저 역시 마쳐야 할 연구가 있군요. 거래를 제안하고 싶습니다.\n\n아메스아란 폐허 안에는 과거의 마법사들이 사용하던 기 집중 장치가 있습니다. 오랜 세월에도 불구하고 여전히 강력한 수호물의 보호를 받고 있죠.\n\n제가 그 수호물을 돌파하는 동안 절 지켜주신다면, 티라에스가 찾는 물건을 얻을 수 있도록 돕겠습니다.",
  },
  [27026] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "잿빛 골짜기의 조람 해안에서 애샬렌과 대화하여 리알라스와의 대결을 시작하십시오.",
    ["D"] =
    "당신이 저를 도와주셨으니, 이 기 집중 장치가 왜 필요한지 설명해 드릴 때가 되었군요.\n\n사악한 바다 마녀, 리알라스는 티라에스가 찾고 있는 것과 동일한 역사서들을 꼼꼼하게 찾기 위해 고대 폐허들을 수색해 오고 있습니다. 하지만 리알라스에 대한 제 원한은 유물을 두고 벌이는 학자와 약탈자 간의 다툼 그 이상입니다.\n\n고대의 전쟁 당시 저희 가족은 칼도레이 저항군에 가담했고, 그로 인해 리알라스의 표적이 되었습니다. 그녀가 저희를 체포하러 왔을 때, 거의 뚫을 수 없는 방어막을 쳤습니다. 우리는 그녀를 막을 수 없었고, 그녀가 우릴 몰살시키는 걸 막아준 건 영원의 샘 폭발뿐이었습니다.\n\n전 수년 동안 그녀의 마법을 뚫을 방법을 찾고 있었습니다. 이 기 집중 장치를 손에 넣었으니, 이번엔 그녀가 그녀의 사악한 마법 뒤에 숨지 못할 것입니다.\n\n조람 해안에서 저를 찾으세요. 함께 리알라스를 쓰러뜨리고 티라에스에게 그토록 원하던 문서를 가져다줍시다.",
  },
  [27027] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "하지리의 연대기를 아스트라나르에 있는 티라에스에게 돌려주십시오.",
    ["D"] =
    "이미 짐작하셨겠지만 제 사연에는 제가 털어놓지 않은 부분들이 있습니다. 전 당신과 함께 마을로 돌아갈 수 없습니다.\n\n당신이 찾던 기록을 얻으셨으니, 전 추방지로 돌아가겠다는 약속을 지키겠습니다. 이곳에서 있었던 일은 우리 둘만의 비밀로 해주시면 진심으로 감사하겠습니다. 제게 일어날 수 있는 최악의 일은 우리의 신성한 규율을 어겼다는 이유로 사제들에게 쫓기는 것이니까요.",
  },
  [27028] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "별가루 폐허의 웅덩이에서 표본을 채취한 후, 아스트라나르의 티라에스에게 돌아가십시오.",
    ["D"] =
    "이 책의 현재 상태로는 도대체 왜 나가가 애초에 이 책을 찾아 나섰는지 알아낼 방법이 없습니다. 그렇다고 방법이 전혀 없다는 건 아닙니다.\n\n아스트라나르 남쪽에는 예전에 별가루라 불렸던 곳이 있습니다. 폐허이긴 하지만 그곳엔 여전히 세상에서 가장 순수한 물의 근원이 남아있지요.\n\n그곳으로 가서 이 약병에 별가루의 물을 채워오십시오. 그 폐허에는 위험한 존재들이 있으니 조심하시고요.",
  },
  [27029] = {
    ["T"] = "하지리의 연대기",
    ["O"] = "아스트라나르 서쪽에 있는 아에시나의 제단으로 가서 아에시나의 축복을 구하십시오. 끝난 후 아스트라나르에서 티라에스를 만나십시오.",
    ["D"] =
    "제 계획의 마지막은 그 물과 연대기를 모두 아에시나의 제단으로 가져가는 것입니다. 이 물을 제물로 바치면, 그녀가 우리에게 축복을 내려 연대기를 복원해 주기를 바라고 있습니다. 그곳에서 뵙지요.\n\n만약 저보다 먼저 도착하신다면, 다른 방문객들에게 아에시나의 축복을 받는 가장 좋은 방법에 대해 물어보는 것도 좋을 것입니다.",
  },
  [27030] = {
    ["T"] = "베어라!",
    ["O"] = "롬굴을 미끼로 삼아 잿빛골짜기 정찰꾼들을 유인하고 그가 공격받는 동안 그를 보호하십시오. 이 임무를 완수하면 작업반장 바란에게 돌아가십시오.",
    ["D"] =
    "비겁한 나이트 엘프 놈들은 어둠 속에 숨어서 자신의 구역에 들어오는 자는 누구든 기습하고 있다. 이제 놈들의 시선을 우리 일꾼들에게서 딴 곳으로 돌릴 조치를 취할 때다.\n\n이번 임무에 롬굴을 너에게 배속시켜 주마. 그는 일꾼들이 늘 그렇듯 요란하게 소리를 내며 비틀거릴 것이다. 매복한 엘프 놈들이 이 멍청한 바보를 보면, 약점을 냄새 맡고 덤벼들겠지. 네 임무는 롬굴을 살리되 매복한 엘프 놈들은 단 한 놈도 살려두지 않는 것이다.\n\n이 임무를 해낸다면 보상을 주마.",
  },
  [27031] = {
    ["T"] = "군단을 무찔러라",
    ["O"] = "만노로크 채찍마녀 6마리, 지옥수호병 6마리, 불타는 지옥불정령 6마리를 처치한 뒤 잿빛 골짜기의 토막나무 주둔지에 있는 자이리스에게 돌아가십시오.",
    ["D"] =
    "불타는 군단의 잔당들이 우리 전쟁노래 벌목장을 습격하고 있다!\n\n더 이상은 안 돼!\n\n악마들은 남동쪽 악령불 언덕, 악마벼락 협곡, 악마벼락 마루라고 불리는 지역에서 공격을 퍼붓고 있다.\n\n가서 가능한 한 많은 놈들을 쳐부수고 너와 호드 모두에게 영광을 가져오도록!",
  },
  [27032] = {
    ["T"] = "군단을 무찔러라",
    ["O"] = "만노로크 채찍마녀 6마리, 지옥수호병 6마리, 불타는 지옥불정령 6마리를 처치한 후 잿빛 골짜기의 숲의 노래에 있는 파수꾼 마이스린에게 돌아가십시오.",
    ["D"] =
    "불타는 군단의 잔당들이 전쟁노래 벌목장을 습격하고 있다네. 나도 벌목꾼들이 싫긴 하지만, 악마들을 저지하지 않는다면 벌목장을 넘어 길가의 여행자들까지 먹잇감으로 삼기 시작할 걸세.\n\n악마들은 남쪽의 악령불 언덕, 악마벼락 협곡, 악마벼락 마루라는 지역에서 공격해 오고 있다네.\n\n가서 최대한 많은 악마들을 처치하여 숲과 얼라이언스에 평화를 가져다주게나!",
  },
  [27033] = {
    ["T"] = "악마의 계획서",
    ["O"] = "악마의 계획서를 잿빛 골짜기 토막나무 주둔지에 있는 자이리스에게 전달하십시오.",
    ["D"] =
    "악마가 놀랍게도 오크어로 쓰인 양피지를 떨어뜨렸습니다! 문서에 언급된 자들은 디아토루스와 고르간논으로, 이 일대의 악마들을 지배하는 악명 높은 두 공포의 군주입니다.\n\n이 계획서에는 북서쪽에 위치한 토막나무 주둔지에 대한 악마들의 공격 준비 과정이 상세히 적혀 있습니다.\n\n토막나무 주둔지에 있는 자이리스가 이 문서에 흥미를 가질 것이 분명합니다.",
  },
  [27034] = {
    ["T"] = "두 번 다신 안 돼!",
    ["O"] = "악마벼락 협곡으로 들어가 고르간논과 수색자 디아토루스를 처치하십시오.",
    ["D"] =
    "$N, 불타는 군단의 이런 공격이 결코 일어나지 않도록 네가 확실히 처리해라! 가서 이 공포의 군주들을 베어버려! 놈들이 없으면 나머지 악마들은 사실상 머리 없는 고기 덩어리일 뿐이니까.\n\n악령불 언덕을 지나 남쪽의 악마벼락 협곡에 가면 만노로스에 꽂혀 떠 있는 부러진 창 근처에서 고르간논을 찾을 수 있을 거다.\n\n수색자 디아토루스는 악마벼락 마루 꼭대기 어딘가에 거주하고 있다. 마루로 가려면 그롬 헬스크림의 기념비 근처 악마벼락 협곡에서 위로 올라가는 길을 찾아봐.",
  },
  [27035] = {
    ["T"] = "악마의 계획서",
    ["O"] = "악마의 계획서를 잿빛 골짜기의 숲의 노래에 있는 파수꾼 마이스린에게 전달하십시오.",
    ["D"] =
    "악마가 놀랍게도 공용어로 쓰인 양피지를 떨어뜨렸습니다! 문서에 언급된 자들은 디아토루스와 고르간논으로, 이 일대의 악마들을 지배하는 악명 높은 두 공포의 군주입니다.\n\n이 계획서에는 북쪽에 위치한 숲의 노래에 대한 악마들의 공격 준비 과정이 상세히 적혀 있습니다.\n\n숲의 노래에 있는 파수꾼 마이스린이 이 문서에 흥미를 가질 것이 분명합니다.",
  },
  [27036] = {
    ["T"] = "두 번 다신 안 돼!",
    ["O"] = "악마벼락 협곡으로 들어가 고르간논과 수색자 디아토루스를 처치하십시오.",
    ["D"] =
    "$N, 불타는 군단의 이런 공격이 결코 일어나지 않도록 자네가 확실히 처리하게! 가서 이 공포의 군주들을 처치해! 놈들이 없으면 나머지 악마들은 본질적으로 분별력 없는 존재들에 불과하다네.\n\n악령불 언덕을 지나 남쪽의 악마벼락 협곡에 가면 만노로스에 꽂혀 떠 있는 부러진 창 근처에서 고르간논을 찾을 수 있을 거네.\n\n수색자 디아토루스는 악마벼락 마루 꼭대기 어딘가에 거주하고 있다네. 마루로 가려면 그롬 헬스크림의 기념비 근처 악마벼락 협곡에서 올라가는 길을 찾아보게나.",
  },
  [27037] = {
    ["T"] = "직접적인 보복",
    ["O"] = "검은심연 나락에서 여왕 사레베스를 처치하고, 아스트라나르의 티라에스에게 돌아가십시오.",
    ["D"] =
    "복원된 연대기를 살펴볼 기회가 있었는데 나가들이 무엇을 찾고 있었는지 알 것 같습니다.\n\n전에도 말씀드렸듯, 하지리는 고대의 전쟁 전부터 존재했지만 수많은 다른 칼도레이 도시처럼 지금은 사라졌습니다. 이 책에는 하지리의 신전에서 별들로 승천했다고 전해지는 한 대여사제의 기록이 담겨 있습니다. 아마 나가들의 목적은 이와 비슷한 의식을 통해 엘룬의 힘을 손에 넣는 것일 겁니다. 비록 우리가 이 문서를 나가들로부터 뺏어오긴 했지만, 그들이 계속해서 다른 문서를 노릴 거란 건 자명한 일입니다.\n\n우리를 공격했던 나가는 여왕 사레베스의 부하들이었습니다. 서쪽으로 조람 해안을 따라가면 폐허가 된 신전의 입구가 있습니다. 그 나락 속에서 여왕 사레베스가 부하들과 모의를 꾸미고 있습니다. 그녀를 찾아서 그녀의 음모에 영원한 종지부를 찍어주십시오. 이 임무를 마치고 제게 돌아오시면 보상을 드리겠습니다.",
  },
  [27038] = {
    ["T"] = "포세이큰 약탈자들",
    ["O"] = "배스랜 서식지에서 포세이큰 수색꾼 5명, 포세이큰 약초채집사 5명, 포세이큰 암살단원 10명을 처치하십시오. 모두 마치면 마에스트라 주둔지에 있는 수호자 델그렌에게 돌아가십시오.",
    ["D"] =
    "포세이큰이 잿빛 골짜기에 침입해 왔소. 그들이 한때 내 동족이었을지는 모르지만, 난 그들이 걷는 곳마다 죽음만이 남는 것을 직접 목격했소. 그들이 이곳에 머물도록 결코 내버려 두지 않겠소.\n\n북쪽 배스랜 서식지에 있는 그들의 전초기지를 찾아서 그들이 거기서 무슨 짓을 꾸미고 있든 끝장내 주시오.",
  },
  [27039] = {
    ["T"] = "실용적인 과학",
    ["O"] = "도르다닐 지하굴 근처, 토막나무 주둔지 남쪽의 연금술사 야영지를 찾으십시오.",
    ["D"] =
    "돈이 되는 일자리를 찾는 모험가가 찾아오면 연금술사들을 방문해보라고 전하라는 부탁을 받았네. 고약한 목적을 가진 냄새나는 시체 녀석들이라도 상관없다면 관심이 갈지도 모르지.\n\n연금술사 야영지는 도르다닐 지하굴 근처 토막나무 주둔지 남쪽에 있다네.",
  },
  [27040] = {
    ["T"] = "실용적인 과학",
    ["O"] = "잿빛골짜기 정찰꾼에게 타락한 혼합물을 5번 사용한 후 연금술사 빅터에게 돌아가십시오.",
    ["D"] =
    "거기 자네! 돈을 벌고 싶나? 호드를 돕는 건 어떤가?\n\n마침 내 연구를 도와줄 조수가 필요하던 참이야. 사실 임무는 꽤 간단하다네. 내가 만든 이 기가 막힌 혼합물을 이 지역을 배회하는 정찰꾼들에게 던지기만 하면 되지.\n내가 말한 이 혼합물은 최신 최고급 대(對) 나이트 엘프 기술이라네. 전쟁노래부족 동맹들이 이곳에서 입지를 굳히는 데 큰 도움이 될 게야.\n\n일이 끝나면 내게 결과를 보고하게나.",
  },
  [27041] = {
    ["T"] = "실용적인 과학",
    ["O"] = "은빛날개 복병에게 타락한 혼합물을 5번 사용한 후 연금술사 빅터에게 돌아가십시오.",
    ["D"] =
    "거기 당신! 돈 버는 데 관심 있나? 호드를 돕는 건 어떤가?\n\n아, 잠깐, 아니군. 이건 아까 했던 말이지. 미안하네, $n. 이번 일은 아까 했던 일과 아주 비슷하지만, 이번엔 남쪽에 있는 은빛날개 복병들에게 사용해 봤으면 좋겠어. 녀석들은 전쟁노래 부족의 눈엣가시지. 그러니 이 적군들을 제거해 주면 전쟁노래 부족도 고마워할 걸세.\n\n엘프 놈들에게 혼합물을 아낌없이 뿌려주고, 어떤 일이 벌어지는지 확인해 보자고!",
  },
  [27042] = {
    ["T"] = "개량된 신속의 물약",
    ["O"] = "호드 정찰병 5명에게 개량된 신속의 물약을 나누어 주고 연금술사 리디야에게 돌아가십시오.",
    ["D"] =
    "당신은 정말 훌륭한 연구 조수로군요, $n. 제 이름은 리디야이며 왕립 연금술사 학회 소속입니다. 저는 빅터와는 별개의 프로젝트를 진행 중인데, 혹시 당신이 이 프로젝트를 도와주실 수 있을까 해서요.\n\n남쪽에는 나이트 엘프 복병들을 끊임없이 감시하는 전쟁노래 부족 정찰병 여럿이 있습니다. 그들은 전투에서 제 몫을 할 수 있긴 하지만, 우리는 그들에게 가능한 모든 지원을 제공해야 합니다.\n\n저는 신속의 물약을 특별히 개량하는 작업을 해왔습니다. 이 물약은 그들에게 뛰어난 반사 신경과 전반적인 민첩성을 부여하여, 어떤 복병이 나타나든 물리칠 수 있게 해줄 것입니다. 저를 위해 이 물약을 전쟁노래 부족 정찰병들에게 나눠주시겠습니까? 수고비는 넉넉히 쳐드리겠습니다.",
  },
  [27043] = {
    ["T"] = "윤리적 딜레마",
    ["O"] = "연금술사 빅터와 리디야의 활동을 작업반장 바란에게 보고하십시오.",
    ["D"] =
    "$n이라고 했나? 리디야가 당신에게 자신의 프로젝트에 대해 하는 말을 우연히 들었어. 우리 모두가 같은 프로젝트를 진행하고 있는데, 그녀가 당신에게 정찰병들에게 나눠주라고 한 \"개량된 신속의 물약\" 같은 건 존재하지 않기 때문에 그녀의 설명이 좀 이상하게 들리더군.\n\n단도직입적으로 말하지. 그녀는 당신에게 거짓말을 했어. 당신이 정찰병들에게 준 것은 나이트 엘프들에게 썼던 것과 똑같은 혼합물이야. 리디야는 우리 프로젝트의 실험 대상군을 넓히고 싶어 안달이었지만, 당신이 오기 전까지는 실험할 대상이 나이트 엘프들밖에 없었지.\n\n누군가 리디야와 빅터를 막아야 해. 놈들은 왕립 연금술사 학회가 결과만 얻을 수 있다면 누구에게 실험하든 신경 쓰지 않는 것 같아. 나로선 놈들을 어찌할 도리가 없지만, 당신이 작업반장 바란을 찾아가면 어떨까... 어쩌면 그녀라면 왕립 연금술사 학회와 전쟁노래 부족 양쪽 모두를 납득시킬 수 있는 해결책을 알지도 몰라.",
  },
  [27044] = {
    ["T"] = "실험의 결말",
    ["O"] = "빅터와 리디야를 죽이고 그 머리를 가져와 그들의 실험을 끝내십시오. 그리고 작업반장 바란에게 돌아가십시오.",
    ["D"] =
    "도넬리가 자기의 작은 연금술 이단 집단의 체면을 살려줄 해결책을 원한다고? 그렇다면 원하는 대로 해주지!\n\n빅터와 리디야에게 가라. 놈들의 머리를 베어 와서 그들의 프로젝트를 \"결론\" 지어라! 만약 도넬리가 그들을 돕는다면, 놈의 머리도 가져와! 호드는 우리의 \"동맹\"이 그런 짓거리를 하는 것을 용납하지 않는다.\n\n물러가라!",
  },
  [27045] = {
    ["T"] = "대지의 울림",
    ["O"] = "토막나무 광산 안의 일꾼들을 심문하십시오.",
    ["D"] =
    "보통 이 광산의 생산량은 호드의 전쟁 물자 공급에 결정적인 역할을 하지. 그런데 최근 들어 빌어먹을 일꾼 놈들이 태만해지고 있어. 심지어 몇몇은 연장까지 내던지고 횡설수설하며 광산 밖으로 뛰쳐나왔다니까!\n\n아제로스에 도대체 무슨 일이 벌어지고 있는지 놈들에게 가서 물어봐 줄 수 있나?",
  },
  [27046] = {
    ["T"] = "대지의 울림",
    ["O"] = "토막나무 광산 안에 있는 일꾼들을 겁먹게 한 괴물을 찾아 제거하십시오.",
    ["D"] =
    "그러니까 광산 깊숙한 곳에 괴물이 있다는 말인가? 최근 이곳에서 일어나고 있는 진동도 그 녀석 때문인지 궁금하군.\n\n다시 아무 문제 없이 이 작업이 돌아가게 해야 해. 광산으로 다시 들어가서 그 녀석을 처리해 줄 수 있겠나?",
  },
  [27047] = {
    ["T"] = "대지의 울림",
    ["O"] = "해안선에서 튼튼한 갈대 6개를 채집하고, 썩어가는 진흙괴물에게서 깨진 유리 조각 4개를 수집하십시오.",
    ["D"] =
    "이제 내 말이 귀에 쏙쏙 들어오나 보군. 이 땅의 울림은 여전하고 일꾼들의 생산성도 크게 나아진 건 없어. 우린 이 진동의 진짜 원인을 찾아내야만 해.\n\n내게 좋은 생각이 있지만 네가 물건을 좀 구해다 줘야겠어. 잿빛 골짜기 전역의 물가를 따라가면 튼튼한 갈대들을 찾을 수 있을 거야. 그걸 속을 파내서 임시 망원경을 만들 수 있지.\n\n렌즈를 만들 유리도 필요한데, 유리는 자연에서 거저 얻을 수 있는 게 아니니... 흠... 아, 알겠다! 근처에 썩어가는 진흙괴물들이 여행자들이 땅에 떨어뜨린 것들을 주워 먹곤 하지. 녀석들이 분명 여기저기서 유리제품들을 삼켰을 거야.",
  },
  [27048] = {
    ["T"] = "대지의 울림",
    ["O"] = "토막나무 광산 밖에서 진동계측기 MK I을 시험해 보십시오.",
    ["D"] =
    "네가 가져온 것들로 내 최신 발명품을 조립했다. 진동계측기 MK I 이지! 광산 밖으로 가져가서 한 번 시험해 봐. 분명 이게 우릴 올바른 방향으로 이끌어 줄 거라고 확신해.",
  },
  [27049] = {
    ["T"] = "대지의 울림",
    ["O"] = "오그리마 안에서 이지 패스로켓을 찾아 현장감독 스프링스프로켓의 물품을 수집하십시오.",
    ["D"] =
    "이게 식물과 진흙 묻은 유리 조각을 써서 싼값에 문제를 대충 해결하려 했던 대가군. 뭐 어쨌든, 시도해 볼 만한 가치는 있었어.\n\n내 금고를 터는 수밖에 방법이 없나 보군. 자, 이 톱니바퀴 자루를 삯으로 가져가고, 오그리마의 비행선 구역에 있는 내 옛 동료 이지 패스로켓을 찾아줘. 그녀에게 내가 필요한 최고급 부품을 공급해 달라고 부탁해.",
  },
  [27050] = {
    ["T"] = "대지의 울림",
    ["O"] = "토막나무 광산에 있는 현장감독 스프링스프로켓에게 돌아가십시오.",
    ["D"] =
    "<이지가 자루 안을 들여다봅니다.>\n\n정말 고블린답게 내 맘에 쏙 드는 친구군.\n\n자, 현장감독이 원하는 모든 게 여기 있어. 솔직히 말해서 네 덕분에 좀 궁금해지네. 이게 어떻게 되는지 꼭 다시 와서 얘기해 줘야 해. 마침내 그가 내게 도움을 청할 수밖에 없게 만든 게 뭔지 몰라도 그게 엄청난 물건이어야만 할 테니까.\n\n이 상자를 들고 토막나무 주둔지로 돌아가서 그에게 전해줘.",
  },
  [27051] = {
    ["T"] = "대지의 울림",
    ["O"] = "진동계측기 MK II를 사용하여 잿빛 골짜기 내에서 지진의 원인을 찾으십시오.",
    ["D"] =
    "이것이 바로 진동계측기 MK II야. 정말 아름답지 않아? 땅에 놓으면 잿빛 골짜기에서 지진이 발생하는 근원지를 향해 널 인도해 줄 거야.\n\n내가 도와줄 수 있는 건 여기까지야. 빌어먹을 일꾼 놈들이 미치기 전에 제발 그 근원지를 찾아내서 멈춰줘.",
  },
  [27052] = {
    ["T"] = "대지의 울림",
    ["O"] = "진동계측기 MK II를 해바위 야영지의 딧지 스프링스프로켓에게 가져가십시오.",
    ["D"] =
    "제 여동생 딧지는 해바위 야영지에 있습니다. 다음 단계를 진행하는 데 도움이 될지도 몰라요. 이 진동계측기를 가져가면 그녀가 직접 계측기를 조정할 수 있을 겁니다. 이 지진을 일으키는 원인은 아제로스 깊은 곳에 있는 아주 강력한 존재임에 틀림없습니다.\n\n딧지에게 가려면 토막나무 주둔지 남서쪽에 있는 발톱협곡 길을 이용하면 됩니다. 만약 불모의 땅 지형에 더 익숙하다면, 모래바람 몰아치는 지옥 같은 불모의 땅 서쪽의 명예의 감시탑으로 가는 길을 통해 해바위 야영지로 갈 수도 있습니다.",
  },
  [27053] = {
    ["T"] = "솔라살 보고서",
    ["O"] = "아스트라나르의 누군가에게 보고서를 가져가십시오.",
    ["D"] =
    "<이 보고서는 솔라살이라는 폐허에 대한 나가의 관심사에 대해 자세히 설명하고 있습니다. 내용 자체는 모호하며, 나가의 병력 규모나 공격 계획에 대한 표시는 없습니다. 이 정보는 아스트라나르에 있는 누군가에게 유용할지도 모릅니다.>",
  },
  [27054] = {
    ["T"] = "고대정령의 심장",
    ["O"] = "아스트라나르에서 심장에 대해 말해줄 수 있는 사람을 찾으십시오.",
    ["D"] =
    "당신은 고대정령의 심장을 집어들었고, 그 심장에서 내뿜는 기묘한 박동을 느낍니다. 아마도 아스트라나르에 있는 누군가가 이에 대해 더 자세히 말해줄 수 있을 것입니다.",
  },
  [27055] = {
    ["T"] = "고대정령의 심장",
    ["O"] = "토막나무 주둔지에서 심장에 대해 말해줄 수 있는 사람을 찾으십시오.",
    ["D"] =
    "당신은 고대정령의 심장을 집어들었고, 그 심장에서 내뿜는 기묘한 박동을 느낍니다. 아마도 토막나무 주둔지에 있는 누군가가 이에 대해 더 자세히 말해줄 수 있을 것입니다.",
  },
  [27056] = {
    ["T"] = "스랄에게로 귀환",
    ["O"] = "오그리마 지혜의 골짜기에 있는 스랄과 대화하십시오.",
    ["D"] =
    "아, $C. 당신에게 전할 메시지가 있습니다.\n\n우리 대족장 스랄님께서 당신이 오그리마로 돌아와 그분과 대화하길 명하셨습니다. 그분께 불타는 칼날단에 대한 소식이 있습니다.",
  },
  [27057] = {
    ["T"] = "에테르의 파동",
    ["O"] = "잿빛 골짜기의 토막나무 주둔지에 있는 자이리스를 찾으십시오.",
    ["D"] =
    "공포안개 봉우리 정상에서 악마의 씨앗을 파괴하기 위해 네가 최근 벌인 활동에 대해 들었다. 이는 칭찬받아 마땅한 행동이었고 네가 불타는 칼날단의 하수인들에게 맞설 수 있다는 걸 보여주었다.\n\n하지만 씨앗이 파괴되면서 어둠의 에테르를 타고 울려 퍼진 신호는 특히 흑마법사와 악마들의 주의를 끌었지. 새로운 위협이 도래했다.\n\n네루 파이어블레이드는 불타는 칼날단이 불모의 땅과 잿빛 골짜기에서 활동한다고 했지. 네가 불모의 땅에 있는 그들의 본거지를 공격했으니 이 위협은 잿빛 골짜기에 나타나리라 생각한다. 잿빛 골짜기의 토막나무 주둔지로 가서 내 대리인인 자이리스와 이야기해라. 그녀가 이 위험을 찾는 것을 도울 것이다.",
  },
  [27058] = {
    ["T"] = "에테르의 파동",
    ["O"] = "돌발톱 산맥에서 불타는 칼날단을 수색하십시오. 그들을 찾으면 불타는 칼날단 징표 목걸이 4개를 회수하여 잿빛 골짜기의 토막나무 주둔지에 있는 자이리스에게 가져가십시오.",
    ["D"] =
    "스랄님께서 당신이 올 것을 미리 알려주셨소. 당신을 또다시 여정으로 보내고 싶진 않지만, 그들의 마법의 표본이 없다면 잿빛 골짜기에서 불타는 칼날단을 찾아낼 수가 없는데 이곳에선 아무런 단서도 없소.\n\n소문에 의하면 불타는 칼날단이 돌발톱 산맥의 타우렌 그림토템 부족에게서 안전한 은신처를 찾았다고 하오. 공포안개 봉우리가 더 이상 안전하지 않게 되자 그들이 그곳으로 이동했을 거라 생각하오.\n\n돌발톱 산맥에 있는 그림토템 부족의 흔적을 수색하고 그들이 정말 불타는 칼날단과 동맹을 맺었는지 확인해 주시오. 그들의 마법과 관련된 무언가를 가져올 수 있는지 보시오 -- 아마 그들이 사용하는 마법 목걸이 같은 것들을 말이오.",
  },
  [27059] = {
    ["T"] = "에테르의 파동",
    ["O"] = "썬더 블러프의 장로의 봉우리에서 마가타 그림토템과 대면하십시오.",
    ["D"] =
    "당신이 가져온 이 목걸이를 연구하여 잿빛 골짜기에서 불타는 칼날단을 찾으려면 시간이 좀 걸릴 것이오.\n\n내가 연구하는 동안, 대족장님의 대리인으로서 그림토템 부족의 지도자와 대화해 주시오.\n\n마가타 그림토템은 썬더 블러프의 장로의 봉우리에 머물고 있소. 불타는 군단은 호드의 끔찍한 적이며, 그녀의 부족이 그들과 협력하는 것은 용납할 수 없는 일이오. 당장 중단되어야만 하오.\n\n이 일에 대한 대족장님의 뜻을 그녀가 확실히 이해하도록 전하시오.",
  },
  [27060] = {
    ["T"] = "에테르의 파동",
    ["O"] = "불모의 땅에 있는 푸른 오아시스로 이동하여 폭풍술사 레제스와 아웃라이더 미신을 처치하십시오.",
    ["D"] =
    "그래서 대족장님께서 우리 부족이 떠돌이 흑마법사 몇 명과 일하는 것을 반대하신단 말이지? 당신은 우리가 왜 그들과 일하는지 묻지 않았지만 내가 말해주겠소.\n\n분명 타우렌이 과거에 켄타우로스에게 사냥당했던 사실을 알고 있을 것이오. 그들의 포식으로 인해 수세대 동안 이어져 온 지식이 소실되었소. 나는 그들이 이 땅을 함께 공유하도록 내버려 두지 않을 것이오. 왜 내가 포세이큰과의 동맹을 지지했다고 생각하오? 그들의 역병은 매우 흥미로운 무기이기 때문이지....\n\n만약 우리 부족이 불타는 칼날단과 일하는 것을 멈추길 원한다면 나에게 그것에 상응하는 도구를 주시오. 불모의 땅으로 가서 폭풍술사 레제스와 아웃라이더 미신을 죽이시오. 그놈들은 너무 오랜 시간 동안 내 눈엣가시였소.",
  },
  [27061] = {
    ["T"] = "에테르의 파동",
    ["O"] = "잿빛 골짜기의 토막나무 주둔지에 있는 자이리스에게 돌아가십시오.",
    ["D"] =
    "난 네가 진짜 찾고 있는 게 뭔지 알고 있다, $C. 어둠에 동화된 모든 피조물들은 악마의 씨앗이 파괴되면서 흩어진 에너지의 파동을 느꼈지. 그 에너지의 일부가 아직도 네 주위를 맴돌고 있군.\n\n잿빛 골짜기 어딘가에서 자라고 있는 또 다른 씨앗이 있다. 그건 내 부족의 목적과는 무관한 것이어서 더 이상의 자세한 정보는 없다. 하지만 대족장님께 좋은 의도를 보여주는 표시로 이 정보를 주마... 이제 잠시 너의 주인들에게 돌아가 보아라. 나중에 돌아와서 내가 시킨 일들을 마무리해 주길 기대하겠다.",
  },
  [27062] = {
    ["T"] = "에테르의 파동",
    ["O"] = "오그리마의 스랄에게 돌아가십시오.",
    ["D"] =
    "당신이 자리를 비운 사이, 당신이 가져온 목걸이의 비밀 일부를 해독할 수 있었소. 유감스럽지만 우리가 잿빛 골짜기에서 상대해야 할 놈은 너무 강력해서 정보가 부족한 상태로는 섣불리 덤빌 수 없을 것 같소.\n\n스랄님께 이 보고서를 전달해 주시오. 스랄님께서 다음 계획을 세우시는 동안 당신은 마가타가 맡긴 귀찮은 일을 처리할 여유가 있을 것 같소.",
  },
  [27063] = {
    ["T"] = "새로운 악마의 씨앗",
    ["O"] = "잿빛 골짜기 토막나무 주둔지에 있는 자이리스와 대화하십시오.",
    ["D"] =
    "$N, 이제 불타는 칼날단에 대항하여 다시 무기를 들 때다. 자이리스가 이전과 같은 에테르의 파동을 일으키지 않고 이 새로운 악마의 씨앗을 소멸시킬 계획을 세웠다.\n\n지금 즉시 토막나무 주둔지에 있는 그녀에게 보고해라.",
  },
  [27064] = {
    ["T"] = "새로운 악마의 씨앗",
    ["O"] = "사티르나르를 거쳐 잿빛 골짜기의 자비안으로 이동하여 나이조리스를 처치하십시오. 주술송곳니 상자를 획득하여 토막나무 주둔지에 있는 자이리스에게 가져오십시오.",
    ["D"] =
    "불모의 땅에서처럼 이 새로운 악마의 씨앗을 단순히 파괴해선 안 됩니다. 우리는 그것이 계속 자라지 못하도록 어딘가에 가두어야 합니다. 다행히도 그렇게 할 수 있는 장소가 우리 손이 닿는 곳에 있습니다.\n\n동쪽에 사티로스 무리가 야영지를 세웠습니다. 자비안의 위층에서 희귀 유물 수집가인 나이조리스를 찾을 수 있습니다. 그는 주술송곳니 상자라는 물건을 소유하고 있습니다. 이 마법의 상자는 강력한 흑마법의 물건들을 보관하기 위해 특별히 고안된 것입니다. 나이조리스를 처치하고 그 상자를 제게 가져오십시오. 그것을 사용해 악마의 씨앗을 가둘 수 있습니다.",
  },
  [27065] = {
    ["T"] = "새로운 악마의 씨앗",
    ["O"] = "악마벼락 협곡에 침투하여 주술송곳니 상자를 사용해 새로운 악마의 씨앗을 격리하십시오.",
    ["D"] =
    "이제 우리의 임무에서 가장 위험한 순간이 왔습니다, $N.\n\n당신은 전쟁노래 벌목장과 악령불 언덕의 남쪽에 위치한 악마벼락 협곡으로 가야 합니다. 그곳은 그롬 헬스크림이 만노로스를 쓰러뜨린 곳입니다. 불타는 칼날단은 남은 만노로스의 피를 이용해 그곳에서 새로운 악마의 씨앗을 키우고 있습니다.\n\n씨앗을 찾아 상자 안에 넣으십시오. 그런 다음 제게 상자를 가져오십시오.\n\n안타깝게도 저는 동행할 수 없습니다. 악마들이 저의 기운을 느끼면 당신은 훨씬 거센 저항에 부딪힐 것입니다.",
  },
  [27066] = {
    ["T"] = "새로운 악마의 씨앗",
    ["O"] = "봉인된 주술송곳니 상자를 오그리마의 스랄에게 가져가십시오.",
    ["D"] =
    "주술송곳니 상자는 이제 마법으로 봉인되었습니다, $N. 와이번을 타고 오그리마로 가서 이 상자를 스랄님께 전하십시오. 스랄님께서 안전한 곳에 상자를 보관하고 감시하도록 조치하실 겁니다.\n\n아주 훌륭하게 해냈습니다, 젊은 $C. 언젠가 다시 만나길 기대하겠습니다.",
  },
  [27067] = {
    ["T"] = "그늘수렵 마을로의 여정",
    ["O"] = "잊혀진 땅의 그늘수렵 마을에서 핍조트와 자카라를 찾으십시오.",
    ["D"] =
    "자이리스가 악마의 씨앗 파괴로 인해 소환된 강력한 악마의 위치에서 잿빛 골짜기를 제외시켰습니다. 잊혀진 땅으로 파견된 제 다른 대리인은 불타는 칼날단이 그 지역에 주둔하고 있다고 보고했습니다.\n\n남서쪽 해안에 있는 그늘수렵 마을로 향하여 자카라와 그녀의 임프 핍조트를 찾으십시오.\n\n자카라는 유능한 흑마법사지만 말을 하지 못합니다. 그녀의 임프가 대신 말을 전해줄 것입니다.",
  },
  [27068] = {
    ["T"] = "작업의 일부분",
    ["O"] = "아즈샤라 발로르모크의 렐코를 위해 아즈샤라에 있는 산호껍질거북들에게서 거북이 목살 6개를 수집하십시오.",
    ["D"] =
    "아즈샤라는 마음껏 가질 수 있는 부유함으로 가득 찬 고대의 경이로운 땅이지. 형제, 거래에 끼어들려고 발로르모크에 온 건가? 최고급 가죽 세공 재료를 찾고 있나?\n\n최근에 나도 숲에서부터 해안까지 퍼져 있는 최상급 야수 가죽들을 왕창 처분했지. 자네도 한몫 끼고 싶다면 팁을 하나 주겠어. 여기 거북이들은 목 주위 가죽이 세상에서 제일 부드럽지. 그런 건 난생처음 봐. 그러니 나가서 산호껍질거북들을 죽이고 그들의--맞아--거북이 목살을 챙겨 와.",
  },
  [27069] = {
    ["T"] = "작업의 일부분",
    ["O"] = "아즈샤라 발로르모크의 렐코를 위해 아즈샤라에 있는 히드라들에게서 폭풍히드라 비늘 6개를 수집하고 돌아가십시오.",
    ["D"] =
    "여기 끝없이 펼쳐진 해안의 바닷바람은 해변을 순찰하는 폭풍히드라들의 비늘을 보존하고 윤기 나게 해 주지. 적어도 나가가 지배하지 않는 곳에서는 말이야.\n\n돈을 더 벌고 싶다면, 여기서 어떤 종류의 히드라든 처치하고 질 좋은 비늘을 수집해 와. 내가 점찍어 둔 구매자들은 오직 최고급 비늘만 원하거든.",
  },
  [27070] = {
    ["T"] = "작업의 일부분",
    ["O"] = "머클럭을 처치하고 질긴 랍스트로크 힘줄을 아즈샤라 발로르모크에 있는 렐코에게 가져가십시오.",
    ["D"] =
    "가죽 세공사들은 물건을 이어 붙일 때 실을 사용하지. 보통은 그걸로 충분해. 하지만 이번엔 좀 더 큰 걸 원하는 구매자가 나타났어. 조금 더 튼튼한 무언가가 필요하지. 그리고 난 어디서 그걸 구해야 할지 알고 있어.\n\n폭풍의 만 한가운데를 보면 굽이치는 바위가 모래사장 위로 걸쳐 있는 섬이 하나 있어. 거기 가면 일광욕을 즐기는 늙고 커다란 랍스트로크 한 마리를 자주 볼 수 있지. 이 머클럭이라는 녀석을 찾아서 죽이고 그 굵고 질긴 힘줄을 가져와 줘. 그것들은 튼튼하고 탄력이 있어서 이 주문을 채우는 데 딱 맞는 재료야.\n\n걱정 마 형제, 이 일을 해내면 특별한 보답을 할 테니.",
  },
  [27071] = {
    ["T"] = "계약: 발로르모크 광산",
    ["O"] = "아즈샤라의 발로르모크 광산에 있는 광맥 5곳에서 채굴한 후, 광산 앞의 현장감독 레오폴드에게 보고하십시오.",
    ["D"] =
    "어이, 광부 양반! 내가 엄청난 거래를 제안하지!\n\n그 튼튼한 이두박근을 보니 곡괭이질 꽤나 해본 솜씨군. 우리 일꾼들 좀 쉴 수 있게 잠깐 광산에서 도와주는 건 어때? 우린 장미수정이라는 걸 캐고 있는데, 나도 생전 처음 보는 아주 귀하고 예쁜 물건이지.\n\n당연히 유급 계약직이고, 단기 근무에, 복지 혜택은 없어. 채굴하다 다치는 건 전적으로 본인 책임이고, 우리 광산 안에서 일어나는 일에 대해선 우리가 절대 책임지지 않지. 그래도 우린 호드에 바칠 할당량이 있고, 당신이 그걸 도와줄 수 있다고!",
  },
  [27072] = {
    ["T"] = "계약: 발로르모크 광산",
    ["O"] = "조사를 위해 발로르모크에 있는 대가 레안더에게 장미수정 표본을 가져가십시오.",
    ["D"] =
    "장미수정을 제법 많이 캐셨군요. 하지만 이건 보통 돌멩이들과는 다릅니다! 이 장미수정 조각을 보세요. 기묘한 빛을 내뿜고 있지 않습니까? 이건 아주 위험하거나, 아니면 엄청난 물건이거나 둘 중 하나죠.\n\n저 남서쪽에 있는 연금술 건물로 이 수정을 가져가서 대가 레안더에게 한 번 보여주는 게 어떨까요?\n\n명심하세요, 만약 이게 저주받은 물건이라면 난 책임 없습니다!",
  },
  [27073] = {
    ["T"] = "계약: 발로르모크 광산",
    ["O"] = "대가 레안더의 보고서를 아즈샤라에 있는 발로르모크 광산의 현장감독 레오폴드에게 가져가십시오.",
    ["D"] =
    "정말 대단한 발견이군요, $N. 딱 봐도 이 장미수정 파편에 일종의 마법 정수가 깃들어 있다는 걸 알 수 있습니다. 이 수정 파편을 제게 가져오게 한 현장감독 레오폴드의 통찰력이 놀라울 따름입니다.\n\n이 표본은 제 연구를 위해 잠시 보관하겠습니다. 레오폴드에게 돌아가서, 앞으로 채굴되는 이런 표본들에 제가 깊은 관심을 갖고 있다고 전해주십시오. 아, 그리고 두둑한 보너스도 챙기게 될 거라고요.",
  },
  [27074] = {
    ["T"] = "악마의 침입",
    ["O"] = "아즈샤라 검은아귀 요새의 대족장 운갈을 위해 레가쉬 사티로스 10마리, 레가쉬 도적 10마리, 레가쉬 지옥소환사 8마리를 처치하십시오.",
    ["D"] =
    "여러 번의 계절이 지나기 전, 강력한 악마가 이 땅에 왔었다. 우리 부족은 얼라이언스가 악마를 물리치는 걸 도왔지. 위대한 족장 운 악은 평화를 찾아 다른 이들로부터 멀리 떨어진 이곳에 자리 잡기로 결정했다.\n\n하지만 악마들이 다시 돌아왔다. 그 타락이 많은 친구들을 앗아갔지.\n\n평화의 시간은 끝났다. 고립의 시간도 끝났다. 이방인이 우리 검은아귀 부족과 친구가 되고 싶다고? 근처 남쪽에 있는 악마들을 많이 죽여서 네가 친구라는 걸 증명해라. 그런 다음에야 대화하겠다.",
  },
  [27075] = {
    ["T"] = "악마의 침입",
    ["O"] = "박스잘란을 처치한 후, 그의 머리를 아즈샤라 검은아귀 요새의 대족장 운갈에게 가져가십시오.",
    ["D"] =
    "넌 우리 검은아귀 부족에게 우정을 보여줬지만, 우리 부족은 네가 힘도 보여주기를 원한다.\n\n남쪽 악마들 중에 박스잘란이라는 놈이 있다. 그놈이 이끌고 다른 악마들은 그놈을 따르지.\n\n너의 힘을 증명하려면 박스잘란을 처치해라. 그 증거로 머리를 가져와라. 그러면 우리는 진정한 친구가 될 것이다.",
  },
  [27076] = {
    ["T"] = "추방자들의 후예",
    ["O"] = "탈렌디스 초소의 대장 아쉴라는 아즈샤라의 탈라시안 주둔지에 있는 블러드 엘프 수색병 10명과 블러드 엘프 감정관 10명을 처치해주길 원합니다.",
    ["D"] =
    "아즈샤라 구경하러 왔나, $C? 역사에서 배우지 못하는 자들에게 이곳에서 볼 만한 건 아무것도 없어. 이 땅과 아즈샤라라는 그 이름 자체가 마법이 얼마나 위험한지를 증명하는 징표니까.\n\n신도레이는 무분별한 마법 사용으로 칼림도어에서 추방된 쿠엘도레이의 일부였지. 그런데 최근 그들이 오크 용병들을 호위로 고용해 아즈샤라로 돌아왔다. 더 우려되는 건, 그들이 고용한 오크들을 죽이고 지금은 이곳 북동쪽 일대에서 자신들의 목적을 위해 조사를 벌이고 있다는 보고야.\n\n놈들은 분명 나쁜 짓을 꾸미고 있고, 난 그들을 막아야겠어. 날 위해 그 침입자들을 제거해 주면 보상하겠다.",
  },
  [27077] = {
    ["T"] = "진흙괴물 증류",
    ["O"] = "아즈샤라의 숲수액괴물에게서 숲 진흙괴물 4개를 수집하여 발로르모크에 있는 대가 레안더에게 돌아가십시오.",
    ["D"] =
    "내 탑 여기저기에 있는 저 수습생들이 보이나, $C? 쓸모없는 놈들, 전부 다!\n\n그런데 이건 뭐지 -- 자네에게서 트롤의 피 냄새가 나는군? 돌비늘 오일의 정수 냄새도 나고? 만약 자네도 연금술사라면, 자네에게 딱 맞는 일거리가 하나 있지.\n\n나한테 수습생이 네 명 있었지만, 숲 진흙괴물을 모아오라는 간단한 심부름을 보내기 전엔 다섯 명이었지. 여전히 진흙괴물이 필요한데 더 이상 여분의 수습생이 없으니, 숙련된 연금술사의 도움이 필요하네. 멘나르 호수 북쪽이나 아즈샤라의 북서쪽 끝에서 숲수액괴물을 찾을 수 있을 거야.\n\n그리고 만약 내 멍청한 수습생의 흔적을 보거든, 주저하지 말고 침이나 뱉어줘!",
  },
  [27078] = {
    ["T"] = "진흙괴물 증류",
    ["O"] = "아즈샤라 남쪽 해안을 따라 서식하는 폭풍해안멀록 점쟁이에게서 순수한 멀록 정수를 구해 발로르모크에 있는 대가 레안더에게 가져가십시오.",
    ["D"] =
    "진흙괴물의 점액은 물약이나 비약을 만들 때 훌륭한 기본 재료가 되지만, 우리가 만들 혼합물에 불을 지필 에너지를 가진 무언가가 필요해. 다행히도 그 해답은 남동쪽 해안에 사는 물의 거주자들에게 있지.\n\n폭풍해안멀록 점쟁이들은 그들의 마법 능력을 강화하는 데 사용되는 벼락이 깃든 정수를 분비하지. 온전한 상태로 그걸 얻는 건 아주 드물지만, 충분한 수의 멀록을 잡다 보면 결국 얻게 될 거야. 녀석들은 레이븐크레스트 기념비 반도의 해안가와 바닷가를 순찰하고 있어. 자, 서둘러!",
  },
  [27079] = {
    ["T"] = "진흙괴물 증류",
    ["O"] = "레안더의 약병을 멘나르 호수의 물로 채운 후 아즈샤라의 발로르모크에 있는 대가 레안더에게 돌아가십시오.",
    ["D"] =
    "<대가 레안더가 하급 언데드어로 수습생들에게 명령을 내리자, 그들은 재빨리 주의를 집중하고 미친 듯이 재료를 섞기 시작합니다. 대가 레안더는 조용히 지켜보다가 한 수습생이 용액에 물을 붓기 시작하자 소리칩니다.>\n\n안 돼! 이 바보 같은 녀석아! 이런 혼합물에 정제되지 않은 오그리마 수돗물을 쓰면 어떡해! 너의 스승이 대체 누구였냐, 트롤이었냐?!\n\n<대가 레안더는 수습생의 손에서 약병을 빼앗아 당신 쪽으로 밀어붙입니다.>\n\n$C, 착한 $g아이야:아이야;, 가서 멘나르 호수의 순수한 마법의 물로 이걸 채워오거라. 남쪽 푸른용기병이 사는 곳 근처에서 그 호수를 찾을 수 있을 거다.\n\n제발 그놈들에게 잡아먹히지 마라, 나에게 여분의 약병이 그리 많지 않으니까.",
  },
  [27080] = {
    ["T"] = "사악한 우상",
    ["O"] = "아즈샤라 검은아귀 요새의 대족장 운갈을 위해 레가쉬 사티로스 야영지에 있는 사악한 우상 토템 3개를 훔치십시오.",
    ["D"] =
    "남쪽에 있는 악마들이 흑마법을 위한 불타는 해골 기둥인 사악한 우상을 만들고 있다. 그 우상에서 검은 연기와 나쁜 마법, 그리고 더 많은 악마들이 튀어나오지.\n\n우리는 그들의 사악한 토템을 빼앗아 정화할 것이다. 세 악마 야영지에 있는 토템을 훔쳐 네가 검은아귀 부족의 친구임을 증명해라. 그들의 마법을 방해해. 그런 다음, 대화하겠다.",
  },
  [27081] = {
    ["T"] = "펄볼그와 친구가 되는 법",
    ["O"] = "아즈샤라 검은아귀 요새의 놀그를 위해 천둥뿔 히포그리프 깃털 10개를 수집하십시오.",
    ["D"] =
    "이방인 안녕. 펄볼그의 방식을 배우고 싶어? 내가 돕겠다.\n\n의식에 깃털이 필요하다. 검은아귀 요새 밖 커다란 히포그리프에게서. 하지만 죽이지 마. 땅에 남겨진 걸 고마움과 함께 우리가 줍는다. 친구는 서로 돕는 거니까 놀그를 도와 깃털을 주워 줄래? 그럼 우리 친구 된다.",
  },
  [27082] = {
    ["T"] = "펄볼그와 친구가 되는 법",
    ["O"] = "놀그의 지시를 따라 /절 로 시작하여 펄볼그 우정 의식에 참여하십시오.",
    ["D"] =
    "춤은 펄볼그의 몸짓을 뜻하는 단어다. 왜냐하면 그건 의식이기 때문이지. 내가 하는 대로 해. 내 말을 주의 깊게 들어. 네가 내 행동을 따라하면 우리는 친구가 된다.\n\n어쩌면 너도 네 친구들과 이런 걸 할지도 모르지. 그들에게 펄볼그처럼 친구가 되는 법을 가르쳐 줘. 우선 놀그에게 /절 하는 것으로 시작해라.",
  },
  [27083] = {
    ["T"] = "워블 할로우의 위협",
    ["O"] = "아즈샤라의 워블 할로우에 있는 웬디 워블스미스를 위해 원한의꼬리일족 비명술사 10마리와 원한의꼬리일족 전사 10마리를 처치하십시오.",
    ["D"] =
    "우리 가족은 비행기 연료가 떨어져서 바다에 불시착하는 아주 힘든 방법으로 아즈샤라에 도착했어요. 그렇게 순탄한 과정은 아니었지만 바닷가에 떠밀려 왔고, 이 절벽 위로 힘겹게 올라온 후 여기에 정착하기로 했죠. 우리가 처음 의도한 건 아니었지만 워블 할로우는 이제 우리의 보금자리가 되었고, 전 아즈샤라 황야의 위협으로부터 이곳을 지키고 싶습니다.\n\n기꺼이 우릴 도와주신다면 기쁜 마음으로 사례금을 드리겠습니다. 원한의꼬리일족 나가들이 멘나르 호수 북쪽 엘프 폐허에 살고 있어요. 특히 전사와 비명술사들을 먼저 처치해주세요. 걔들은 나가들 중에서도 잔챙이들 같으니까 큰 어려움은 없을 겁니다.",
  },
  [27084] = {
    ["T"] = "워블 할로우의 위협",
    ["O"] = "아즈샤라의 워블 할로우에 있는 웬디 워블스미스를 위해 원한의꼬리일족 세이렌 10마리와 원한의꼬리일족 미르미돈 10마리를 처치하십시오.",
    ["D"] =
    "당신에게 그 잔챙이 나가들을 처치해 달라고 부탁한 것이 부서진 해변에 더 숙련된 나가들이 모이게 한 것 같군요. 지금 해변 곳곳을 순찰하고 있는 원한의꼬리일족 미르미돈과 세이렌들 말입니다. 만약 놈들의 순찰 병력이 더 늘어난다면, 해안가에 있는 우리를 발견할지도 모르고 그런 일이 일어나게 내버려 둘 순 없습니다.\n\n한 번 더 저희를 도와주실 수 있나요?",
  },
  [27085] = {
    ["T"] = "워블 할로우의 위협",
    ["O"] = "아즈샤라의 워블 할로우에 있는 웬디 워블스미스를 위해 아즈샤라 남쪽 해안을 따라 폭풍해안멀록 점쟁이 8마리를 처치하십시오.",
    ["D"] =
    "당신이 나가를 격퇴하는 동안 전 반드시 처리해야 할 또 다른 위협을 알아냈습니다. 우리 동쪽 해안에 있는 폭풍해안멀록 점쟁이들이 어두운 의식을 통해 강력한 폭풍을 일으킬 음모를 꾸미고 있습니다. 놈들을 그냥 두면, 아즈샤라로 통하는 바닷길과 하늘길 모두 위험해질 겁니다!\n\n해안을 따라 내려가서 그들의 계획을 막아주셨으면 합니다. 조심하세요, 이 멀록들은 강력한 자연 마법을 휘두르고, 원소를 다루는 솜씨 또한 대단하니까요. 성공하신다면 이번에도 기꺼이 보상해 드리겠습니다.",
  },
  [27086] = {
    ["T"] = "원한의꼬리일족의 지휘관",
    ["O"] = "워블 할로우의 웬디 워블스미스를 위해 아즈샤라의 레이븐크레스트 기념비 근처에 있는 원한의꼬리일족 지휘관 여마법사 얄리나를 처치하십시오.",
    ["D"] =
    "저기요 $N, 관심 있으시다면 당신에게 맡길 또 다른 호위 임무가 있습니다.\n\n원한의꼬리일족 나가는 아즈샤라에서 우리의 적이며, 새로운 지휘관이 바다에서부터 그들을 지휘하러 왔습니다. 우리의 원격 감지기에 그녀가 도착한 것이 기록되었죠.\n\n지역 지휘관이 자리를 잡은 상황에서, 나가들이 병력을 모아 원한다면 워블 할로우를 침략하는 걸 막을 방법이 없습니다. 지휘관이 없다면, 그들은 우리가 방어 태세를 갖출 충분한 시간 동안 혼란에 빠져 있을 겁니다.\n\n동쪽 멀리, 레이븐크레스트 기념비 주변 절벽 꼭대기에서 여마법사 얄리나를 찾을 수 있습니다. 그녀를 처치하고 우리가 대비할 시간을 벌어주세요!",
  },
  [27087] = {
    ["T"] = "아크코란 신전 약탈하기",
    ["O"] = "아즈샤라 북서쪽 아크코란 신전에서 우리에게 가치가 있을 만한 모든 유물을 수집하십시오.",
    ["D"] =
    "아즈샤라 북서쪽 끝에 있는 아크코란 신전을 조사할 의향이 있다면, 우리에게 가치 있을 만한 특이한 물건을 잘 살펴보게.\n\n정확히 그게 무엇인지는 나도 모르네 -- 두루마리, 책, 물약... 나가들은 석판이나 조각상 같은 걸 꽤나 좋아하던가...?\n\n어쨌든, 직접 옮길 수 있을 만한 흥미로운 물건을 찾으면 나한테 가져와 주게.",
  },
  [27088] = {
    ["T"] = "아크코란 신전 약탈하기",
    ["O"] = "이상한 나가 석판을 발로르모크의 연금술 탑에 있는 대가 레안더에게 가져가십시오.",
    ["D"] =
    "아즈샤라의 명가 폐허에는 많은 석판이 있지만, 이건 다른 것들과 완전히 다른 것 같군. 더 크고, 어... 더 화려하달까? 룬 문자도 더 많고?\n\n나도 몰라, 난 그냥 평범한 병사일 뿐이니까. 내가 말할 수 있는 건 위험해 보인다는 것뿐이네. 대가 레안더에게 가져가서 더 자세히 조사해 보는 게 좋을 것 같네. 발로르모크 반대편 연금술 탑에서 수습생들과 함께 있는 그를 찾을 수 있을 거야.",
  },
  [27089] = {
    ["T"] = "아크코란 신전 약탈하기",
    ["O"] = "이상한 나가 석판을 북쪽 아즈샤라의 마법사 탑에 있는 대마법사 실렘에게 가져가십시오. 그곳으로 순간이동하려면 발로르모크 근처 야영지에서 사나스 임요를 찾으십시오.",
    ["D"] =
    "<대가 레안더가 석판을 당신에게 돌려줍니다.>\n\n그걸 아주 조심해서 다루게, $R. 자네가 들고 있는 것은 아즈샤라 여왕 자신의 명가 도서관에서 나온 유물인, 온전한 명가 성물함 석판인 것 같군.\n\n이곳에 세워졌던 엘프 도시를 파괴한 세계의 분리 이후, 도서관과 그 안의 모든 내용물은 파괴된 것으로 추정되었네. 이 석판이 진짜 성물함 석판인지 내가 확인할 수는 없지만, 그럴 수 있는 사람을 한 명 알지.\n\n이 석판을 근처 절벽 위 탑에 거주하는 대마법사 실렘에게 가져가게. 탑 위로 올라가려면 그의 조수 사나스 임요를 설득해야 할 거네.",
  },
  [27090] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "폭풍의 만에 있는 엘프 폐허에서 물에 젖은 명가 유물 8개를 수집하십시오.",
    ["D"] =
    "자네와 자네 스승이 이 석판을 내게 가져온 것은 잘한 일이네, $C. 하지만 이 석판은 한때 아즈샤라의 명가 성물함에 존재했던 수많은 지식의 극히 일부에 불과해.\n\n아마도 이 온전한 석판을 해독기 삼아 폭풍의 만에 흩어진 깨지고 쓸모없는 유물들을 해석할 수 있을지도 몰라. 물속으로 잠수해서 내게 몇 개를 가져와 주면 비교해 보겠네.",
  },
  [27091] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "아즈샤라 발로르모크에 있는 대가 레안더에게 돌아가십시오.",
    ["D"] =
    "네가 가져온 유물들을 해독하려면 시간이 좀 걸릴 거야. 당분간 너의 스승에게 돌아가 있는 게 어때? 도움이 필요하면 다시 부르지.",
  },
  [27092] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "발로르모크에 있는 대가 레안더를 위해 마크리니 랍스트로크의 눈 12개를 수집하십시오.",
    ["D"] =
    "그의 관심사와 우리 관심사가 겹칠 수만 있다면 대마법사는 아주 강력한 동맹이 될 거야. 잘했네, $N.\n\n자네에게 맡길 임무가 하나 더 있네. 아즈샤라 남북쪽 해안에서 마크리니 랍스트로크를 찾을 수 있을 거야. 녀석들의 눈알이 필요해. 정확히 열두 개 말이야.\n\n그리고 아크코란 변종과 헷갈리지 말게나. 그놈들은 마법에 변형되어서 내겐 아무 짝에도 쓸모없으니까.",
  },
  [27093] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "북쪽 아즈샤라의 마법사 탑에 있는 대마법사 실렘과 대화하십시오. 그곳으로 순간이동하려면 발로르모크 근처 야영지에서 사나스 임요를 찾으십시오.",
    ["D"] =
    "자네가 내 자잘한 심부름을 나간 사이에 대마법사 실렘으로부터 전갈이 왔어. 석판과 관련해 자네의 도움이 다시 한번 필요하다는군.\n\n오래 기다리게 하지 않는 게 좋을 거야. 지금은 그가 너를 좋게 보고 있으니 망치지 말게나.",
  },
  [27094] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "아즈샤라 남동쪽 모서리에 있는 조수 웅덩이에서 망명자 나가의 위치를 수색하십시오.",
    ["D"] =
    "자네가 폭풍의 만에서 가져온 유물들은 성물함 석판의 룬문자와 부분적으로만 일치하네. 이 퍼즐엔 아직 누락된 조각이 하나 있는데, 그걸 어디서 얻을 수 있을지 알 것 같군.\n\n내 점술에 의하면 아즈샤라 남동쪽 구석의 레이븐크레스트 기념비 아래, 웅덩이 속에 숨겨진 동굴에 은둔해 사는 나가 여마법사가 있네. 그녀를 찾아가 석판 해독을 도와달라고 부탁하게.\n\n그녀가 우리를 도울 거라 믿을 만한 이유가 있네.",
  },
  [27095] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "아크코로크의 자손을 처치하고 심해의 인장을 아즈샤라의 대마법사 실렘에게 가져가십시오.",
    ["D"] =
    "당신의 \"대마법사\" 친구는 자신의 점술로 나를 들여다볼 수 있었다는 사실에 스스로 똑똑하다고 생각하겠지만, 내가 발견되길 원했기 때문에 그가 날 볼 수 있었다는 건 깨닫지 못하는군요. 난 당신이 아크코란 신전에서 석판을 가져갔을 때부터 당신의 여정을 지켜봐 왔소. 당신은 지금 아즈샤라에 사는 모든 이들을 위협하는 길을 걷고 있고, 내가 수수방관하는 건 무책임한 행동이겠죠.\n\n그러니 한 번만 말해주겠소: 필멸자인 당신들이 이런 거대한 마법에 간섭하는 건 어리석은 짓이오. 이건 깊은 바다의 힘에서 비롯된 것이며, 애초에 당신들을 위한 게 아니오. 통제할 수도 없을 테고.\n\n내 말을 귀담아듣지 않을 거라는 걸 알기에 하나 더 말해주겠소. 아크코로크의 자손들은 깊은 바다를 횡단할 때 그들을 보호하는 특별한 인장을 지니고 있었기에 그 석판을 찾을 수 있었던 거요. 놈들 중 하나를 죽이고 인장을 뺏으시오. 그것이 당신의 실수에서 비롯될 재앙으로부터 당신이 살아남을 수 있도록 충분한 보호막을 제공해 줄지도 모르니.",
  },
  [27096] = {
    ["T"] = "아즈샤라의 유산",
    ["O"] = "아즈샤라 발로르모크의 대가 레안더에게 돌아가십시오.",
    ["D"] =
    "우리의 거래는 당분간 끝이네, $C. 자네의 스승에게 돌아가 자네의 봉사에 합당한 보상을 받아 가도 좋아.\n\n필요하다면 그에게 다시 연락하지. 난... 자네에게 감사해야 할 빚이 있네.",
  },
  [27097] = {
    ["T"] = "워블 할로우로 보내는 메시지",
    ["O"] = "아즈샤라 남부 해안의 멘나르 호수 남쪽 절벽에서 워블 할로우를 찾으십시오.",
    ["D"] =
    "주목해 주게 $R! 아즈샤라로 여행할 계획인가? 그렇다면 자네에게 임무를 하나 징발해야겠네.\n\n나의 초소에 아이언포지에서 웬디 워블스미스라는 사람을 위한 메시지가 도착했다네. 나에게는 낯선 이름이지만, 그 메시지에 따르면 노움 무리가 아즈샤라의 남쪽 가장자리 절벽 어딘가에 작전 기지를 세웠을지도 모른다고 하네. 이 메시지를 가지고 멘나르 호수 남쪽에서 수신자를 찾아 주겠나? 난 메시지를 전달하러 주둔지를 떠날 수 없다네.",
  },
  [27098] = {
    ["T"] = "정찰병 두라에게 메시지 전달",
    ["O"] = "아즈샤라 발로르모크에 있는 정찰병 두라를 찾아가십시오.",
    ["D"] =
    "이곳에 너무 오래 머무르면 악령숲의 오염이 자네의 살갗에 스며들 것이네, $R. 자네를 위해서 아즈샤라 발로르모크에 있는 새로운 전초기지를 방문해 보는 게 좋을 것 같군. 잠시 지옥의 강에서 벗어나 짠 바닷바람을 들이마셔 보게.\n\n그곳에 가면 내 친구 두라를 찾아보게. 그녀가 주변 지리에 대해 알려줄 것이네.",
  },
  [27099] = {
    ["T"] = "흑요석 강철",
    ["O"] = "아즈샤라 발로르모크에 있는 그룰 다크블레이드를 위해 수호병의 방패 6개를 수집하십시오.",
    ["D"] =
    "아, 동료 대장장이시군요. 혈관에서 화로 특유의 냄새가 나는 걸 맡을 수 있습니다.\n\n근처 엘다라스 폐허를 지키는 원한의꼬리일족 수호병들이 흑요석 강철을 다뤄 그 인상적인 방패를 제작한다는 사실에 당신도 꽤나 흥미를 느끼시겠죠.\n\n흑요석 강철이 뭐냐고요? 저 역시 그게 궁금합니다.\n\n그들이 가진 수호병의 방패 여섯 개를 모아서 제게 가져오십시오. 그러면 아마 우리가 함께 그 비밀을 밝혀낼 수 있을지도 모릅니다.",
  },
  [27100] = {
    ["T"] = "흑요석 강철",
    ["O"] = "수호병의 방패를 오그리마 명예의 골짜기에 있는 크라토크 몰튼피스트에게 가져가십시오.",
    ["D"] =
    "방금 보셨습니까, $N? 이 재료는 제 화로의 열기에도 전혀 녹지 않습니다!\n\n하지만 이곳 발로르모크의 장비는 기본 수준일 뿐입니다. 이 방패들을 오그리마의 대장간으로 가져가서 크라토크 몰튼피스트가 이것들을 녹일 수 있는지 확인해 보시겠습니까? 그는 명예의 골짜기 뒤쪽에서 찾을 수 있을 겁니다.",
  },
  [27101] = {
    ["T"] = "흑요석 강철",
    ["O"] = "녹은 흑요석 찌꺼기를 아즈샤라 발로르모크의 그룰 다크블레이드에게 가져가십시오.",
    ["D"] =
    "그룰이 이것들을 녹이고 싶다면, 그렇게 해주지. 내 숯의 열기는 아이언포지의 것만큼이나 뜨거우니까.\n\n<크라토크가 방패를 천천히 끈적하고 기름진 액체 찌꺼기로 녹여냅니다.>\n\n확실히 깔끔하게 녹지는 않는군. 내가 너라면 이 물건을 조심해서 다룰 거다. 하지만 그룰은 최고 중에 하나지. 그가 이 재료로 뭘 만들어 낼지 꽤 흥미롭군.",
  },
  [27102] = {
    ["T"] = "고위집행관 델링턴에게 보고",
    ["O"] = "티리스팔 숲의 보루에 있는 고위집행관 델링턴에게 보고하십시오.",
    ["D"] =
    "호드의 병사여! 이곳 병력에서 아제로스 전역의 다른 호드 전초기지로 긴급히 전달되어야 할 서신이 있다. 자네가 이 임무를 맡아주겠나?\n\n이 보고서를 티리스팔 숲 보루에 있는 고위집행관 델링턴에게 가져가라. 동부 왕국으로 이동한 뒤, 언더시티에서 동쪽 길을 따라 그의 야영지에 도착해야 한다.\n\n신속하게 움직이고, 명예와 함께하길!",
  },
  [27103] = {
    ["T"] = "파견사령관 루아그에게 보고",
    ["O"] = "슬픔의 늪 스토나드에 있는 파견사령관 루아그에게 보고하십시오.",
    ["D"] =
    "호드의 병사여! 슬픔의 늪 스토나드에 주둔하고 있는 파견 사령관 루아그가 보낸 전갈에 응답해야 한다. \n\n동부 왕국으로 가서 그롬골 주둔지 북쪽 길을 따라 그늘숲과 죽음의 고개를 거쳐 슬픔의 늪에 다다라야 한다. 꽤 멀지만 아주 중요한 임무다. 이 서신을 안전하게 배달해 줄 거라 믿어도 되겠나?",
  },
  [27104] = {
    ["T"] = "정찰병 두라에게 보고",
    ["O"] = "아즈샤라 발로르모크의 정찰병 두라를 찾아가십시오.",
    ["D"] =
    "페랄라스에서 오우거들과 맞서 자네가 한 일을 아주 높게 평가하네, $C. 그래서 자네를 훨씬 더 위험한 지역의 임무에 추천하려고 하네.\n\n페랄라스의 엘프 폐허가 인상 깊었다고 생각한다면 아즈샤라에 있는 것들을 볼 때까지 기다리게. 호드가 발로르모크에 전방 기지를 세웠고, 이 야생을 탐험하고 우리 위치를 지킬 자네 같은 투사들이 필요하네.\n\n내 명예를 걸고 자네를 추천하는 것이니 날 실망시키지 말게!",
  },
  [27105] = {
    ["T"] = "워블 할로우의 보급품",
    ["O"] = "아즈샤라의 워블 할로우에 있는 윌버 워블스미스와 대화하여 예비 기계 부품에 대한 도움을 요청하십시오.",
    ["D"] =
    "이런 황무지에서 동료 기술자를 만나게 되어 기쁘군. 이 전초기지의 모든 기계를 고치는 데 시간을 보내고 있는데, 쉽지 않은 일이라는 걸 말해주고 싶군!\n\n기술자로서 내 부탁 하나만 들어줄 수 있나? 톱니바퀴 같은 기본 부품들이 떨어져 가고 있거든. 멘나르 호수 남쪽 절벽 끄트머리에 노움 무리가 야영지를 세웠다고 하더군. 거기로 내려가서 우리가 싼값에 구할 수 있는 예비 부품이 있는지 좀 알아봐 줘. 그럼 충분히 보상해 줄 테니까.\n\n그래, 걔들이 얼라이언스 소속인 건 알지만, 그래도 꽤 친절한 녀석들이니까.",
  },
  [27106] = {
    ["T"] = "워블 할로우의 보급품",
    ["O"] = "남부 아즈샤라 해안과 바다에서 난파선 부품 10개를 수집하고, 제한된 순간이동기를 사용하여 아즈샤라의 워블 할로우로 돌아오십시오.",
    ["D"] =
    "기술자들에게 가장 많이 필요한 게 있다면 바로 예비 부품이죠. 불행히도 여기엔 쓸만한 예비 부품이 많지 않아요. 우리 스스로 부품을 긁어모아야 했거든요. 하지만 좋은 소식은 우리 정보통이 당신에게도 유용할 수 있다는 겁니다.\n\n<윌버가 남쪽의 탁 트인 바다를 가리킵니다.>\n\n저쪽엔 잠수만 조금 할 의향이 있다면 건질 수 있는 파편이 가득한 난파선이 널려있습니다. 자, 여기 순간이동기 표지기를 하나 드릴 테니 여기 있는 우리 순간이동기를 통해 다시 돌아올 수 있을 겁니다. 배터리가 오래가지 않으니 서둘러야 할 거예요. 행운을 빕니다!",
  },
  [27107] = {
    ["T"] = "워블 할로우의 보급품",
    ["O"] = "아즈샤라의 발로르모크에 있는 피짓에게 물에 젖은 부품 상자를 가져가십시오.",
    ["D"] =
    "자, 이것들을 상자에 담아드릴게요. 당신이 이걸 어디에 쓰려 했건 간에 도움이 되길 바랍니다. 잠깐만요, 이걸 어디에 쓴다고 말하셨었나요?\n\n<윌버가 창백해집니다.>\n\n아, 호드 전초기지라고요? 어, 음... 기술자들 간의 협력이라는 이름하에 저희가 제공한 도움이 여기 아즈샤라의 평화를 유지하는 데 큰 도움이 되길 바랍니다.\n\n이제 얼른 가보세요!",
  },
  [27108] = {
    ["T"] = "원한의꼬리일족의 마술",
    ["O"] = "북쪽 아즈샤라에 있는 마법사 탑의 조이 아나레스와 대화하십시오. 그곳에 가려면 발로르모크 근처 야영지에 있는 사나스 임요에게 먼저 말을 걸어야 할 수도 있습니다.",
    ["D"] =
    "이 땅에 흐르는 마력이 느껴지는감, $C? 자네가 마법부여 막대를 꽤 잘 다룬다는 건 알겠어 -- 마력이 자네 몸 주변에서 환하게 빛나고 있거든.\n\n그 기운을 좀 막아보고 싶나? 자네의 마법부여 실력을 시험해 보는 건 어떻고? 여기서 멀지 않은 대마법사 탑에 조수가 필요하다는 하이 엘프가 있더군. 그 위로 올라가려면 사나스 임요와 거래를 해야겠지만 한 번 가보는 것도 나쁘지 않을 거야.",
  },
  [27109] = {
    ["T"] = "원한의꼬리일족의 마술",
    ["O"] = "원한의꼬리일족 세이렌이나 여마법사에게서 암호화된 바다 두루마리 10개를 획득하여 아즈샤라 마법사 탑의 조이 아나레스에게 돌아가십시오.",
    ["D"] =
    "자네가 꽤 훌륭한 마법부여사라는 건 알겠지만, 날 위해 몇 가지 사소한 일들을 기꺼이 해준다면 내가 가르쳐 줄 수 있는 게 많아.\n\n영원의 샘 폭발로 대륙이 산산조각 났을 때 강력한 명가 마법사들은 나가로 변했지. 그들은 여전히 옛 비밀을 많이 알고 있고 난 그것들을 수집하는 게 목표야.\n\n나가 세이렌이나 여마법사를 처치하고 그들이 지닌 두루마리 10개를 모아오게. 아즈샤라의 남동쪽 끝에 있는 레이븐크레스트 기념비를 둘러싼 언덕이나, 남쪽의 으스러진 해안가에서 그들을 찾을 수 있을 거야.\n\n자, 가보게나!",
  },
  [27110] = {
    ["T"] = "원한의꼬리일족의 마술",
    ["O"] = "아즈샤라 남동쪽 레이븐크레스트 기념비에 있는 여마법사 얄리나에게서 원한의꼬리일족 주문껍질을 구해 아즈샤라 마법사 탑에 있는 조이 아나레스에게 돌아가십시오.",
    ["D"] =
    "이 두루마리들은 올바른 암호 해독 열쇠가 없으면 사용할 수 없는 마법 암호로 작성된 것 같군. 다행히도, 이번 주 초에 대마법사 실렘이 이 문제를 해결할 방법을 투시해 냈어.\n\n그는 이 지역을 평소처럼 감시하던 중, 아즈샤라 남동쪽 끝에 있는 레이븐크레스트 기념비에 새 지휘관이 자리 잡은 것을 확인했네. 이 여마법사 얄리나가 이 두루마리를 해독하는 데 필요한 열쇠나 징표를 가지고 있을 게 확실해. 그녀를 죽이고 이 징표를 내게 가져오게!",
  },
  [27111] = {
    ["T"] = "직물 방어",
    ["O"] = "아즈샤라에 서식하는 그물나무그늘거미에게서 그물나무그늘거미 실 10개를 구해 발로르모크의 쥴자에게 가져가십시오.",
    ["D"] =
    "이 땅에 흐르는 마력이 느껴지나, $C? 이곳에 사는 생물들에겐 어두운 과거와 불길한 미래의 전조지. 명가는 이 땅에 흐르는 바로 그 마법에 끔찍한 죄를 저질렀어. 그런 악에 비하면 내 부두 마법은 약하고 무력할 뿐이야.\n\n그것을 막아내고 싶나? 우리 재봉사들에겐 그럴 기술이 있지만, 이 근처에서 몇 가지 재료를 구해야 해.\n\n도와주고 싶다면 아즈샤라에 사는 그늘거미들의 거미줄을 내게 가져와. 그걸로 우리가 뭘 짤 수 있을지 보자고.",
  },
  [27112] = {
    ["T"] = "직물 방어",
    ["O"] = "아즈샤라의 블러드 엘프들에게서 엘프 옷감 12개를 구하여 발로르모크에 있는 쥴자에게 가져가십시오.",
    ["D"] =
    "직물에 대해 이야기하자면, 우리 동쪽의 블러드 엘프들은 태양빛으로 짠 고급 실을 잔뜩 가지고 있지. 그 옷감은 그들의 선조 마법에 선천적으로 저항하는 성질이 있어. 우리가 그것을 손에 넣을 수만 있다면, 이번 일이 훨씬 쉬워질 거야.\n\n블러드 엘프 야영지는 동쪽, 으스러진 해안 위쪽 절벽을 따라가면 나올 거다. 놈들의 실을 10여 개 정도 챙겨서 이리로 돌아와.",
  },
  [27113] = {
    ["T"] = "직물 방어",
    ["O"] = "아즈샤라 검은아귀 요새에 있는 무역상 말루에게 룬문자 실타래를 주고 가을 염료로 교환한 후 발로르모크의 쥴자에게 돌아가십시오.",
    ["D"] =
    "마지막으로 필요한 건 현지 재료로 만든 염료야. 대가 레안더에게 이렇게 사소한 부탁은 차마 못 하겠고 그의 수습생들은 우리를 돕기에는 너무 바쁘다네.\n\n듣자 하니 펄볼그들이 이방인에게 우호적인 북쪽 해안 마을에 펄볼그 상인이 하나 있다고 하더군. 그곳에 상인이 있다면 거래할 염료가 있는지 알아봐 주겠나?\n\n거래할 물건을 하나 가져가야 할 거야. 룬문자 실타래는 어떤가? 그들이 쓰는 것보다 훨씬 훌륭한 물건일 테니.",
  },
  [27114] = {
    ["T"] = "바다 인양",
    ["O"] = "워블 할로우 근처 바다에서 윌버, 웬디, 윌슨, 윌헬미나가 잃어버린 보급품을 수집한 후, 제한된 순간이동기를 사용하여 아즈샤라 워블 할로우의 윌버 워블스미스에게 돌아오십시오.",
    ["D"] =
    "안녕하세요 $C! 지금 워블 할로우는 촌스럽게 보일지 몰라도, 우리에게 시간만 조금 주신다면 이 아제로스의 외딴 구석에 기계공학의 경이로움을 세울 겁니다.\n\n그러기 위해 우리 가족이 가져온 보급품을 회수하는 걸 도와주셨으면 해요.\n\n우리는 처음에 세 대의 비행기로 출발했는데, 이 남쪽 바다에 모두 추락했죠. 그 후 화물을 회수하려 했지만 우리 배마저 가라앉아 간신히 해안으로 헤엄쳐 돌아와야 했습니다.\n\n우리 중 수영할 수 있는 사람이 아무도 없으니, 당신이 물속으로 뛰어들어 그 난파선에서 찾은 걸 가져다주시면 좋겠습니다.\n\n걱정 마세요! 과학의 힘이 있으니까요! 일이 다 끝나면 이 제한된 순간이동기를 사용해서 이리로 뿅 하고 돌아오시면 됩니다! 효율적으로 움직여야 할 거예요 -- 배터리 수명이 그리 길지 않거든요.",
  },
  [27115] = {
    ["T"] = "해안 인양",
    ["O"] = "아즈샤라 워블 할로우에 있는 윌버 워블스미스를 위해 아즈샤라 해안에서 난파선 보급품 10개를 수집하십시오.",
    ["D"] =
    "괜찮으시다면, 당신에게 부탁할 일이 더 있습니다, $C. 폭풍의 만 남쪽에 있는 해안과 웅덩이 지역은 사우스리지 해변이라고 불립니다. 우리 비행기가 여기 추락하기 전에 이 지역을 여러 번 공중에서 조사했었죠. 그곳 해변에 잔해들이 밀려온 곳이 꽤 많다는 걸 알았습니다. 사우스리지로 내려가서 그 상자들을 조사해주셨으면 합니다. 우리 워블 할로우 작업에 쓸모 있는 걸 찾아주시면 후하게 보상해 드리겠습니다. 어때요?",
  },
  [27116] = {
    ["T"] = "인양꾼 인양",
    ["O"] = "아크코란멀록 땅꾼을 처치하고 빛나는 전리품 상자를 되찾아 아즈샤라 워블 할로우에 있는 윌버 워블스미스에게 가져가십시오.",
    ["D"] =
    "제 공중 조사로 또 다른 흥미로운 곳을 발견했습니다. 바로 폭풍의 만 반대편, 북서쪽 끝에 있는 아크코란 신전이죠. 만을 순찰하는 바다 거인들이 주워 모은 물건들을 멀록들이 뒤질 수 있게 그곳에 남겨두고 가는 것 같습니다. 제가 생각하기에 놈들은 온갖 물건을 빼돌려 숨겨두는 것 같습니다. 멀록들은 반짝이는 걸 좋아하는 것 같으니까요.\n\n아무튼 그 말은 그 녀석들의 보물창고가 우리의 좋은 목표물이 될 수 있다는 뜻이죠. 멀록은 더러운 놈들이고 놈들을 쓰러뜨리는 건 공익을 위한 일입니다. 게다가 워블 할로우에 귀중한 자원을 약탈할 수도 있다는 게 추가 보너스죠! 한 번 해보시겠어요?",
  },
  [27117] = {
    ["T"] = "원한의꼬리일족 인양",
    ["O"] = "아즈샤라 워블 할로우의 윌슨 워블스미스를 위해 원한의꼬리일족 전투대장과 원한의꼬리일족 마법부여사를 처치하고 인양한 두루마리를 수집하십시오.",
    ["D"] =
    "제가 조사할 수 있었던 마지막 장소는 아즈샤라의 남동쪽 끝에 있는 레이븐크레스트 기념비 근처였습니다. 저는 그곳에 원한의꼬리일족 나가가 서식하고 있으며, 그들 중에는 강력한 주문 시전자인 여마법사도 있다는 걸 눈치챘습니다. 우리 노움은 과학 기술의 전문가지만, 때로는 마법이 기술만으로는 쉽게 할 수 없는 걸 보완해 줄 때가 있죠.\n\n이 나가들은 일상적인 마법이 깃든 두루마리를 종종 들고 다닙니다. 당신이 그 두루마리들을 그들에게서 좀 빼앗아 와 주셨으면 해요. 그러면 우리는 놈들의 마법으로 우리 기술을 보완할 수 있을 거고 -- 덤으로 우리 고향 근처의 나가 위협을 없애는 효과까지 누리게 되는 셈이죠!",
  },
  [27118] = {
    ["T"] = "아크코란 신전 정찰",
    ["O"] = "북서쪽 아즈샤라의 아크코란 신전으로 여행하여 아크코란멀록 땅꾼 8마리와 아크코란멀록 점쟁이 8마리를 처치하십시오.",
    ["D"] =
    "황무지에 오신 걸 환영하오, $C. 나처럼 자네도 이 땅의 거친 기운이 느껴지나?\n\n하그룸과 아그토르는 사방에 도사린 눈에 보이는 위협에만 신경 쓰고 있고, 그게 그들의 역할이지. 하지만 난 그 너머를 본다네. 저 지평선에 어렴풋이 보이는 아크코란이라 불리는 거대한 사원과 그 안에 숨어있는... <몸서리친다>... 멀록들 말이야.\n\n나는 이곳에 남아 위험이 없는지 감시하라는 명령을 받았지만, 자네가 날 위해 놈들을 쓸어버리고 나중에 일어날 멀록 침략의 악몽에서 우리를 구해줄 수 있지 않겠나?",
  },
  [27119] = {
    ["T"] = "지평선의 난파선",
    ["O"] = "아즈샤라 남부 해안선 어딘가에서 난파선 생존자들을 찾으십시오.",
    ["D"] =
    "어이 $C! 여기 워블 할로우에서는 아즈샤라 해안을 오르내리며 듀로타까지 아주 잘 볼 수 있습니다.\n\n얼마 전 수평선 위로 조난을 당한 배를 봤습니다. 꽤 먼 바다에서 가라앉았지만, 일부 생존자가 해안에 도달한 것 같습니다. 해안을 따라가 그들이 무사한지 확인해 주시겠습니까. 그들이 도움이 필요하다면, 우리가 할 수 있는 일은 기꺼이 돕고 싶습니다.",
  },
  [27120] = {
    ["T"] = "고대 땅의 전리품",
    ["O"] = "아즈샤라 발로르모크의 렐코를 위해 이끼발굽순록을 무두질하여 이끼발굽순록 생가죽 10개를 수집하십시오.",
    ["D"] =
    "이곳 아즈샤라에서 무두질하는 일은 고블린 상인의 금고만큼이나 수지가 맞는 장사지, $N. 자네도 이 전리품 좀 챙겨보고 싶나?\n\n전초기지를 지으려면 많은 재료가 필요하고, 발로르모크는 호드가 지을 수 있는 아주 훌륭한 기지야. 이 지역 전역에 서식하는 수사슴들의 가죽에 좋은 값을 매겨 줄 수 있네. 그것들을 처치하고, 무두질해서 가져오면 보물을 조금 나눠주지.",
  },
  [27121] = {
    ["T"] = "고대 땅의 전리품",
    ["O"] = "안개날개 키메라를 무두질하여 안개날개 키메라 가죽 10장을 수집한 후 아즈샤라 발로르모크의 렐코에게 돌아가십시오.",
    ["D"] =
    "아즈샤라 어디서나 수사슴을 볼 수 있지만 키메라는 찾기 훨씬 어렵지. 그놈들의 가죽을 구하는 건 훨씬 위험하고 -- 결과적으로 가치도 훨씬 더 비싸다네.\n\n전리품을 더 구하고 싶다면, 멘나르 호수 근처에서 희귀한 키메라를 찾을 수 있어 -- 하지만 대부분은 북동쪽에 서식하지. 그것들을 처치하고, 무두질해서 여기로 가져오면 보상을 주겠네!",
  },
  [27122] = {
    ["T"] = "고대 땅의 전리품",
    ["O"] = "오그리마의 카마리에게 가죽 꾸러미를 가져가십시오.",
    ["D"] =
    "친구, 마지막으로 하나 더 부탁하겠네. 오그리마에 이 가죽들을 기쁜 마음으로 작업할 내 지인이 있지만, 어떠한... 사정 때문에... 난 당분간 도시에 안 들어갈 생각이네. 이 가죽 꾸러미를 명예의 골짜기에 있는 가죽세공 상점의 카마리에게 가져가면 그녀가 수고에 대한 넉넉한 보상을 해줄 거야.\n\n하지만 그녀가 묻는다면, 자네는 날 보지 못한 거고, 내가 어디 있는지도 모르는 거며, 계산서는 이미 보냈다고 전해 주게.",
  },
  [27123] = {
    ["T"] = "학생들 보급품 조달",
    ["O"] = "아즈샤라 발로르모크의 수습생 사리나에게 태양풀 20개를 가져가십시오.",
    ["D"] =
    "아, 안녕하세요, $C. 뭐 필요한 거라도 있으신가요? 전 대가 레안더께서 저희에게 지시한 모든 일을 처리하느라 몹시 바쁘거든요.\n\n저기, 혹시 약초학자이신가요? 그렇다면 정말 큰 도움이 될 것 같아요. 태양풀이 거의 바닥났는데, 아즈샤라에는 흔하지만 제가 직접 캐러 갈 시간이 없거든요. 여행 중에 좀 보이면 우리 재고를 채워주시겠어요?\n\n수습생 사리나에게 가져다주세요. 그녀가 태양풀을 이용한 새로운 공식을 연구 중이거든요.",
  },
  [27124] = {
    ["T"] = "학생들 보급품 조달",
    ["O"] = "거대한 폭풍히드라 5마리를 처치하고 그것들의 소화 주머니를 수집하십시오. 그런 다음 아즈샤라 발로르모크의 수습생 자비스에게 가져가십시오.",
    ["D"] =
    "우리가 연구소를 세운 이후로 코린은 저에게 엉뚱한 꽃이나 보내면서 계속 시간을 낭비하고 있어요. 그 시간에 아즈샤라 식물 채집 카탈로그 작업에나 집중할 것이지!\n\n진정으로 저희를 돕고 싶으시다면, 우리 수습생들 힘만으론 도저히 해낼 수 없는 일이 하나 있습니다. 아즈샤라 남동쪽 해안에 서식하는 거대한 폭풍히드라들이 레이븐크레스트 기념비 아래의 섬세한 웅덩이를 이리저리 누비며 그곳의 희귀하고 섬세한 식물들을 짓밟고 있습니다. 그 히드라들이 너무 위험해서 우린 아직 그 웅덩이에서 자라는 모든 종의 목록조차 제대로 파악하지 못하고 있어요.\n\n당신이 그 히드라들을 처치하고 소화 주머니를 모아주신다면 그 지역에서 자라는 식물에 대해 더 잘 이해할 수 있을 겁니다. 모을 수 있으시다면, 2층에 있는 식물학 전문가인 수습생 자비스에게 가져다주세요.",
  },
  [27125] = {
    ["T"] = "학생들 보급품 조달",
    ["O"] = "사우스리지 해변의 조수 웅덩이에서 하얀 조수 연꽃 8송이를 수집하여 아즈샤라 발로르모크의 수습생 윈터에게 가져가십시오.",
    ["D"] =
    "대단하네요, $C! 이 폭풍히드라 위장 속에 <백색 연꽃> 즉, 하얀 조수 연꽃의 잔해가 남아있어요.\n\n하얀 조수 연꽃은 믿을 수 없을 정도로 희귀하며, 이걸 채취하려면 노련한 약초학자가 필요합니다. 안타깝게도 여기 수습생 중에는 그 정도 실력을 갖춘 사람이 없어요. 하지만 혹시 당신이라면...?\n\n이 약초 수집을 돕고 싶으시다면 아즈샤라 남동쪽 지역의 계곡과 바위 사이에 있는 조수 웅덩이를 찾아보세요. 연꽃을 발견하면 꼭대기 층에 있는 수습생 윈터에게 가져다주세요.",
  },
  [27126] = {
    ["T"] = "펄볼그 -- 고블린 무역로",
    ["O"] = "아즈샤라에 있는 킴야엘에게 스팀휘들 무역회사와 검은아귀 마을 간의 무역로 개설에 대해 이야기하십시오.",
    ["D"] =
    "새로운 친구 안녕. 나 말루, 검은아귀 무역상.\n\n이제 이방인에게 마을 열었으니, 나 거래로 새로운 장신구 많이 모은다. 새 친구 중에 킴야엘이라는 작고 녹색 남자 있다. 그 사람 자기가 검은아귀 마을에서 멀리 떨어진 다른 수많은 녹색 사람들과 무역하게 도울 수 있다고 말했지.\n\n말루 이방인과 교역하느라 마을에 머물러야 하지만, 네가 그 사람 찾아서 말루가 무역 원한다고 말해 줄래? 그는 멀지 않은 곳, 엘프 야영지 위쪽 언덕에 산다.",
  },
  [27127] = {
    ["T"] = "펄볼그 -- 고블린 무역로",
    ["O"] = "톱니항에 있는 M. 스펜서 코퍼핀치에게 스모키우드 목장과 검은아귀 마을 간의 무역로 개설에 대해 이야기하십시오.",
    ["D"] =
    "정말이지, $N... 당신을 $N이라고 불러도 될까요? 솔직히 말해서 저는 그 녀석에게 단지 예의상 한 말일 뿐입니다. 검은아귀 녀석들이 수집하는 물건들은 제가 주로 다루는 상품이 아니거든요.\n\n하지만 당신이 여기까지 오셨고 흔쾌히 부탁을 들어주실 것 같으니 한 가지 제안을 하죠. 남쪽의 스모키우드 목장에서 일하는 제 사촌에게 꽤 짭짤한 일거리가 있습니다. 그들은 온갖 기이한 장난감과 장신구들로 유명하죠. 검은아귀 부족이 깎아 만든 토템이 율 축제 때 잘 팔릴지도 모르잖아요? 아니면 신선한 생선을 팔 시장이 있을 수도 있고요? 저도 자세한 건 잘 모르겠습니다.\n\n톱니항의 스모키우드 사무실 밖에서 그들의 물건을 팔고 있는 제 사촌을 찾을 수 있을 겁니다. 이름은 M. 스펜서 코퍼핀치입니다.",
  },
  [27128] = {
    ["T"] = "펄볼그 -- 고블린 무역로",
    ["O"] = "스팀휘들 항구에 있는 재비에게 스팀휘들 무역회사와 검은아귀 마을 간의 무역로 개설에 대해 이야기하십시오.",
    ["D"] =
    "저기 $N... $N이라고 불러도 되겠죠? 스모키우드 목장은 최고급 품질의 상품을 취급합니다. 이 녀석들의 상품은 그야말로 \"장인의 솜씨\"라는 말에 어울리는 것 같군요. 아즈샤라 숲에 사는 곰들이 만든 수공예품이라뇨? 하! 비록 그게 까다로운 나이트 엘프 시장을 파고들 기회를 줄지도 모르지만... 음....\n\n<M. 스펜서 코퍼핀치가 잠시 생각에 잠깁니다.>\n\n아뇨, 아뇨. 절대 안 될 일입니다. 미안해요 $N, 당신이 제안한 물건은 제게 필요하지 않아요. 게다가 킴야엘이 절 찾아보라고 한 건 단지 그 녀석이 널 떼어내려고 보낸 게 분명해요. 하지만 이런 건 어때요? 제가 아주 훌륭한 기업가로서, 펄볼그들이 파는 물건에 흥미를 느낄 만한 사람과 당신을 연결해 드리죠. 제 옛 룸메이트였던 재비가 타나리스의 스팀휘들 항구에서 물건을 팔고 있습니다. 어쩌면 아주 먼 북쪽에서 온 물건들이 그의 고객들에게 뭔가 새로운 것이 될지도 모르잖아요?",
  },
  [27129] = {
    ["T"] = "펄볼그 - 고블린 무역로",
    ["O"] = "스팀휘들 무역회사와 검은아귀 마을 간의 무역로 개설에 대해 행상 러즈고트와 이야기하십시오.",
    ["D"] =
    "있지 $N... 널 $N이라고 불러도 되겠어? 이봐, 곰들이 숲에서 장난감을 만든다는 지어낸 이야기를 들고 내 상점 안으로 걸어 들어오는 촌놈을 만나는 건 매일 있는 일이 아니거든. 재밌는 농담이군!\n\n잠깐, 진심이야?\n\n음. 뭐, 기름이 흐르고 물을 뿜어대기 시작한 이후로 이곳 스팀휘들 항구에 더 많은 사람들이 찾아오고 있지. 그 말은 곧 관광객들이 늘어났다는 뜻이고! 무법항에 있는 아이들에게 가져다 줄 선물을 찾는 해적이든 기분 전환이 필요한 목마른 행상이든, 난 누구에게나 물건을 팔 거야. 그러니 좋아, 알았어, 한 번 해보자고!\n\n가장 먼저 필요한 건 기반 시설이야. 아즈샤라에 배를 대고 물건을 싣고 이곳으로 항해해 올 누군가가 필요하지. 무법항에 있는 행상 러즈고트와 이야기해 보는 게 어때? 그가 북쪽 바다에 이미 알고 있는 연줄이 있는지 알아보라고?",
  },
  [27130] = {
    ["T"] = "펄볼그 -- 고블린 무역로",
    ["O"] = "스팀휘들 무역회사와 검은아귀 마을 간의 무역로 개설에 대해 황야의 땅 스프링소켓에 있는 조아킴 스파크루트와 대화하십시오.",
    ["D"] =
    "내 예전 호위병 중 한 녀석이 황야의 땅에 있는 스프링소켓으로 스팀휘들 무역회사가 이주할 때 자기 짐마차 회사를 세웠다네. 거긴 완전 불모지니까 녀석에겐 일이 좀 더 필요할 거라고 생각해. 이름은 조아킴 스파크루트이고 휴일에는 동네 주변을 어슬렁거리는 녀석을 쉽게 찾을 수 있을 거야.\n\n러즈고트가 보냈다고 하면 서비스 수수료를 깎아줄지도 모른다네!",
  },
  [27131] = {
    ["T"] = "펄볼그 -- 고블린 무역로",
    ["O"] = "스팀휘들 무역회사와 검은아귀 마을 간의 무역로 개설에 대해 눈망루 마을의 우마론 스트래가렐름과 대화하십시오.",
    ["D"] =
    "러즈고트가 제대로 짚어 주긴 했지만 난 그 일에 적합한 고블린이 아니야. 황야의 땅을 떠난다는 건 생각조차 할 수 없다고. 여긴 할 사업이 널려 있어서, 아무리 솔깃한 곰들의 이야기라 한들 그런 기회들을 놓치고 싶진 않아.\n\n하지만 헤이, 완전히 헛수고한 건 아니야. 내 예전 직원 중 하나가 더위를 정말 싫어해서 사막과는 가장 거리가 먼 곳으로 가버렸거든. 바로 여명의 설원이야. 눈망루 마을에 있는 우마론 스트래가렐름과 대화해 봐. 녀석은 지금 일도 없고 그 일을 할 만한 경험도 있지.\n\n행운을 빈다 $N... 널 $N이라 불러도 되겠지?",
  },
  [27132] = {
    ["T"] = "펄볼그 - 고블린 무역로",
    ["O"] = "당신이 개척한 무역로에 대해 검은아귀 마을의 무역상 말루와 대화하십시오.",
    ["D"] =
    "이 검은아귀 마을이 해안가에 있다고 했나? 그리고 물건을 타나리스의 스팀휘들 항구로 가져가야 한다고? 꽤 쉬울 것 같군. 내 여동생의 증기선을 빌리면 되겠다. 걔가 어떤 노움이랑 결혼했거든... 어쩌다 보니.\n\n다음 달부터 배송을 시작할 수 있네. 마을의 거래처에 선적용 포장만 잘 해두라고 전해줘. 바구니든 상자든 다 좋아. 물건을 그냥 두지만 않으면 돼, 파손돼도 내 책임은 아니니까.\n\n혹시 계약서 보냈어? 아니라고? 뭐, 곰이니까. 종이 쪼가리 같은 건 안 만질 것 같군.\n\n아무튼 거래는 거래라고 전해줘. 도와줘서 고맙네.",
  },
  [27133] = {
    ["T"] = "도둑들!",
    ["O"] = "레트레스 성소에서 알렉산드라의 책을 회수하여 아즈샤라 황폐한 해안에 있는 그녀에게 돌려주십시오.",
    ["D"] =
    "우리가 나가의 손, 아니 발톱이나 지느러미에 공격당한 게 이번이 처음은 아니에요! 우리가 처음 도착했을 때 해변에 바로 자리를 잡았죠. 우리가 알아채기도 전에 멀록과 나가들이 우리를 습격해 우린 여기까지 후퇴해야만 했어요.\n\n전 딱 한 번 뒤돌아봤는데, 멀록 중 하나가 제가 평생을 바쳐 쓴 책에 그 생선 같은 손가락을 뻗는 걸 보았어요. 부디 제 책을 되찾아주신다면 그 대가를 기꺼이 지불하겠습니다. 그들은 동쪽의 레트레스 성소 쪽에서 온 것 같았어요.",
  },
  [27134] = {
    ["T"] = "만일을 대비해서",
    ["O"] = "레트레스 성소에서 원한의꼬리일족 약탈자 10마리와 원한의꼬리일족 마녀 5마리를 처치한 뒤 아즈샤라 황폐한 해안에 있는 패트릭 밀스에게 돌아가십시오.",
    ["D"] =
    "나가가 우리를 여기까지 밀어붙인 후, 우린 줄곧 수비 태세였습니다. 지금은 한숨 돌리고 있지만, 의사가 부상자들을 치료하는 동안 놈들을 떼어놓기 위해선 무언가 해야 합니다.\n\n알렉산드라는 레트레스 성소에서 나가가 다가오는 것을 보았다고 했습니다. 우리를 도울 생각이 있으시다면, 그곳이 그들을 공격하기 좋은 지점일 겁니다. 운이 좋다면 그들이 추가 공격을 보내는 걸 망설이게 될 겁니다.",
  },
  [27135] = {
    ["T"] = "벼랑 끝에서",
    ["O"] = "아즈샤라 황폐한 해안에 있는 의사 텔틴을 위해 의료용 보급품 상자 3개를 모으십시오.",
    ["D"] =
    "정말 악몽 같아요. 먼저 배가 가라앉았고 그다음엔 포위당했고, 이젠 보급품마저 바닥나고 있습니다.\n\n부탁 하나 해도 될까요? 남쪽에 있는 지평선 정찰대의 잔해에서 우리 의료 보급품 중 일부가 떠올랐을지도 모릅니다. 서쪽에서 노움의 집 같은 것도 봤고요. 그곳에서 보급품을 팔지도 몰라요.\n\n어디서든 의료 보급품을 가져와 주신다면 아즈샤라가 어떤 시련을 던져주든 우린 살아남을 수 있을 거예요.",
  },
  [27136] = {
    ["T"] = "지평선 정찰대",
    ["O"] = "아즈샤라의 지평선 정찰대 근처에서 이등항해사 샨드릴을 찾으십시오.",
    ["D"] =
    "나와 내 선원들은 당신이 와줘서 정말 운이 좋소. 상황이 조금씩 나아지기 시작하는군.\n\n이미 당신에게 많은 것을 요구했다는 건 알지만 우리가 처음 이곳에 발이 묶였을 때 내 이등항해사 샨드릴이 지평선 정찰대 근처에 다른 생존자가 있는지 확인하러 나갔소. 내가 이곳을 지킬 테니 그녀가 무사한지 확인해 주겠소? 그녀는 우리 위치에서 바로 남쪽에 있을 거요.",
  },
  [27137] = {
    ["T"] = "지평선 정찰대",
    ["O"] = "지평선 정찰대의 잔해 근처에서 실종된 선원들을 수색한 뒤 이등항해사 샨드릴에게 돌아가십시오.",
    ["D"] =
    "배가 침몰했을 때 우리 대부분은 목숨을 건졌지만, 선원 3명이 아직 실종된 걸 확인했어요. 그들을 찾을 수 있을까 싶어 난파선으로 헤엄쳐 내려가 보았지만, 다치는 바람에 더 이상 수색할 수 없었죠.\n\n아직 부상을 회복 중이에요. 이 소녀의 부탁 좀 들어주셔서 일등항해사, 요리사, 그리고 기술자를 찾아봐 주시겠어요? 운이 좋다면 그들이 빠져나왔겠지만 예감이 썩 좋진 않네요.",
  },
  [27138] = {
    ["T"] = "최선을 다하지만, 크게 기대하진 마라",
    ["O"] = "지평선 정찰대의 잔해에서 롤랜드 기어대블러를 구하기 위해 \"최선\"을 다하십시오.",
    ["D"] =
    "그 망할 노움 자식! 지평선 정찰대에는 몇 명의 승객이 타고 있었는데 그중 하나가 이 질질 짜는 롤랜드라는 꼬마 노움이었습니다. 내가 실종된 선원들을 찾을 수 있는지 알아보려고 했을 때, 그 노움 녀석이 나를 공격했어요.\n\n뭔가 발작을 일으키는 것 같아요. 내 일이니까 어떻게든 그를 제정신으로 돌려놔서 안전한 곳으로 데려오려 최선을 다하지 않는다면 직무 유기겠지만 지금 당장은 그를 상대할 여력이 없습니다. 당신이 저보다는 운이 좋지 않을까요?\n\n정당방위로 그를 죽여야 한다 해도 이해하겠습니다.",
  },
  [27139] = {
    ["T"] = "지평선 정찰대",
    ["O"] = "아즈샤라 황폐한 해안에 있는 선장 바네사 벨티스에게 돌아가십시오.",
    ["D"] =
    "지금 당장 당신이 할 수 있는 일은 다 한 것 같군요. 난 돌아가기 전에 여기서 건질 수 있는 게 더 있는지 좀 알아봐야겠어요.\n\n선장님께 보고해 주세요.",
  },
  [27140] = {
    ["T"] = "지맥 나침반",
    ["O"] = "기묘한 나침반을 아즈샤라 발로르모크의 대가 레안더에게 가져가십시오.",
    ["D"] =
    "당신이 처치한 마술사왕은 기묘한 마법 장치를 지니고 있었습니다. 나침반 모양이지만, 그 안의 섬세한 은빛 부품들은 정북쪽을 가리키지 않습니다. 대신 유리덮개 아래에서 빠르게 돌다가, 멈출 때마다 다이얼처럼 보이는 곳에 그려진 낯선 표식들을 가리킵니다.\n\n아마 발로르모크의 대가 레안더가 이 물건을 조사하는 데 관심이 있지 않을까요?",
  },
  [27141] = {
    ["T"] = "부서진 해변 지휘관",
    ["O"] = "으스러진 해변에서 바다여사제 아킬라를 찾아 처치한 후, 아즈샤라 워블 할로우의 웬디 워블스미스에게 승전보를 전하십시오.",
    ["D"] =
    "이 나가는 미역에 싸인 일종의 명령서를 가지고 있었습니다. 나가의 불가해한 글씨의 세부 내용은 알아볼 수 없지만, 그 명령서에 지휘관인 바다여사제 아킬라의 이름이 명시되어 있다는 것은 알아차렸습니다.\n\n으스러진 해안에서 원한의꼬리일족의 지휘관을 제거하면 웬디 워블스미스가 기뻐할 것이며, 워블 할로우의 안전을 지키는 데 큰 도움이 될 것입니다. 근처에 있는 큰 천막들을 수색해 보는 게 어떨까요?",
  },
  [27142] = {
    ["T"] = "부서진 해변 지휘관",
    ["O"] = "으스러진 해안에서 바다여사제 아킬라를 찾아 처치한 후, 아즈샤라 발로르모크의 하그룸 블러드피스트에게 승전보를 전하십시오.",
    ["D"] =
    "이 나가는 미역에 싸인 일종의 명령서를 가지고 있었습니다. 나가의 불가해한 글씨의 세부 내용은 알아볼 수 없지만, 그 명령서에 지휘관인 바다여사제 아킬라의 이름이 명시되어 있다는 것은 알아차렸습니다.\n\n으스러진 해안에서 원한의꼬리일족의 지휘관을 제거하면 하그룸 블러드피스트가 기뻐할 것이며 발로르모크의 안전을 지키는 데 큰 도움이 될 것입니다. 근처에 있는 큰 천막들을 수색해 보는 게 어떨까요?",
  },
  [27143] = {
    ["T"] = "나무구렁일족 동맹",
    ["O"] = "문지기 레이지로어와 대화하여 검은아귀 펄볼그가 타락하지 않았다고 설명하십시오. 그들이 당신에게 대화하려면 나무구렁일족 평판이 최소한 약간 우호적이어야 합니다.",
    ["D"] =
    "이제 너는 검은아귀 부족의 친구니 검은아귀가 할 수 없는 일을 할 수 있다.\n\n나무구렁 펄볼그들은 형제지만 다른 어떤 펄볼그도 믿지 않는다. 합당한 이유지. 많은 펄볼그가 타락했으니까. 하지만 나무구렁일족은 검은아귀일족과 비슷하다. 너는 나무구렁일족의 친구가 될 수 있다. 만약 네가 나무구렁과 검은아귀 모두의 친구라면, 넌 검은아귀 부족을 위해 문지기 레이지로어에게 편지를 가져갈 수 있다.\n\n레이지로어는 나무구렁 요새 입구를 지키고 있다. 하지만 그에게 접근하려면 넌 나무구렁일족의 친구여야 한다. 그들에게 검은아귀 부족은 타락하지 않았다고 전해라. 우리가 친구라는 사실도 전하고.",
  },
  [27144] = {
    ["T"] = "나무구렁일족 동맹",
    ["O"] = "아즈샤라 나무구렁 요새에 있는 정찰병 갈레스와 대화하십시오.",
    ["D"] =
    "난 자네를 믿네, $C. 왜냐하면 자네는 나무구렁일족의 친구고 자네가 검은아귀 부족의 친구라고 말하니까.\n\n<문지기 레이지로어가 고민합니다.>\n\n정찰병 갈레스를 자네와 함께 검은아귀 부족에게 보내겠네. 그를 보호하게. 그가 진실을 보고 보고할 것이네. 그를 데리고 무사히 여행하게나.",
  },
  [27145] = {
    ["T"] = "나무구렁일족 동맹",
    ["O"] = "검은아귀 부족이 타락하지 않았음을 증명하기 위해 정찰병 갈레스를 검은아귀 마을까지 호위하십시오.",
    ["D"] =
    "나 검은아귀 부족과 대화한 적 없다. 악마들이 오기 전부터 멀리 떨어져 살았지. 그들의 족장에 대한 무서운 소문도 들었다. 사람들이 그가 늑대로 변한다고 하던데. 너 본 적 있나? 없어? 그럼 진짜가 아닐지도 모르지.\n\n준비 끝나면 말해라. 악마 보이면 날 보호해 줘라. 그래야 내가 검은아귀 부족 만날 수 있으니까.",
  },
  [27146] = {
    ["T"] = "나무구렁일족 동맹",
    ["O"] = "문지기 레이지로어의 우정의 제안을 아즈샤라 검은아귀 마을의 대족장 운갈에게 가져가십시오.",
    ["D"] =
    "나무구렁일족의 친구로서 이 편지를 검은아귀 부족에게 전해주어라. 우리가 지켜보겠다. 너희의 냄새도 기억할 것이다. 우리는 함께 악마들과 싸우지.\n\n우리는 검은아귀 부족을 주시할 것이고 검은아귀 부족도 나무구렁일족을 지켜볼 것이다. 만약 타락이 찾아온다면, 우리는 우리가 해야 할 일을 할 것이다.\n\n자, 우정을 나누러 가라 $N.",
  },
  [27147] = {
    ["T"] = "다가오는 겨울",
    ["O"] = "아즈샤라 이끼발굽순록에게서 사슴 고기 스테이크 10개를 수집해 돼지치기 구눅에게 가져가십시오.",
    ["D"] =
    "제 열정은 돼지들에 쏟고 있지만, $N. 돼지들만으로는 우리가 겨울을 날 만큼 식량을 충당할 수 없습니다 -- 특히나 녀석들도 뭘 먹어야 할 땐 말이죠!\n\n머리에 거대한 뿔이 달린 살집 좋은 커다란 짐승들이 숲을 배회하는 걸 봤습니다. 타우렌 중 한 명이 그놈들을 '사슴' 또는 '수사슴' 어쩌고라고 부르더군요. 먹음직스럽게 생겼으니 다가오는 겨울을 위해 그 고기를 비축해둬야 합니다. 제게 그 짐승의 고기를 넉넉하게 구해다 주실 수 있습니까?",
  },
  [27148] = {
    ["T"] = "다가오는 겨울",
    ["O"] = "발로르모크 동쪽의 나가에게서 원한의꼬리일족 해초 10개를 수집해 아즈샤라 발로르모크의 돼지치기 구눅에게 가져가십시오.",
    ["D"] =
    "제디가는 아즈샤라에 온 첫 번째 오크 중 한 명인데, 어처구니없게도 해초 맛에 빠져버렸지 뭡니까!\n\n제디가의 말에 따르면 고기처럼 다양한 방법으로 해초를 요리할 수 있다더군요. 말리기, 양념하기, 볶기, 굽기, 스튜 만들기 등등 말입니다.\n\n듣자 하니 해변 쪽 나가들이 해초를 엄청 많이 가지고 있다는군요. 그게 그들을 크고 강하게 만든다면, 어쩌면 우리도 크고 강하게 만들어줄지 모르죠. 나가들에게서 해초 좀 왕창 구해주실 수 있습니까?",
  },
  [27149] = {
    ["T"] = "다가오는 겨울",
    ["O"] = "아크코란 랍스트로크를 처치하고 거대한 랍스트로크 집게발 10개를 모아 아즈샤라 발로르모크에 있는 돼지치기 구눅에게 가져가십시오.",
    ["D"] =
    "트롤들이 이곳 바다에서 바닷가재를 잡는다는 얘기를 하더군요. 우리도 고향 드레노어에서 바닷가재를 먹었었죠. 전 바닷가재를 아주 좋아합니다.\n\n그런데 여기 아즈샤라에 바닷가재 인간들이 있더군요! 그들의 집게발은 더 크답니다. 분명 맛도 더 좋을 거예요. 살도 훨씬 많을 거고요.\n\n요리해 볼 수 있도록 그 크고 살이 꽉 찬 집게발을 좀 가져다주시겠습니까? 여기서 동쪽, 해변을 따라 아크코란 신전 옆으로 가면 그 녀석들이 무리 지어 있습니다.",
  },
  [27150] = {
    ["T"] = "다가오는 겨울",
    ["O"] = "검은아귀 마을의 무역상 말루에게서 검은아귀 부족의 버터를 구해 아즈샤라 발로르모크에 있는 돼지치기 구눅에게 가져가십시오.",
    ["D"] =
    "저 같은 비천한 돼지치기에게 이렇게나 큰 도움을 주시다니요. 또 부탁드리기는 싫지만, 이 바닷가재 집게발과 곁들일 버터가 너무 필요합니다.\n\n북쪽 해안에는 외부인에게 나무구렁일족보다 호의적인 펄볼그들의 야영지가 있습니다. 검은아귀 부족이라고 불리는데, 그들은 우리와 기꺼이 물건을 거래합니다. 이 베이컨 한 조각을 그곳 상인에게 가져가서 버터와 교환해 줄 수 있는지 물어봐 주시겠습니까?",
  },
  [27151] = {
    ["T"] = "배고픈 노움",
    ["O"] = "아즈샤라에 있는 이끼발굽순록에게서 사슴 고기 스테이크 10개를 수집해 워블 할로우의 윌헬미나 워블스미스에게 가져가십시오.",
    ["D"] =
    "이봐요 $R! 워블 할로우에 오신 걸 환영해요.\n\n뭐 좀 먹을 걸 대접하고 싶지만 솔직히 물고기 빼곤 먹을 게 없어요. 매일 말이에요.\n\n바다 덕분에 굶어 죽진 않겠지만, 전 지금 육즙이 좔좔 흐르는 스테이크가 너무 먹고 싶어요. 숲속을 배회하는 웅장한 사슴들을 본 적은 있지만, 저는 사냥꾼이 아니잖아요. 당신만 괜찮다면, 사슴 고기를 잔뜩 가져다주시면 충분히 보상해 드릴게요.",
  },
  [27152] = {
    ["T"] = "배고픈 노움",
    ["O"] = "엘다라스 폐허와 으스러진 해안에 있는 원한의꼬리일족 나가에게서 노획한 보급품 10개를 수집한 후 아즈샤라 워블 할로우의 윌헬미나 워블스미스에게 돌아가십시오.",
    ["D"] =
    "이 고기를 당장 구워 먹고 싶지만 세상에, 향신료만 조금 있다면 뭐든 다 줄 텐데. 약간의 양념, 약간의 소금... 잠깐, 거기서 좋은 생각이 났어요!\n\n폭풍의 만은 아주 위험한 곳이라서 정기적으로 배들이 난파되어 밀려오죠. 으스러진 해안의 원한의꼬리일족 나가들이 이 난파선들을 약탈한답니다. 걔들이 분명 보급품을 잔뜩 쌓아두고 있을 테고 향신료가 들어있을 거라 거의 장담해요!\n\n주변에 널려 있는 걸 주울 수 있을지, 아니면 무력으로 나가들에게서 뺏어야 할지 모르겠지만, 제가 찾는 걸 구해주시면 두둑하게 보답해 드릴게요.",
  },
  [27153] = {
    ["T"] = "배고픈 노움",
    ["O"] = "아크코란 랍스트로크를 처치하고 거대한 랍스트로크 집게발 10개를 모아 아즈샤라 워블 할로우에 있는 윌헬미나 워블스미스에게 가져가십시오.",
    ["D"] =
    "앗싸! 횡재했네요 $N! 이 상자들 안에 자극을 덜어주는 향신료와 매운 향신료가 잔뜩 들어있어요. 하지만 지금, 제게 더 좋은 생각이 났죠....\n\n스테이크보다 맛있는 게 뭔지 아세요? 바로 바닷가재와 함께 먹는 거랍니다!\n\n바다에서 나는 건 이제 질렸다고 했던 건 알지만, 이젠 바다와 육지의 진미를 동시에 맛볼 생각을 하니 도저히 머릿속에서 지워지질 않네요.\n\n그러면 바닷가재를 어디서 구하냐가 문제인데. 혹시 거대한 고기 집게발을 달고 아즈샤라를 돌아다니는 바닷가재 인간들을 본 적 있나요? 아즈샤라 북서쪽 끝에 있는 아크코란 신전 쪽에 놈들이 엄청나게 몰려 있어요. 칼날집게 마크리니마크루라와 뾰족뿔 마크리니마크루라를 죽여서 그 고기를 제게 가져다주세요! 그게 얼마나 맛있을지 상상이 가시나요?",
  },
  [27154] = {
    ["T"] = "배고픈 노움",
    ["O"] = "검은아귀 마을의 무역상 말루에게서 검은아귀 부족의 버터를 구해 아즈샤라 워블 할로우에 있는 윌헬미나 워블스미스에게 가져가십시오.",
    ["D"] =
    "좋아요 $N! 해산물도 있고! 고기도 있고! 양념도 있어요! 그런데... 오 안 돼... 오 안 돼! 버터가 없네요. 버터 없이 어떻게 맛있고 고소한 스테이크와 바닷가재를 먹을 수 있죠?\n\n이 꿈을 포기할 순 없어요 $N. 아즈샤라 어딘가에서 버터를 구할 수 있는 약간의 가능성이 있습니다.\n\n북쪽 해안을 따라 외부인들에게 우호적인 펄볼그들의 야영지가 있어요. 듣자 하니 걔네들이 온갖 물건을 파는 상인이라고 하더라고요. 혹시 이 베이컨 한 조각과 교환해서 그들이 버터를 구해줄 수 있지 않을까요?",
  },
  [27155] = {
    ["T"] = "발로르모크의 위협",
    ["O"] = "발로르모크에 있는 하그룸 블러드피스트를 위해 원한의꼬리일족 전사 10마리와 원한의꼬리일족 비명술사 10마리를 처치하십시오.",
    ["D"] =
    "환영한다, 호드의 병사여!\n\n발로르모크는 칼림도어에 세워진 호드의 가장 전방 전초기지다. 우리의 기지를 안전하게 지키려면 너의 도움이 필요하다.\n\n우선 근처 폐허에 있는 나가들을 소탕하는 것부터 시작해라. 네 무기가 녀석들의 피로 붉게 물들 때까지 전사들과 비명술사들을 죽여라!\n\n잠깐... 나가도 붉은 피를 흘리던가?\n\n어디 한 번 알아봐!",
  },
  [27156] = {
    ["T"] = "발로르모크의 위협",
    ["O"] = "발로르모크에 있는 하그룸 블러드피스트를 위해 원한의꼬리일족 미르미돈 10마리와 원한의꼬리일족 세이렌 10마리를 처치하십시오.",
    ["D"] =
    "발로르모크 근처의 나가들은 약해빠져서 쉽게 부서지는 법이지. 그렇게 허접한 적을 상대하게 해서 미안하지만, 너에게 더 적합한 임무를 제안하기 전에 우선 네 실력을 시험해 봐야 했거든. 동쪽 으스러진 해안으로 내려가면 훨씬 까다로운 적들을 만날 수 있을 거다.\n\n원한의꼬리일족 미르미돈과 세이렌을 처치해라. 해변에서 적을 쓸어버려 오늘 밤 우리 침상에서 편안히 잘 수 있도록!",
  },
  [27157] = {
    ["T"] = "발로르모크의 위협",
    ["O"] = "하그룸 블러드피스트를 위해 폭풍해안멀록 전사 15마리를 처치하십시오.",
    ["D"] =
    "내 상관인 혈투사 글러쉬는 특히 멀록들을 혐오하지. 나야 멀록들에 대해 그렇게까지 특별히 불쾌하게 생각하진 않지만 놈들이 위협이 되는 건 사실이다.\n\n엄청나게 많은 놈들의 전사가 아즈샤라 북부 해안을 순찰하고 있다. 놈들이 조직력을 갖추고 우리에게 맞서 들고일어나지 못하도록 녀석들의 머릿수를 줄여라.\n\n그러면 글러쉬도 멀록들의 그 기괴한 소리에 대해 더 이상 징징거리지 않겠지.",
  },
  [27158] = {
    ["T"] = "발로르모크의 위협",
    ["O"] = "발로르모크에 있는 하그룸 블러드피스트를 위해 푸른용기병 5마리, 푸른용혈족 맹독전사 5마리, 용혈족 마술사 5마리를 처치하십시오.",
    ["D"] =
    "자네가 다양한 전사들을 상대로 실력을 증명했는데, 마법을 쓰는 적들은 어떤가?\n\n남쪽 멘나르 호수 주변에는 푸른용혈족 무리가 살고 있다네. 놈들이 있다는 건 이 일대에 지맥이나 다른 마력의 핵이 있을 가능성이 크다는 뜻이지. 앞으로 우리는 이 자원을 활용해야 할 필요가 있을 게야.\n\n미리 진입하여 놈들의 병력을 박살 냄으로써 놈들에게 호드의 공포를 심어주게. 그러면 우리가 본격적으로 병력을 이끌고 갔을 때 놈들이 도망치겠지.\n\n푸른용기병들은 결코 만만한 상대가 아니야. 이 임무를 위해선 분대를 조직하는 편이 좋을 거다.",
  },
  [27159] = {
    ["T"] = "발로르모크의 위협",
    ["O"] = "발로르모크에 있는 하그룸 블러드피스트를 위해 절벽거인 5마리를 제거하십시오.",
    ["D"] =
    "자네에게 많은 것을 요구했지만 $N, 지금까지 한 번도 실망시킨 적이 없군. 우리의 안전을 확보하기 위해 마지막 임무를 주겠네.\n\n아즈샤라의 절벽거인들이 우리를 침공할 만큼 체계적인 것 같지는 않지만 그들의 우렁찬 발걸음이 대지를 뒤흔들어 우리가 이곳에 건설 중인 모든 것, 특히 광산에 큰 위협이 되고 있네. 그놈들의 머릿수를 좀 줄여주게.\n\n마침 분대가 구성되어 있다면 그들을 다시 데려가는 게 좋을 거야. 행운을 비네.",
  },
  [27160] = {
    ["T"] = "발로르모크 광산 보고서",
    ["O"] = "광산 상황을 보고받기 위해 아즈샤라 발로르모크 광산에 있는 현장감독 레오폴드, 감독관 갈드, 현장감독 레너드와 대화하십시오.",
    ["D"] =
    "발로르모크에 온 것을 환영한다, $C. 대족장님의 뜻에 따라 이 땅을 정복하고 그 자원들을 활용하여 호드의 장비와 물자를 조달하기 위해 우리가 이곳에 있는 것이다.\n\n난 전초기지 일들을 처리하느라 바빴네. 혹시 마을 북쪽에 있는 광산에 들러 관리자들을 확인해 줄 수 있겠나? 놈들이 상황 보고를 올릴 시간이 지났거든.",
  },
  [27161] = {
    ["T"] = "일하며 휘파람 불기",
    ["O"] = "발로르모크 일꾼 5명과 함께 /휘파람 을 분 다음, 아즈샤라 발로르모크의 아그토르 블러드피스트에게 돌아가십시오.",
    ["D"] =
    "날 급진주의자라 불러도 좋지만 난 음악이 힘든 하루를 바꿀 수 있다고 믿어. 그러니 입술을 모아 광부들과 함께 광산 아래서 휘파람을 조금 불어봐. 신나게 휘파람을 불며 광석을 캘 수 있을 거야. 박자를 맞춰주는 노래가 있다면 그렇게 오래 걸리진 않을 테지.\n\n기분이 좋아지면 시간도 훌쩍 갈 거야. 그러니 그들이 일하면서 휘파람을 불게 하자고.\n\n<아그토르가 당신을 향해 무섭도록 씩 웃습니다.>",
  },
  [27162] = {
    ["T"] = "오그리마에 발로르모크 보고",
    ["O"] = "오그리마 지혜의 골짜기에 있는 스랄에게 발로르모크 보고서를 가져가십시오.",
    ["D"] =
    "<아그토르 블러드피스트가 한숨을 내쉽니다.>\n\n제가 누구에게 농담을 하겠습니까? 음악 조금 틀어준다고 모든 게 해결되진 않겠죠.\n\n얼라이언스나 불타는 군단과 싸울 때가 훨씬 쉬웠습니다. 지금은 온통 '사기', '약혼', '더 이상 켄타우로스 가죽을 벗기지 마라' 같은 얘기뿐입니다.\n\n광부들에게 영향을 미치는 무언가가 있다면 스랄님께서 어떻게 해야 할지 아실지도 모릅니다. 어찌 됐든 광산이 가동 중이긴 하지만 아직 목표 생산량에 도달하지 못했다는 사실을 그분께 보고해야 합니다. 오그리마의 지혜의 골짜기에 있는 그분께 이 메시지를 전해주시겠습니까?",
  },
  [27163] = {
    ["T"] = "현상 수배: 푸른용",
    ["O"] = "워블 할로우의 웬디 워블스미스를 위해 푸른용기병 5마리, 푸른용혈족 맹독전사 5마리, 용혈족 마술사 5마리를 처치하십시오.",
    ["D"] =
    "모험가 여러분 주목: 워블 할로우 북쪽 멘나르 호수 근처에 푸른용 무리가 살고 있습니다. 이 적들은 우리 작업에 위협이 됩니다. 이들의 수를 줄여주는 사람에게는 누구에게나 보상이 제공됩니다. \n\n경고: 이들은 매우 강력한 적입니다.\n\n이 임무를 완수하고 워블 할로우에 있는 웬디 워블스미스와 대화하십시오.",
  },
  [27164] = {
    ["T"] = "현상 수배: 절벽거인",
    ["O"] = "절벽거인 5마리를 처치한 뒤 아즈샤라 워블 할로우에 있는 웬디 워블스미스에게 가십시오.",
    ["D"] =
    "모험가 여러분 주목: 아즈샤라 저편에 절벽거인들이 돌아다니고 있습니다. 이 끔찍한 괴물들의 발구름 소리가 우리가 워블 할로우에서 사용하는 정밀 장비들에 악영향을 주고 있습니다. 이 거인 중 몇을 제거하고 평화를 되찾아주는 모든 이들에게 보상이 지급될 것입니다.\n\n경고: 이들은 매우 강력한 적입니다.",
  },
  [27165] = {
    ["T"] = "불타는 칼날단 징표",
    ["O"] = "불타는 칼날단 징표 10개를 모아 크로스로드의 톨크에게 돌아가십시오.",
    ["D"] =
    "불타는 칼날단에 대해 들어보셨겠죠? 군단이 도래한 이후 아제로스 전역을 괴롭혀 온 무자비한 악마 숭배 집단 말입니다. 놈들은 불모의 땅까지 침입하여 작은 마을 하나를 약탈했습니다.\n\n제 최우선 임무는 이 땅의 안전이기에, 가서 그들을 이곳에서 몰아내 주십시오! 그들을 처치했다는 증거로 그들의 징표 반지를 몇 개 가져오십시오. 우리 정찰병의 보고에 따르면 그들은 여기서 북서쪽으로 꽤 멀리 떨어진 산맥인 공포안개 봉우리에 야영지를 세웠다고 합니다.",
  },
  [27166] = {
    ["T"] = "증오에 삼켜지다",
    ["O"] = "크로스로드의 만크릭에게 콜카르 켄타우로스의 머리 10개를 가져오십시오.",
    ["D"] =
    "나디아의 운명을 알 수 없어 매일같이 불확실성 속에서 살아가는 기분이 어떤지 아십니까? 알 수도 있고 모를 수도 있겠지만 확실한 건 단 하나... 전 복수를 원합니다. 피를 원합니다. 콜카르 놈들은 죽어야 합니다!\n\n제 발로 직접 가고 싶지만 도망치던 중 다리를 다쳤습니다. 날 대신해 가주시오, $r. 놈들의 머리를 가져오면 복수가 이루어졌음을 알 수 있을 겁니다.",
  },
  [27167] = {
    ["T"] = "외국 기술",
    ["O"] = "죽음의 폐광으로 잠입하여 인지 재구성기를 훔쳐 크로스로드의 트라우그에게 가져가십시오.",
    ["D"] =
    "이곳 불모의 땅에서 우리 기술은... 한계가 있소. 저는 무기나 도구를 좀 더 복잡하고 자동화된 방식으로 만들 수 있는 기술을 얻고 싶소. 제겐 그런 지식이 없지만, 그걸 가진 자들은 있죠.\n\n죽음의 폐광에 대해 들어본 적 있소? 데피아즈단의 요새인데, 동부 왕국의 서부 몰락지대에 위치해 있다오. 그곳에서 데피아즈단을 위해 장치를 만드는 길니드라는 사악한 고블린을 찾을 수 있을 거요.\n\n소문에 의하면 그가 원자재를 무기로 바로 찍어내는 새로운 장치를 가지고 있다고 하더군! 호드가 더 강해질 수 있도록 그 장치를 제게 가져다주시오! 하지만 조심하시오, 데피아즈단은 그들의 기계를 쉽게 내어주지 않을 테니 친구들과 함께 가는 것이 좋을 거요.",
  },
  [27168] = {
    ["T"] = "전투 중 실종",
    ["O"] = "나디아에게 무슨 일이 일어났는지 알아내고 크로스로드의 만크릭에게 돌아와 보고하십시오.",
    ["D"] =
    "놈들은 한밤중에 떼거지로 몰려왔소. 켄타우로스는 끔찍하고 역겨운 괴물들이오. 난 살기 위해 우리 마을에서 도망쳐 이 은신처로 왔지만, 내 아내 나디아는 그러지 못했지.\n\n그들이 남쪽에 있는 푸른 오아시스 근처 텐트로 그녀를 데려갔소. 끔찍한 상상만 들지만, 난 꼭 알아야 하오, $N. 제발 그들의 텐트에서 무슨 단서라도 찾을 수 있을지 확인해 주시오. 그리고 가능하다면 그녀를 다시 데려와 주시오. 길을 가로막는 켄타우로스가 있다면 전부 학살해 주시오.",
  },
  [27169] = {
    ["T"] = "잔해 수색",
    ["O"] = "만크릭의 마을에서 나디아의 흔적을 찾고 크로스로드의 만크릭에게 돌아가십시오.",
    ["D"] =
    "그녀가 켄타우로스로부터 도망쳤다니! 나디아가 왜 이곳으로 오지 않았을까요? 아마 제가 여깄는지 모르는 걸지도 모릅니다. 그렇다면 우리가 그녀를 찾아야만 합니다. 제가 그곳에 있을 거라 생각하고 우리 마을로 돌아갔을 겁니다.\n\n$N, 내 마을로 가서 그녀를 찾아주십시오. 북쪽으로 길을 따라가다 갈림길에서 오른쪽으로 가십시오. 그리고 이 땅이 듀로타와 만나는 해안선을 따라 남쪽으로 가십시오. 그곳에서 우리 마을을, 그리고 부디 나디아를 찾을 수 있을 겁니다.",
  },
  [27170] = {
    ["T"] = "내 손을 떠난 일",
    ["O"] = "불모의 땅에서 신질을 찾아내십시오.",
    ["D"] =
    "우리가 그녀를 찾기 위해 더 이상 할 수 있는 일이 없소, $n. 외부의 도움을 구해야만 하오. 당신이 심문한 포로들이 그녀가 도망쳤다고 했으니 난 그녀가 살아있다고 확신하오.\n\n이 지역 사람들에게 도움을 주었던 신질이라는 트롤 주술사에 대한 이야기를 들었소. 그는 이 마을에서 조금 북쪽으로 가면 나오는 갈림길 근처에 산다오. 가서 그와 이야기해 보시오. 그가 나디아를 찾는 데 도움을 줄 수 있는지 말이오.",
  },
  [27171] = {
    ["T"] = "Retrieving the Orb",
    ["O"] = "Kill Archmage Korgar and bring his orb to Shin\'Zil in The Barrens.",
    ["D"] =
    "Aye, I can help you mon, but we need some things to begin de ritual so that we can focus on Nadia\'s location. De only thing that be powerful enough to find her is located in Northwatch Hold.\n\nThere is a powerful mage there dat goes by the name of Archmage Korgar. His orb, de source of his power, is under constant protection. If we are to find Nadia, we be needing that orb.\n\nYou be finding Northwatch Hold just south of Ratchet, mon. But you best be mindful, de guards don\'t take kindly to strangers.",
  },
  [27172] = {
    ["T"] = "Infusing the Orb",
    ["O"] = "Siphon 5 Essence of Lightning into Korgar\'s Orb and return to Shin\'Zil in The Barrens.",
    ["D"] =
    "This be de orb we looking for, mon. But now dat we have the orb, we need to infuse it with de power of nature. Far south, past de Crossroads, live packs of thunder lizard that look similar to kodos.\n\nWe need to harness their essence and infuse it into de orb... while they be alive for de most potent power. After you do dat, return to me so that we may complete de ritual.",
  },
  [27173] = {
    ["T"] = "Report to Mankrik",
    ["O"] = "Report to Mankrik at The Crossroads with the news of Nadia\'s location.",
    ["D"] =
    "We found her, mon! Remember, southwest of de Lushwater Oasis is a Bristleback village. It is there that you will find her.\n\nWaste no time, go tell Mankrik de news! Also, if anyone else at de Crossroads be needing help, please send them my way.",
  },
  [27174] = {
    ["T"] = "Finding Nadia",
    ["O"] = "Locate Nadia in the Bristleback Village in The Barrens.",
    ["D"] =
    "We are so close to finding her, $n. I am familiar with the area Shin\'Zil told you about. It is called Agama\'gor, and many Bristleback dwell there.\n\nYou will find it southwest of the Lushwater Oasis. I am counting on you, please, bring my beloved Nadia back to me.",
  },
  [27175] = {
    ["T"] = "Opening the Cage",
    ["O"] = "Collect Gortak\'s Key and release Nadia from her cage in The Barrens.",
    ["D"] =
    "I\'m so glad you\'re here! Many days have I been trapped here... lost... waiting. But I think I know a way out!\n\nI have observed their leader from time to time, they call him Gortak. He always comes from a Bristleback village northwest of here. I\'ll bet anything he has the key to my cage! But be careful, he looks a lot tougher than the others... you might need some friends to take him on.",
  },
  [27176] = {
    ["T"] = "The Good News",
    ["O"] = "Tell Mankrik at The Crossroads of Nadia\'s escape.",
    ["D"] =
    "Thank you for all your assistance, $N. I owe my life to you. I know my way home from here, but you tell me it has been destroyed. I suppose I must take refuge at The Crossroads until we can build a new home.\n\nGo on ahead and tell Mankrik all that has happened. I know he must be dying of uncertainty, not knowing my fate. I will be right behind you!",
  },
  [27177] = {
    ["T"] = "Operation: Northwatch Hold",
    ["O"] = "Steal the Crate of Assorted Armor from Northwatch Hold and bring it to Thork at The Crossroads.",
    ["D"] =
    "Psst! You, yeah you! You see that keep in front of us? Those Theramore guards are using it as an outpost for supplies. I\'ve been observing them for the past few days, and I\'m concerned they have enough supplies to launch an attack on The Crossroads!\n\nI want you to get in there and steal their armor. You can probably find it in their blacksmith building. Bring it back to Thork at The Crossroads so we can use it for our soldiers.",
  },
  [27178] = {
    ["T"] = "Contract #1001: Corehound Manure",
    ["O"] = "Fill a box with Corehound Manure from The Beast\'s room in Blackrock Spire.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. We all like food, right? Well here\'s a contract that benefits the produce department.\n\nContract #1001: Obtain Corehound manure from within Blackrock Spire\n\nQuantity: One Carton",
  },
  [27179] = {
    ["T"] = "Contract #1024: Dark Iron Slag",
    ["O"] = "Collect 4 handfuls of Dark Iron Slag from prominent dwarves within Blackrock Depths.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. Here\'s one that benefits our toy division.\n\nContract #1024: Obtain Dark Iron Slag from within Blackrock Depths\n\nQuantity: Four Handfuls",
  },
  [27180] = {
    ["T"] = "Contract #1031: Necrotic Dye",
    ["O"] = "Collect 4 Necrotic Dye from members of the Cult of the Damned in Stratholme.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. Do you like presents? Who doesn\'t!? Here\'s one from the giftwrap department.\n\nContract #1031: Obtain Necrotic Dye from within Stratholme\n\nQuantity: Four Vials",
  },
  [27181] = {
    ["T"] = "Contract #1063: Ogre Musk",
    ["O"] = "Collect 4 Pints of Ogre Musk from Blackrock Spire.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. Here\'s one from the perfume, cologne, and scented candle division.\n\nContract #1063: Obtain Ogre Musk from within the lower part of Blackrock Spire\n\nQuantity: Four Pints",
  },
  [27182] = {
    ["T"] = "Contract #1088: Oversized Femur",
    ["O"] = "Collect an Oversized Femur from a Risen Construct in Scholomance.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. Do you like music? Who doesn\'t!? Here\'s one from the music department.\n\nContract #1088: Obtain a femur from within Scholomance\n\nQuantity: One (Oversized)",
  },
  [27183] = {
    ["T"] = "Contract #1025: Sanctified Cloth",
    ["O"] = "Collect a Bolt of Sanctified Cloth from within the Scarlet Enclave of Stratholme.",
    ["D"] =
    "I have jobs available for contractors willing to assemble a team. Here\'s one from the drive-thru wedding industrial complex we\'d like to set up in Booty Bay.\n\nContract #1025: Obtain Sanctified Cloth from within Stratholme\n\nQuantity: One Bolt",
  },
  [27184] = {
    ["T"] = "Supplies from Alterac Valley",
    ["O"] = "Win a game of Alterac Valley to acquire the Alterac Supply Cache.",
    ["D"] =
    "Smokywood does business all over Azeroth, including some of the most dangerous places. We even have agreements with some of the battleground factions to receive supply caches if we contribute combatants to their efforts.\n\nI need supplies from Alterac Mountains. Emerge victorious from Alterac Valley and you\'ll be able to pick up an Alterac cache containing pure snow and wintersbite used for our Wondervolt machines. Are you willing to join the fight?",
  },
  [27185] = {
    ["T"] = "Supplies from Bloody Tokens",
    ["O"] = "Bring 5 Bloody Tokens to Morrison Copperpinch in Ratchet.",
    ["D"] =
    "The goblin trade cartels are neutral when it comes to the tension between the Horde and the Alliance, but I\'m intrigued by the bloody tokens that are sometimes obtained when you fight each other. There are certain off the books \"entrepreneurs\" who are willing to supply rare ingredients in exchange for these bloody tokens.\n\nI\'m not going to risk MY hide to obtain some, but if you\'re willing to, it would impress me.",
  },
  [27186] = {
    ["T"] = "Supplies from Eastern Plaguelands",
    ["O"] = "Capture one of the towers in Eastern Plaguelands for Morrison Copperpinch in Ratchet.",
    ["D"] =
    "We\'ve only just begun to explore how the changed flora and fauna in the Eastern Plaguelands can be used to best effect. It\'s a dangerous area, and we\'ve had more agent fatalities there than any other place on Azeroth.\n\nMaybe you can help make it a safer place by taking control of one of the towers the Argent Dawn has established there? Then I can let my agents know it\'s a safe harbor, if they need it.",
  },
  [27187] = {
    ["T"] = "Supplies from Gillijam\'s Island",
    ["O"] = "Win a game of Gillijam\'s Island to acquire the Gillijam Supply Cache.",
    ["D"] =
    "Smokywood does business all over Azeroth, including some of the most dangerous places. We even have agreements with some of the battleground factions to receive supply caches if we contribute combatants to their efforts.\n\nI need supplies from Gillijam\'s Island. Emerge victorious from Gillijam\'s Island and you\'ll be able to pick up a Gillijam supply cache containing wildvine and bananas used for our secret potions. Are you willing to join the fight?",
  },
  [27188] = {
    ["T"] = "Supplies from Warsong Gulch",
    ["O"] = "Win a game of Warsong Gulch to acquire the Warsong Supply Cache.",
    ["D"] =
    "Smokywood does business all over Azeroth, including some of the most dangerous places. We even have agreements with some of the battleground factions to receive supply caches if we contribute combatants to their efforts.\n\nI need supplies from Ashenvale. Emerge victorious from Warsong Gulch and you\'ll be able to pick up a Warsong cache containing oil and naga scales used for holiday ornaments. Are you willing to join the fight?",
  },
  [27189] = {
    ["T"] = "The Chilling Components",
    ["O"] = "Collect 10 Chilling Owl Feathers from owls in Winterspring.",
    ["D"] =
    "How much would you pay for a good night\'s sleep? You don\'t have to answer -- I know its worth a lot of gold. That\'s why Smokywood is developing an experimental pillow, made from the finest cooling technology.\n\nWe need more feathers for our prototype and only one source will do -- the owls in Winterspring. Their feathers are innately chilled, making for a comfortable sleep even if you\'re bedding down next to Blackrock Mountain. Are you willing to take the job?",
  },
  [27190] = {
    ["T"] = "The Element of Dread",
    ["O"] = "Obtain an Artisanal Water Core from Unfiltered Elementals on the Isle of Dread in Feralas.",
    ["D"] =
    "Have you ever had our coffee? That deep peaty aroma comes from the special roast on our beans, achieved from bathing them in artisanal water from elementals extracted in their natural habitat.\n\nOne water core lasts for a long time in our process but it\'s time to replenish it from our special source in Feralas. Are you willing to take the job?",
  },
  [27191] = {
    ["T"] = "The Mushrooms of Fungal Vale",
    ["O"] = "Collect 5 Nictia Colabrus mushrooms from the Fungal Vale in Eastern Plaguelands",
    ["D"] =
    "Have you ever tried our mince meat fruitcake or meat pies? Meat is easy to come by, but the spices -- that\'s where the flavor comes from!\n\nWe use a variety of mushrooms in our pies, but there\'s a rare kind I\'d like to try. They\'re called Nictia Colabrus, and they only grow in the Fungal Vale in Eastern Plaguelands. Do you think you\'d be up to gathering some for me?",
  },
  [27192] = {
    ["T"] = "The Sentries of the Dark Portal",
    ["O"] = "Kill 5 Felguard Sentries near the Dark Portal in the Blasted Lands.",
    ["D"] =
    "Do you know the Dark Portal in the Blasted Lands? Most people avoid it on account of that whole Legion war thing, but Smokywood isn\'t one to let a little thing like a demonic invasion get in the way of business!\n\nWe have an agent who routinely siphons energy radiated by the portal, but there have been some issues with the Felguard Sentries that patrol the area. If you could thin them out so our agents can get on with their tasks, that would be great!",
  },
  [27193] = {
    ["T"] = "The Stars Over Winterspring",
    ["O"] =
    "Use the Marvelous Owlkin Obtaining Neuralizer to siphon 5 Essence of Starlight from owlbeasts in Winterspring.",
    ["D"] =
    "I hope you\'ve noticed that goods made by Smokywood Pastures have that little extra *something* that makes them special. It\'s not a trick -- it\'s a tiny infusion of starlight in everything we make.\n\nOur starlight supplies are running low, but I have recently obtained a new tool that can be used to drain starlight from creatures particularly attuned to it, like the owlbeasts in Winterspring. Just weaken and drain, easy-peasy. Interested in the job?",
  },
  [27194] = {
    ["T"] = "The Terrorweb Trial",
    ["O"] = "Retrieve the Smokeywood Pastures dropbox from Terrorweb Tunnel in Eastern Plaguelands.",
    ["D"] =
    "Smokywood agents have been collecting a variety of spider silk in Eastern Plaguelands and arranged for a drop off at one of our secure box locations, located in Terrorweb Tunnel. There\'s a problem though -- the Venture Company has been tailing our agent and I think they know the location of the drop box. I need you to secure that shipment by any means necessary!",
  },
  [27195] = {
    ["T"] = "Straight to the Teeth",
    ["O"] = "Gather 10 Hecklefang Teeth and bring them back to Kaliyah Stormshew at Camp Taurajo.",
    ["D"] =
    "Greetings, $c, by now you must know that Azeroth is a deadly place. To venture without fear, one needs a strong, sturdy weapon.\n\nI need some teeth from the local Hecklefang Hyenas for my tribe\'s weapons. I am not strong enough to go and fight them myself, but I\'ll make you a deal. Bring me back some of their teeth and I\'ll fashion you a weapon as well.",
  },
  [27196] = {
    ["T"] = "The Kolkar Report",
    ["O"] = "Bring the Kolkar Report to Thork at The Crossroads.",
    ["D"] =
    "This appears to be a note scrawled in Kolkar writing and is unreadable to you. It would be a good idea to bring this report to Thork at The Crossroads.",
  },
  [27197] = {
    ["T"] = "The Merchant\'s Daughter",
    ["O"] = "Bring the Box of Treasure back to Wrenix the Wretched in Ratchet.",
    ["D"] =
    "Hey friend, you want to make some money? Times are tough around here, but I heard a rumor that off the coast of this town lies a ship at the bottom of the sea, called The Merchant\'s Daughter.\n\nInside the wreckage is some treasure. Who knows what the crew of that ship had in there! I don\'t, but I do know that I won the key to the treasure chest off a drunken sailor the other night. Bring that treasure back and I\'ll give you a bit of the cut.",
  },
  [27198] = {
    ["T"] = "The Missing Lorespeakers",
    ["O"] = "Search the Southern Gold Road for any sign of the missing caravan.",
    ["D"] =
    "Hail, adventurer. Are you traveling the Southern Gold Road by chance?\n\nI am expecting a caravan to arrive here but it\'s overdue by several days. I\'m concerned something has happened to them.\n\nIf you venture south, keep an eye out for a tauren and troll traveling in a kodo-driven wagon.",
  },
  [27199] = {
    ["T"] = "The Missing Lorespeakers",
    ["O"] = "Return to Sage Elkhoof at Camp Taurajo with the bad news.",
    ["D"] =
    "You look around the wreckage. The bones are freshly picked clean. The crates are broken open and looted.\n\nA broken quilboar tusk lies in the dirt. There are also arrows and a discarded dagger that look like quilboar make. You pick up the dagger as evidence to take to Sage Elkhoof when you deliver the bad news.",
  },
  [27200] = {
    ["T"] = "The Missing Lorespeakers",
    ["O"] = "Recover 8 Tauren Lore Scrolls from the quilboar encampment at Blackthorn Ridge.",
    ["D"] =
    "Poor Mina and Selim. They were peaceful researchers, not warriors. They had no quarrel with the quilboar... but now I do!\n\nThat wagon contained crates of tauren lore scrolls from Freewind Post. I can only assume the quilboar are now in possession of them. Go down to their encampment at Blackthorn Ridge near where they attacked the caravan, and recover those scrolls. Kill any quilboar that get in the way. That is my vengeance for my fallen brethren.",
  },
  [27201] = {
    ["T"] = "The Triad Scrolls",
    ["O"] = "Infiltrate Razorfen Kraul and recover the Triad Scrolls from the quilboar.",
    ["D"] =
    "The Triad scrolls are a set of three scrolls that describe the founding of Thunder Bluff, Sunrock Retreat, and Camp Mojache. This was the first time this lore was written down from the original oral history. We must recover them.\n\nI have a terrible suspicion that these scrolls have been sent as trophies to the quilboar stronghold at Razorfen Kraul. You must make your way into that place and recover them!",
  },
  [27202] = {
    ["T"] = "The Obsidian Relic",
    ["O"] = "Take the Obsidian Relic to Gann Stonespire in the Barrens.",
    ["D"] =
    "Among the Prospector\'s possessions is a strange relic at odds with the style of the ruins in the Bael Modan excavation. It is made of a black material that seems to suck away the light around it.\n\nPerhaps Gann Stonespire will know what to do with such an ominous find?",
  },
  [27203] = {
    ["T"] = "The Obsidian Relic",
    ["O"] = "Take the Obsidian Relic to Pawe Mistrunner at Thunder Bluff.",
    ["D"] =
    "If the dwarves were interested in such a thing, I am filled with concern. If this is in any way a weapon, our allies must be made aware.\n\nTake this relic to Pawe Mistrunner on the Spirit Rise in Thunder Bluff. She has an interest in old things and may be able to help.",
  },
  [27204] = {
    ["T"] = "WANTED: Deepskin",
    ["O"] = "Slay Deepskin and bring his tooth to Thork at The Crossroads.",
    ["D"] =
    "Many adventurers have fallen prey to this particularly aggressive crocolisk. He roams the river bordering The Barrens and Durotar.\n\nBring one of his fangs to Thork in The Crossroads as proof of his death.",
  },
  [27205] = {
    ["T"] = "My Sister Isabetta",
    ["O"] = "Speak to Isabetta Wheeland at her home on an island off the coast of Darkshore just south of Auberdine.",
    ["D"] =
    "I\'ve been here in town looking for help with this murloc problem for so long that my sister Isabetta must be wondering where I am.\n\nWhile you\'re out and about dealing with the murlocs, would you be willing to stop by the house and tell her I\'ll be home soon?\n\nWe built a home on a little island south of town.",
  },
  [27206] = {
    ["T"] = "My Sister Isabetta",
    ["O"] = "Investigate the fire at Isabetta Wheeland\'s house.",
    ["D"] =
    "A woman\'s body lies here. You assume it must be Isabetta Wheeland. Although her hair is singed and she has burns on her hands, the cause of her death appears to be several stab wounds to the chest.\n\nIt looks like her body was searched, as her pockets have been turned out.\n\nThe house nearby still smolders from a recent fire. Perhaps you should investigate the scene before letting Bill Wheeland know what has happened?",
  },
  [27207] = {
    ["T"] = "My Sister Isabetta",
    ["O"] = "Travel to Westfall and tell Evangeline Wheeland about the fire and Isabetta Wheeland\'s death.",
    ["D"] =
    "This... this is a scrap from a Defias mask, I\'d bet my life on it. It seems certain that this is the work of the Defias -- a band of thugs and villains that are terrorizing the commonfolk in the lands of Stormwind. They followed us... they wanted to send a message.\n\nI must send a message of my own. If you\'re willing, take this message to our other sister, Evangeline. She\'s part of the militia, back in Westfall. She has information that the Defias wouldn\'t want shared with others. If they came to Darkshore for Isabetta, then Evangeline\'s life is also in danger.\n\nIt is a long journey, $C, but it start by taking the boat from here to Menethil Harbor.",
  },
  [27208] = {
    ["T"] = "My Sister Isabetta",
    ["O"] = "Kill Omar Dorn at the Gold Coast Quarry and bring his Defias Key to Evangeline Wheeland in Westfall.",
    ["D"] =
    "The Defias followed Isabetta to Darkshore, burned down her house, and killed her? Oh my god!\n\n<Evangeline looks stunned, then a wave of determination seems to pass over her face.>\n\nI\'m sorry, $C. You\'ve stepped into the middle of a situation much larger than you could know. And, I need help. But I don\'t know if I can trust you yet.\n\nIf you want to help, would you mind taking on a task? There is a Defias lieutenant who has made a home in the Gold Coast Quarry, which is farther to the west on this road. His name is Omar Dorn. Take him out and bring me the key he carries.",
  },
  [27209] = {
    ["T"] = "My Sister Isabetta",
    ["O"] =
    "Use the Defias Key to open the Defias Lockbox concealed in Moonbrook. Bring what you find inside it to Evangeline Wheeland in Westfall.",
    ["D"] =
    "Moonbrook was once a thriving town. Now it is a den of thieves, a stronghold for Defias sympathizers.\n\nSomewhere in Moonbrook there is a strongbox where certain documents are kept. This key you recovered from Omar Dorn should open it. I\'d like you to bring me any papers you find inside it -- but I\'ll let you keep anything else you find in there.",
  },
  [27210] = {
    ["T"] = "A Hidden Record",
    ["O"] = "Bring Evangeline\'s Note to Baros Alexton at Cathedral Square in Stormwind.",
    ["D"] =
    "See this, $N? This is a secret the Defias are desperate to hide, a secret that concerns my sister.\n\nYou see, Isabetta was one of the many people who sympathized with the Defias. After all, they have a valid grievance with the nobles of Stormwind. But when the Defias started terrorizing ordinary people here in Westfall, in our own backyard, she walked away.\n\nIt was only after she left that she learned she was pregnant.\n\nThis is the only copy of her daughter\'s birth certificate. I\'d like you to take it to an old friend in Stormwind for safe-keeping. His name is Baros Alexston and he holds the position of City Architect. You\'ll find him near the great cathedral.",
  },
  [27211] = {
    ["T"] = "A Hidden Record",
    ["O"] = "Bring the Birth Certificate to Royal Factor Bathrilor in Stormwind.",
    ["D"] =
    "<Baros Alexston quickly scans the note and certificate.>\n\nSo my old friend Edwin VanCleef has a daughter with Isabetta Wheeland. If the Stormwind nobles learn of this, they\'ll try to seize her, and hold her as a hostage. Yet it\'s clear Isabetta didn\'t want her daughter in Edwin\'s care either. Evangeline is asking me to help her walk this fine line between both sides.\n\nI don\'t know what to do next but we might as well file this record with the official registrar. He\'s upstairs in this building. If you\'d be so kind as to take it to him, maybe I\'ll have a plan by the time you return.",
  },
  [27212] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Return to Protector Evangeline in Westfall.",
    ["D"] =
    "Evangeline\'s note stated that she doesn\'t know where Vanessa is now.  Go back and tell her that I will provide her with whatever help I can to locate Vanessa.\n\nThe witness listed on the birth certificate is Edna Molsen -- VanCleef\'s maternal aunt. I haven\'t seen her in years. They used to be close. Maybe she would have more information -- if she\'s still alive.",
  },
  [27213] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Travel to the Dead Acre and search for any clues as to Edna Molsen\'s whereabouts.",
    ["D"] =
    "Baros\'s idea to try to find Edna Molsen is a good one, but as he says, I haven\'t seen her in years either.\n\nWhen her husband died, she moved to a little farm on the edge of the river that borders Duskwood. The farm didn\'t prosper, even before the Defias moved in, and she left. It\'s known as the Dead Acre now.\n\nIt\'s worth a look around. Maybe there will be some clue as to where she\'s gone. Let me know what you find.",
  },
  [27214] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Return to Protector Evangeline in Westfall.",
    ["D"] =
    "\"Shire\" could refer to several different towns in the Stormwind kingdom. It\'s a slim clue, but it appears to be the only lead left at the ruined farm.\n\nEvangeline Wheeland would like to know about this.",
  },
  [27215] = {
    ["T"] = "Auntie VanCleef",
    ["O"] =
    "Search the inns in Goldshire, Lakeshire, and Darkshire to see if you can find a lead to Edna Molsen\'s whereabouts.",
    ["D"] =
    "The word \"shire\"? That\'s it? Well, I suppose it\'s something.\n\nI hope you\'ve got good walking boots, $N. You\'ll just have to head out to the neighboring towns of Goldshire, Lakeshire, and Darkshire, and see if anyone has seen Edna Molsen in town.",
  },
  [27216] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Speak to Royal Factor Bathrilor at Cathedral Square in Stormwind.",
    ["D"] =
    "I first met Edna Molsen two years ago. She bought some property in Duskwood but she never moved in, and the farm has fallen into disrepair since.\n\nI believe she went back to Stormwind over a year ago. She had an urgent summons regarding her granddaughter -- something to do with a family dispute, poor dear.\n\nI think she has family in Stormwind though. Their registrar might know.",
  },
  [27217] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Find Steven Molsen in Stormwind.",
    ["D"] =
    "You\'re looking for an Edna Molsen in the city records? Hmm, that name is not familiar to me. But, there is a Steven Molsen in town. At least, sometimes in town. He\'s a bit of an... itinerant worker. Not sure where he is right now.\n\nI\'ll look through the records in more detail for you while you\'re searching for Steven. Come back later and I\'ll tell you if I found anything about Edna.",
  },
  [27218] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Get a bottle of Raven\'s Dark Ale from the inn at Raven Hill in Duskwood.",
    ["D"] =
    "Edna? Yeah I know Edna. She\'s my... *hic*... older sister.\n\nYou part of the Defias, by chance?\n\n<Steven belches.>\n\nNah, you don\'t got the look. Guess you wanna know where she is, huh? Well, I\'ll tell you if you can do a small favor for me first.\n\nUsed to be a rollicking inn at Raven Hill, just over the bridge from Westfall into Duskwood. Made great ale. I\'d sure like more of it. Head over to what\'s left of that place and scrounge up a bottle for me, will ya? Then I\'ll tell you what you wanna know.",
  },
  [27219] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Find Edna Molsen at Addle\'s Stead in Duskwood.",
    ["D"] =
    "Edna bought some land out in Duskwood, the old Addle\'s Stead... *hic*. She let our woebegone nephew Edwin use it. She hoped that by having a place to call his own, he\'d steer off the path he was goin\' down.\n\n<Steven sobers.>\n\nDidn\'t work.\n\nFew weeks ago, Edwin sent Edna a message askin\' her to meet him at the Stead. Haven\'t seen her since. Told her not to go. \'Spect she\'s dead. And you will be too if you go pokin\' your nose around in Defias business.",
  },
  [27220] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Kill Patrick Payne and bring the Chain Key to Edna Molsen at Addle\'s Stead in Duskwood.",
    ["D"] =
    "I\'ll tell you what happened to Vanessa but first, please help me escape these chains.\n\nThe leader of the Defias at Addle\'s Stead is Patrick Payne. Just imagine -- I used to bake biscuits for him and his friends when he was a boy, but he didn\'t think twice about knocking me upside the head.\n\nHe\'s as stealthy as any other member of the Defias here, but if you can find him, he\'s the one who carries the key to my bonds.",
  },
  [27221] = {
    ["T"] = "Auntie VanCleef",
    ["O"] = "Return to Protector Evangeline in Westfall.",
    ["D"] =
    "A few months ago, Edwin\'s thugs started threatening Isabetta. He\'d never cared much about his daughter before but suddenly he went on and on about the \"legacy\".\n\nIsabetta brought Vanessa to me and then left for Kalimdor.  I kept moving. We were in Menethil Harbor, on our way to Theramore, when misfortune struck. For some reason, some of Edwin\'s men happened to see us in the inn. I have no idea why they were there, but they took Vanessa from me. I came to Addle\'s Stead because I hoped I could get her back.\n\n<Edna hangs her head.>\n\nI failed to protect her. I can only pray her father will treat her well. But now, we must leave here. I\'ll go a different way. Good luck, $C, and thank you.",
  },
  [27222] = {
    ["T"] = "Lost But Not Forgotten",
    ["O"] = "Speak to Baros Alexston at Cathedral Square in Stormwind.",
    ["D"] =
    "While you were tracking down Edna, word spread that Edwin was defeated by some intrepid adventurers. Perhaps you know something about that...?\n\nVanessa wasn\'t with him. There\'s no way of knowing where what remains of the Defias might be keeping her. I don\'t know what else to do, other than wait for some new information to turn up.\n\nThe last thing I would ask of you is to return to Stormwind and fill Baros Alexston in everything that has happened.",
  },
  [27223] = {
    ["T"] = "Personal Possessions",
    ["O"] = "Collect Archaeologist Everit\'s personal possessions from around Remtravel\'s Excavation.",
    ["D"] =
    "Ya known $C, those golems have me a mite scared to head back into the pit right now. Reckon I\'ll pitch a new tent up here, out \'o the way of those beasties.\n\nBut to do that, I need a few of me prized possessions that I left around the excavation. If yer goin\' down there anyway, do ye think ye could pick \'em up for me?",
  },
  [27224] = {
    ["T"] = "Rampaging Golems",
    ["O"] = "Kill 6 Cracked Golems or Stone Behemoths for Archaeologist Everit at Remtravel\'s Excavation Site.",
    ["D"] =
    "Welcome to Remtravel\'s Excavation, $glad:lass;. I\'m glad yer here because we\'ve got big problems afoot in this excavation.\n\nProspector Remtravel is so focused on his studies, he\'s turned a blind eye to the dangers around us. One of those dangers is these golems that have risen up since we started digging. I\'m just an archaeologist but you look like you\'re a fighter. Could ye help us out by thinning their numbers?",
  },
  [27225] = {
    ["T"] = "The Ersotta Stone",
    ["O"] = "Take the strange stone to the Hall of Explorers in Ironforge.",
    ["D"] =
    "Inside this chest is a tablet covered with strange markings the likes of which you\'ve never seen before. You suspect this stone would have value to an archaeologist. The Explorer\'s League in Ironforge may be interested in this item -- for all you know, that might have been this ship\'s destination.\n\nYou can reach Ironforge by taking the Deeprun Tram in Stormwind\'s Dwarven District.",
  },
  [27226] = {
    ["T"] = "The Ersotta Stone",
    ["O"] =
    "Take the Ersotta stone to Archaeologist Hollee at Auberdine in Darkshore.\n\nTo get to Darkshore, you\'ll need to make your way through Loch Modan and the Wetlands to the port at Theramore.",
    ["D"] =
    "This stone is a very important artifact in the study of the Old Gods, terrifying beings that ruled Azeroth long ago. One of our researchers in Auberdine could really use this piece, but that\'s far away -- in Kalimdor.\n\nIt\'s a dangerous journey to travel there, $N, but you would be well rewarded if you\'re willing to undertake it.\n\nYou\'ll have to follow the road east to Loch Modan, then north to the Wetlands. Stay on the road there all the way to Menethil and watch yer back -- it\'s a long way.",
  },
  [27227] = {
    ["T"] = "The Storeta Stone",
    ["O"] = "Collect 10 Storeta Fragments from naga at the Ruins of Mathystra.",
    ["D"] =
    "I\'m confident this stone is the key to deciphering some of the other old tablets that are found in this area. Unfortunately, I haven\'t been able to make any progress collecting those tablets because of hostile naga in the ruins. The naga broke one of the tablets I\'m seeking into fragments!\n\nYou\'ve proved yourself capable so far. If you\'d like to continue helping with my work, go to the Ruins of Mathystra to the north, and collect some tablet fragments from the naga that currently infest the area. Maybe I can reassemble it.",
  },
  [27228] = {
    ["T"] = "The Troesta Stone",
    ["O"] = "Collect the Troesta Stone tablet from Twilight Lord Kelris in Blackfathom Deeps.",
    ["D"] =
    "There is one other tablet that is key to my work, but it will be far more dangerous to obtain than anything you\'ve done yet, $C.\n\nTo the south, along the coast, is a temple known as Blackfathom Deeps. Within this temple there is rumored to be a sister tablet to the Ersotta stone. This Troesta stone is the last piece I need to be able to translate the Old God\'s ancient writing.\n\nUnfortunately, the temple is filled with hostile naga and some kind of doomsday cult. If you do manage to find a group interested in looting this temple, I\'d like you to keep an eye out for the stone and bring it to me.",
  },
  [27229] = {
    ["T"] = "The Odd Relic",
    ["O"] = "Take the Odd Relic to Chief Archaeologist Greywhisker in Darnassus.",
    ["D"] =
    "Look at these relics, young one. Do you see what I see?\n\nOne of them is different. It feels present to the mortal hand but to my eyes, it... wavers. It is... not of this time. I know not how else to explain to a $R.\n\nThe presence of this odd relic might explain what the Twilight\'s Hammer is doing here, at the grave of their long dead god. There is a dwarf in Darnassus who has come to study ancient things related to the old gods and their enemies, the titans. Take this to him, that it might aid his studies and shed some light on the Twilight Hammer\'s plans.",
  },
  [27230] = {
    ["T"] = "A Gnome in Need",
    ["O"] = "Track down the Burning Blade Courier and bring his letter to Dibi Squigglecord in Desolace.",
    ["D"] =
    "I know I may not look like much, but I built this town from the ground up! It\'s my duty to look out for my citizens, and right now I need your help!\n\nOne of my engineers, Winkle Screwbucket, went out for a supply run and hasn\'t been seen since. I\'m worried the Burning Blade may have captured him.\n\nMy intel reports that one of their couriers is set to deliver a letter to the chief in Thunder Axe Fortress. It\'s possible that letter contains information about where Winkle is. You\'ll probably find the courier around the fortress, so be quick and bring me that letter!",
  },
  [27231] = {
    ["T"] = "A Gnome in Need",
    ["O"] = "Speak to Ekoc Niftypatch at Squigglecord Outpost.",
    ["D"] =
    "Since the Burning Blade captured Winkle, we\'re going to need some special tools to get him back! My chief engineer, Ekoc Niftypatch, might be able to hook you up with something that can assist us. You\'ll find him in the building right behind me.",
  },
  [27232] = {
    ["T"] = "A Gnome in Need",
    ["O"] =
    "Recover the Trance Enhancer goggles from the wreckage at Sar\'theris Strand and return to Ekoc Niftypatch at Squigglecord Outpost.",
    ["D"] =
    "I might have a way we can force the Burning Blade to give up Winkle\'s position! The only problem is... we don\'t have the right tools. A few years ago, a ship carrying a bunch of engineers docked off the coast of Sar\'theris Strand, just northwest of here. The naga attacked and the ship sank.\n\nI\'ve heard rumors that some of the tools the crew carried were quite advanced. There\'s even some goggles that hypnotize an enemy! Recover those goggles from the wreckage, and we might be able to use them to find Winkle.",
  },
  [27233] = {
    ["T"] = "A Gnome in Need",
    ["O"] = "Siphon 5 Shadow Essence into the Trance Enhancer and return to Ekoc Niftypatch at Squigglecord Outpost.",
    ["D"] =
    "The good news is we have the goggles, but the bad news is they aren\'t charged! Turns out being under the sea for a few years really drains the battery. Luckily I know just the place to recharge these.\n\nTake them to Sargeron, northeast of here. You\'ll find some shadow elementals there that are rich in energy. Siphon their energy into the goggles and bring them back to me.",
  },
  [27234] = {
    ["T"] = "A Gnome in Need",
    ["O"] =
    "Use the Charged Trance Enhancer to hypnotize a member of the Burning Blade Clan into telling you the location of Winkle Screwbucket. Return to Dibi Squigglecord at Squigglecord Outpost if you succeed.",
    ["D"] =
    "The Trance Enhancer is charged and ready to go! Take it to Thunder Axe Fortress and use it on one of the Burning Blade members there. I can\'t gurantee how long the trance will last, so ask your questions quickly.\n\nIf you end up getting his location, let Dibi know at once so we can coordinate a rescue operation. Good luck, $N, and bring Winkle home!",
  },
  [27235] = {
    ["T"] = "A Gnome in Need",
    ["O"] = "Locate Winkle Screwbucket at Thunder Axe Fortress in Desolace.",
    ["D"] =
    "So, the Burning Blade member you hypnotized said Winkle is being held in a cave on the south side of Thunder Axe Fortress? If that\'s true, we must hurry before they transport him to their main holding cells.\n\nBe careful though, the Burning Blade won\'t part with him easily. I wish I could spare some guards, but I leave this in your hands $N. Bring Winkle home to us safely.",
  },
  [27236] = {
    ["T"] = "A Gnome in Need",
    ["O"] = "Escort Winkle Screwbucket out of Thunder Axe Fortress. Report to Dibi Squigglecord if you are successful.",
    ["D"] =
    "Did Dibi send you? I\'ve been trapped in this cave for days. I thought about making a run for it, but I\'m just a cowardly gnome. Now that you\'re here, we have a chance to get out of here though! Lead the way, $R!",
  },
  [27237] = {
    ["T"] = "An End To Dread",
    ["O"] = "Slay 8 Dread Flyers for Strek at Scrabblescrew\'s Camp within Desolace.",
    ["D"] =
    "As our caravan makes it\'s way across Desolace, it is often at risk of ambush from centaurs and local widlife. For some reason the Dread Flyers across Desolace have taken a particular liking to stealing the raw meat we haul. After some success, their attacks have grown bolder. Could you thin their numbers for me so the caravan is safe?",
  },
  [27238] = {
    ["T"] = "An Imp\'s Bidding",
    ["O"] =
    "Travel to Sargeron in northwest Desolace and search for Nyzzorith, again. Retrieve the Demonic Sextant and bring it to Pipjot at Shadowprey Village.",
    ["D"] =
    "I don\'t know whether it\'s a benefit or drawback of being a demon, but there\'s a little clause in our contract that when we\'re summoned to a world other than the one we originate from, we generally can\'t really die.\n\nI mean, we die but, we come back. Sometimes it takes a long time, and sometimes it takes no time at all.\n\nWell that one demon Xirith had you kill back in Ashenvale -- Nyzzorith -- he\'s on the short timer. He\'s here, in a satyr conclave called Sargeron and this time he\'s got a relic called the Demonic Sextant with him. Normally it would be used for... other things... but we can use it to find your Demon Seed demon. So get out there and get that sextant.\n\nOr get turned into a pile of ash like the last two we sent after it.",
  },
  [27239] = {
    ["T"] = "An Imp\'s Bidding",
    ["O"] = "Recover the Infernal Almanac from Shireena at Mannoroc Coven in Desolace.",
    ["D"] =
    "This next task is much more challenging than the last one. Maybe there\'s still time to get turned into ash!\n\nThe Burning Blade have an obvious presence in the ruins at Mannoroc Coven, along the road that leads east from Shadowprey. I\'m sure others around here will give you mundane tasks to deal with the demons there, but we only care about one of them.\n\nShireena the Succubus possesses the only copy of the Infernal Almanac that exists on this plane. We need it. Go get it!",
  },
  [27240] = {
    ["T"] = "An Imp\'s Bidding",
    ["O"] = "Search for a powerful demon in Shadowbreak Ravine in southeastern Desolace.",
    ["D"] =
    "You may be wondering how I know what to tell you to do. It\'s because I know what Zakara is thinking. How does that work? I\'ll tell you -- it\'s magic.\n\nZakara has used magical techniques far beyond the comprehension of your puny $C brain to determine the demon you\'re looking for is in a clandestine canyon in the southeast of Desolace. I went there once at the bidding of my former master. It\'s called Shadowbreak Ravine.\n\nSo, off you go, to find the big bad demon!",
  },
  [27241] = {
    ["T"] = "Shadowbreak Ravine",
    ["O"] = "Return to Zakara and Pipjot at Shadowprey Village in Desolace.",
    ["D"] =
    "Instead of a powerful demon, you find a stronghold constructed by the Burning Blade. The entrance is tightly sealed and you see no way to enter at this time.\n\nIf the demon is here, it must be inside the fortress. You\'ll have to return to Zakara and Pipjot and tell them of this development.",
  },
  [27242] = {
    ["T"] = "Shadowbreak Ravine",
    ["O"] = "Return to Thrall in Orgrimmar.",
    ["D"] =
    "Alas, Zakara doesn\'t know what to do next. We\'ll have to find a way to breach the doors of that fortress, but without knowing anything about what is inside, it would be foolish to rush in. Or so she says. I\'d love to see you try it.\n\n<Pipjot smiles a toothy smile at you.>\n\nSo, go tell Thrall. It\'s his problem now.",
  },
  [27243] = {
    ["T"] = "Crazed Carrion",
    ["O"] = "Slay 8 Carrion Horrors within the Kodo Graveyard.",
    ["D"] =
    "It is a natural part of the cycle of life to become food for what comes after you, be it worms in the dirt or carrion picking at your bones.\n\nI believe deep down the kodo know this, which is why they come to the graveyard here.\n\nHowever the Carrion Vultures that feast on the kodo corpses have become too numerous in number, and too aggressive. They peck and scratch at the kodo that are still living, making their last days agony.\n\nThin the number of vultures $N, and restore balance to this hallowed ground.",
  },
  [27244] = {
    ["T"] = "Drysnap Delicacy",
    ["O"] =
    "Collect Oversized Drysnap Claws from Drysnap Makrura on the coast of Desolace and return to Harnor at Ghost Walker Post.",
    ["D"] =
    "The mood at Ghost Walker Post is often grim, what with the nature of the graveyard below. It is painful for a tauren to witness the end of a kodo\'s life, but we know it must happen.\n\nThe one thing that can warm any soul is a nice wholesome seafood stew. If I can get ahold of some Drysnap Claws, I can make a delicious meal for everyone.\n\nWill you head to the coast and collect some for me from the Drysnaps there? The bigger, the better!",
  },
  [27245] = {
    ["T"] = "The Betrayal of the Grimtotem",
    ["O"] = "Kill 8 Galak Stormers, 8 Galak Marauders, and 8 Galak Maulers at Camp E\'thok or Splithoof Hold.",
    ["D"] =
    "I know what you see when you look at me, $C. You think I\'ve betrayed the Horde because I\'m willing to work with Thrall\'s enemies. Your world is black and white, while mine is many shades of grey.\n\nThink of the vengeance Thrall desires against those who tricked his people into corruption and enslavement. Well, the centaur are my Burning Legion. My life\'s work is to ensure we will never be hunted by those abominations again.\n\nTo that end, I wish you to travel to Thousand Needles and slay many centaur. You\'ll find them at Camp E\'thok and Splithoof Crag.\n\nTake the road south from the Barrens to Thousand Needles. The centaur camps cling to the northern face of the canyon.",
  },
  [27246] = {
    ["T"] = "Stormcaller J\'seenth",
    ["O"] = "Travel to Splithoof Hold. Slay Stormcaller J\'seenth and retrieve the Tablet of the Earth Mother from her.",
    ["D"] =
    "The centaur loot and pillage what the Tauren worked ceaselessly to build. They are thieves and mongrels who desecrate the earth with their hooves.\n\nWhen Camp Tahonda was abandoned, the centaur came and looted the few items of value that could not be carried away. One of these was the sacred Tablet of the Earth Mother that had been buried there to consecrate the ground.\n\nThe Tablet is now in the possession of Stormcaller J\'seenth, who dwells within Splithoof Crag in the Thousand Needles. I want this sacred tablet returned and J\'seenth to be buried in the earth instead.",
  },
  [27247] = {
    ["T"] = "Gloombreak Mesa",
    ["O"] = "Take the Tablet of the Earth to Kai\'li Grimtotem at Gloombreak Mesa in Desolace.",
    ["D"] =
    "The Tablet of the Earth Mother you rescued from Camp Tahonda is ready to go to its new home.\n\nMy clan has established a new settlement in Desolace called Gloombreak Mesa. You will find a path winding up to it in the hills northwest of the Spirit Rise. It starts near a blue totem.\n\nTake the tablet to Kai\'li Grimtotem. She is the resident shaman who will bless the earth with it.",
  },
  [27248] = {
    ["T"] = "A Message for Ghostwalker Post",
    ["O"] = "Travel to Ghostwalker Post in central Desolace and speak to Felgur Towcuts.",
    ["D"] =
    "The Kolkar centaur are nomadic, just like the Tauren used to be. No sooner had we established ourselves here at Gloombreak Mesa than the Kolkar moved in and set up their tents at the foot of the hills below the village. We didn\'t have enough warriors to resist them and Kai\'li sent a message back to Thunder Bluff about the situation. I wonder why it never arrived....\n\nWe don\'t need the Tablet of the Earth Mother anymore. I can take it back to Magatha. Would you please continue on to Ghostwalker Post? My friend Felgur Twocuts should know what has happened here.",
  },
  [27249] = {
    ["T"] = "Kill the Invaders!",
    ["O"] = "Kill 10 Kolkar Ravagers at Gloombreak Mesa for Jevan Grimtotem.",
    ["D"] =
    "I had hoped that the Horde\'s defeat of the centaur in Mulgore would mean a change in our dealings with them. I was foolish. Some things never change.\n\nYou seem like a competent fighter. I could use your services to clear out the Kolkar Ravagers that are hanging around Gloombreak Mesa.",
  },
  [27250] = {
    ["T"] = "Pillaging the Looters",
    ["O"] = "Collect 8 Treasured Tauren Possessions for Jevan Grimtotem at Gloombreak Mesa.",
    ["D"] =
    "Not only did the Kolkar kill everyone in Gloombreak Mesa, they also looted the village and took many of our treasured possessions down to their camp. I want those things back!\n\nGo through Gloombreak Mesa and down the path to the Kolkar Village. You\'ll find stolen tauren possessions in their huts and camps. Gather as many as you can and return them to me.",
  },
  [27251] = {
    ["T"] = "Return to Magatha",
    ["O"] = "Inform Magatha Grimtotem of what has happened at Gloombreak Mesa.",
    ["D"] =
    "I wish to remain here for a short time to bid farewell to my fallen clanmate\'s spirits. Before you arrived I managed to collect bones from the fallen. Please take this bundle back to Magatha for the proper rites of burial. Tell her what has happened and that I will return to town soon.",
  },
  [27252] = {
    ["T"] = "A Proper Burial",
    ["O"] = "Take the Bundle of Grimtotem Bones to the Ceremonial Bonfire at Red Rocks in northeastern Mulgore.",
    ["D"] =
    "I will deal with the council of elders. You have served me as you said you would. You kept your word.\n\nI ask you one last thing -- take these bones to the sacred burial site of Red Rocks, in northeastern Mulgore. Cast them into the ceremonial fire so that the spirits of my clan will know rest. You are then released from my service, $N.",
  },
  [27253] = {
    ["T"] = "Massive Profits",
    ["O"] =
    "Collect 3 Fossilised Gallbladders from the largest kodo skeletons found within Desolace, then return to Bibbly F\'utzbuckle at Kormek\'s Hut within Desolace.",
    ["D"] =
    "All around the Kodo Graveyard to the southwest there are some truly colossal skeletons of kodo that must have lived here eons ago, before Desolace became... this. I think the key to their size is what they consumed, and I need samples of fossilised gallbladders to prove my theory.\n\nIf I\'m correct, and I can breed beasts of that scale, who knows how much people would pay to see these!? Maybe at some kind of park... anyway, the gallbladders will be hard to find, so keep your eyes open.",
  },
  [27254] = {
    ["T"] = "Reagents For The Undercity",
    ["O"] = "Bring 10 Hatefury Claws and 10 Hatefury Horns to Annie Grim in Desolace.",
    ["D"] =
    "One of my tasks out here involves picking up some reagents for Theodore Griffs, a powerful alchemist within the Undercity. Marwin seems to think it\'s easy coin in the bank since we\'re out here already. He doesn\'t really care that we\'re short-handed as is.\n\nThe first few items on his list should be easy enough to get, and it\'d be a good chunk of coin for anyone helping me out.\n\nI need some horns and claws from the Hatefury satyr far to the northeast of Desolace. Bring \'em back to me and we\'ll get started on the rest of the list.",
  },
  [27255] = {
    ["T"] = "Reagents For The Undercity",
    ["O"] = "Bring 7 vials of Scorpashi Venom and 3 Aged Kodo Hides to Annie Grim in Desolace.",
    ["D"] =
    "Next on Theodore\'s list is... let\'s see... hmm. Oh, here it is.\n\nSimple enough, but pretty explicit in his directions. He needs venom from the scorpashi, and hide from some kodo. The fine print says he needs a specific creature: while the venom can come from any of the scorpashi, the hide\'s got to come from an aged kodo, not the dying or ancient ones.\n\nAlchemists, I tell ya, some of the stuff they want... it\'s just weird.",
  },
  [27256] = {
    ["T"] = "Reagents For The Undercity",
    ["O"] = "Bring 10 Felhound Brains, 10 Nether Wings, and 10 vials of Doomwarder Blood to Annie Grim in Desolace.",
    ["D"] =
    "This is the last of the items, and I won\'t lie, it ain\'t pretty. I\'m also expecting this to take you a little bit longer than the other items.\n\nSo, here\'s the bad news. Theodore says he needs: ten brains from either mana eaters, mage hunters, or ley hunters. Then, ten nether wings from a nether maiden, sister or sorceress. And... ten vials of doomwarder blood from a doomwarder captain or lord.\n\nSimple enough, huh? Sheesh... if you wanna pass on this one, I\'d understand.",
  },
  [27257] = {
    ["T"] = "Reagants For The Undercity",
    ["O"] = "Deliver Theodore\'s Package to Theodore Griffs at the Apothecarium within the Undercity.",
    ["D"] =
    "To get paid, you\'re gonna have to go back to the Undercity and speak to Theodore himself. Just give him this package of supplies, and it should be enough to get your booty.\n\nAnd don\'t worry, I\'m still going to put in a good word for you when I get back. I shouldn\'t be in Desolace much longer.",
  },
  [27258] = {
    ["T"] = "Remnants Of The Nether",
    ["O"] = "Collect 10 Remnants of the Nether from demons within Mannoroc Coven.",
    ["D"] =
    "Southwest of here you will find Mannoroc Coven, a dangerous and fel-blighted place where the Burning Blade are summoning demons into these lands.\n\nAs a demon is ripped from their home plane to Azeroth, they bring with them strange remnants of the nether that I am studying. Could you collect some samples?",
  },
  [27259] = {
    ["T"] = "Supplies for Squigglecord",
    ["O"] = "Bring the Squigglecord Supplies crate to Squigglecord Outpost southwest of Thunder Axe Fortress.",
    ["D"] =
    "Out in these dangerous lands we members of the Alliance have to keep a helping hand ready for our allies. In that spirit, I need you to take a package over to the new gnome settlement called Squigglecord Outpost. I\'ve gotten word from their Innkeeper, Teenyfuse, that his food and drink supplies are running low.\n\nSquigglecoard isn\'t too far away. You can find it southwest of here, beyond Thunder Axe Fortress.",
  },
  [27260] = {
    ["T"] = "Pleading To Return",
    ["O"] = "Collect 4 Storming Essences from Whirlwind Stormwalkers northeast of Shadowprey Village.",
    ["D"] =
    "My home and my heart lives in de Hinterlands with de Revantusk Tribe, but I was exiled for teaching some Witherbark cousins about de darker side of being a Shaman. I deeply regret dese actions and all I want is to finally feel de grass under my feet again, see de trees sway, and spend nights with family.\n\nTo be able to do that I am offering de Revantusk Primal a lightning totem of great power, and I hope you can help me with dis task.\n\nNortheast of here are Whirlwind Stormwalkers, powerful air elementals that roam dese lands. Within them lies a fury that I can channel into de totem. Collect it and bring it back to me, please.",
  },
  [27261] = {
    ["T"] = "Pleading To Return",
    ["O"] = "Collect 10 Capacitive Horns from Elder Thunder Lizards throughout Desolace.",
    ["D"] =
    "I need one last thing to be able to make de totem. Around Desolace you will find de Elder Thunder Lizards who are oldest, strongest, and have de largest horns. With de energy dat has flowed through dem over de years, I can create a potent lightning totem as a gift to de Primal. Can ya collect me some?",
  },
  [27262] = {
    ["T"] = "The Freshest Oil",
    ["O"] = "Collect 7 Chunks of Orca Blubber for Marwin Shrillwill along the coast of Shadowprey Village.",
    ["D"] =
    "Some of the best oil for lanterns and explosives come from the Orca along the shores of Desolace. Both the tauren and troll refuse to help me get ahold of their blubber, some kind of ritual animal respect thing. So I need an intrepid adventurer like you to get their hands dirty on my behalf! Could you enter the bay and collect the blubber for me?",
  },
  [27263] = {
    ["T"] = "The Kindest Act",
    ["O"] = "Slay 8 Dying Kodo within the Kodo Graveyard.",
    ["D"] =
    "It is not fully understood why the kodo on Kalimdor try so desperately to reach the graveyard here when they feel their long lives are coming to an end, but their journey is as predictable as the rising sun\'s.\n\nHowever some kodo are gravely sick and roam the land in agony, unable to cross over to the Earthmother\'s embrace.\n\nThe kindest thing we can do is guide them towards her. Will you do this for me?",
  },
  [27264] = {
    ["T"] = "Wanted: Keiko",
    ["O"] = "Locate and slay Keiko in the bay outside of Shadowprey Village within Desolace.",
    ["D"] =
    "Fishing is an important part of keeping this village fed, but out in the bay a great Orca we named Keiko has been capsizing our fishing boats and injuring troll and tauren alike. This brutish Orca must be slain so that we can continue to feed as many as we can.\n\nBring proof of Keiko\'s death to Jinar\'Zillen within Shadowprey Village.",
  },
  [27265] = {
    ["T"] = "Wanted: Wilfiz Silverbit",
    ["O"] = "Locate and slay Wilfiz Silverbit north of Mannoroc Coven within Desolace.",
    ["D"] =
    "My former apprentice ran off to aid the Burning Legion, taking with him valuable knowledge on our plans here. This insolence shall not stand! I want his head brought to me -- on a pike if needed! He was last seen picking mushrooms just north of Mannoroc Coven.\n\n-- Imu Copperspell",
  },
  [27266] = {
    ["T"] = "A Touch of Lightning",
    ["O"] = "Siphon 5 Essence of Lightning into Jo\'gon\'s Rod and return to Jo\'gon at Razor Hill.",
    ["D"] =
    "Greetings mon. I be using your help if you got de time. I be practicing my shamanistic skills, and wish to learn to manipulate objects. To do that I be needing some lightning essence.\n\nDe best place to find dat is up in Thunder Ridge. Take my rod and use it on de beasts. The lizard\'s hides are rich in lightning, and this rod will absorb it.",
  },
  [27267] = {
    ["T"] = "A Village In Need",
    ["O"] =
    "Collect 5 Thistleweed, 3 vials of Felstalker Blood, and 3 Bloodtalon Claws for Garoki in the Valley of Trials.",
    ["D"] =
    "Greetings, mon. I\'ve recieved a report from a local village that they are in need of some supplies. If you\'re looking for work, the help would be appreciated.\n\nThe report said they need some thistleweed, which you can find scattered around the valley here. Next is blood from Felstalkers at the cave north of here. Finally, they need the claws off the raptor colony located south of here.",
  },
  [27268] = {
    ["T"] = "Delivery to Vornal",
    ["O"] = "Deliver the Box of Reagents to Master Vornal at Sen\'jin Village.",
    ["D"] =
    "Your help was much appreciated, mon. Do you think that on your way out of the valley you could delivery these reagents?\n\nThese go to Master Vornal at Sen\'jin Village, which you can find to the southeast after you exit the valley. I have no idea what they need these for, but if you deliver them they might have some more work for you.",
  },
  [27269] = {
    ["T"] = "Journeyman Raptor Riding",
    ["O"] = "Learn Journeyman Riding from Xar\'Ti, then speak to Zjolnir in Durotar to claim your raptor.",
    ["D"] =
    "Welcome back. Ya here to learn Journeyman riding, correct? As before, de price of your raptor has been covered, but ya\'ll have to pay the price of training. Swift riding is not cheap I be sorry to say.\n\nSpeak to Zjolnir just beside me after you have acquired training. He tends to de sale of our raptors. If you do not have de funds yet, ya may return later.",
  },
  [27270] = {
    ["T"] = "Raptor Riding",
    ["O"] = "Learn Apprentice Riding from Xar\'Ti, then speak to Zjolnir in Durotar to claim your raptor.",
    ["D"] =
    "So ya here for a raptor are ya? It just so happens dat I was expecting you! A mysterious benefactor left us payment for a regular raptor and it be addressed to you by name, $N. However dey did not pay for ya training, so I am afraid you still be having to purchase dat.\n\nSpeak to Zjolnir just beside me after you have acquired training. He tends to de sale of our raptors. If you do not have da funds yet ya may return later.",
  },
  [27271] = {
    ["T"] = "Journeyman Wolf Riding",
    ["O"] =
    "Learn Journeyman Riding from Kildar, then speak to Ogunaro Wolfrunner in Orgrimmar to claim your riding wolf.",
    ["D"] =
    "Welcome back. You\'re here to learn Journeyman riding, correct? As before, the price of your wolf has been covered, but you will have to pay the price of training. Swift riding is expensive, I am sorry to say.\n\nSpeak to Ogunaro Wolfrunner just beside me after you have acquired training. He tends to the sale of our wolves. If you do not have the funds yet you may return at any time.",
  },
  [27272] = {
    ["T"] = "Wolf Riding",
    ["O"] =
    "Learn Apprentice Riding from Kildar, then speak to Ogunaro Wolfrunner in Orgrimmar to claim your riding wolf.",
    ["D"] =
    "So you\'re here for a wolf are you? It just so happens that I was expecting you! A mysterious benefactor left us payment for a riding wolf and it is addressed to you by name, $N. However they did not pay for your training, so I am afraid you will still have to purchase that.\n\nSpeak to Ogunaro Wolfrunner just beside me after you have acquired training. He tends to the sale of our wolves. If you do not have the funds yet you may return later.",
  },
  [27273] = {
    ["T"] = "Sha\'gri",
    ["O"] = "Kill the Spirit of Sha\'gri and return to Bom\'bay at Sen\'jin Village.",
    ["D"] =
    "Ello mon. Long ago dere was a troll named Sha\'gri that was de leader of de Echo Isles. He was killed by an adventurer not unlike yourself.\n\nNow his spirit be angry and spreading its wrath across the isles. It must be stopped! Ya can find a shrine de trolls built for him at de top of de northernmost isle. Destroy it, so his presence be gone.",
  },
  [27274] = {
    ["T"] = "The Cursed Fleet",
    ["O"] = "Kill 8 Kul Tiras Deckhands and 3 Kul Tiras Admirals and return to Gar\'Thok at Razor Hill.",
    ["D"] =
    "Good work taking care of the keep $N, but there is still work to be done. Several years ago the Kul Tirans assaulted Durotar from the sea. The cannons and explosions nearly killed my men. We finally pushed them back when we got reinforcements from Orgrimmar, and slaughtered many of them.\n\nI\'m told the dead Kul Tiran crew are restless at sea, unable to pass on properly because their mission is unfinished.\n\nI need you to go to the wreck of their fleet and destroy any Kul Tirans still causing trouble. You can find the sunken ships at the Scuttle Coast, east of here.",
  },
  [27275] = {
    ["T"] = "WANTED: Dustpaw",
    ["O"] = "Bring Dustpaw\'s Snout to Foreman Thazz\'ril in the Valley of Trials.",
    ["D"] =
    "By order of the guard, a dangerous wolf named Dustpaw is hereby sentenced to death! Having killed dozens of citizens in the Valley of Trials, Dustpaw will present a challenge to adventurers seeking to claim this bounty.\n\nDustpaw has been sighted patrolling the eastern ridge of the valley. Should you succeed, bring his snout to Foreman Thazz\'ril.",
  },
  [27276] = {
    ["T"] = "Supervisor Hink",
    ["O"] = "Report to Supervisor Hink at the Zeppelin Tower in Durotar.",
    ["D"] =
    "One of my scouts just delivered a letter. Apparently the goblins constructing our new zeppelin tower are having some trouble. I\'m not entirely sure what that means... but the foreman requested help, so Razor Hill will answer.\n\nThe Warchief says that getting the zeppelin tower built is a top priority, so it\'s important we assist with any issues the goblins are having! Go report to Supervisor Hink, he is overseeing the construction. You\'ll find the new zeppelin tower just southeast of the Orgrimmar gates.",
  },
  [27277] = {
    ["T"] = "Scythemaw Standstill",
    ["O"] = "Kill 10 Bloodtalon Scythemaws and return to Supervisor Hink at the zeppelin tower in Durotar.",
    ["D"] =
    "I knew I made a mistake when I took a job in Durotar! Of all the places in Azeroth, I chose to go where raptors and scorpions regularly roam the lands. I\'m telling ya, the only reason I\'m even here is because the Warchief is paying me a ton to construct this tower.\n\nEver since construction started, we\'ve been dealing with these damn raptors! They constantly raid our camps at night, and eat my workers during the day. I need you to go and \"prune\" their population a bit so that development can get back on schedule!",
  },
  [27278] = {
    ["T"] = "The Dustwind Escape",
    ["O"] =
    "Help Gizzle Screwsnip escape Dustwind Cave. Should you succeed, report to Supervisor Hink at the zeppelin tower in Durotar.",
    ["D"] =
    "I didn\'t think I would see another $R again! You gotta get me out of here, these cultists are crazy! They tried performing a ritual on me earlier, but I don\'t think they had all the materials.\n\nWhen they get back, they\'re sure to try again. This time it might work! Let\'s hurry and bust out of here.",
  },
  [27279] = {
    ["T"] = "Searching for Gizzle",
    ["O"] = "Find Gizzle Screwsnip. You recall Supervisor Hink saying he might be held at Dustwind Cave.",
    ["D"] =
    "My best engineer, Gizzle Screwsnip, mysteriously dissapeared a few days ago, when he went out on a supply run. I\'m quite worried about him, and his designs are essential to the development on the zeppelin tower.\n\nIf I had to guess, it was the Burning Blade that took him. I heard they\'re occupying a cave just north of Razor Hill, named Dustwind Cave. They perform demonic rituals and other heinous acts on the people they capture.\n\nI think if you go to Dustwind Cave there is a good chance you\'ll find Gizzle. If you find him, I\'ll reward you handsomely for your efforts.",
  },
  [27280] = {
    ["T"] = "Airheart Must Go",
    ["O"] = "Locate Fort Airheart on the border of Dustwallow Marsh and The Barrens, and slay Commander Airheart within.",
    ["D"] =
    "We have received troubling news from Camp Taurajo. A band of Alliance deserters have claimed a fort on the border of Dustwallow and the Barrens and are stealing our supplies. My... contacts within the Alliance agree that we must clear them out before someone confuses the situation, and these deserters trigger open war with the Horde.\n\nHowever, they are well armed and thoroughly entrenched in the fort. Their leader is a fearless commander named Airheart. Find him deep within the fort and slay him to end this dire situation.",
  },
  [27281] = {
    ["T"] = "Airheart Must Go",
    ["O"] = "Locate Fort Airheart on the border of Dustwallow Marsh and The Barrens and slay Commander Airheart within.",
    ["D"] =
    "We have received troubling news from our scouts that a new group of deserters have claimed a fort on the border of Dustwallow and the Barrens. We must clear them out before someone confuses the situation, and believes we are arming for open war with the Horde.\n\nThe deserters are well armed and thoroughly entrenched within the keep. Their leader is a fearless Commander named Airheart. Find him deep within the fort and slay him to end this dire situation.",
  },
  [27282] = {
    ["T"] = "Wanted: Dragon Killers",
    ["O"] = "Track down Brogg at Brogg\'s Hollow in Dustwallow Marsh.",
    ["D"] =
    "Brogg needs strong warriors and powerful magic people to help reclaim Stonemaul. The fat, lazy Overlord won\'t do anything, but I can. Find Brogg in a hollow in the southwest corner of the Marsh.",
  },
  [27283] = {
    ["T"] = "Cast Away",
    ["O"] = "Safely escort Argyle Wilkes to Theramore.",
    ["D"] =
    "First I get kicked out by my own crewmates over a minor disagreement, cast away into a storm with nothing more than this dingy to help me. And then I wake up in this Light-forsaken swamp!\n\nI just want to go back to my shack on the beach where I can be alone. Enough whining! I need a drink! Where\'s the nearest bar, eh?",
  },
  [27284] = {
    ["T"] = "Escaping Airheart",
    ["O"] =
    "Escort Anna Kaspian out of Fort Airheart and then report her escape to her friend Janene at the Theramore Inn.",
    ["D"] =
    "My husband Gerald and I were making our way from Ratchet to Theramore with fresh supplies when these ruffians ambushed us. I could tell by the crest on their chests that they were no friends of Theramore.\n\nMy poor husband tried to stand up for the honor of the Proudmoores and well... look behind me to see how that went....\n\nMy ankle was badly twisted, and I need help getting out of here. Will you assist me, $n?",
  },
  [27285] = {
    ["T"] = "Escaping Airheart",
    ["O"] =
    "Escort Kaya Ragetotem out of Fort Airheart and then inform her friend Kaliya at the Camp Taurajo Inn of Kaya\'s escape.",
    ["D"] =
    "My husband Tonga and I were making our way from Freewind Post to Camp Taurajo when these ruffians ambushed us.\n\nI could tell by the crest on their chests that they were no friend of the Horde.\n\nMy poor husband tried to stand up for us and well... they spread him on that garden as mulch...!\n\nMy ankle was badly twisted and I need help getting out of here. Will you assist me, $n?",
  },
  [27286] = {
    ["T"] = "Kill It With Fire",
    ["O"] = "Enter Darkmist Cavern and set fire to 8 Darkmist Egg Sacks.",
    ["D"] =
    "Since we move here, ogres go missing. Wander too far and spiders get you. If we are to survive, meanie bugs must go. Take my torch, burn their eggs.",
  },
  [27287] = {
    ["T"] = "Put Them Down",
    ["O"] = "Assault Fort Airheart and slay 8 Deserter Honorguards and 8 Deserter Medics.",
    ["D"] =
    "An old fort at the border of Dustwallow and the Barrens has been taken over by Alliance deserters under the command of a man named Airheart. If we only strike him down, a new leader will simply rise in the ranks.\n\nWe must assault these deserters with full force, not only striking at the head, but also at the limbs. Take down his fearsome Honorguards and their Medics, so that they cannot recover from this blow.",
  },
  [27288] = {
    ["T"] = "Put Them Down",
    ["O"] = "Assault Fort Airheart and slay 8 Deserter Honorguards and 8 Deserter Medics.",
    ["D"] =
    "An old fort at the border of Dustwallow and the Barrens has been taken over by Alliance deserters under the command of a man named Airheart. If we only strike him down, a new leader will simply rise in the ranks.\n\nWe must assault these deserters with full force, not only striking at the head, but also at the limbs. Take down his fearsome Honorguards and their Medics, so that they cannot recover from this blow.",
  },
  [27289] = {
    ["T"] = "Reinforcements From Afar",
    ["O"] = "Bring the Adorned Letter to Nazeer Bloodpike in Brackenwall Village for inspection.",
    ["D"] =
    "Your request for supplies and reinforcements has been heard and our smugglers are doing their best to get you aid via Steamwheedle and Theramore itself.\n\nIt is important to our cause that the keep does not fall. The dogs of the Horde and the whelps within the Alliance will pay for what has been done.\n\nOur newfound neutrality with the owner of our isle has allowed us to begin building a true town for those who are loyal to our desires.\n\nBefore long you will be sent to attack Camp Taurajo in force, but await our next report. For the Admiral!\n\n-- R.D.",
  },
  [27290] = {
    ["T"] = "Reinforcements From Afar",
    ["O"] = "Bring the Adorned Letter to Lady Jaina Proudmoore in Theramore for inspection.",
    ["D"] =
    "Your request for supplies and reinforcements has been heard and our smugglers are doing their best to get you aid via Steamwheedle and Theramore itself.\n\nIt is important to our cause that the keep does not fall. The dogs of the Horde and the whelps within the Alliance will pay for what has been done.\n\nOur newfound neutrality with the owner of our isle has allowed us to begin building a true town for those who are loyal to our desires.\n\nBefore long you will be sent to attack Camp Taurajo in force, but await our next report. For the Admiral!\n\n-- R.D.",
  },
  [27291] = {
    ["T"] = "Wanted: King Krool",
    ["O"] = "Locate King Krool south of the Stonemaul Ruins and defeat him.",
    ["D"] =
    "Big Croc eat ogre! Family go missing. Do not wander south of Stonemaul or King Krool gonna get you. If you kill croc, get shinies.",
  },
  [27292] = {
    ["T"] = "Wanted: King Krool",
    ["O"] = "Locate King Krool south of the Stonemaul Ruins and defeat him.",
    ["D"] =
    "An enormous crocolisk has been seen in the tributaries of Dustwallow, snapping up soldiers and travelers alike. The ogres imaginatively named him \"King Krool\".\n\nHunt down the monster. He was last seen south of the Stonemaul ruins.",
  },
  [27293] = {
    ["T"] = "The Downed Zeppelin",
    ["O"] = "Scout the area southeast of Brackenwall Village to locate the downed zeppelin that Scout Ghak spotted.",
    ["D"] =
    "Did you see it $c? A burst of flames and next thing I know, on the horizon due southeast of here, a zeppelin is tumbling out of the air!\n\nI\'ve requested a scouting party go investigate what is going on, but all the red tape mumbo jumbo is getting in the way.\n\nPlease could you go investigate the crash, and check for survivors?",
  },
  [27294] = {
    ["T"] = "The Downed Zeppelin",
    ["O"] = "Scout the area west of the Theramore docks to locate the downed zeppelin that Watcher Wallace spotted.",
    ["D"] =
    "Did you see it $c? A burst of flames and next thing I know, on the horizon due west of here a zeppelin is tumbling out of the air!\n\nI\'ve requested a scouting party go investigate what is going on, but all the red tape mumbo jumbo is getting in the way.\n\nPlease could you go investigate the crash, and check for survivors?",
  },
  [27295] = {
    ["T"] = "Where In The World Is Beezil Linkspanner?",
    ["O"] =
    "Loot clues of what may have happened to Beezil Linkspanner from oozes near Beezil\'s Wreck in Dustwallow Marsh.",
    ["D"] =
    "My job on the zeppelin is simple: keep an eye out for dragons as we\'re flying over the swamp. I\'d just taken up my post when, next thing I know, there\'s a mighty boom, and a box smacks me in the head! Out cold in an instant.\n\nI may be the only one of the crew to regain consciousness, and I can\'t find Captain Beezil Linkspanner anywhere! The oozes nearby have been swallowing up anything they can wrap themselves around and may have some clues that lead us to him. Loot them and bring me what you find.",
  },
  [27296] = {
    ["T"] = "Grab The Goods",
    ["O"] = "Collect 8 crates of Zeppelin Cargo from the area surrounding Beezil\'s Wreck.",
    ["D"] =
    "The company\'s next highest priority after finding the Captain is to recover our assets! Anything that survived the crash and hasn\'t been absorbed by a damned ooze is ours, and we need it back.\n\nWe have to salvage at least some profit from this disaster. Go collect the surviving cargo that is scattered around, $n.",
  },
  [27297] = {
    ["T"] = "Defibrillated",
    ["O"] = "Zap awake 6 crew members to uncover more information about what may have happened on the zeppelin.",
    ["D"] =
    "Now we have to help the rest of the crew. By the looks of it, their medical costs will be higher than the payout to their next of kin. However... I\'m going to need their help to transport these crates out of the Marsh.\n\nTake this Defibrillator and wake them up. See if they have any information about where Beezil went, while you\'re at it. One sharp pulse should do it, right to the heart.",
  },
  [27298] = {
    ["T"] = "Sniffotron MK IV",
    ["O"] = "Enquire with Gazlowe in Ratchet about getting Cys\'s Sniffotron MK IV.",
    ["D"] =
    "This operation is getting more and more expensive. My boss won\'t be liking that and I\'m not going to take the rap for Beezil\'s mistakes!\n\nWe can use the cloak you found to track him down, but we\'re going to need some technological assistance. Go speak with Gazlowe in Ratchet about a Sniffotron MK IV Kit that I left in his care. \n\ne\'re going to use fine goblin technology to locate Beezil.",
  },
  [27299] = {
    ["T"] = "Sniff Him Out",
    ["O"] = "Use the Sniffotron MK IV Controller to summon the Sniffotron, which will lead you to Beezil.",
    ["D"] =
    "With this Sniffotron and the cloak that you found, we can find Beezil. Bring out the Sniffotron and it will sniff at the cloak and set off with you following in tow. Defend this device with your life, as we don\'t have a replacement at hand!\n\nFind the Captain and bring him back to me safely.",
  },
  [27300] = {
    ["T"] = "Beezil And The Burning Blade",
    ["O"] = "Return to Cys Craftcharge with the information about Beezil Linkspanner.",
    ["D"] =
    "If it weren\'t for the fact you\'ve just saved my life from that Infernal, I wouldn\'t tell you anything. But I owe you that much, and a part of me thinks I can salvage this.\n\nYes, the Burning Blade recruited me to transport a massive Infernal to Steamwheedle Port to do who knows what with. I\'m sure it was nothing good. Luckily, they paid me up front. I need to inform them of what happened, but don\'t worry, I have a little insurance plan up my sleeve.\n\nSee ya around chump!",
  },
  [27301] = {
    ["T"] = "Burning Blade Dossier",
    ["O"] = "Bring Cys Craftcharge\'s Report to Scout Ghak in Brackenwall Village.",
    ["D"] =
    "So Beezil was working with the Burning Blade behind the company\'s back? That rat bastard!\n\nThis problem\'s bigger than company resource mismanagement now. I think it wise that you bring a copy of my report to your superiors. They will want to know the lengths that the Blade have gone to.",
  },
  [27302] = {
    ["T"] = "Burning Blade Dossier",
    ["O"] = "Bring Cys Craftcharge\'s Report to Watcher Wallace in Theramore.",
    ["D"] =
    "So Beezil was working with the Burning Blade behind the company\'s back? That rat bastard! I think it wise that you bring a copy of my report to your superiors. They will want to know the lengths that the Blade have gone to.",
  },
  [27303] = {
    ["T"] = "Containing the Contamination",
    ["O"] =
    "Take the Felwater Purifier to the lake at Bloodvenom Falls and deploy it. Then return to Ivy Leafrunner at Emerald Sanctuary in Felwood.",
    ["D"] =
    "Greetings $C. It is still unclear whether we can repair the damage caused by the vile demonic corruption that has twisted Felwood, but we can take steps to keep it from spreading.\n\nTainted oozes have been multiplying on the banks of the Bloodvenom river, which flows down into Darkshore. I\'m concerned about the runoff spreading corruption downriver. Luckily one of our goblin friends has created a purifier device to help cleanse the river at its source.\n\nTake this purifier to the dock on the lake at Bloodvenom Falls and toss it in. Let me know if seems to have any effect.",
  },
  [27304] = {
    ["T"] = "Containing the Contamination",
    ["O"] =
    "Obtain a Burning Elemental Core from an Infernal Bodyguard at Shatter Scar Vale in Felwood and bring it to Ivy Leafrunner at the Emerald Sanctuary.",
    ["D"] =
    "$N, I have an idea. You\'ll need to find something to tempt this giant ooze to leave the lake, so we can destroy it.\n\nThe oozes are born of demonic corruption and they feed on it to grow larger. I suspect if you were to harvest a powerful source of demonic energy, you could use that to tempt the ooze away from the lake.\n\nThis is a dangerous task. The only place I can think to get such a powerful source is the core of an Infernal Bodyguard that roams near Shatter Scar Vale. You won\'t want to attempt this alone.\n\nGood luck, and may Elune be with you.",
  },
  [27305] = {
    ["T"] = "Containing the Contamination",
    ["O"] = "Lure the Vile Oozemother out of Bloodvenom Falls and destroy it.",
    ["D"] =
    "Here $N, I\'ve taken the core and fashioned it into a lure for you to use. Be warned, as soon as you activate it, the Oozemother is certain to come right for you!\n\nI bet once it is destroyed, we\'ll see the corruption in the Bloodvenom River begin to drop. I\'ll work on getting the purifier repaired just in case -- but if your efforts are successful, maybe we won\'t need it!",
  },
  [27306] = {
    ["T"] = "The Garden of Jadefire Glen",
    ["O"] =
    "Kill Jadefire Satyrs and Felsworn until you retrieve Kelek Skykeeper\'s gardening tools, then return them to him at Emerald Sanctuary in Felwood.",
    ["D"] =
    "Before the Legion came I spent much of my time at Jadefire Glen, where I created a luminous garden. Sadly nothing remains of the many years of cultivation and effort that went into building that restful sanctuary.\n\nThe Jadefire demons that now inhabit my old garden are known as packrats who hoard any scraps they get their filthy hands on. I\'m hoping that means they have my tools, and I\'d give anything to have them back.\nI\'m no fighter, but I will reward you handsomely if you bring me back my tools -- especially if it means killing every demon in the place!",
  },
  [27307] = {
    ["T"] = "The Shrine of the Deceiver",
    ["O"] =
    "Recover the mementos of Sargeras, Tichondrius, Kil\'jaeden, and Archimonde that are kept in the Shrine of the Deceiver and bring them to Watcher Steelsong at Emerald Sanctuary in Felwood.",
    ["D"] =
    "I greet you $C. My name is Vela Steelsong and I am a Warden. Or, at least I hope to be. I\'m actually still in training.\n\nI was sent here to examine the demonic forces that have taken over Jaedenar. I\'ve determined that these cultists have collected mementos from when the Burning Legion passed through Felwood, and are storing them in the Shrine of the Deceiver within Jadenar.\n\nTaking these mementos away from them would remove a powerful symbol of their devotion to the Legion.\n\nI\'m not supposed to engage them directly and I don\'t want to disobey orders on my first assignment -- but if you could act as my agent and retrieve these relics, I would be most grateful.",
  },
  [27308] = {
    ["T"] = "Mementos of the Third War",
    ["O"] = "Take the Box of Grisly Mementos to Tyrande Whisperwind at the Temple of the Moon in Darnassus.",
    ["D"] =
    "I\'m glad you\'re here $N. Looking over these items I find that they are much more gruesome than I expected -- these are skulls of some of the victims the Legion claimed as they made their way to Hyjal.\n\nThe cultists have marked them with their names. Though I know nothing about their victims, they deserve a proper burial with full honor as heroes who defended the world tree.\n\nPlease take these trophies to Tyrande Whisperwind, high priestess of Elune in Darnassus. I trust her judgment when it comes to deciding what to do next.",
  },
  [27309] = {
    ["T"] = "Mementos of the Third War",
    ["O"] = "Take the Box of Grisly Mementos to Thrall at the Valley of Wisdom in Orgrimmar.",
    ["D"] =
    "I\'m glad you\'re here $N. Looking over these items I find that they are much more gruesome than I expected -- these are skulls of some of the victims the Legion claimed as they made their way to Hyjal.\n\nThe cultists have marked them with their names. Though I know nothing about their victims, they deserve a proper burial with full honor as heroes who defended the world tree.\n\nPlease take these trophies to Thrall, High Warchief of the Horde and one of the victors of the conflict. I trust his judgment when it comes to deciding what to do next.",
  },
  [27310] = {
    ["T"] = "Wanted: Kal\'alash",
    ["O"] = "Find Kal\'alash in Irontree Woods and end his suffering.",
    ["D"] =
    "These woods are a painful reminder of what we\'ve lost in the wake of the Third War, $N. Whatever wildlife the Legion haven\'t slaughtered were driven mad by the demonic corruption in Felwood.\n\nThe great chimaera Kal\'alash and his children were the first to protect Felwood when the Legion attacked. Sadly, his entire brood fell in the fight against the demons, leaving him alone and tainted by foul fel magic. What is left of the great chimaera now wanders the Irontree Woods, scarred from the great battle and wracked with grief. \n\nI wouldn\'t suggest setting foot in those cursed woods alone, but should you come across Kal\'alash himself... please end his suffering. That is all I ask.",
  },
  [27311] = {
    ["T"] = "Wanted: Kal\'alash",
    ["O"] = "Venture into Irontree Woods and slay the foul chimaera Kal\'alash.",
    ["D"] =
    "You might have thought the chimaera were wiped out of this forest after the Third War $C, but one still wanders the Irontree Woods. \"Kal\'alash\", the elves call it. \n\nMy hunting partner and I sought to capture it, only to be met by a fel-crazed winged terror, twin maws spitting felfire and venom. I managed to escape with my life, but my partner... he was not as fortunate. \n\nI dare not tangle with that beast again but I\'ll reward any that can put it down.",
  },
  [27312] = {
    ["T"] = "Gordunni Thieves",
    ["O"] = "Collect 10 Camp Mojache Supplies from the Gordunni ogres in Feralas.",
    ["D"] =
    "It\'s hard enough to get supplies through to us here at Camp Mojache with disturbances on the roads in the Barrens, but the limited crates that get through to Feralas are being stolen by the Gordunni ogres.\n\nCan you recover some crates from those thieves so we\'re not running on bare minimum? Follow the river north, and you will find their outpost.",
  },
  [27313] = {
    ["T"] = "Meat!",
    ["O"] = "Collect Ironfur Meat and Ape Meat for Mek\'nell at Gluk\'s Compound.",
    ["D"] =
    "Me running low on supplies! It takes a lot to feed Gluk\'s Enforcers! We need more! Will you help?\n\nThe young Ironfur Bears have the yummiest meat, so get them! And the Groddocs taste sweet too, me love them! Go get, they\'re nearby.",
  },
  [27314] = {
    ["T"] = "Freedom for All Creatures",
    ["O"] =
    "Using the Bamboo Cage Key, free the Sprite Darters from the pen in the Grimtotem camp. At least 6 Sprite Darters and Luyua Earthmoon must survive.\n\nYou have 6 minutes before Luyua decides it is time to retreat and you fail the quest.",
    ["D"] =
    "The filthy Grimtotem clan are capturing faerie dragons, $N. Ordo and I have no idea what they plan on doing with them, but they\'re obviously up to no good.\n\nWe\'re not powerful enough to fight our way into the camp and free the captured dragons, but perhaps with your help... we can do something.\n\nIf you\'re willing, and you have some strong friends, release the creatures from their cage with this key and make sure they escape with their lives. I\'ll be by your side the entire time. Ordo will remain here.",
  },
  [27315] = {
    ["T"] = "Doling Justice",
    ["O"] =
    "Kill 12 Grimtotem Naturalists, 10 Grimtotem Raiders, and 6 Grimtotem Shamans before returning to Ordo Earthmoon in Feralas.",
    ["D"] =
    "As she\'s already told you, Luyua and I will now take the fight to the Grimtotem. Together, we should still be able to pick off some of the Grimtotem without much threat to ourselves, but we\'d love some help if you\'re willing and able.\n\nYou\'ve seen the camp below us, but there are more to the east. Using your own tactics, deal as much damage to the tauren as you can. We can all meet back here after they\'ve felt the sting of Luyua\'s arrows and your own weapons.",
  },
  [27316] = {
    ["T"] = "Doling Justice",
    ["O"] = "Take Ordo\'s Signet Ring to Arch Druid Hamuul Runetotem in Thunderbluff.",
    ["D"] =
    "Out here in the wilderness, Luyua and I have meager means to reward your help, but we don\'t want you to feel unappreciated. Take my signet ring. If you ever find yourself on the peaks of Thunder Bluff, go to the Elder Rise. There you will find Arch Druid Hamuul Runetotem. The ring will let him know that we are well and give credit to your story.\n\nWe both thank you, $N.",
  },
  [27317] = {
    ["T"] = "An Orphan Looking For a Home",
    ["O"] = "Speak to Hassan Heavywood at Mirage Raceway in Thousand Needles.",
    ["D"] =
    "Oh, hello, $N. I\'m so glad to see you again. How was your trip to Thunder Bluff?\n\nWell, you\'ll be happy to know that we\'ve made quite a bit of progress while you\'ve been gone. We even saved a nest full of eggs. Unfortunately, the mother died before we got to her.\n\nSay, would you want one for a pet? They look to hatch soon, so they\'ll need a good $Gfather:mother;. What do you say?\n\nIf you\'re really interested, take one of the eggs to Hassan Heavywood at the race track in Shimmering Flats. He\'ll tell you more.",
  },
  [27318] = {
    ["T"] = "A Short Incubation",
    ["O"] = "Bring 2 Elixirs of Fortitude to Hassan Heavywood in Thousand Needles.",
    ["D"] =
    "The Earthmoons, huh? Most intriguing. I wish the sprite darters could truly appreciate what it means to have those two look after them. They are both quite capable.\n\nSo, they gave you the egg as a gift. Well, then you should be responsible for it for as long as it needs. It appears it\'s almost ready to hatch, but we should ensure it\'s healthy and no damage has been done to it.\n\nI only need two elixirs of fortitude for a small spell to protect the egg. I have the rest of the components here with me.",
  },
  [27319] = {
    ["T"] = "The Newest Member of the Family",
    ["O"] =
    "Take your Fragile Sprite Darter Egg to the Hinterlands and speak to Huntsman Markhor, but hurry, you only have 1 hour to find him before the hatchling within the egg dies.",
    ["D"] =
    "A magnificent specimen, $N. If this creature survives gestation, then it\'ll be a healthy pet indeed!\n\nThere is one last thing I would suggest doing if you plan on following through with this -- head to Revantusk Village in the Hinterlands. Speak to a troll there named Huntsman Markhor. He\'s a master animal handler and should be able to guide you in the final steps of incubation.\n\nBut hurry, $N, this egg is fragile and will not last long without proper care.",
  },
  [27320] = {
    ["T"] = "Food for Baby",
    ["O"] = "Bring 5 Silvermane Stalker Flanks to Huntsman Markhor in the Hinterlands.",
    ["D"] =
    "Sprite darters are omnivores -- that means they eat both meat and vegetation. If your egg here\'s gonna hatch, we best be prepared. Some good eats for these little guys are flanks of meat, raw and juicy, believe it or not. I was never able to find out why, but it has somethin\' to do with Elune\'s plan for the elves... maybe they were to be protectors or somethin\', I don\'t know.\n\nI\'ll take care of the egg for now, why don\'t you get me some good Silvermane Stalker flanks for \'em to eat when he\'s hatched.",
  },
  [27321] = {
    ["T"] = "Becoming a Parent",
    ["O"] = "Speak to Huntsman Markhor in the Hinterlands.",
    ["D"] = "Whoa, it was a lot more ready than I thought...!",
  },
  [27322] = {
    ["T"] = "Convincing the Denied",
    ["O"] =
    "Collect Broken Mirror Shards from Harpies that are found northwest of Gluk\'s Compound at the Ravenwind Ruins.",
    ["D"] =
    "Me Jrall. Me need help. My friend Trog, he dead but he no know it. He walk around like alive. Me want him find peace. Me hear Harpies at Ravenwind ruins, they love mirror pieces. They vain, always looking at themselves. You go get for me, okay? Me pay good. Help me, friend",
  },
  [27323] = {
    ["T"] = "A Reflection of Death",
    ["O"] = "Show Trog his own reflection to prove to him that he is dead.",
    ["D"] =
    "You help me before, thank you. Now me need more help. Me make mirror with pieces you bring. Me want you take it to Trog and show him reflection. He see he dead, he find peace. You do this for me, friend?",
  },
  [27324] = {
    ["T"] = "Dead and Gone",
    ["O"] = "Ask around Gluk\'s Compound to get information about where Trog died.",
    ["D"] =
    "Trog not believe he dead, need see body. You help me find out where he die. Go talk to Enforcers, Mek\'nell, and Gark. They know things. You bring back information, me pay you.",
  },
  [27325] = {
    ["T"] = "Dental Records",
    ["O"] = "Collect Ironfur Patriarch teeth from the areas north of Gluk\'s Compound.",
    ["D"] =
    "Me need you to go find Ironfur Patriarch teeth. Me think maybe when Trog see teeth, he remember how he die. You go find teeth, bring them back to me. We show Trog, maybe he remember and finally know he dead. You go now. Hurry up!",
  },
  [27326] = {
    ["T"] = "Dental Records",
    ["O"] = "Show Trog the teeth you have collected to see if he recollects being killed.",
    ["D"] =
    "You bring back teeth, good. Now, me need you to go show Trog. Me think maybe if he see teeth, he remember how he die. You go to Trog, show him teeth, see if he remember. Hurry, we need to know so Trog can finally rest in peace.",
  },
  [27327] = {
    ["T"] = "Dental Records",
    ["O"] = "Collect teeth from the Elder Rage Scar yetis found north of Gluk\'s Compound near the Twin Colossals.",
    ["D"] =
    "Me think maybe Elder Rage Scar in cave north of camp, they big and strong. Me need you go get teeth from them, me hope Trog recognize them and finally understand. You go now, bring back teeth, help Trog rest in peace.",
  },
  [27328] = {
    ["T"] = "Dental Records",
    ["O"] = "Show Trog the teeth you have collected to see if he recollects being killed.",
    ["D"] = "Me want you to go show big teeth to Trog. Me hope he remember dem, go now!",
  },
  [27329] = {
    ["T"] = "Dental Records",
    ["O"] = "Collect teeth from the Groddoc Thunderers found north of Gluk\'s Compound near the Twin Colossals.",
    ["D"] =
    "Me, Jrall, and Trog, we goin\' huntin\' long time ago. We find big mean Groddocs. They got big teeth, big mean teeth. We run away fast, but Jrall remember dem teeth. Now, me think dem teeth what kill Trog. Me need you go get dem teeth from Groddocs. You bring back, we show Trog, maybe he remember.",
  },
  [27330] = {
    ["T"] = "Dental Records",
    ["O"] = "Show Trog the teeth you have collected to see if he recollects being killed.",
    ["D"] = "Maybe this the one? Go show Groddoc teeth to Trog. I bet all my rocks he remember now.",
  },
  [27331] = {
    ["T"] = "Curious Groddoc",
    ["O"] = "Collect a Crate of Tel\'Abim Bananas.",
    ["D"] =
    "Groddocs! Groddocs are usually nice if you leave dem alone. I bet they not eat all of Trog. Groddoc loves bananas. If we give bananas then maybe they nice and show the way?\n\nViggo eats lots of fancy fruits that he no share with us. Maybe ask him for bananas?",
  },
  [27332] = {
    ["T"] = "Curious Groddoc",
    ["O"] = "Throw Tel\'Abim Bananas at Groddoc Thunderers in the Twin Colossals to locate Trog\'s Corpse.",
    ["D"] =
    "We killed Groddoc for teeth earlier... me hope that these bananas sweeten their hearts and they might show us where they usually take their food. Go try!",
  },
  [27333] = {
    ["T"] = "Facing Oneself",
    ["O"] = "Bring Trog\'s Head to Jrall in Gluk\'s Compound.",
    ["D"] =
    "There is barely anything left of the body, but the head lying nearby is pristine. Perhaps it was simply too ugly for any nearby beasts to consume?\n\n You should bring this head to Jrall in Gluk\'s Compound.",
  },
  [27334] = {
    ["T"] = "Facing Oneself",
    ["O"] = "Prove to Trog that he is dead.",
    ["D"] = "There\'s no way that Trog won\'t believe he dead now after seeing this. You show him for me?",
  },
  [27335] = {
    ["T"] = "Wanted: Lost Ancient",
    ["O"] = "Locate and slay the Lost Ancient and collect a Hefty Ancient Log as proof.",
    ["D"] =
    "Soon-to-be-king Gluk\'s demands for weapons to bolster his forces know no bounds, and we\'re going to need a lot of very strong wood.\n\nA Lost Ancient has been seen roaming south of the compound, decimating adventurers and ogres alike. Slay him on my behalf and you will be handsomely rewarded.\n\n-- Viggo",
  },
  [27336] = {
    ["T"] = "The Essence of Nightmares",
    ["O"] =
    "Collect 10 Samples of Nightmare Essence from Ancestral Nightmares in the Stormrage Barrow Dens and bring them to Sira Moonwarden in Moonglade.",
    ["D"] =
    "Moonglade may look peaceful, $c, but I sense something lurking beneath its tranquil exterior.\n\nCaptain Stormrunner would like you to put down the restless spirits in the barrow dens but I am more concerned with what is troubling them in the first place. Once you\'ve slain your first one, I think you will see what I mean... the nightmare made manifest.\n\nGather the essence of these nightmares and bring them to me so that I may investigate further.",
  },
  [27337] = {
    ["T"] = "In Elune\'s Light",
    ["O"] =
    "Enter the middle portal of the Stormrage Barrow Dens and put 10 Kaldorei Spirits to rest. The spirits are only visible at night. When this task is complete, return to Captain Saynna Stormrunner outside the Stormrage Barrow Dens in Moonglade.",
    ["D"] =
    "$C, be warned! The Stormrage Barrow Dens are a place of tranquility and peace, and we will not suffer fools desecrating our sacred ground.\n\nNormally outsiders would be kept away, but I have need of your assistance. When the light of Elune shines upon Moonglade, the spirits of our ancestors have begun to appear. Although they appear tranquil, they roil on the inside with suppressed rage.\n\nI cannot bear to dispatch my kin over and over every night. If you would assist in returning these spirits to the earth, I would be grateful.",
  },
  [27338] = {
    ["T"] = "The Stormrage Barrow Dens",
    ["O"] = "Speak to Captain Saynna Stormrunner at the Stormrage Barrow Dens in Moonglade.",
    ["D"] =
    "You seem to be a capable $c. Captain Saynna Stormrunner, leader of our Barrow Watchers, is currently stationed at the Stormrage Barrow Dens on the southeast side of Lake Elune\'ara. She is looking for assistance with a matter of urgency.\n\nJust follow the road out of Nighthaven all the way around the lake and you will find her.",
  },
  [27339] = {
    ["T"] = "Grimtotem Encroachment",
    ["O"] = "Kill 4 Grimtotem Hectors and 4 Grimtotem Skirmishers, then report back to Grull Hawkwind in Camp Narache.",
    ["D"] =
    "Watch your hooves, peaceful resident of Red Cloud Mesa. Members of the Grimtotem clan have abandoned our camp and set up their own settlement to the east. They take from the land for themselves, not considering the needs of all tauren. Even though we are all children under the same sun, it does not stop them from dishonoring this sacred mesa.\n\nOur efforts at diplomacy have been rebuffed, and our last emissary didn\'t return. We have no choice: the Grimtotem must be removed from Red Cloud Mesa.",
  },
  [27340] = {
    ["T"] = "Finding Mone",
    ["O"] = "Locate Mone Sunmane who was last seen heading east to the Grimtotem settlement on Red Cloud Mesa.",
    ["D"] =
    "I am so desperately worried about my husband, Mone. He left two days ago to speak to the Grimtotem at their settlement to the east. He went to ask them to stop overhunting on the Mesa, but he hasn\'t returned.\n\nPlease go investigate and bring him back to me safely. You can recognise him by the golden tips on his horns.",
  },
  [27341] = {
    ["T"] = "Finding Mone",
    ["O"] = "Bring the Simple Green Pendant to Kaya Sunmane at Red Cloud Mesa.",
    ["D"] =
    "Around the neck of the fallen tauren you find a necklace with a Simple Green Pendant. Suspecting that this is Kaya Sunmane\'s husband, you decide to bring the pendant back to Red Cloud Mesa.",
  },
  [27342] = {
    ["T"] = "Gnoll Rustlers",
    ["O"] = "Find and release 8 kidnapped Tauren from the gnoll cave west of Bloodhoof Village.",
    ["D"] =
    "We need your help, $c. People have been going missing while foraging for food or hunting with their children. It started with only a few, but now dozens are gone.\n\nRumors have been spreading that it is the local gnolls taking them off to the cave to the west of town.\n\nPlease, investigate this cave! If our neighbors are imprisoned there, please return them to us.",
  },
  [27343] = {
    ["T"] = "Journeyman Kodo Riding",
    ["O"] =
    "Learn Journeyman Riding from Kar Stormsinger, then speak to Harb Clawhoof in Mulgore to claim your kodo beast.",
    ["D"] =
    "Welcome back. You\'re here to learn Journeyman riding, correct? As before, the price of your kodo has been covered, but you will have to pay the cost of training. Swift riding is expensive, I am sorry to say.\n\nSpeak to Harb Clawhoof just beside me after you have acquired training. He tends to the sale of our beasts. If you do not have the funds yet you may return at any time.",
  },
  [27344] = {
    ["T"] = "Kodo Riding",
    ["O"] =
    "Learn Apprentice Riding from Kar Stormsinger, then speak to Harb Clawhoof in Mulgore to claim your kodo beast.",
    ["D"] =
    "So you\'re here for a kodo are you? It just so happens that I was expecting you! A mysterious benefactor left us payment for a basic kodo and it is addressed to you by name, $N. However they did not pay for your training, so I am afraid you will still have to purchase that.\n\nSpeak to Harb Clawhoof just beside me after you have acquired training. He tends to the sale of our beasts. If you do not have the funds yet you may return later.",
  },
  [27345] = {
    ["T"] = "Sage Raintotem",
    ["O"] = "Find Sage Raintotem near Red Rocks in northeastern Mulgore.",
    ["D"] =
    "Would you be willing to do me a favor, $C?\n\nSage Raintotem left yesterday to visit the sacred burial site at Red Rocks, and he hasn\'t returned. Would you please check on him to make sure he is ok?\n\nYou can take the northern elevator out of Thunder Bluff and then go east to find Red Rocks.",
  },
  [27346] = {
    ["T"] = "Stonebull Pollution",
    ["O"] = "Bring 10 pieces of Venture Co. Debris to Agatha Longcast in Bloodhoof Village.",
    ["D"] =
    "Stonebull Lake\'s sacred spring has nourished us for centuries. It\'s the literal source of life in Mulgore, a blessed chalice of the Earthmother.\n\n$C, look at it now! Pieces of refined metal, debris, some oily substance even my husband is afraid to touch... he even caught a catfish with a metal bolt in its belly!\n\nThe Venture Company is going to ravage Mulgore for profit, burying us in a twisted grave made of its desecrated gifts, so sacred to our people.\n\nPlease, could you help me by cleaning the lake a bit? The bulk of the garbage is closest to the northeastern shore.",
  },
  [27347] = {
    ["T"] = "It\'s Never Too Coagu-late.",
    ["O"] =
    "Retrieve the Gnomish Coagulator and use it to cleanse Stonebull Lake. Return to Agatha Longcast after you\'re done.",
    ["D"] =
    "Wait, what\'s on your face? Oh, it\'s that filthy oil. I\'d like to think it\'s not toxic, but I fear it corrupts both the water and the soil.\n\nOne of the hunters here in Bloodhoof Village has mentioned a strange device that some of the Workers and Supervisors from Venture Co. use to cleanse the oil pollution from their mine to the northeast.\n\nTry retrieving it. If they can neutralize the pollution there, we could do it to Stonebull Lake as well.",
  },
  [27348] = {
    ["T"] = "Stop the Plunderers",
    ["O"] =
    "Kill Bael\'dun Appraisers and collect the Ancient Tauren Relics they carry. Bring 6 of them to Pawe Mistrunner on the Spirit Rise of Thunder Bluff.",
    ["D"] =
    "Hail, $C. Have you spoken to Blaine Bloodhoof down in the village? He is looking for someone to head to the dwarven dig site of Bael\'dun in western Mulgore and stop the digging.\n\nWhile Blaine\'s goal is understandable, sometimes we need to dig to unearth history. Since the damage is already done, I\'d like you to make the most of it. The Appraisers at the dig site carry artifacts found at the site. I\'d like you to collect those artifacts so we can study them.",
  },
  [27349] = {
    ["T"] = "Stop the Plunderers",
    ["O"] = "Recover 8 Ancient Relics from Venture Company personnel at their mine in southeastern Mulgore.",
    ["D"] =
    "The dwarves aren\'t the only people encroaching on our history here in Mulgore. The Venture Company has opened up a mine in the southeastern part of Mulgore. They are only here for the resources they can plunder, and have no regard for the history they are destroying with their reckless actions!\n\nI know the workers in the mine keep ancient things they find for themselves. It is better that those relics remain here with the tauren than lining greedy Goblin pockets. Please, go to the mine and recover them!",
  },
  [27350] = {
    ["T"] = "The Lost Calf",
    ["O"] = "Locate the Lost Kodo Calf\'s owner in Bloodhoof Village.",
    ["D"] =
    "Around the neck of a frantic kodo calf you find a damaged collar, with the identity of its owner worn away.\n\nSuddenly, the kodo sprints off, leaving the collar in your grasp. Someone in Bloodhoof Village may be the owner. Seek them out to inform them of what you have found.",
  },
  [27351] = {
    ["T"] = "The Lost Calf",
    ["O"] = "Collect 8 Mulgoji Berries from the Plainstriders and Swoops on the Mulgore Plains.",
    ["D"] =
    "That little scamp! I adore him but his disobedience is becoming a nuisance.\n\nThe calf you found is Odok. I\'ve been taking care of him since his mother passed, as he\'s not big enough to take care of himself yet. I\'m so worried that he\'s alone on the plains! We have to get him back.\n\nHe has a specific favorite treat that I know will lure him back, but I will need you to collect some ingredients to make it.\n\nThe Swoops and Plainstriders north of the village ferment the local Mugoji Berries in their stomachs, and for some reason Odok adores the flavor. Bring me some of these berries and we can work on a lure.",
  },
  [27352] = {
    ["T"] = "The Lost Calf",
    ["O"] = "Collect Grouper Puree from the Lake Groupers in Stonebull Lake.",
    ["D"] =
    "If you thought that was gross, sadly, I can only say it\'s going to get a bit worse. The next thing we will need is some Grouper Puree from the lake surrounding the village.\n\nEvery other day I take Odok out to fish up the Grouper, and he gets the scraps. I bet that pungent smell will have him running straight for us.",
  },
  [27353] = {
    ["T"] = "The Lost Calf",
    ["O"] = "Place the Calf Bait outside the Bloodhoof Village Inn to lure Odok back to his owner.",
    ["D"] =
    "With these berries and puree combined, I have a \"delicious\" treat for Odok. However, for the benefit of the other inn guests, please place it OUTSIDE of the inn.",
  },
  [27354] = {
    ["T"] = "Wanted: Jasone",
    ["O"] = "Hunt down the Centaur Jasone roaming beneath Thunder Bluff.",
    ["D"] =
    "An exiled Galak Centaur roams beneath the city of Thunder Bluff, attacking men, women, and children. This cannot stand! Gather your friends and hunt the centaur down.\n\nBring proof of your victory over this beast to Zangen Stonehoof atop Thunder Bluff, and you will be rewarded.",
  },
  [27355] = {
    ["T"] = "Armaments Of The Damned",
    ["O"] = "Collect 8 Ethereal Armaments from Tortured Sentinels within Southwind Village.",
    ["D"] =
    "Southwind Village was once the site of a great battle between the Kaldorei and the Silithid. Though we are unsure why the spirits of Southwind linger, what we do know is that they carry with them the weapons they used in life. These weapons were specifically forged for fighting Silithid and it would be a great boon to our troops if we could recover some. Go to Southwind and put some spirits to rest, but bring their weapons back here.",
  },
  [27356] = {
    ["T"] = "Released From Anguish",
    ["O"] = "Slay 6 Tortured Druids within the ruins of Southwind Village.",
    ["D"] =
    "Many years ago, during the War of Shifting Sands, my brethren and I were stationed within a small village south of here, on the eastern border of Un\'Goro. \n\nOur defenses were overcome... the village was lost, and many of those I fought alongside now roam in agony and anguish. Release their spirits so that they may pass on from this torture.",
  },
  [27357] = {
    ["T"] = "Reports From The Past",
    ["O"] = "Collect 3 Ancient Reports from Southwind Village.",
    ["D"] =
    "When the Silithid overran Southwind Village eons ago, many that could not flee perished in the battle. But the Kaldorei forces left behind key intel in the form of reports which detail how we can fight the Silithid.\n\nWill you go to Southwind Village for me, and gather as many as you can? Information is the key to victory, and I fear there may be secrets that even we night elves have forgotten.",
  },
  [27358] = {
    ["T"] = "Shade Slaughter",
    ["O"] = "Slay the Shade of Selandiir and bring his essence to Folean Sageblower at Valor\'s Rest in Silithus.",
    ["D"] =
    "There is great unrest at Southwind Village, $n. The shade of a once mighty Druid named Selandiir has been witnessed there, babbling and screaming to himself. They say he chants \"The Eye Comes\" over and over.\n\nMy father once served alongside Selandiir, and in his memory I must free the Druid from this anguish. Will you do this for me?",
  },
  [27359] = {
    ["T"] = "Silence The Whispers",
    ["O"] =
    "Slay the Shade of Ambermoon and free her from her insanity for Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "Some time ago, a wandering dwarf named Brann passed through here, traveling between Tanaris and Silithus for reasons he chose not to share. The last time he passed through Valor\'s Rest he reported seeing the shade of one of Southwind\'s commanders, Lady Ambermoon. He claimed that he overheard her talking to whispers she alone could hear.\n\nI fear her tortured mind has truly broken -- or worse, something sinister is influencing her in undeath. Would you please release her spirit from whatever dark force has power over it?",
  },
  [27360] = {
    ["T"] = "Crystal Survey",
    ["O"] = "Peta Windscar wants you to use the Essence Focuser on 5 piles of crystals at the northeast end of Silithus.",
    ["D"] =
    "Just southwest of here, there are piles of crystals which are notably different when compared to those further west. I need to understand the purpose of these crystals, and see if there is something we can use for our purposes here.\n\nTake this focuser and seek to attune it to the piles of crystals in the northeast, and then return it to me.",
  },
  [27361] = {
    ["T"] = "Culling the Wildlife",
    ["O"] = "Zannok Hidepiercer wants you to kill 8 Sand Skitterers.",
    ["D"] =
    "As you move through Silithus, you have surely been attacked by the vicious spiders that call this land home. Valor\'s Rest is not immune to this, either.\n\nThe guards do their best to keep us safe, but we need someone that can strike out against them and offer the expedition a reprieve. Would you do us this kindness?",
  },
  [27362] = {
    ["T"] = "Scorpid Venom Collection",
    ["O"] = "Nata Hawksong wants you to collect 8 Vials of Scorpid Venom from any scorpids in Silithus.",
    ["D"] =
    "One of the challenges our expedition faces in Silithus is the sting of scorpids. Their venom is strong and deadly, and we do not have enough samples of it to create antivenom.\n\nWe are spread thin. If you would aid us by collecting vials of venom from the local scorpids, that would help us tremendously.",
  },
  [27363] = {
    ["T"] = "The Swarms",
    ["O"] = "Capture 6 Silithid Wasp Swarms for Am\'las Moonsword at Valor\'s Rest in Silithus.",
    ["D"] =
    "The work of the Cenarion Circle in Silithus has given me a unique opportunity to study the aqir up close.\n\nThe Silithid have swarms of juvenile wasps that can be found just west of here. I\'d collect them myself, but my studies keep me here for now. Would you gather them in my stead?",
  },
  [27364] = {
    ["T"] = "Those....",
    ["O"] = "Zannok Hidepiercer wants you to kill 10 Dredge Strikers.",
    ["D"] =
    "Dredge worms call Silithus home, and are just another example of the horrible creatures that can be found here. They are exceptionally violent and will attack without hesitation.\n\nThey have yet to encroach on Valor\'s Rest, but I am not willing to take the chance. Could I convince you to thin their numbers?",
  },
  [27365] = {
    ["T"] = "Champion of Thunderaan",
    ["O"] =
    "Gather 5 Essence of Thunderaan from Dust Stormers, then use them to summon and slay the Champion of Thunderaan. Should you succeed, return to Jarund Stoutstrider at Valor\'s Rest in Silithus.",
    ["D"] =
    "Have you heard of Thunderaan, the Prince of Air? His importance cannot be understated in Silithus, as many of his subjects wander the Crystal Vale to the northwest. Elementals known as Dust Stormers carry his essence, tying themselves to their master. If one was to weaken the grip of the Prince on Silithus, they would need to slay his subjects and gather these essences together. Once you have enough, use them to call upon the Champion of Thunderaan and slay it.",
  },
  [27366] = {
    ["T"] = "Forbidden, Or Just Lost?",
    ["O"] = "Collect a Twilight Tablet for Am\'las Moonsword at Valor\'s Rest in Silithus.",
    ["D"] =
    "The Twilight\'s Hammer had a camp in the northwest end of Silithus that was destroyed some time ago. The how and why are questions for later, but what is most interesting now is the potential to collect what information they may have had at their camp. It is my hope that they have a greater knowledge of the aqir, the Qiraji, and the Silithid.\n\nIf you find yourself in the area of the ravaged camp, would you take a look around and see what you can find? Be wary of any cultists that may be waiting in the shadows.",
  },
  [27367] = {
    ["T"] = "Dust in the Wind",
    ["O"] = "Slay 8 Dust Stormers for Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "Throughout this land are air elementals known as Dust Stormers, though they seem to have the greatest presence far to the west, just south of the Crystal Vale. They are furious elementals that cause dangerous sandstorms that affect the entirety of Silithus.\n\nIt is very important that their numbers be reduced. If you mean to confront them on our behalf, take care and bring allies.",
  },
  [27368] = {
    ["T"] = "Grumbling Rumblers",
    ["O"] = "Slay 6 Desert Rumblers for Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "It\'s well known that the Twilight\'s Hammer cult calls upon earth elementals to be servants for their dark deeds. Within the Crystal Vale itself are several elementals summoned and left to wreak havoc on the land.\n\nValor\'s Expedition is spread thin, so it falls to heroes like yourself to deal with the threat of these rampaging elementals. Please, $n, gather your fellow adventurers and reduce their numbers.",
  },
  [27369] = {
    ["T"] = "Small Enough to Carry",
    ["O"] = "Collect 8 Silithus Crystal Fragments from the Crystal Vale for Peta Windscar at Valor\'s Rest in Silithus.",
    ["D"] =
    "There is a place called the Crystal Vale in northwest Silithus, far from here. The crystals there are more numerous than those found elsewhere. Our scouts reported that the crystals are growing, and that \"juvenile\" crystals can be found not far from much larger crystals there.\n\nCould you retrieve some samples of the juvenile crystals for me?",
  },
  [27370] = {
    ["T"] = "Avenging What, Exactly?",
    ["O"] = "Kill 8 Twilight Avengers for Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "The Silithid are not the only dangers present in this land. Our work is disrupted by the Twilight\'s Hammer cult in the form of their \"avengers,\" though what it is they are avenging is unknown to me.\n\nI ask that you gather your fellows and strike at them to reduce their numbers. Take care, however. They are not to be taken lightly.",
  },
  [27371] = {
    ["T"] = "Cult Plans",
    ["O"] = "Recover 3 sets of Cult Plans from any Twilight\'s Hammer camp in Silithus.",
    ["D"] =
    "Keeping an eye on enemy operations is just one of my tasks for the expedition, however I am unable to do my duty while I recover from my recent wounds. My task was to infiltrate the camps belonging to the Twilight\'s Hammer and learn anything I can about their plans.\n\nWill you undertake this task in my stead? Find any of their camps and bring their plans to me.",
  },
  [27372] = {
    ["T"] = "Elemental Binding",
    ["O"] = "Recover 6 Bracers of Elemental Binding from Twilight Geolords and Twilight Stonecallers.",
    ["D"] =
    "The Twilight\'s Hammer works ceaselessly, calling upon elementals and binding them to this plane. Our scouts report that the cult is most concentrated in the east and southeast, and it is at those locations where most of their bindings take place.\n\nIf you are here to assist Valor\'s Expedition, I ask that you find and disrupt them. Bring the bracers they bind elementals with back to me.",
  },
  [27373] = {
    ["T"] = "Good Reading",
    ["O"] = "Obtain 5 Twilight Writings from any Twilight\'s Hammer cultist in Silithus.",
    ["D"] =
    "Seems like everyone is busy thinking about the Twilight\'s Hammer cult today, but nobody has any idea what their motivation is for their cursed acts. To understand a cult, one need only read its dull literature. I\'m betting that members of the cult have information on them that\'ll help us better understand the structure of the organization and how best to deal with it.\n\nIf you find yourself battling cultists any time soon, take the time to check if they have anything written on them that can help us understand. Sasia may get something useful out of it.",
  },
  [27374] = {
    ["T"] = "No (Old) Gods, No (Twilight) Masters",
    ["O"] = "Kill 6 Twilight Masters for Milais Mistblade at Valor\'s Rest in Silithus.",
    ["D"] =
    "Dark rituals are performed in Silithus which torture the spirits of the fallen, as well as antagonize those of us that live. None other than the Twilight\'s Hammer\'s \"Masters\" are responsible for these profane acts.\n\nThere was a time where I would take the responsibility upon myself to hunt them down and slay them, but I must remain here to maintain our defenses. Would you act in my stead, and strike out at those who would call themselves masters of the Twilight\'s Hammer?",
  },
  [27375] = {
    ["T"] = "Sister, Sister",
    ["O"] = "Acquire 3 Hive\'Zora Sister Brains from Hive\'Zora Hive Sisters.",
    ["D"] =
    "There is a Silithid creature known as a \"Hive Sister\" at Hive\'Zora. What makes this variant special? Are they more or less capable than other types? I have so many questions! I brought the matter up with others in the expedition, but Sasia seems to be under the impression that we cannot send forces to secure samples without exposing us to serious danger.\n\nI hate to ask, but would you please collect samples of their brains to bring back to me for study?",
  },
  [27376] = {
    ["T"] = "Starve Them",
    ["O"] = "Burn 10 Piles of Meat at Hive\'Zora and return to Zannok Hidepiercer at Valor\'s Rest in Silithus.",
    ["D"] =
    "The Silithid survive off enormous piles of meat from the wildlife they kill. I suggested to Sasia that the guards find and torch the swarm\'s food supply, but she thought the risks were too great. I don\'t disagree, but we can\'t leave the swarms to grow endlessly.\n\nIf I give you my torch, will you set flame to their food supplies in Hive\'Zora?",
  },
  [27377] = {
    ["T"] = "The Wasp\'s Nest",
    ["O"] = "Slay 8 Hive\'Zora Wasps at Hive\'Zora and return to Zannok Hidepiercer at Valor\'s Rest in Silithus.",
    ["D"] =
    "A disturbingly large amount of Silithid wasps have been sighted at Hive\'Zora. These are no ordinary wasps, and to be seen in such numbers is a sign that we may soon expect to be attacked.\n\nIt is my belief that the Silithid would not expect a preemptive counterstrike while they are mustering their power. While we are holding the defensive here, you and your compatriots could strike against the wasps at Hive\'Zora and reduce their numbers.",
  },
  [27378] = {
    ["T"] = "Watcher of Ways",
    ["O"] = "Slay 6 Hive\'Zora Waywatchers at Hive\'Zora, then return to Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "The expedition is on high alert, and for good reason. The Silithid are dangerous enough that we cannot give them any ground. To that end, if you are interested in helping out, you can take the fight to the Waywatchers at Hive\'Zora. With their numbers reduced, the swarms will have impaired coordination, allowing us to strengthen our hold on the road into Silithus.\n\nMaybe then Sasia will breathe, and we can get back to work.",
  },
  [27379] = {
    ["T"] = "Darai\'s Report",
    ["O"] =
    "Find Darai Moonbough in Hive\'Zora and obtain her report for Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "Darai went out to scout Hive\'Zora. The situation is delicate here, and we will need to obtain an early report from her to stay ahead of the Silithid threat. With the risk of the hives mobilizing without us knowing, I need to keep the expedition guards close.\n\nCould you find Darai within the hive and get the report from her?",
  },
  [27380] = {
    ["T"] = "Oh Lordy!",
    ["O"] =
    "Obtain 3 brains from Hive\'Regal Hive Lords at Hive\'Regal and return to Am\'las Moonsword at Valor\'s Rest in Silithus.",
    ["D"] =
    "Hive\'Regal is controlled by Silithid known as Hive Lords. They are at the top of their hierarchy, though still subservient to their Qiraji masters. I\'ve been looking into the brains of various different Silithid for comparison to better understand how they work.\n\nThe expedition wardens were unsuccessful in retrieving samples of hive lord brains. Would you aid my research by getting me some?",
  },
  [27381] = {
    ["T"] = "Bug Squishing",
    ["O"] = "Kill 6 Hive\'Regal Burrowers at Hive\'Regal and return to Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "One of the Silithid types at Hive\'Regal is known to burrow and tunnel through the land, making paths for others. Whatever defenses we prepare here can be undermined by these creatures!\n\nOur wardens are still keeping a close eye on Valor\'s Rest, otherwise they\'d be out dealing with them. Can I entrust the task to you instead?",
  },
  [27382] = {
    ["T"] = "Imminent Emancipation",
    ["O"] = "Kill 5 Hive\'Regal Slavemakers at Hive\'Regal and return to Maska Emberbender at Valor\'s Rest in Silithus.",
    ["D"] =
    "Have you ever seen slaves in the employ of the Silithid, $n? I have not. However, there have been reports that some of the Silithid at Hive\'Regal can take control of an unwary soldier\'s mind. These creatures have been dubbed \"Slavemakers\". As to where these Slavemakers bring the slaves they \"make,\" I will never know. What I do know is that we must eliminate these Silithid for our own good. If you\'re here to help us, you\'ll kill any Slavemakers you find, and take care not to be enslaved yourself.",
  },
  [27383] = {
    ["T"] = "It\'s More Like Acid",
    ["O"] =
    "Obtain 5 Acidic Spit Samples from Hive\'Regal Spitfires at Hive\'Regal and return to Nata Hawksong at Valor\'s Rest in Silithus.",
    ["D"] =
    "For once, my focus is not on crafting antivenom. It seems that no matter what I do, I cannot create an effective counter to the acidic spit that some of the Silithid at Hive\'Regal use to dissolve enemy armor. If you are in the vicinity of Hive\'Regal, will you gather spit samples from the \"Spitfires\" there?",
  },
  [27384] = {
    ["T"] = "Striking at the Heart",
    ["O"] =
    "Place the Glowing Seed at the heart of Hive\'Regal and Return to Layo Starstrike at Valor\'s Rest in Silithus.",
    ["D"] =
    "The time to act is now, $n. While the Silithid attempt to regroup, we need to make a move on one of their hives and disrupt it. In my possession is a seed of volatile power that, when planted, will grow rapidly and without control. Will you assist us by seeking the heart of Hive\'Regal and planting the seed in its heart?",
  },
  [27385] = {
    ["T"] = "Oppress the Workers",
    ["O"] = "Eliminate 6 Hive\'Ashi Workers at Hive\'Ashi and return to Sasia Forestcrest at Valor\'s Rest in Silithus.",
    ["D"] =
    "Hive\'Ashi is run by drones, or workers, that handle the mundane tasks around the hive. While not as militant as others, they ensure that the hive can continue to produce more dangerous Silithid. The expedition wardens I sent were to try and eliminate as many of the drones as they could, but I regret that several died in the hive. I cannot send more to complete their task.\n\nWill you brave Hive\'Ashi and strike down a significant number of their workers, fulfilling the task left unfinished by the fallen wardens?",
  },
  [27386] = {
    ["T"] = "Egg Smash!",
    ["O"] = "Smash 10 Silithid Eggs at Hive\'Ashi and return to Jarund Stoutstrider at Valor\'s Rest in Silithus.",
    ["D"] =
    "If we are to stem the swarm\'s growth, we should look to the source. It is unlikely we will find a single brood mother, but I do know that there are eggs all throughout Hive\'Ashi. Hypothetically, were a band of adventurers to venture there and smash them into mush, there would be less Silithid to reinforce their numbers in the future.",
  },
  [27387] = {
    ["T"] = "Stingers from Stingers",
    ["O"] =
    "Obtain 5 Hive\'Ashi Stingers from Hive\'Ashi Stingers at Hive\'Ashi and return to Nata Hawksong at Valor\'s Rest in Silithus.",
    ["D"] =
    "The stingers at Hive\'Ashi have a potent venom that\'s especially lethal when compared to others injected by Silithid. After the failure of our wardens, I\'m concerned that we just aren\'t ready to take them on without devising an antidote.\n\nIf you find yourself down there, can you collect some of the stingers from the...  stingers? Hive\'Ashi stingers from Hive\'Ashi Stingers. Does that make sense?",
  },
  [27388] = {
    ["T"] = "Recover the Lost",
    ["O"] =
    "Recover 3 Valor\'s Rest Supplies from Hive\'Ashi and return to Milais Mistblade at Valor\'s Rest in Silithus.",
    ["D"] =
    "With much of the threat of the swarm attacking Valor\'s Rest diminished, Sasia used our chance to strike at Hive\'Ashi in an attempt to cripple them and buy the expedition more time. Many wardens battled at the hives, but were forced to retreat back here. We lost many supplies and armaments in the fight. Would you go the the hive and see what you can recover?",
  },
  [27389] = {
    ["T"] = "Just One?",
    ["O"] = "Kill the Hive\'Ashi Overlord at Hive\'Ashi and return to Darai Moonbough at Valor\'s Rest in Silithus.",
    ["D"] =
    "Each of the Silithid hives is unique in how they work. In the case of Hive\'Ashi, their leadership is centralized around a single overlord that rules directly from the hive itself. Sasia sent expedition wardens to eliminate it, but I fear they were not successful.\n\nThe threat of the hives mobilizing is still very real, and it\'s not likely that another expedition will be sent out. Please, $n, gather other adventurers and eliminate the overlord of Hive\'Ashi.",
  },
  [27390] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27391] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27392] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27393] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27394] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27395] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27396] = {
    ["T"] = "Gratitude Of The Expedition",
    ["O"] = "Collect your Expedition Crate.",
    ["D"] = "",
  },
  [27397] = {
    ["T"] = "A Trip to the Vale",
    ["O"] =
    "Collect 1 Charred Wood and 1 Basilisk Tail from the Charred Vale and return to Kulwia at Sun Rock Retreat in Stonetalon Mountains.",
    ["D"] =
    "I am in need of some exotic trade materials only found in The Charred Vale. It\'s a dangerous place where only the bravest of adventurers go. You can find it by heading north of here. When you reach Mirkfallon Lake, go east, and you should find the path.\n\nThe materials I need are one basilisk tail, and one piece of charred wood from the ancients that roam the vale. Bring me these materials and I will make it worth your while.",
  },
  [27398] = {
    ["T"] = "Attack on the Mine",
    ["O"] =
    "Kill 5 Windshear Geomancers, 5 Windshear Overlords, and 10 Windshear Diggers in Windshear Mine, then return to Grawnal at Sun Rock Retreat in Stonetalon Mountains.",
    ["D"] =
    "If you find yourself in Windshear Crag, be on the lookout for a mine the Venture Company has constructed. I heard they started operations, but kobolds took over the mine and pushed the Venture Company out!\n\nThe Venture Company plunders the resources of the earth without thinking of the consequences, but kobolds are vermin that, if left unchecked, summon elementals of significant power. The operations in the mine must be stopped!  Do what it takes, $N, and do not return to me until the task is completed.",
  },
  [27399] = {
    ["T"] = "Hunting in Serenity",
    ["O"] =
    "Collect 10 Courser Fur from the deer around Stonetalon Grove and return to Hunter Kyana in the Stonetalon Mountains.",
    ["D"] =
    "Greetings, $C. Are you familiar with the art of hunting? The deer here in the grove are quite elusive, and would make a formidable challenge for anyone wishing to hunt them. Their quick feet and sharp senses make for good sport.\n\nTell you what, if you bring me some of their fur, I\'ll even make you a nice cloak out of it! I\'ll be keeping some for myself of course, because the winters get cold up here! Best of luck, and if you can\'t find any up here, the deer sometimes venture a bit further south, near the trail leading up to the grove.",
  },
  [27400] = {
    ["T"] = "Mirkfallon Bracers",
    ["O"] =
    "Collect 8 Mirkfallon Bracers from the water elementals at Mirkfallon Lake and return to Tammra Windfield at Sun Rock Retreat in Stonetalon Mountains.",
    ["D"] =
    "Greetings, $N. It\'s good to see a $C around here, as there is much work to be done. I have lived in Sun Rock Retreat for many years now, and these mountains never fail to amaze me. Recently a magical spring has awoken at nearby Mirkfallon Lake, and I need your help to deal with it.\n\nThe lake is an old and ancient refuge for creatures of the forest. Thanks to the spring, water elementals have sprung from the lake\'s depths and are harming the creatures all around the lake. I want you to get rid of the water elementals, and bring me their bracers as proof of this deed.",
  },
  [27401] = {
    ["T"] = "Mirkfallon Lake",
    ["O"] =
    "Collect 8 Mirkfallon Essence from the Water Elementals at Mirkfallon Lake and return to Centrica Nightsong at Stonetalon Grove in Stonetalon Mountains.",
    ["D"] =
    "The Stonetalon Mountains are home to many of Elune\'s precious creatures, $N. I ventured here to study them, and practice alchemy in peace.\n\nI have observed some water elementals south of here, at Mirkfallon Lake. I would love to test the effects of their essences. Do you think you could bring me some?\n\nSimply follow the road south out of the grove, and you should reach Mirkfallon Lake with no trouble. If you bring me some usable samples, I\'ll be happy to give you some of my potions!",
  },
  [27402] = {
    ["T"] = "Ore for Sun Rock",
    ["O"] = "Mine 8 Palladium Ore from Windshear Mine and return to Grawnal at Sun Rock Retreat.",
    ["D"] =
    "I know it doesn\'t look it, but we\'re running low on metals that we can forge into weapons for the guards. If we can\'t defend ourselves, we leave ourselves open to an Alliance attack!\n\nI\'ve heard that the Venture Company found a new ore here in Stonetalon, that is said to be stronger than the iron we\'ve been using. I want you to take my pickaxe and go to Windshear Mine. Just enter Windshear Crag and head to the right, along the mountain\'s edge, to find the mine. If you find any special ore, use my pickaxe to gather it, and bring it back to me for examination.",
  },
  [27403] = {
    ["T"] = "Rumbles Of The Earth",
    ["O"] = "Collect 3 Metallic Tail Spines from Pridewing Skyhunters, Consorts, or Patriarchs.",
    ["D"] =
    "Well, I can\'t deny that my brother has saved me some time building this gizmo, but there\'s one thing this needs: more power! I can super charge this with a makeshift battery, but I\'m going to need a couple things. The first is the metallic tails of the strongest Pridewings that you can find, which are northwest of here.\n\nI only want the biggest, meanest and toughest of them! You can get a nice mature tail from the Skyhunters, Consorts, or Patriarchs.",
  },
  [27404] = {
    ["T"] = "Rumbles Of The Earth",
    ["O"] = "Collect 4 Lightning Totems from Bloodfury Storm Witches within the Charred Vale in Stonetalon Mountains.",
    ["D"] =
    "I know! Within the Charred Vale you will find Bloodfury Storm Witches. The lightning that they channel must have a source. Kill them and bring me whatever it is! I can channel their lightning with the tails you\'ve brought me and super charge this Tremormatic.\n\nI think four harpy sources should suffice. The Charred Vale can be found west of Sun Rock Retreat.",
  },
  [27405] = {
    ["T"] = "Rumbles Of The Earth",
    ["O"] = "Using the Tremormatic MK III, locate the source of the tremors within Stonetalon.",
    ["D"] =
    "Here we go. I introduce, the Tremormatic MK III. I always was better at bodging things together than my brother. You know the score, I can tell!\n\nNow slap the Tremormatic on the ground and it will locate the source of these tremors. Get at it!",
  },
  [27406] = {
    ["T"] = "Rumbles Of The Earth",
    ["O"] = "Bring a sample of the ore to Ditsy Springsocket in Sun Rock Retreat.",
    ["D"] =
    "The ore before you is unlike anything you have ever seen before. With great effort you manage to pull a chunk off to bring to Ditsy Springsocket.",
  },
  [27407] = {
    ["T"] = "Rumbles Of The Earth",
    ["O"] = "Bring the Coprolite Sample to Thrall in Orgrimmar.",
    ["D"] =
    "No one dares venture into Stonetalon Caverns since the Warchief, a few years ago, and he\'s the only person I know to have come back alive. Take the sample you collected to him, and tell him of your journey.\n\nThere is no one who would have better insight into this metal than he will.",
  },
  [27408] = {
    ["T"] = "Tinkering in the Vale",
    ["O"] =
    "Collect 10 Scorched Scales and 1 Raging Core from The Charred Vale and return to Bapper Tookwinkle at Stonetalon Grove in Stonetalon Mountains.",
    ["D"] =
    "Good day, $gsir:madam;! It\'s quite nice up here in the grove, wouldn\'t you say? I actually came here to explore some of the creatures in The Charred Vale, and see if they could be of any use in my next creation.\n\nUnfortunately, I am too scared to actually venture there. You look like a strong adventurer, could you go instead? I need scales off the basilisks, and a core from the earth elementals. You\'ll find The Charred Vale south of here, via a path west of Mirkfallon Lake.",
  },
  [27409] = {
    ["T"] = "Twilight Fangs",
    ["O"] = "Collect 10 Twilight Fangs and return to Krond at Sun Rock Retreat in Stonetalon Mountains.",
    ["D"] =
    "Should you find yourself at Stonetalon Grove, far north of here, keep a keen eye out for the Twilight Runners that lurk there. Their fangs are said to be of the highest quality, but they are rare because the cats are elusive and quick.\n\nIf you bring me some of their fangs, I\'ll be happy to craft you something made of them. Some say the twilight fangs even have magical properties...!",
  },
  [27410] = {
    ["T"] = "Vines of the Lake",
    ["O"] = "Collect 8 Water Vines from Mirkfallon Lake and return to Vallourek Nightsong at Stonetalon Grove.",
    ["D"] =
    "It\'s good to see a $c around here, I\'ve been looking for an individual with a sense of adventure! My sister, Centrica Nightsong, is in need of some new material for her alchemy studies. I came along so I could assist her, but I\'m afraid I haven\'t been much help at all! The herbs she needs only grow in dangerous places, and I have no skill with a blade.\n\nWould you be willing to go in my place, $N? She needs water vines that only grow in Mirkfallon Lake. The lake is easy enough to find, simply follow the road south, but be wary of the creatures there!",
  },
  [27411] = {
    ["T"] = "Vines of the Lake",
    ["O"] = "Deliver the Crate of Water Vines to Centrica Nightsong at Stonetalon Grove.",
    ["D"] =
    "Your assistance was much appreciated, $N. I went ahead and placed the water vines into a crate, so if you could deliver them to my sister that would be great! You can find her right at the inn up here. She will be so pleased to finally have these herbs; I know she has been trying to get ahold of them for some time now.",
  },
  [27412] = {
    ["T"] = "Attack on the Foulweald",
    ["O"] = "Collect 15 Foulweald Amulets and return to Sentinel Thenysil in Astranaar.",
    ["D"] =
    "If you listen closely you can hear the strained cries of the Foulweald tribe. These damned furblogs plague this land, terrorizing villages, and hunting civilians. It\'s time to bring the fight to them, and we will strike hard!\n\nThey made their camp south of the road to the east, shortly before you reach Raynewood Retreat. We must show no mercy, $N. Kill them all, and bring me the amulets they wear to mark their tribe as proof of their demise. Good luck, Astranaar is counting on you.",
  },
  [27413] = {
    ["T"] = "Report to Kaela",
    ["O"] = "Report to Kaela Shadowspear who overlooks the valley entering Windshear Crag in the Stonetalon Mountains.",
    ["D"] =
    "We dealt a decisive blow to the Foulweald today, but I have recieved information that threats in Stonetalon Mountains require our attention. Apparently, the Venture Company has started up operations in Windshear Crag. This must be put to a stop.\n\nSince you proved effective with the Foulweald, I would like for you to report to Kaela Shadowspear, who is overseeing our attack on the Venture Company. After you travel to Stonetalon along the Talondeep Path south of here, you can find her on a cliff overlooking the entrance to Windshear Crag.",
  },
  [27414] = {
    ["T"] = "Torching the Stockpiles",
    ["O"] =
    "Set fire to 8 Venture Co. Supplies in Windshear Crag and then return to Kaela Shadowspear in Stonetalon Mountains.",
    ["D"] =
    "Below this vantage point lies Windshear Crag, a once lush and beautiful forest. However, its serenity is being threatened by the Venture Company, a relentless group of goblins motivated by profit. They are known for destroying Azeroth\'s majestic spaces for their natural resources.\n\nWe need to launch an attack on the Venture Company, for the protection of the forest. I want you to take this torch and light it at the campfire behind me, then set fire to their supply crates. If your torch runs out of flame, come back to me for another one. The forest is counting on you, $N.",
  },
  [27415] = {
    ["T"] = "Windshear Mine",
    ["O"] = "Kill 15 Windshear Diggers in Windshear Mine and return to Kaela Shadowspear in Stonetalon Mountains.",
    ["D"] =
    "I expect that the Venture Co. will have a hard time continuing operations here with their supplies burnt to a crisp. Our next threat to Windshear Crag is kobolds. They have begun digging for ore in a mine, along with terrorizing the citizens of these parts.\n\nYou\'ll find the mine directly east of where you enter Windshear Crag. Exterminate the kobolds there, and return to me. It\'s important for the safety of these lands that those vile creatures are not allowed to continue mining here.",
  },
  [27416] = {
    ["T"] = "Stonetalon Grove",
    ["O"] = "Deliver Kaela\'s Report to Captain Mynera at Stonetalon Grove in the Stonetalon Mountains.",
    ["D"] =
    "$N, I appreciate all your assistance dealing with the problems in Windshear Crag. My superior in Stonetalon Grove, Captain Mynera, has requested a report on the status of Windshear Crag. Do you think you could bring it to her? To reach Stonetalon Grove, follow the road all the way north.",
  },
  [27417] = {
    ["T"] = "A Loa\'s Respect",
    ["O"] =
    "Collect meat from Searing Rocs and Glasshide Petrifiers in the southwest region of Tanaris for an offering to Gral, the Loa of the sea.",
    ["D"] =
    "Ey, mon. I be Akiha, powerful shaman and servant of Gral, de Loa of de sea. I come to you wit a task of great importance.\n\nTo de west of Anje\'Watha, dere be Searing Rocs and Glasshide Petrifiers. Dese beasts be known for de succulent meat dey provide, and I need a large amount of it to gain de favor of Gral.\n\nI need Gral\'s blessing to keep de elementals flowing dat provide us wit water in de desert. Without his favor, dey will wither and fade away.\n\nBring me as much meat as you can manage.",
  },
  [27418] = {
    ["T"] = "A Loa\'s Respect",
    ["O"] = "Make an offering to Gral at the altar on Land\'s End Beach in order to gain his favor.",
    ["D"] =
    "Now, I have another task for you. I need you to take dis meat to an altar on Land\'s End Beach and place it dere as an offering to Gral. Hopefully, he will be pleased with de offering and appear to us.\n\nTo find de altar on Land\'s End Beach, simply travel east of Anje\'Watha until you reach de sandy shores. The altar can be found near de water\'s edge.\n\nOnce you have made de offering, return to me at Anje\'Watha and I will reward you for your efforts. May Gral guide you on your journey.",
  },
  [27419] = {
    ["T"] = "Boom! Boom! Boom!",
    ["O"] = "Collect 8 Flame Sacs from Fire Rocs in the Abyssal Sands of Tanaris. They are usually found around bones.",
    ["D"] =
    "Boom! Boom! Boom! I\'m making a biiig grenade! Why? Why not!? Boom! Boom! Boom!\n\nI need an extra boost that can come from only one thing: Fire Rocs. Can you go collect some of their Flame Sacs?",
  },
  [27420] = {
    ["T"] = "Two-Legged Vultures",
    ["O"] = "Collect Marvon\'s Pocket Watch, Brimmed Hat, and Ham Radio from the looters at his crashed zeppelin.",
    ["D"] =
    "I crashed here two weeks ago and already my zeppelin has been taken taken over by looters.\n\nThey\'re no better than vultures, swooping out of nowhere to pick apart what isn\'t theirs.\n\nHowever there\'s only me out here and I\'m focused on my research. Could you be a dear and go collect my things from the looters? As you can see I\'ve barely a scrap to my name here.",
  },
  [27421] = {
    ["T"] = "Lightfoot\'s Rescue",
    ["O"] = "Escort Scout Lightfoot out of the Noxious Lair and defend him from any threats along the way.",
    ["D"] =
    "Thank you for finding me. I was on a scouting mission in the Noxious Lair when I was ambushed and knocked unconscious. I need your help to get out of here and back to Anje\'Watha. Will you help me?",
  },
  [27422] = {
    ["T"] = "No One Drinks For Free",
    ["O"] =
    "Have a stern talk with the occupants of Steamwheedle Port who have not paid their water bills. Return to Security Chief Bilgewhizzle at Steamwheedle Port in Tanaris when you have completed this task.",
    ["D"] =
    "Well, don\'t you look like a walking, talking, mean son of a gun... open to a little side work? Around here if you want the best clean water you have to go through us. We pipe it directly to all the homes in town for a fee.\n\nSome people don\'t seem to understand how generous we\'ve been and have \"forgotten\" to pay their bills. I need someone to convince them. You can do that, can\'t you?\n\nThe first is Miss Miki Springsocket. She sells food and drinks behind the inn. The second will be Inabit Wedgefeet, our resident explosives obsessive. You\'ll find him easily as he\'s the only gnome in town. Thirdly you\'ll have to track down Stelx. She recently set up shop selling and fixing armor. Lastly, that fishy-smelling fool, Gikkix.",
  },
  [27423] = {
    ["T"] = "Scout\'s Honor",
    ["O"] =
    "Head northwest to the Noxious Lair and locate a scout named Shadowdancer who is monitoring the situation there.",
    ["D"] =
    "Listen carefully, adventurer. I sent a strong troll named Shadowdancer and her scouting party to monitor the situation at the Noxious Lair to the northwest. They have not reported back in weeks, and I am concerned for their safety. I need someone to head to the Noxious Lair and locate them.\n\nI will not tolerate incompetence. If Shadowdancer and her party are in danger, it is your duty to locate them and ensure their safety. Head to the Noxious Lair and do not return until you have found them. And be warned -- if you fail in this task, you will face the full wrath of my anger. Do I make myself clear?",
  },
  [27424] = {
    ["T"] = "A Party Fractured",
    ["O"] = "Collect 8 Centipaar Wasp Stingers from the Centipaar Wasps above ground at the Noxious Lair.",
    ["D"] =
    "The rest of my scouting party was stung and knocked unconscious by a paralyzing toxin during fights with the insect Silithid, and I am worried about their safety. I need the stingers from the Centipaar Wasps that are found above ground at the Noxious Lair to create a salve that will cleanse the toxin and help them recover.",
  },
  [27425] = {
    ["T"] = "Worker\'s Rebellion",
    ["O"] = "Kill 10 Centipaar Workers at the Noxious Lair for Scout Shadowdancer in Tanaris.",
    ["D"] =
    "Listen carefully, $n. While you are collecting the stingers from the Centipaar Wasps, I have seen the Centipaar Workers dragging unconscious members of the scouting party into the hive for unknown reasons. I need you to kill these workers to prevent them from taking any more of my scouts into the hive.",
  },
  [27426] = {
    ["T"] = "On Your Feet",
    ["O"] = "Locate and revive 8 Unconscious Scouts on the surface of the Noxious Lair.",
    ["D"] =
    "The safety of my scouting party is at stake, and we need to revive them as soon as possible. Head to the Noxious Lair and use this salve I\'ve made to revive the unconscious scouts. Do not return until you have successfully revived all of the scouts. Do I make myself clear, $n?",
  },
  [27427] = {
    ["T"] = "Silithid Scramble",
    ["O"] = "Scout deeper into the hive and eradicate 6 Centipaar Tunnelers and 6 Centipaar Sandreavers.",
    ["D"] =
    "Thank you for your help with reviving the scouts, $n. Now it is time for us to seek vengeance for what the Centipaar have done to my scouting party. I need you to scout deeper into the hive and eradicate the Centipaar Tunnelers and Centipaar Sandreavers who are responsible for digging the tunnels under the sands of Tanaris.\n\nThe hives are dangerous places, filled with all manner of deadly insects. You must be careful, $n, and be prepared for a difficult and dangerous fight. Once you have killed the Tunnelers and Sandreavers, return to me.",
  },
  [27428] = {
    ["T"] = "Bug Burnout",
    ["O"] = "Burn 6 Centipaar Stinger or Centipaar Swarmer corpses in the deepest parts of the Noxious Lair.",
    ["D"] =
    "I have a special mission for you, $n. The lowest depths of the Noxious Lair are filled with the toughest Centipaar, including the Centipaar Stingers and Centipaar Swarmers. I need you to reach them and kill these insects.\n\nHowever, there is a catch. When you kill the Stingers and Swarmers, you must use a torch that I have coated with crushed stinger paste to set them on fire. The stinger paste is highly flammable.\n\nYou see, $n, the Centipaar Stingers and Centipaar Swarmers are the most potent breeders of the Centipaar. By killing them and setting them on fire, we can decimate their population and prevent them from rebuilding the hive. It is a risky plan, but it is the only way to ensure the safety of the people of Tanaris. Can I trust you to do this, $n?",
  },
  [27429] = {
    ["T"] = "Urulg\'s Report",
    ["O"] = "Bring the Scouting Report back to Urulg in Anje\'Watha.",
    ["D"] =
    "We have successfully cleared the lair of all hostile creatures, and have discovered a potential weapon in the Silithid Stingers. I would be grateful if you could deliver this report to my superior, Urulg, and inform him of our success.",
  },
  [27430] = {
    ["T"] = "Supplying Anje\'Watha",
    ["O"] = "Bring the supplies to Urulg at Anje\'Watha in the southeast corner of Tanaris.",
    ["D"] =
    "Greetings, adventurer. I have a mission for you, if you\'re up for the challenge. We\'ve received word that our outpost at Anje\'Watha, to the southeast of here, is running low on supplies. I need someone to take a shipment of supplies to them. You\'ll find the outpost near The Gaping Chasm -- just head southeast from Gadgetzan and you should be able to find it. Are you interested?",
  },
  [27431] = {
    ["T"] = "Find Wuti",
    ["O"] = "Locate Wuti Sunjumper on Land\'s End Beach in Tanaris and ensure she is safe.",
    ["D"] =
    "Greetings, adventurer. I am in need of your help. My dear friend, Wuti Sunjumper, has been missing for several days. She is a skilled fisherwoman and a valuable member of our community. I fear something terrible may have happened to her.\n\nWill you please search for Wuti on Land\'s End Beach? Her home is located there, and it is the last place she was seen. I will be forever in your debt.",
  },
  [27432] = {
    ["T"] = "A Chilly Stranger",
    ["O"] = "Collect 8 Sandshore Seagrass and 6 Phials of Surf Glider Water for Wuti Sunjumper.",
    ["D"] =
    "The tuskarr is in great danger from the heat of the desert. I fear that he will not survive much longer without a cooling totem to protect him.\n\nTo create the totem, we will need a specific type of kelp called Sandshore Seagrass that can only be found on the desert coasts, as well as water from a turtle shell. Yes you heard me. A turtle shell.\n\nI know it will be a difficult task, but I beg of you, please help me by gathering these ingredients. The tuskarr\'s life depends on it.",
  },
  [27433] = {
    ["T"] = "A Chilly Stranger",
    ["O"] =
    "Fill the Crystal Phial with water from the Moonwell and gather 8 Sturdy Roots from Thistleshrub Thornseekers in Thistleshrub Valley for Wuti Sunjumper on Land\'s End Beach.",
    ["D"] =
    "I fear that the cooling totem will not be powerful enough to help the tuskarr. The desert heat is too strong, and he needs more powerful ingredients to recover.\n\nI have heard of a Moonwell in Thistleshrub Valley, to the northwest. The water from the Moonwell is said to have powerful healing properties. If we could obtain some of that water, it would greatly strengthen the totem.\n\nAdditionally, the most powerful Thistleshrub monsters that inhabit the valley are known to have strong roots that can enhance the potency of herbal remedies. If you could collect some of those roots for us, it would be a great help.\n\nI know it is a dangerous journey, but I beg of you, please help me obtain these ingredients. The tuskarr\'s life depends on it.",
  },
  [27434] = {
    ["T"] = "A Chilly Stranger",
    ["O"] = "Place the Water Totem next to Roknar the Tuskarr at Wuti Sunjumper\'s home.",
    ["D"] =
    "The totem is almost ready, adventurer. I just need your help to place it next to the tuskarr. His condition is still critical, and the totem will provide the healing he needs.\n\nCan you please assist me in placing the totem next to the tuskarr? Your help is greatly appreciated.",
  },
  [27435] = {
    ["T"] = "Technological Advances",
    ["O"] = "Journey to Steamwheedle Port and ask Innkeeper Fizzmind for a cooler for the tuskarr.",
    ["D"] =
    "I have not yet contacted Steamwheedle Port, but I have heard that they have a mechanical cooler that we could use to save the Tuskarr. However, I fear that they may not be willing to lend it to us without a good reason.\n\nCan you please go to Steamwheedle Port and convince Innkeeper Fizzmind to lend us the cooler? I understand that it may be difficult, but I am confident in your skills and abilities.\n\nThe tuskarr\'s life depends on it.",
  },
  [27436] = {
    ["T"] = "Keep On Chilling",
    ["O"] = "Bring the cooler to Akiha in Anje\'Watha and ask for his guidance on how to empower it.",
    ["D"] =
    "I must admit, I am fond of Wuti Sunjumper and I would like to help her. I will lend you the cooler, but I must warn you that it is not powerful enough on its own to replicate the cold of Northrend.\n\nTo empower the cooler and make it strong enough to save a tuskarr, you will need the assistance of a water elemental. The nearest water elementals can be found in Anje\'Watha, an outpost to the south that I don\'t doubt you are familiar with. Go ask a powerful Shaman there named Akiha for his guidance.",
  },
  [27437] = {
    ["T"] = "A Blessing of Aqua",
    ["O"] = "Ask both water elementals in Anje\'Watha for their blessing upon the cooler.",
    ["D"] =
    "I see da determination and passion in your eyes, adventurer. You truly believe in da importance of saving da Tuskarr. I am impressed by your resolve and I will do everyting in my power to help you.\n\nBut be warned, mon. Da water elementals are not bound to me by force. Dey be bonded to me by choice, and I cannot command dem to do anyting against dere will.\n\nYou must request da aid of da water elementals and convince dem of da need for da cooler and da importance of saving da Tuskarr. If you can do dat, dey will willingly empower da cooler and make it strong enough to save da Tuskarr\'s life.",
  },
  [27438] = {
    ["T"] = "A Chilly Friend",
    ["O"] = "Place the empowered cooler next to the tuskarr to cure him of his heat stroke.",
    ["D"] =
    "Adventurer, you have been instrumental in our quest to save the tuskarr. Without your help, we would have surely failed.\n\nI would like to ask one final favor of you. Would you do the honors of placing the cooler next to the tuskarr and saving his life? It would be a great honor for me, and I know that the tuskarr would be grateful as well.",
  },
  [27439] = {
    ["T"] = "The Great Brain Robbery",
    ["O"] = "Collect brains from the Silithid at the two hives in Tanaris.",
    ["D"] =
    "Ah, so you\'re the hero that\'s going to help me with my research, are you? Well, let me tell you, it\'s no easy task. I need brains from the Silithid at the two hives in Tanaris. Think you can handle that, or do I need to find someone else?\n\nI don\'t have time to explain the details, but let\'s just say I\'m conducting a study on the Silithid and I need brains from those critters. The hives in Tanaris are crawling with them, so get over there and collect as many brains as you can. I\'ll be waiting for you when you get back",
  },
  [27440] = {
    ["T"] = "Hive Mind",
    ["O"] = "Collect Dumont\'s Secret Supplies from Inabit Wedgefeet at Steamwheedle Port in Tanaris.",
    ["D"] =
    "We\'ve noticed something with the Silithid brains. A sort of... psychic link. They\'re not just driven by instinct -- somewhere in the dunes is a great Hazzali leader that controls the Silithid here and at the Noxious Lair.\n\nSilithid brains are very simple so we\'re going to make a special mind control cap rigged with explosives. I think it would suit Dennis here very well....\n\nI\'ve commissioned the cap from an eccentric gnome in Steamwheedle named Inabit Wedgefeet, along with some other things. Can you pick them up for me?",
  },
  [27441] = {
    ["T"] = "Mind Blown",
    ["O"] =
    "Using the Explosive Mind Control Cap, send Dennis into the northern Gaping Chasm Hive and destroy the Hazzali Brainlord inside.",
    ["D"] =
    "The Silithid are simple beasts who can even \"function\" with half their brain missing. Little Dennis over there is a prime example. Sadly, this cap is for him.\n\nThe Silithid will not attack him, which lets us get deep into the Gaping Chasm hive and take out the Brainlord that is controlling them. I\'m sure that Lillyn won\'t mind sacrificing her pet.",
  },
  [27442] = {
    ["T"] = "A Hive Cleared",
    ["O"] = "Inform Urulg that you have successfully cleared the Gaping Chasm hive of its strongest Silithid.",
    ["D"] =
    "This was far more successful than I anticipated. I think before long we can clear out of here and back to our real research in the Undercity. Go give that gruff oaf Urulg the good news.",
  },
  [27443] = {
    ["T"] = "Azeroth Space Society",
    ["O"] = "Locate Goddard of the Azeroth Space Society in Steamwheedle Port.",
    ["D"] =
    "Our chief rocket scientist Goddard has set up his experimental rocket development platform in Steamwheedle Port. Something about it being safer to launch over the ocean -- but since when has safety mattered?\n\nHe was recently complaining that he needs some assistance tracking down key materials.\n\nCould you go find him and see what he wants?",
  },
  [27444] = {
    ["T"] = "The Perfect Fuel",
    ["O"] =
    "Collect 8 Ancient Batteries from the Noonshade Ruins and 6 Extracted Scorpid Venom Sacs from Scorpid Hunters.",
    ["D"] =
    "I\'m working on the perfect rocket fuel for my prized construction you see right behind me. The fuel is the key to everything, and without it, this is nothing more than an overgrown uh... symbol. I can\'t be having that!\n\nThe ancient trolls of the Noonshade Ruins west of here used to create a rudimentary form of solar battery. As they have sat baking in the desert sun for decades, the battery power has only increased. Could you go and collect some, $n?\n\nWhile you\'re at it, I\'m going to need the biggest venom sacks you can get from the scorpid nearby.",
  },
  [27445] = {
    ["T"] = "The Perfect Fuel",
    ["O"] = "Collect Crude Oil from the base of the Oil Rig northeast of Steamwheedle Port.",
    ["D"] =
    "At the base of the Oil Platform northeast of here you can find a valve that they use to test the purity before and after they refine the oil. I need the crudest, most unrefined oil available, so that means we need to steal some from underwater. Go to that platform and bring this vessel with you. Fill it up at the valve and bring it back to me so we can continue.",
  },
  [27446] = {
    ["T"] = "The Perfect Container",
    ["O"] = "Acquire 6 Gnome Car Parts from the crashed Gnome racer west of Gadgetzan.",
    ["D"] =
    "The perfect fuel is useless if we don\'t have a reliable way to store it on the rocket. The best metallurgy around is done by the gnome racing crew at the Mirage Raceway, but sadly they won\'t share! Something to do with \"trade screts\" and \"stop trying to steal our stuff\", whatever.\n\nGossip has been spreading that one of their experimental cars crashed all the way out here in Tanaris. I want that car\'s metal! Find the crash just outside of Gadgetzan and bring its parts back by any means neccesary!",
  },
  [27447] = {
    ["T"] = "Even Better Fuel",
    ["O"] = "Collect a Mutated Basilisk Gland and 6 Glasshide Glands for Poole in Steamwheedle Port.",
    ["D"] =
    "Psst... over here... keep your voice down.\n\nLook, between you and me I think Goddard here is a bozo. Constantly pushing me around and bragging about how brilliant he is. I\'m tired of it! There can only be one chief rocket scientist; the budget doesn\'t allow for more. So... help me get rid of him and I\'ll treat you better than he does. Whaddya say?\n\nI\'m going to add some extra ingredients into the mix that will have catastrophic results when ignited. If you\'re willing to help, I need glands from the Glasshide Basilisks in the dunes. Those are a relatively normal component in fuel. The extra spark comes from a mutated one I\'ve seen nearby. I think the oil made it go all wonky! He\'s been seen patrolling the beaches south of here. Go get me his gland to add to the mix.\n\nAnd keep this between us or it\'s both our necks being rung outside Gadgetzan.",
  },
  [27448] = {
    ["T"] = "A Dangerous Mixture",
    ["O"] =
    "Combine the Rocket Fuel Ingredients at Narain\'s house and bring the Experimental Rocket Fuel back to Goddard in Steamwheedle Port.",
    ["D"] =
    "So now we get to actually mix everything. My nuisance of an assistant has bundled everything together for you, here, take it.\n\nThe only trouble is that this part of the process could be... explosive if done wrong. I\'ve been expressly forbidden from even attempting it within the Port\'s walls, so how about you mix this at the next nearest candidate location. Let me think... I know! That fool Narain\'s house outside of town to the north. He\'s constantly whining about our work here, and with this there\'s two possible outcomes.\n\nIf it\'s mixed properly, then nothing happens. If it isn\'t, well, the only thing that blows up is you and him. Win-win.",
  },
  [27449] = {
    ["T"] = "The Final Countdown",
    ["O"] = "Push the plunger next to Goddard and begin the rocket\'s take-off procedures.",
    ["D"] =
    "Now is the time $n! We finally test this rocket and see just how high a goblin can fly. Un-manned first, of course. Since you\'ve been such a great help, how about you do the honors, and push that plunger right next to me? That will begin the test.",
  },
  [27450] = {
    ["T"] = "A.S.S. Overhaul",
    ["O"] = "Bring Poole\'s Report to Kranz the founder of A.S.S. in Gadgetzan.",
    ["D"] =
    "He, he, he, that went perfectly! I bet they could see the rocket smoke all the way to Un\'Goro. Now the only thing I need to do is sow some seeds of doubt with our boss, and I\'ll have Goddard\'s job in a heartbeat.\n\nHere is a report I put together of what happened here. Bring this to Kranz, our organization\'s founder, and your work here is done.",
  },
  [27451] = {
    ["T"] = "Lorespeaker Vanza",
    ["O"] = "Find Lorespeaker Vanza at Anje\'watha in Tanaris.",
    ["D"] =
    "I could use a messenger to the desert, if ya be interested.\n\nDown in southern Tanaris you\'ll find the troll settlement of Anje\'watha. Lorespeaker Vanza went there weeks ago and hasn\'t sent back a progress report yet. If you\'re in the area and could bring me an update, I be thankin\' ya.",
  },
  [27452] = {
    ["T"] = "Dead Message",
    ["O"] = "Search the Tanaris coast for Lorespeaker Vanza\'s missing messenger.",
    ["D"] =
    "If Lorespeaker Jani didn\'t receive my reports then somethin\' must have happened to the messengers. I be fearin\' for their lives, mon.\n\nI told \'em both to take the coastal route -- avoids the silithid and the dust storms. Would ya search the coast and see if ya can find any trace of \'em? And be wary, $C.",
  },
  [27453] = {
    ["T"] = "Dead Message",
    ["O"] = "Return to Lorespeaker Vanza with the bad news.",
    ["D"] =
    "The dead troll\'s weapons are caked in humanoid blood. They put up quite a fight before they died. You notice some odd blackened skin on the corpse that doesn\'t appear to be from decay.\n\nYou inspect the body and find that their courier pouch is empty. Whatever message they were carrying has been looted, while other valuables were left behind.\n\nLorespeaker Vanza will need to know about this.",
  },
  [27454] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Collect 6 Tul\'Mari Tokens from Sandfury Trolls near Zul\'Farrak.",
    ["D"] =
    "I come to Tanaris searchin\' for the tomb of Tul\'Mari, an ancient troll hero from the days before the Sunderin\'. I believe the tomb is in Tanaris but the Sandfury claim Tul\'Mari as an ancestor too. They know where it is, and they don\'t want me to find it. I tried but I be failin\' to negotiate with them.\n\nThe black skin you saw on the corpse was Sandfury poison. If they be killin\' my messengers then I\'m gonna ask you to kill them! The Sandfury carry little tokens with the words of Tul\'Mari written on them. Since they wouldn\'t give me what I need in peace, I\'ll take it from them by force.",
  },
  [27455] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Ask Lorespeaker Gi\'hin in Orgrimmar to translate the Tul\'mari Tokens.",
    ["D"] =
    "<Lorespeaker Vanza sighs.>\n\nI shoulda known. These tokens be written in the ancient Sand Troll language, which I not be readin\'.\n\nLorespeaker Gi\'hin in Orgrimmar can read this though. Take the tokens to him and ask him what they say, please.\n\nYou\'ll find him in the Valley of Spirits, with the other Lorespeakers.",
  },
  [27456] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Kill Witchdoctor Zum\'rah in Zul\'Farrak and obtain his Charm Book for Lorespeaker Gi\'hin in Orgrimmar.",
    ["D"] =
    "I\'ll do this translatin\' for Vanza if you\'ll do me a little favor while I work on it. Since you be workin\' in Tanaris anyway, I want ya to pay a visit to my old friend Witch Doctor Zum\'rah in Zul\'Farrak.\n\nLong ago he stole an old recipe for a charm that I\'d like back. Since he won\'t be givin\' it up freely, kill him and bring me his Charm Book.\n\nThen I\'ll be givin\' you the translation.",
  },
  [27457] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Take the translation to Lorespeaker Vanza at Anje\'watha in Tanaris.",
    ["D"] =
    "Here is the translation Lorespeaker Vanza requested. I be thinkin\' it means more work for you. Ya see, it be sayin\' the tomb he\'s lookin\' for was buried beneath the waves during the Sunderin\'. And Vanza, he be afraid of de sea.\n\n<Lorespeaker Gi\'hin chortles.>\n\nFortunately, it says a magical barrier protects the tomb to keep the water out, so if ya find it, ya can breathe down there. Good luck, $C.",
  },
  [27458] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Find the Tomb of Tul\'Mari and recover the Hammer of Drek.",
    ["D"] =
    "Tul\'Mari was the champion of Drek and she inherited his hammer when he died. Accordin\' to the legends, the hammer was buried with her. That be what I\'m lookin\' for.\n\nBut this translation says the tomb was buried beneath the waves off the southern coast of Tanaris. I can\'t swim, $C, and I hate the sea.\n\nSearch the southern coastal waters for me and find the tomb, I beg ya.",
  },
  [27459] = {
    ["T"] = "The Search for the Tomb",
    ["O"] = "Deliver an update to Lorespeaker Jani in Thunder Bluff.",
    ["D"] =
    "Well, now ya can head back to Lorespeaker Jani in Thunder Bluff and give him a proper update.\n\nHe bet me I\'d not be findin\' the tomb. So now he owes me a big batch of his family\'s Junglevine Wine.\n\nBe off then, and watch out for de voodoo.",
  },
  [27460] = {
    ["T"] = "They Mostly Come At Night... Mostly",
    ["O"] = "Collect 10 Nightstalker Mandibles from Nightstalkers in Tanaris at night.",
    ["D"] =
    "The blasted silithid are causing trouble again. They\'ve been spotted sending their Nightstalkers to guard their territory in Tanaris. These beasts only come out at night, so you\'ll need to be careful if you want to track them down.\n\nYou can find the Nightstalkers at the Noxious Lair and the Gaping Chasm. The Noxious Lair is in the far northwest, and the Gaping Chasm is just outside Anje\'Watha.\n\nUse your strength and cunning to defeat them, and collect their mandibles as proof of your victory.",
  },
  [27461] = {
    ["T"] = "Think Of The Animals",
    ["O"] = "Clean 8 Oil-Coated Critters along the Tanaris coast.",
    ["D"] =
    "Ever since the goblins built that rig I\'ve been finding animals up and down the coast coated in oil from their spills. The wildlife is suffering and it breaks my heart to see them like this.\n\nCan you do something about it? I can\'t save them all. Here, take these cleaning supplies and aid any oil-covered beasts you come across.",
  },
  [27462] = {
    ["T"] = "Waste Removal",
    ["O"] = "Clean up 6 Oil Spills in the waters along the Tanaris coast.",
    ["D"] =
    "If we don\'t remove the barrels in the ocean that are leaking this oil, it won\'t matter how many critters we clean up.\n\nTake this oil absorber and head along the coast. Remove any oil spills you find. The more the better.\n\nCan you do that?",
  },
  [27463] = {
    ["T"] = "Desperate Measures",
    ["O"] = "Collect Marai\'s \"Supplies\" from her contact Buzzek Bracketswing in Gadgetzan.",
    ["D"] =
    "I\'m sick of this! I can already see new critters suffering and fresh barrels being dumped into the ocean. The Water Company won\'t help me since they have their fancy filter nonsense. If we want this pollution stopped we have to go to the real source...! That oil rig has to go... permanently.\n\nI reached out to a master engineer in Gadgetzan by the name of Buzzek and he has prepared some \"supplies\" for me. Can you go fetch them for me? They will be important for what is to come.",
  },
  [27464] = {
    ["T"] = "Oil Baron Beatdown",
    ["O"] = "Slay 8 Oil Rig Workers and their leader Overseer Looney at the Oil Rig north of Steamwheedle Port.",
    ["D"] =
    "The first step to taking down that oil rig is removing the rig workers. Their leader goes by the name Overseer Looney and he can be found right at the top of the rig in the control room.\n\nThe rest of the workers are just lackeys, but they don\'t care about making critters suffer for their own financial gain, so that\'s good enough for me. What kind of monster does that?",
  },
  [27465] = {
    ["T"] = "Sink The Rig",
    ["O"] = "Place 4 Explosives around Slightly-Open Oil Barrels on the oil rig north of Steamwheedle Port.",
    ["D"] =
    "And now for the ultimate solution to this little problem. Once the workers are dead it will be easy for you to plant these explosives near any open barrel. The resulting chain reaction will be catastrophic. Place them in as many places as you can so we can ensure that rig is never fit for use again.",
  },
  [27466] = {
    ["T"] = "Tips Of Fire",
    ["O"] = "Locate Melchor Bloodrunner at Anje\'Watha in Tanaris.",
    ["D"] =
    "I understand that you have recently discovered that Silithid Stingers can be crushed into a paste and used as a flammable weapon. This information could be valuable to our cause in the ongoing war against both the Alliance and the Silithid. I am asking for your help in delivering this information to a Forsaken named Melchor Bloodrunner. He can be found nearby, in a cave within Anje\'Watha.",
  },
  [27467] = {
    ["T"] = "Tips Of Fire",
    ["O"] = "Collect 8 Hazzali Wasp Stingers from Hazzali Wasps at the Gaping Chasm in Tanaris.",
    ["D"] =
    "Now that we know the potential of Silithid Stingers, I want to take this opportunity to explore them further. I have a new quest for you, $n. I want you to collect more of these stingers, but this time from the much stronger Hazzali Wasps. With a larger supply of the paste, we can create specialised fire arrows for our Horde troops in Tanaris. Can I count on you to help us with this?",
  },
  [27468] = {
    ["T"] = "Tips Of Fire",
    ["O"] =
    "Siphon Tar from Tar Beasts in Un\'Goro Crater using the item Melchor Bloodrunner provided. Tar Beasts must be in a weakened state.",
    ["D"] =
    "Now that we have the stingers, we must focus on making the fire arrows as potent as possible. I have devised a special container that can absorb tar straight from the core of Tar Beasts, but it requires that they be weakened and alive. It is a painful process, but sometimes science demands sacrifice. You can find the Tar Beasts at the Lakkari Tar Pits in nearby Un\'Goro Crater.",
  },
  [27469] = {
    ["T"] = "Tips Of Fire",
    ["O"] = "Bring the Fire Arrows to Remi Coldeye in Anje\'Watha.",
    ["D"] =
    "The fire arrows are complete, $n. And now it is time to put them to use. I want you to deliver them to Remi Coldeye, who will distribute them among our new recruits for use in battle against the Silithid.",
  },
  [27470] = {
    ["T"] = "Water Co. Savior",
    ["O"] = "Collect 8 Filter Parts from the seabed surrounding Steamwheedle Port.",
    ["D"] =
    "Steamwheedle Port is the heart of the Water Company empire, but right now we\'re running entirely on reserves because there\'s been some serious damage to the filtration system.\n\nWe were expecting a shipment of parts, but those lumbering oafs operating the crane knocked the majority of the crates off the boat when it was docking! Just can\'t get good talent these days!\n\nCan you dive down along the shore and get those parts before they\'re rusted beyond use?",
  },
  [27471] = {
    ["T"] = "A Workwoman\'s Tools",
    ["O"] =
    "Collect Kyx\'s Battery Boosted Welder from Razzeric at the Mirage Raceway in the Shimmering Flats of Thousand Needles.",
    ["D"] =
    "One of the things we were expecting from our shipment was a new powerful arc welder that I can use here. The second it touched the water, it was ruined, so I didn\'t even bother asking you to fish that up.\n\nI do have a spare that I loaned to a good buddy of mine who works for the Goblin Race Team at the Mirage Raceway. Could you go ask him for it? I\'m sure he won\'t be pleased to part with it, but our needs are greater than some race car.",
  },
  [27472] = {
    ["T"] = "A Workwoman\'s Tools",
    ["O"] = "Charge Kyx\'s Batteries using weakened Raging Tempests across the dunes of Tanaris.",
    ["D"] =
    "The only issue with this welder is that apparently Razzeric didn\'t keep it charged. Typical of him.\n\nOut in the Tanaris dunes there is a rare elemental that we\'ve taken to calling a Raging Tempest. They\'re chock full of extremely potent electricity! If we siphon that energy from them, then we can charge the welder\'s batteries rapidly.\n\nYou will have to weaken the Tempests first and then blast them with the charger. Before you know it we\'ll be on our way to some high quality H2O flowing through here again.",
  },
  [27473] = {
    ["T"] = "Water Injection",
    ["O"] = "Collect 8 Fuel Injectors from the downed Zeppelin near the Broken Pillar Ruins in the center of the dunes.",
    ["D"] =
    "Wait, wait, wait. Something is definitely off here. The water pressure is just nowhere near what we need. Let me think....\n\nI know! Southwest of here, at the Broken Pillar ruins, there\'s a mad scientist that we once employed. His zeppelin crashed nearby and it was carryinng some fuel injectors. With a little bit of tinkering, I can modify them to be water injectors. It\'s a bit of a trek, but could you go get them? The crash should be easy to spot once you\'re in the middle of the dunes.",
  },
  [27474] = {
    ["T"] = "A Saboteur In Our Midst",
    ["O"] = "Question Bruisers in Steamwheedle Port to find out who the Shadowy Figure is and where they went.",
    ["D"] =
    "A saboteur! It all makes so much sense now... they must have intentionally knocked our parts into the ocean! They were the ones who sabotaged the filter in the first place! But who could it be?\n\nI didn\'t quite see where they fled but that\'s what the Bruisers are paid for. Go and ask them what they saw.",
  },
  [27475] = {
    ["T"] = "Clear Accusations",
    ["O"] =
    "Inform Security Chief Bilgewhizzle at Steamwheedle Port of who you suspect damaged the water filtration system.",
    ["D"] =
    "So they all kept mentioning the same person, Doszard. Why does that name ring such a bell? A bruiser! He\'s one of the guards. It\'s an inside job! The security chief must be told of this. Go to him now!",
  },
  [27476] = {
    ["T"] = "Wanted: Doszurd",
    ["O"] = "Locate and slay Doszurd, the former Bruiser. He was reportedly seen just outside of Gadgetzan.",
    ["D"] =
    "Our agents have informed us that the traitor Doszurd has been spotted getting supplies from Gadgetzan and walking out of the gates. Wherever he is must be a short walk away. Find him and slay him on behalf of the Water Company. Report to the Security Chief when the deed is done.",
  },
  [27477] = {
    ["T"] = "Attack on the Gnarlpine",
    ["O"] =
    "Kill 4 Gnarlpine Shamans, 4 Gnarlpine Defenders, 4 Gnarlpine Ambushers, and 4 Gnarlpine Warriors, and then return to Melarith at Dolanaar in Teldrassil.",
    ["D"] =
    "The Gnarlpine tribe has been growing increasingly restless in their attacks against our people, and I\'m beginning to get worried. Do you think you could help us in our battle against them?\n\nYou can find members of their tribe scattered across Teldrassil, but scouts report that they gather just off the road west of here, and also near the Ban\'ethil Barrow Den. Go out and kill them, so I know our people will be safe.",
  },
  [27478] = {
    ["T"] = "Attack on the Gnarlpine",
    ["O"] = "Kill Agal, Nargle, and Greenpaw and return to Melarith at Dolanaar.",
    ["D"] =
    "The Gnarlpine will keep growing in number if we do not strike at their leadership. If they have no chiefs, they have no bear to follow. Their tribe will fall apart and wander away.\n\nThe first chief is Agal. He lives in a cave just north of the Ban\'ethil Barrow Den. The second and third chiefs, Nargle and Greenpaw, both live deep inside the barrow den. I would not go alone if I were you; the stronghold is very deep and it\'s easy to get lost.\n\nI wish you the best of luck in this task, $n. Stay safe, and bring about the end of the Gnarlpine.",
  },
  [27479] = {
    ["T"] = "Bloodfeather Eggs",
    ["O"] = "Collect 6 Bloodfeather Eggs and return to Alanna Raveneye at the Oracle Glade in Teldrassil.",
    ["D"] =
    "Have you seen the nearby Bloodfeather harpies? They have invaded this land but they are also magical, beautiful creatures.\n\nI study magic, and I think the eggs they lay could possibly possess magical properties. Do you think you could bring me some eggs so I can examine them?",
  },
  [27480] = {
    ["T"] = "Corruption in Shadowglen",
    ["O"] = "Kill Natook and 8 Frenzied Moonkin, then return to Alanea Miststriker at Aldrassil in the Shadowglen.",
    ["D"] =
    "A moonkin colony has taken residence in Shadowglen! We have nothing against moonkin, in fact many are our allies, but this colony has lost touch with Elune and is causing havoc across the forest.\n\nIt is my belief that something has corrupted these moonkin, making them unruly and chaotic.\n\nThe colony has taken over a furbolg camp to the east of here. Please kill their leader and disperse the rest of them before they cause serious damage to the balance of nature here in Shadowglen!",
  },
  [27481] = {
    ["T"] = "Journeyman Tiger Riding",
    ["O"] = "Learn Journeyman Riding from Jartsam, then speak to Lelanai in Darnassus to claim your saber.",
    ["D"] =
    "Welcome back. You\'re here to learn Journeyman riding, correct? As before, the price of your saber has been covered, but you will have to pay the cost of training. Swift riding is expensive, I am sorry to say.\n\nSpeak to Lelanai just beside me after you have acquired training. She handles the sale of our sabers. If you do not have the funds yet, you may return at any time.",
  },
  [27482] = {
    ["T"] = "Saber Riding",
    ["O"] = "Learn Apprentice Riding from Jartsam, then speak to Lelanai in Darnassus to claim your saber.",
    ["D"] =
    "So you\'re here for a saber are you? It just so happens that I was expecting you! A mysterious benefactor left us payment for a simple saber and it is addressed to you by name, $N. However they did not pay for your training, so I am afraid you will still have to purchase that.\n\nSpeak to Lelanai just beside me after you have acquired training. She handles the sale of our sabers. If you do not have the funds yet, you may return later.",
  },
  [27483] = {
    ["T"] = "Demons In Fel Rock",
    ["O"] = "Collect 10 Demonic Essence from Fel Rock and return to Jeena Featherbow in Dolanaar.",
    ["D"] =
    "Greetings, how nice to see a new $c in Dolanaar. I assume you\'ve heard of the recent corruption occuring in Teldrassil?\n\nDemons have invaded these lands, and some of our scouts report that a large concentration of them is located in a cave called Fel Rock, just north of here.\n\nCan you kill them and bring me their demonic essence so we can purify it?",
  },
  [27484] = {
    ["T"] = "Purifying the Essence",
    ["O"] = "Purify the Demonic Essence at the moonwell in Dolanaar and return to Jeena Featherbow.",
    ["D"] =
    "Demonic essence binds the demon to the plane they are summoned on, so if we are to remove their spirits from this world, we must purify it.\n\nThere are many moonwells across night elf territory, but the closest one is right here in Dolanaar. Go to the moonwell and purify this essence, so their spirits will be banished from Azeroth forever.",
  },
  [27485] = {
    ["T"] = "Herbal Medicine",
    ["O"] = "Gather 8 Lily Whips from the Pools of Arlithrien and return to Malorne Bladeleaf at Dolanaar in Teldrassil.",
    ["D"] =
    "Many think that herbs are only used for potions that cause harm, but herbs were used for medicine first. You never know when an owl will go rabid and strike an ally, so it\'s always a good idea to have medicine on hand.\n\nIf you bring me some of the Lily Whips from the Pools of Arlithrien far to the west, I can make some medicine for you. Maybe I\'ll even teach you how to make something for yourself, if I like your samples.",
  },
  [27486] = {
    ["T"] = "호박석 기념품",
    ["O"] = "호박석 기념품의 수수께끼를 푸십시오.",
    ["D"] =
    "먼지발굽 족장의 방황하는 영혼에게서 얻은 이 부적은 겉보기엔 그다지 특별해 보이지 않습니다. 금속은 변색되었고 세공된 자리에 호박석 한 조각이 대충 박혀 있는 낡은 청동 펜던트입니다.\n\n이 장신구가 얼마나 오래되었는지, 혹은 가치가 얼마나 되는지는 알 수 없습니다. 이 물건을 조사하자 차가운 돌풍이 당신을 스치며 소금 평원의 북쪽 가장자리 방향으로 당신을 손짓합니다.\n\n한번 조사해 보는 게 어떨까요?",
  },
  [27487] = {
    ["T"] = "영혼의 모임",
    ["O"] = "잊혀진 땅의 해안에서 그물잎사귀 8묶음을 모으십시오.",
    ["D"] =
    "아주 오래전, 우리 부족은 마샨쉬의 초원을 여행했지만 그 지역에 재앙이 닥쳐 생명력이 없고 메마른 땅이 되었습니다. 우리 부족은 먼지발굽 족장의 인도하에 지금은 잊혀진 땅이라 불리는 그 황무지를 떠났습니다. 그는 남쪽 사막을 넘어, 켄타우로스와 엘프의 땅 훨씬 너머에 푸르고 길들여지지 않은 땅이 있을 것이라는 희망을 품고 있었습니다.\n\n우리는 여행 준비가 덜 되어 있었고, 먼지발굽 족장님은 소금 평원을 건너던 중 돌아가셨습니다. 족장님이 돌아가시자 부족의 나머지는 뿔뿔이 흩어졌습니다. 많은 이들이 사막의 더위와 야수들의 먹이가 되었지요. 이 지역을 배회하는 그들의 영혼 일부를 보셨을 겁니다.\n\n비록 영혼의 모습일지라도 부족으로서 다시 한번 그 땅을 걷기 위해서라면, 우리는 이 여행을 해낼 수 있다고 믿습니다. 하지만 $c, 당신이 우리를 도와주셔야 합니다.\n\n당신은 산 자들의 세계로 돌아가 잊혀진 땅으로 여행해야 합니다. 해안을 따라 그물잎사귀를 모아주십시오. 충분히 모았다면 이리 돌아와서 이 토템에 불을 지피는 데 사용하십시오. 과거에 우리는 의식을 치를 때 그물잎사귀를 향으로 사용했습니다. 먼지발굽 족장님과 우리 형제들의 영혼이 그 냄새를 알아볼 것입니다.\n\n대지모신께서 당신의 앞길을 인도하시길, 친구여.",
  },
  [27488] = {
    ["T"] = "먹구름 같은 나쁜 소식",
    ["O"] = "먹구름 봉우리에서 세 개의 비밀 쪽지를 찾아 회수하십시오.",
    ["D"] =
    "켄타우로스, 타우렌, 그리고 이따금 지나가는 고블린 짐마차를 제외하면 버섯구름 봉우리에서는 여행자를 보기 드뭅니다. 하지만 특히 제 우려를 끄는 무리가 하나 있습니다.\n\n그림토템 부족과 접촉하는 수상한 자들이 목격되었습니다. 두건을 쓰고 있어서 정체를 파악할 수는 없었지만, 그들이 호드의 일원인지 의심스럽습니다.\n\n그림토템이 무엇을 꾸미고 있는지 모르겠지만 절대 좋은 일일 리가 없습니다. 아주 큰 위험이라는 건 알지만, 당신이 먹구름 봉우리에 있는 그들의 마을에 잠입해주셨으면 합니다. 그 요원들과 그림토템 부족 사이의 협력을 설명할 수 있는 문서나 메시지 등 그 어떤 단서라도 찾아봐 주십시오.",
  },
  [27489] = {
    ["T"] = "협곡 정찰",
    ["O"] = "모테가 파이어메인은 당신이 버섯구름 봉우리에서 점박이하이에나 8마리를 처치하기를 원합니다.",
    ["D"] =
    "잔인한 청소부라는 평판에도 불구하고, 이 땅의 하이에나들은 유능한 사냥꾼입니다. 그들은 대지모신의 생명의 순환의 일부이며, 불모의 땅의 사자나 멀고어의 거대한 코도 야수 못지않게 중요합니다.\n\n불행히도, 이것은 버섯구름 봉우리를 여행하는 이들에게 그들을 위험한 존재로 만듭니다. 제 부탁을 하나 들어주시고, 그들의 수를 좀 줄여주시겠습니까?",
  },
  [27490] = {
    ["T"] = "바위표범 추적",
    ["O"] = "모테가 파이어메인은 당신이 버섯구름 봉우리에서 바위표범 6마리를 처치하기를 원합니다.",
    ["D"] =
    "버섯구름 봉우리에 존재하는 위험이 하이에나뿐만이 아닙니다, $n. 눈에 보이는 위협과 보이지 않는 위협 모두에 직면할 준비가 항상 되어 있어야 합니다.\n\n바위표범들은 위장의 전문가들이라 일반 퓨마보다 훨씬 위협적입니다. 길을 벗어날 만큼 어리석은 자들은 이 사실을 곧 직접 깨닫게 되죠.\n\n당신은 어리석은 자가 아니니, 그들과 맞서기 위해 협곡 깊숙이 들어가야 할 겁니다. 경계를 늦추지 마십시오, $c. 우리는 당신을 믿고 있습니다.",
  },
  [27491] = {
    ["T"] = "운전 면허 승인",
    ["O"] = "경주로관리인 제린, 경주진행자 크론크라이더, 래저릭, 그리고 위즐 브라스볼츠에게 애원하고 간청하여 신기루 경주장 면허증을 얻으십시오.",
    ["D"] =
    "신기루 경주장에 참가하고 싶다면, 이 지역의 핵심 인물들로부터 정식 승인을 받아야 합니다. 경주진행자 크론크라이더가 최고 책임자이지만, 그 혼자서 승인할 수는 없습니다. 각 팀 대표의 승인이 필요하죠. 노움 팀의 위즐 브라스볼츠와 고블린 팀의 래저릭 말입니다. 그리고 마지막으로 경주로관리인 제린이 큰 영향력을 가지고 있습니다.\n\n이곳에서 경주자들의 자존심만큼 거대한 것은 없으니, 그들에게 애원하고 간청하면 당신을 위한 정식 청원이 승인되어 경주장에 나갈 수 있을 거라 확신합니다.",
  },
  [27492] = {
    ["T"] = "신선한 물 배달",
    ["O"] = "신기루 경주장 주변 감시탑에 있는 경주 감독관들에게 시원하게 톡 쏘는 신선한 물 10개를 배달하십시오.",
    ["D"] =
    "경주장 주변에는 감독관이라고 불리는 경주 심판들이 머무는 4개의 탑이 있습니다. 감독관들은 뜨거운 태양 아래 그곳에 앉아 경주를 모니터링하며 부정행위와 외부 개입을 허용 가능한 수준으로 유지합니다. 경주를 중단시킬 충돌이 발생하면 그들이 이곳으로 알려주지요.\n\n이 시원하게 톡 쏘는 신선한 물을 좀 가져다주면 무언가 잘못되었을 때 그들이 조금 더... 상냥해질지도 모릅니다. 어때요?",
  },
  [27493] = {
    ["T"] = "시상대 입상",
    ["O"] = "신기루 경주장 이벤트 동안 시상대 1, 2, 3위 안에 드십시오.",
    ["D"] =
    "경주에 나가면 당신은 우리 고블린 경주팀을 대표하게 될 겁니다. 당신에게 최고를 기대하고 있으니 이렇게 합시다. 경주가 끝날 때 시상대 3위 안에 든다면 특별한 선물을 주겠소. 어때요? 자, 이제 나가서 고무 좀 태워봐요!",
  },
  [27494] = {
    ["T"] = "시상대 입상",
    ["O"] = "신기루 경주장 이벤트 동안 시상대 1, 2, 3위 안에 드십시오.",
    ["D"] =
    "경주에 나가면 당신은 우리 노움 경주팀을 대표하게 될 겁니다. 당신에게 최고를 기대하고 있으니 이렇게 합시다. 경주가 끝날 때 시상대 3위 안에 든다면 특별한 선물을 드릴게요. 어때요? 자, 이제 나가서 고무 좀 태워봐요!",
  },
  [27495] = {
    ["T"] = "독사의 이빨",
    ["O"] = "치명적인 맹독 샘 10개를 모테가 파이어메인에게 가져가십시오.",
    ["D"] =
    "버섯구름 봉우리는 위험으로 가득합니다, 친구. 켄타우로스뿐만 아니라 토착 야생동물들 때문이기도 하죠. 제 경고를 귀담아듣지 않은 여행자들의 부상을 너무나 많이 치료해야 했습니다.\n\n구름천둥매의 물림은 특별한 관리가 필요한데, 특히 그들의 맹독이 문제입니다. 그들의 독으로 만든 해독제만이 그 영향을 완전히 중화시킬 수 있는데, 지금 물자가 부족합니다.\n\n당신이 목숨을 거는 것을 원치 않지만, 구름천둥매에게서 맹독 샘을 조금 구해다 준다면 후하게 보상하겠습니다.",
  },
  [27496] = {
    ["T"] = "꿰매기 재료",
    ["O"] = "먼지가 쌓인 가죽 10개를 버섯구름 봉우리의 탈라나르에 있는 렌도우에게 가져가십시오.",
    ["D"] =
    "실례지만, 시간 좀 내주시겠습니까? 방어구 수리에 쓸 재료가 다 떨어져 가는데, 켄타우로스들의 최근 공격 이후로 이곳을 지나는 대상이 있을 거라 기대하지 않습니다. 버섯구름 봉우리를 배회하는 야수들에게서 신선한 가죽이 좀 필요합니다.\n\n어떤 동물에게서 모으든, 가죽의 질이 어떠하든 크게 까다롭게 굴지는 않겠지만, 10조각을 모아 오시면 후하게 쳐드리겠습니다.",
  },
  [27497] = {
    ["T"] = "갈라크를 향한 반격",
    ["O"] = "대장군 블리쉬를 찾아 처치하고 그의 머리를 높새바람 봉우리의 절벽파수꾼 롱혼에게 가져가십시오.",
    ["D"] =
    "그 겁쟁이 녀석...! 그렇게 내 머리를 원한다면... 그가 직접 이곳으로 와야만 기회를 얻을 수 있을 것이다.\n\n대장군 블리쉬는 북쪽에 야영지를 차리고 우리 야영지와 대상을 공격하기 위해 군대를 보내고 있다. 그가 직접 나를 죽이러 오는 대신 거기에 숨어 있는 것이 놀랍지도 않군.\n\n있지, 높새바람 봉우리는 당신이 그의 죽음을 증명해 준다면 기뻐할 것이다.",
  },
  [27498] = {
    ["T"] = "칸 아블린",
    ["O"] = "칸 아블린을 찾아 처치하고 그의 머리를 높새바람 봉우리의 절벽파수꾼 롱혼에게 가져가십시오.",
    ["D"] =
    "에톡 야영지의 대장군은 죽었지만, 그들의 지도자인 칸 아블린이 새 대장군을 임명하는 것은 시간문제일 뿐이다. 바로 지금 쳐야 해!\n\n칸은 북쪽의 켄타우로스 야영지에 거주하며 다음 계획을 꾸미고 있다. 그를 추적해, $c. 그를 베고 야영지를 혼란에 빠뜨려라.",
  },
  [27499] = {
    ["T"] = "평원의 유령",
    ["O"] = "먼지발굽 족장의 영혼을 처치하십시오.",
    ["D"] =
    "이봐, 당신 영웅 타입 같아 보이는군. 시간 좀 있어?\n\n우리 차들 중 일부가 갑자기 길을 이탈해서 궤도 밖으로 추돌하는 일들이 발생하고 있어. 무슨 생각하는지 알지만, 이번만큼은 고블린 기술이 폭발한 게 아니라고 믿어줘. 노움 녀석들이 우리 엔진을 건드린 줄 알았는데, 알고 보니 그쪽 경주자들도 이 일을 겪고 있다지 뭐야.\n\n“이게” 뭐냐고 묻고 싶겠지? 생존자 중 한 명이 경주장 동쪽에서 먼지 묻은 코트를 입은 어떤 타우렌 족장 유령이 배회하는 걸 봤다고 하더군. 노움들은 신기루라고 하지만, 난 신기루가 경주장에 들어와서 사람을 너무 놀라게 해 차량 통제력을 잃게 만들진 않을 거라 생각해!\n\n날 위해 이 일을 좀 조사해 줘. 친구들을 데려와도 좋으니, 그 유령 영감을 길에서 치워버리라고!",
  },
  [27500] = {
    ["T"] = "신성한 불꽃",
    ["O"] = "버섯구름 봉우리의 갈라진발굽 벼랑을 시작으로 켄타우로스 유물의 위치를 정찰하십시오. 그것을 발견하면 탈라나르의 팔핀델 웨이워더에게 귀환하십시오.",
    ["D"] =
    "이 지역 켄타우로스들에 대한 소문을 들었습니다. 갈라크 부족이 켄타우로스 탄생 시대의 유물을 지키고 있다고 하더군요.\n\n정확히 무엇인지는 모르겠지만, 켄타우로스의 기원에 대해 어떤 빛을 던져줄 수 있을 거라 믿습니다. 안타깝게도 우리는 그 유물의 행방을 전혀 모르고, 갈라크가 그렇게 쉽게 위치를 밝히진 않을 겁니다.\n\n가장 큰 갈라크 정착지는 협곡 더 깊숙한 곳의 갈라진발굽 벼랑에 있습니다. 단서를 찾기 위해 그곳을 수색해보는 걸 추천하지만, 켄타우로스조차도 그렇게 귀중한 것을 야외에 그냥 두지는 않을 것 같군요.",
  },
  [27501] = {
    ["T"] = "신성한 불꽃",
    ["O"] = "팔핀델 웨이워더를 위해 갈라진 발굽을 회수하십시오.",
    ["D"] =
    "이 유리병을 받아, 여기 달샘에서 채워 주십시오. 제 추측이 맞다면, 달샘의 물을 사용하여 불꽃을 끄고 발굽을 회수할 수 있을 겁니다. 영원히 꺼지는 것은 아니니 서둘러야 할 것입니다.\n\n갈라진발굽 벼랑으로 돌아가 갈라진 발굽을 회수해 주십시오. 켄타우로스와 드리아드는 비슷한 혈통을 공유하는 것 같고, 이 발굽이 그것과 연결되어 있을 거라 확신합니다.",
  },
  [27502] = {
    ["T"] = "타혼다 야영지의 비극",
    ["O"] = "마모된 토템을 높새바람 봉우리의 누군가에게 가져가십시오. 그들은 폐허가 된 야영지에 대해 더 알고 있을지도 모릅니다.",
    ["D"] =
    "당신 손에 있는 타우렌제 토템은 뚜렷한 마모의 흔적을 보여줍니다. 바실리스크가 물어뜯은 자국이 토템을 덮고 있고, 벗겨지지 않은 페인트도 심하게 변색되었습니다. 이 모든 것에도 불구하고, 이것은 폐허가 된 야영지에 남은 몇 안 되는 물건 중 하나이며, 타우렌에게 가치가 있을지도 모릅니다.\n\n높새바람 봉우리에 타혼다 폐허와 그 운명에 대해 더 잘 아는 사람이 있을 수 있습니다. 토템을 팔아 금화를 조금 챙길 수도 있겠네요.",
  },
  [27503] = {
    ["T"] = "아 슬프도다 와이번",
    ["O"] = "버섯구름 봉우리의 마루둥지에서 크리스티의 고양이 코디를 구출하십시오.",
    ["D"] =
    "$C, 제발 절 도와주세요!\n\n우리 악마 같은 고양이 코디가... 납치당했어요! 제가 잠시 이동장 문을 열어둔 사이에 사막으로 뛰쳐나가 버렸어요! 제가 잡기도 전에 와이번 하나가 휙 날아와 우리 불쌍한 코디를 낚아채 갔다고요! 자기네 새끼인 줄 알았던 게 틀림없어요!\n\n코디의 이동장을 가지고 마루둥지에 있는 와이번의 보금자리로 올라가 주세요. 제발 조심하시고요! 거기 와이번들은 사납다고 들었어요. 우리 꼬마가 다치는 건 원치 않아요!\n\n제발 $c, 서둘러요!",
  },
  [27504] = {
    ["T"] = "크리스티의 배달 서비스",
    ["O"] = "잊혀진 땅의 스퀴글코드 전초기지에 있는 넬라에 스카이문에게 코디를 데려다주십시오.",
    ["D"] =
    "글쎄요, 코디는 그 작은 모험 이후로 괜찮아 보입니다. 조금 떨고는 있지만, 그 외에는 다치지 않았어요. 그저 녀석이 계속 문제를 일으키는 걸 보면 코디를 더 이상 탈라나르 주변에 둬도 될지 모르겠어요.\n\n괜찮으시다면, 이 녀석을 조금 더 살펴보다가 제 친구에게 데려다주시겠어요? 넬라에 스카이문은 잊혀진 땅의 스퀴글코드 전초기지 쪽에 살고 있어요. 그녀는 온갖 종류의 고양이들에게 아주 다정한 사람이니, 분명 기꺼이 코디를 돌봐줄 거예요.\n\n잊혀진 땅은 여기서 걷기엔 좀 멀지만, 당신이 여태 겪은 일을 생각하면 그 정도는 문제도 아닐 거예요!",
  },
  [27505] = {
    ["T"] = "고단백 식단",
    ["O"] = "서부 역병지대의 청소부 독수리 둥지에서 썩은알 12개를 모아 운고로 분화구 늪지대의 모르벡에게 가져가십시오.",
    ["D"] =
    "보통 어린 라바사우루스는 부모가 둥지로 가져온 시체에서 먹이를 찾고 스스로 사냥하는 법을 빨리 배우지 않으면 굶어 죽습니다. 제가 이 공룡들을 탈것으로 길들이고 있기 때문에, 그들은 더 균형 잡힌 아침 식사를 하게 됩니다.\n\n알은 훌륭한 단백질원이지만, 현지에서 조달하여 먹이고 싶지는 않습니다. 운고로의 공룡 개체 수는 추가 알을 채집하기에는 너무 불안정하거든요. 스컬지가 휩쓸고 지나간 이후 서부 역병지대의 독수리 개체 수가 통제할 수 없을 정도로 급증했다고 들었습니다. 그곳의 알들은 거대해서 엄청난 식욕을 달래주기에 완벽하다고 합니다.\n\n서부 역병지대로 가서 알 12개를 모아주시겠습니까? 청소부 독수리가 배회하는 곳 근처에서 찾을 수 있을 겁니다.",
  },
  [27506] = {
    ["T"] = "배고픈 새끼들",
    ["O"] = "운고로 분화구 공포의 터 근처에 있는 스테고돈에게서 신선한 공룡 고기 10개를 모으십시오.",
    ["D"] =
    "제가 돌보는 라바사우루스 새끼들을 위해 균형 잡힌 식단을 유지하고는 있지만, 녀석들을 튼튼하게 유지하는 데에는 신선한 고기만 한 게 없습니다.\n\n분화구 남서쪽 구석에서 스테고돈이라는 강력한 공룡들을 찾을 수 있을 겁니다. 녀석들의 고기는 특히 두껍고 즙이 많아 어린 라바사우루스의 식욕을 만족시키기에 제격이죠!\n\n저를 위해 녀석들에게서 고기 10덩이를 구해다 주시겠습니까?",
  },
  [27507] = {
    ["T"] = "힘을 위한 힘",
    ["O"] = "아즈샤라의 검은아귀 마을에 있는 상인 말루에게 붉은색, 노란색, 푸른색, 녹색 마력의 수정 각 5개씩을 검은아귀 의식의 토템과 교환하십시오. 토템을 운고로 분화구의 모르벡에게 가져오십시오.",
    ["D"] =
    "토르와 패스파인더에게서 들은 새로운 훈련 기술을 시도해보고 싶습니다. 그는 아즈샤라 위쪽에 검은아귀 펄볼그라는 부족에 대해 말해주었습니다. 그들은 야수가 조련사를 신뢰하도록 돕는 진정 토템을 만든다고 하는데, 제게 하나 가져다주셨으면 합니다.\n\n토르와가 말하길 그런 물건을 얻는 데 단순한 동전은 충분치 않을 거라고 합니다. 물물교환이 필요하죠. 토템이 힘을 상징하므로, 같은 힘끼리의 교환이 통하지 않을까요?\n\n운고로 전역에서 자라나는 마력의 수정을 색깔별로 다섯 개씩 모아 북아즈샤라에 있는 마을로 가서 거래로 받아줄지 확인해 보십시오.",
  },
  [27508] = {
    ["T"] = "연구 구출",
    ["O"] = "어떤 라바사우루스에게서든 연구 노트를 10개 모아 운고로 분화구 마샬의 야영지에 있는 윌리덴 마샬에게 가져가십시오.",
    ["D"] =
    "오 안 돼, $N! 장비와 함께 있던 우리 연구 노트가 전부 사라졌습니다.\n\n보관함이 망가진 걸 보니 당신이 오기 전에 운고로의 랩터들이 먼저 손을 댄 것 같군요. 그 노트들은 지금 어디 있을지 모릅니다.\n\n분화구 랩터 서식지 근처를 탐험하시다가 우리 노트를 발견하신다면, 좀 돌려주시겠습니까? 모르긴 해도... 녀석들이 노트를 가지고 있는지 확인하려면 몇 마리는 처치해야 할 겁니다.",
  },
  [27509] = {
    ["T"] = "운고로 사냥",
    ["O"] = "스파인스케일을 처치하고 그의 머리를 운고로 분화구 마샬의 야영지에 있는 S.J. 얼가딘 주니어에게 가져오십시오.",
    ["D"] =
    "마샬 원정대에 편승해 운고로 분화구에 왔지만 아무래도 내 능력을 벗어난 곳 같아요. 날 좀 도와줄 수 있나요?\n\n우리 부모님은 대단한 사냥꾼들이라, 저도 운고로에 와서 제가 사냥할 준비가 되었다는 걸 보여주고 싶었거든요.\n\n솔직히 여기 너무 무서워서 집에 가고 싶어요. 하지만 빈손으로 돌아가면 평생 놀림을 당할 거예요. 제가 전설을 세울 수 있도록 기념이 될 만한 야수를 좀 사냥해 주시겠어요?\n\n분화구 북쪽 능선의 거대한 바위 근처에 스파인스케일이라는 육중한 디메트로돈이 산다고 들었어요. 그 녀석의 머리를 전리품으로 가져다주세요. 보상은 톡톡히 할게요!",
  },
  [27510] = {
    ["T"] = "운고로 사냥",
    ["O"] = "테러윙을 처치하고 그 머리를 운고로 분화구 마샬의 야영지에 있는 S.J. 얼가딘 주니어에게 가져오십시오.",
    ["D"] =
    "마샬 원정대가 처음 분화구에 진입했을 때 홀라니에가 강철바위 고원이라 부르는 곳을 지나쳤어요. 비행 야수 무리가 있었고 그중 하나는 다른 것들보다 훨씬 크고 사나워 보였죠. 우리는 녀석을 테러윙이라고 불렀습니다.\n\n테러윙을 찾아 머리를 가져다줄 수 있나요? 이거라면 부모님도 틀림없이 감명받을 만한 전리품이 될 거예요.",
  },
  [27511] = {
    ["T"] = "운고로 사냥",
    ["O"] = "스테고돈을 처치하고 그 머리를 운고로 분화구 마샬의 야영지에 있는 S.J. 얼가딘 주니어에게 가져오십시오.",
    ["D"] =
    "페트라 그로센은 이전에 운고로를 여행한 적이 있는데, 분화구 남서쪽 어딘가에 거대한 융기 골판을 가진 거대한 야수가 있다고 말해줬어요. 무척이나 위험하다고 하니 그걸 죽인다면 더욱 인상적이겠죠.\n\n바로 이겁니다 $N! 이 \"스테고돈\"의 머리를 가져다주시면 보수를 두 배로 드리겠습니다.",
  },
  [27512] = {
    ["T"] = "운고로 사냥",
    ["O"] = "데빌사우루스를 처치하고 그 머리를 운고로 분화구 마샬의 야영지에 있는 S.J. 얼가딘 주니어에게 가져오십시오.",
    ["D"] =
    "이 근처 능선으로 올라가 정상에 다다랐을 때 땅이 흔들리는 걸 느꼈어요. 랩터 같지만 열 배는 더 큰 거대한 괴물이 걸어 지나가더라고요! 페트라가 말하길 그놈들은 데빌사우루스라고 불리며 오직 이곳 운고로 분화구에서만 발견된다고 하더군요.\n\n내 수집품을 위해 그놈 머리 하나가 꼭 필요해요. 우리 부모님이 가져오셨던 어떤 것보다도 대단할 거예요. 제발, $N, 날 위해 데빌사우루스를 잡아서 머리를 가져다줘요!",
  },
  [27513] = {
    ["T"] = "쉬즐의 개조된 비행기",
    ["O"] = "운고로 분화구 마샬의 야영지에 있는 쉬즐에게 스테고돈 골판 3개를 모아주십시오.",
    ["D"] =
    "당신이 그 얼가딘 녀석과 이야기하는 걸 우연히 듣게 됐지 뭐야. 생각해 봤는데, 이 비행기에 폼을 좀 더하려면 필요한 게 하나 더 있어. 바로 비행기 중앙부를 덮을 질기고 튼튼한 골판이지. 불안정한 럼주를 흘렸을 때 훌륭한 받침대 역할을 해줄 거야.\n\n스테고돈을 사냥하러 갈 거라면, 실험해 보게 몇 개만 구해다 줄 수 있어? 세 개면 충분해!",
  },
  [27514] = {
    ["T"] = "쉬즐의 호화 비행기",
    ["O"] = "운고로 분화구 마샬의 야영지에 있는 쉬즐에게 데빌사우루스 가죽 1개를 모아주십시오.",
    ["D"] =
    "그래서 그 꼬마가 데빌사우루스를 잡아달라고 했다고? 글쎄, 그런 녀석을 쫓아갈 거라면, 내 비행기 내부를 꾸밀 멋진 가죽이 필요할 텐데. 최고급 가죽을 얻으려면 진짜 가죽세공사가 필요하겠지만, 아무 모험가나 대충 쓸만한 껍질은 벗겨다 줄 수 있잖아.\n\n오오, 상상만 해봐. 내후성도 뛰어나고 멋까지 나잖아!\n\n어때?",
  },
  [27515] = {
    ["T"] = "실리더스 간식",
    ["O"] = "실리더스에 있는 미늘벌레에게서 모래벌레 고기 5개를 가져와 운고로 분화구 늪지대의 모르벡에게 주십시오.",
    ["D"] =
    "제가 훈련하는 라바사우루스들은 결국 주인을 따라 전 세계를 여행하게 될 것입니다. 녀석들이 적응하는 것을 돕기 위해 저는 다양한 고기를 먹이도록 신경 쓰고 있습니다.\n\n서쪽에는 실리더스라는 위험한 땅이 있습니다. 이 불모지를 배회하는 거대한 미늘벌레들은 맹독가죽 새끼들이 먹던 것과는 완전히 다른 맵고 건조한 고기를 가졌습니다. 녀석들이 자랄 때 이것을 식단에 포함시키고 싶습니다.\n\n이 미늘벌레들에게서 고기 다섯 덩이를 모아주십시오. 하지만 경고하건대 녀석들은 강력한 적이라 쓰러뜨리기 위해선 일행이 필요할지도 모릅니다.",
  },
  [27516] = {
    ["T"] = "뽀드득 깨끗하게",
    ["O"] = "모르벡의 청소용 양동이를 사용하여 골락카 간헐천에서 물을 길어, 식기 전에 근처에 있는 어린 맹독가죽 라바사우루스를 씻기십시오.",
    ["D"] =
    "제 근처에 있는 어린 맹독가죽 라바사우루스가 보이십니까?\n\n이 녀석은 운고로의 진흙탕 강을 첨벙거리며 걷는 걸 좋아하는데, 먹이를 죽인 후 아직 발톱에서 피를 닦아내는 법을 배우지 못했습니다. 이 어린 아가씨를 목욕시켜줄 시간입니다!\n\n이 양동이를 분화구 반대편에 있는 골락카 간헐천으로 가져가 뜨거운 물을 채워오십시오. 이리로 돌아와 물이 식기 전에 박박 씻겨주십시오.",
  },
  [27517] = {
    ["T"] = "폭풍, 대지, 바람 그리고 불",
    ["O"] = "송진 정령 6마리를 약화시키고 대지의 힘을 야루니 플레임워처의 토템에 흡수시키십시오.",
    ["D"] =
    "대지 고리회를 대신해 인사드립니다, $R. 저는 원시 정령들을 연구하고 있는데, 혹시 절 도와주실 수 있으신가요?\n\n이 토템에 운고로의 각 정령력의 정수를 담고 싶지만, 악령숲에서 여러 해를 보내고 나니 잔류하는 지옥 마력으로 정수들을 오염시킬까 두렵습니다. 저 대신 정수를 수집해 줄 사람이 필요합니다. 정령들을 약화시킨 뒤, 토템을 사용하여 그들의 원시 정수를 포획하기만 하면 됩니다.\n\n락카리 진흙 구덩이 주변의 송진 정령들, 즉 원시 대지의 힘부터 시작하시면 됩니다.",
  },
  [27518] = {
    ["T"] = "폭풍, 대지, 바람 그리고 불",
    ["O"] = "바람의 정령 6마리를 약화시키고 바람의 힘을 야루니 플레임워처의 토템에 흡수시키십시오.",
    ["D"] =
    "대지는 무겁고 끈적이며 밀도가 높습니다. 우리는 그 반대인 바람으로 넘어갈 것입니다.\n\n바람의 정수는 운고로 주변 산맥에 숨어 있습니다. 북동쪽과 남서쪽으로 언덕과 계곡을 오르며 분화구 가장자리 주변에서 녀석들을 찾아야 합니다.\n\n과정은 동일합니다. 녀석들을 약화시키고 토템으로 정수를 차지하십시오.",
  },
  [27519] = {
    ["T"] = "폭풍, 대지, 바람 그리고 불",
    ["O"] = "불의 정령 6마리를 약화시키고 불의 힘을 야루니 플레임워처의 토템에 흡수시키십시오.",
    ["D"] =
    "바람은 산들거리고 가볍고 더 밝은 에너지인 불꽃 같은 것에 쉽게 밀려납니다.\n\n불은 운고로에서 쉽게 눈에 띕니다. 분화구 중앙의 불기둥 마루는 타오르는 정령들로 우글거립니다.\n\n탁 트인 용암 웅덩이와 그들의 지도자인 불바람 주변에서는 조심하십시오. 녀석은 우리 연구 대상이 아닙니다.\n\n다른 정령들은 약화시킨 후 토템에 흡수시켜도 좋습니다.",
  },
  [27520] = {
    ["T"] = "폭풍, 대지, 바람 그리고 불",
    ["O"] = "물의 정령 6마리를 약화시키고 물의 힘을 야루니 플레임워처의 토템에 흡수시키십시오.",
    ["D"] =
    "마지막으로 서쪽으로 가셔야 합니다. 골락카 간헐천에는 거칠고 회복력이 빠른 생명체인 물의 정령들이 살고 있습니다.\n\n<야루니 플레임워처가 당신을 위아래로 훑어봅니다.>\n\n당신이라면 녀석들을 처리할 수 있을 거라 확신합니다.\n\n과정은 동일합니다. 약화시키고 토템을 사용하여 정수를 포획하십시오. 거의 다 되었습니다.",
  },
  [27521] = {
    ["T"] = "폭풍, 대지, 바람 그리고 불",
    ["O"] = "바위 수호자에게 야루니의 정령력이 부여된 토템을 사용한 후 녀석을 처치하십시오.",
    ["D"] =
    "운고로에는 송진 군주들보다 더 강력한 대지의 세력이 있으며, 그게 바로 절 이곳으로 이끈 이유입니다.\n\n거대한 바위 수호자들이 강과 분화구 절벽 같은 인적 드문 경로를 따라 배회합니다. 평소 같으면 우리 둘 중 누구도 혼자서는 감당하기 벅찬 강력한 상대였겠지만, 우리가 모은 원시의 힘이 이 건장한 적을 제압하는 데 쓰일 수 있다고 믿습니다.\n\n이 토템을 받으십시오. 당신이 모은 모든 정령력으로 충전되어 있습니다. 바위 수호자에게 토템의 힘을 해방하고 무찌르십시오.\n\n수호자들은 당장 평화롭지만, 언젠가 악령숲의 정령들처럼 타락할 경우를 대비하여 방어를 철저히 해야 합니다.",
  },
  [27522] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "운고로 분화구의 가장자리를 따라 아루탈리스 폐허를 수색하고 발견한 물건을 자일사 스톤송에게 가져오십시오.",
    ["D"] =
    "안녕하신가요, $R. 제가 쇠약해진 상태인 것을 용서하십시오. 저는 엘룬의 자매 자일사 스톤송입니다. 전설 속의 엘프 도시 아루탈리스를 찾기 위해 운고로 분화구에 왔지요.\n\n들리는 바에 의하면, 우리 조상들은 광란하는 트롤 전쟁 부대를 피하기 위해 이 분화구에 숨었다고 합니다. 그들은 아즈샤라의 어느 곳에 필적할 만한 도시를 짓고 그 이름을 아루탈리스라 지었지요. 그러고는 아제로스가 갈라지기 훨씬 이전, 오랜 옛날에 파멸하고 말았습니다.\n\n분화구는 위험한 곳이며 저는 이 지역 생물들에게 심하게 다쳤습니다. 전 곧 회복하겠지만, 수색을 계속해 주시겠습니까? 분화구 중심부는 지났지만 가장자리는 수색하지 못했습니다. 제발, 조상의 흔적을 찾으려면 우리 주변의 언덕과 고원을 찾아봐 주십시오.",
  },
  [27523] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "운고로 분화구의 자일사 스톤송을 위해 폐허 유적지와 바람의 정령들에게서 아루탈리스 유물 6개를 모으십시오.",
    ["D"] =
    "우리는 아루탈리스에 무슨 일이 일어났는지 더 많이 알아내야만 합니다. 이곳에서 완전한 고고학적 발굴을 하려면 수개월, 수년이 걸릴 것입니다. 하지만 표면에는 종종 유물이 있으며, 심지어 이 지역 생물들이 집어갔을 수도 있습니다.\n\n당신이 묘사한 바람의 정령들이 우리가 처치하여 쉽게 회수할 수 있는 유물들을 빨아들였을지도 모릅니다. 비교를 위해 몇 개만 수집해 주시겠습니까?",
  },
  [27524] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "리키의 시추기를 사용하여 마샬의 야영지 수정 동굴 안쪽, 불기둥 마루 정상, 강철바위 고원, 골락카 간헐천에서 시료를 채취한 후, 운고로 분화구의 리키 카트스파크에게 시료를 가져오십시오.",
    ["D"] =
    "자일사가 거대한 비전 폭발이 아루탈리스를 파괴했다는 전설을 언급했나요? 당신이 찾은 유물이 이 이론을 뒷받침할 수 있습니다. 만약 그것이 사실이라면, 분화구에 오랫동안 쌓인 퇴적물 샘플에서 비전 잔여층을 볼 수 있어야 하죠.\n\n전 자일사를 돌봐야 하지만 도와주실 의향이 있다면, 이 시추기를 가지고 운고로의 다양한 곳에서 퇴적물 코어를 추출해 주시겠어요. 목록을 드릴게요.",
  },
  [27525] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "아루탈리스의 4개 폐허를 방문해 석판을 찾으십시오. 찾은 석판의 탁본을 떠서 운고로 분화구의 자일사 스톤송에게 탁본을 가져오십시오.",
    ["D"] =
    "다시 만났군요, $N. 가져오신 유물들을 살펴보았는데 \"쐐기돌 석판\"이라는 것에 대한 언급이 있더군요. 대략적인 번역이라 정확히 무엇을 의미하는지는 확실하지 않지만, 전체의 각기 다른 부분들이 아루탈리스 전체에 흩어져 있다는 뜻인 것 같습니다.\n\n온전한 상태는 아니겠지만, 우리가 충분한 조각을 모을 수 있다면 아마도 문맥을 통해 나머지를 이해할 수 있을 겁니다.\n\n이전에 찾으신 여러 폐허 유적지로 가서 글씨가 쓰인 석판, 아마 둥근 글씨체일 수도 있는 것을 찾아주시겠습니까? 이 탁본 도구들을 가져가서 제게 석판의 탁본을 좀 떠다 주십시오.",
  },
  [27526] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "다르나서스의 달의 신전에 있는 티란데 위스퍼윈드에게 아루탈리스 연구 재료 상자를 가져가십시오.",
    ["D"] =
    "지금으로선 저를 도와주실 수 있는 일을 다 하신 것 같네요. 제가 회복되면 스스로 이 연구를 계속할 수 있을 겁니다.\n\n부탁 건대 마지막으로 한 가지 더 도와주십시오. 코어 샘플, 석판 탁본, 제 보고서를 다르나서스에 있는 제 윗분들에게 가져다주세요. 그들은 우리가 발견한 것을 몹시 듣고 싶어 할 겁니다.",
  },
  [27527] = {
    ["T"] = "아루탈리스의 전설",
    ["O"] = "썬더 블러프의 장로의 봉우리에 있는 하뮬 룬토템에게 아루탈리스 연구 재료 상자를 가져가십시오.",
    ["D"] =
    "지금으로선 저를 도와주실 수 있는 일을 다 하신 것 같네요. 제가 회복되면 스스로 이 연구를 계속할 수 있을 겁니다.\n\n부탁 건대 마지막으로 한 가지 더 도와주십시오. 코어 샘플, 석판 탁본, 제 보고서를 썬더 블러프의 하뮬 룬토템에게 가져다주세요. 그는 이 전설이 사실인지 아는 데 관심이 많았고, 호드 일원인 당신이 저를 도와주었으니 최소한 이 정도는 해야겠지요.",
  },
  [27528] = {
    ["T"] = "남쪽 수정탑",
    ["O"] = "운고로 분화구에서 남쪽 수정 수정탑을 찾아 조사하십시오.",
    ["D"] =
    "제 이론이 맞는지 정말 알고 싶군요, $N. 제 복잡한 머릿속을 편하게 해주시겠습니까?\n\n분화구의 남쪽 지역을 확인해 주실 수 있다면, 그 지역 분화구 가장자리를 따라 수정탑이 있을 수 있다고 들었습니다.",
  },
  [27529] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "운고로 분화구 남서쪽 어딘가에서 리키 카트스파크를 찾으십시오.",
    ["D"] =
    "운고로 분화구의 수정탑들은 무척이나 오래되었다고 전해지며, 그것들이 어디에서 왔는지는 아무도 모릅니다. 저 수정탑이 얼마나 오랫동안 부서져 있었던 걸까요?\n\n오래된 물건의 연대를 정하는 데 전문가인 제 친구 리키 카트스파크가 있습니다. 그녀와 동료는 분화구 남서쪽 구석에 있는 공포의 터에서 고고학 연구를 하고 있지요. 그녀를 찾아가 수정탑이 언제 손상되었는지 알아낼 방법이 있는지 물어봐 주시겠어요?",
  },
  [27530] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "운고로 강둑에서 고운 강모래 4개와 운고로 분화구의 진흙괴물에게서 수액 화합물 1개를 수집하십시오.",
    ["D"] =
    "제 파트너 자일사와 저는 운고로에서 나이트 엘프 역사를 연구 중입니다. 수정탑을 가까이서 많이 본 적은 없지만, 이 탑들은 나이트 엘프보다도 훨씬 이전에 지어졌을 거라 믿습니다.\n\n수정탑이 언제 파손되었는지 알아내기 위해 우리가 의지할 수 있는 몇 가지 연구 원칙이 있죠.\n\n당신이 조사에 사용할 장비를 조립하려면 몇 가지 재료가 필요할 겁니다. 전 자일사를 돌봐야 하니 당신이 강둑에서 고운 모래와 근처 진흙괴물에게서 끈적이는 화합물을 좀 구해다 주시면 큰 도움이 될 거예요.",
  },
  [27531] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "리키의 연대 감지 화합물을 사용하여 남쪽 수정탑을 조사하고 그 결과를 관찰하십시오.",
    ["D"] =
    "좋아요, 계획은 이렇습니다. 남쪽 수정탑으로 돌아가서 이 화학 추출물을 바르셔야 해요. 수정탑 조각들이 일 년 이상 땅에 놓여 있었다면 빽빽한 정글 환경에 쌓인 흙과 이끼가 화합물을 흡수해서 아무 일도 일어나지 않을 겁니다. 하지만 최근에 깨진 거라면, 추출물을 모두 흡수할 만큼 퇴적물이 충분치 않아 어떤 반응이 일어날 거예요.\n\n정확히 어떤 반응일지 말씀드릴 순 없지만, 아마 놓치진 않을 거라고 확신해요!",
  },
  [27532] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "남쪽 수정탑에 대한 정보를 운고로 분화구 마샬의 야영지에 있는 J.D. 콜리에게 다시 가져가십시오.",
    ["D"] =
    "얼마나 흥미로운 전개인가요! 당신이 관찰한 반응은 지난 1년 이내에 어떤 종류의 폭발물이 수정탑에 사용되었음을 의미해요. 그게 무슨 뜻인지 이해가 되시나요?\n\n수정탑이 세월이나 날씨 때문에 손상되었을 리는 없어요. 누군가 파괴한 겁니다. 근데 대체 왜?\n\n당신이 발견할 것이 궁금하긴 하지만 전 자일사와 함께 여기 남아야 해요. J.D.가 이 소식을 들어야 하니 당장 그녀에게 가서 말해주세요.",
  },
  [27533] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "홀라니에 마샬에게 운고로의 실리시드 둥지가 얼마나 오래되었는지 아는지 물어보십시오.",
    ["D"] =
    "누군가 고의로 그 수정탑 중 하나를 파괴했다고요... 근데 왜? 우려스러운 가설이 하나 있어요. 수정탑들이 저 곤충 생명체들과 그들의 둥지 확장을 막는 것과 관련이 있을 수 있어요.\n\n이 가설을 확인해 볼 수 있는 방법이 있습니다. 홀라니에가 실리시드 둥지 조사에 관심이 있었던 것으로 기억해요. 어쩌면 그녀의 연구가 둥지가 얼마나 오래 있었는지 알려줄지도 모릅니다. 만약 지난 1년 내의 일이라면, 우린 이 일을 아주 심각하게 받아들여야 해요.",
  },
  [27534] = {
    ["T"] = "이것들 중 하나는 다른 것들과 다르다",
    ["O"] = "당신이 알아낸 사실을 마샬의 야영지에 있는 J.D. 콜리에게 보고하십시오.",
    ["D"] =
    "당신이 가져온 둥지 벽 샘플을 보니 이 터널은 꽤나 새것 같군요. 사실, 우리가 본 모든 실리시드 둥지들은 비교적 최근에 만들어진 것들입니다. 이 생물들은 성장도 아주 빠르고 순식간에 확장하거든요.\n\n이 둥지가 생긴 지는 1년 이하로 추정됩니다. 도움이 되었으면 좋겠군요!",
  },
  [27535] = {
    ["T"] = "폭풍이 몰려온다",
    ["O"] = "타나리스 입구와 실리더스 입구에 있는 기이한 수정탑들을 조사하십시오.",
    ["D"] =
    "수정탑이 실리시드의 확장을 막고 있었다는 것이 사실이라면, 그것들이 애초에 왜 만들어졌는지에 대한 다른 단서가 있을지도 모릅니다.\n\n운고로 분화구 입구 남동쪽과 북서쪽에 짙은 보라색 수정탑이 있습니다. 그 수정탑들을 조사해 분화구 안의 수정탑과 어떤 관계가 있는지 확인해 주시겠습니까?\n\n예감이 좋지 않군요....",
  },
  [27536] = {
    ["T"] = "폭풍이 몰려온다",
    ["O"] = "실리더스 용사의 안식처에서 퀴라지 수정탑 상형문자의 메시지에 대해 물어보십시오.",
    ["D"] =
    "마샬 원정대가 가젯잔에서 준비하는 동안 용맹 원정대라는 무리가 실리더스로 떠났습니다. 그들 중 일부 연구자들은 실리시드에 대한 자칭 전문가라고 하더군요. 검은 수정탑을 그들이 만들었다면 당신이 관찰한 조각들이 그들에게 어떤 의미가 있을지도 모릅니다.\n\n지금 그들이 어디 있는지는 모르겠지만, 실리더스로 향하는 도로를 따라가면 야영지를 찾을 수 있지 않을까요?",
  },
  [27537] = {
    ["T"] = "폭풍이 몰려온다",
    ["O"] = "용맹 원정대의 답변을 운고로 분화구 마샬의 야영지에 있는 J.D. 콜리에게 가져가십시오.",
    ["D"] =
    "우리 무리도 멈춰 서 운고로 입구의 수정탑에 주목했으니 당신이 묻는 것이 무엇인지 잘 알고 있습니다. 그것들은 실리시드의 사촌 격인 인간을 닮은 종족 퀴라지가 만든 것입니다. 일종의 경고, 그러니까 분화구는 출입 금지이거나 위험하다는 뜻인데 대략적인 번역일 뿐입니다. 그들의 언어와 개념은 당신과 제가 의사소통하는 방식과 꽤 다르거든요.\n\n우리는 이곳의 역사에 대해 잘 모릅니다. 단지 아주 오래전 이곳에서 큰 전쟁이 있었고 실리시드와 퀴라지가 패배했다는 사실만 알 뿐이죠. 아직 더 자세히 말씀드릴 수 없어 죄송하지만... 나중에 다시 오신다면 저희 연구를 돕는 것을 환영합니다. 아마 그때쯤엔 당신이 찾는 답을 얻을 수 있을지도 모르지요.",
  },
  [27538] = {
    ["T"] = "폭풍이 몰려온다",
    ["O"] = "오그리마 골목길에 있는 질지빈 드럼로어에게 J.D. 콜리의 보고서를 가져가십시오.",
    ["D"] =
    "이 전개를 우리끼리만 알고 있어서는 안 됩니다 $N! 알맞은 사람을 알고 있습니다 -- 연금술사 페슬저그가 오그리마의 조언가 질지빈 드럼로어를 위해 실리시드를 연구 중이라고 했죠. 이 보고서를 직접 가져다주십시오! 그는 어떻게 해야 할지 알 겁니다!",
  },
  [27539] = {
    ["T"] = "폭풍이 몰려온다",
    ["O"] = "다르나서스에 있는 그라시나 스피릿마이트에게 J.D. 콜리의 보고서를 가져가십시오.",
    ["D"] =
    "이 전개를 우리끼리만 알고 있어서는 안 됩니다 $N! 알맞은 사람을 알고 있습니다 -- 연금술사 페슬저그가 다르나서스의 조언가 그라시나 스피릿마이트를 위해 실리시드를 연구 중이라고 했죠. 이 보고서를 직접 가져다주십시오! 그녀는 어떻게 해야 할지 알 겁니다!",
  },
  [27540] = {
    ["T"] = "도둑맞은 설명서",
    ["O"] = "운고로 분화구의 모르벡을 위해 하스글렌에서 \"공룡 길들이는 법\"을 회수하십시오.",
    ["D"] =
    "얼마 전 어떤 인간이 제 라바사우루스 물품 주변을 기웃거리는 것을 목격했습니다. 쫓아내긴 했지만 나중에 맹독가죽 라바사우루스 훈련 팁이 적힌 공책을 훔쳐 갔다는 걸 알게 되었죠. 조금 조사해보니 그 도둑은 붉은십자군이라는 조직의 일원이었습니다.\n\n이 광신도들은 북부 역병지대의 하스글렌이라는 곳에 세력 거점을 두고 있습니다. 그곳에 사는 붉은 마술사들은 대단한 독서광이라고 하니, 그 책이 그들의 도서관 어딘가에 있지 않을까요?\n\n이 라바사우루스 새끼들을 계속 훈련시킬 수 있도록 그 책을 되찾아 주십시오!",
  },
  [27541] = {
    ["T"] = "독성 내성",
    ["O"] = "맹독가죽 라바사우루스의 피를 20번 뒤집어쓸 때까지 운고로 분화구에서 맹독가죽 라바사우루스를 공격하십시오.",
    ["D"] =
    "맹독가죽을 타고 싶나? 그럼 안 좋은 소식이 하나 있네.\n\n맹독가죽 라바사우루스는 독 덩어리지. 피도, 침도, 피부도 모두 독이라네. 녀석에 올라탔다간 몇 시간 후엔 죽은 채 떨어지게 될 거란 말씀.\n\n내가 팔기 전에 독에 대한 내성부터 길러야 할 텐데, 이게 시간이 아~주 오래 걸리거든.... 정말 관심 있다면 북서쪽 늪지대 북부 지역을 좋아하니 그쪽으로 가봐. 녀석들과 싸우며 피를 듬뿍 뒤집어써 봐.",
  },
  [27542] = {
    ["T"] = "아루탈리스에서 온 장난감",
    ["O"] = "운고로 분화구의 아루탈리스 폐허에 사는 바람의 정령들에게서 \"장난감\" 8개를 모으십시오.",
    ["D"] =
    "맹독가죽 라바사우루스는 애완동물이 아닙니다만, 기르고 훈련하는 동안 놀이를 통해 장난기를 끄집어내는 것이 좋습니다.\n\n라바사우루스의 장난감으로 썼을 때 버텨낼 수 있는 물건은 많지 않지만 돌로 만든 것은 하루 이상 갈 확률이 가장 높습니다. 분화구 주변 언덕에서 엘프 폐허를 본 적이 있습니다. 지금 그곳에 서식하는 바람의 정령들이 때때로 오래된 엘프 석제 유물을 빨아들이는데 이게 어린 맹독가죽들에게 적절한 장난감이 됩니다.\n\n절 위해 몇 개만 수집해 주실 수 있나요? 운고로 북동쪽과 남서쪽 끝에서 녀석들을 찾으실 수 있을 겁니다.",
  },
  [27543] = {
    ["T"] = "맹독가죽 안장",
    ["O"] = "무법항으로 이동해 드리즐릭에게서 맹독가죽 안장 화물을 찾아 운고로 분화구의 모르벡에게 가져오십시오.",
    ["D"] =
    "거죽이나 벗기지 가죽세공점의 드리즐릭에게 내가 훈련시키는 맹독가죽 라바사우루스용 안장 제작을 의뢰했소. 다음 안장이 지금쯤 완성되었을 텐데, 수고스럽지만 가져다주겠소? 무법항 위층에 가게가 있을 거요.\n\n한 가지 덧붙이자면 $N, 안장 값을 지불했는지 기억이 나질 않소. 만약 안 냈다면 대신 지불해주시겠소? 돌아오면 보상하리다.",
  },
  [27544] = {
    ["T"] = "영매를 위한 선물",
    ["O"] = "켈테릴 호수 근처 영매 니셸에게 기이한 다면체 수정을 가져가십시오.",
    ["D"] =
    "모험이 당신을 부르는군 -- 마우아리가 알지! 당신 같은 젊은 $C를 시험하기에 아주 딱인 게 있지.\n\n친애하는 내 친구 니셸은 특히 정령들과 교감 능력이 뛰어나다네. 이 집중의 수정을 켈테릴 호수 쪽에 있는 그녀에게 가져가면 엄청난 모험이 뒤따를 거야. 하지만 명심하게, 이 땅의 유령들은 분노하고 쉴 곳을 찾지 못하고 있어. 만약 그들을 달래지 못하면 평생토록 널 쫓아다닐지도 모른다구!",
  },
  [27545] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "눈망루 마을 북쪽의 야수들에게서 온전한 곰 대퇴골, 온전한 올빼미야수 눈알, 온전한 키메라 독낭을 구해 영매 니셸에게 가져가십시오.",
    ["D"] =
    "켈테릴 호수에 온 걸 환영해요, $N. 나처럼 이곳에 이끌렸나요? 난 이 폐허를 연구하는 데 모든 깨어있는 시간을 보냈어요.\n\n오래전 세계가 갈라지기 전, 이 신전에 끔찍한 비극이 일어났었죠. 비극의 원인은 미스터리지만, 우리가 그들과 대화할 수만 있다면 정령들이 그 수수께끼를 풀어줄 수 있어요. 당신이 가져온 수정은 우리가 대화할 수 있는 정령을 소환하도록 내가 고안한 특별한 의식의 핵심 재료입니다.\n\n이곳 야생동물들로부터 의식에 필요한 재료를 모아야 해요. 곰 대퇴골, 올빼미야수 눈알, 키메라 독낭을 가져오세요. 눈망루 마을 북쪽에서 이 동물들을 모두 찾을 수 있습니다만, 의식이 효과를 보려면 상처 없는 온전한 부위여야 해요.",
  },
  [27546] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "조율되지 않은 수정을 켈테릴 호수 주변 명가의 영혼에게 조율하여 켈테릴 호수 근처 영매 니셸에게 돌아오십시오.",
    ["D"] =
    "의식을 시작하기 전, 우리가 소환하고자 하는 영적인 에너지 유형에 수정을 조율해야 해요. 켈테릴 호수 폐허에는 비극을 목격한 엘프들의 고통스럽고 번뇌하는 영혼들이 살고 있어요. 당신은 이 정령들에게 수정을 사용하여 나의 동족들이 거주하는 영계와 조율해야 해요. 아 내 말은, 그들의 동족들이요. 용서해요, 여기서 너무 많은 시간을 보내다 보니 내가 이곳의 일부가 된 것 같군요.\n\n이 정령들을 파괴하는 것은 가슴 아프지만, 나머지들을 구하려면 희생이 필요해요. 이 작업을 마치면 내게 돌아와요. 당신이 떠난 동안 당신이 가져온 의식용 재료들을 조립해 둘 테니.",
  },
  [27547] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "영매 니셸이 의식을 완료하도록 도우십시오.",
    ["D"] =
    "가죽에 에테리얼의 짜릿함이 느껴져, $C. 우리 아주 가까이 왔어! 이제 네가 가져온 재료들을 마우아리가 조율한 수정과 내가 조제한 정령의 가루와 섞을 거다. 시간이 조금 걸리겠지만, 내가 끝내고 나면 정령이 나타날 거야.\n\n이 시점부터는 되돌아갈 수 없다 $N. 한 번 필멸의 영역을 넘어 저편의 세계에 발을 들여놓으면, 저편의 영혼들이 널 어디서 찾아야 할지 영원히 알게 될 거야. 지금 당장 떠나기로 선택해도 탓하지 않겠어. 만약 남기로 한다면 경계를 늦추지 마. 이 정령이 어떤 형태를 취할지 모르니까.",
  },
  [27548] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "여명의 설원 동쪽에 있는 영매 엄브런스를 찾아 고대의 일지를 번역해 달라고 도움을 청하십시오.",
    ["D"] =
    "슬프게도, 난 이 일지를 도저히 이해할 수가 없어요. 내용이 베일을 통과하면서 왜곡된 것 같아요. 게다가 의식용 수정도 손상됐고요. 정말 재앙이군요! 하지만 근처에 우릴 도와줄 수 있는 사람이 한 명 있어요.\n\n영매 엄브런스는 한때 니셸의-- 아니-- 나의 멘토였지. 눈망루 마을 북동쪽 외딴 판잣집에서 그를 찾을 수 있을 거다. 일지와 수정을 그에게 가져가서 번역해 줄 수 있는지 물어봐. 내가 직접 가고 싶지만 우린... 사이가 틀어졌거든. 너같이 중립적인 제삼자에게 부탁하는 게 낫다고 생각해서 그래.",
  },
  [27549] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "수리된 수정을 사용하여 영매 니셸 안의 사악한 정령을 몰아내고 파괴하십시오.",
    ["D"] =
    "일지를 번역할 수는 있지만 더 시급한 문제가 있네. 니셸의 연구가 그녀를 사악한 정령에 씌이게 했어. 설명해 주지.\n\n켈테릴 호수의 명가들은 진말로의 수정이라는 강력한 마법 유물을 남용했지. 이 수정은 수리해서 쓰기엔 너무 위험해. 당신도 자네 두 눈으로 직접 신전 거주자들에게 내려진 파괴의 흔적을 보았을 거야. 어떤 미스터리는 그대로 내버려 두는 게 낫다고 니셸에게 경고했건만.\n\n니셸은 정령들이 수정을 어떻게 사용했는지 이해할 수 있다면 그걸 통제할 수 있다고 믿었네. 그녀의 연구가 호수 정령들의 빙의에 그녀를 무방비하게 노출시켰고, 이제 사악한 힘이 그녀의 행동을 조종하고 있어. 네가 시도했던 의식은 더 많은 정령이 우리 세상에 들어올 수 있도록 문을 여는 것이 목적이었네. 다행히 네가 이 통로를 파괴했어.\n\n이 존재가 너를 믿고 있으니 내가 이 수정을 고쳐주마. 그러면 넌 이것을 사용해 그녀의 몸에서 정령을 몰아내 파괴할 수 있을 거야. 그럼 아마 그녀가 제정신을 차리고 이 어리석은 탐구를 포기하겠지.",
  },
  [27550] = {
    ["T"] = "과거로 통하는 문",
    ["O"] = "여명의 설원 동쪽에 있는 영매 엄브런스에게 돌아가십시오.",
    ["D"] =
    "엄브런스의 말이 맞았어, 진말로의 수정은 다시 발견되거나 사용되기엔 너무 위험해요. 난 내 안에 거주하던 정령을 참으며 며칠을 버텼지만, 그건 수정이 초래할 잠재적인 악행 중 가장 미약한 것이었죠.\n\n부탁이야, $N. 엄브런스에게 돌아가서 내가 다시 나 자신으로 돌아왔다고 전해주겠어? 난 더 이상 일지 번역에는 관심이 없다고 해. 그가 그 고서로 뭘 하든 상관 안 할 테니. 이 경험을 곰곰이 생각해 볼 시간을 가진 후 곧 마을로 돌아갈 생각이야. 정령이 널 축복하길, $C.",
  },
  [27551] = {
    ["T"] = "살점 1파운드",
    ["O"] = "앨런 호손은 당신이 여명의 설원에 있는 펄볼그들에게서 쭈글쭈글한 펄볼그 뇌 4개, 펄볼그 살점 20개, 커다란 펄볼그 뼈 15개를 모아오기를 원합니다.",
    ["D"] =
    "안녕하신가, $C.\n\n도살자가 하나 필요한데... 안목이 까다롭고 도덕성은 약간 결여된 자로 말이야. 관심 있나?\n\n이곳의 펄볼그들은 튼튼한 생물이지 -- 말하자면 근육질의 산이야. 놈들은 '화염수'를 마시는데, 내가 나름대로 요긴하게 쓰고 있지. 그나저나 말이 샜군.\n\n내게 계획이 있어. 예술 작품을 위한 계획이지. 펄볼그 뇌와 그들의 살, 그리고 뼈가 필요해.",
  },
  [27552] = {
    ["T"] = "불길한 보급품",
    ["O"] = "눈망루 마을의 상인들에게서 납이 섞인 유리병 20개, 석탄 10개, 빈 양피지 5개를 구매하여 여명의 설원의 앨런 호손에게 돌아가십시오.",
    ["D"] =
    "자, 이제 눈앞에 있는 이 피범벅으로 디자인을 구상해야겠군. 시간이 좀 걸리겠어.\n\n자넨 이 지역을 여행하고 있겠지? 눈망루 마을이라는 그 쓰레기 같은 악당들의 소굴에 가게 되면 이 물건들을 사다 줘. 보상은 두둑이 할 테니, 물론이지...!",
  },
  [27553] = {
    ["T"] = "일생의 역작",
    ["O"] = "앨런 호손의 동굴에 있는 고기 무더기에 호손의 불안정한 용액을 사용하십시오.",
    ["D"] =
    "내 작품을 널리 알릴 생각인데, 자네부터 시작하지. 자네가 없는 동안 난 스승님의 누더기골렘 가르침을 정독했어. 모든 것이 제자리에 있어 -- 직접 봐봐.\n\n<고기 무더기는 당신이 두고 간 그대로의 모습입니다.>\n\n이 유리병을 들고 그 내용물을 무더기에 부어.",
  },
  [27554] = {
    ["T"] = "고통받는 자들의 고통",
    ["O"] = "켈테릴 호수의 유령들에게서 불안정한 엑토플라즘 10개를 모아 여명의 설원에 있는 앨런 호손에게 돌아가십시오.",
    ["D"] =
    "아니야, 내가 의도한 게 절대 아니었어. 적어도 네가 처리하긴 했군... 어, 훌륭하게 말이야.\n\n흠... 불행은 친구를 좋아하는 법이지. 괴물이 깨어날 때 기분 좋을 리가 없고, 저기 동쪽 호수를 배회하는 아주 비참한 유령들을 보았어.\n\n저 망령들을 한번 찾아가 보는 게 어떤가, $C? 그들의 엑토플라즘 한 무더기면 충분할 거야.",
  },
  [27555] = {
    ["T"] = "끝나지 않는 임무",
    ["O"] = "앨런 호손의 동굴에 있는 고기 무더기에 호손의 안정화된 용액을 사용하십시오.",
    ["D"] =
    "다시 해볼까?\n\n네가 떠난 동안 나는 뇌를 '강화'했고, 엑토플라즘 덕분에 이 피조물의 마음은 놈의 분노를 분산시킬 수 있게 되었어. 게다가 추론 능력이 뛰어날수록 통제하기 쉬워지지.\n\n내가 용액을 정제했어. 이제 붓기만 하면 되는데, 그 일은 다시 한번 네 몫이야.",
  },
  [27556] = {
    ["T"] = "도둑맞은 고서",
    ["O"] = "여명의 설원에 있는 리베른 프로스트윈드를 위해 하스글렌에서 \"눈호랑이 조련법에 관한 소고\"를 회수하십시오.",
    ["D"] =
    "얼마 전에 은빛 여명회가 계곡 반대편 외딴곳에 사는 영매 엄브런스라는 인간에게 사절을 보낸 적이 있네. 은빛 여명회 사절은 떠나기 전에 여명의 설원을 순회했는데 녀석은 호랑이 훈련법에 무척이나 관심을 보이더군.\n\n너무 지나친 관심이었지.\n\n그 남자는 도둑이었어. 녀석은 내 반쯤 완성된 \"눈호랑이 조련법에 관한 소고\"를 훔치고 사라졌네. 내가 엄브런스와 이야기했을 때, 그 영매 또한 도둑을 맞았다는 걸 알았어. 우린 도둑이 사실 붉은십자군의 일원이고 그들의 거점인 하스글렌에 숨어 있다고 믿네. 그곳에 사는 붉은 마술사들은 소문난 지식광이니 -- 혹시 내 책이 그들의 도서관 어딘가에 있지 않을까?",
  },
  [27557] = {
    ["T"] = "따뜻한 목욕",
    ["O"] = "리베른 프로스트윈드의 청소용 양동이를 얼음불꽃 온천의 따뜻한 물로 채운 후, 눈호랑이 동반자인 글레이셔를 목욕시키는 데 사용하십시오.",
    ["D"] =
    "내 동반자 글레이셔는 장난기가 많은 친구야. 가끔 장난치고 사냥하다 털이 너무 더러워져서 스스로 청결을 유지하기도 힘들 지경이지. 녀석을 목욕시키는 걸 좀 도와줄 수 있겠나?\n\n이 양동이를 얼음불꽃 온천으로 가져가 따뜻한 물로 채워주게. 물이 식기 전에 빨리 돌아와서 글레이셔에게 잽싸게 목욕을 시켜주게나. 으르렁거리고 자네를 할퀼 수도 있겠지만, 녀석도 고마워할 거라고 확신하네.",
  },
  [27558] = {
    ["T"] = "톡 쏘는 사업",
    ["O"] = "눈망루 마을 남쪽 도로와 인접한 야영지의 타눔과 이야기하십시오.",
    ["D"] =
    "야, 잘난 친구! 일자리 찾고 있어? 연금술계에서 최고의 품질을 자랑하는 음료를 만드는 사업을 하고 있거든.\n\n적어도 난 그렇게 생각했지! 내 동업자 타눔이 일주일도 넘게 사라져서 슬슬 걱정이 돼. 제품이 필요한데 칼림도어 전체에서 내가 믿을 수 있는 연금술사라곤 그 녀석뿐이거든! 거액을 들여서 여길 끌고 왔다고!\n\n일이 너무 바빠서 그런데 무슨 일인지 좀 알아봐 줄래? 눈망루 마을 남쪽으로 나가봐. 큰길 따라 조금만 내려가면 돼. 내가 생각하는 짓을 하고 있는 건 아니어야 할 텐데!",
  },
  [27559] = {
    ["T"] = "고급 재료",
    ["O"] = "타눔의 쇠톱을 사용하여 타눔의 야영지 동쪽에 있는 얼음엉겅퀴설인 시체에서 설인의 손가락 80개를 채집하십시오.",
    ["D"] =
    "그러어니까, 그 아가씨가 물약을 원한다, 이 말이지? 참을성이라곤 없군, 이 작은 고블린 녀석! 걔들한테 보낸 지 하루밖에 안 지났는데...!\n\n<타눔이 물약 얼룩진 수염을 긁자 털이 한 움큼씩 빠집니다.>\n\n이름이 뭐라고 했지... $N...? $N, 온 김에 이 피곤한 늙은 드워프 좀 도와주는 건 어때. 이 물약들을 만들려면 동쪽 언덕을 배회하는 커다란 야수들의 설인 손가락이 필요하거든. 그래, 손가락 -- 온전해야 돼, 특히 발톱이 말이야! 위쪽 동굴 안에서도 찾을 수 있을 거야.\n\n너무 메스꺼워하지 말라고! 이 쇠톱을 가져가서 맘껏 즐겨봐.",
  },
  [27560] = {
    ["T"] = "망령포효",
    ["O"] = "타눔의 야영지 동쪽에 있는 절벽 동굴에서 망령포효를 처치하십시오.",
    ["D"] =
    "잘 들어봐, $N. 저 소리 들려?\n\n<타눔이 잠시 멈추고 당신은 동쪽에서 희미한 포효를 듣습니다.>\n\n나 여기 나와 있는 내내 이 소동을 겪고 있다니까! 그리고 누가 원인인지도 알아... 저기 위 동굴 저 깊숙한 곳에 있는 뚱뚱한 털 덩어리 녀석이지! 지금 나한테는 좀 벅찬데... 네 녀석은 어때...?\n\n<타눔이 손가락을 비비며 뱀 같은 눈으로 당신의 장비를 훑어봅니다. 시선이 마주치자 불길한 미소가 그의 얼굴에 번집니다.>\n\n일하려면 조용해야 하거든! 섭섭지 않게 보상해 주마, $C... 응?",
  },
  [27561] = {
    ["T"] = "톡 쏘는 맛",
    ["O"] = "타눔은 서리바람 키메라의 번개 숨결로 전자식 B.T.L.R. 장치를 8번 충전하기를 원합니다.",
    ["D"] =
    "좋아, $C. 손가락도 얻었고 조용하기도 하니 이제 톡 쏘는 맛이 필요해... 톡 쏘는 게 뭐냐고?\n\n<타눔이 공허한 눈으로 당신을 바라보며 멈칫합니다.>\n\n당연히 번개 숨결이지! 저 키메라들한테서 나오는 거... 하지만 너를 지질 놈들한테만이야! 자, 여기 작업에 쓸 도구가 있어.\n\n<타눔이 버튼, 스위치, 조명으로 덮인 위험해 보이는 장치를 건넵니다.>\n\n조금 따끔해도 신경 쓰지 마... 아, 그리고 죽지 않도록 조심해라!",
  },
  [27562] = {
    ["T"] = "훌륭한... 제품?",
    ["O"] = "눈망루 마을의 록시 피즈휘슬에게 물약 상자를 전달하십시오.",
    ["D"] =
    "알았어, $N... 으윽...!\n\n<타눔이 크게 한숨을 쉬며 서로 다른 색과 농도의 다양한 물약을 집어 들더니 상자 안에 휙 던져 넣습니다.>\n\n이걸 그 쪼끄만 다이너마이트한테 가져다줘! 아, 그녀가 내 인생 망치고 있어! 이-이러언 거 할 시-시가안 읎다그어...!\n\n<타눔은 중얼거리며 혀가 꼬이기 시작하더니, 이제 막 빚어낸 물약으로 게걸스러운 눈을 돌립니다.>",
  },
  [27563] = {
    ["T"] = "공용어",
    ["O"] = "타눔을 혼내준 후 눈망루 마을의 록시 피즈휘슬에게 돌아오십시오.",
    ["D"] =
    "<록시가 뒤죽박죽인 물약 상자를 살핍니다. 당신의 이야기를 듣고는 혐오감에 얼굴을 구깁니다.>\n\n아니, 안 돼! 안 돼!! 또 그 제품을 들이마시고 있잖아! 나한테 이 쓰레기를 보내다니... 이 병에 뭐가 들었는지조차 알고 싶지 않아. 내 건 아니라는 건 확실하니까!\n\n그 멍청이 운도 좋지, 제대로 된 음료를 만들어냈네! 아... 보스가 알게 되면 뭐라고 하실까!?\n\n결정했어, $N! 그 난쟁이 녀석 좀 혼내줘! 죽이진 말고, 그냥... 좀 거칠게 다뤄 줘. \"무역회사가 안부 전한대\"라고 전해. 그럼 녀석도 정신 차릴 거야!",
  },
  [27564] = {
    ["T"] = "델레반 돕기",
    ["O"] = "은밀한 숲의 남쪽이자 눈망루 마을 북동쪽 야영지에 있는 델레반 프로스트게이즈와 이야기하십시오.",
    ["D"] =
    "아주 잘했어, 꼬맹아. 털보수염 자식에게 겁을 제대로 줬지! 일 하나 더 해볼래?\n\n여명의 설원에 친구 하나가 있어. 착하고 동물들도 잘 다루는 녀석이지. 잿빛 골짜기, 악령숲 등에서 나를 엄청 도와줬어... 어쨌든 이름은 델레반이고 북쪽의 올빼미야수인지 뭔지와 무언가를 하려고 하고 있어.\n\n<록시가 손바닥을 들어 올립니다.>\n\n뭘 하냐고는 묻지 마! 걘 말할 때 알아들은 적이 한 번도 없거든. 나보고 너 같은 사람 있으면 찾아서 자기한테 보내달라고 하더라. 위험하다고는 하던데, 딱 네 취향 같잖아.",
  },
  [27565] = {
    ["T"] = "재료로 만든 막대",
    ["O"] = "델레반 프로스트게이즈는 은밀한 숲 근처에 있는 하늘을 나는 부엉이들에게서 뿌리에서 나는 얼음수액 8개, 바위에서 나는 서리 수정 6개, 핏빛 깃털 5개를 가져오기를 원합니다.",
    ["D"] =
    "록시가 제 목적을 설명해 주었을 거라 믿소만. 안 했소?\n\n이곳 북쪽 올빼미야수들의 마음을 동요시키는 무언가가 있소. 원인을 설명하긴 어렵지만 우리가 녀석들의 혼란을 줄일 수 있을 거라고 믿소.\n\n첫 번째 단계는 막대에 현지 재료를 묻혀 마법을 불어넣어 효력을 높이는 거요. 내가 직접 다 모으고 싶지만... 돌아오니 엉망진창이 된 야영지만 있을 뿐이었소. 나 대신 다녀와 줄 수 있겠소?\n\n근처 뿌리에 있는 얼음수액이 마음을 늦춰주는 밀봉제 역할을 할 거요. 바위 꼭대기의 서리 수정은 차가운 기운을 내뿜어 마음을 달래주고, 마지막으로 여명의 설원을 날아다니는 늘 현명한 올빼미들은 굳건한 존재들이니 녀석들의 핏빛 깃털이 녀석들보다 큰 동족들에게 그 특성을 전해줄 수 있지 않겠소. 녀석들이 품위 있게 최후를 맞도록 해 주시게나.\n\n이 재료들을 모아 주신다면 그 은혜 잊지 않겠소. 여명의 설원은 자비롭지 않으니 몸조심하시구려.",
  },
  [27566] = {
    ["T"] = "달빛 속의 애도",
    ["O"] = "밤에 은밀한 숲 안에 있는 달빛에 미친 올빼미야수를 델레반 프로스트게이즈와 함께 처치하십시오.",
    ["D"] =
    "꿈속에서 나는 깊은 원한을 품고 숲을 배회하는 고독한 올빼미야수를 보았소. 명확한 위협이 없었음에도... 절망적으로 느껴졌소. 내 생각에 이 피조물은 내 의도를 알고 있으면서 분노에 휩싸여 있는 것 같소.\n\n막대는 완성되었지만 다시 한번 자네 힘을 빌려야겠소. 밤이 되면 숲의 동식물들이 마법에 반응하여 조율되는데, 우린 이 순간을 이용할 거요. 막대가 조율을 흡수할 것이고 나는 이 분노에 맞서겠소. 내 추측이 맞다면 이 고독한 올빼미야수가 분노 자체를 상징할 것이오.\n\n위험을 마주할 준비가 되면 내게 말해주시오. 자네와 합류할 테지만, 우린 반드시 밤에 가야 하오.",
  },
  [27567] = {
    ["T"] = "텔레스아란으로 가는 길",
    ["O"] = "눈망루 마을을 나와 북쪽 길을 따라가다가 별내림 마을을 지나 갈림길에서 우회전하여 여명의 설원에 있는 차카자의 고용주를 찾으십시오.",
    ["D"] =
    "거기 자네. 차카자의 고용주가 용감하고 튼튼한 전사를 찾고 있는데... 왠지 자네라면 해낼 수 있을 거 같군.\n\n눈망루 마을 북쪽 길로 나가서 별내림 마을을 지나 갈림길에서 오른쪽으로 꺾어. 그녀가 자넬 기다리고 있을 거야.",
  },
  [27568] = {
    ["T"] = "돌에 새겨진 단어",
    ["O"] = "여군주 리렌은 여명의 설원의 텔레스아란을 수색하고 쿠엘도레이 석판 8개를 수집하기를 원합니다.",
    ["D"] =
    "준비는 된 모양이군. 두둑이 한몫 챙길 생각 있나, $C?\n\n나는 칼림도어의 추방자들이 아닌 명가, 고대 쿠엘도레이에 관한 모든 것을 수집하는데 북쪽의 폐허에서 찾을 것이 있다. 찾을 수 있는 문헌은 뭐든 필요하지만 아마 돌판밖에 발견하지 못할 것이다.\n\n읽을 필요는 없다. 합의된 거로 알까?",
  },
  [27569] = {
    ["T"] = "필경사의 일",
    ["O"] = "쿠엘도레이 석판을 여명의 설원 눈망루 마을 여관에 있는 마리우스 헤드린에게 가져가십시오.",
    ["D"] =
    "내 호위병들은 눈망루 마을에서 빈둥거리고 있다. 그 두 녀석은 나와 같은 열정을 공유하진 않지만 녀석들이 거기 있는 이유는 그게 아니지.\n\n필경사, 마리우스 헤드린을 찾아라. 그가 이 석판의 이 부분을 두루마리에 새기도록 해라.\n\n<여군주 리렌은 그녀의 손가락으로 석판 문자의 한 구역을 가리킵니다.>\n\n주문 두루마리의 효력이 강력해야 한다고 전해라 -- 그의 최고 기량만이 내 기대에 미칠 것이다.",
  },
  [27570] = {
    ["T"] = "환영의 열쇠",
    ["O"] = "여명의 설원 눈망루 마을의 마리우스 헤드린은 쿠엘도레이 두루마리를 만들기 위해 환영 가루 7개가 필요합니다. 환영 가루는 마법부여 전문기술로 제작할 수 있습니다.",
    ["D"] =
    "와, 아름다운 글씨체로군요! 전 읽을 수 없지만, 아가씨께서 이걸 필사하기 원하시는 건가요?\n\n주문 두루마리요? 글쎄요, 가장 강력한 주문 두루마리는 환영 가루를 써야 하는데... 아, 지난주에 가루가 다 떨어졌어요!\n\n어... 재료 좀 구해다 주시겠어요? 환영 가루는 마법부여사가 다루니 딴 데서 못 구하시면 눈망루 마을의 관측소에 있는 경매장에서 찾아보실 수 있을 거예요.",
  },
  [27571] = {
    ["T"] = "미지의 마법",
    ["O"] = "텔레스아란 밖에 있는 여군주 리렌에게 튼튼한 두루마리 보관함을 가져가십시오.",
    ["D"] =
    "다 됐습니다, $C. 이 정도면 충분할 거예요! 전 석판을 계속 보관하고 있겠지만 당신은 이걸 가져가셔야 할 겁니다.\n\n<마리우스가 당신에게 튼튼하게 봉인된 무거운 보관함을 건넵니다.>\n\n두루마리는 안에 있습니다. 여군주 리렌에게 전해주세요. 조심히 가시고, 행운을 빕니다!",
  },
  [27572] = {
    ["T"] = "비전 보관소",
    ["O"] = "텔레스아란의 주문 두루마리를 사용하여 비전 보관소의 문을 열고 금고를 찾으십시오.",
    ["D"] =
    "좋아, 계획은 이렇다...:\n\n텔레스아란에는 도시 북쪽 가장자리에 비전 보관소라고 불리는 거대한 쿠엘도레이의 저장고가 있다. 많은 보물을 보존하기 위해 산속에 지어졌고, 안의 마법은 수년이 지난 지금도 그 유물들을 보존할 만큼 강력하지. 네가 찾은 그 석판에 문을 열기 위한 주문이 적혀 있었다. 내가 무슨 말 하려는지 알겠나?\n\n유령들은 우릴 돕지 않을 테고 살아있는 자 중에 이 언어를 읽을 자가 있을 것 같진 않으니, 네가 대신 그 두루마리를 사용하도록 해라. 내 연구에 따르면 이 거대한 보관소 금고는 위층에 있으며 중무장된 호위를 받고 있다. 안에 있는 걸 가져와라, $C.",
  },
  [27573] = {
    ["T"] = "퇴폐적인 욕망",
    ["O"] = "텔레스아란 밖에 있는 여군주 리렌에게 쿠엘도레이 유물을 가져가십시오.",
    ["D"] = "<여군주 리렌은 당신이 찾은 유물을 보고 싶어 할 것입니다.>",
  },
  [27574] = {
    ["T"] = "길 잃은 영혼",
    ["O"] = "이스미르 돈폴은 여명의 설원에 있는 텔레스아란의 어떤 유령 거주민이든 20명을 안식에 들게 하기를 원합니다.",
    ["D"] =
    "저한테 말씀하시는 겁니까? 얼마 만인지...? 대부분의 여행자들은 저에게 신경 쓰지 않거나... 반대 방향으로 도망치기 바쁘죠.\n\n<이스미르는 당신이 떠날 것이라 예상이라도 한 듯 잠시 말을 멈춥니다. 그의 날카로운 눈동자는 깊은 슬픔을 숨기고 있습니다.>\n\n전 제 임무에 실패했습니다, $C... 텔레스아란은 제 아버지 조상의 집이었고, 저는 몇 년 전에 고통받는 동족들을 안식에 들게 하기 위해 이곳에 왔습니다. 살아서도 순찰자였기에 제 능력에 대한 자신감에 차있었습니다만. 대신 이 꼴이 된 걸 보십시오...!\n\n<이스미르는 형체가 없는 손을 가슴에 휘저었고, 그러자 그의 유령 오라가 일그러집니다.>\n\n폐허로 향하는 길인 것 같군요. 당신에게 드릴 건 없지만 제발 -- 이곳 영혼들에게 자비를 베풀어 주십시오. 그들의 고통을 덜어주십시오. 비극적이게도 그들은 자신들이 처한 상태조차 깨닫지 못하고 있습니다.",
  },
  [27575] = {
    ["T"] = "악몽의 씨앗",
    ["O"] = "텔레스아란 내부의 사티로스 야영지에서 악몽의 씨앗 8개를 수집하십시오. 사티로스 야영지에서 냄새의 원인을 찾으십시오.",
    ["D"] =
    "<씨앗 껍데기는 죽어있고 반쯤은 전 주인이 먹어치운 상태입니다. 이전엔 결코 본 적 없는 모습이며... 썩은 냄새가 납니다.>\n\n<이 폐허 어딘가에서 이와 비슷한 끔찍한 냄새가 나고, 사티로스 야영지에 가까워질수록 그 냄새는 더 심해집니다.>",
  },
  [27576] = {
    ["T"] = "말보르의 안내",
    ["O"] = "뿌리예언자 아하루는 악몽의 씨앗 자루를 달숲의 말보르에게 전달하기를 원합니다.",
    ["D"] =
    "이것들을 내게 가져온 것은 현명한 결정이었습니다, $N. 이제 알겠군요, 나무의 뿌리와 마법이 땅에 단단히 박혀 있습니다. 나무를 벤다고 해서 이것이 퍼지는 것을 막을 순 없을 겁니다.\n\n제 마법으로 상처를 치료하고 식물을 키울 수는 있습니다만... 이런 것은 저 혼자만의 능력으로는 벅차군요. 그러나 비슷한 상황을 처리해 본 사람을 한 명 알고 있습니다.\n\n$N, 달숲에 있는 박식한 약초학자 말보르를 찾아 주십시오. 그는 밤의 안식처 남서부 비행 조련사 근처에 머물고 있습니다.\n\n씨앗을 전해주고 우리의 궁지를 설명해 주십시오. 그가 어떻게 해야 할지 알 겁니다. 전 여명의 설원에 남아 동료와 상의해보겠습니다.",
  },
  [27577] = {
    ["T"] = "달빛처럼 순수한",
    ["O"] = "달숲에 있는 말보르의 집 밖 달샘에서 수정 플라스크를 채우십시오.",
    ["D"] =
    "정말 걱정스럽군요, $C. 씨앗 자루가 멀쩡해서 다행입니다 -- 이 씨앗 중 하나라도 흙에 닿았더라면 회수하지 못했을 겁니다.\n\n이 씨앗들은 부패했지만 달의 축복을 받은 물은 어떤 것이든 정화할 수 있죠. 제 예상이 맞는다면 우리는 이 씨앗들의 사악한 목적을 역이용할 수 있을 것입니다. 제 플라스크를 밖의 달샘으로 가져가서 채운 후 저에게 돌아오십시오.",
  },
  [27578] = {
    ["T"] = "아하루에게 귀환",
    ["O"] = "여명의 설원의 텔레스아란 근처에 있는 뿌리예언자 아하루에게 꿈의 씨앗 플라스크를 전달하십시오.",
    ["D"] =
    "자, 이제 됐습니다. 씨앗들이 꿈틀거림을 멈춘 게 보이십니까? 머지않아 긍정적인 변화의 요원이 될 것입니다.\n\n달의 물이 강력한 반격의 마법을 부여합니다. 만약 이것들을 저주받은 나무 근처에 심는다면 녀석의 성장과 악의를 멈출 수 있을지도 모릅니다.\n\n추가 연구를 위해 씨앗을 몇 개 남겨 두었으니 원에 이 경과를 알릴 것입니다. 서둘러 아하루에게 가십시오. 그가 당신의 비용을 보상해 줄 것입니다. 고맙습니다, $C.",
  },
  [27579] = {
    ["T"] = "꿈 심기",
    ["O"] = "여명의 설원에 있는 텔레스아란 내부에 있는 5개의 악몽의 성장을 꿈의 씨앗 곁에 심으십시오.",
    ["D"] =
    "말보르가 우리를 구했군요! 이 더러운 나무를 당장 없앨 수 없어 유감스럽지만 그 영향을 약화시킬 수 있다면 그것만으로도 승리입니다. 내 동료 델레반이 야생 동물이 동요하고 있다고 의심하니 시간이 핵심입니다!\n\n부디 효과가 있기를. 직접 심어주는 영광을 드리죠, $N. 다 끝나면 내게 돌아오십시오.",
  },
  [27580] = {
    ["T"] = "흉악한 뿔의 그림자",
    ["O"] = "뿌리예언자 아하루는 당신이 북쪽 텔레스아란 내부에 있는 악당의 뿔 사티로스 15마리를 처치하기를 원합니다.",
    ["D"] =
    "안녕하세요 $C. 더 좋은 상황에서 만났으면 좋았을 텐데요.\n\n달숲에서조차 여명의 설원에 무언가 잘못되었다는 것을 느꼈습니다. 나는 나무들과 교감했고, 그들은 대지에 사악한 마법에 의해 자라나 더욱 끔찍하게 퍼져나가는 오염된 상처를 보여주었습니다.\n\n<뿌리예언자 아하루가 낙담하여 고개를 젓습니다.>\n\n공기 중의 그 더러운 냄새가 맡아지십니까? 이 멀리까지 불어오는 유황의 냄새는 단 한 가지를 의미합니다. 사티로스죠. 북쪽의 냄새를 쫓아 그들을 해치우고 -- 그들의 사악한 행위에 종지부를 찍으십시오!",
  },
  [27581] = {
    ["T"] = "눈체리 간식",
    ["O"] = "여명의 설원에 있는 리베른 프로스트윈드를 위해 눈체리 12개를 수집하십시오.",
    ["D"] =
    "눈호랑이를 길들이는 일은 시간이 많이 소요되는 과정이라네, $N. 비록 내가 좋아하는 간식이 우리 주변에 널려 있지만 밥 먹을 시간조차 없어.\n\n혹시 부탁 하나 들어주겠나? 눈체리는 여명의 설원 곳곳, 특히 이 지역을 수놓고 있는 큰 나무나 바위 은신처 근처에서 많이 자라지. 내가 계속 훈련을 시키는 동안 내게 한 움큼 정도만 따다 준다면 정말 고맙겠네.",
  },
  [27582] = {
    ["T"] = "부드러운 박쥐 가죽",
    ["O"] = "여명의 설원의 리베른 프로스트윈드를 위해 동부 역병지대의 역병박쥐에게서 부드러운 박쥐 가죽 10개를 수집하십시오.",
    ["D"] =
    "눈호랑이를 타기 위해 필수적인 부품은 바로 알맞은 안장이지. 여명의 설원에는 가죽이 부족하지 않지만 이런 종류의 안장을 만들 땐 좀 더 이국적인 가죽이 더 낫다는 걸 알았네.\n\n바다 건너 동부 역병지대로 가서 그곳을 배회하는 역병박쥐들을 사냥해 보게. 박쥐 가죽은 질기지만 부드러워 다른 가죽처럼 쓸리지 않거든. 안장 제작에 쓸 부드러운 박쥐 가죽 열 개를 구해 여기 여명의 설원에 있는 내게 가져다주게.",
  },
  [27583] = {
    ["T"] = "마즈소릴의 혈족",
    ["O"] = "여명의 설원에 있는 마즈소릴로 여행하여 푸른용 새끼 12마리를 처치하십시오.",
    ["D"] =
    "눈호랑이는 위험한 포식자이기도 하지만, 특정 강력한 존재에게는 먹잇감이기도 하네 -- 마즈소릴에 서식하는 푸른용들 말이야.\n\n다 자란 눈호랑이는 하급 용혈족과 싸워도 버틸 수 있지만 저 사악한 생물들은 가끔 새끼들에게 먹이로 주려고 새끼 눈호랑이들을 잡아간다네. 그것도 생명의 순환이지. 하지만 최근 그 지역에서 푸른용 새끼들의 수가 늘어난 것을 알아차렸네. 녀석들이 너무 많으면 눈호랑이 개체군에 무슨 일이 생길지 걱정이오. 조치를 취해야 하네!\n\n마즈소릴에 들끓는 푸른용 새끼들을 줄여주게. 녀석들은 개별적으론 약하지만 성체들이 수호할지도 몰라. 자네 안전을 위해 파티를 맺어 가길 추천하네.",
  },
  [27584] = {
    ["T"] = "에코 교환",
    ["O"] =
    "아즈샤라의 검은아귀 마을에 있는 상인 말루에게 올빼미야수 에코 5개, 얼음엉겅퀴설인 에코 5개를 주고 검은아귀 의식의 토템과 교환하십시오. 토템을 여명의 설원에 있는 리베른 프로스트윈드에게 가져오십시오.",
    ["D"] =
    "눈사태 펄볼그들이 타락하기 전에는 눈호랑이를 길들이는 데 자주 도움을 주었다네. 녀석들은 야수가 날 신뢰하도록 돕는 진정 토템을 만들었지. 아즈샤라에 있는 검은아귀 펄볼그 부족이 비슷한 토템을 만든다고 들었는데, 나를 위해 그 토템을 가져와 주게나.\n\n녀석들이 눈사태 펄볼그들과 같다면 단순한 동전만으로 그런 물건을 얻긴 힘들 거야. 물물교환이 필요해. 눈망루 마을의 의술사 마우아리가 여명의 설원 주민들로부터 마력을 추출하는 방법을 알아냈지. 이 \"에코\"가 검은아귀 부족의 관심을 끌지 않을까?\n\n에코를 어떻게 구해야 할지 모르겠다면 눈망루 마을의 의술사와 이야기해보게. 아니면 펄볼그와 비슷하지만 서리와 비전으로 주입된 올빼미야수와 설인들의 정수를 시도해 봐.",
  },
  [27585] = {
    ["T"] = "여명의 설원 안장",
    ["O"] = "무법항으로 이동해 드리즐릭에게서 눈호랑이 안장 화물을 찾아 여명의 설원의 리베른 프로스트윈드에게 가져오십시오.",
    ["D"] =
    "거죽이나 벗기지 가죽세공점의 드리즐릭에게 내가 훈련시키는 눈호랑이용 안장 제작을 의뢰했소. 다음 안장이 지금쯤 완성되었을 텐데, 수고스럽지만 가져다주겠소? 무법항 위층에 가게가 있을 거요.\n\n한 가지 덧붙이자면 $N, 안장 값을 지불했는지 기억이 나질 않소. 만약 안 냈다면 대신 지불해주시겠소? 돌아오면 보상하리다.",
  },
  [27586] = {
    ["T"] = "달시를 위한 의뢰",
    ["O"] = "연금술사 말로리는 당신의 연금술 기술을 사용해 최하급 치유 물약 5개를 제작하고 엘윈 숲의 골드샤이어에 있는 달시에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "신입 연금술사로군! 나 좀 도와주겠나. 지금 일거리가 넘쳐나는 데다 골드샤이어의 달시는 다친 광부들을 위한 최하급 치유 물약을 부탁해왔거든. 난 스톰윈드 경비병을 위해 중요한 임무를 마쳐야 해서 말이야. 도와주고 싶다면 그 물약 다섯 개를 만들어 달시에게 가져다주게.",
  },
  [27587] = {
    ["T"] = "토마스 경비병을 위한 의뢰",
    ["O"] = "연금술사 말로리는 당신의 연금술 기술을 사용해 최하급 방어의 비약 5개를 제작하고 엘윈 숲의 동쪽계곡 벌목지에 있는 토마스 경비병에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "자네가 도와줄 수 있는 일이 또 있네 -- 아주 간단하고 기초적인 기술만 필요하지.\n\n동쪽으로 난 길을 따라 내려가면 동쪽계곡 벌목지 근처에 수비대원들을 볼 수 있을 거야. 그들 중 토마스 경비병은 숲에서 경비병들이 자꾸 실종된다고 연금술의 도움이 필요하다고 요청해왔네. 길을 잃는 걸 막아줄 순 없지만, 최하급 방어의 비약 정도면 생존에 도움이 되겠지. 이 일을 맡겠나?",
  },
  [27588] = {
    ["T"] = "마일리 의무병을 위한 의뢰",
    ["O"] = "의무병 마일리는 당신의 연금술 기술을 사용해 최하급 마나 물약 5개를 제작하고 던 모로의 카라노스에 있는 의무병 마일리에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "오 안녕! 네 방어구에 묻은 평온꽃 자국만 봐도 연금술사란 걸 알겠네! 날 좀 도와줄래?\n\n나는 노움들이 실험실에서 겪는 숱한 사고들을 돕기 위해 여기 왔는데, 가끔 마나가 부족해. 네가 내게 최하급 마나 물약을 좀 만들어 주면 물약값도 쳐주고 보급품도 덤으로 좀 줄게!",
  },
  [27589] = {
    ["T"] = "앙구스를 위한 의뢰",
    ["O"] = "의무병 마일리는 당신의 연금술 기술을 사용해 약한 트롤의 피 비약 5개를 제작하고 던 모로의 카라노스 남쪽 야영지에 있는 앙구스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "있잖아, 이 주위엔 연금술사가 할 일이 꽤 많아. 더 해볼 생각 있어?\n\n카라노스 남쪽에 있는 드워프 박격포 부대도 자잘한... 사고를 많이 치거든. 치유 물약을 쓸 정도는 아니지만-- 네가 의뢰받을 생각이 있다면, 약한 트롤의 피 비약 정도는 필요해할 거야.",
  },
  [27590] = {
    ["T"] = "달의 여사제 아마라를 위한 의뢰",
    ["O"] = "말로른 블레이드리프는 당신의 연금술 기술을 사용해 사자의 힘 비약 5개를 제작하고 텔드랏실의 다르나서스 서쪽 길에 있는 달의 여사제 아마라에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "실례지만 연금술사신 걸 우연히 알게 되었습니다. 신드라 님은 요청이 쇄도하고 있는데다 너무 상냥하셔서 거절을 못 하시거든요. 혹시 그녀의 의뢰 중 몇 개만 대신 맡아주실 수 있나요?\n\n달의 여사제 아마라는 외곽 감시병들을 위해 사자의 힘 비약 5개를 요청하셨습니다. 이걸 만드신 후 서쪽 다르나서스 가는 길 어딘가에서 그녀를 찾으시면 될 겁니다.",
  },
  [27591] = {
    ["T"] = "파수꾼 아리니아 클라우드브레이크를 위한 의뢰",
    ["O"] = "말로른 블레이드리프는 당신의 연금술 기술을 사용해 최하급 활력 물약 5개를 제작하고 텔드랏실의 예언자의 숲에 있는 파수꾼 아리니아 클라우드브레이크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "신드라 님이 너무 바쁘다는 걸 누가 좀 말해줬으면 좋겠지만 다가오는 사람 모두를 도와주려는 그분의 마음도 이해합니다. 예언자의 숲에 홀로 있는 클라우드브레이크 파수꾼의 최우선 요청이 있습니다. 최하급 활력 물약을 좀 만들어서 전해주신다면 신드라 님께 큰 도움이 될 것입니다.",
  },
  [27592] = {
    ["T"] = "농부 살딘을 위한 의뢰",
    ["O"] = "지나 맥그레거는 당신의 연금술 기술을 사용해 하급 치유 물약 5개를 제작하고 서부 몰락지대의 살딘 농장에 있는 농부 살딘에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "저는 비약이나 물약을 만드는 재주는 없는 그저 평범한 상인이지만 서부 몰락지대의 동료 시민들을 돕고 싶습니다. 농부 살딘은 그의 농장에서 날뛰는 기계들을 처리하려다 가벼운 상처를 입었죠. 하급 치유 물약을 만들어서 살딘 농장으로 전달해주신다면, 제가 그를 더 도울 수 없다는 제 마음의 짐도 좀 덜어질 것입니다.",
  },
  [27593] = {
    ["T"] = "그림부즈 썬더브루를 위한 의뢰",
    ["O"] = "지나 맥그레거는 당신의 연금술 기술을 사용해 아귀아귀 기름 5개를 제작하고 서부 몰락지대의 단검 굽이에 있는 그림부즈 썬더브루에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "돕는 김에 말하자면... 연금술사의 도움을 구하는 분이 또 있습니다. 단검 굽이에 있는 야영지에서 그림부즈 썬더브루를 찾을 수 있습니다. 그는 자기를 위해 아귀아귀 기름병을 몇 개 만들어 줄 사람을 찾고 있거든요. 관심 있으시면, 그가 보수를 확실히 지불할 겁니다.",
  },
  [27594] = {
    ["T"] = "울란나를 위한 의뢰",
    ["O"] = "울란나는 당신의 연금술 기술을 사용해 지혜의 비약 5개를 제작하고 어둠해안의 고대정령의 숲에 있는 울란나에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "몇 달에 한 번씩 오누와 상담하려 고대정령의 숲으로 여행하는 순례자들이 있습니다. 그의 지혜는 때론 이해하기 어렵죠. 그래서 순례자들이 오누의 말을 이해하는 데 도움을 주기 위해 지혜의 비약을 좀 비축해 두려 합니다. 만들어서 제게 가져다주신다면 기쁜 마음으로 쓸 만한 보급품을 챙겨 드릴게요.",
  },
  [27595] = {
    ["T"] = "고고학자 에버릿을 위한 의뢰",
    ["O"] = "울란나는 당신의 연금술 기술을 사용해 최하급 인내의 비약 5개를 제작하고 어둠해안의 렘트래블의 발굴현장에 있는 고고학자 에버릿에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "최근 드워프 일행이 들렀습니다. 그들은 렘트래블의 발굴현장이라 알려진 발굴지로 향하고 있었어요. 골렘 때문에 약간의 문제가 생겼다 들었는데 최하급 인내의 비약이 그 문제를 해결하는 데 도움이 되지 않을까 궁금하네요. 확인해 볼 만한 일 아니겠어요?",

  [27916] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] =
    "저주받은 땅에서 마즈로아에게 /결투 명령어를 사용하여 막고라를 선포하고 명예로운 전투에서 그를 물리치십시오. 이 도전에서 살아남아야 합니다.",
    ["D"] =
    "명예로운 전투에 대해 평생을 이야기할 수 있지만, 당신의 기본적인 이해를 위해 간단히 설명하겠습니다.\n\n우리 동족은 불타는 군단에 가담하기 위해 명예를 포기했고, 그 힘의 노예가 되었습니다. 타락하기 전, 우리는 리더십 분쟁을 해결하거나 다른 사람의 권위에 도전하기 위해 막고라라는 명예로운 결투를 사용했습니다. 저주받은 땅 어둠의 문이 내려다보이는 언덕에 마즈로아라는 악마가 있습니다. 그는 아제로스의 군단 하수인들을 지휘하는 하급 군주이지만, 도전하여 물리쳐야 합니다.\n\n마즈로아에게 막고라를 선포하고, 속임수 없이 명예롭게 그와 맞서십시오. 지더라도 공정하게 지십시오. 이긴다면 당신 자신의 힘으로 이기십시오. 행운을 빕니다, 모험가여.",
  },
  [27917] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "테라모어 섬에 있는 여군주 제이나 프라우드무어에게 돌아가 배운 것을 말하십시오.",
    ["D"] =
    "이제 우리 동족에 대해 더 잘 이해하게 된 것 같군요, $R. 우리는 아직 당신을 친구라 부르지 않을지 모르지만, 전장에서 오크와 마주칠 때 그것이 명예로운 도전이 될 것임을 기억하십시오. 당신의 최선의 노력에 걸맞은 가치가 있는 전투 말입니다.\n\n당신을 내게 보낸 사람에게 돌아가 배운 것을 전하십시오. 안녕히 가십시오!",
  },
  [27918] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "아이언포지에서 기록관 던짐을 찾으십시오.",
    ["D"] =
    "이제 오크의 명예에 대해 더 잘 알게 되었으니, 전투에서 당신을 이끌 그 원칙들을 사용할 수 있을 것입니다. 그것을 더욱 완전히 받아들이고 싶다면, 아이언포지의 기록관 던짐을 찾으십시오. 행운을 빕니다, $C.",
  },
  [27919] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "오그리마 스랄의 방에 있는 나즈그렐에게 돌아가십시오.",
    ["D"] =
    "이제 우리 동족에 대해 더 잘 이해하게 된 것 같군요, $R. 우리는 이미 동맹이지만 전장에서 오크 곁에서 싸울 때 그것이 명예로운 전투가 될 것임을 이제 알게 되었습니다. 당신의 최선의 노력에 걸맞은 가치가 있는 전투 말입니다.\n\n당신을 내게 보낸 사람에게 돌아가 배운 것을 전하십시오. 안녕히 가십시오!",

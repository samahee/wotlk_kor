    ["D"] =
    "잠깐만요, 쉿, 저 좀 도와주실래요? 수석 연금술사 리앤더님께서 제가 마법에만 너무 의존하고 연금술 기술엔 신경 쓰지 않는다고 제 마술봉을 빼앗아 버렸어요. 하지만 전 마술봉이 필요하단 말이에요! 그러니 비밀리에 교체품 하나만 만들어 주실 수 있나요? 돈은 드릴게요!",
  },
  [28424] = {
    ["T"] = "감독관 랠렌의 의뢰",
    ["O"] = "감독관 랠렌이 기계공학 기술을 이용해 구리 나사 한줌 24개를 제작하여 엘윈 숲 동부계곡 벌목지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "이봐, $N -- 귀 뒤에 기름때 묻었잖아! 그거면 자네가 기계공학자란 걸 알 수 있지. 그래서 말인데 좀 도와줄 일이 하나 있어.\n\n제재소를 계속 돌리는 건 정말 쉴 틈 없는 일이야. 조금만 잘못 쳐다봐도 당장 부서질 것 같다니까. 톱날이 계속 돌아가게 하려면 구리 나사 한줌 수십 개는 있어야 해. 혹시 좀 도와줄 수 있나?",
  },
  [28425] = {
    ["T"] = "치안대장 해거드의 의뢰",
    ["O"] = "감독관 랠렌이 기계공학 기술을 사용해 조잡한 구리 폭탄 20개를 제작하여 엘윈 숲 동부계곡 벌목지에 있는 치안대장 해거드에게 배달해 주길 원합니다.",
    ["D"] =
    "이봐, 당신 기계공학자라니까 여기서 도와줄 수 있는 일이 하나 더 있어.\n\n저 너머의 치안대장 해거드는 수십 년 동안 스톰윈드 경비병으로 복무해 왔어. 가끔 밤에 깨어나 제2, 제3차 대전쟁의 기억에 시달리지... 더 이상 안전하다고 느끼지 못하는 모양이야. 내 생각엔 그에겐 강력한 화력이 필요한 것 같아. 곁에 두고 안심할 수 있는 그런 거 말이지. 내 말은 폭발물이야, $N. 조잡한 구리 폭탄 한 무더기면 그가 자신만의 무기고를 가졌다고 느낄 수 있을 거야.",
  },
  [28426] = {
    ["T"] = "조종사 해머풋의 의뢰",
    ["O"] = "라즐 스프리스프로켓이 기계공학 기술을 이용해 아크라이트 스패너 2개를 제작하여 던 모로 북문 초소에 있는 조종사 해머풋에게 배달해 주길 원합니다.",
    ["D"] =
    "놈리건의 대재앙으로 노움 기계공학자들이 수없이 죽는 바람에 우리 서비스의 수요가 폭발적으로 늘었어. 조종사 해머풋 좀 봐 -- 자기 공성 전차를 고쳐야 한다고 내 개인 도구마저 내놓으라는 거 있지!\n\n흥, 내 눈에 흙이 들어가기 전엔 내 도구는 절대 못 주지. 하지만 좋은 일을 좀 하고 싶다면 아크라이트 스패너 몇 개 만들어서 북문 초소에 있는 녀석에게 갖다줘 봐. 우리도 공성 전차는 굴러가야 하니까.",
  },
  [28427] = {
    ["T"] = "레욜트 발리브루의 의뢰",
    ["O"] = "라즐 스프리스프로켓이 기계공학 기술을 이용해 구리관 5개를 제작하여 던 모로 브루날 마을에 있는 레욜트 발리브루에게 배달해 주길 원합니다.",
    ["D"] =
    "기계공학자라면 다른 드워프들 못지않게 질 좋은 맥주의 진가를 알아보는 법이지. 그러니 시간 나면 레욜트 발리브루가 보낸 이 의뢰를 좀 처리해 줬으면 좋겠어. 브루날 마을의 증류기를 개조하려고 구리 파이프를 한가득 찾고 있더라고. 레욜트가 이미 빚은 에일도 꽤나 일품이라, 새 증류기가 돌아가기 시작하면 또 어떤 작품을 내놓을지 정말 기대돼.",
  },
  [28428] = {
    ["T"] = "다잘라의 의뢰",
    ["O"] = "샨테르가 당신의 기계공학 기술을 이용해 굵은 붐스틱 1개를 제작하여 텔드랏실 돌라나르에 있는 다잘라에게 배달해 주길 원합니다.",
    ["D"] =
    "이슈누달디에브, $C. 아이언포지에서 돌아온 이후로 내 기계공학 서비스에 대한 수요가 꽤 많아졌어. 혼자 다 감당할 수 없을 정도로 밀려드는군.\n\n자네도 기계공학에 소질이 있다면 주문을 하나 처리해 주겠나? 돌라나르의 사냥꾼 조련사 다잘라가 총을 한번 써보고 싶다더군. 상상이나 해봐? 아주 진취적인 생각이지!\n\n어쨌든, 자네가 굵은 붐스틱을 만들어 그에게 배달해 준다면 참 고맙겠어.",
  },
  [28429] = {
    ["T"] = "데날란의 의뢰",
    ["O"] = "샨테르가 당신의 기계공학 기술을 이용해 조잡한 다이너마이트 20개를 제작하여 텔드랏실 알아메스 호수에 있는 데날란에게 배달해 주길 원합니다.",
    ["D"] =
    "조금 당혹스러운 주문이 하나 있어. 자네가 한번 살펴봐 주겠나?\n\n데날란이 알아메스 호수 근처에서 식물 실험을 해왔는데 며칠 전 그가 \"통제 불능의 관목\"을 처리할 \"폭발적인\" 뭔가를 요청하는 편지를 보냈지 뭔가. 글쎄, 이걸 어찌 생각해야 할지 모르겠지만 조잡한 다이너마이트라도 만들어보고 싶다면, 돌라나르 뒤편 호숫가에 있는 데날란에게 배달해 주게나.",
  },
  [28430] = {
    ["T"] = "정찰병 리엘의 의뢰",
    ["O"] = "민병대원 가리엘이 당신의 기계공학 기술을 사용해 조잡한 조준경 2개를 만들어 서부 몰락지대 감시의 언덕에 있는 정찰병 리엘에게 배달해 달라고 합니다.",
    ["D"] =
    "저는 민병대에 필요한 물품을 징발할 수 있는 권한을 받았습니다. 기계공학자라고 하셨죠? 탑 꼭대기에 있는 정찰병 리엘을 위해 조잡한 조준경이 필요한데 만들어주시겠습니까? 감시의 언덕을 공격하는 적들을 저격하는 데 큰 도움이 될 겁니다. 조준경 몇 개를 만들어서 전해주시면 보상은 확실히 챙겨드리죠.",
  },
  [28431] = {
    ["T"] = "민병대원 도라나의 의뢰",
    ["O"] = "민병대원 가리엘이 기계공학 기술을 사용해 날쌘 호랑이 고글 1개를 제작하여 서부 몰락지대 감시의 언덕 북쪽 길목을 순찰 중인 민병대원 도라나에게 배달해 주길 원합니다.",
    ["D"] =
    "민병대의 보급품 징발 담당관으로서 민병대원 도라나를 위해 날쌘 호랑이 고글 한 쌍을 만들어 달라고 부탁하고 싶소. 그녀는 감시의 언덕 북쪽으로 뻗은 길을 홀로 순찰하고 있는데 모래 폭풍이 일으키는 먼지와 따가운 햇빛으로부터 눈을 보호해 줄 고글이 필요할 거요. 그것들을 그녀에게 배달해 주는 친절을 베풀어 준다면 정말 감사하겠소.",
  },
  [28432] = {
    ["T"] = "고고학자 에베리트의 의뢰",
    ["O"] = "골볼트 스틸핸드가 당신의 기계공학 기술을 이용해 표적 허수아비 5개를 만들어 어둠해안 렘트래블의 발굴현장에 있는 고고학자 에베리트에게 배달해 달라고 합니다.",
    ["D"] =
    "이곳 엘프 친구들은 훌륭한 기계공학 기술을 거의 신뢰하지 않지. 하지만 최근 남쪽에 있는 렘트래블의 발굴현장 소속 고고학자 에베리트라는 드워프와 얘기를 나눈 적이 있네. 골렘과 관련된 무슨 문제가 생겨서 표적 허수아비가 필요하다고 하더군. 난 재고가 없었어 -- 보통 취급하는 물건도 아니었으니까 -- 하지만 자네가 이걸 만드는 데 관심이 있다면, 녀석이 분명히 충분한 보상을 해줄 거라고 믿네.",
  },
  [28433] = {
    ["T"] = "셀렐리안 화이트클로의 의뢰",
    ["O"] = "골볼트 스틸핸드가 기계공학 기술을 사용하여 은 접점 20개를 만들고 어둠해안 아우버다인에 있는 셀렐리안 화이트클로에게 가져가 달라고 합니다.",
    ["D"] =
    "내가 재고로 가지고 있지 않은 물건이 하나 더 있는데 은 접점일세. 그런데 마을에 있는 한 나이트 엘프가 그걸 사고 싶어 하더군. 아내의 초상화를 그리는 데 필요한 '적절한 도구' 라나 뭐라나. 난 예술에 대해선 아무것도 모르지만... 샐렐리안 화이트클로를 위해 은 접점을 만들어 낸다면 꽤 짭짤한 수입을 올릴 수 있다는 것쯤은 알지.",
  },
  [28434] = {
    ["T"] = "브록 스톤시커의 의뢰",
    ["O"] = "브록 스톤시커가 기계공학 기술을 이용해 구리 변조기 5개를 제작하여 모단 호수 텔사마에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "안녕하시오, $C. 광부가 기계공학자한테 도움을 요청하는 게 좀 이상하긴 하지만 나한테 새로운 자동 굴착 도구 아이디어가 하나 있어서 말이오. 첫 번째 프로토타입을 만들려면 구리 변조기 5개가 필요하오. 날 도와준다면 제작비 말고도 팁을 얹어 주겠소.",
  },
  [28435] = {
    ["T"] = "풋내기 다릴의 의뢰",
    ["O"] = "브록 스톤시커가 기계공학 기술을 사용해 연습용 자물쇠 5개를 제작해 모단 호수 원정순찰대 오두막에 있는 풋내기 다릴에게 배달해 달라고 합니다.",
    ["D"] =
    "도움 이야기가 나와서 말인데, 얼마 전 원정순찰대 오두막으로 향하는 젊은 인간 하나가 여길 지나갔소. 사냥에 영 흥미를 못 느끼는 것 같더군. 혹시 마을에 연습용 자물쇠를 만들 수 있는 사람이 있느냐 물었지만 여긴 그런 기술을 가진 자가 아무도 없소. 자네가 주머니를 더 두둑하게 채우고 싶다면, 녀석 말로는 한동안 오두막에 묵을 예정이라 하더군. 이름은 다릴이라고 했소.",
  },
  [28436] = {
    ["T"] = "빅토리 프리즘안트라스의 의뢰",
    ["O"] = "코그 글리츠스피너가 당신의 기계공학 기술을 사용해 정교한 망원경 1개를 만들어 그늘숲 다크샤이어의 빅토리 프리즘안트라스에게 배달해 달라고 합니다.",
    ["D"] =
    "옆집에 사는 인간 하나가 별을 관측하겠다며 무슨 거창한 망원경인가 뭔가를 만들려 하고 있어요. 우리 노움들은 정교한 망원경으로 별을 보는 방법이 진작부터 있었다고 계속 말해줬는데도 말이죠!\n\n전 기계공학자가 아니지만 당신은 그래 보이는군요. 망원경을 하나 만들어서 빅토리에게 전해주면 좋겠네요. 녀석의 그 멍청한 발명품에 대해 더 이상 듣고 싶지 않거든요!\n\n<코그가 인간들이 노움 산업을 잠식하고 있다며 투덜거립니다.>",
  },
  [28437] = {
    ["T"] = "젬 리워드의 의뢰",
    ["O"] = "젬 리워드가 당신의 기계공학 기술을 사용해 수중 유인기 10개를 만들어 붉은마루 산맥 레이크샤이어의 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "여어, $C. 영원고요 호수의 낚시가 요즘 최고야. 이 부두에서 크고 빛나는 해를 닮은 물고기들을 꽤 많이 낚아 올렸지 -- 하지만 수중 유인기 같은 최신식 장비가 있다면 훨씬 더 대박을 터뜨릴 수 있을 텐데. 그거 만들 줄 아는 사람 혹시 아나?",
  },
  [28438] = {
    ["T"] = "오렌딜 브로드리프의 의뢰",
    ["O"] = "수호자 델그렌이 기계공학 기술을 사용해 강한 다이너마이트 20개를 제작하여 잿빛 골짜기 마에스트라 주둔지에 있는 오렌딜 브로드리프에게 배달해 주길 원합니다.",
    ["D"] =
    "반갑습니다, $C. 저는 인근에서 벌어지는 포세이큰들의 동향을 살피고자 이곳에 왔습니다만, 제 이웃 오렌딜 브로드리프로부터 기계공학 기술에 관해 무수히 많은 질문을 받게 되었군요. 그자는 여느 나이트 엘프들처럼 기술에 반감을 가지지는 않은 듯합니다.\n\n오렌딜에게 기계공학 기술의 위력을 보여주고 싶군요. 당신이 강한 다이너마이트 몇 개를 만들어서 그에게 가져다주실 수 있겠습니까?",
  },
  [28439] = {
    ["T"] = "사령관 스트롱해머의 의뢰",
    ["O"] = "프래드 스위프트기어가 기계공학 기술을 사용해 표준형 조준경 2개를 제작해 저습지 북쪽 늪지대의 번두랄에 있는 사령관 스트롱해머에게 배달해 달라고 합니다.",
    ["D"] =
    "나의 누추한 작업장에 오신 걸 환영하오, $C. 북쪽 늪지대에서 무언가 벌어지고 있다는 끔찍한 보고가 들어왔소. 용아귀부족 오크들이 그곳에 병력을 집결시키고 있어서, 번두랄이 공격받을지도 모르오.\n\n스트롱해머 사령관은 그곳의 방위 대장인데, 그가 자기 소총병들을 위해 표준형 조준경 2개를 요청한 주문서가 여기 있소. 하지만 아아, 난 아직 그걸 처리하지 못했소. 날 도와 이 일을 즉시 처리해주지 않겠소?",
  },
  [28440] = {
    ["T"] = "하사관 요화의 의뢰",
    ["O"] = "하사관 요화가 기계공학 기술을 사용해 커다란 청동 폭탄 20개를 제작하여 가시덤불 골짜기 반란군 야영지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "쿠르젠 대령의 병력은 가시덤불 골짜기 북쪽 끝 언덕에 있는 동굴에 틀어박혀 있소. 전술적 타격으로 쿠르젠과 녀석의 부하들을 소탕하는 것이 가장 좋겠지만, 공격이 실패할 경우를 대비해야만 하오.\n\n그 대비책에 자네 같은 뛰어난 기계공학자가 필요하네.\n\n폭탄이 필요하네, $N. 커다란 놈으로. 정확히 말하면 커다란 청동 폭탄이 한가득 필요하네. 최악의 상황이 오면, 그 동굴 입구를 폭파해서 쿠르젠을 안에 가둬버려야 해.",
  },
  [28441] = {
    ["T"] = "현장감독 티온의 의뢰",
    ["O"] = "경비병 바이론이 당신의 기계공학 기술을 사용해 회전톱니시계 5개를 만들어 먼지진흙 습지대 테라모어 섬의 현장감독 티온에게 배달해 주길 원합니다.",
    ["D"] =
    "어이 -- 거기 자네! 내가 동부 왕국에 주둔할 때 아이언포지의 기계공학 전문가 옆에서 널 본 것 같은데. 기계공학자 맞지?\n\n현장감독 티온이 우리 제재소를 가동하려 애쓰고 있는데 벨트 타이밍을 맞추는 데 애를 먹고 있어. 그걸 돌리려면 회전톱니시계가 몇 개 필요하다고 하더군. 자네가 좀 도와줄 수 있겠나?",
  },
  [28442] = {
    ["T"] = "호르니즈 브림버즐의 의뢰",
    ["O"] = "디비 스퀴글코드가 당신의 기계공학 기술을 사용해 단단한 다이너마이트 20개를 만들어 잊혀진 땅 코도 무덤의 호르니즈 브림버즐에게 배달해 주길 원합니다.",
    ["D"] =
    "스퀴글코드에 온 걸 환영해. 난 밑바닥에서부터 이 장소를 만들었고 할 일은 산더미처럼 많아.\n\n그나저나, 너 기계공학자지? 네 손가락에 박힌 아크라이트 스패너 굳은살을 보면 다 알아. 열린 주문 하나 채워볼래?\n\n코도 무덤 저기 아래 사는 고블린이 단단한 다이너마이트를 좀 사겠다고 요청했어. 고블린 기계공학자에 대한 내 직업적인 존경심은 크지만 이 녀석은 연금술사란 말이지.... 대체 녀석이 다이너마이트를 어디에 쓰려고 그러는지 알 수가 없어서 아직 주문을 안 채우고 놔뒀어. 네가 원하면 그 일은 다 네 차지야!",
  },
  [28443] = {
    ["T"] = "시몬 캔트렐의 의뢰",
    ["O"] = "시몬 캔트렐이 당신의 기계공학 기술을 사용해 초정밀 고글 1개를 만들어 힐스브래드 구릉지 라벤홀트 장원에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "라벤홀트 영주 같은 인간이 조경에 안목이 있을 줄은 몰랐는데, 여기 정원은 정말 뛰어나게 발전할 수 있는 기반을 갖추고 있어요. 제가 나뭇잎의 세세한 부분까지 집중할 수 있는 초정밀 고글이 하나 있다면 정말 큰 도움이 될 텐데요. 혹시 어디서 그 고글을 구할 수 있는지 아시나요?",
  },
  [28444] = {
    ["T"] = "호윈 카인드페더의 의뢰",
    ["O"] = "호윈 카인드페더가 기계공학 기술을 사용하여 미스릴 튜브 5개를 만들고 동부 내륙지 맹금의 봉우리에 있는 자신에게 가져다주길 원합니다.",
    ["D"] =
    "낚시 자주 해, $N? 나도 낚시를 정말 좋아하는데 썩은가지 트롤 녀석들이 내가 찜해둔 낚시터에서 날 쫓아내는 바람에 애지중지하던 낚싯대를 잃어버렸어.\n\n마을에 기계공학자가 없어서 언제 새 낚싯대를 장만할 수 있을지 모르겠어. 혹시라도 미스릴 튜브를 구하게 되면 자네 친구 호윈을 떠올려 주겠나? 튜브 몇 개만 있으면 새 낚싯대를 만들 수 있을 것 같은데.",
  },
  [28445] = {
    ["T"] = "샨드리스 페더문의 의뢰",
    ["O"] = "샨드리스 페더문이 기계공학 기술을 사용하여 고급 표적 허수아비 2개를 만들고 페랄라스 페더문 요새에 있는 자신에게 가져가 달라고 합니다.",
    ["D"] =
    "훈련시켜야 할 파수꾼은 많은데 갑옷이 부족하오, $N. 대장간에서 새 갑옷이 나오기를 기다리는 이들은 부상을 피하기 위해 조심해서 대련해야 하는 상황이지. 당신의 명성은 이곳까지 널리 알려졌으니, 당신이 나설 차례군. 파수꾼들을 훈련시킬 고급 표적 허수아비가 몇 개 필요하오. 도와줄 수 있소?",
  },
  [28446] = {
    ["T"] = "학자 애드우드의 의뢰",
    ["O"] = "마리엘 듀몬트가 기계공학 기술을 사용하여 불안정한 기폭장치 5개를 만들어 서부 역병지대 카엘 다로우에 있는 학자 애드우드에게 배달해 주길 원합니다.",
    ["D"] =
    "당신 기계공학자야? 미안해... 그냥 그렇게 보여서. 내 오빠도 기계공학자거든.\n\n어쨌든, 아까 서리바람 야영지에서 애드우드 박사란 사람이 불안정한 기폭장치를 찾고 있었다는 걸 알려주고 싶었어. 은빛 여명회가 그를 거의 쫓아내다시피 했는데... 이유는 모르겠어. 근데 기계공학자가 지나가면 카엘 다로우로 오라는 말을 남겼어. 네가 언데드의 위협을 무릅쓰고 그곳까지 갈 수만 있다면 돈을 벌 좋은 기회가 될지도 몰라!",
  },
  [28447] = {
    ["T"] = "킴야엘의 의뢰",
    ["O"] = "윌슨 워블스미스가 기계공학 기술을 사용하여 치명적인 조준경 2개를 만들어 아즈샤라 레가쉬 야영지에 있는 킴야엘에게 배달해 주길 원합니다.",
    ["D"] =
    "오! 동료 기계공학자군! 그 손톱 밑의 찌든 때만 봐도 단번에 알 수 있지!\n\n그나저나 자네, 일자리 구하나? 워블 할로우엔 할 일이 산더미라 다른 누군가를 도울 여력이 안 되네. 저 북쪽 악마들 근처에 사는 고블린 하나가 자신을 위해 치명적인 조준경 몇 개를 만들어 줄 사람을 찾고 있더군. 돈 벌 생각이 있다면 그자가 꽤 짭짤한 보상을 해줄 걸세!",
  },
  [28448] = {
    ["T"] = "소로스 다크크레센트의 의뢰",
    ["O"] = "소로스 다크크레센트가 기계공학 기술을 사용하여 고성능 폭탄 20개를 만들어 악령숲 갈퀴가지 숲에 있는 소로스 다크크레센트에게 가져다 달라고 합니다.",
    ["D"] =
    "<소로스는 약해 보이지만 의식은 뚜렷합니다.>\n\n악마들이... 이렇게 만들었어. 복수... 해야 해! 폭탄이... 필요해. 고성능... 폭탄이. 제발... 내 복수를 도와줘!",
  },
  [28449] = {
    ["T"] = "감독관 힌크의 의뢰",
    ["O"] = "머크드락이 기계공학 기술을 이용해 구리 나사 한줌 24개를 만들어 듀로타 오그리마 외곽 비행선 탑에 있는 감독관 힌크에게 배달해 주길 원합니다.",
    ["D"] =
    "이봐, $N -- 귀 뒤에 묻은 기름때 좀 닦아! 보아하니 기계공학자인 모양인데 마침 일손이 필요하던 참이야.\n\n고블린들이 오그리마 외곽에 새 비행선 탑을 짓고 있는데 구리 나사 한줌이 수십 개 필요하다더군. 내가 수레 부품 주문을 처리하느라 바빠서 도통 손을 못 대고 있어. 네가 좀 도와주겠어?",
  },
  [28450] = {
    ["T"] = "라르 프라울터스크의 의뢰",
    ["O"] = "머크드락이 당신의 기계공학 기술을 사용해 조잡한 구리 폭탄 20개를 만들어 듀로타 센진 마을에 있는 라르 프라울터스크에게 배달해 주길 원합니다.",
    ["D"] =
    "이봐, 자네가 기계공학자라니 말인데 여기서 도울 일이 하나 더 있어.\n\n저 아래 센진 마을의 라르 프라울터스크가 골치 아픈 켄타우로스 무리를 처치하는 데 도움을 요청해 왔어. 내가 지원할 만한 게 없냐고 묻길래, 내가 뭐 폭탄을 만들어 주겠다고 했지. 낄낄.\n\n폭탄 말이야, $N.\n\n조잡한 구리 폭탄 한 무더기면 그 친구도 개인 무기고를 갖춘 기분일걸.",
  },
  [28451] = {
    ["T"] = "멜로르 스톤후프의 의뢰",
    ["O"] = "트위직 스프로켓그라인드가 기계공학 기술을 사용하여 굵은 붐스틱 1개를 만들어 멀고어 썬더 블러프에 있는 멜로르 스톤후프에게 전달해 달라고 합니다.",
    ["D"] =
    "칼림도어엔 기계공학자가 거의 없다 보니, 우리 기술의 수요가 끝내주지. 멜로르 스톤후프만 봐도 알 수 있어 -- 그 친구가 새 총을 구한다는 연락을 보내왔는데 내가 도통 시간이 안 나서 답장을 못 했거든. 의뢰를 놓치는 건 속 쓰리지만, 네가 선행을 좀 하고 싶다면 굵은 붐스틱을 하나 만들어서 썬더 블러프의 수렵의 봉우리에 있는 그 친구에게 전해 주면 돼.",
  },
  [28452] = {
    ["T"] = "바인 블러드후프의 의뢰",
    ["O"] = "트위직 스프로켓그라인드가 기계공학 기술을 사용하여 구리관 5개를 만들어 멀고어 블러드후프 마을에 있는 바인 블러드후프에게 가져다 달라고 합니다.",
    ["D"] =
    "나도 바인 블러드후프가 족장의 아들이고 기술이라면 질색한다는 건 잘 알아. 그리고 나도 인정하지, 투자개발회사나 탐험가 연맹이 멀고어에서 벌이는 짓거리가 타우렌 맘에 안 든다면 그건 잘못된 거지. 잠재 고객을 화나게 해선 안 되는 법이잖아!\n\n투자개발회사가 호수에 폐기물을 내버리고 있어서 바인이 그 기름과 진흙을 빼내려면 구리관이 좀 필요할 거야. 네가 기계공학(과 고블린)이 무언가를 날려버리는 것뿐만 아니라 돕는 데도 쓸모 있다는 걸 좀 보여줄래?",
  },
  [28453] = {
    ["T"] = "토마스 알렌도의 의뢰",
    ["O"] = "그레이엄 반 탈렌이 당신의 기계공학 기술을 이용해 아크라이트 스패너 2개를 만들어 티리스팔 숲 브릴에 있는 토마스 알렌도에게 배달해 달라고 합니다.",
    ["D"] =
    "죽음의경비병들이 데스넬에서 잠든 자들을 깨우기 시작한 이후로 내 기계공학 기술에 대한 수요가 꽤 많아졌어. 혼자 다 감당할 수 없을 정도로 밀려드는군.\n\n당신도 기계 쪽에 일가견이 있다면 이 주문을 하나 처리해 주겠나? 토마스 알렌도라는 자가 티리스팔 숲과 은빛소나무 숲을 가로지르는 수레들을 유지보수하는데 낡아빠진 스패너를 교체하겠다며 아크라이트 스패너 2개를 주문했네.\n\n이것들을 만들어 그에게 전해준다면 큰 도움이 될 거야.",
  },
  [28454] = {
    ["T"] = "죽음의경비병 리니아의 의뢰",
    ["O"] = "그레이엄 반 탈렌이 당신의 기계공학 기술을 이용해 조잡한 다이너마이트 20개를 만들어 티리스팔 숲 언더시티 동쪽 야영지에 있는 죽음의경비병 리니아에게 배달해 달라고 합니다.",
    ["D"] =
    "언더시티 외곽 도로에 야영 중인 죽음의경비병 리니아에게서 들어온 의뢰가 있네. 마을 동쪽 농장으로 스컬지 무리가 계속 침투해 와서... 뭐라도 해 보겠다며 조잡한 다이너마이트를 좀 달라는군. 글쎄, 난 뭐 그저 만들고 배달할 뿐이지. 자네가 이걸 좀 맡아 주겠나?",
  },
  [28455] = {
    ["T"] = "샘 요릭의 의뢰",
    ["O"] = "기욤 소로이가 당신의 기계공학 기술을 이용해 조잡한 조준경 2개를 제작하여 은빛소나무 숲 올슨 농장의 샘 요릭에게 가져다 달라고 합니다.",
    ["D"] =
    "나는 죽음의추적자가 필요로 하는 물품을 징발할 수 있는 권한을 받았소. 당신, 기계공학자 맞지? 올슨 농장에서 정찰 임무를 수행 중인 샘 요릭을 위한 조잡한 조준경이 필요하오. 그걸 쓰면 남쪽에서 공동묘지를 공격하는 적을 저격하는 데 큰 우위를 점할 수 있을 거요. 조준경 몇 개를 만들어서 전해주면 보상은 섭섭지 않게 해주겠소.",
  },
  [28456] = {
    ["T"] = "레인 요릭의 의뢰",
    ["O"] = "기욤 소로이가 기계공학 기술을 사용해 날쌘 호랑이 고글 1개를 제작하여 은빛소나무 숲 공동묘지 북쪽 길목에 있는 레인 요릭에게 배달해 달라고 합니다.",
    ["D"] =
    "죽음의추적자의 보급품 징발관으로서 레인 요릭에게 날쌘 호랑이 고글을 한 쌍 만들어 줄 것을 요청하오. 그녀는 홀로 공동묘지에서 북쪽으로 뻗은 길을 순찰하고 있는데, 날아드는 흙먼지와 강렬한 햇빛으로부터 눈을 보호해 줄 고글이 필요할 거요. 그것들을 그녀에게 배달해 준다면 참으로 고맙겠소.",
  },
  [28457] = {
    ["T"] = "셀그라 다크쏜의 의뢰",
    ["O"] = "가즈로가 기계공학 기술을 사용하여 표적 허수아비 5개를 만들어 불모의 땅 크로스로드의 셀그라 다크쏜에게 가져다 달라고 합니다.",
    ["D"] =
    "이 칼림도어 얼간이들 대부분은 기계공학의 진정한 힘을 이해하진 못하지만, 우리가 만드는 물건을 원한다는 것쯤은 알아. 그 말인즉슨 우리가 이 시장을 꽉 쥐고 있어서 감당 못 할 만큼 일거리가 넘쳐난다는 거지. 크로스로드의 대장인 셀그라 다크쏜을 봐. 그녀는 지금 표적 허수아비들을 찾고 있어. 난 지금 수중에 가진 게 없지만 만약 네가 제작할 생각이라면 그녀가 분명 두둑이 챙겨줄 거야.",
  },
  [28458] = {
    ["T"] = "웨니키 볼트버킷의 의뢰",
    ["O"] = "가즈로가 당신의 기계공학 기술을 사용하여 은 접점 20개를 만들어 불모의 땅 황금길 북쪽에 사는 웨니키 볼트버킷에게 가져다 달라고 합니다.",
    ["D"] =
    "내가 가지고 있지 않은 또 다른 물건은 은 접점이야. 북쪽 황금길에 사는 어떤 고블린이 그걸 사고 싶어 하더군. 배송 기간은 기다릴 수 있다고 하더라. 그가 뭘 만들고 있는지는 모르겠지만 네가 웨니키 볼트버킷을 위해 은 접점을 구해준다면 돈 냄새가 난다는 건 알지.",
  },
  [28459] = {
    ["T"] = "테터낵 스틸포지의 의뢰",
    ["O"] = "테터낵 스틸포지가 당신의 기계공학 기술을 사용하여 구리 변조기 5개를 만들어 불모의 땅 타우라조 야영지의 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "환영하네, $C. 대장장이가 기계공학자에게 도움을 청하는 게 조금 이상하긴 하지만 내 용광로를 계속 가동하려면 어쩔 수 없다네. 용광로를 돌리려면 구리 변조기가 다섯 개 필요해. 기꺼이 도와준다면 자네의 수고비에 보너스까지 얹어주지.",
  },
  [28460] = {
    ["T"] = "블루쉬트의 의뢰",
    ["O"] = "테터낵 스틸포지가 당신의 기계공학 기술을 사용하여 연습용 자물쇠 5개를 만들어 불모의 땅 남부 황금길 외곽의 불타버린 감시탑에 있는 블루쉬트에게 가져가 달라고 합니다.",
    ["D"] =
    "도움 얘기가 나와서 말인데 연습용 자물쇠를 구한다는 익명의 쪽지를 하나 받았지 뭔가. 누가 그런 걸 찾는지 모르겠지만 여기엔 그걸 만들 수 있는 기술자가 아무도 없어. 자네 지갑을 두둑하게 채우고 싶다면 쪽지에 적힌 대로 남쪽 황금길 근처, 불에 탄 호드 감시탑 근처에 자물쇠를 두고 오게나.",
  },
  [28461] = {
    ["T"] = "지리트의 의뢰",
    ["O"] = "지리트가 당신의 기계공학 기술을 사용해 정교한 망원경 1개를 만들어 잿빛 골짜기 토막나무 주둔지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "대족장께서 이곳 주둔지를 정비하라고 나를 보냈는데, 해야 할 일이 산더미더군. 순찰대는 있지만 여기 토막나무엔 쓸만한 정찰 장비가 하나도 없어.\n\n너 기계공학자지? 순찰대원들이 길을 살피고 일꾼들을 감시하려면 정교한 망원경이 필요해. 값은 치르겠다.",
  },
  [28462] = {
    ["T"] = "톡카르의 의뢰",
    ["O"] = "가라쉬가 당신의 기계공학 기술을 사용해 수중 유인기 10개를 만들어 슬픔의 늪 안개갈대 주둔지의 톡카르에게 가져가 달라고 합니다.",
    ["D"] =
    "어이, $C. 우리가 동쪽 바다로 선발 정찰대를 보냈는데 녀석들은 우리 식량 보급을 확보하는 임무를 맡고 있지. 바다에서 물고기를 잡는 데 수중 유인기라는 미끼가 아주 요긴하다고 들었어. 신선하게 잡은 물고기를 꼭 한번 먹어보고 싶군! 그거 만들 줄 아는 사람 혹시 아나?",
  },
  [28463] = {
    ["T"] = "위즐로 베어링샤이너의 의뢰",
    ["O"] = "위즐로 베어링샤이너가 당신의 기계공학 기술을 사용해 표준형 조준경 2개를 만들어 버섯구름 봉우리 하얀여울 주둔지의 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "이봐, 기계공학자야? 아주 좋았어! 짐마차를 이끌고 다시 길을 나설 준비를 하고 있는데 켄타우로스 놈들이 보일 때마다 바로 박살을 내주려면 표준형 조준경이 두어 개 필요하거든. 날 좀 도와주겠어?",
  },
  [28464] = {
    ["T"] = "지즈 피직스의 의뢰",
    ["O"] = "디트시 스프링스프로켓이 기계공학 기술을 사용하여 강한 다이너마이트 20개를 제작해 돌발톱 산맥 칼바람 벼랑에 있는 지즈 피직스에게 배달해 달라고 합니다.",
    ["D"] =
    "나도 기계공학자이긴 하지만 당장은 일을 받을 여유가 없어. 지금 내 프로젝트를 진행 중이거든. 그렇다고 사람들이 내게 도움을 청하지 않는 건 아니지!\n\n일손이 하나 필요한데, 정확히 말하자면 지즈 피직스가 당신의 도움을 필요로 하고 있어.\n\n당신이 강한 다이너마이트를 좀 만들어서 칼바람 벼랑 아래에 있는 피직스의 작업장에 전해주면 돼.",
  },
  [28465] = {
    ["T"] = "사령관 아그로고쉬의 의뢰",
    ["O"] = "오글소프 오브노티쿠스가 기계공학 기술을 사용해 커다란 청동 폭탄 20개를 제작하여 가시덤불 골짜기 그롬골 주둔지에 있는 사령관 아그로고쉬에게 배달해 주길 원합니다.",
    ["D"] =
    "반갑소, $N! 설령 자네가 호드일지라도 솜씨 좋은 기계공학 동지를 뵙는 일은 언제나 즐겁군.\n\n그나저나... 그롬골의 아그로고쉬 사령관에게서 커다란 청동 폭탄을 만들어 달라는 전갈을 받았다네. 나는 표면적으론 진영 간 분쟁에 중립을 지키고 있지만, 이 주문은 호드 기술자가 처리해 줬으면 해. 그래, 바로 자네 말일세!",
  },
  [28466] = {
    ["T"] = "타르그의 의뢰",
    ["O"] =
    "타르그는 당신의 기계공학 숙련도를 사용해 회전초시계 5개를 만들어 먼지진흙 습지대의 담쟁이 마을에 있는 타르그에게 배달하길 원합니다.",
    ["D"] =
    "타르그 제일 똑똑한 오우거 아니지만, 타르그 물건 안다. 그림자와 빛, 밝음과 어둠. 타르그 시간에 대해 궁금하다. 타르그 시간 보는 법 모르지만 회전초시계 시간에 유용한거 안다. 타르그에게 회전초시계 많이 가져오면 타르그 시간 많이 가진다!",
  },
  [28467] = {
    ["T"] = "호르니즈 브림버즐의 의뢰",
    ["O"] =
    "투크는 당신의 기계공학 숙련도를 사용해 견고한 다이너마이트 20개를 만들어 잊혀진 땅의 코도 무덤에 있는 호르니즈 브림버즐에게 배달하길 원합니다.",
    ["D"] =
    "그늘수렵 마을에 온 것을 환영해. 자네 기계공학자지? 손가락에 박힌 아크라이트 렌치 굳은살을 보면 알 수 있어. 열려있는 의뢰를 처리해 볼 텐가?\n\n코도 무덤 아래쪽에 사는 고블린이 견고한 다이너마이트를 좀 사겠다고 요청했어. 난 고블린 기계공학자에 대해 건전한 직업적 존경심을 갖고 있지만, 이 녀석은 연금술사라고.... 다이너마이트로 대체 뭘 하려는 건지 모르겠단 말이야. 이 의뢰를 원한다면, 모두 자네 차지야!",
  },
  [28468] = {
    ["T"] = "명사수 갈라마브의 의뢰",
    ["O"] =
    "니카 블러드스카는 당신의 기계공학 숙련도를 사용해 초정밀 고글 1개를 만들어 황야의 땅의 카르가스에 있는 명사수 갈라마브에게 배달하길 원합니다.",
    ["D"] =
    "명사수 갈라마브가 사격에 아무런 장비도 사용하지 않는다는 사실에 꽤 놀랐어. 내 생각엔 그가 기계공학이 그를 위해 뭘 해줄 수 있는지 모르는 것 같아 -- 초정밀 고글 같은 것 말이야! 혹시 고글을 어디서 구할 수 있는지 모르나?",
  },
  [28469] = {
    ["T"] = "낚시꾼 카툼의 의뢰",
    ["O"] =
    "낚시꾼 카툼은 당신의 기계공학 숙련도를 사용해 미스릴 관 5개를 만들어 동부 내륙지의 레반터스크 마을에 있는 낚시꾼 카툼에게 배달하길 원합니다.",
    ["D"] =
    "낚시하나, $N? 난 낚시를 좋아하는데, 썩은가지부족 트롤 녀석들이 내가 가장 좋아하는 낚시터에서 날 쫓아냈을 때 가장 아끼는 낚싯대를 잃어버리고 말았어.\n\n마을에 기계공학자가 없어서 언제 새 낚싯대를 얻을 수 있을지 모르겠군. 혹시 미스릴 관을 우연히 발견하게 된다면, 자네 친구 카툼을 생각해 주겠나? 그걸로 새 낚싯대를 만들 수 있을 거야.",
  },
  [28470] = {
    ["T"] = "레미 콜드아이의 의뢰",
    ["O"] =
    "레미 콜드아이는 당신의 기계공학 숙련도를 사용해 고급 표적 허수아비 2개를 만들어 타나리스의 안제와타에 있는 레미 콜드아이에게 배달하길 원합니다.",
    ["D"] =
    "훈련시켜야 할 그런트들은 많은데, 나누어 줄 방어구가 부족해, $N. 방어구가 만들어지길 기다리는 자들은 부상을 피하기 위해 조심스럽게 대련해야만 하지. 자네가 나설 차례야 -- 자네가 오기도 전부터 자네의 기계공학 솜씨에 대한 소문이 자자했네. 신병들을 위해 고급 표적 허수아비가 좀 필요한데, 도와주겠나?",
  },
  [28471] = {
    ["T"] = "비고의 의뢰",
    ["O"] =
    "신드라 톨그래스는 당신의 기계공학 숙련도를 사용해 불안정한 방아쇠 5개를 만들어 페랄라스의 글루크의 야영지에 있는 비고에게 배달하길 원합니다.",
    ["D"] =
    "당신 혹시 기계공학자야? 미안해... 그냥 그런 모습이라서 말이야.\n\n얼마 전에 한 고블린이 찾아와 불안정한 방아쇠를 찾더군. 난 그런 종류의 물건은 재고로 두지 않지만, 그가 말하길 만약 기계공학자가 온다면 자신이 글루크의 야영지에 머물고 있을 거라고 했어. 숲의 위험을 감수하고 갈 수 있다면 동전을 좀 만질 좋은 기회가 될지도 몰라!",
  },
  [28472] = {
    ["T"] = "제시 문보우의 의뢰",
    ["O"] =
    "알트소바 레이지토템은 당신의 기계공학 숙련도를 사용해 치명적인 조준경 2개를 만들어 악령숲의 에메랄드 성소에 있는 제시 문보우에게 배달하길 원합니다.",
    ["D"] =
    "오! 기계공학자군! 손톱 밑에 낀 때만 봐도 어디서든 알아볼 수 있지!\n\n저기, 고용될 생각 있나? 내가 에메랄드 성소에 내려갔을 때, 한 나이트 엘프가 치명적인 조준경을 좀 사고 싶어 했지. 양심상 나이트 엘프에게 팔 수는 없지만, 그녀는 세나리온 의회의 일원이야. 이 일에 관심이 있다면, 길을 따라 남쪽으로 가면 그녀를 찾을 수 있을 거야.",
  },
  [28473] = {
    ["T"] = "혈투사 글루쉬의 의뢰",
    ["O"] =
    "그룰 다크블레이드는 당신의 기계공학 숙련도를 사용해 고성능 폭탄 20개를 만들어 아즈샤라의 발로르모크에 있는 혈투사 글루쉬에게 배달하길 원합니다.",
    ["D"] =
    "매일 식사 시간마다 멀록의 위협에 대한 이야기만 듣는다네. 므르르글글 어쩌고 롸아아글 어쩌고. 혈투사 글루쉬는 완전히 그 녀석들에게 집착하고 있어.\n\n우리 마을에는 기계공학을 할 수 있는 대장간이 없지만, 만약 자네가 다른 곳에서 고성능 폭탄을 좀 만들어 글루쉬에게 전달해 준다면, 그가 \"멀록의 위협\"으로부터 안전하다고 느끼고 입을 다물지도 모르지!",
  },
  [28474] = {
    ["T"] = "탐네르 폴의 의뢰",
    ["O"] =
    "탐네르 폴은 당신의 응급치료 숙련도를 사용해 리넨 붕대 20개를 만들어 던 모로의 카라노스에 있는 탐네르 폴에게 배달하길 원합니다.",
    ["D"] =
    "카라노스가 자기 자신을 증명하길 열망하는 젊고 싱싱한 신병들로 빠르게 채워지고 있네. 그리고 훈련은 타박상, 찰과상, 분별력보다 큰 자만심을 동반하지.\n\n우리 붕대 재고가 바닥을 보이고 있어. 자네가 리넨 붕대 20개를 가져다준다면, 이 가벼운 부상들이 더 악화되기 전에 계속 치료할 수 있을 게야.",
  },
  [28475] = {
    ["T"] = "고고학자 에버릿의 의뢰",
    ["O"] =
    "고고학자 호올리는 당신의 응급치료 숙련도를 사용해 두꺼운 리넨 붕대 20개를 만들어 어둠해안의 렘트래블의 발굴현장에 있는 고고학자 에버릿에게 배달하길 원합니다.",
    ["D"] =
    "렘트래블의 발굴현장에 있는 고고학자 에버릿으로부터 그들이 발굴한 골렘들과 관련된 가벼운 사고들이 몇 번 있었다는 소식을 들었어.\n\n응급치료로 상처를 감싸는 기술을 알고 있나? 그렇다면 두꺼운 리넨 붕대를 좀 만들어 발굴지의 에버릿에게 배달해 줄 수 있겠나? 길을 따라 남쪽으로 꽤 멀리 가야 해.",
  },
  [28476] = {
    ["T"] = "순찰대원 도즈의 의뢰",
    ["O"] =
    "브링크 스패너크랭크는 당신의 응급치료 숙련도를 사용해 해독제 3개를 만들어 그늘숲 중심부의 야경대 야영지에 있는 순찰대원 도즈에게 배달하길 원합니다.",
    ["D"] =
    "난 독에 대해 잘 안다네, $C. 독을 연구하고, 끓이고, 치료해왔지. 이 숲에서는? 거미에 한두 번 물릴 것에 대비하는 게 좋을 거야.\n\n거미에 물렸을 때 야경대에게 실질적인 자원이 좀 필요해. 해독제 3개를 순찰대원 도즈에게 가져다주게. 화려하진 않지만, 순찰대원들이 도랑에서 죽어가는 대신 두 발로 서 있게 해줄 걸세.",
  },
  [28477] = {
    ["T"] = "에이미 데이븐포트의 의뢰",
    ["O"] =
    "에이미 데이븐포트는 당신의 응급치료 숙련도를 사용해 양모 붕대 20개를 만들어 붉은마루 산맥의 레이크샤이어에 있는 에이미 데이븐포트에게 배달하길 원합니다.",
    ["D"] =
    "저기, 가방에 있는 거 붕대인가요? 당신의 도움이 필요해요. 산등성이 근처에서 경비병 몇 명이 너무 대담하게 굴다가 오크 순찰대와 정면으로 맞닥뜨리고 말았어요. 지금은 레이크샤이어로 돌아왔지만, 음... 그들 중 일부는 한동안 경비 임무를 나가지 못할 것 같아요.\n\n의료품이 부족해요. 양모 붕대 20개를 가져다주시면 경비병들에게 확실히 전달할게요. 살아남은 게 다행이에요 -- 계속 살려두도록 하죠.",
  },
  [28478] = {
    ["T"] = "센트리카 나이트송의 의뢰",
    ["O"] =
    "센트리카 나이트송은 당신의 응급치료 숙련도를 사용해 두꺼운 양모 붕대 20개를 만들어 돌발톱 산맥의 돌발톱 숲에 있는 센트리카 나이트송에게 배달하길 원합니다.",
    ["D"] =
    "연금술은 경이롭지. 화상용 물약, 진통제 엘릭서, 체력 강장제... 하지만 어떤 상처에는, 때로는 깨끗한 천 조각과 안정된 손길만이 필요할 때가 있어.\n\n이 전초기지에는 치유사가 배치되어 있지 않다네, $C. 그러니 두꺼운 양모 붕대 20개를 가져다주게. 보급품이 있다면, 가벼운 상처를 치료하고 심각한 사태를 위해 연금술 보급품을 아낄 수 있을 거야.",
  },
  [28479] = {
    ["T"] = "렌도우의 의뢰",
    ["O"] =
    "렌도우는 당신의 응급치료 숙련도를 사용해 강력한 해독제 3개를 만들어 버섯구름 봉우리의 탈라나르에 있는 렌도우에게 배달하길 원합니다.",
    ["D"] =
    "와이번들이 이곳 숲 가장자리의 높은 하늘을 배회하고 있소. 빨리 조치를 취하지 않으면 그 녀석들의 독침은 빠르고 잔인하며 치명적이지. 우린 이미 짐말 두 마리를 잃었고, 정찰병 한 명도 잃을 뻔했소.\n\n응급치료에 능숙하군, 딱 봐도 알겠어. 강력한 해독제 3개가 필요하오. 독에 쏘인 다음 생물은 독이 온몸에 퍼지기 전에 돌아오지 못할지도 모르니, 우린 대비해야만 하오.",
  },
  [28480] = {
    ["T"] = "여관주인 핀미르의 의뢰",
    ["O"] =
    "여관주인 핀미르는 당신의 응급치료 숙련도를 사용해 두꺼운 비단 붕대 20개를 만들어 슬픔의 늪의 피난처에 있는 여관주인 핀미르에게 배달하길 원합니다.",
    ["D"] =
    "여기 피난처의 망명자들은 많은 것을 견뎌냈소. 질병, 부상, 그리고 파괴된 세계로부터의 긴 여정 사이에서, 그들에게 치료를 위해 남은 것은 거의 없소.\n\n두꺼운 비단 붕대 20개를 내어준다면, 가장 도움을 필요로 하는 드레나이들에게 전달하겠소. 큰 것은 아니지만, 부드러운 천 한 조각조차도 희망을 가져다줄 수 있다오.",
  },
  [28481] = {
    ["T"] = "베단 블루워터의 의뢰",
    ["O"] =
    "베단 블루워터는 당신의 응급치료 숙련도를 사용해 마법옷감 붕대 20개를 만들어 페랄라스의 페더문 요새에 있는 베단 블루워터에게 배달하길 원합니다.",
    ["D"] =
    "티란데 위스퍼윈드 님의 명을 받아 이곳을 고향으로 삼았던 고대 나이트 엘프들을 연구하러 왔어. 하지만 페랄라스의 폐허가 오래되고 위험하다는 것을 깨달았지. 떨어지는 돌, 날카로운 뿌리, 이끼 아래 숨겨진 것들. 연구를 제대로 하려면 가벼운 부상에 대비해야 해.\n\n출발하기 전에 검토할 게 많은데 당신의 도움이 필요해. 마법옷감 붕대 20개를 가져다줘. 찰과상과 염좌 때문에 탐험을 멈추지는 않겠지만, 치료하지 않은 채 내버려 두지도 않을 거야.",
  },
  [28482] = {
    ["T"] = "가빅 그라임세일의 의뢰",
    ["O"] =
    "가빅 그라임세일은 당신의 응급치료 숙련도를 사용해 비단 붕대 20개를 만들어 가시덤불 골짜기의 무법항에 있는 가빅 그라임세일에게 배달하길 원합니다.",
    ["D"] =
    "예전만큼 재빠르지가 않아, $N, 바다는 봐주지 않지. 거기서 긁힌 상처 하나가 순식간에 악화될 수 있어. 선장님은 항구에서 일을 다 보는 대로 즉시 출항할 준비를 갖추길 원하셔. 나는? 돛대에 다시 오르기 전에 휴식을 좀 취하고 싶군.\n\n그래! 비단 붕대 20개 좀 가져다주겠나? 커틀러스를 휘두를 순 있지만, 요새는 멀쩡히 버티기 위해 도움이 좀 더 필요해.",
  },
  [28483] = {
    ["T"] = "대족장 운갈의 의뢰",
    ["O"] =
    "대족장 운갈은 당신의 응급치료 숙련도를 사용해 두꺼운 마법옷감 붕대 20개를 만들어 아즈샤라의 검은아귀 마을에 있는 대족장 운갈에게 배달하길 원합니다.",
    ["D"] =
    "악마들은 불과 어둠으로 공격한다. 우리는 싸우지만, 부상자가 너무 많다.\n\n약초나 마법 없이도 상처를 낫게 하는 너희의 약과 천에 대해 들었다. 한번 시험해 보겠다. 두꺼운 마법옷감 붕대 20개를 가져와라, 그러면 너희의 방법이 우리 부족에 도움이 될지 확인하겠다.",
  },
  [28484] = {
    ["T"] = "리키 카트스파크의 의뢰",
    ["O"] =
    "리키 카트스파크는 당신의 응급치료 숙련도를 사용해 룬무늬 붕대 20개를 만들어 운고로 분화구의 공포의 터에 있는 리키 카트스파크에게 배달하길 원합니다.",
    ["D"] =
    "당신같이 솜씨 좋은 사람을 여기서 만나다니 다행이야, $C. 제이사는 아직 회복하지 못했어. 밖에서 그녀를 친 건 단순한 이빨과 발톱이 아니었어. 등 뒤에서 뿜어져 나오는 분노였고, 그녀의 회복에는 오랜 시간이 걸릴 거야.\n\n그녀를 안정시키느라 붕대 재고의 대부분을 썼어. 더 필요해. 룬무늬 붕대 20개를 가져다주면, 그녀의 회복에 큰 도움이 될 거야.",
  },
  [28485] = {
    ["T"] = "멀그리스 딥리버의 의뢰",
    ["O"] =
    "멀그리스 딥리버는 당신의 응급치료 숙련도를 사용해 두꺼운 룬무늬 붕대 20개를 만들어 서부 역병지대의 고통의 흉가에 있는 멀그리스 딥리버에게 배달하길 원합니다.",
    ["D"] =
    "나를 동정하지 마오, $C. 내 생명은 끝을 향해 가고 있으니... 상처는 너무 많고, 빛은 너무 희미하오. 하지만 아주 희미할지라도 일말의 희망은 남아 있소.\n\n두꺼운 룬무늬 붕대 20개를 가져다주면, 어쩌면 버텨낼 수 있을지도 모르오... 이 숲 위로 떠오르는 일출을 한 번만 더 볼 수 있을 때까지.",
  },
  [28486] = {
    ["T"] = "비라 영후프의 의뢰",
    ["O"] =
    "비라 영후프는 당신의 응급치료 숙련도를 사용해 리넨 붕대 20개를 만들어 멀고어의 블러드후프 마을에 있는 비라 영후프에게 배달하길 원합니다.",
    ["D"] =
    "야영지가 자기 자신을 증명하길 열망하는 젊은 전사들과 싱싱한 발굽들로 빠르게 채워지고 있습니다. 그리고 훈련은 타박상, 찰과상, 분별력보다 큰 자만심을 동반하죠.\n\n우리 붕대 재고가 바닥을 보이고 있습니다. 당신이 리넨 붕대 20개를 가져다준다면, 이 가벼운 부상들이 더 악화되기 전에 계속 치료할 수 있을 겁니다.",
  },
  [28487] = {
    ["T"] = "레인 요릭의 의뢰",
    ["O"] =
    "고위집행관 하드렉은 당신의 응급치료 숙련도를 사용해 두꺼운 리넨 붕대 20개를 만들어 은빛소나무 숲 북쪽 농장에 있는 레인 요릭에게 배달하길 원합니다.",
    ["D"] =
    "실종된 죽음의 추적자들을 찾으러 나갈 생각이라면, 그들에게 필요할 만한 것을 준비해 두는 게 좋을 거다.\n\n두꺼운 리넨 붕대를 말하는 거다, $C. 한 뭉치 만들어서 요릭 형제를 찾을 때 챙겨가라.",
  },
  [28488] = {
    ["T"] = "마그그랜 어스바인더의 의뢰",
    ["O"] =
    "탐라 윈드필드는 당신의 응급치료 숙련도를 사용해 해독제 3개를 만들어 돌발톱 산맥의 해바위 야영지에 있는 마그그랜 어스바인더에게 배달하길 원합니다.",
    ["D"] =
    "난 독에 대해 잘 안다네, $C. 그것들은 대지의 방어 수단 중 하나이며, 이 산에서는? 거미에 물리거나 와이번에 쏘일 것에 대비하는 게 좋을 거야... 둘 다 겪고 싶지 않다면!\n\n이곳에 주둔 중인 그런트들에겐 독에 대비한 실질적인 자원이 좀 필요해. 해독제 3개를 마그그랜 어스바인더에게 가져다주게. 우린 독의 근원을 사용해 그 독을 치료할 거야.",
  },
  [28489] = {
    ["T"] = "칼리야 스톰슈의 의뢰",
    ["O"] =
    "칼리야 스톰슈는 당신의 응급치료 숙련도를 사용해 양모 붕대 20개를 만들어 불모의 땅의 타우라조 야영지에 있는 칼리야 스톰슈에게 배달하길 원합니다.",
    ["D"] =
    "저기, 가방에 있는 거 붕대인가요? 당신의 도움이 필요해요. 대자연에 용감히 맞서고 싶지만, 그전에 필요한 보급품이 몇 가지 있어요. 무기, 식량, 그리고 당신이 도와줄 수 있는 물건 하나요!\n\n의료품이 부족해요. 양모 붕대 20개를 가져다주시면 요긴하게 쓰겠다고 약속할게요. 여기에 있는 것도 다행이니까요 -- 계속 살려두도록 하죠.",
  },
  [28490] = {
    ["T"] = "연금술사 라이던의 의뢰",
    ["O"] =
    "연금술사 라이던은 당신의 응급치료 숙련도를 사용해 두꺼운 양모 붕대 20개를 만들어 힐스브래드 구릉지의 타렌 제분소에 있는 연금술사 라이던에게 배달하길 원합니다.",
    ["D"] =
    "연금술은 경이롭지, $N. 화상용 물약, 진통제 엘릭서, 체력 강장제... 하지만 어떤 상처에는, 때로는 깨끗한 천 조각과 안정된 손길만이 필요할 때가 있어.\n\n내 보급품은 너무 귀중해서 치유 물약으로 낭비할 수 없다네. 그러니 두꺼운 양모 붕대 20개를 가져다주게. 보급품이 있다면, 경비병들의 가벼운 상처를 치료하고 심각한 사태를 위해 연금술 보급품을 아낄 수 있을 거야.",
  },
  [28491] = {
    ["T"] = "엘루의 의뢰",
    ["O"] =
    "엘루는 당신의 응급치료 숙련도를 사용해 강력한 해독제 3개를 만들어 버섯구름 봉우리의 높새바람 봉우리에 있는 엘루에게 배달하길 원합니다.",
    ["D"] =
    "와이번들이 이곳 봉우리의 높은 하늘을 배회하고 있습니다. 전 그 녀석들을 흠모하지만, 빨리 조치를 취하지 않으면 그 독침이 빠르고 잔인하며 치명적이라는 사실은 인정해야 합니다. 최근 우린 짐꾼 코도 두 마리를 잃었고 정찰병 한 명도 잃을 뻔했습니다.\n\n응급치료에 능숙하시군요, 딱 봐도 알겠습니다. 강력한 해독제 3개가 필요합니다. 독에 쏘인 다음 생물은 독이 온몸에 퍼지기 전에 돌아오지 못할지도 모르니, 우린 대비해야만 합니다.",
  },
  [28492] = {
    ["T"] = "벤고르의 의뢰",
    ["O"] =
    "벤고르는 당신의 응급치료 숙련도를 사용해 두꺼운 비단 붕대 20개를 만들어 슬픔의 늪의 스토나드에 있는 벤고르에게 배달하길 원합니다.",
    ["D"] =
    "온몸이 쑤시는군, $C. 하지만 치유 마법으로 나를 건드릴 생각은 하지 마라. 난 이 \"빛\" 따위와 엮이고 싶지 않다.\n\n전통적인 의학이 내 상처에 듣겠지. 아니면 죽음을 받아들이겠다. 두꺼운 비단 붕대 20개를 내어준다면, 다시 두 발로 설 수 있을지도 모르겠군.",
  },
  [28493] = {
    ["T"] = "블라이즈 몽고메리의 의뢰",
    ["O"] =
    "블라이즈 몽고메리는 당신의 응급치료 숙련도를 사용해 마법옷감 붕대 20개를 만들어 페랄라스의 모자케 야영지에 있는 블라이즈 몽고메리에게 배달하길 원합니다.",
    ["D"] =
    "학자들의 명을 받아 이곳을 고향으로 삼았던 고대 나이트 엘프들을 연구하러 왔지만, 페랄라스의 폐허가 오래되고 위험하다는 것을 깨달았소. 연구를 제대로 하려면 가벼운 부상에 대비해야 하오. 여기서 추가 보급품 우편을 기다리고 있었는데 웬일인지 도착하지 않고 있소.\n\n출발하기 전에 검토할 게 많은데 당신의 도움이 속도를 내는 데 큰 도움이 될 거요. 마법옷감 붕대 20개를 가져다주시오. 찰과상과 염좌 때문에 탐험을 멈추지는 않겠지만, 치료하지 않은 채 내버려 두지도 않을 거요.",
  },
  [28494] = {
    ["T"] = "제이슨 마더스의 의뢰",
    ["O"] =
    "제이슨 마더스는 당신의 낚시 숙련도를 사용해 빛나는 작은 물고기 20마리를 모아 엘윈 숲의 수정 호수에 있는 제이슨 마더스에게 배달하길 원합니다.",
    ["D"] =
    "작은 물고기가 다 떨어졌어. 오늘 아침 마지막 남은 놈들을 물건을 갖겠다고 싸울 기세였던 요리사에게 팔아버렸지.\n\n낚싯대가 있고 손이 안정적이라면 신선한 어획물이 좀 필요해. 빛나는 작은 물고기 20마리를 가져다줘. 이 근처 사람들은 내가 물고기를 잘 비치해 두길 기대하고, 난 사람들을 돌려보내기 시작하는 건 질색이거든.",
  },
  [28495] = {
    ["T"] = "민병대원 가리엘의 의뢰",
    ["O"] =
    "민병대원 가리엘은 당신의 낚시 숙련도를 사용해 매끌매끌한 고등어 20마리를 모아 서부 몰락지대의 감시의 언덕에 있는 민병대원 가리엘에게 배달하길 원합니다.",
    ["D"] =
    "스톰윈드에 우리 사람들을 위한 식량을 더 요청했지만, 돌아오는 건 관료주의적 절차뿐이다. 민병대에게 필요한 건 약속이 아니라 단백질이다.\n\n또다시 보급품이 부족한데, 지금은 소금에 절인 고기보다 신선한 생선이 더 구하기 쉽다. 낚싯대가 있군. 이 배고픈 사람들을 배불리 먹이는 걸 도와줄 수 있나? 가능하다면 매끌매끌한 고등어 20마리를 잡아서 여기 감시의 언덕에 있는 나에게 가져다 다오.",
  },
  [28496] = {
    ["T"] = "할 맥알리스터의 의뢰",
    ["O"] =
    "할 맥알리스터는 당신의 낚시 숙련도를 사용해 긴주둥이진흙통돔 20마리를 모아 힐스브래드 구릉지의 사우스쇼어에 있는 할 맥알리스터에게 배달하길 원합니다.",
    ["D"] =
    "오늘 아침에 마지막 진흙통돔을 요리했지. 정오가 되기도 전에 다 팔렸어! 약간의 향신료와 뜨거운 프라이팬만 있으면 사람들은 이 물고기에 환장하거든.\n\n낚시할 시간이 있다면 긴주둥이진흙통돔 20마리만 가져다줘. 요리는 내가 맡을 테니 -- 자넨 계속 공급만 해주면 돼.",
  },
  [28497] = {
    ["T"] = "워그 딥워터의 의뢰",
    ["O"] =
    "워그 딥워터는 당신의 낚시 숙련도를 사용해 호수프렌지 20마리를 모아 모단 호수의 대호수에 있는 워그 딥워터에게 배달하길 원합니다.",
    ["D"] =
    "이 근방에 새로 온 $g어부:어부;신가? 낚시 대결 한번 어때? 자네가 바늘에 미끼를 꿰는 법을 알기도 전부터 난 호수프렌지를 낚아 올리고 있었어. 내 어획량을 이길 수 있을 것 같나?\n\n호수프렌지 20마리를 가져와서 자네 실력을 한번 보자고. 내가 그날 가장 큰 놈을 잡아도 삐치지는 말고.",
  },
  [28498] = {
    ["T"] = "파수꾼 오나에야의 의뢰",
    ["O"] =
    "파수꾼 오나에야는 당신의 낚시 숙련도를 사용해 표범메기 20마리를 모아 잿빛 골짜기의 마에스트라 주둔지에 있는 파수꾼 오나에야에게 배달하길 원합니다.",
    ["D"] =
    "마에스트라 주둔지의 파수꾼들은 보급품이, 특히 신선한 식량이 부족해지고 있다. 밤낮으로 정찰을 할 때 육포만으로는 버티는 데 한계가 있지.\n\n표범메기 20마리가 있으면 좋겠어. 소화가 잘 되고 영양가도 높으며 작은 불에 굽기 쉽지. 낚아올 수 있다면 낭비되는 일이 없게 하마.",
  },
  [28499] = {
    ["T"] = "킬륵스의 의뢰",
    ["O"] =
    "킬륵스는 당신의 낚시 숙련도를 사용해 무지개날개다랑어 20마리를 모아 불모의 땅의 톱니항에 있는 킬륵스에게 배달하길 원합니다.",
    ["D"] =
    "무법항부터 검은심연까지 낚시를 다녀봤지만, 무지개날개다랑어는 낚아본 적이 없어. 소문에 의하면 일출처럼 빛나고 맛은 두 배나 훌륭하다더군.\n\n무지개날개다랑어 20마리를 가져다줘. 내 눈으로 직접 보고 싶기도 하고, 나머지는 구워 먹어보려고. 보통 어떤 걸로 양념하나 몰라?",
  },
  [28500] = {
    ["T"] = "노인 헤밍의 의뢰",
    ["O"] =
    "노인 헤밍은 당신의 낚시 숙련도를 사용해 돌비늘대구 20마리를 모아 가시덤불 골짜기의 무법항에 있는 노인 헤밍에게 배달하길 원합니다.",
    ["D"] =
    "그저 물가에 앉아 소리에 귀를 기울여본 적 있나? 거기에 바로 기쁨이 있지. 황금도 아니고, 어획물도 아니야. 그저 평온함과 낚시를 던지는 것뿐.\n\n그래도... 우연히 돌비늘대구를 낚게 된다면 마다하진 않겠어. 그 생선들은 내가 왜 애초에 낚시를 시작했는지 떠올리게 해주거든.",
  },
  [28501] = {
    ["T"] = "스미드 스크래블스크류의 의뢰",
    ["O"] =
    "스미드 스크래블스크류는 당신의 낚시 숙련도를 사용해 기름기 많은 아귀 20마리를 모아 잊혀진 땅의 스크래블스크류의 야영지에 있는 스미드 스크래블스크류에게 배달하길 원합니다.",
    ["D"] =
    "저 밖에 있는 다른 고블린들은 이윤을 얻으려고 땅을 파고, 나무를 베고, 무언가를 폭파하고 있지. 아마추어들.\n\n땅이 끝나고 물이 시작된다는 사실을 무시해선 안 돼. 그리고 이윤도 거기서부터 시작되지! 무엇을 낚을지 안다면 바다엔 금화가 넘쳐난다고. 이를테면 기름기 많은 아귀 같은 것 말이야. 연금술사들이 최고가로 쳐주지.\n\n기름기 많은 아귀 20마리를 가져와. 그러면 저 땅 밟고 다니는 바보들에게 진짜 영리한 돈은 파도에서 온다는 걸 보여주겠어.",
  },
  [28502] = {
    ["T"] = "시몬 캔트렐의 의뢰",
    ["O"] =
    "시몬 캔트렐은 당신의 낚시 숙련도를 사용해 큰 표범메기 20마리를 모아 알터랙 산맥의 라벤홀트 장원에 있는 시몬 캔트렐에게 배달하길 원합니다.",
    ["D"] =
    "고향인 아스트라나르에서는 밋밋하면서도 부드럽고 섬세한 맛을 내는 표범메기를 아주 귀하게 여겼지. 알터랙, 그것도 더 큰 놈들을 이곳에서 보게 될 줄은 꿈에도 몰랐어!\n\n이 큰 표범메기는 옛 향수이자 깜짝 선물 같은 놈이야. 큰 표범메기 20마리를 가져다줘. 내 기억 속의 그 맛 그대로인지 알아보고 싶으니까.",
  },
  [28503] = {
    ["T"] = "\"늪지눈알\" 자를의 의뢰",
    ["O"] =
    "\"늪지눈알\" 자를은 당신의 낚시 숙련도를 사용해 수염메기 20마리를 모아 먼지진흙 습지대의 늪지기 오두막에 있는 \"늪지눈알\" 자를에게 배달하길 원합니다.",
    ["D"] =
    "늪지대에 사니까 사람들이 내가 물을 좋아한다고 생각하더군. 오해를 좀 풀지. 난 안 좋아해. 춥고 젖어 있는데다 어디에나 있으니까.\n\n하지만 물고기라면? 좋아하지. 특히 메기 말이야.\n\n수염메기 20마리를 가져오면 내 젖은 장화 핑계는 까맣게 잊어주지.",
  },
  [28504] = {
    ["T"] = "모렌 리버벤드의 의뢰",
    ["O"] =
    "모렌 리버벤드는 당신의 낚시 숙련도를 사용해 강철비늘송어 20마리를 모아 달숲의 나이트헤이븐에 있는 모렌 리버벤드에게 배달하길 원합니다.",
    ["D"] =
    "엘룬아라 호수에 강철비늘송어가 너무 많이 번식했소. 녀석들은 다른 물고기 무리를 몰아내고 갈대밭을 오염시키며 호수의 생태계를 파괴하고 있지.\n\n개체 수를 좀 줄여야 하오. 낚시할 줄 안다면 강철비늘송어 20마리를 낚아다 주시오. 생태계와 우리의 저녁 식탁에 모두 도움이 될 거요.",
  },
  [28505] = {
    ["T"] = "멕넬의 의뢰",
    ["O"] =
    "멕넬은 당신의 낚시 숙련도를 사용해 점박이노란방어 20마리를 모아 페랄라스의 글루크의 야영지에 있는 멕넬에게 배달하길 원합니다.",
    ["D"] =
    "글루크의 집행자들은 고기를 좋아해! 생선도 좋아해! 낚싯대 있네, 낚시 잘하네. 글루크의 친구들을 위해 점박이노란방어 많이 가져와. 그러면 우린 널 친구로 생각할게.",
  },
  [28506] = {
    ["T"] = "추방된 아탈라이트롤의 의뢰",
    ["O"] =
    "추방된 아탈라이트롤은 당신의 낚시 숙련도를 사용해 태양비늘연어 20마리를 모아 동부 내륙지의 샤드라알로에 있는 추방된 아탈라이트롤에게 배달하길 원합니다.",
    ["D"] =
    "추방 생활은 쓰디쓰다. 차가운 돌, 오래된 유령, 냄비엔 온기 한 점 없지.\n\n하지만 난 태양비늘연어의 맛을 기억해. 기름지고, 황금빛을 띠며, 오래전 잊힌 강의 온기를 한가득 머금고 있었지. 태양비늘연어 20마리를 가져와라, 그러면 단 한 끼 식사일지언정 어둠보다 더 나은 무언가를 기억해 낼 수 있겠지.",
  },
  [28507] = {
    ["T"] = "리키 카트스파크의 의뢰",
    ["O"] =
    "리키 카트스파크는 당신의 낚시 숙련도를 사용해 붉은퉁돔 20마리를 모아 운고로 분화구의 공포의 터에 있는 리키 카트스파크에게 배달하길 원합니다.",
    ["D"] =
    "저기, 가방에 묶여 있는 거 낚싯대 아니야? 우리 부탁 좀 들어줄래?\n\n제이사가 다쳐서 예정보다 오랫동안 대자연 속에 머무르게 되었는데, 이제 신선한 식량도 다 떨어졌어. 굶어 죽진 않겠지만 매일 같은 배급 식량만 먹는 건 좀... 지겹잖아!\n\n신선한 게 필요해. 거창한 거 말고! 자네가 기꺼이 낚시를 해준다면 붉은퉁돔 정도면 충분해.",
  },
  [28508] = {
    ["T"] = "요르바 스크류스피곳의 의뢰",
    ["O"] =
    "요르바 스크류스피곳은 당신의 낚시 숙련도를 사용해 유리비늘연어 20마리를 모아 타나리스의 스팀휘들 항구에 있는 요르바 스크류스피곳에게 배달하길 원합니다.",
    ["D"] =
    "케잔의 무역회사 우두머리들은 이렇게 말하지. \"배가 들어오기만을 가만히 앉아 기다리고 있지 마라.\"\n\n뭐, 내 배는 늦고 있고 난 확실히 그냥 여기에 앉아 있는 중이야. 그래서 생각했지 -- 차라리 뭔가 먹자고.\n\n유리비늘연어 20마리를 가져다줘. 크고 맛있고 불안한 내 신경 말고 씹을 거리를 줄 테니까.",
  },
  [28509] = {
    ["T"] = "아리덴 엘리스의 의뢰",
    ["O"] =
    "아리덴 엘리스는 당신의 낚시 숙련도를 사용해 은빛연어 20마리를 모아 저승바람 고개의 아리덴의 야영지에 있는 아리덴 엘리스에게 배달하길 원합니다.",
    ["D"] =
    "인정하건대, 내가 카라잔으로 돌아가려고 나섰을 때 내게 필요한 \"야전 식량\"의 규모를 다 생각하지 못했어. 저장식품은 듬뿍 챙겨 왔지만... 마을이나 심지어 장원에서 먹었던 것에 비하면 아무것도 아니었지.\n\n난 낚시 체질이 아냐 -- 너무 습하고 벌레도 많잖아. 하지만 은빛연어 20마리를 가져다준다면 병조림이 아닌 식사를 할 수 있어서 고마울 거야.",
  },
  [28510] = {
    ["T"] = "킴야엘의 의뢰",
    ["O"] =
    "킴야엘은 당신의 낚시 숙련도를 사용해 집게턱바닷가재 20마리를 모아 아즈샤라의 레가쉬 야영지에 있는 킴야엘에게 배달하길 원합니다.",
    ["D"] =
    "저주받을 블러드 엘프 놈들한테 쫓기다가 공책, 도구, 간식... 내 모든 걸 잃어버렸어. 가장 좋아하던 포크조차 아직 못 찾았지.\n\n지금 내게 정말 필요한 건 제대로 된 식사야. 집게턱바닷가재 20마리를 낚아다 주면, 앞으로 어떻게 할지 생각하는 동안 최소한 배를 따뜻하게 채울 수는 있을 테니까.",
  },
  [28511] = {
    ["T"] = "이자벨 픽맨의 의뢰",
    ["O"] =
    "이자벨 픽맨은 당신의 낚시 숙련도를 사용해 밤비늘통돔 20마리를 모아 서부 역병지대의 카엘 다로우에 있는 이자벨 픽맨에게 배달하길 원합니다.",
    ["D"] =
    "학생들이 갈수록... 안달하고 있어. 그들의 야망만큼이나 식욕도 채워질 줄 모르지 -- 의식의 방에서 쓰러지는 일이 또 생기면 학생 중 하나를 제물로 바쳐야 할지도 몰라. 게다가 학생들은 아직 살이 통통하게 오르지도 않았고.\n\n밤비늘통돔 20마리를 낚아와. 영양도 풍부하고 요리하기도 쉬운 데다, 학생들의 정신을 맑게 해줘서 한 번에 너무 많은 생선을 뜰 필요도 없게 만들어 주거든.",
  },
  [28512] = {
    ["T"] = "우탄 스틸워터의 의뢰",
    ["O"] =
    "우탄 스틸워터는 당신의 낚시 숙련도를 사용해 빛나는 작은 물고기 20마리를 모아 멀고어의 블러드후프 마을에 있는 우탄 스틸워터에게 배달하길 원합니다.",
    ["D"] =
    "물의 고요함, 낚싯줄이 당겨질 때의 느낌, 물고기를 낚아챌 때 사이의 정적과 비교할 만한 건 없소. 이것이야말로 대지모신과 그분이 창조한 모든 것들과 교감하는 방식이라오.\n\n나만큼 낚시를 즐긴다면 빛나는 작은 물고기 20마리를 가져다주시오. 거래용도 아니고 동전을 벌려는 것도 아니오. 그저 물고기를 낚는 즐거움을 나누고 싶을 뿐이라오.",
  },
  [28513] = {

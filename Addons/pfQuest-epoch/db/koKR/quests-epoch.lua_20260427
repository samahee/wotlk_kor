  [26171] = {
    ["T"] = "우아한 낙하",
    ["O"] = "샤드라알로 안에 있는 마른나무껍질 트롤들에게서 마른나무껍질 트롤의 숄 조각 8개와 완벽한 혈거미 비단 8개를 수집하십시오.",
    ["D"] =
    "저는 얼라이언스와 와일드해머 부족 간의 관계를 강화하는 것을 돕기 위해 수석 땜장이님께서 직접 이곳으로 파견하셨어요. 제 역할은 간단해요. 그들의 그리핀 비행을 더 안전하게 만드는 거죠.\n\n탑승자가 떨어지는 것을 감지하면 자동으로 펼쳐지는 낙하산을 만들 계획이에요. 훌륭한 생각이죠?\n\n하지만 이걸 만들려면 와일드해머 부족에게 없는 재료들이 필요해요. 첫 번째로 챙겨야 할 것은 낙하산 자체예요. 근처의 마른나무껍질 트롤들은 품질 높은 재봉 기술을 가지고 있고, 그들의 거미들은 징그럽긴 해도 훌륭한 실을 만들어내죠. 가서 그것들을 조금 구해다 주시면 이 낙하산 제작을 시작할 수 있어요.",
  },
  [26172] = {
    ["T"] = "우아한 낙하",
    ["O"] = "동부 내륙지 산속에서 루포 집코일을 찾으십시오.",
    ["D"] =
    "이 계획의 다음 단계는 바로 고도계예요! 간단히 말해서, 물체가 떨어지면? 고도계가 작동하죠. 쉽죠.\n\n불행히도 전 고도계를 가지고 있지 않아요. 우리 노움들은 이곳 동부 내륙지에 작은 전초기지를 하나 두고 있는데, 제 동료 중 한 명이 부품을 가지고 있을지도 몰라요. 가서 그와 이야기해 보시겠어요?\n\n이곳에서 동쪽 산맥 구석, 쿠엘다닐 오두막 북쪽의 비밀 전초기지에서 그들을 찾을 수 있을 거예요.",
  },
  [26173] = {
    ["T"] = "우아한 낙하",
    ["O"] = "아골와타 호수 바닥에서 고도계를 수집하십시오.",
    ["D"] =
    "아, 그러니까 티지가 고도계를 찾고 있군요? 우리한테 있긴 했어요, 핵심은 '했었다'는 거죠. 얼마 전에 아골와타 옆 호수에 실험 기구를 설치하다가 사고가 났고, 슬프게도 우리 장비 일부가 그대로 빠져버렸어요. 당신이 내려가서 그것들을 가져오면 당신이 찾는 고도계도 분명 그곳에 있을 거예요.",
  },
  [26174] = {
    ["T"] = "우아한 낙하",
    ["O"] = "흠집 없는 고도계를 맹금의 봉우리의 티지 스파크크래프트에게 가져가십시오.",
    ["D"] = "자, 스파크크래프트 양을 위한 흠집 없는 고도계입니다. 대체 이걸 어디에 쓰려는 걸까요? 자동 전개 낙하산... 흥미롭군요... 최종 기구의 적절한 시연을 준비해야겠어요.",
  },
  [26175] = {
    ["T"] = "우아한 낙하",
    ["O"] = "티지의 제트팩을 사용하여 공중 높이 솟구쳐 오르고 자동 전개 낙하산을 시험해 보십시오.",
    ["D"] =
    "때가 왔어요... 쇼 타임! 이걸 팔스타드에게 직접 가져가서 그가 이 멋진 광경을 가까이서 볼 수 있게 해주세요. 그리고 이 제트팩의 끈을 당기세요.\n\n순식간에 하늘 높이 솟아오를 거고, 당신이 떨어지는 순간 낙하산이 펼쳐질 거예요. 제 생각엔... 뭐, 확인해 볼 방법은 하나뿐이겠죠!",

  [26576] = {
    ["T"] = "암흑의 주술사",
    ["O"] = "남쪽 불타는 언덕 안에 있는 암흑 주술사 드레즈코와 암흑 주술사 엔위를 찾아 처치하십시오.",
    ["D"] =
    "드레즈코와 엔위가 바로 우리 진짜 적의 이름이오. 길게 말하지 않겠소 $N. 그저 그들을 처치하고 박살 낸 다음, 녀석들의 머리를 내게 직접 가져오시오. 내가 할 수 있는 최상의 보상을 내리겠소.",
  },
  [26577] = {
    ["T"] = "질 좋은 물약",
    ["O"] = "스프링소켓에 있는 드리즐에게 불타는 핵 10개를 가져다주십시오.",
    ["D"] =
    "고블린인 제가 물건을 이리저리 실험하고 만지작거리는 건 당연하죠. 지금 전 아제로스에 알려진 최고의 물약을 끓이고 있어요. 바로 여기 스프링소켓에서요! 그런데 꼭 필요한 재료 몇 개가 없어요. 제가 이 물약을 완성하려면 당신의 도움이 필요해요.\n\n첫 번째로 필요한 재료는 카르가스 바로 너머 능선, 서쪽 멀리 있는 정령들의 불타는 핵이에요. 이 불의 정령들은 지글거리고 타오르는데, 녀석들의 핵에는 정말 강력한 재료가 포함되어 있죠. 그 핵을 몇 개 가져다주면 물약 완성에 한 걸음 더 가까워질 겁니다.",
  },
  [26578] = {
    ["T"] = "질 좋은 물약",
    ["O"] = "스프링소켓에 있는 드리즐에게 응축된 물 10개를 가져다주십시오.",
    ["D"] =
    "제 목록에 있는 다음 재료는 아라시 고원에 있습니다. 구체적으로는 동쪽 봉인의 마법진에 있는 물의 정령들이죠. 녀석들은 일전에 당신이 제게 가져다준 불타는 핵과 결합할 아주 강력한 시약을 지니고 있거든요.\n\n정령을 물리치면 응축된 물로 변할 겁니다. 제가 물약 제조를 계속할 수 있도록 이것들을 제게 가져오세요.\n\n아라시 고원은 모단 호수와 저습지를 지나 훨씬 더 북쪽에 있습니다. 조심하세요, $N. 길고 위험한 여정이 될 테니까요.",
  },
  [26579] = {
    ["T"] = "질 좋은 물약",
    ["O"] = "스프링소켓에 있는 드리즐에게 갈아놓은 돌 1개를 가져다주십시오.",
    ["D"] =
    "마지막으로 우리에게 필요한 재료는 고통의 요새에 있어요. 드워프들이 거대한 바위 골렘을 깨웠거든요. 그리고 제 목록의 마지막 재료는 갈아놓은 돌이죠. 그 골렘들에게서 분명 최고의 견본을 구할 수 있을 거예요.\n\n고통의 요새는 여기서 북서쪽으로 가면 찾을 수 있습니다. 하지만 조심해요, 드워프들은 외부인에게 꽤나 배타적이거든요.",
  },
  [26580] = {
    ["T"] = "잃어버린 보물",
    ["O"] = "해머토의 발굴현장으로 떠나 보물을 발견할 수 있는 어떤 단서라도 찾아내십시오. 무언가 알아내면 스프링소켓의 누글에게 돌아가십시오.",
    ["D"] =
    "어둠괴철로단 드워프들이 여기서 북서쪽, 해머토의 발굴현장에서 굴착 작업을 시작했다는 소문을 들었습니다! 그들이 무엇을 발견했을지는 아무도 모르죠! 주변에 떠도는 소문에 따르면 그곳에 보물이 묻혀 있다는군요... 진귀한 보석과 부귀영화로 가득 찬 보물이요!\n\n제가 그 보물을 손에 넣는 걸 도와주신다면, 기꺼이 수익을 나누겠습니다. 일단 발굴지에 도착하면, 안도 다크섀도를 잘 주시하세요. 제 정보원에 따르면 그가 굴착 작업을 총괄하고 있으니, 그가 보물의 위치를 알고 있을 확률이 높거든요.",
  },
  [26581] = {
    ["T"] = "잃어버린 보물",
    ["O"] = "고통의 요새로 가서 어둠괴철로단 보물을 찾으십시오. 끝나면 스프링소켓에 있는 누글에게 돌아가십시오.",
    ["D"] =
    "안도의 몸에서 발견한 편지에 의하면 그 보물이 고통의 요새에 있답니다. 하지만 오랫동안 그곳에 머물진 않을 거예요! 드워프들이 머지않아 그걸 어둠괴철로단 도시로 싣고 갈 계획이거든요.\n\n우리가 이 보물을 손에 넣고 싶다면, 서둘러야 해요 $N. 여기서 북서쪽으로 가면 고통의 요새를 찾을 수 있겠지만 조심하세요... 어둠괴철로단이 가득한 요새니까요! 행운을 빕니다. 당신에겐 정말로 행운이 필요할 테니까요.",
  },
  [26582] = {
    ["T"] = "부적 갈취",
    ["O"] = "스프링소켓에 있는 조아킴 스파크루트에게 먼지목도리 부적 10개를 가져다주십시오.",
    ["D"] =
    "돈 버는 것 말고 고블린이 살아갈 이유가 어디 있겠습니까? 저 역시 마찬가지죠. 만약 당신이 고블린이라면, 당신도 똑같이 느낄 거라고 확신합니다! 어쨌든, 당신에게 짭짤한 보상이 될 만한 고부가가치 상품에 대한 정보를 입수했습니다.\n\n남서쪽으로 한참을 가다 보면 먼지목도리 소굴이 나옵니다. 여기서 어슬렁거리는 모든 오우거들의 본거지죠. 소문에 따르면, 놈들은 자신의 부족을 상징하는 부적을 달고 다닌다고 합니다. 그 부적을 만든 재료가 꽤 가치 있을지도 몰라요! 그 부적을 몇 개 구해 오세요, $N. 만약 가치가 있다면, 우리 둘 다 한 몫 챙길 수 있을 겁니다.",
  },
  [26583] = {
    ["T"] = "발굴현장 조사",
    ["O"] = "발굴현장을 조사하고 스프링소켓의 개플에게 돌아가십시오.",
    ["D"] =
    "이봐, 시간 좀 있어?\n\n북동쪽에 있는 발굴지에 대해 여관 녀석들이 얘기하는 걸 엿들었어. 이 주변에서 흔한 일은 아니지만, 내가 들은 바로는 꽤 거대한 작업장인가 봐. 그 녀석들도 그 배후가 누군지에 대해선 잘 몰랐지만, 일행 중 하나가 가까이 가서 보려다가 쫓겨났대.\n\n근데 넌 꽤 강해 보이니까, 날 위해 한 번 알아봐 주지 않을래? 네 조사가 쏠쏠한 수익으로 이어진다면, 이윤의 일부를 나눠 줄게.",
  },
  [26584] = {
    ["T"] = "빙클의 정의",
    ["O"] = "어둠괴철로단 발굴지에서 어둠괴철로단 채굴꾼 10명과 어둠괴철로단 감독관 10명을 처치하고 스프링소켓에 있는 빙클 스크류스닙에게 돌아가십시오.",
    ["D"] =
    "개플에게 어둠괴철로단이 근처에서 굴착 작업을 시작했다는 소식을 들었어요. 이건 제가 정의를 실현할 때가 왔다는 뜻이죠. 어둠괴철로단은 무자비하고, 전 반드시 갚아주어야 할 개인적인 원한이 있어요.\n\n수년 전, 제 아내 라크타가 어둠괴철로단에게 살해당했어요. 전 그날 제 반쪽을 잃었고, 그 이후로 단 한 번도 예전의 제 모습으로 돌아오지 못했죠. 전 여기서 스프링소켓을 위해 무기를 더 많이 만들어야 하는 신세지만, 전 당신이 가서 그 발굴현장에 있는 어둠괴철로단 놈들을 죽일 수 있는 한 많이 쓸어버려 주셨으면 해요. 제게 평온을 가져다주세요, $N.",
  },
  [26585] = {
    ["T"] = "개플을 위한 광석",
    ["O"] = "어둠괴철로단 발굴지에서 미스릴 상자 8개를 모아 스프링소켓에 있는 개플에게 돌아가십시오.",
    ["D"] =
    "그 광산은 광물들로 꽉 차 있을 거야! 만약 우리가 그걸 손에 넣는다면 얼마나 많은 돈을 벌 수 있을지 한번 상상해 보라고!\n\n이봐... 넌 꽤 능력 있어 보이는데, 한번 해보지 않을래? 그 안에서 캐고 있는 게 무슨 광석이든 몇 상자 가져다줘. 구매자는 내가 찾을 테니까 너한테 수수료의 일부를 떼어 줄게!",
  },
  [26586] = {
    ["T"] = "원시적인 유물",
    ["O"] = "스프링소켓에 있는 개플에게 원시적인 유물을 가져가십시오.",
    ["D"] = "어둠괴철로단 발굴 때문에 방해를 받은 듯한 대지의 정령을 쓰러뜨리셨군요. 정령이 이 유물을 떨어뜨렸습니다. 어쩌면 스프링소켓에 있는 개플이 흥미를 가질 만한 물건 아닐까요?",
  },
  [26587] = {
    ["T"] = "원시적인 유물",
    ["O"] = "만약 당신이 얼라이언스라면 해머토의 발굴현장 근처 드워프들에게, 호드라면 카르가스로 원시적인 유물을 가져가십시오.",
    ["D"] =
    "오해하지 말아요, 제게 이걸 가져다주신 건 감사해요. 하지만 요즘은 도처에 탐험가들이 깔려 있어서 박물관 물품은 돈이 안 되거든요.\n\n정말로 이런 것에 관심 있는 사람을 찾고 싶다면, 해머토의 발굴현장 근처에 있는 드워프들이 제격 아닐까요? 아니면 카르가스의 누군가라든가 - 제 생각엔 그들이 황야의 땅에 이런 걸 찾는 탐험대를 보냈던 것 같아요.",
  },
  [26588] = {
    ["T"] = "광부 구출",
    ["O"] = "얼음이빨 광산에 갇힌 광부들을 구출하십시오.",
    ["D"] =
    "그래서, 패기가 좀 있다는 건가? 그렇다면 너에게 맡길 임무가 또 하나 있지. 호드가 카르가스를 건설했을 때, 우리는 동쪽 바로 근처에 얼음이빨 광산을 열었어. 아무래도 굴착 작업이 그 지역 대지 정령들의 심기를 건드린 모양이야, 그놈들이 광산을 점령해버렸으니까!\n\n정령들이 미쳐 날뛸 때 대부분의 일꾼은 도망쳤지만, 아직 광산 안에 갇힌 사람들이 몇 명 남아 있어. 안으로 들어가서 그들이 무사히 빠져나올 수 있도록 확인해 다오.",
  },
  [26589] = {
    ["T"] = "광부 구출",
    ["O"] = "얼음이빨 광산 안의 퀘이크를 처치하고 가렉의 기묘한 광석을 회수하십시오.",
    ["D"] =
    "나는 칼림도어와 예전 드레노어에서 광산을 다녔지만, 정령들이 이렇게 조직적으로 움직이는 건 본 적이 없다네. 틀림없이 놈들에겐 우두머리가 있을 거야. 놈이 이동할 때마다 대지가 뒤흔들릴 정도로 무거운 정령이지. 그래서 나는 그 녀석에게 퀘이크라는 별명을 붙여주었지.\n\n정령들이 광산으로 쏟아져 들어왔을 때 나는 퀘이크를 따라 여기까지 왔다네. 그 녀석은 우리가 갓 캐낸 특별한 광석을 집어 들더니 자신의 몸에 흡수해버렸어. 그 순간 퀘이크는 뭔가... 어두워졌지. 녀석이 지나갈 때 숨어 있다가 광산 깊숙한 곳으로 들어왔네만.\n\n만약 돕고 싶다면, 퀘이크를 처치하고 그 광석을 회수해주게!",
  },
  [26590] = {
    ["T"] = "광부 구출",
    ["O"] = "기묘한 광석을 카르가스에 있는 니카 블러드스카에게 가져가십시오.",
    ["D"] =
    "좋소. 이제 당신이 광산을 모두 정리했으니, 나는 도구들을 최대한 회수하고 나서 여기에 있는 광부들을 모아 마을로 돌아가겠소. 이제 얼음이빨을 잃었으니, 어쩌면 칼림도어로 돌아갈지도 모르겠구려.\n\n하지만 당장은, 당신이 그 광석을 가지고 카르가스로 돌아가 무슨 일이 일어났는지 설명해 주시오.",
  },
  [26591] = {
    ["T"] = "기묘한 광석",
    ["O"] = "카르가스에 있는 역사가 레베카 켈러에게 기묘한 광석을 가져가십시오.",
    ["D"] =
    "저는 야금학자가 아니고, 지금 카르가스에는 금속 전문가가 한 명도 없습니다. 하지만 언더시티에서 온 현자 한 분이 최근에 도착했어요. 그들은 일종의 연구 단체 같은 곳인데 - 어쩌면 그 분이 이것이 무엇인지, 혹은 누구와 이야기해야 하는지 아실지도 몰라요.\n\n그녀의 이름은 레베카 켈러입니다. 불가 주변에 다른 포세이큰들과 함께 있어요.",
  },
  [26592] = {
    ["T"] = "기묘한 광석",
    ["O"] = "황야의 땅 고통의 요새에서 인듀리움 광석 8상자를 수집하십시오.",
    ["D"] =
    "이걸 얼음이빨 광산에서 구했다고? 엄청나군요! 하지만 순수한 인듀리움 광석을 발견한 것보다는 덜 놀랍죠. 우리가 아는 한, 이건 오직 울다만에서만 나옵니다. 그리고 울다만 주변 광산들은 어둠괴철로단에게 점령당했죠.\n\n하지만... 동쪽 고통의 요새에도 어둠괴철로단 기지가 있습니다. 울다만을 직접 공격하는 것보다 그곳을 치는 편이 더 쉬울 거예요. 만약 돕고 싶다면, $C, 고통의 요새로 가서 놈들의 인듀리움 저장고를 훔쳐오세요!",
  },
  [26593] = {
    ["T"] = "인듀리움 매트릭스",
    ["O"] = "울다만 안에서 인듀리움 매트릭스를 찾아 역사학자 레베카 켈러에게 가져가십시오.",
    ["D"] =
    "티탄은 셀 수 없이 오랜 옛날 아제로스 위를 거닐었던 고대 종족입니다. 세월이 흐르며 그들의 울다만 시설은 발굴되어 많은 이들의 거주지가 되었습니다. 수많은 비밀들이 도굴당했지만, 여전히 가장 깊은 방에는 옛 티탄의 방어 기재가 지키고 있는 곳이 있습니다.\n\n당신은 지금까지 충분히 유능한 모습을 보여주셨죠. 어쩌면 그 방어 기재들과 맞서볼 만한 상대가 아닐까요? 만약 놈들을 시험해 볼 생각이 있으시다면, 부탁드릴 임무가 하나 있습니다. 울다만의 가장 깊은 방들 안에는 인듀리움 매트릭스라는 티탄의 기계가 있을 겁니다. 만약 그걸 회수해 제게 가져다주신다면 섭섭지 않게 보상해 드리겠습니다.",
  },
  [26594] = {
    ["T"] = "수배: 스코치마우",
    ["O"] = "스코치마우를 처치하고 그의 머리를 스프링소켓의 더크 윈드래틀에게 가져가십시오.",
    ["D"] =
    "스프링소켓 동쪽 레슬로 협곡에는 스코치마우라는 위험한 비룡이 배회하고 있습니다. 수십 명을 죽음으로 몰고 간 장본인인 스코치마우는 가는 곳마다 파괴를 일삼습니다.\n\n스프링소켓의 뜻있는 시민 한 분이 이 짐승의 머리에 현상금을 걸었습니다. 스코치마우는 공격자에게 자비라곤 베풀지 않으니 모험가 여러분은 부디 동료를 데려가는 것을 권장합니다. 성공한다면 짐승의 머리를 스프링소켓 여관에 있는 더크 윈드래틀에게 가져가십시오.",
  },
  [26595] = {
    ["T"] = "마법의 메달",
    ["O"] = "마법의 메달을 감정해 줄 사람을 찾으십시오.",
    ["D"] =
    "검은바위 산을 흐르는 용암의 엄청난 열기에도 전혀 손상되지 않은 이 메달에는 틀림없이 강력한 마법이 깃들어 있을 것입니다. 메달에는 토막으로 나누어진 원 또는 고리 형태의 단순한 문양이 새겨져 있습니다.\n\n당신은 이 문양이 낯설지만 세상 어딘가에는 필시 알고 있는 누군가가 있을 것입니다...",
  },
  [26596] = {
    ["T"] = "마법의 메달",
    ["O"] = "타나라신? 텐커리스? 타네라니사니? 뭔가 그런 이름인 곳에 있는 마본 리벳시커에게 마법의 메달을 가져가십시오!",
    ["D"] =
    "언젠가는 나도 직접 현장에 나가서 대단한 발견을 할 날이 오겠지만, 지금은 여기 톱니항에 있는 마본의 작업장이나 지키고 있죠. 그래도 당신이 가져온 부적을 보여주면 정말 좋아할 거예요. 그는 이상한 문양이 새겨진 오래된 물건들을 좋아하거든요. 사실 그게 그의 주특기이기도 하고요.\n\n그는 남쪽, 비행선을 타고 가야만 할 정도로 꽤 멀리 떨어져 있는 곳에 있습니다. 타나라신? 텐커리스? 타네라니사니? 뭐 그런 비슷한 이름의 곳이었어요!",
  },
  [26597] = {
    ["T"] = "마법의 메달",
    ["O"] = "마법의 메달을 운고로 분화구에 있는 얄루니 플레임워처에게 가져가십시오.",
    ["D"] =
    "아니? 검은바위 산에 있는 용암에 떠다니고 있는 걸 찾았다고? 글쎄, 최소한 재미있는 이야깃거리긴 하군. 어쩌면 그걸로 대지고리회의 심기를 거스르는 건 피할 수 있을지도.\n\n그래, 이 부적에는 대지고리회의 상징이 새겨져 있지. 알겠지만 걔들은 알 수 없는 고대의 주술사 같은 놈들이잖아. 아마도 자기들끼리만 비밀로 하는 정신 나간 마력을 부린다거나 어쩐다나.\n\n만약 당신이 이 작은 물건을 돌려주고 싶어 하는 착한 사람이라면, 원시 정령을 연구하는 대지고리회의 일원이 운고로 주변에 어슬렁거리고 있다는 얘기를 들은 적이 있어. 근데 여기...\n<마본이 메달을 조정합니다.>\n이걸 그냥 가지고 싶다면 새것처럼 말짱해. 이전에 주인이 누구였건 그자는 틀림없이 이게 더 이상 필요 없을 테니까...",
  },
  [26598] = {
    ["T"] = "빚 수금",
    ["O"] = "펠스톤 농장의 언데드에게서 존 테일러, 조엘 테일러, 조슈아 테일러를 처치하고 그록스의 상품을 챙기십시오.",
    ["D"] =
    "힘쓰는 일이 하나 있는데, 좀 도와줄래?\n\n여기 요새에 있는 삼형제 언데드 빈대 녀석들이 나한테 크게 빚을 졌거든. 지지난 번 우리가 여기 정박했을 때, 녀석들은 내가 파는 물건을 원했지만 당장 돈이 없었어. 다음번에 들를 때 갚겠다고 하길래 물건을 내어주기로 동의했지.\n\n근데 웬걸? 난 아직도 돈을 못 받고 있어! 고블린은 절대 잊지 않는다는 걸 똑똑히 알아둬, $R!\n\n한 놈은 내 지팡이를, 다른 놈은 시계를, 마지막 놈은 마법의 북을 가지고 있어. 내 물건을 돌려받기 위해서 뼈 몇 개를 부러뜨려야 한다 해도 난 신경 안 써. 내 말 무슨 뜻인지 알지?",
  },
  [26599] = {
    ["T"] = "부대 식량 조달",
    ["O"] = "잿빛갈기멧돼지에게서 유황 맛 고기 10개를 모으십시오.",
    ["D"] =
    "이런 곳에서는 항상 긍정적인 태도를 잃지 않는 게 중요하네만, 이 망할 놈의 요새에선 모두가 날 무시하는 기분이야? 너무 원망하진 말게. 삭막한 풍경, 끊이지 않는 번개, 당장이라도 깨어날 듯한 어둠의 문이라는 위협... 이곳에 주둔 중인 대다수의 사람들이 지쳐 있을 만도 하지.\n\n스트레스받는 근무지도 모자라 굶주림까지 더해지면 사람이 끔찍하게 변하거든. 다음 대규모 보급품이 도착할 때까지 비상식량으로 버티고 있는데... 그게 언제 올지는 아무도 모르지!\n\n이곳 동물들은 식용으로 적합하지 않지만, 나한테 좋은 계획이 하나 있네. 도와줄 텐가?\n\n이 지역을 배회하는 잿빛갈기멧돼지의 고기가 필요해. 할 수 있는 한 많이 가져다주게, 질긴 놈들은 되도록 피하고 말이야.",
  },
  [26600] = {
    ["T"] = "연금술이 정답이다",
    ["O"] = "네더가드 요새의 마법사 탑 안에 있는 니나 라이트브루와 대화하십시오.",
    ["D"] =
    "탑 위에 있는 니나 만나 봤어? 그녀는 이곳과 그늘숲을 오가며 연금술 재료를 팔고 있지.\n\n그녀가 연금술 자체에 진정한 열정이 있다고 내게 털어놓은 적이 있는데, 자신의 결과물에 자신이 없대. 이건 그녀가 실용적인 문제를 해결하도록 끌어들일 완벽한 기회야.\n\n어때, $N? 이 재료들을 먹을 수 있게 만들어 달라고 그녀에게 부탁해 볼 텐가? 아, 그리고 내가 안부 전한다고 전해주게나!\n\n<룬겔츠가 사람 좋은 미소를 지어 보입니다.>",
  },
  [26601] = {
    ["T"] = "점토 정화",
    ["O"] = "저주받은 땅 해안 근처의 점토 더미에서 붉은 점토 7개를 수집하십시오.",
    ["D"] =
    "그러니까... 이 악마 같은 고기를 연금술을 이용해 먹을 수 있는 걸로 바꿔보자는 계획이군요? 흠... 저도 확신할 수는 없지만, 시도해봐서 나쁠 건 없겠죠.\n\n<니나가 오랫동안 턱을 괴고 생각에 잠깁니다.>\n\n글쎄요, 말도 안 되는 소리처럼 들릴 수도 있지만... 우리가 이곳에서 타는 말들은 늪을 지나온 후면 종종 병에 걸리곤 해요. 하지만 도착했을 때 말들이 땅에 있는 점토 덩어리를 뜯어먹는 걸 봤어요. 그리고 다음 날이면 거짓말처럼 씻은 듯이 낫더라고요.\n\n아마도... 점토에 어떤 정화 작용을 하는 성분이 있는 게 아닐까요? 소량이라면 어디서든 구할 수 있겠지만 조수 간만의 차도 있고 하니 해안가 쪽이 구하기 더 수월할 거예요.",
  },
  [26602] = {
    ["T"] = "배급 준비 완료",
    ["O"] = "네더가드 요새 안에 있는 병참장교 룬겔츠에게 소식을 전하십시오.",
    ["D"] =
    "자, 이제 시험해 볼까요. 물을 끓이고, 으깬 숯, 타박풀, 그롬의 피를 넣고... 이제 점토를 넣습니다.\n\n<니나가 악취 나는 용액에 점토를 섞어 걸쭉하게 만듭니다.>\n\n밑져야 본전이죠...\n\n<혼합물이 고기에 닿자 격렬하게 지글거리며 끓어오릅니다. 상황이 진정되자 뭔가 제대로 되었다는 것이 분명해집니다.>\n\n오, 세상에... 냄새가 사라졌어요! 더 이상 끈적거리지도 않고, 색깔도 더 밝아졌네요, 심지어 고기가 조리된 것 같아요!\n\n<니나가 당신을 조심스럽게 바라보더니 조금 맛을 봅니다.>\n\n음... 나쁘지 않네요! 운이 좋았나 봐요, $N. 룬겔츠에게 이 기쁜 소식을 전해주는 게 어때요? 나머지 고기를 다 요리해서 나중에 가져다줄게요. 정말 고마워요!",
  },
  [26603] = {
    ["T"] = "정찰병 몰그리아",
    ["O"] = "저주받은 땅 해안가 어딘가에서 정찰병 몰그리아를 찾으십시오.",
    ["D"] =
    "마침 내가 찾던 그 $R이군, $N.\n\n아직 본 적이 없을지도 모르겠지만, 일부 정찰병과 보병들이 저주받은 땅에서 저주에 걸려 돌아오고 있다네. 시간 제한도 없고, 우리 흑마법사들도 처음 보는 종류지.\n\n그래서 이 사태를 조사하기 위해 남은 정찰병 중 한 명을 남쪽으로 파견했네만 자네라면 그녀와 손발이 잘 맞을 거라 생각하네. 다혈질이긴 하지만 자네가 잘 조율해주게. 그렇다고 그 황무지의 위험을 과소평가해서는 안 되네.\n\n마지막 보고서에 따르면 그녀와 상단이 저주받은 땅 해안에 있다고 하더군. 힘과 명예를, $N.",
  },
  [26604] = {
    ["T"] = "약골들 처치",
    ["O"] = "저주받은 땅에서 어둠의혈맹 이교도를 처치하십시오.",
    ["D"] =
    "파견 사령관께서 절 이곳으로 보내 정보를 수집하게 하셨죠. 이미 충분히 다 모았습니다! 이 이교도 놈들은 우리 옆구리에 곪은 상처와 같아요. 멀리서 우리를 괴롭히며 저주를 퍼트리고 있죠.\n\n<몰그리아가 근처에 있는 언데드에게 매서운 눈빛을 보냅니다. 언데드도 그녀의 노려보는 시선에 지지 않고 맞받아칩니다.>\n\n모두 죽여버려요, $N. 여기서 남서쪽에 있는 요새 외곽을 떠도는 쓰레기들부터 시작하세요. 그놈들의 피로 이 땅을 더 붉게 물들여줍시다. 호드를 위하여!",
  },
  [26605] = {
    ["T"] = "얼라이언스 처치",
    ["O"] = "네더가드 요새 주변 얼라이언스 병사들에게서 네더가드 휘장 16개를 수집하십시오.",
    ["D"] =
    "이교도들도 문제지만 저 얼라이언스 놈들을 보면 피가 거꾸로 솟아요. 지금이야 우리는 이 야영지에 손님으로 있는 처지니 예의를 지켜야겠지만... 저 쓰레기 같은 놈들이 지나가는 걸 볼 때면 이성을 잃을 것만 같아요! 저한테 권한이 있었다면 당장 네더가드 요새를 전면 공격했을 겁니다!\n\n제 상관은 악마들이 늪지로 향하는 것을 막기 위한 완충 지대로 그놈들이 필요하다고 하죠... 말도 안 되는 소리! 당신은 저와 같은 명령을 따르지 않으니 어서 가세요, $N. 네더가드 요새 주변의 병사들에게서 얼라이언스 휘장을 가져오면 두둑이 보상해 드리겠습니다.",
  },
  [26606] = {
    ["T"] = "마음껏 취하다",
    ["O"] = "저주받은 땅의 요새 무기고에서 네더가드 광석 선적품 10개를 훔치십시오.",
    ["D"] =
    "<토르스락이 고개를 돌려 오른쪽 눈으로 당신을 응시합니다.>\n\n눈이 멀었다고 해서, $C.... 좋은 기회를 못 본다는 건 아니오.\n\n스토나드로 돌아가 무기, 건물 유지보수, 수리에 쓸 금속이 필요하오. 여기서 북서쪽 언덕 위에 네더가드가 최고급 광석이 가득한 광산을 보유하고 있소. 보나 마나 스톰윈드에 있는 계집애 같은 대장장이들에게 배송할 박스들이 잔뜩 쌓여 있겠지.\n\n그 광석이 좀 필요하오, $C.",
  },
  [26607] = {
    ["T"] = "후천적 취향",
    ["O"] = "저주받은 땅 주변의 붉은바위 수정바실리스크들에게서 붉은바위 고기 10개를 수집하십시오.",
    ["D"] =
    "보급품이 떨어져 가고 있는데, 이 땅은 듀로타의 한여름보다 더 가혹합니다! 이 해부학 지식이 없다면 여기 있는 모든 것이 식용으로는 독이나 다름없죠.\n\n여기를 배회하는 붉은 바실리스크가 식용으로 도축하고 손질하기에 가장 쉽습니다. 다만 독이 퍼지기 전에 몸에서 머리를 떼어내고, 목구멍에 손을 넣어 주황색 독샘을 빼내는 것을 잊지 마십시오. 속도가 빠르지 않으면 고기가 상해버릴 테니까요.\n\n고기를 좀 가져오시면 요리를 시작하겠습니다! 걱정 마십시오, 음식은 나눠드릴 테니.",
  },
  [26608] = {
    ["T"] = "펠스톤 함락",
    ["O"] = "펠스톤 농장 내부의 거주자들에게서 너덜너덜한 귀 50개를 수집하십시오.",
    ["D"] =
    "저 요새는 이 땅의 골칫거리입니다. 우리가 \"지켜보며 관망\"하는 시간이 길어질수록, 그곳의 위험은 더욱 커지고 있습니다.\n\n제가 스토나드를 떠나기 전에 오그리마에 지원을 요청했습니다. 하지만 저 반대편 세상까지 소식이 전해지고, 그걸 또 나약한 놈들이 다른 서류더미와 섞어버리는 동안 우리가 여기 앉아 멍하니 기다리고 있어야만 한단 말입니까?!\n\n이제 지긋지긋합니다! 당신만의 전쟁 부대를 결성하십시오! 전리품을 가져오십시오, $N. 귀를 원합니다. 당신이 벌인 핏빛 축제의 증거를 보고 싶습니다! 요새로 진입하여 놈들의 두개골을 박살 내십시오. 호드를 위해 봉사하는 데 허락 따윈 필요 없습니다!",
  },
  [26609] = {
    ["T"] = "펠스톤 광산",
    ["O"] = "펠스톤 농장 내부 광산에서 펠스톤 금광석 30개를 수집하십시오.",
    ["D"] =
    "저기 저 언데드가 펠스톤 지하에 있는 광산에 대해 얘기해주었소. 녀석의 마지막 정보에 따르면 광맥은 아직도 무궁무진하고 이 지역에서 가장 규모가 크다더군.\n\n우리도 한몫 챙겨봅시다, $C. 이대로 가다간 요새 안에 살아남는 놈이 하나도 없을 테니까요. 다른 쥐새끼들이 배를 갈아타고 물건을 훔쳐 달아나기 전에 우리가 먼저 손을 씁시다.",
  },
  [26610] = {
    ["T"] = "스토나드에 보고",
    ["O"] = "슬픔의 늪 스토나드에 있는 파견사령관 루아그에게 보고하십시오.",
    ["D"] =
    "<몰그리아가 경례하며 빨간색 광택 밀랍이 찍힌 찢어진 두루마리를 건넵니다.>\n\n성공적인 임무라고 말할 수 있겠네요. 모두 당신 덕분입니다. 정말 칭찬해 마지않겠습니다, $N. 이제 이곳을 뒤로하고 떠나고 싶으실 테니, 스토나드의 파견 사령관에게 이 보고서를 가져가 주시길 바랍니다.\n\n호드의 적들을 처단한 영광만으로 충분하지 않으시다면, 사령관님께서 충분히 보상해 주실 겁니다.\n\n승리가 아니면 죽음을!",
  },
  [26611] = {
    ["T"] = "악당을 위한 휴식",
    ["O"] = "밤의 추적자 로스를 호위하여 펠스톤 농장 밖으로 탈출시키십시오.",
    ["D"] =
    "<가볍게 찌르자 희미하게 쉭쉭거리는 소리가 그의 입술 사이로 새어 나옵니다, 이내 언데드가 눈을 뜹니다.>\n\n너는 광신도가 아니로군? 도와줘, $C! 놈들이 내게 군단 마법을 쓰고 있어. 더 이상은 버티기 힘들어...\n\n여길 떠나야 해... 지금 당장! 고-고문관은 처리했나?\n\n우리가 여-여길 살아서 나간다면, 언더시티의 도-도적 지구에 있는 그레고리 찰스를 찾아가.",
  },
  [26612] = {
    ["T"] = "응답받은 기도",
    ["O"] = "성기사 셔먼을 펠스톤 요새 밖으로 호위하십시오.",
    ["D"] =
    "<인간이 눈을 깜빡이며 뜨더니 당신의 존재를 알아차립니다.>\n\n당신... 광신도가 아니군요? 오늘이 며칠이죠? 난 여길 나가야 해요!\n\n내 부대의 절반은 척후병들에게 도륙당했어요... 놈들은 남은 우리를 여기로 끌고 왔고, 이제 나만 남았군요.\n\n제발, 우린 떠나야 합니다! 빛의 가호로 우리가 탈출한다면... 빛의 가호로... 당신이 해낸 일을 스톰윈드 대성당의 그레이슨 섀도브레이커 경에게 전해주세요.",
  },
  [26613] = {
    ["T"] = "네더가드를 위한 원조",
    ["O"] = "네더가드 요새 안에 있는 감시자 마할 바에게 지원 요청서를 가져가십시오.",
    ["D"] =
    "<시체는 비교적 부패하지 않은 상태입니다. 드워프의 가슴에 난 너덜너덜한 상처에서 웅덩이가 질 정도로 많은 피가 땅으로 흘러나왔습니다.>\n\n<드워프의 장비는 손대지 않은 듯 보이고 낡은 배낭 안에서 네더가드 요새의 공식 서한으로 보이는 편지 한 통을 발견합니다.>",
  },
  [26614] = {
    ["T"] = "정보 수집",
    ["O"] = "저주받은 땅 곳곳의 어둠의혈맹 이교도에게서 이교도 저서 12묶음을 수집해야 합니다.",
    ["D"] =
    "어둠의혈맹은 우리가 어둠의 문을 주시하는 데 항상 걸림돌이 되어 왔소. 우리는 보통 산발적인 사건이나 언쟁 속에서 그들을 마주치곤 했지만, 그들은 점점 더 대담하고 조직적으로 변하고 있소. 우리가 파견한 정찰병 대부분이 돌아오지 않아서 그들의 성장을 감시할 수도 없는 노릇이오. 설상가상으로 적들은 우리가 치유할 수 없는 기이하고 새로운 마법 저주를 사용하고 있소.\n\n나는 이곳에서 무슨 일이 일어나고 있는지 호기심이 생기오. 우리의 대리인으로 나서주겠소? 어둠의혈맹 하급 조직원들이 최고의 정보원은 아니겠지만, 우리가 목격할 수 있는 유일한 자들이오. 이곳에서 남쪽에 있는 계곡의 그들부터 시작해서 그들이 가지고 있을 법한 쪽지나 편지를 가져다주시오.\n\n밖에서는 조심하시오, $C."
  },
  [26615] = {
    ["T"] = "더 큰 그림",
    ["O"] = "펠스톤의 정예 거주민들에게서 펠스톤 서신 20개를 획득해야 합니다.",
    ["D"] =
    "오크들이 아제로스를 처음 침공했을 때, 이 땅은 자원이 풍부했었지. 그들은 우리 세계로 밀려들면서 발판이자 집결지로 펠스톤을 지었소. 펠스톤은 2차 대전쟁 당시에 어둠의 문과 함께 파괴되었고. 그 이후로 요새 폐허 근처에 접근한 자는 거의 없소.\n\n하지만 당신이 회수한 쪽지들을 보면 그곳을 마치 도시처럼 이야기하고 있소. 그 모든 재건 작업이 하루아침에 이루어지지는 않았을 테고, 분명 누군가의 감독 없이는 불가능했을 거요. 펠스톤에 주둔한 병력은 어둠의 의회 내 여러 분파에서 온 것 같은데, 나는 누가 이곳을 지휘하고 있는지 도무지 알 수가 없소. 그들은 좀처럼 협력하는 법이 없으니까.\n\n스톰윈드에 있는 내 동료에게 보낼 보고서를 준비 중인데, 당신이 더 질 높은 정보를 수집해 주었으면 하오. 유능한 동맹들의 도움을 받는 것을 추천하겠소. 요새에 침투해서 장비를 잘 갖춘 자가 가진 서신을 찾아보시오.\n\n명심하시오. 이것은 무엇보다도 정찰 임무요. 적들을 과소평가하지 마시오. 이 쪽지들은 펠스톤 내에 아주 강력한 자들이 거주하고 있다는 것을 증명하고 있으니 각별히 조심하시오."
  },
  [26616] = {
    ["T"] = "우리만의 눈",
    ["O"] = "펠스톤 요새 내부에 있는 12개의 저주의 눈에 파수꾼의 홍채를 사용해야 합니다.",
    ["D"] =
    "이 글 중 일부에는 흑마법사들이 요새 내에서 거의 전지전능한 존재로 어떻게 군림하고 있는지 언급되어 있소. 보아하니 그들은 육체가 없는 눈을 소환해 길가를 떠다니게 하며 끊임없이 무리를 감시하고 있는 것 같소...\n\n그다지 복잡한 마법 같지는 않고, 우리가 그 눈에 접속해서 여기서 그들의 시야를 모니터링할 수 있다면 엄청난 잠재력이 있을 거라 생각하오. 어쩌면 유행하고 있는 이 저주에 대해 더 많은 것을 알 수 있을지도 모르지.\n\n당신이 요새에 가져갈 수 있는 장신구를 하나 준비했소. 이 눈들 중 하나를 마주치면, 홍채를 통해 쳐다보시오. 그러면 마법이 깃들 거요. 눈은 많을수록 좋으니, 더 이상 할 수 없을 때까지 계속 사용하시오."
  },
  [26617] = {
    ["T"] = "펠스톤 광산",
    ["O"] = "펠스톤 요새 내부에 있는 광산에서 펠스톤 금광석 30개를 수집해야 합니다.",
    ["D"] =
    "안녕하신가, $C. 당신이 늙은 감시자를 도왔던 분이라 들었소. 우리 모두를 대신해... 고맙소.\n\n남쪽 요새에 광산이 있다는 소식도 들었소. 이 땅의 역사에 대해 아는 게 있소? 오크들이 말라 비틀어지게 만들기 전에는 이 근방에 금이 아주 많았지. 그들이 광산에서 작업 중이라면, 아직 좀 남아있을지도 모르겠군!\n\n펠스톤으로 가는 길이오? 그렇다면 그곳에서 채굴하고 있는 광석 좀 가져다주시겠소? 네더가드는 자원 하나하나가 아쉬운 상황이라오!"
  },
  [26618] = {
    ["T"] = "목마른 자와 소포",
    ["O"] = "펠스톤 요새가 어떻게 깨끗한 물을 구하는지 알아내야 합니다.",
    ["D"] =
    "저 펠스톤은 영 안 좋은 곳이에요. 이 저주받은 땅도 불길하긴 마찬가지고요... 아시다시피 예전부터 이 지역 전체가 그리 보기 좋은 곳은 아니었죠.\n\n그건 그렇고, 저 펠스톤 놈들은 대체 어디서 물을 구하는 걸까요? 우리는 우리의 음료를 알잖아요...\n\n<자신의 자매 근처에 있는 양조주가 가득 찬 큰 마차를 향해 고개를 끄덕이는 힐다.>\n\n...게다가 이 지역 우물은 전부 말라버렸다는 것도 알고요. 비 한 방울 내리지 않는 곳이니까요. 설마 마법으로 만들어낸 물만 마시고 있는 건 아니겠죠..? 건강에 나쁠 텐데요!\n\n누구에게나 물은 필요해요, $N. 만약 그쪽으로 가실 거라면, 조사를 좀 해보시는 게 어때요? 장담컨대 우리가 기대했던 것보다 훨씬 많은 걸 알게 될 거예요... 어쩌면 우리도 깨끗한 물을 얻을 방법을 찾을지도 모르죠! 마지막으로 들은 바로는 우리 물도 바닥을 보이고 있거든요."
  },
  [26619] = {
    ["T"] = "그렇게 나쁘진 않아",
    ["O"] = "펠스톤 그로그 24병을 그록스 먹스웨거에게 가져다주어야 합니다.",
    ["D"] =
    "그래, 네더가드도 물이 필요하다 이거지? 뭐야... 그 스톰윈드의 거물들이 너희들 지원이라도 끊은 거야? 걱정 마, 걱정 말라고...\n\n흠... 물물교환은 어때? 난 이 펠스톤 놈들이 딱 질색이야 -- 음침하고 표리부동한데다 가끔은 진짜 지독하거든! 하지만 그로그 하나는 끝내주게 만들지.\n\n나한테, 오... 그 그로그 스물네 병만 가져다줘. 그렇게만 해주면, 내 물을 좀 나눠주고 남은 건 우리가 항구를 떠난 뒤에 네더가드로 배달해주지."
  },
  [26620] = {
    ["T"] = "지친 자를 위한 물",
    ["O"] = "네더가드 요새의 힐다 썬더브루에게 물통을 전달하고 소식을 전해야 합니다.",
    ["D"] =
    "여기 있소.\n\n<날카로운 휘파람을 부는 그록스. 갑판원 한 명이 재빨리 통을 끌고 와 당신 앞에 내려놓습니다.>\n\n내가 말했지 -- 당신이 찾을 수 있는 가장 신선한 물일 거라고! 그 힐다란 아가씨한테 내가 곧 네더가드로 가서 남은 물을 전달하고 향후 배송 건에 대해 얘기할 거라고 전해주시오. 방법은 걱정 말고 우리한테 맡겨두라고. 거래해서 즐거웠소."
  },
  [26621] = {
    ["T"] = "되살아나는 악",
    ["O"] = "스톰윈드 마법사 지구에 있는 마법사의 성소에서 고위마술사 안드로매스와 대화해야 합니다.",
    ["D"] =
    "우리가 알게 된 모든 것을 보고서로 정리해 두었소, $N. 스톰윈드에 있는 내 동료는 헤아릴 수 없는 힘을 지닌 지혜로운 자, 고위마술사 안드로매스요. 이 보고서를 들고 서둘러 그에게 가시오. 그가 보고서를 읽고 나면, 이 위협을 근절하기 위해 자신의 막대한 영향력을 빌려줄 거라 확신하오.\n\n당신의 활약과 여기서 우리에게 준 모든 도움에 대해서도 상세히 적어 두었소. 그곳에 도착하면 고위마술사가 당신에게 무언가 보상해 줄 거요.\n\n빛이 항상 당신과 함께하길, $N. 이것이 우리가 할 수 있는 마지막 일이라 하더라도, 우리는 이 어둠의 세력들을 막아낼 것이오."
  },
  [26622] = {
    ["T"] = "침몰한 보물",
    ["O"] = "저주받은 땅 연안에 있는 난파선 중 한 곳에서 침몰한 보물을 찾아야 합니다.",
    ["D"] =
    "이보쇼! 수영 솜씨가 좋아 보이는데, 마침 수영 잘하는 사람이 필요하던 참이오.\n\n저기 저 난파선들 보이오? 항구로 들어올 때마다 계속 눈에 띄어서 말이지, 이런 생각이 들더군. 침몰한 보물!\n\n나 대신 저 아래를 확인해 준다면 보수를 섭섭지 않게 쳐주겠소. 내가 세어보니 난파선이 네 척이오. 뭐라도 찾아서 가져오면, 전리품을 나눠 갖도록 합시다...\n\n아, 그리고 저 아래에 고약한 뼈다귀들이 수영하고 있는 걸 본 것 같으니. 조심하시오, $R!"
  },
  [26623] = {
    ["T"] = "뼈 분쇄",
    ["O"] = "그롬볼라 내부에서 로코와 테디를 위해 튼튼한 뼈 30개를 가져와야 합니다.",
    ["D"] =
    "<로코가 꿀꿀거리며 불안해합니다. 그는 입에 양말을 물고 있습니다. 우리 주변에 흩어져 있는 거의 흔적도 없이 갉아먹힌 뼈들이 보입니다.>"
  },
  [26624] = {
    ["T"] = "수배: 영혼약탈자 그루조크",
    ["O"] = "펠스톤 요새 내부에 있는 그롬볼라에 들어가 영혼약탈자 그루조크의 머리를 가져와야 합니다.",
    ["D"] =
    "어둠의혈맹 영토 깊숙한 곳으로 들어가 영혼약탈자 그루조크라는 자를 찾아 처치할 용감한 파티가 필요합니다.\n\n그는 극도로 위험한 인물로 간주됩니다. 신뢰할 수 있는 정보에 따르면 그는 네더가드 남쪽 펠스톤 요새 깊은 곳, 뼈로 둘러싸인 동굴 안에 있다고 합니다.\n\n현상금을 받으려면 그루조크의 머리를 병참장교 룬겔츠에게 가져오십시오."
  },
  [26625] = {
    ["T"] = "수배: 영혼약탈자 그루조크",
    ["O"] = "펠스톤 요새 내부에 있는 그롬볼라에 들어가 영혼약탈자 그루조크의 머리를 가져와야 합니다.",
    ["D"] =
    "호드의 일원들이여, 이것은 전투 소집령이다! 굴단의 옛 추종자들이 펠스톤 요새 안에 둥지를 틀고, 죽은 자를 일으키며 사악한 강령술을 부활시키고 있다.\n\n이 집단의 우두머리는 영혼약탈자 그루조크라 불리며, 그를 처치하기 위해서는 노련한 파티가 필요하다. 남쪽에 있는 펠스톤 요새 내부, 뼈로 둘러싸인 동굴 안에서 그를 찾아라.\n\n현상금을 받으려면 그의 머리를 정찰병 모그리아에게 가져가라."
  },
  [26626] = {
    ["T"] = "뜻밖의 동맹",
    ["O"] = "저주받은 땅 해안 어딘가에서 이잘니르를 찾아 대화해야 합니다.",
    ["D"] =
    "대부분 인정하려 들진 않겠지만, 우린 지금 끔찍한 위기에 처했소. 네더가드는 한동안 증원군을 받지 못했고, 사람들은 전에 본 적 없는 저주로 고통받고 있으며, 우리 주변의 땅은 매일매일 더 위험해지고 있소.\n\n2주일 전 시약을 구하러 나갔을 때, 남쪽 요새 폐허에서 도망쳐 나오는 언데드 한 명과 마주쳤소. 싸울 채비를 했지만, 그는 두 팔을 들어 올리곤 자신의 상황을 설명하더군.\n\n그는 한때 이교도의 고위 간부였고 탈출하려다 죽을 뻔했다오. 지금은 호드나 얼라이언스에게 은신처를 구하고 있지만, 그가 언데드인 이상... 글쎄, 우리에게 그를 위한 자리는 별로 없지 않소?\n\n감시자는 그걸 어떤 함정이라고 생각하지만, 솔직히 말해 우린 돌파구가 필요하오. 그런 자라면 필시 유용한 정보를 가지고 있을 테니까.\n\n그를 찾아보지 않겠소, $C? 마지막으로 봤을 땐 해안 쪽으로 향하고 있었소."
  },
  [26627] = {
    ["T"] = "최악 중 최고",
    ["O"] = "모그리아의 야영지 남서쪽에 있는 펠스톤 전초기지에서 리디아 카트라이트를 처치해야 합니다.",
    ["D"] =
    "분명히 말해 두지 -- 난 아직 어떤 진영과도 손잡지 않았지만, 내 옛 동료들에 대한 애정 따윈 식은 지 오래요. 그 바보들에게 절대 잊지 못할 교훈을 가르쳐 줄 수만 있다면 누구와도 협력하겠소!\n\n요새에 오래 머물진 않았지만, 난 요새의 모든 비밀을 알고 있소... 더 중요한 건 요새의 모든 것을 멈추게 하는 방법도 알고 있다는 거요. 적어도 당분간은 말이오...\n\n당신이 그 임무를 해낼 수 있을지 확인해야겠소. 근처 전초기지에 '리디아 카트라이트'라는, 이교도의 오합지졸들을 은밀하게 지휘하는 자가 있소.\n\n동료들을 데려가... 그녀를 처치하시오. 그런 다음 계속 진행하도록 하지."
  },
  [26628] = {
    ["T"] = "무너지는 토대",
    ["O"] = "펠스톤 요새 내부에서 펠스톤 상인 15명, 펠스톤 광부 15명, 펠스톤 수리공 15명을 처치해야 합니다.",
    ["D"] =
    "펠스톤의 사회적 기반은 노동자들로 이루어져 있소. 그들의 참여 없이는 아무것도 굴러가지 않지. 전쟁군주 나로크는 공포와 고통으로 그들을 통제하는 데 엄청난 시간을 쏟아부었소.\n\n요새는 이 지역에서 가장 큰 금맥 위에 자리 잡고 있으며, 노동자들이 그것을 채굴하고 있소. 펠스톤의 오래된 구조물들은 폐허가 되었지만 노동자들이 수리하고 있지. 부두에는 운송해야 할 물품들이 쌓여 있고 -- 채굴한 금으로 산 것들이오, 그 밖에도 수없이 많소...\n\n무엇을 해야 할지 알겠지, $N."
  },
  [26629] = {
    ["T"] = "광신도",
    ["O"] = "펠스톤 요새 내부에서 야수조련사 진라, 요리사 데빈, 부두주임 리암을 처치해야 합니다.",
    ["D"] =
    "펠스톤의 간부 중에는 없어서는 안 될 중요한 인물들이 몇 명 생각나는군. 그들을 죽이면 지휘 체계에 깊은 혼란을 심어줄 수 있을 거요.\n\n야수조련사 진라, 늑대들을 기르는 거친 여인으로 요새 내부의 기마 순찰대와 중요한 배달을 감독하오. 야수들은 오직 그녀만을 따르지. 그녀는 마구간 근처 서쪽 끝 언덕에 있는 커다란 오두막에 살고 있소.\n\n요리사 데빈은 진짜 끔찍한 놈이오 -- 낮에는 요리사, 밤에는 고문관인데, 그 누구도 구운 고기가 어디서 났는지 묻지 못할 정도지. 그는 요새에 공포를 생생하게 불어넣으며, 남쪽 중간 테라스의 벽으로 둘러싸인 구역을 배회하고 있소.\n\n마지막으로, 부두주임 리암은 펠스톤의 군수와 해상 무역을 책임지는 천재요. 그는 외톨이라... 십중팔구 항구 사무실에서 책에 파묻혀 있을 거요."
  },
  [26630] = {
    ["T"] = "배신의 고통",
    ["O"] = "이잘니르의 소지품을 찾고 펠스톤 요새 내부의 에델드린에게서 이잘니르의 문양을 획득해야 합니다.",
    ["D"] =
    "믿거나 말거나, 펠스톤 안에도 살아있는 자들이 친구라 부를 만한 이가 하나 있었지.\n\n하이 엘프 '에델드린'과 나는 공통 관심사가 많았소. 매혹적이었지. 우리가 협력하면서, 난 경계를 늦췄소... 그의 행동은 교묘했고, 내 주위 사람들에게 미치는 그의 영향력이 잡초처럼 자라나는 걸 알아채지 못했소. 내가 도망쳤을 때, 그는 내가 가진 모든 것을 물려받았소.\n\n그중 일부를 되찾고 싶군. 부두 근처 언덕에 있는 내 옛 텐트에 내 소지품이 든 배낭이 있소. 그리고 에델드린이 내 문양을 가지고 있소. 저주를 통제하는 일종의 '열쇠'이자, 우리가 저주를 막으려면 꼭 필요한 물건이오."
  },
  [26631] = {
    ["T"] = "눈엣가시",
    ["O"] = "펠스톤 요새 내부에 있는 세이아나 브라이트글렌에게서 세이아나의 문양을 획득해야 합니다.",
    ["D"] =
    "내 상대는 세이아나 브라이트글렌이었소. 완벽주의라는 불행한 성향을 가진 뛰어난 흑마법사였지. 아주 사소한 결점만 있어도 그녀는 콧방귀를 뀌며 비아냥대기 일쑤였소. 내가 나락으로 떨어진 후 내 꿈에서 그녀가 짓던 그 악마 같은 미소는 아직도 생생하오.\n\n인정하건대, 유행하고 있는 이 저주... 지옥불은 우리 두 사람의 합작품이오. 그녀는 해로운 측면을 맡았고, 나는 효력과 지속 시간을 담당했지.\n\n<건성으로 사과하듯 양손을 들어 올리며 고개를 숙이는 이잘니르.>\n\n쉬운 싸움은 아닐 거요. 그녀는 우리가 저주에 맞서 싸우는 데 필요한 또 다른 문양을 가지고 있소. 펠스톤 중앙에서 서쪽으로 가면, 주요 경로 오른쪽 언덕에서 그녀를 찾을 수 있을 거요."
  },
  [26632] = {
    ["T"] = "전쟁군주의 문양",
    ["O"] = "펠스톤 요새 내부에 있는 전쟁군주 나로크에게서 나로크의 문양을 획득해야 합니다.",
    ["D"] =
    "드디어 때가 왔군, $N. 이제 뱀의 머리를 치러 갈 차례요. 거의 다 왔소...\n\n충성심을 증명하고 보안을 강화하기 위해, 세이아나와 나는 전쟁군주 나로크에게도 각자의 문양을 내어주어야만 했소. 세 개의 문양을 결합하면 저주에 대한 약간의 통제력을 얻게 되오. 세상에서 저주를 완전히 없앨 정도는 아니지만... 시작으론 충분하지. 개별적인 경우에 한해서 당신에게 걸린 저주를 해제해 줄 수 있을 거요.\n\n나로크는 가장 먼 남쪽의 가장 높은 테라스에 있는 자신의 탑에 거주하오. 다른 자들이 죽었으니 그가 당신이 오고 있다는 걸 알게 될 거요. 나에게 그의 문양을 가져오면, 내가 퍼뜨리는 데 일조했던 이 저주를 다시 거두기 시작할 수 있소."
  },
  [26633] = {
    ["T"] = "애쉬폴 무장",
    ["O"] = "타우릿산 폐허에 있는 타우릿산 비밀요원과 타우릿산 첩보원에게서 검은무쇠 단검 10개와 검은무쇠 총 5자루를 회수해야 합니다.",
    ["D"] =
    "시간 좀 있나? 싸움을 두려워하지 않는 자처럼 생겼군.\n\n예전 섀도포지 시절엔 나도 장교였지... 뭐랄까... 수많은 드워프들을 지휘했다고나 할까. 다른 일에는 영 쓸모가 없어서, 조합에서 대체 불가한 인력이 되어볼까 생각 중이지. 당신 도움이 좀 필요해.\n\n이 조그마한 촌락이 안전해 보이겠지만, 몇 달에 한 번씩 오크 약탈대들이 지나쳐 간다네. 저기 저 모건이라는 친구가 모두의 무기를 멀쩡하게 유지하려고 최선을 다하고 있긴 하지만, 약탈이 너무 자주 오고 있어.\n\n저쪽 타우릿산의 잔해에는 아주 끔찍한 비밀요원과 첩보원들이 무기를 잔뜩 들고 진을 치고 있지. 여기 경비병들을 위해 그 무기들을 좀 조달해 주겠나? 보수는 넉넉히 주지."
  },
  [26634] = {
    ["T"] = "오크 놈들은 지긋지긋해!",
    ["O"] = "애쉬폴 초소 서쪽에 있는 검은바위 오크 30명을 처치해야 합니다.",
    ["D"] =
    "자, 여기서 바로 서쪽에, 우리가 쳐부숴야 할 검은 호드의 찌끄레기들이 있네. 군대 전체를 상대하라는 건 아니지만, 자네가 오크를 하나씩 죽일 때마다 이곳에서 생명 하나를 구하는 셈이지.\n\n가서 이 호드 놈들 숫자를 좀 줄여주겠나? 놈들을 이끄는 우두머리를 점찍어두긴 했는데, 정찰을 좀 더 해봐야겠어."
  },
  [26635] = {
    ["T"] = "불타오르는 히드라",
    ["O"] = "애쉬폴 초소 서쪽에 있는 대장 그루마, 마술사 말타그, 제련장인 트라락을 처치해야 합니다.",
    ["D"] =
    "한동안 저 밖에서 명령을 내리는 오크들을 주시해 왔는데, 자네만 괜찮다면 처치해 주었으면 하는 놈들을 몇 발견했네.\n\n여기 서쪽 커다란 탑에서 병력들에게 순찰 명령을 짖어대는 대장 그루마. 탑에서 남서쪽으로 멀지 않은 곳에서 무슨 의식 같은 걸 하는 마술사 말타그... 십중팔구 안 좋은 일이지. 그리고 짐작했겠지만 제련소에 있는 제련장인 트라락... 뭐 이놈들에 대해선 딱히 덧붙일 말이 없군.\n\n등 뒤를 조심하게, $C. 자네가 떠난 동안 계속 정찰을 하고 있겠네."
  },
  [26636] = {
    ["T"] = "급소 찌르기",
    ["O"] = "애쉬폴 초소 북서쪽에 있는 검은바위 요새 내부의 나르고쉬 레이지블레이드를 처치해야 합니다.",
    ["D"] =
    "좋아, 그래서... 이 지역 오크들의 대장인지 뭔지 하는 놈에 대해 알아냈네... 내가 보기엔 좀 벼락출세한 놈 같아 보이지만 -- 그 자리에 앉은 지 얼마 안 됐거든.\n\n이름은 나르고쉬 레이지블레이드라지. 검은바위 산 동쪽의 커다란 요새가 그놈이 있는 곳일세... 그러니까 여기서 북서쪽이지. 근육이 장난 아니던데, 조심하게나... 십중팔구 그 우스꽝스러운 이름값을 할 테니.\n\n건투를 비네, $C."
  },
  [26637] = {
    ["T"] = "부재중인 대화",
    ["O"] = "그룰 스톤크릭의 도면을 모건 블랙아이에게 전달해야 합니다.",
    ["D"] =
    "반갑소, $C. 대지고리회에서 이 땅의 상태를 살피기 위해 나를 이곳에 보냈소.\n\n이곳에서 들리는 원소의 목소리는 오직 불뿐이오. 불의 정령들의 태도부터 그들이 쓰는 방언까지 폭력의 화신 그 자체지. 수많은 목소리 중에서도 유독 내 귓가에 맴도는 목소리가 하나 있소 -- 이 땅을 전율케 하는 거친 명령소리... 반드시 잠재워야만 할 목소리요. 나를 도와주겠소?\n\n이 목소리 뒤에 숨은 힘을 정령의 형태로 속박하여 취약하게 만들 수 있소. 하지만 그러려면 준비가 필요하지. 부디 이 판화를 저기 있는 드워프에게 가져다주시오... 내 기억으론 모건이라고 불리던데.\n\n그가 내가 그린 것을 제작할 수 있는지 확인해 주시오. 그동안 나는 우리의 목표를 이룰 재료를 모을 테니, 때가 되면 당신을 찾으러 가겠소."
  },
  [26638] = {
    ["T"] = "속박의 손목보호구",
    ["O"] = "불타는 평원 전역의 다양한 적에게서 검은무쇠 조각 30개를 획득해야 합니다.",
    ["D"] =
    "흠... 손목보호구? 참 흥미로운 도면이구먼. 내 불룩한 뱃살보다 더 두껍네그려! 그 덩치 큰 놈이 이걸 찰 만한 손목을 가지고 있단 말이야?!\n\n<불의 정령을 속박해 파괴함으로써 이 땅을 잠재우겠다는 계획을 설명하는 당신의 말을 귀 기울여 듣는 모건.>\n\n하, 그거 한번 적극 지지해 볼 만한 계획이로군! 기꺼이 돕고 싶지만, 이런 걸 만들 만한 금속이 당장 수중에 없다네. 하지만 검은무쇠 조각을 쓰면 되겠어...\n\n갑옷, 무기, 장신구 등등 검은무쇠를 쓰는 놈들은 얼마든지 있다네! 조각을 좀 가져다주면 무료로 손목보호구 제작을 시작하지 -- 그 고약한 불의 군주 놈을 혼내주고 싶거든!"
  },
  [26639] = {
    ["T"] = "지원이 필요함",
    ["O"] = "그룰 스톤크릭과 대화하여 그의 곤경에 대해 알아봐야 합니다.",
    ["D"] =
    "좋아, 작업을 시작하지. 그... 타우렌과 얘길 나눠봤네. 내가 제대로 발음했나?\n\n자네를 보고 싶다더군. 거대한 계획에 필요한 몇 가지를 구하는 데 애를 먹고 있대."
  },
  [26640] = {
    ["T"] = "지옥불 룬",
    ["O"] = "불타는 평원 곳곳의 인간형 마법 사용자들에게서 지옥불 룬 15개를 수집해야 합니다.",
    ["D"] =
    "필요한 재료는 다 모았소... 단 하나만 빼고.\n\n원로 드워프들의 말에 따르면 마술사왕이 통치하던 시절, 우레망치 바위굴 꼭대기에 있는 제단은 초창기 화염 마법을 연구하던 장소였다고 하오. 그 시절의 잔해로 우리 의식에 쓸 수 있는 룬들이 남아 있지.\n\n이 룬들은 힘을 품고 있어서, 마치 불나방처럼 평원 전역의 마법 사용자들이 이 룬을 찾아 헤매고 있소.\n\n<자신의 가슴에 새로 난 화상 자국을 보여주는 그룰.>\n\n나는 전성기가 지났소 -- 몸이 예전 같지 않아서, 전투 중에 쓰러질 뻔했지 뭐요. 부탁하건대, 날 대신해서 가서 당신이 찾는 모든 룬을 가져와 주시오."
  },
  [26641] = {
    ["T"] = "불려 나온 자",
    ["O"] = "우레망치 바위굴 정상의 제단에서 불의 현신을 소환하고 처치해야 합니다.",
    ["D"] =
    "<그룰이 중얼거리며 룬 위로 손을 흔들자, 룬이 달그락거리며 빛을 냅니다.>\n\n흠... 이거로군. 그 목소리가 소리칠 때 이 룬이 내게 속삭인다오. 속박할 수 있도록 준비할 시간을 주시오.\n\n<몇 분 후, 그룰이 모은 모든 재료를 사용하여 작업을 마칩니다.>\n\n됐소. 의식은 간단하오 -- 우레망치 바위굴 꼭대기에 있는 제단에서 이 룬을 사용하시오. 이 땅의 소용돌이치는 에너지가 손목보호구 안으로 쏟아져 들어와 정령의 형태로 속박될 것이오. 놈을 물리치면 놈을 묶어두는 데 쓰인 에너지가 모두 소멸될 거요.\n\n전에도 말했듯, 불은 아주 폭력적인 원소요. 앞으로 벌어질 전투를 위해 동맹을 구해야 할지도 모르오."
  },
  [26642] = {
    ["T"] = "사라진 미란",
    ["O"] = "애쉬폴 초소 바로 바깥 지역에서 미란의 행방에 대한 단서를 조사해야 합니다.",
    ["D"] =
    "오, 모험가시군요! 선술집 입구에 제가 둔 표지판을 보셨나요?\n\n다정했던 제 남편 미란이... 며칠째 행방불명이에요! 그인 약초학자인데, 성벽 밖에 나가서 동전 몇 닢에 팔 만한 약초를 좀 캐오겠다고 했었거든요.\n\n<눈물을 글썽이기 시작하는 밀디스.>\n\n그 후로... 그이를 보지 못했어요! 우리는... 우린 이런 곳에 적응할 준비가 전혀 안 되어 있었다고요!\n\n부탁이에요... 그 사람 좀 찾아주시겠어요?! 당신이라면 분명 어떻게든 해주실 수 있을 거예요!"
  },
  [26643] = {
    ["T"] = "오우거의 짓일까?",
    ["O"] = "우레망치 바위굴 북쪽 어딘가에서 미란의 흔적을 찾아야 합니다.",
    ["D"] =
    "<격렬한 몸싸움의 흔적과 버려진 주머니는 미란이 죽임을 당한 것이 아니라 이 자리에서 납치되었음을 나타냅니다.>\n\n<커다란 발자국과 우레망치 바위굴이 가까운 것으로 보아 습격자가 오우거임을 시사합니다. 발자국은 북쪽으로 이어집니다. 미란은 아직 살아있을지도 모릅니다.>"
  },
  [26644] = {
    ["T"] = "동굴",
    ["O"] = "근처 동굴로 들어가 미란을 찾아야 합니다.",
    ["D"] =
    "<셔츠 주변을 살펴보니, 모든 증거가 오우거들이 미란을 근처 동굴로 데려갔음을 암시합니다. 끌려간 자국이 동굴 입구로 이어져 있습니다.>"
  },
  [26645] = {
    ["T"] = "미란의 탈출",
    ["O"] = "미란을 우레망치 바위굴 밖으로 호위해야 합니다.",
    ["D"] =
    "크아악! 물러서, 이 짐승 같은 놈! 당장-\n\n<당신이 오우거가 아님을 알아채는 미란.>\n\n누... 누구시죠?! 당신... 우리 편입니까? 제 아내가 보냈나요? 오, 밀디스...\n\n제가... 제가 같이 가도 될까요, 폐... 폐가 되지 않는다면요? 오우거 놈들이 절 장난감처럼 다뤘어요... 뼈도 몇 군데 부러졌고, 절 버려두고 가신다면 전 얼마 못 버틸 겁니다."
  },
  [26646] = {
    ["T"] = "우리 안의 첩자",
    ["O"] = "타우릿산 폐허를 배회하는 드워프들에게서 추적의 증거를 찾아야 합니다.",
    ["D"] =
    "$C. 자네에게 제안할 게 하나 있네. 섀도포지 도시는 우리 형제에게 상황이 너무 험악해져서, 우린 토륨 대장조합과 함께 새 삶을 시작하려고 여기까지 왔다네.\n\n<더 가까이 다가와 목소리를 낮춰 속삭이는 페린.>\n\n솔직히 말해, 누군가 우리를 미행하는 것 같아. 원로원은 아직 우리를 포기하지 않았어 -- 과거의 불만 때문에 우리를 심판의 투기장으로 끌고 가길 원하지...\n\n첩자들이 저 북쪽 폐허에 쥐새끼처럼 숨어 있네. 몇 놈만 죽여봐... 나머지 놈들이 얼마나 빨리 나락으로 도망치는지 보게나. 무엇보다도, 나와 내 형제에 관한 중요한 단서를 찾을 수 있는지 한번 보라고."
  },
  [26647] = {
    ["T"] = "무법자의 법칙",
    ["O"] = "타우릿산의 갈증 내부에 있는 아래층 손님들의 소지품을 뒤져야 합니다.",
    ["D"] =
    "그 도시의 끊임없는 편집증은 언제나 혐오스러웠어. 카룸이 앤빌레이지 장교로 일할 때도, 우린 너무 많은 사람의 심기를 건드리지 않도록 조심해야 했지. 여기 오니까 그나마 숨통이 좀 트이는군...\n\n자네가 할 수 있다면, 아래층 손님들 방을 좀 뒤져서 누가 혹은 뭐가 있는지 알아봐 주지 않겠나? 내가 아는 한 우리가 가장 오래 머물렀으니, 요원 놈은 누구라도 될 수 있네.\n\n그 요원 놈을 죽이게. 보수는 쳐줄 테니까. 세상에 공짜는 없지."
  },
  [26648] = {
    ["T"] = "문제의 근원",
    ["O"] = "검은바위 나락 내부의 거주 구역으로 들어가 이그비르 말리스터를 처치하고 그의 목걸이를 가져와야 합니다.",
    ["D"] =
    "사실 내겐 혈육이 둘 더 있어. 카룸은 여기 있고, 다른 한 명인 이그비르는 섀도포지에 있지 -- 어찌나 아부를 잘하는지 검은무쇠 드워프라고는 도무지 믿기지 않을 정도야. 그놈은 해결사라 원로원 의원들이 더러운 일에 그놈을 자주 써먹지.\n\n우리가 탈출 계획을 얘기했을 때 그놈은 우리를 비웃고 발작하며 떠났다가 경비병을 데리고 돌아왔어. 카룸이 놈들을 처리했고, 이그비르는 도망쳤고, 우린 지금 여기 있는 거지. 그 꼬마 놈이 독살범을 우리에게 보내며 자기 본색을 드러냈군.\n\n도시에 침투해 혼란을 조장하는 약탈 파티가 있다는 소릴 들었어. 그 파티에 합류해서, 놈을 죽이고 그놈이 차고 있는 목걸이를 내게 가져와 주게. 십중팔구 거주 구역에서 굽실거리고 있을 거야."
  },
  [26649] = {
    ["T"] = "골렘 사냥",
    ["O"] = "타우릿산 폐허 북쪽 기슭에서 골렘술사 루가를 찾아 그의 지배의 막대를 빼앗아야 합니다.",
    ["D"] =
    "당신 같은 모험가 타입을 찾고 있었소! 나 좀 도와줄 수 있소?\n\n이곳 경비병들을 도울 골렘을 하나 구하고 싶소만. 젊은 시절 배운 골렘술을 꽤 자부하긴 해도, 여긴 제작소가 아니지 않소. 파괴자를 처음부터 다시 만드는 건 여간 힘든 일이 아니오.\n\n북쪽 폐허 너머 기슭에 루가라는 골렘술사가 있다는 소문을 들었소. 그 지역의 낡은 전투파괴자들을 수리하고 있다던데... 내가 흥미를 가질 만한 개인 프로젝트를 진행 중이지...\n\n그자에게 지팡이가 하나 있는데, 자신의 개인 골렘을 통제할 수 있게 해준다오. 그 지팡이를 뺏어오면 당장 일을 시작할 수 있소!"
  },
  [26650] = {
    ["T"] = "거인의 어깨 위에 서서",
    ["O"] = "불타는 평원에 있는 전투절단기에게서 온전한 공명 수정을 수집하고 헬가의 룬새김 병을 사용하여 근처 웅덩이에서 용암을 조금 흡수해야 합니다.",
    ["D"] =
    "<짧게 눈을 감았다가 뜨는 헬가.>\n\n허... 아직 완성하지 못했다는 건 알 수 있지만, 최소한 기본기는 다 갖췄군.\n\n내가 직접 골렘을 이쪽으로 옮겨 보겠소. 좀 더 개선할 수 있는 몇 가지 아이디어가 있거든!\n\n공명 수정이 깨져 있어서 지배의 막대를 쓸 때 제대로 보기가 힘드오. 이 지역 전투절단기에서 상태가 괜찮은 걸로 하나 찾아보시오.\n\n오, 그리고 룬이 약간 긁혀 있어서 -- 용암으로 좀 다듬어 줘야 하는데, 그러려면 이게 필요할 거요.\n\n<룬이 새겨진 유리 같은 병을 건네는 헬가.>\n\n길 서쪽에 웅덩이가 있을 거요... 하지만 빠지지 않게 조심하시오! 그 병은 오랫동안 잘 견뎌왔으니 다루는 건 걱정 말고."
  },
  [26651] = {
    ["T"] = "핵 충전",
    ["O"] = "검은바위 산 서쪽에 있는 폭풍의 제단으로 동력 잃은 골렘 핵을 가져가서 충전해야 합니다.",
    ["D"] =
    "루가가 골렘의 코어를 완전히 충전하진 않았지만, 난 내가 검은바위에서 가져온 맞춤형 코어를 쓰고 싶소. 내 코어는 용량이 훨씬 더 크니까, 이런 생각이 들었소...\n\n산 서쪽에 폭풍의 제단이라는 곳이 있소. 오크 마법을 위한 장소라고들 하던데...\n\n만약 이 폭풍의 제단이 이름값이라도 한다면, 내 생각엔 이 녀석을 충전하기에 아주 완벽한 장소가 될 거요!\n\n어떠신가, $N? 크게 어렵진 않을 거요. 어, 내 생각엔... 아무튼..."
  },
  [26652] = {
    ["T"] = "올바른 종류의 기름",
    ["O"] = "불타는 평원 전역의 화염독침전갈, 화염집게전갈, 화염꼬리전갈의 사체에서 전갈 점액 16병을 수집해야 합니다.",
    ["D"] =
    "좋은 골렘의 비밀이 골렘에 바르는 기름이라는 건 누구나 아는 사실이오. 우리가 마법을 쓴다는 이유만으로 돌이 깨지지 않을 거라고 생각하소? 천만의 말씀!\n\n바로 요전 날, 죽은 전갈들을 실은 마차를 끌고 온 상인을 보았소. 그 녀석들에게서 나오는 점액이 -- 마치 끈적이는 강물 같았지! 그 물질이 우리의 새 골렘에 엄청난 잠재력을 줄 거라 생각하오.\n\n우리를 위해 그 점액을 좀 모아주시겠소? 전갈들은 평원 전역에서 찾을 수 있을 거요. 여기 빈 병들이 있으니 -- 그냥 전부 꽉 채워오시오!"
  },
  [26653] = {
    ["T"] = "골렘술의 예술",
    ["O"] = "통제력을 잃거나 스튜어트가 죽지 않도록 조종하면서 불타는 평원에서 적 20마리를 처치해야 합니다.",
    ["D"] =
    "좋소, $N. 내가 원하던 걸 다 얻었고 녀석도 좀 손봤소. 이제 녀석이 일어서서 움직이고 있으니...\n\n재미 좀 볼 텐가?!\n\n한번 타고 나가보시오! 맘에 드는 녀석을 상대로 자유롭게 싸워보시오, 단 이번 시험은 제대로 치르고 싶으니 -- 집중이 흐트러지면 안 된다는 뜻이오! 준비되면 알려주시오.\n\n아... 이 녀석 이름은 스튜어트라오."
  },
  [26654] = {
    ["T"] = "내장 불태우기",
    ["O"] = "우레망치 바위굴에 있는 불자루일족 오우거에게서 화염내장 30개를 수집해야 합니다.",
    ["D"] =
    "거기 당신... 마법에 대해 좀 아쇼?\n\n안개석을 만들려고 -- 꼬마들이 좋아하거든. 그런데 그전에 저 동쪽 오우거 놈들에게서 재료가 좀 필요하네.\n\n오우거 놈들을 본 지 좀 오래되긴 했지만, 오우거 내장 구조야 거기서 거기 아니겠어? 척 보면 알겠지만 그놈들의 내장이 필요해."
  },
  [26655] = {
    ["T"] = "영원한 고요",
    ["O"] = "밤에 붉은마루 산맥의 영원고요 호수 바닥에 있는 영원고요 잠복꾼을 처치하고 그 안개의 핵을 수집해야 합니다.",
    ["D"] =
    "붉은마루 산맥에 가본 적 있나? 좋은 곳이지. 내 약혼녀와 난 거기 살았었어.\n\n아무튼... 밤이 되면 호수가 요동친다네. 호수 밑바닥을 파헤치는 덩치 큰 괴수 -- 외래종이라고 해두지. 다 내 잘못이야. 공격적이진 않지만, 주변을 헤집고 다니는 걸 아주 좋아하지.\n\n그 녀석이 이 안개석에 필요한 재료를 가지고 있어. 자네가 그놈을 처리하고 코어를 내게 가져다주면 어떤가?"
  },
  [26656] = {
    ["T"] = "날씨 견디기",
    ["O"] = "불타는 평원에서 검은불늑대 가죽 8장을 수집해야 합니다.",
    ["D"] =
    "자네 무슨 생각하는지 알아... \"이놈 필시 다음엔 또 웬 돌덩이를 가져오라고 시키겠지\", 안 그래?\n\n헤헤... 돌은 이미 다 구해놨으니 걱정 붙들어 매시게나. 이 내장들이 다 마르면 잘게 갈아버릴 참이야.\n\n<몸서리를 치는 제이슨 틴링.>\n\n이봐... 공기에 스민 이 한기가 느껴지나? 뼈가 다 시리군...\n\n이거 어떤가. 여기 돌아다니는 검은불늑대들에게서 가죽을 좀 벗겨오게. 그럼 안개석을 내어주지."
  },
  [26657] = {
    ["T"] = "관리인의 요청",
    ["O"] = "죽음의고개 오우거를 처치하고 그들의 야영지를 수색하여 카라잔 폐허에서 물건을 훔쳤는지 확인한 다음, 발견한 단서를 저승바람 고개의 아리덴의 야영지에 있는 아리덴 엘리스에게 보고해야 합니다.",
    ["D"] =
    "안녕하십니까, 여행자여! 보통 저승바람 고개를 지나가는 분들에겐 그저 빨리 지나가라고 충고하겠지만, 당신은 더 강인한 체력을 지닌 분 같군요.\n\n저는 예전에 나이 든 메디브 님의 장원인 카라잔을 관리하던 사람이었습니다. 모든 마법이 풀려날 때 스톰윈드에 있었는데, 상황이 가라앉은 지금은 그곳을 확인해야겠다는 사명감이 듭니다. 하지만 저는 어리석은 노인네가 아닙니다. 먼저 그곳을 정찰해 줄 용감한 분의 도움이 필요합니다.\n\n이곳에 대한 온갖 끔찍한 이야기를 들으셨을 테니 무작정 뛰어들라고 하진 않겠습니다. 남쪽으로 향하는 도로를 따라 동굴에 한 오우거 부족이 이주해 왔습니다. 모험을 즐기는 젊은 분이 설득되어 오우거 야영지를 확인하고 그들이 카라잔에서 귀중품을 훔쳤는지 알아봐 주신다면, 그곳을 안전하게 조사할 수 있을 겁니다."
  },
  [26658] = {
    ["T"] = "관리인의 요청",
    ["O"] = "카라잔 예배당을 수색하여 숨겨진 관리인의 열쇠를 찾은 다음, 저승바람 고개의 아리덴의 야영지에 있는 아리덴 엘리스에게 열쇠를 가져가야 합니다.",
    ["D"] =
    "오우거들이 전리품을 챙길 만큼 안전하다면, 카라잔 주변 지역은 당신처럼 용감한 모험가가 조사하기에 충분히 안전할 거라 생각합니다.\n\n그들의 전리품에 장원에서 가져온 물건이 없다는 것은 그곳이 굳게 잠겨 있다는 의미입니다. 부디 마법으로 봉인되어 있기를 바랄 뿐입니다.\n\n다행히도 저는 항상 카라잔 예배당에 열쇠를 숨겨두곤 했습니다. 남쪽 길을 따라 장원으로 간 다음, 장원을 지나쳐 서쪽으로 계속 가면 예배당을 찾을 수 있습니다. 열쇠를 찾을 수 있는지 확인해 보십시오!"
  },
  [26659] = {
    ["T"] = "관리인의 요청",
    ["O"] = "관리인의 열쇠를 사용하여 카라잔의 정문을 열고 저승바람 고개의 아리덴의 야영지에 있는 아리덴 엘리스에게 돌아가야 합니다.",
    ["D"] =
    "저는 마법사는 아니지만 물건에 깃든 마법의 세력을 감정하는 눈썰미가 있습니다. 메디브 님이 모아둔 각종 장신구의 먼지를 털어낼 때 아주 유용하죠.\n\n일반적으로 카라잔 정문을 감싸고 있는 침입자 방지 마법 보호막을 뚫고 들어갈 마법이 이 열쇠에 아직 남아있습니다. 열쇠를 사용할 때 위험이 전혀 없다고는 장담할 수 없지만, 만약 성공한다면 장원의 실제 상태를 알 수 있을 겁니다."
  },
  [26660] = {
    ["T"] = "관리인의 요청",
    ["O"] = "관리인의 열쇠를 사용하여 카라잔의 뒷문을 열고 저승바람 고개의 아리덴의 야영지에 있는 아리덴 엘리스에게 돌아가야 합니다.",
    ["D"] =
    "물론 정문은 침입자를 막기 위해 굳건히 봉인되어 있습니다. 하지만 장원 북동쪽 강기슭으로 내려가 반대편 탑을 오르면 도달할 수 있는 뒷문이 있습니다.\n\n뒷문에는 자체적인 방어막이 있지만, 열쇠에 남아 있는 마법만으로도 충분히 피할 수 있을 거라 생각합니다. 물론 제 생각이 틀릴 수도 있습니다만, 기꺼이 도전해 보시겠다면 열쇠를 가져가 뒷문을 열어 보십시오. 좋은 소식을 가지고 무사히 돌아오길 바랍니다."
  },
  [26661] = {
    ["T"] = "비행장 공격 계획",
    ["O"] = "던 모로의 아이언포지 비행장 남쪽에 있는 켈시 스틸스파크에게 편지를 전달해야 합니다.",
    ["D"] =
    "이 트롤의 양피지는 거친 그림으로 보아 아이언포지 비행장에 대한 일종의 공격 계획을 묘사한 것으로 보입니다. 공성 전차가 따라올 수 없는 얼음 위로 산악경비대를 유인하는 계획 같지만 잔달라어를 읽을 수 없어 확신할 수 없습니다. 이 편지를 켈시 스틸스파크에게 보여주는 것이 좋을 것 같습니다."
  },
  [26662] = {
    ["T"] = "아이언포지 비행장",
    ["O"] = "비행기를 타고 아이언포지 비행장으로 간 다음 동쪽 벙커 근처에 있는 기르다 썬더브루와 대화해야 합니다.",
    ["D"] =
    "아이언포지 비행장에 대해 들어보셨나, $R? 내 개인적으론 그리핀을 더 좋아하지만, 우리 드워프들은 비행 기계로도 유명하다네. 제2차, 3차 대전쟁 이후 우리는 비행 기계를 대부분 잃었지만, 마그니 국왕께서 그 기계들을 다시 만들기 위해 거대한 비행장 건설을 지시하셨지.\n\n이리 빙빙 돌려 물어봐서 미안하네만, 비행장으로 가는 무료 여행에 관심 있나? 자네 같은 모험가라면 분명 도움이 될 걸세!"
  },
  [26663] = {
    ["T"] = "아이언포지 비행장",
    ["O"] = "비행기를 타고 아이언포지 비행장으로 간 다음 동쪽 벙커 근처에 있는 기르다 썬더브루와 대화해야 합니다.",
    ["D"] =
    "아이언포지 비행장에 대해 들어보셨나, $R? 내 개인적으론 그리핀을 더 좋아하지만, 우리 드워프들은 비행 기계로도 유명하다네. 제2차, 3차 대전쟁 이후 우리는 비행 기계를 대부분 잃었지만, 마그니 국왕께서 그 기계들을 다시 만들기 위해 거대한 비행장 건설을 지시하셨지.\n\n이리 빙빙 돌려 물어봐서 미안하네만, 비행장으로 가는 무료 여행에 관심 있나? 자네 같은 모험가라면 분명 도움이 될 걸세!"
  },
  [26664] = {
    ["T"] = "노네르 돕기",
    ["O"] = "비행장 남쪽에서 모로 독수리를 사냥하여 튼튼한 독수리 가슴살 8개를 모아야 합니다.",
    ["D"] =
    "어이! 보아하니 낯선 분이신데, 확실히 모험가 냄새가 물씬 풍기는구만. 일거리를 찾고 있소?\n\n마침 잘됐소! 식량 창고가 바닥을 드러내고 있는데 여기 친구들은 밥 한 끼 제대로 먹기를 기대하고 있거든. 그쪽이 아주 멋진 분이라면 이 근처에 있는 가금류 좀 잡아다 주겠소? 독수리 말이지. 튼튼한 가슴살 몇 개면 충분할 거요!"
  },
  [26665] = {
    ["T"] = "노네르 돕기",
    ["O"] = "비행장 남동쪽, 얼어붙은 호수 동쪽에서 덩치 큰 얼음발톱흰곰에게서 가죽 5장을 수집해야 합니다.",
    ["D"] =
    "자자, 뛰어가기 전에 내가 부탁할 일이 하나 더 있소. 걱정 마시오, 그만한 보수는 할 테니. 내 생각엔 그쪽이 평생 동안 곰 한두 마리쯤은 거뜬히 때려잡았을 법한 그런 $R분 같은데, 안 그러오? 여기 남동쪽에 그 짐승들 소굴이 꽤 괜찮게 자리 잡고 있거든. 내가 물건 좀 만들 수 있게 그 녀석들 가죽 좀 몇 개 가져다주겠소?"
  },
  [26666] = {
    ["T"] = "톱시 돕기",
    ["O"] = "비행장에 있는 스톰파이크 산악경비대 또는 던 모로 산악경비대 6명에게 청소 도구를 사용해야 합니다.",
    ["D"] =
    "안녕하세요! 저는 제가 맡은 임무를 제대로 수행하지 못하고 있는데... 혹시 좀 도와주실 수 있나요? 산악경비대 분들의 총을 닦아주러 다녀야 하는데, 이 망할 추출기를 고치느라 바빠서요. 항상 고장 나 있는 것 같다니까요...\n\n총 닦는 건 식은 죽 먹기예요, $N. 그냥 이 청소 도구를 들고 돌아다니면서 닦아주겠다고만 하면 돼요. 반 다스만 닦아주셔도 제가 시간을 엄청나게 아낄 수 있을 거예요!"
  },
  [26667] = {
    ["T"] = "톱시 돕기",
    ["O"] = "얼음 호수로 가서 코어 추출기를 설치하고 지켜야 합니다. 허블 버블텀프와 대화하여 코어 추출기를 얻어야 합니다.",
    ["D"] =
    "당신이 안 계신 동안 다행히도 제가 이 기계를 고쳤어요. 저기요, 한 번 더 도와주시겠어요? 이번에는 꼭 보상할게요!\n\n이 기계의 이름은 얼음 코어 추출기예요. 남쪽의 얼음 호수를 뚫고 얼음 속의 내용물을 연구하는 데 사용하죠. 그건 기후에 대한 유용한 정보와 함께, 공성 전차가 얼음 위를 달릴 수 있는지 여부를 알려준답니다.\n\n아주 작은 섬 남쪽에 있는 호수에서 가장 깊은 곳에 가서 이걸 사용하기만 하면 돼요. 야생 동물들로부터 기계를 지켜야 할지도 몰라요!"
  },
  [26668] = {
    ["T"] = "위즐 돕기",
    ["O"] = "비행장 주변에 흩어져 있는 쓰레기 12조각을 수집해야 합니다.",
    ["D"] =
    "네, 네, 뭡니까? 아주 바쁘거든요.\n\n아, 그냥 할 일을 찾고 계신 겁니까? 그 정도로 엄청나게 심심하신가 보군요. 하지만 뭐 일거리를 하나둘 정도 드릴 순 있겠네요.\n\n아시다시피 이 비행장은 지어진 지 얼마 안 돼서 주변에 쓰레기가 참 많습니다. 쓰레기를 좀 모아오시면, 쓸만한 게 있는지 확인해 보죠."
  },
  [26669] = {
    ["T"] = "위즐 돕기",
    ["O"] = "비행기 수리를 도와야 합니다.",
    ["D"] =
    "다음 지루한 일거리는 활주로에 왜 비행기가 서 있는지 알아내는 겁니다. 보아하니 코발트 기술자가 비행기와 같이 있는데, 필시 뭔가 문제가 생긴 게 틀림없어요. 아마 당신의 도움이 필요할 테고, 저는 제 시간을 허비할 수 없으니까요. 전 제가 수리비 받고 맡은 비행기가 더 걱정이거든요. 그한테 가서, 당신의 도움이 필요한지 알아보세요.\n\n재미있을 수도, 아닐 수도 있겠죠. 저는 신경 안 씁니다."
  },
  [26670] = {
    ["T"] = "아이언포지 비행장",
    ["O"] = "비행장 주변을 둘러보고, 문제를 겪고 있는 3명을 도와주어야 합니다.",
    ["D"] =
    "훌륭하군, 여기 자네 같은 사람이 꼭 필요했네. 이 비행장은 얼라이언스의 공중 우위를 창출하기 위해 드워프와 노움이 함께 협력해 이루어낸 아리따운 결실이지.\n\n활주로에 비행기가 막혀 있는 걸 자네도 볼 수 있듯, 지금은 상황이 좀 더디게 돌아가고 있네. 이 주변을 돌아다니다 보면 자네의 도움이 필요한 사람들을 분명히 찾을 수 있을 걸세!"
  },
  [26671] = {
    ["T"] = "켈시에게 식량 배달하기",
    ["O"] = "켈시 스틸스파크를 찾아 기르다가 준 식량을 배달해야 합니다.",
    ["D"] =
    "비행장 주변에서 자네가 보여준 그 훌륭한 활약 덕분에 사람들의 기운이 났구만. 하지만 내 마지막 부탁이 하나 있네... 켈시 스틸스파크라는 이름의 노움에게 이 음식을 좀 전해줄 수 있겠나? 그녀는 남서쪽에 있는 서리갈기 트롤 마을을 주시하고 있는 정찰병이라네.\n\n그녀를 찾는 가장 좋은 방법은 얼음 호수 서쪽을 샅샅이 뒤지는 걸세."
  },
  [26672] = {
    ["T"] = "서리갈기 공터",
    ["O"] = "아이언포지 비행장 남서쪽의 릭와타에서 서리갈기 트롤 12마리를 처치해야 합니다.",
    ["D"] =
    "저는 여기 트롤들을 감시하면서 그들이 허튼수작 부리지 못하게 막으라는 지시를 받았어요. 헌데, $C님, 그놈들이 진짜 허튼수작을 부리고 있더라고요.\n\n그놈들의 대사제 리카리라는 트롤이 절 발견하곤 경비병을 불러 공격했을 때 얼마나 깜짝 놀랐는지 몰라요. 간신히 탈출하긴 했지만, 무릎을 정통으로 얻어맞았지 뭐예요. 가서 그놈들 숫자를 좀 줄여주시면 좋겠는데, 대사제와 교전해선 안 돼요!"
  },
  [26673] = {
    ["T"] = "무장 파괴",
    ["O"] = "아무 불이나 사용하여 불붙지 않은 횃불에 불을 붙인 다음, 릭와타에서 서리갈기 부대 무기 6개를 불태워야 합니다. 릭와타에는 횃불에 불을 붙일 수 있는 모닥불이 있습니다.",
    ["D"] =
    "릭와타에 있는 서리갈기 트롤들이 비행장 공격을 준비하고 있어요. 식량만 들어있는 줄 알았던 마을 곳곳의 상자에 사실은 무기가 보관되어 있더라고요. 무기 상자가 꽉 차 있다고요!\n\n여기, 제가 쓰시라고 임시로 횃불을 만들어 뒀어요. 트롤들의 모닥불이나 아무 불로 가져가서 불을 붙인 다음, 그 무기들을 불태워 버리세요!"
  },
  [26674] = {
    ["T"] = "대사제 리카리",
    ["O"] = "대사제 리카리를 처치해야 합니다.",
    ["D"] =
    "당신의 활약 덕분에 이제 제 영혼도 고양되었어요, $N님. 이젠 트롤 녀석들에게 우리가 호락호락하지 않다는 걸 보여줘야 할 때예요. 그렇게 할 수 있는 가장 좋은 방법은 바로 대사제 리카리를 처치하는 거죠. 그러면 그다음 우두머리는 우릴 공격할 엄두를 못 내리라 기대해 볼 수 있어요.\n\n대사제는 어둠의 힘을 조종하니 얕보지 마세요. 부디 도와줄 친구들이 좀 있으면 좋겠군요.\n\n성공하시면 비행장에 있는 함대 사령관 스톤플린트에게 보고해 주세요. 그는 벙커 안에 있을 거예요."
  },
  [26675] = {
    ["T"] = "얼음 부수기",
    ["O"] = "그림나르 스롬윈이 서리갈기 소굴에서 탈출하도록 도와주어야 합니다. 성공하면, 카라노스에 있는 그론 스롬윈에게 알려야 합니다.",
    ["D"] =
    "마침내, $r군! 당신 같은 사람을 다시 보게 될 거란 희망을 거의 포기하고 있었소.\n\n이 망할 트롤 녀석들이 카라노스로 가는 길에 나를 붙잡는 바람에, 계속 여기에 갇혀 있었소. 내가 탈출하는 걸 좀 도와줄 수 있겠소?"
  },
  [26676] = {
    ["T"] = "잃어버린 형제...",
    ["O"] = "그론 스롬윈의 잃어버린 형제를 찾아야 합니다. 그는 서리갈기 소굴 근처에서 마지막으로 목격되었습니다.",
    ["D"] =
    "우리는 이곳 카라노스에서 수많은 무기와 방어구를 제작하고, 아제로스 전역의 다양한 지역으로 그것들을 배달해야 한다오. 내 형제 그림나르도 그 배달 임무를 수행 중이었고 며칠 전에 돌아왔어야 했지.\n\n누군가 그가 서리갈기 소굴을 지나는 걸 봤다는데, 그 후론 아무도 그를 보지 못했소. 혹시 트롤들이 그를 붙잡은 건 아닐까? 아니길 바라지만... 날 위해 확인해 줄 수 있겠소?"
  },
  [26677] = {
    ["T"] = "서리갈기 죄수",
    ["O"] = "서리갈기 야영지에서 붙잡힌 주민 3명을 구출하고 대장 썬더브루에게 돌아가야 합니다.",
    ["D"] =
    "$N, 자네에게 아주 긴급한 임무가 있네. 최근 우리 시민 몇 명이 미스터리하게 사라졌네. 처음엔 대수롭지 않게 여겼지만 몇 주가 지났는데도 아무도 돌아오지 않고 있어.\n\n실종 사건이 시작된 이후로 서리갈기 트롤들이 이 서쪽에 야영지를 몇 개 지었지. 그곳을 확인하고 우리 시민들을 찾을 수 있는지 알아봐 주게."
  },
  [26678] = {
    ["T"] = "의료 기록",
    ["O"] = "원장 메리의 기록을 아이언포지에 있는 민시 스프링치크에게 가져가야 합니다.",
    ["D"] =
    "이곳 놈리건 지하에서는 고군분투하고 있지만, 빛을 치료에 활용하는 제 연구는 큰 성공을 거두었습니다. 저 스스로 이곳을 빠져나갈 가능성은 당분간 희박해 보이니, 제 기록을 아이언포지의 수석 의료관에게 전해주시겠습니까? 그녀의 이름은 민시 스프링치크이며 팅커 타운에서 찾을 수 있습니다.\n\n부탁입니다, $C, 서둘러 주세요."
  },
  [26679] = {
    ["T"] = "따뜻하게 유지하기",
    ["O"] = "겨울 늑대 가죽 8장을 모아 카라노스의 여관주인 벨름에게 가져가야 합니다.",
    ["D"] =
    "공기 중에 한기가 느껴지시나요? 불 옆에 서 있어도 턱수염이 얼어붙을 것만 같아요! 정말이지, 겨울이 해가 갈수록 더 추워지고 있어요.\n\n저기, 망토를 만들 짐승의 좋은 가죽이 좀 필요해요. 좀 도와주실 수 있나요? 서쪽 얼음방울 호수로 가서 늑대 가죽을 좀 가져다주세요."
  },
  [26680] = {
    ["T"] = "길 잃은 산양",
    ["O"] = "베론의 올가미 밧줄을 이용해 앰버스틸 산양 3마리를 앰버스틸 목장으로 다시 데려온 다음 베론 앰버스틸에게 돌아가야 합니다.",
    ["D"] =
    "며칠 전에 지독한 눈보라가 치는 바람에 우리 문이 망가졌어요! 소중한 산양들이 많이 도망쳐 버렸죠! 여기 남쪽으로 달아나는 걸 봤는데, 도저히 막을 수가 없었어요. 팔 산양이 없으면 제가 어떻게 돈을 벌겠어요?\n\n이 남쪽의 툰드라 언덕으로 가서 제 산양들을 찾을 수 있는지 봐주세요. 산양들에게 가까이 다가가서 제 올가미 밧줄을 써서 목장으로 타고 돌아와 주시면 돼요! 평생 잊지 않겠습니다!"
  },
  [26681] = {
    ["T"] = "수습 해골마 기수",
    ["O"] = "벨마 워넘에게 전문 승마 기술을 배운 다음 티리스팔 숲에 있는 자카리아 포스트와 대화하여 해골마를 받아야 합니다.",
    ["D"] =
    "다시 오셨군요. 전문 승마 기술을 배우러 오셨죠, 맞나요? 전과 마찬가지로 해골마 비용은 지불되었지만, 훈련 비용은 직접 지불하셔야 합니다. 빠른 승마 훈련은 아쉽게도 가격이 좀 나간답니다.\n\n훈련을 받으신 후 제 뒤에 있는 자카리아 포스트와 대화하세요. 그가 우리 말 판매를 관리하고 있습니다. 아직 자금이 부족하시다면 언제든 돌아오셔도 좋습니다."
  },
  [26682] = {
    ["T"] = "수습 산양 기수",
    ["O"] = "울담 아이언혼에게 전문 승마 기술을 배운 다음 던 모로에 있는 베론 앰버스틸과 대화하여 산양을 받아야 합니다.",
    ["D"] =
    "다시 오셨군요! 더 빨리 타는 법을 배우러 오셨죠, 맞나요? 전과 마찬가지로 산양 비용은 지불되었지만, 훈련 비용은 직접 지불하셔야 합니다. 고급 훈련은 아쉽게도 가격이 좀 나간답니다.\n\n훈련을 받으신 후 우리 밖으로 나가서 베론 앰버스틸과 대화하세요. 그가 이 목장을 운영하며 산양을 판매하고 있습니다. 아직 자금이 부족하시다면 언제든 돌아오셔도 좋습니다."
  },
  [26683] = {
    ["T"] = "수습 언데드 기수",
    ["O"] = "벨마 워넘에게 수습 승마 기술을 배운 다음 티리스팔 숲에 있는 자카리아 포스트와 대화하여 해골마를 받아야 합니다.",
    ["D"] =
    "해골마를 구하러 오셨군요? 마침 당신을 기다리고 있었어요! 어떤 신비한 후원자분께서 평범한 말 한 필의 값을 치르고 가셨는데, 이름이 $N님 앞으로 되어 있더군요. 하지만 훈련 비용은 지불하지 않으셨기 때문에 안타깝게도 그 부분은 직접 부담하셔야 합니다.\n\n훈련을 받으신 후 제 뒤에 있는 자카리아 포스트와 대화하세요. 그가 우리 말 판매를 관리하고 있습니다. 아직 자금이 부족하시다면 나중에 다시 오셔도 좋습니다."
  },
  [26684] = {
    ["T"] = "산양타기",
    ["O"] = "울담 아이언혼에게 수습 승마 기술을 배운 다음 던 모로에 있는 베론 앰버스틸과 대화하여 산양을 받아야 합니다.",
    ["D"] =
    "그래, 산양 타는 법을 배우러 오셨소? 마침 당신을 기다리고 있었지! 어떤 신비한 후원자분께서 평범한 산양 한 마리의 값을 치르고 가셨는데, 이름이 $N님 앞으로 되어 있더군. 하지만 훈련 비용은 지불하지 않으셨기 때문에 안타깝게도 그 부분은 직접 부담하셔야 하오.\n\n훈련을 받으신 후 우리 밖으로 나가서 베론 앰버스틸과 대화하시오. 그가 이 목장을 운영하며 산양을 판매하고 있소. 아직 자금이 부족하시다면 나중에 다시 오셔도 좋소."
  },
  [26685] = {
    ["T"] = "전문 기계타조 기수",
    ["O"] = "빈지 페더휘슬에게 수습 승마 기술을 배운 다음 던 모로에 있는 밀리 페더휘슬과 대화하여 기계타조를 받아야 합니다.",
    ["D"] =
    "다시 오셨군요. 더 빨리 타는 법을 배우러 오셨죠, 맞나요? 전과 마찬가지로 기계타조 비용은 지불되었지만, 훈련 비용은 직접 지불하셔야 합니다. 고급 조종술은 아쉽게도 가격이 좀 나간답니다.\n\n훈련을 받으신 후 제 옆에 있는 제 동생 밀리와 대화하세요. 동생이 기계타조를 조립하고 판매한답니다. 아직 자금이 부족하시다면 언제든 돌아오셔도 좋습니다."
  },
  [26686] = {
    ["T"] = "기계타조 조종술",
    ["O"] = "빈지 페더휘슬에게 수습 승마 기술을 배운 다음 던 모로에 있는 밀리 페더휘슬과 대화하여 기계타조를 받아야 합니다.",
    ["D"] =
    "그래, 기계타조 조종하는 법을 배우러 오셨나요? 마침 당신을 기다리고 있었어요! 어떤 신비한 후원자분께서 수습 등급 기계타조의 값을 치르고 가셨는데, 이름이 $N님 앞으로 되어 있더군요. 하지만 훈련 비용은 지불하지 않으셨기 때문에 안타깝게도 그 부분은 직접 부담하셔야 합니다.\n\n훈련을 받으신 후 제 옆에 있는 제 동생 밀리와 대화하세요. 동생이 기계타조를 조립하고 판매한답니다. 아직 자금이 부족하시다면 나중에 다시 오셔도 좋습니다."
  },
  [26687] = {
    ["T"] = "그룸날을 위한 광석",
    ["O"] = "골볼라 채석장 광산에서 동력의 광석 10개를 채굴하여 광부 그룸날에게 돌아가야 합니다.",
    ["D"] =
    "저 아래에 있는 망할 트로그 놈들이 우리 채굴 작업을 멈추게 만들었소. 엄청난 대발견을 코앞에 두고 말이지!\n\n트로그의 공격을 피해 광산에서 대피하던 중에 내 광부 중 한 명이 나에게 다급히 달려왔소. 광산 깊은 곳에서 흔치 않은 금속의 새로운 광맥을 발견했다고 하더군. 안타깝게도 이 발견에 대한 후속 조치는 취할 수가 없었지.\n\n당신에게는 투지가 엿보이는군. 당신이 광석 냄새를 잘 맡고 트로그를 죽이는 걸 좋아한다면, 저 안에서 독특한 광석을 발견해 가져다줄 시 후한 보상을 주겠소."
  },
  [26688] = {
    ["T"] = "역사 복원",
    ["O"] = "서리갈기 동굴에서 잃어버린 서판 8개를 회수하여 수습생 소렌에게 돌아가야 합니다.",
    ["D"] =
    "과거의 역사를 발굴해 보려는 희망을 품고 이곳에 왔건만, 제가 발굴하려던 바로 그곳에 망할 트롤 놈들이 동굴을 장악해 버렸지 뭡니까!\n\n전 싸움꾼은 아니지만, 당신은 그 임무에 제격인 것 같군요. 동굴에 들어가 흥미로워 보이는 유물이 있으면 제게 가져다주시겠습니까? 항아리, 단지, 서판 같은 것들 말입니다.\n\n보상은 섭섭지 않게 챙겨 드리죠. 이곳 발굴 명령은 아이언포지에서 직접 내려온 거니까요!"
  },
  [26689] = {
    ["T"] = "술집 난동",
    ["O"] = "골드샤이어 남서쪽 길을 따라 마르디간의 위치를 찾아야 합니다.",
    ["D"] =
    "불과 두어 시간 전 사자의 긍지 여관에서 벌어진 싸움을 말려야 했습니다. 뭐 사랑 때문이었냐고요? 명예? 돈? 아뇨. 다름 아닌 물약 하나 때문이었습니다. 빌어먹을 분노의 물약 하나 말이죠.\n\n제가 녀석들을 떼어놓았을 때, 싸움꾼 중 한 명이 이곳 동쪽 아조라의 탑의 주인이자 대마법사인 칼레인의 아들, 마르디간이라는 걸 알아챘습니다.\n\n마르디간은 마을 남서쪽, 웨스트브룩 주둔지 쪽으로 비틀거리며 길을 따라 걸어갔습니다. 저 대신 그를 좀 확인해 주시겠습니까? 그 애가 심하게 다치기라도 하면 그의 아버지가 이 지역 수비대에게 불벼락을 내릴 겁니다."
  },
  [26690] = {
    ["T"] = "술집 난동",
    ["O"] = "엘윈 숲에서 핏빛 꽃잎 6장을 구해 사자의 긍지 여관에 있는 윌리엄 페슬에게 가져가야 합니다.",
    ["D"] =
    "아버지는 저를 사자의 긍지 여관으로 보내 윌리엄 페슬에게 분노의 물약을 만들어 달라고 요청하게 하셨죠. 물약을 손에 넣고 나니, 에일도 한잔하는 게 어떨까 하는 생각이 들더라고요? 하지만 잔을 비우기도 전에 처음 보는 악당에게 기습을 당했습니다!\n\n상황은 순식간에 험악해졌고, 우리가 칼을 뽑으려는 찰나에 치안대장 더그한이 끼어들었죠. 소동이 벌어지는 사이 그 악당이 물약을 훔쳐 가버렸습니다!\n\n과거에 아버지의 심부름을 몇 번 망친 적이 있다는 건 인정하지만, 만약 그 물약을 가져가지 못하면 아버지가 저와 제 개를 내쫓아버리실 게 뻔합니다.\n\n치안대장 더그한이 절 돕기 위해 당신을 보냈다면, 핏빛 꽃잎을 좀 구해 윌리엄 페슬에게 가져다주십시오. 그러면 그가 새 물약을 만들어 줄 수 있을 겁니다."
  },
  [26691] = {
    ["T"] = "술집 난동",
    ["O"] = "골드샤이어 남서쪽에 있는 마르디간에게 돌아가야 합니다.",
    ["D"] =
    "저렇게 소란을 피울 거라면 마르디간과의 거래는 이제 사양하겠어요. 사자의 긍지 여관은 아늑하고 존경받는 곳인데, 마르디간이 나타날 때마다 꼭 싸움이 벌어지니까요!\n\n그가 물약이나 영약을 원한다면 앞으로는 스톰윈드로 가라고 하세요. 이제 그건 루미어 양의 몫이라고 전해주세요!"
  },
  [26692] = {
    ["T"] = "술집 난동",
    ["O"] = "거울 호수 위, 천둥 폭포에 있는 그의 집 근처에서 마르디간과 만나야 합니다.",
    ["D"] =
    "이게 바로 내가 원했던--\n\n<마르디간이 갑자기 말을 멈추고 저 멀리 무언가를 주시합니다.>\n\n저건 연기인가? 언덕 쪽에서? 그럴 리가... 집으로 돌아가야겠어! 천둥 폭포에 있는 내 집에서 만나자고!"
  },
  [26693] = {
    ["T"] = "술집 난동",
    ["O"] = "마르디간의 집에서 단서를 확인해야 합니다.",
    ["D"] =
    "<프리츠의 시체에서 마르디간의 집 안으로 핏자국이 이어져 있습니다. 안에서 뭔가 단서를 찾을 수 있을지도 모릅니다?>"
  },
  [26694] = {
    ["T"] = "술집 난동",
    ["O"] = "마르디간의 집에 불을 낸 일에 대해 사자의 긍지 여관 뒤편에 있는 남자와 대면해야 합니다.",
    ["D"] =
    "<쪽지를 손에 쥔 마르디간은 사자의 긍지 여관 쪽으로 전속력으로 달려가며 욕설을 퍼붓고 얼굴을 붉힙니다.>\n\n<그를 쫓아가 마르디간의 집을 망가뜨리고 그의 개를 죽인 남자를 대면해야 합니다.>"
  },
  [26695] = {
    ["T"] = "술집 난동",
    ["O"] = "엘윈 숲의 아조라의 탑에 있는 테오크리투스에게 마르디간의 상황을 알려야 합니다.",
    ["D"] =
    "마르디간을 진심으로 돕고 싶다면 지금 당장 날 도와주십시오. 마르디간의 아버지에게 아들의 범죄를 알려야 하지만, 그에게 연락이 닿을 수 있는 사람은 골드샤이어 동쪽 길에 위치한 아조라의 탑에 있는 테오크리투스뿐입니다. 조심하십시오. 그 탑은 강력한 비전 마법의 중심지이며 그곳엔 뭔가 이상한 기운이 감돌고 있으니까요...."
  },
  [26696] = {
    ["T"] = "아조라의 손",
    ["O"] = "서부 몰락지대 중앙의 감시의 언덕에서 칼레인을 찾아야 합니다.",
    ["D"] =
    "마르디간의 아버지는 내 동료인 대마법사 칼레인이오. 나는 아주 중요한 유물인 아조라의 손을 회수하기 위해 칼레인을 서부 몰락지대로 보냈소.\n\n아조라의 손은 아주 매우 골치 아픈 집단의 관심을 끌었던 강력한 무기라오. 나는 타노스라는 강력한 마법사에게 그것을 숨기도록 맡겼으나, 타노스는 서부 몰락지대로 떠난 뒤 실종되었소.\n\n칼레인을 찾으려면 감시의 언덕으로 가보시오. 부디 그가 타노스의 흔적을 쫓고 있기를 바랄 뿐이오. 칼레인을 도와 이 일을 해결하면, 그가 당신의 일을 봐줄 수 있을 거요."
  },
  [26697] = {
    ["T"] = "아조라의 손",
    ["O"] = "이 지역의 데피아즈단 노상강도와 데피아즈단 밀수업자에게서 타노스의 행방을 알 수 있는 단서 3가지를 찾으십시오.",
    ["D"] =
    "테오크리투스가 말했듯이, 난 타노스라는 사람을 찾기 위해 이리로 보내졌지만 내가 찾은 것이라곤 바람에 실려 오는 소문뿐이라네.\n\n그가 이곳을 방문했다는 건 알지만, 사라지기 전엔 누구에게도 자신의 목적을 말하지 않았다더군.\n\n스튜어트맨틀의 말로는 그가 근방 데피아즈단에 대해 수소문하고 다녔다는군. 데피아즈단이 그를 찾을 핵심 열쇠일지도 몰라. 마르디간을 위해 내 도움이 필요하다면, 내가 여기서 조사를 계속하는 동안 자네가 그 녀석들을 족쳐줘야겠네."
  },
  [26698] = {
    ["T"] = "아조라의 손",
    ["O"] = "감시의 언덕의 여관에서 레빌 코스트와 대화해야 합니다.",
    ["D"] =
    "자네가 외출한 사이 난 여기 민병대원들과 꽤 친해졌다네. 그들은 내게 마음을 열고 그들이 아는 얼마 안 되는 정보를 알려주었지.\n\n스튜어트맨틀의 말에 따르면 타노스는 데피아즈단에 대해 알아내는 데 관심이 많았고, 레빌 코스트라는 남자와 이야기하는 데 많은 시간을 보냈다는군 -- 그는 우리가 예전에 함께 일했던 적이 있는 교회 소속의 무법자야.\n\n우린 썩 좋게 헤어진 편은 아니었네. 코스트는 여관에 틀어박혀 있는데, 내가 누군지 알아보면 마을을 뜰지도 모르네. 자네가 가서 그가 무슨 변명을 하는지 좀 들어보겠나?"
  },
  [26699] = {
    ["T"] = "아조라의 손",
    ["O"] = "해당 지역에 있는 데피아즈단 약탈자와 데피아즈단 덫사냥꾼에게서 타노스의 위치에 대한 3가지 추가 단서를 찾으십시오.",
    ["D"] =
    "타노스? 그 머리 희끗희끗한 양반 말이오? 그래, 여기 있었지. 데피아즈단에 대해 횡설수설하면서 그놈들 작전 기지 중 하나를 찾고 있었소.\n\n당시엔 제정신이 아닌 것 같았소. 내 손을 잡으려고도 하지 않았지.\n\n그가 어디로 갔는진 나도 전혀 모르지만, 그 붉은 복면을 쓴 건방진 놈들과 한판 벌이려던 것 같더군. 그놈들이 타노스를 쫓고 있었다고? 그놈들한테서 뭘 알아냈소?\n\n당신이 적은 메모를 보니 서신 절반이 누락됐군. 계급이 더 높고 더 강한 놈들을 노려보시오. 장담컨대 당신이 필요한 걸 얻게 될 거요."
  },
  [26700] = {
    ["T"] = "아조라의 손",
    ["O"] = "데피아즈단 단서를 사용하여 서부 몰락지대에서 타노스의 위치를 찾아야 합니다.",
    ["D"] =
    "어둠의 기수들이라 불리는 집단이 가지고 있는 것으로 추정되는 위대한 유물을 찾기 위해 서부 몰락지대로 오라는 명령을 받았습니다.\n\n기수들은 전설 속의 존재들입니다 -- 막강한 힘을 가진 물건을 찾아 카라잔에 있는 어둠의 주인에게 가져가기 위해 대륙을 배회하는 사악하고 불결한 존재들이죠.\n\n저는 타노스가 가지고 있는 것이 제가 찾고자 하는 유물과 맞먹거나 그 이상의 힘을 지녔다고 믿습니다. \n\n기수들이 타노스가 유물을 소유하고 있다는 사실을 알게 된다면 그는 심각한 위험에 처하게 될 겁니다. 당신이 그를 찾아야 합니다, 서둘러요! 저는 이 사실을 칼레인에게 알리겠습니다."
  },
  [26701] = {
    ["T"] = "아조라의 손",
    ["O"] = "타노스가 황금해안 채석장을 치우고 은신처를 만드는 것을 도와야 합니다.",
    ["D"] =
    "조심해! 나도 이 물건을 통제할 수가 없어! 테오크리투스가 내게 이 빌어먹을 장갑을 주면서 서부 몰락지대 이곳에 숨기라고 했지.\n\n아조라의 탑에서 멀어지자, 난 이 장갑을 껴야만 할 것 같은 강한 충동을 느꼈어. 손에 끼는 순간 두 번째 피부처럼 착 달라붙더니 이젠 벗겨지지도 않는단 말이야! 지금은, 내가 두려움을 느낄 때마다 순수한 비전 마력이 폭발하듯 뿜어져 나오고 있어.\n\n난 숨어야 해, $C! 내가 어디 있는지 아무도 모르게 해야 한다고.\n\n저 앞에 있는 광산이 내 새 안식처가 될 거야. 이 땅을 공포에 떨게 하는 데피아즈단이 광산을 점거했으니, 마을 사람들은 근처에 얼씬도 안 하겠지. 이 장갑만 있으면 그놈들을 쉽게 쓸어버릴 수 있어. 오랫동안 데피아즈단이 사라진 걸 아무도 눈치채지 못할 거야."
  },
  [26702] = {
    ["T"] = "아조라의 손",
    ["O"] = "엘윈 숲의 아조라의 탑에 있는 테오크리투스에게 돌아가야 합니다.",
    ["D"] =
    "우린 임무에 실패했소... 그 기수들이 지니게 된 힘을 생각하면 등골이 서늘해지는구려.\n\n테오크리투스에게 돌아가 무슨 일이 있었는지 전해야 하오.\n\n이 사태를 수습하기 위해 우리가 무얼 할 수 있을지 도저히 모르겠소."
  },
  [26703] = {
    ["T"] = "아조라의 손",
    ["O"] = "마르디간에게 일어난 일에 대해 칼레인에게 알려야 합니다.",
    ["D"] =
    "칼레인이 곧 이곳에 도착할 거요. 그 친구 성격상 물건을 챙기자마자 순간이동 주문을 시전할 게 뻔하오.\n\n그가 도착하면 마르디간에게 일어난 끔찍한 사태의 심각성을 제대로 인지시키고, 두 사람이 힘을 합쳐 마르디간이 향한 곳으로 서둘러 떠나야 하오. \n\n아조라의 손은 당분간 잃어버린 셈 쳐야겠지만, 적어도 마르디간을 구하는 일은 해볼 수 있지 않소."
  },
  [26704] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "다크샤이어 경비병들에게 정체불명의 2인조에 관한 정보를 물어봐야 합니다.",
    ["D"] =
    "당신 표정을 보니 알겠소. 아무리 강인한 $g사내:여인;라도... 일단 기수들을 마주하고 나면 그런 표정을 짓게 마련이지. 그렇소, 불과 두 시간 전에 그놈들이 이 근처에서 목격됐소.\n\n최근 사제 한 명과 동행한 불안정한 마법사 하나가 당신과 똑같이 겁에 질린 표정으로 마을을 가로질러 뛰어갔다오. 그들은 누군가를 찾고 있다며 여러 마을 사람들에게 정보를 내놓으라 다그치더니, 또다시 서둘러 떠나버렸소.\n\n그들이 어느 쪽으로 떠났는지는 보지 못했구려. 내 파수꾼들에게 가서 그 두 사람이 어느 방향으로 갔는지 물어보시오."
  },
  [26705] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "다크샤이어 남쪽의 레빌 야영지를 찾아야 합니다.",
    ["D"] =
    "음, 적어도 이름 하나는 건졌군. 레빌이라고. 짐작 가는 데가 있소?\n\n서로 아는 사이라고? 그 미치광이 두 명이 당신을 찾고 있었소? 어쩐지 세 명 모두 그 끔찍한 표정을 하고 있는 이유를 이제야 알겠군....\n\n마을 남쪽으로 향해서 그들과 합류하도록 하시오. 그들이 떠난 지 하루가 넘었으니 -- 틀림없이 근처 어딘가에 야영지를 꾸렸을 거요."
  },
  [26706] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "다크샤이어 북쪽의 미스트맨틀 장원을 조사해야 합니다.",
    ["D"] =
    "레빌의 일지: 247일 차 - 2부\n\n칼레인 말로는 최근 미스트맨틀 장원에서 어둠의 기수들이 목격됐다고 한다. 그 이유는 우리 둘 다 알 길이 없다. 더 중요한 건 장원 근처에서 늑대인간이 나타났다는 거다. 보통 그곳은 언데드들이 우글거리는 곳인데 말이다.\n\n우리는 곧 떠나야 한다. 나는 그가 간절히 바라는 위안을 우리가 찾아주기를 바랄 뿐이다."
  },
  [26707] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "빛의 대성당에 있는 수사 대로우에게서 마력이 깃든 은괴를, 스톰윈드 항구에 있는 로버트 다비에게서 최고급 오크나무를 얻어야 합니다.",
    ["D"] =
    "고집불통 늑대인간을 상대하려면 우린 어둠의 힘을 빌려야 해 - 빛의 반대편에 있어서 사람들이 꺼려하는 그런 종류의 힘이지.\n\n난 이런 순간을 대비해왔고, 정의로운 대의를 위해 그 계획을 실행할 때가 왔네. 칼레인은 좋은 사람이야. 그의 아들이 어딨는지 알 권리가 있어.\n\n먼저, 스톰윈드 항구 지구로 가서 부두관리인 아가일과 대화하게. 그는 내... 친구가 보낸 특수 은상자를 보관하고 있을 걸세. 그곳에 간 김에, 조선소의 선박 건조공 로버트 다비도 찾아가게나. 오크나무가 좀 필요한데, 지난번 술집 난동 때 내가 그 친구 목숨을 구해줘서 나한테 빚을 진 게 하나 있거든.\n\n은을 확보하면 내 지인인 수사 대로우에게 가져가야 하네. 그는 성당 지하 도서관에서 사람들이 가장 많이 찾는 책들을 보호하는 임무를 맡고 있지.\n\n대성당 바로 아래에 있을 거야. 그에게 은을 건네면 축복을 내려줄 걸세.\n\n마력이 깃든 은괴와 최고급 오크나무를 모두 나에게 가져오게."
  },
  [26708] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "포획한 늑대인간을 심문해야 합니다.",
    ["D"] =
    "레빌이 자신의 계획을 털어놓고, 우리에게 필요한 정보를 얻어낼 도구까지 건네줬소. 하지만 막상 여기까지 오고 나니, 난... 난 도저히 이 짓을 못 하겠소. 내 대신 이 일을 해주시길 간청하오, $N. 제발! 마르디간이 어디로 갔는지, 그리고 무사한지 꼭 알아야 한단 말이오."
  },
  [26709] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "다크샤이어 남쪽으로 여행하여 롤랜드의 파멸에 도달해야 합니다. 늑대인간을 뚫고 길을 내고 칼레인과 레빌을 안에서 기다리십시오.",
    ["D"] =
    "내 아들이 롤랜드의 파멸에 있다면, 더 늦기 전에 서둘러 그곳으로 가야 하오. 늑대인간의 시체는 레빌과 내가 알아서 처리할 테니, 그곳에서 합류합시다. 그 일대를 지키는 늑대인간들을 뚫고 길을 확보해 주시면, 우리가 당신을 찾아가겠소.\n\n마르디간이 그곳에서 무사히 있기를 희망의 끈을 놓지 않으려 하지만, 최악의 사태가 머릿속을 떠나지 않는구려. 서둘러 주시오, 부탁이오, $n."
  },
  [26710] = {
    ["T"] = "어둠 속의 기수들",
    ["O"] = "칼레인과 레빌이 도착할 때까지 롤랜드의 파멸 내부에서 마르디간을 방어해야 합니다.",
    ["D"] =
    "이 무리의 우두머리 늑대가 곧 돌아올 거요. 놈은 사악하게 생긴 낫을 써서 날 자기네 부하로 만들려 했지. 낫으로 날 찔렀을 때 내 정신이 타들어가고 지져지는 것 같았지만 난 버텨냈소. 놈은 \"그곳\"으로 가야 한다며 나를 끝장내려고 이곳으로 끌고 왔다오.\n\n난 체력을 되찾아야 하오. 그러고 나면 우두머리 늑대가 돌아와 우리를 다 늑대로 만들기 전에, 여기서 빠져나가 아버지를 찾을 수 있을 거요!"
  },
  [26711] = {
    ["T"] = "죽음 속의 삶",
    ["O"] = "그늘숲 주변에서 밝은나무 꽃 8송이를 채집해야 합니다.",
    ["D"] =
    "이 저주받은 땅은 메디브의 타락이 휩쓸기 전까지만 해도 밝은나무 숲으로 불렸지만, 지금은 우리가 아는 그늘숲이 되어버렸습니다.\n\n땅이 어찌나 심하게 오염되었는지, 생명을 부지할 수 있는 그 어떤 것도 자랄 수 없다고 다들 믿고 있지요. 밖에 있는 호박들 보셨습니까? 속까지 썩어문드러졌습니다.\n\n하지만 저는 엘룬의 도우심과 자연의 치유력이 닿는다면, 아직 희망이 있다고 생각합니다.\n\n대지를 치유하려면 가장 먼저 과거의 잔재가 필요합니다. 그늘숲 곳곳에는 아직 밝은나무 꽃이라는 고대의 약초가 자라고 있습니다. 그 꽃을 8송이만 꺾어오시면 다음 단계의 실험에 사용할 수 있습니다."
  },
  [26712] = {
    ["T"] = "죽음 속의 삶",
    ["O"] = "그늘숲 곳곳의 언데드에게서 신선한 뼛가루를 모아야 합니다.",
    ["D"] =
    "다음 실험의 핵심 재료는 정말 불쾌한 물질입니다. 건강과 생명의 반대말은 죽음과 부패이고, 이 숲에는 그 조건에 딱 맞는 것들이 넘쳐나지요.\n\n묘지로 가서 그곳을 떠도는 언데드 괴물들에게서 방금 빻아낸 뼛가루를 모아오십시오. 5개면 충분할 겁니다, $n."
  },
  [26713] = {
    ["T"] = "죽음 속의 삶",
    ["O"] = "황혼의 숲을 찾아 달샘에서 약병을 채워야 합니다.",
    ["D"] =
    "그늘숲 한가운데에는 이 타락 속에서도 꿋꿋하게 생명이 피어나는 아름다운 곳이 있습니다. 바로 황혼의 숲이라 불리는 곳입니다. 그곳엔 제 선조들이 남긴 달샘이 있습니다. 그곳이 그늘숲을 구할 마지막 열쇠라고 저는 굳게 믿고 있습니다.\n\n다크샤이어 남쪽 길로 나가 가시덤불 골짜기로 가는 교차로 직전까지 가십시오. 거기서 북쪽으로 향하면 숲으로 들어가는 오솔길이 보일 겁니다. 지금까지 모은 재료들을 가져가서 이 약병에 달샘의 물을 채운 뒤 제게 가져오십시오."
  },
  [26714] = {
    ["T"] = "하녀의 몰락",
    ["O"] = "다크샤이어에서 넬의 옛 연인 파린을 찾아야 합니다.",
    ["D"] =
    "내 사랑, 파린을 보지 못한 지도 벌써 몇 주가 지났어요. 그의 얼굴을 다시 볼 수만 있다면 정말 행복하겠지만, 한 달 동안이나 연락이 닿지 않았고 이제 미스트맨틀 장원은 언데드 천지가 되어 버렸어요.\n\n전 스탈반 영주님을 모시기 위해 이곳에 남았지만, 그분이 변하고 계세요. 영주님이 숨기려 하시긴 하지만, 피부가 뼈에서 떨어져 나가는 걸 본 게 한두 번이 아니에요.\n\n스탈반 영주님은 바깥세상이 혼란에 빠졌고 내 사랑 파린도 그곳에서 죽었을 거라고 하셨어요. 그게 아니라면 왜 돌아오지 않겠냐면서요.\n\n전 그 사람 없이는 살 수 없어요. 안녕, 내 사랑. 빛이여, 부디 절 용서하소서."
  },
  [26715] = {
    ["T"] = "하녀의 몰락",
    ["O"] = "붉은까마귀 선술집에서 남은 빵 약간과 밝은나무 백포도주 한 통을 훔쳐야 합니다.",
    ["D"] =
    "그녀의 슬픔이 밴시를 만들 줄이야. 전 그녀의 영혼을 자유롭게 해주어야 합니다! 생각 좀 해보죠...\n\n생각났습니다! 우리는 그녀를 밖으로 유인해서 쉴 수 있게 해야 합니다. 건초밭에서 소풍을 즐기던 것이 우리가 가장 좋아하던 일이었으니, 소풍을 다시 가자고 권하면 아마 유혹을 느낄지도 모릅니다.\n\n제가 부자는 아니지만, 지금 같은 위급 상황에서는 어쩔 수 없습니다. 혹시 붉은까마귀 선술집에서 남은 빵과 그녀가 제일 좋아했던 와인, 밝은나무 백포도주 한 통을 훔쳐와 주실 수 있겠습니까?"
  },
  [26716] = {
    ["T"] = "하녀의 몰락",
    ["O"] = "다크샤이어 서쪽에 있는 새끼 검은약탈자늑대에게서 부드러운 늑대 털 6개를 수집해야 합니다.",
    ["D"] =
    "함께 소풍을 갈 때면, 종종 담요를 가져오는 걸 깜박해서 그녀에게 혼이 나기도 했죠. 이젠 더 이상 혼날 일이 없다는 사실이, 오히려 그 꾸중을 그립게 만들네요.\n\n<쓸쓸하게 미소 짓는 파린.>\n\n이 계획이 성공하려면 모든 게 완벽해야 하는데, 쓸만한 담요가 지금 없습니다. 빨리 하나 만들어야겠습니다.\n\n다크샤이어 외곽에 있는 새끼 검은약탈자늑대를 찾아 그들의 털을 가져와 주세요. 그러면 쓸 만한 담요를 만들 수 있을 겁니다."
  },
  [26717] = {
    ["T"] = "하녀의 몰락",
    ["O"] = "준비된 소풍 세트를 다크샤이어 서쪽에 있는 건초밭에 놓고 넬 옥스본의 영혼이 도착하면 안식에 들게 해야 합니다.",
    ["D"] =
    "이제 제 넬의 영혼을 마침내 편히 쉴 수 있게 해줄 수 있겠군요. 부디 이 저주받은 삶 이후에는 평안하시길 기도합니다.\n\n당신이 사용할 담요와 소풍 세트를 준비해 두었습니다. 우리가 만나던 건초밭으로 가서 그녀의 영혼을 꾀어내어 죽여 주십시오. 그것만이 최선이지만, 전 차마 그 광경을 지켜볼 용기가 나지 않습니다."
  },
  [26718] = {
    ["T"] = "죽음이 우리를 갈라놓을 때까지",
    ["O"] = "새끼 그물독거미에게서 반짝이는 거미줄 10개, 그늘숲 북쪽 강가에서 흠 없는 진주 7개를 수집해야 합니다.",
    ["D"] =
    "잠깐만요! 무기를 거두세요! 제발요! 당신의 도움이 필요합니다.\n\n그 금발 머리 잡종, 아서스 왕자가 로데론을 짓밟기 전까지만 해도, 페이 언더힐 양과 전 단둘이서 더없이 행복하게 살고 있었습니다. 스컬지가 들이닥쳤을 때 전 그녀를 멀리 떠나보냈고... 보시다시피 제 몰골이 이렇게 되고 말았죠.\n\n그녀가 다크샤이어로 돌아왔습니다. 전 그녀와 대화하고 다시 사랑을 키우고 싶어 미칠 지경입니다. 하지만 지금 이 상태로는 도저히 안 됩니다. 절 알아보기나 할까요?\n\n하지만 제게 계획이 있습니다! 그녀가 좋아하는 선물을 만들고 저 자신도 최대한 멀끔하게 꾸미는 겁니다. 절 알아보면 틀림없이 제 품에 뛰어들 거라 확신합니다.\n\n다크샤이어 북동쪽에 사는 새끼 그물독거미에게서 최고급 거미줄을 구해와야 하는데, 전 이 몰골로는 헛간 밖으로 나갈 수가 없습니다. 제가 필요한 걸 좀 구해주시겠습니까?\n\n간 김에 그늘숲과 엘윈 숲을 가르는 강 깊은 곳으로 잠수해 보세요. 완벽한 진주를 품고 있는 조개들을 발견할 수 있을 겁니다. 이 재료들만 있으면 숨 막힐 듯 아름다운 목걸이를 만들 수 있습니다."
  },
  [26719] = {
    ["T"] = "죽음이 우리를 갈라놓을 때까지",
    ["O"] = "스톰윈드 운하 지구의 향기로운 화원에서 붉은 장미를 구해야 합니다.",
    ["D"] =
    "이 목걸이는 페이에게 딱 맞습니다. 그녀는 늘 진주를 좋아했고, 당신이 구해온 진주는 정말 완벽하게 잘 어울립니다! 하지만, 아아, 그녀가 1마일 밖에서도 제 썩어가는 살점 냄새를 맡는다면 진주도 아무 소용이 없겠죠.\n\n로데론에 있을 때 우린 심심풀이로 우리만의 향수를 만들곤 했습니다. 그녀는 우리가 만든 장미 향수가 저와 가장 잘 어울린다고 항상 말했습니다. 제가 그 향수를 재현해 내면, 그녀는 단번에 저를 알아볼 겁니다.\n\n이 근방에서 제가 아는 유일한 꽃집은 스톰윈드의 운하 지구에 있는 프래그런트 플라워즈의 검프네뿐입니다. 그곳으로 가서 죽음의 냄새를 없앨 신선한 붉은 장미를 제게 구해다 주십시오."
  },
  [26720] = {
    ["T"] = "죽음이 우리를 갈라놓을 때까지",
    ["O"] = "다크샤이어 외곽에 있는 페이의 집, 폐기된 외양간 뒤쪽에 잭의 편지를 놓아두십시오.",
    ["D"] =
    "그녀의 마음을 얻기 위한 내 계획의 마지막 조각은 이것입니다: 바로 우리의 비밀 애칭을 사용하여 그녀에게 쓴 편지죠. 분명히 이 편지가 그녀를 제게 데려올 겁니다. 이것을 가져가 제 대신 그녀의 집에 놓아주시겠습니까? 파수꾼에게 들킬 위험을 무릅쓸 순 없습니다. 이 헛간 바로 뒤에서 그녀의 집을 찾으실 수 있을 겁니다."
  },
  [26721] = {
    ["T"] = "죽음이 우리를 갈라놓을 때까지",
    ["O"] = "페이 언더힐이 다크샤이어 외곽에 있는 마구간에 도착할 때까지 기다려야 합니다.",
    ["D"] =
    "편지를 놓아두셨다고요? 정말 미칠 듯이 설레는군요. 그녀가 곧 이곳에 올 거라 확신합니다. 향수도 뿌렸고, 이 선물이 그녀의 마음을 얻는 데 큰 도움이 될 겁니다. 당신 덕분에 우리가 다시 만났다고 그녀에게 말하면, 분명 그녀도 당신을 알게 되어 기뻐할 겁니다."
  },
  [26722] = {
    ["T"] = "죽음이 우리를 갈라놓을 때까지",
    ["O"] = "잭 아처의 고통을 덜어주고 그를 죽여야 합니다.",
    ["D"] =
    "이런 식으로 살 수는 없습니다. 더 이상은 안 됩니다. 그녀가 없다면 제 언데드 삶의 이유도 사라집니다. 이제 제겐 남은 게 아무것도 없습니다.\n\n제발, $n. 광장 경비병들이 제가 포세이큰이란 이유로 제 몸을 산산조각 내기 전에 당장 빠르고 깔끔하게 제 목숨을 끊어주십시오."
  },
  [26723] = {
    ["T"] = "수배: 역병걸린 늪괴물",
    ["O"] = "다크샤이어 북쪽 강둑을 배회하는 역병걸린 늪괴물을 처치해야 합니다.",
    ["D"] =
    "오직 밤에만 다크샤이어 북쪽 강둑을 순찰하며 그 일대를 죽음과 파괴로 몰아넣는 끔찍한 역병 야수가 목격되었습니다.\n\n강인한 마음씨와 자신감 넘치는 기술을 지닌 모험가 여러분, 괴물이 다크샤이어와 무역로에 너무 가까이 접근하기 전에 부디 이 괴물을 제거해 주십시오."
  },
  [26724] = {
    ["T"] = "흑마법",
    ["O"] = "동부 역병지대에 있는 암흑의 수행사제와 어둠마법사에게서 흑마법 고서 3권을 구한 다음 아이언포지 쓸쓸한 회랑의 주발 콥스시커에게 돌아가야 합니다.",
    ["D"] =
    "저주받은 자들의 교단은 다양한 금단의 마법과 흑마술에 재능이 있는 마법사들을 양성합니다. 그들의 주력은 강령술이지만 우리 흑마법사들도 그들의 연구에서 얻을 것이 많을 겁니다.\n\n동부 역병지대로 가서 그 교단의 암흑의 수행사제와 어둠마법사들을 모조리 쳐부수십시오. 놈들의 근거지인 맹독의 숲이나 곰팡이 계곡에서 찾아볼 수 있습니다. 그들의 기술을 연구할 수 있도록 놈들의 마법서를 세 권만 가져다주시오."
  },
  [26725] = {
    ["T"] = "흑마법",
    ["O"] = "동부 역병지대에 있는 암흑의 수행사제와 어둠마법사에게서 흑마법 고서 3권을 구한 다음 오그리마 어둠의 틈에 있는 쿠르굴에게 돌아가야 합니다.",
    ["D"] =
    "저주받은 자들의 교단은 마법사들에게 온갖 금단의 마법과 모든 형태의 흑마술을 훈련시키고 있지. 놈들의 주특기는 강령술이지만, 우리 흑마법사들도 그놈들의 연구에서 꽤 많은 것들을 배울 수 있을 게야.\n\n동부 역병지대로 이동하여 교단의 암흑의 수행사제와 어둠마법사들을 처치하라. 그들의 본거지인 맹독의 숲이나 곰팡이 계곡에서 놈들을 찾아볼 수 있다. 그들의 기술을 내가 직접 연구할 수 있게 놈들의 주문서를 3권만 구해 오너라."
  },
  [26726] = {
    ["T"] = "메아리치는 헌신",
    ["O"] = "역병숲에서 길을 잃은 엘리드린을 찾아 그의 영혼을 달래야 합니다.",
    ["D"] =
    "제가 보이시나요? 제 목소리가 들리시나요? 당신의 영혼은 산 자의 것임이 틀림없군요. 아마도 제 기도가 닿은 모양입니다.\n\n저는 세라핀이라 합니다. 한때는 쿠엘탈라스의 일원이었지만, 이제는 이 오염된 땅에서 잊혀져 버린 잔향에 불과하죠. 아직 끝나지 않은 임무 때문에 제 영혼이 여전히 이승을 떠나지 못하고 있습니다. 저주받은 자들은 영원히 고통받고… 산 자들은 너무도 쉽게 잊어버리는군요.\n\n저의 사랑하는 이 —- 엘리드린 —- 은 스컬지의 첫 번째 공격 때 목숨을 잃었습니다. 그의 영혼도 저처럼 묶여 있지만 분노와 슬픔에 사로잡혀 있습니다. 제게 평온을 주시고 싶으시다면, 먼저 그를 해방시켜 주십시오. 그는 우리가 마지막까지 저항했던 폐허 근처를 방황하며, 자신의 실패에 괴로워하고 있습니다. 역병숲 바로 근처에서 그를 찾을 수 있을 겁니다."
  },
  [26727] = {
    ["T"] = "메아리치는 헌신",
    ["O"] = "곰팡이 계곡에 있는 추악한 힐두르에게서 세라핀의 로켓을 되찾아야 합니다.",
    ["D"] =
    "제가 엘리드린과 묶여있는 건 저를 이 세계에 얽매는 이유 중 일부일 뿐입니다. 제 유해는 흙으로 돌아가기도 전에 약탈당했습니다.\n\n엘리드린이 우리가 맺어진 지 5주년 되던 날 제게 로켓을 선물해 주었습니다. 그런데 그 로켓이 저주받은 자들의 교단의 손에 들어갔습니다. 여기서 남쪽으로 향하면 곰팡이 계곡에 그 기운이 느껴집니다.\n\n제 시신을 약탈한 묘실 도굴꾼은 생전에 우리 집을 지나가던 상인 힐두르로, 제가 아는 자였습니다. 그가 지금 어떤 존재가 되었는지는 알 수 없으나, 이제는 더 이상 상인이 아니라는 것만은 분명합니다."
  },
  [26728] = {
    ["T"] = "현장 학습",
    ["O"] = "라스무센 교수를 처치하고 우등생들로부터 4개의 프로젝트 노트를 모아야 합니다.",
    ["D"] =
    "저기요, 제게 스칼로맨스에 대해 언급했다고 해서 저를 이단자로 오해하지 마십시오, $C님. 제 마음은 언제나 은빛 여명회와 함께합니다. 저는 어둠의혈맹 이교도들 틈에 잠입해서 그들의 계획을 저지할 기회를 엿보며 수많은 날을 보냈습니다. 당신의 등장은 제 정체를 들키지 않으면서 그들의 일에 관여할 좋은 핑계거리가 되겠군요.\n\n스칼로맨스 우등생들로 구성된 한 무리가 동부 역병지대로 무언가를 조사하기 위한 현장 실습을 나왔습니다. 하지만 그들의 지도 교수인 라스무센은 저를 의심하며 그들이 이곳에 온 목적을 말해주지 않습니다.\n\n그와 그의 멍청한 제자들을 쓰러뜨리고 그들의 노트를 되찾으십시오. 어쩌면 그들이 이곳에 있는 목적을 파악해 볼 수 있을지도 모릅니다."
  },
  [26729] = {
    ["T"] = "현장 학습",
    ["O"] = "코린 삼거리에서 명예교수 칠본을 찾아 그를 죽이고 그의 일지를 회수해야 합니다.",
    ["D"] =
    "이름 없는 전직 교사가 이제는 칠본이라 불리나 보군요. 조사를 계속하기 위해 코린 삼거리로 향했다는 메모가 있습니다. 우리가 아는 한, 새로 태어난 리치는 자신의 능력을 키우는 데 시간이 걸립니다. 즉 군대 전체를 소환하지 않고도 충분히 그를 상대할 수 있을 겁니다.\n\n교단이 이곳에서 무엇을 찾고 있는지에 대해 그가 더 많은 정보를 가지고 있기를 바라지만, 이 기회를 빌려 그가 더 강력해지기 전에 미리 그를 처리해야 합니다."
  },
  [26730] = {
    ["T"] = "의심스러운 편지",
    ["O"] = "동부 역병지대에 있는 스탈링 교수에게 의심스러운 편지를 가져가야 합니다.",
    ["D"] =
    "당신은 칠본의 소지품 안에서 라스 프로스트위스퍼에게 보내려던 미완성된 편지를 발견했습니다. 이렇게 적혀 있습니다:\n\n\"라스, 접선 장소에 대한 알림을 받았고 물건을 전달할 연락병을 급파했다. 로데론에 그렇게 가까이서, 그것도 신디케이트가 통제하는 지역을 거쳐 접선하는 게 과연 현명한 일일까? 포세이큰에게 어둠의 은신 따위는 통하지 않아. 만약 성물함이 잘못된 자의 손에 들어가기라도 한다면, 그 결과는...\"\n\n스탈링 교수가 이 물건에 관심을 가질 것입니다."
  },
  [26731] = {
    ["T"] = "현장 학습",
    ["O"] = "밤이 되면 인수인계를 위한 접선 장소를 찾고, 접선을 관찰할 수 있는 장소를 물색해야 합니다.",
    ["D"] =
    "리치는 성물함을 확보하여 정화하기 전까지는 결코 진정으로 쓰러뜨린 것이 아닙니다. 칠본의 성물함은 그가 가지고 있지 않았고, 이 편지를 보아하니 다른 곳으로 옮겨진 듯합니다.\n\n이것 보십시오 - 일지의 마지막 항목에 따르면 다가오는 접선이 왕립 연금술 학회의 회원과 로데론의 폐허 바로 아래에 있는 외딴 지역에서 열릴 예정이라고 합니다! 편지에 쓰여진 방향대로라면 당신은 알터랙 산맥을 지나 단드레드 장원을 거쳐 로르다미어 호수 동쪽 가장자리를 따라 이동하게 될 것입니다.\n\n이 접선은 밤에 이루어질 것으로 보이므로 반드시 저지해야 합니다. 저는 여기 남아서 일지의 나머지 내용을 해독하는 데 집중하겠습니다."
  },
  [26732] = {
    ["T"] = "현장 학습",
    ["O"] = "접선을 관찰하고 칠본의 성물함을 가로채야 합니다.",
    ["D"] =
    "상자 안에 자리를 잡고 당신이 늦지 않게 도착했기를 바라며, 너무 오래 기다리지 않아도 접선이 이루어지기를 바랍니다.\n\n당신의 인내는 곧 보상받습니다. 쌓여 있는 통들 사이로 횃불 불빛이 일렁이고, 어스름한 밤의 어둠 속에서 형체들이 모습을 드러냅니다."
  },
  [26733] = {
    ["T"] = "현장 학습",
    ["O"] = "칠본의 성물함을 검은바위 산으로 가져가 산 내부의 용암에 파괴를 시도해야 합니다. 그런 다음 동부 역병지대의 버려진 예배당 근처에 있는 스탈링 교수에게 결과를 알려야 합니다.",
    ["D"] =
    "리치의 성물함을 정화하는 일은 결코 가벼운 일이 아닙니다. 하지만 한 가지 확실한 방법이 있습니다 - 검은바위 산의 끓어오르는 뜨거운 용암 속으로 성물함을 던져버리는 것입니다. 칠본의 영혼을 묶어두는 뼈대가 그 산의 작열하는 열기로도 녹지 않는다면, 그 어떤 것으로도 그를 파괴할 수 없을 것입니다.\n\n프랑클론 포지라이트의 무덤을 지나 사슬을 따라가면, 용암 벌판 깊은 곳의 용암 웅덩이에 쉽게 도달할 수 있습니다."
  },
  [26734] = {
    ["T"] = "현장 학습",
    ["O"] = "긴급 보고서를 동부 역병지대의 빛의 희망 예배당에 있는 니콜라스 제베렌호프 경에게 전달해야 합니다.",
    ["D"] =
    "당신이 여행하는 동안 칠본의 일지를 해독할 수 있었습니다. 제가 알게 된 사실은 끔찍할 정도입니다. 제가 지금 얼마나 많은 것을 당신과 나눌 수 있을지 확신할 수 없으니, 자세한 것은 상부의 판단에 맡기겠습니다. 제가 작성한 이 보고서를 빛의 희망 예배당에 있는 니콜라스 제베렌호프 공작에게 당장 가져가 주십시오!"
  },
  [26735] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "다로우샤이어에서 과거의 유물을 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 페더문에게 가져가야 합니다.",
    ["D"] =
    "당신도 느끼십니까, $C님? 이 땅의 존재의 자연스러운 조화가 무너짐에 따라 이 땅이 비명을 지르며 고통스러워하고 있는 것을요? 저는 그 부름에 응답하여 머나먼 곳에서 찾아왔지만, 이제 막 이곳에 발을 들이자마자 이 땅의 엄청난 고통에 압도당할 것만 같습니다. 당신의 도움이 필요합니다. \n\n역병이 퍼지기 전, 이곳은 이스트월드라는 이름의 푸르고 풍요로운 숲이자 무성하게 자라나는 생명들로 가득한 농토였습니다. 이 땅이 치유되려면, 우리가 이 땅이 예전에 어떤 모습이었는지를 기억나게 해주어야 합니다. \n\n이곳에 살던 이들은 역병을 피해 도망치거나 굴복할 때, 과거 자신들이 가꾸던 삶의 유물들을 남겨두었습니다. 이 땅의 어두운 기억들을 없애는 정화 의식을 치르려면, 그 유물들을 많이 모아야 합니다. \n\n먼저 남쪽의 다로우샤이어라는 마을에서부터 시작하십시오. 옛 흔적이 될 만한 것이 없는지 살펴보십시오."
  },
  [26736] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "코린 삼거리에서 과거의 유물 두 개를 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 페더문에게 가져가야 합니다.",
    ["D"] =
    "다로우샤이어에서 길을 따라 올라오는 여행자는 다음으로 코린 삼거리에 도착했을 겁니다. 저는 그 마을에서 즐거운 축제, 특히 추수 감사절 축제가 열렸다는 이야기를 들은 적이 있습니다. 심지어 우리 동족 사이에서도 붉은수탉 여관은 맛있는 에일로 유명했지요. 우리는 그 풍성함과 기쁨의 기억을 소환해야 합니다. \n\n코린 삼거리로 여행하여 그곳에서 여러 유물을 찾아주십시오."
  },
  [26737] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "브라우만 제분소에서 과거의 유물을 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "우리가 지금 서 있는 곳 바로 북쪽에는 브라우만 제분소가 있었습니다. 과거에는 줄아만과 영원노래 숲에서 강을 따라 흘러온 통나무들을 톱으로 잘라내던 곳이었죠. 개인적으로 이런 행동은 탐탁지 않지만, 그곳에서 일하던 일꾼들이 분명 그들의 봉사에 대한 흔적을 남겨 두었을 테니 그것을 담아야 합니다. \n\n제분소에서 유물을 하나 찾아 제게 가져다주십시오."
  },
  [26738] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "메말라버린 녹색물결 강 근처의 농장에서 과거의 유물 두 개를 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "녹색물결 강은 예전에 산맥을 타고 내려와 이스트월드를 가로지르며 하류의 농장들에 나무와 생명을 가져다주곤 했습니다. 그 농장들의 폐허 중 일부는 아직 남아있습니다. \n\n검은나무 농장은 같은 이름의 호수 근처에 있었고, 녹색물결 농장은 강 건너 그보다 북쪽에 위치해 있었습니다. 그 농장들을 수색하여, 행복했던 시절의 유물을 찾을 수 있는지 확인해 주십시오."
  },
  [26739] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "신더홈의 폐허에서 과거의 유물 두 개를 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "스트라솔름으로 다가가는 여행자들은 장엄한 문을 지났습니다. 이 문이 인간들에게 어떤 의미였는지는 알 수 없지만, 그 문 옆에는 신더홈이라는 마을이 있었습니다. 과거에 성장해 가던 공동체의 모습은 이제 거의 남아있지 않지만, 우리는 그들의 유산을 담아낼 수 있습니다. \n\n서북쪽으로 나 있는 스트라솔름으로 가는 길을 따라 이동한 뒤, 문을 지나 지금은 역병숲이 된 폐허를 수색해 주십시오. 발견한 것은 무엇이든 가져와 주십시오."
  },
  [26740] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "테러데일에서 과거의 유물을 찾아 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "역병숲의 반대편에는 한때 웨스트데일이라 불렸지만, 지금은 그 이름에 걸맞게 테러데일이라 불리는 작은 마을이 있습니다. 스트라솔름 주민 중 상당수가 아서스가 도시를 공격할 때 이곳으로 피신해 오면서 역병까지 함께 옮겨 왔습니다. \n\n저는 그곳이 꽤 일찍 무너졌다고 알고 있습니다. \n\n이제 거의 다 됐습니다, $C님. 웨스트데일의 역사적인 유물을 우리 컬렉션에 추가하기 위해 가져와 주십시오."
  },
  [26741] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "스트라솔름의 거주민들로부터 10개의 과거의 유물을 수집해 동부 역병지대의 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "단 한 곳만이 남았고, 저를 대신해 이 위험을 감수해 달라고 요청하기가 몹시 두렵지만, 당신이 마지막 유물들을 찾아내는 데 성공한다면, 저는 필요한 의식을 준비해야만 합니다. \n\n그것들은 스트라솔름 거주민들의 유물들입니다. \n\n한때 북방의 빛나는 보석이라 불렸던 곳이 이제는 흉가와 영원히 타오르는 폐허가 되었습니다. 언데드와 저주받은 자들의 교단이 그 거리를 걷고 있습니다. \n\n이 새로운 주민들 중 상당수가 망자들에게서 물건을 약탈했을 것입니다. 그들의 불법적인 약탈품을 빼앗아 제게 가져다주십시오. \n\n이제 거의 다 끝났습니다."
  },
  [26742] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "동부 내륙지의 세라다인에 있는 폐허가 된 사원으로 여행하여 의식용 제단을 찾으십시오. 안전을 위해 동료들과 함께 가시길 권합니다.",
    ["D"] =
    "저는 이 땅의 고통 때문에 너무 약해져 여기서 의식을 치를 수 없을 것 같습니다. 자연의 힘이 더 강한 곳으로 가셔야 합니다. \n\n동부 내륙지에 있는 세라다인은 그리 멀지 않습니다. 적대적인 녹색 용기병들을 피할 수 있다면, 정화 의식을 수행하기에 완벽한 장소인 사원 폐허를 찾을 수 있을 것입니다. 묶음으로 된 유물들을 제단으로 가져가 그 위에 올려두십시오. 이 땅을 파괴하는 데 관여했던 강력한 존재들의 기억들이 끌려 나올 것입니다. 당신은 그들을 물리쳐야 합니다.\n\n당신에게 너무 많은 것을 부탁드렸군요 $N님, 할 수 없다 해도 이해합니다. 당신을 도울 동맹을 모아야 할 것이고, 맞서 싸워야 할 것들은 말로 설명하기 어려울 만큼 끔찍한 악몽입니다. 제가 드릴 수 있는 말은, 이 땅의 영혼 자체를 정화하지 않고서는 치유를 시작조차 할 수 없다는 것뿐입니다."
  },
  [26743] = {
    ["T"] = "이스트월드의 기억",
    ["O"] = "세라다인의 제단에서 유물 꾸러미를 무거운 기억의 구속에서 해방시켜 정화한 다음, 동부 역병지대 빛의 희망 예배당에 있는 아일라나 문페더에게 가져가야 합니다.",
    ["D"] =
    "저를 만나고 놀라시는 게 느껴집니다, $C님. 그렇습니다. 저 역시 이스트월드의 기억 중 하나입니다. 아시다시피, 스컬지 역병이 시작되었을 때 저도 거기에 있었습니다. 그리고 제가 평생 부끄러워할 일이지만, 이 사태를 막으려 하기보다는 도망치기를 선택했죠.\n\n당신 앞의 과업은 몹시 위험하지만, 당신은 기억의 굴레로부터 이스트월드뿐 아니라 저마저 해방시키는 셈입니다.\n\n이야기가 끝나면, 제가 기억들을 불러내고 의식을 시작하겠습니다. 파티원들과 단단히 준비하십시오..."
  },
  [26744] = {
    ["T"] = "영업 개시",
    ["O"] = "스트라솔름과 테러데일 사이에 있는 역병숲의 교차로에 위치한 여관 폐허를 수색해 마빈 캐쉬의 흔적이 있는지 찾아야 합니다.",
    ["D"] =
    "이제 전 장사할 준비가 다 됐어요! 뭘 원하십니까? \n\n아, 잠깐만요... 창고에 물건이 별로 없는 것 같네요. 팔 물건이 없는데 어떻게 물건을 팔죠? \n\n마빈 캐쉬가 내게 팔 물건을 가져다주곤 했어요. 여기 없는 걸 보니, 아직 배달 경로를 도는 중인가 보군요. 그는 스트라솔름과 이쪽으로 이어지는 길의 교차로 바로 옆에 있는 여관에 들르곤 했어요. 여관에 제 인벤토리를 두고 갔는지 한 번 확인해 주시겠어요. 물건들을 제게 가져오시면 제 물건 값이 얼마나 엄청나게 싼 지 아시게 될 겁니다!"
  },
  [26745] = {
    ["T"] = "영업 개시",
    ["O"] = "동부 역병지대에 있는 검은나무 호수 근처 농장으로 마빈의 흔적을 따라가야 합니다.",
    ["D"] =
    "당신은 편지를 펼쳐 내용을 읽습니다. \n\n\"애거타에게,\n\n이 편지를 찾아서 나를 쫓아와 주기를 기도할 수밖에 없소. 언데드 군대가 로데론을 향해 다가오고 있소. 나는 굿맨 가족과 함께 검은나무 농장에서 피난할 생각이오. 부디 무사하길 바라오. 빛의 가호가 당신과 함께하기를.\n\n마빈\"\n\n어쩌면 아우구스투스가 언급했던 그 사람 아닐까요?"
  },
  [26746] = {
    ["T"] = "영업 개시",
    ["O"] = "동부 역병지대의 코린 삼거리에 있는 여관으로 마빈의 흔적을 쫓아가야 합니다.",
    ["D"] =
    "여기 있는 편지는 습기 때문에 축축하고 곰팡이가 피어 있습니다. 당신은 조심스럽게 편지를 열었지만, 글씨를 알아보기 힘듭니다. \n\n\"애가...에게,\n\n우리에겐... 이틀이... 게걸스러운 구울들이... 근처 언덕을 배회하고... 코린 삼거리로 가는 여정... 여관에서 방 하나를 구하고... 그곳에서 당신에게 남길 말.\n\n마빈\"\n\n어쩌면 코린 삼거리에 있는 여관을 수색해 보는 편이 좋지 않을까요?"
  },
  [26747] = {
    ["T"] = "영업 개시",
    ["O"] = "동부 역병지대의 메렐다르 호수 해안에서 마빈 캐쉬의 흔적을 수색해야 합니다.",
    ["D"] =
    "당신은 편지를 열고 내용을 확인합니다. \n\n\"애거타에게,\n\n다로우샤이어에서 전투가 벌어졌고, 수도로 향하는 길은 우리에게 막혔다는 소식을 들었소. 굿맨 일가가 배를 가진 사람을 찾았고, 우리는 메렐다르 호수를 가로질러 반대편 해안에서 탈출을 시도해 볼 거요. 이 암울한 시기에 빛의 축복이 우리 모두에게 임하길.\n\n마빈\"\n\n호수 근처 부두를 한 번 확인해 보는 게 어떨까요?"
  },
  [26748] = {
    ["T"] = "영업 개시",
    ["O"] = "동부 역병지대의 테러데일에 있는 정신나간 아우구스투스에게 회수된 물품이 든 상자를 반환해야 합니다.",
    ["D"] =
    "이 마차에 저장된 마른 약초 묶음, 성스러운 신앙의 봉인들, 그리고 비전 양초들은 흙먼지가 뽀얗게 쌓여 있지만 아직 쓸만해 보입니다. 아마 이것들이 마빈 캐쉬가 아우구스투스에게 가져다줄 예정이었던 물건의 짐이 아닐까요? \n\n어느 쪽이든, 이 상인과 그의 친구들에게 무슨 일이 일어났는지 알려줄 다른 단서는 없습니다. 그들이 운이 좋았다면 스컬지 군대의 진군을 피해 탈출할 수 있었을지도 모릅니다."
  },
  [26749] = {
    ["T"] = "경쟁자 처치",
    ["O"] = "스컬지 병사 6명, 지하추적자 4마리, 찢어진 비명꾼 2마리, 역병걸린 돼지 1마리를 처치해야 합니다.",
    ["D"] =
    "제 손님들은 궁극의 쇼핑 경험을 원하시는데, 가게 주변을 맴도는 불쾌한 불량배 몇 명이 자꾸 눈에 띄는군요. \n\n저들에게 다른 곳에서 시간을 보내도록 설득 좀 해주시겠어요? 어떤 방식의 설득이든 상관없습니다! 하! 두고 보세요! 정말 엄청날 테니까요! \n\n아, 그리고 저 돼지 중 한 마리도 처리해 주세요. 내 마지막 도넛을 먹어 치웠거든요!"
  },
  [26750] = {
    ["T"] = "경쟁자 처치",
    ["O"] = "정신나간 아우구스투스를 위해 가고일의 날개 8개와 괴물의 봉합선 4개를 구해야 합니다.",
    ["D"] =
    "오 안 돼, $N! 문제가 생겼어요 - 손님들이 살 물건을 담을 쇼핑백이 하나도 없지 뭡니까! \n\n스트라솔름에 들어가 굿맨 씨네 잡화점에서 쇼핑백을 더 가져다주실 순 없겠죠? \n\n불에 타고 있다고요? 그럼 안 되겠네요. 알았어요. \n\n내가 날아다니면서 비명을 지르는 박쥐처럼 생긴 괴물들을 봤거든요. 그냥 박쥐 말고요! 박쥐 같이 생긴 놈들이요. 놈들의 날개라면 훌륭한 쇼핑백이 될 거예요. 그리고 실도 필요해요. 아마 역병숲을 어슬렁거리는 꿰맨 괴물들에게서 구하면 될 거예요. 그래요! 바로 그거예요!"
  },
  [26751] = {
    ["T"] = "방문 마케팅",
    ["O"] = "6명의 유령 주민에게 아우구스투스의 미친듯한 초특가 세일 소식을 알리십시오!",
    ["D"] =
    "이제 정말 장사할 준비가 끝났습니다! 그러니 밖으로 나가 테러데일의 선량한 사람들에게 알리세요. 쇼핑의 시간이 도래했다고 말입니다! \n\n이 기회를 놓치면 후회하실걸요. 제 물건값은 완전 미쳤거든요!"
  },
  [26752] = {
    ["T"] = "목적을 가지기 위해",
    ["O"] = "동부 역병지대에 있는 아돈을 위해 유령 타란툴라 8마리를 처치해야 합니다.",
    ["D"] =
    "무사히 도착하셨군요 모험가여! 이 오염된 땅에서 새로운 얼굴을 본 지도 꽤 오래되었군요.\n\n저는 쿠엘탈라스에 닥칠 위험을 감시하기 위해 이곳에 배치되었고, 비록 죽었거나 행방불명된 상관들의 명령을 지키는 것이 우스워 보일지라도 저는 이 임무를 회피하지 않을 것입니다. 그러나 감시를 계속하면서, 저는 누군가 무기를 들고 해결할 의지만 있다면 바로잡을 수 있는 이 지역의 문제점들을 발견하게 되었습니다.\n\n당신이 바로 그런 $R이라면, 역병숲 남쪽의 거미로 우글거리는 동굴로 관심을 돌려 주십시오. 그 짐승들의 수를 줄여 당신의 전투력을 증명해 보이십시오."
  },
  [26753] = {
    ["T"] = "숲 너머의 땅",
    ["O"] = "유령 타란툴라의 알주머니에서 쿠엘도레이 비단 가닥 6개를 모아 동부 역병지대에 있는 아돈에게 가져다주어야 합니다.",
    ["D"] =
    "쿠엘탈라스가 몰락한 이후, 저는 제 동족들에게서 쫓겨난 추방자 신세가 되었습니다. 쿠엘리시엔 오두막에 있는 엘프들은 외부인과의 접촉을 거부했고, 실버문으로 가는 길은 막혀 있습니다. 저는 혼자입니다.\n\n절 좀 도와주시겠습니까? 역병숲 남쪽에 사는 유령 타란툴라의 알주머니에는 실버문에서 질 좋은 망토를 만드는 데 사용하는 섬세한 실크 가닥이 들어 있습니다. 제가 다시 한번 실버문에 살았던 기분을 기억할 수 있도록 그 가닥들을 좀 가져다주십시오."
  },
  [26754] = {
    ["T"] = "숲 너머의 땅",
    ["O"] = "동부 역병지대에 있는 아돈에게 태양의 온기가 담긴 특별한 포도주 한 병을 가져다주십시오.",
    ["D"] =
    "즐거운 날이었다면 당신의 승리를 축하하며 태양의 빛으로 발효시킨 포도주, 태양의 온기가 담긴 특별한 포도주로 건배를 나누었을 겁니다. 그걸 다시 맛볼 수 있다면 무엇이든 기꺼이 내놓을 텐데 말입니다.\n\n쿠엘리시엔 오두막에 있는 엘프들이 가지고 있을지도 모르지만, 그들은 예전 쿠엘탈라스에서 쫓겨난 자들입니다. 마지막으로 그들과 대화하려 했을 때 그들은 저를 쫓아내며 다시는 자신들의 영역에 들어오지 말라고 경고했습니다. 그들의 분노를 사고 싶지 않습니다. 어쩌면 당신이 저 대신 그곳에 가서 포도주를 좀 구할 수 있지 않겠습니까?"
  },
  [26755] = {
    ["T"] = "태양의 물",
    ["O"] = "운고로 분화구의 골락카 간헐천에 있는 살아있는 물과 튀기는 물의 정령에게서 순수한 샘물 구슬 8개를 모아 동부 역병지대 쿠엘리시엔 오두막의 셀레스테 코레알리스에게 가져가야 합니다.",
    ["D"] =
    "태양의 온기가 담긴 특별한 포도주를 찾으시나요? 비싼 입맛이시군요! 요즘은 그런 음료를 구하기가 아주 어렵습니다.\n\n운이 좋게도 저는 지금 태양의 온기가 담긴 특별한 포도주를 숙성 중인데, 더 만들기 위한 핵심 재료가 다 떨어져 가고 있었습니다. 제게 그 재료를 찾아다 주시면 포도주 한 병은 다 당신 겁니다!\n\n저는 영원노래 숲을 가로지르던 그런 순수한 샘물이 필요합니다. 영원노래 숲이 스컬지에 의해 황폐해진 이후로, 다른 수원지를 찾아보셔야만 합니다. 온천이 있는 태고의 장소 같은 곳이 좋을까요? 그곳이 어디일지 찾아내는 건 당신에게 맡기겠습니다."
  },
  [26756] = {
    ["T"] = "숲 너머의 땅",
    ["O"] = "동부 역병지대 맹독의 숲 도축장에서 순찰자 라리아를 찾아 그녀를 죽이고, 동부 역병지대에 있는 아돈에게 돌아가야 합니다.",
    ["D"] =
    "당신에게 부탁하고 싶은 일이 하나 더 있습니다, $R.\n\n스컬지가 우리 동족의 땅을 짓밟았을 때 우리는 최고의 순찰자들을 많이 잃었습니다. 운이 좋았던 이들은 죽음을 맞이했죠. 그러나 다른 이들은 언데드의 저주로 인해 일으켜 세워져 조종당하고 있습니다. 그들 중 한 명은 저와 가까웠던 사람입니다.\n\n맹독의 숲은 스컬지가 이 땅에서 더러운 음모를 꾸미는 작전 기지 중 하나입니다. 그 숲의 사령관은 예전에 실버문의 순찰자였던 라리아입니다. 부디 그녀가 일찍이 허락받지 못했던 안식을 맞이하게 해주십시오. 그녀가 편히 쉬고 있다는 사실을 알게 된다면 제 마음도 크게 위안을 얻을 것입니다."
  },
  [26757] = {
    ["T"] = "그림자가 드리우지 않는 곳",
    ["O"] = "동부 역병지대에 있는 아돈에게 라리아의 편지를 가져가야 합니다.",
    ["D"] =
    "순찰자 라리아의 시신에서 발견한 이 편지는 오래되고 급하게 휘갈겨 쓴 것 같습니다. 봉인조차 되어 있지 않습니다. 아돈이라면 틀림없이 이것에 관심을 가질 것입니다."
  },
  [26758] = {
    ["T"] = "야수의 본성",
    ["O"] = "그늘날개로 알려진 흉악한 괴물을 처치하고, 동부 역병지대 산마루 경비탑 근처에 있는 파트리스 얼가딘 부인에게 돌아가야 합니다.",
    ["D"] =
    "반갑습니다, 모험가여! 이 황량한 땅에서 우호적인 얼굴을 뵙게 되어 다행이군요.\n\n제 남편은 가시덤불 골짜기에서 사냥꾼으로 명성을 떨치고 있습니다. 저는 역병지대의 거대한 야수들을 사냥하여 남편의 명성을 뛰어넘으려 했으나, 제가 그토록 잘 알던 이 땅의 파괴된 모습을 보며 비통함에 사로잡혀 버렸습니다. 예를 들어, 이 집은 한때 친한 친구들의 소유였죠.\n\n전리품을 찾는 대신 우리는 스컬지가 창조해 낸 끔찍한 생명체들을 파괴하는 데 도움을 주어야 합니다. 그늘날개라는 거대한 알비노 악마 박쥐가 매리스 농장 북쪽 시골을 맴돌고 있습니다. 이 더러운 생명체를 파괴하는 데 당신의 도움을 받을 수 있다면 대단히 감사하겠습니다."
  },
  [26759] = {
    ["T"] = "야수의 본성",
    ["O"] = "피고름구더기로 알려진 사악한 괴물을 죽이고 동부 역병지대의 산마루 경비탑 근처에 있는 파트리스 얼가딘 부인에게 돌아가야 합니다.",
    ["D"] =
    "그늘날개의 죽음으로, 당신은 강인한 짐승을 다룰 수 있다는 것을 증명해 보였습니다. 당신이 죽여 주셨으면 하는 괴물이 하나 더 있습니다.\n\n북쪽으로, 스트라솔름으로 향하는 길을 따라가다 보면 피고름구더기로 알려진 피투성이 괴물을 만나게 될 것입니다. 통제할 수 없을 만큼 수많은 끔찍한 벌레들을 번식시키기 전에 그것을 처치해 주십시오."
  },
  [26760] = {
    ["T"] = "역병숲의 가마솥",
    ["O"] = "역병숲에 있는 스컬지 가마솥에 다목적 중화제를 넣고 연금술사 디더스에게 돌아가야 합니다.",
    ["D"] =
    "당신은 서부 역병지대의 가마솥들에 아주 훌륭한 작업을 해주셨습니다. 이제 우리의 주의를 동부 역병지대에서 일어나는 유사한 스컬지 활동으로 돌려야 할 때입니다. \n\n우리의 정보에 따르면 역병숲에는 3개의 역병 가마솥이 작동 중입니다. 이것들에는 가마솥 군주가 없으니 일반적인 중화제를 사용하여 가마솥의 내용물을 오염시켜 최소한 당분간은 사용할 수 없게 만들 수 있을 거라 봅니다. 이 약병을 챙겨서 가마솥으로 가십시오. 단, 조심하셔야 합니다. 역병숲은 역병지대 스컬지 전력의 심장부이며 그들의 병사들이 득실거리는 곳이니까요."
  },
  [26761] = {
    ["T"] = "마지막 가마솥",
    ["O"] = "곰팡이 계곡과 맹독의 숲에 있는 스컬지 가마솥에 다목적 중화제를 넣고 연금술사 디더스에게 돌아가야 합니다.",
    ["D"] =
    "동부 역병지대의 맹독의 숲과 곰팡이 계곡에 각각 1개씩, 총 2개의 마지막 가마솥이 남아 있다는 보고가 들어왔습니다. 이 두 가마솥에 중화제를 넣기만 하면, 적어도 지금 당장은 역병의 확산을 통제할 수 있을 것입니다. \n\n영웅이여, 서둘러 가십시오. 그래야 이 문제를 매듭지을 수 있을 테니까요."
  },
  [26762] = {
    ["T"] = "역병숲의 가마솥",
    ["O"] = "역병숲에 있는 스컬지 가마솥에 다목적 중화제를 넣고 연금술사 알빙턴에게 돌아가야 합니다.",
    ["D"] =
    "당신은 서부 역병지대의 가마솥들에 아주 훌륭한 작업을 해주셨습니다. 이제 우리의 주의를 동부 역병지대에서 일어나는 유사한 스컬지 활동으로 돌려야 할 때입니다. \n\n우리의 정보에 따르면 역병숲에는 3개의 역병 가마솥이 작동 중입니다. 이것들에는 가마솥 군주가 없으니 일반적인 중화제를 사용하여 가마솥의 내용물을 오염시켜 최소한 당분간은 사용할 수 없게 만들 수 있을 거라 봅니다. 이 약병을 챙겨서 가마솥으로 가십시오. 단, 조심하셔야 합니다. 역병숲은 역병지대 스컬지 전력의 심장부이며 그들의 병사들이 득실거리는 곳이니까요."
  },
  [26763] = {
    ["T"] = "마지막 가마솥",
    ["O"] = "곰팡이 계곡과 맹독의 숲에 있는 스컬지 가마솥에 다목적 중화제를 넣고 연금술사 알빙턴에게 돌아가야 합니다.",
    ["D"] =
    "동부 역병지대의 맹독의 숲과 곰팡이 계곡에 각각 1개씩, 총 2개의 마지막 가마솥이 남아 있다는 보고가 들어왔습니다. 이 두 가마솥에 중화제를 넣기만 하면, 적어도 지금 당장은 역병의 확산을 통제할 수 있을 것입니다. \n\n영웅이여, 서둘러 가십시오. 그래야 이 문제를 매듭지을 수 있을 테니까요."
  },
  [26764] = {
    ["T"] = "우리에겐 기술력이 있다",
    ["O"] = "스컬지 기술자 라트렌치를 처치하고 투석기 설계도를 빼앗으십시오. 동부 역병지대의 티르의 손 수도원으로 향하는 길목에서 그를 찾아보십시오.",
    ["D"] =
    "여어, 안녕하신가, $C. 친근한 - 게다가 살아 있는 - 얼굴을 보니 좋구만. \n\n언데드가 우글거리는데도, 당신처럼 진취적이고 젊은 $R들을 위한 기회는 이곳에도 있다네! 스컬지 놈들이 역병지대를 휩쓸고 지나가면서 남겨둔 투석기들이 잔뜩 있고, 이젠 그 놈들이 자기들 투석기를 일부 수거하기 시작했지. 그게 어떻게 돌아가는 원리인지 내가 한번 알고 싶다 이 말씀이야! \n\n여기서 멀지 않은 티르의 손 수도원으로 향하는 길에 고장 난 벌목기를 고치고 있는 스컬지 기술공들이 있어. 자네가 그 녀석들의 우두머리를 해치우고 그 녀석들이 탈것을 수리할 때 쓰는 설계도를 내게 가져오면, 섭섭지 않게 보상해주겠네."
  },
  [26765] = {
    ["T"] = "우리에겐 기술력이 있다",
    ["O"] = "티르의 손 수도원 근처나 쿠엘탈라스로 가는 길목의 스컬지 기술공들에게서 스컬지 렌치, 스컬지 스패너, 스컬지 망치를 수집해야 합니다.",
    ["D"] =
    "우와, 이것 보게, $N. 이 부품 중 일부는 노스렌드의 용광로에서 생산된 특수 냉철 도구가 필요해. 난 그런 건 없다고! 사실, 내가 아는 사람 중엔 그걸 가진 이가 아무도 없지! \n\n하지만 이 탈것들을 회수하려고 작업 중인 스컬지 기술공 녀석들은 분명 갖고 있을걸. 주변 놈들이 그런 걸 안 갖고 있다면 북쪽으로 쿠엘탈라스로 향하는 길에서 더 많은 스컬지 놈들을 찾을 수 있을 거야."
  },
  [26766] = {
    ["T"] = "우리에겐 기술력이 있다",
    ["O"] = "동부 역병지대 노스데일 근처에 있는 역병의 수확기를 해체하여 스컬지 예비 부품 30개를 모아야 합니다.",
    ["D"] =
    "이제 적절한 도구가 생겼으니 딱 맞는 부품이 필요해. \n\n이 투석기들엔 뭔가 치명적인 설계 결함이 있어 보이는데, 바로 기즈모플럭스 톱니벨트가 회전 너트 매트릭스와 맞물리는 부분에 문제가 있거든. 내가 본 고장 난 탈것들은 하나같이 그 부분이 다 망가져 있더군. 하지만 이제 우리의 고블린 기계공학을 써먹어 볼 때지! 노스데일 주변에 있는 기계식 수확기에서 대체 부품을 구할 수 있을 거야. 돌봐주는 녀석이 없어 이놈들이 광폭해졌으니 조심하는 게 좋을 걸!"
  },
  [26767] = {
    ["T"] = "우리에겐 기술력이 있다",
    ["O"] = "기술자 길킨에게 투석기 조립에 필요한 부품을 모두 가져왔다고 전해야 합니다.",
    ["D"] =
    "이것들을 조립하는 건 여간 고된 작업이 아니지. 나는 최종 조립을 내 조수인 기술자 길킨에게 맡길 생각이라네. 여기 자네가 우리가 준비가 다 됐다는 걸 그녀석에게 전해주겠나? 저어어기 들판 쪽에 있을 거네."
  },
  [26768] = {
    ["T"] = "합당한 보상",
    ["O"] = "사라 템플워스에게 특별한 간식을 만드는 데 필요한 재료를 가져다 주어야 합니다.",
    ["D"] =
    "우리의 영광스러운 주인님께서 저녁 식사에 특별한 손님들을 초대하셨고, 전 요리 임무를 배정받았습니다. 저는 가장 훌륭한 재료를 찾아다니고 최고의 레시피를 연구하는 데 몇 주를 투자하여 손님들에게 잊지 못할 저녁을 대접하려고 했죠.\n\n그 대망의 날, 전 주방에서 몇 시간 동안 완벽하게 향신료와 소스의 조화를 맞췄습니다. 손님들의 입안에서 음식들이 춤을 출 거라는 확신이 든 후에야 음식을 내가도록 허락했습니다.\n\n시작은 좋았습니다. 손님들은 애피타이저 냄새에 침을 질질 흘리며 기대에 부풀었죠. 모든 손님이 서빙을 받은 후, 주인님께서 다 함께 식사하자고 권하셨습니다.\n\n그때 제 인생 가장 큰 모욕을 당했습니다. 주인님은 제 음식에는 입도 대지 않으신 채, 손가락을 튕기시더니 머핀을 소환해서 드시더군요! 본인이 페이스트리 중독자라는 농담이나 던지시며 제가 준비한 음식은 거들떠보지도 않으셨습니다. 그러자 손님들도 주인님과 같은 걸 드시길 원하시더라고요! 모든 게 다 헛수고가 되었습니다!\n\n그의 배은망덕함에 진저리가 났고 전 제 복수를 위한 계획이 있습니다. 부족한 재료 몇 가지만 있으면 됩니다.\n\n진저가 가꾸는 정원에서 마나 열매 약간, 그리고 골드샤이어에 있는 타린 바우던에게서 밀가루, 부드러운 양념와 소금을 구해다 주세요."
  },
  [26769] = {
    ["T"] = "합당한 보상",
    ["O"] = "아조라의 탑 바깥에 있는 우물에서 마나로 오염된 진흙을 낚아 올리세요.",
    ["D"] =
    "좋아요. 당신이 재료를 가져왔으니 맛있는 케이크를 만들어 볼게요 -- 하지만 하나가 더 필요해요. 케이크에 들어갈 다른 모든 재료들의 향을 덮어버릴 만큼 진한 냄새를 가진 무언가가 필요하답니다.\n\n근처에 있는 우물은 주인님의 실험으로 오염되어 아무도 쓰지 않죠. 우리가 필요한 게 저 아래 있을 거라고 확신해요. 이 막대를 가져가서 마나로 오염된 진흙을 낚아 올려 주세요."
  },
  [26770] = {
    ["T"] = "합당한 보상",
    ["O"] = "사라의 케이크를 테오크리투스에게 바쳐야 합니다.",
    ["D"] =
    "자, 케이크가 완성되었습니다. 겉보기에는 아주 먹음직스럽지만... 안에는 아주 작은 한 조각만 먹어도 심각한 위경련을 유발하는 것들이 들어있죠.\n\n케이크를 탑 꼭대기에 있는 테오크리투스에게 가져가세요. 이 케이크가 그의 페이스트리 중독을 치료해 주리라 확신해요. 그럼 제가 만든 건강하고 맛있는 음식에 아무 불평 없이 먹어 치우겠죠."
  },
  [26771] = {
    ["T"] = "잃어버린 장비",
    ["O"] = "재스퍼로드 광산에서 채굴 장비 8개를 회수한 후 골드샤이어의 로버트 미스톤에게 돌아가야 합니다.",
    ["D"] =
    "저는 코볼트와 거미 떼가 재스퍼로드 광산을 점거하기 전에 그곳에서 일했습니다. 그곳엔 광석이 아주 풍부했고, 스톰윈드의 대장장이들에게 주 공급원 역할을 했었죠.\n\n괴물들이 광산을 차지했을 때 우리는 수많은 동료 광부들과 장비들을 모두 잃었습니다. 죽은 동료들을 살려낼 순 없어도, 혹시 우리가 그곳에 남겨둔 장비를 좀 찾아서 제게 가져다주실 수 있을까요?"
  },
  [26772] = {
    ["T"] = "전문 승마",
    ["O"] = "랜들 헌터에게 전문 승마 기술을 배운 다음 엘윈 숲에 있는 케이티 헌터와 대화하여 말을 받아야 합니다.",
    ["D"] =
    "다시 오셨군요. 전문 승마 기술을 배우러 오셨죠, 맞나요? 전과 마찬가지로 말 비용은 지불되었지만, 훈련 비용은 직접 지불하셔야 합니다. 고급 훈련은 아쉽게도 가격이 좀 나간답니다.\n\n훈련을 받으신 후 목장 맞은편에 있는 케이티 헌터와 대화하세요. 그녀가 우리 말 판매를 관리하고 있습니다. 아직 자금이 부족하시다면 언제든 돌아오셔도 좋습니다."
  },
  [26773] = {
    ["T"] = "승마",
    ["O"] = "랜들 헌터에게 수습 승마 기술을 배운 다음 엘윈 숲에 있는 케이티 헌터와 대화하여 말을 받아야 합니다.",
    ["D"] =
    "그래, 말을 구하러 오셨군요? 마침 당신을 기다리고 있었어요! 어떤 신비한 후원자분께서 평범한 말 한 필의 값을 치르고 가셨는데, 이름이 $N님 앞으로 되어 있더군요. 하지만 훈련 비용은 지불하지 않으셨기 때문에 안타깝게도 그 부분은 직접 부담하셔야 합니다.\n\n훈련을 받으신 후 목장 맞은편에 있는 케이티 헌터와 대화하세요. 그녀가 우리 말 판매를 관리하고 있습니다. 아직 자금이 부족하시다면 나중에 다시 오셔도 좋습니다."
  },
  [26774] = {
    ["T"] = "거미 비약",
    ["O"] = "엘윈 숲의 재스퍼로드 광산에서 거미의 턱뼈 4개를 모으고 갇혀 있는 광부 4명을 풀어주어야 합니다.",
    ["D"] =
    "모험가님, 제게 도움을 주시겠습니까? 재스퍼로드 광산에서 도망친 불쌍한 광부들을 발견했습니다. 골드샤이어로 무사히 돌아오기 전에 지쳐 쓰러지더군요. 무슨 일이 있었는지 물어보려 했지만 앞뒤가 맞지 않는 소리만 늘어놓고 있어서 도저히 알 수 없었습니다. 무언가 단단히 정신을 잃게 만든 모양입니다.\n\n거미 떼가 광산 깊은 곳에 둥지를 틀었다는 소문을 들었습니다. 광부들이 거미독에 중독된 것이라면, 모든 게 설명됩니다! 적절한 해독제를 만들려면 광산 거미의 턱뼈 샘플이 필요합니다.\n\n그리고 부탁입니다만, 갇혀 있는 광부를 보시거든 그들이 빠져나올 수 있도록 제발 풀어주십시오."
  },
  [26775] = {
    ["T"] = "상처 입은 이들 돌보기",
    ["O"] = "거미 비약을 사용하여 원장 달시의 야전 치료 텐트에서 발견된 중독된 광부들을 치료해야 합니다.",
    ["D"] =
    "이제 해독제가 있으니, 남은 부상자들을 편안히 치료할 수 있겠군요. 제 뒤에 있는 광부들에게 해독제를 한 번씩 투여해 주십시오. 그러면 그들이 안전하고 건강하게 가족들의 품으로 돌아갈 수 있을 겁니다."
  },
  [26776] = {
    ["T"] = "날쌘발바닥",
    ["O"] = "노스샤이어 수도원 밖에 있는 메리사 스틸웰에게 날쌘발바닥의 주둥이를 가져다주십시오.",
    ["D"] =
    "아, $c... 마침내 여기서 일손을 보탤 분을 만나다니 반갑네요. 최근 있었던 그 끔찍한 비극에 대해 들으셨나요? 제 아들이 폭포 아래서 놀고 있었는데, 거대한 늑대가 숲에서 튀어나와 아이를 죽였어요! 제가 손쓸 새도 없이 불쌍한 제 아이는 숨을 거두었죠.\n\n<살짝 눈물을 글썽이는 메리사.>\n\n경비병들과 얘기를 나눠보니, 그 늑대가 워낙 도망을 잘 쳐서 녀석을 날쌘발바닥이라고 부른다더군요! 그러면서 자기들은 어떻게 도와줄 방법이 없다는 거예요! 혹시라도 명성을 떨치고 싶으시다면, 한 어머니의 마음에 평안을 가져다주시고 다른 이들에게 같은 운명이 닥치지 않도록 그 끔찍한 짐승을 끝장내 주세요."
  },
  [26777] = {
    ["T"] = "흠뻑 젖은 물통",
    ["O"] = "북넉샤이어 수도원 안에서 이 물통의 출처를 알고 있을 만한 사람을 찾아보십시오.",
    ["D"] =
    "수정 호수로 이어지는 강변을 걷다가 눈 덮인 산꼭대기 문양이 찍혀 흠뻑 젖은 에일 물통을 우연히 발견합니다. 이 물통에서는 여태껏 맡아본 적 없는 아주 환상적인 향이 납니다. 어쩌면 북넉샤이어 수도원의 누군가 이 물통이 어디서 왔는지 알지도 모릅니다."
  },
  [26778] = {
    ["T"] = "형제 찾기",
    ["O"] = "흠뻑 젖은 통을 북넉샤이어 수도원의 수사 닐스에게 가져다주십시오.",
    ["D"] =
    "저는 에일이나 와인 쪽엔 전문가가 아니라서, 그냥 포도만 키울 뿐이죠. 하지만 이 수도원에 전문가라고 할 만한 분이 딱 한 분 계십니다 -- 바로 수사 닐스 님이시죠. 수도원 꼭대기 층에 가시면 찾으실 수 있을 겁니다."
  },
  [26779] = {
    ["T"] = "수사의 혐오",
    ["O"] = "사자의 긍지 여관에 있는 멜리카 아이센스트라이더에게 통의 더미를 가져다주어야 합니다.",
    ["D"] =
    "<수사 닐스가 통을 보며 찡그린 표정을 짓습니다.>\n\n역겨운 구정물이로군! 여긴 와이너리라고, $N! 오스워드 양이 동부 왕국 전체에서 가장 훌륭한 포도를 재배하고, 나와 다른 수사들이 이 와인을 생산하고 있지. 여기선 에일 같은 건 입에 대는 놈은 없네.\n\n이게 어디서 났는지 꼭 알고 싶다면, 골드샤이어에 있는 사자의 긍지 여관으로 가서 멜리카 아이센스트라이더에게 자네가 발견한 것을 보여주게. 그 여자는 이 지역 단골이나 양조장 놈들을 꽉 잡고 있으니.\n\n아! 만약 자네가 그곳으로 간다면, 최신 와인 화물도 그녀에게 가져다주게나."
  },
  [26780] = {
    ["T"] = "마법사의 조언",
    ["O"] = "사자의 긍지 여관 위층에 있는 잘디마르와 대화해야 합니다.",
    ["D"] =
    "말씀하시니 생각나는데... 1주일쯤 전에 무룬이라는 드워프가 여기 온 적이 있어요. 술을 엄청나게 퍼마시더니 수도원 위쪽의 북넉샤이어 폭포 근처에 풍부한 광맥을 찾으러 가겠다는 이야기로 손님들을 즐겁게 해 주었죠.\n\n그자가 가져온 에일의 모양과 향이 딱 당신이 가져온 통과 똑같았어요. 하지만 제 생각엔 젊은 $c님께서 그 절벽을 오르기엔 무리가 좀 있을 것 같네요.\n\n무룬을 뒤쫓을 생각이라면, 위층에 있는 잘디마르에게 물어보세요. 아주 교활한 마법사라 당신을 도와줄 수 있을 겁니다."
  },
  [26781] = {
    ["T"] = "라이누스 석재 단서",
    ["O"] = "골드샤이어의 사자의 긍지 여관에 있는 잘디마르에게 다 쓴 공간이동의 돌을 가져가야 합니다.",
    ["D"] =
    "이 부분에서 자네의 도움이 필요하네, $N. 최근 내 조수 놈이 근처의 데피아즈단 놈들과 결탁했다는 걸 발견했거든. 라이누스 그 자식은 내 코앞에서 골드샤이어 경비대의 패턴과 화물 운송 정보를 놈들에게 흘리고 있었다고!\n\n불행히도 내가 그놈을 해고했을 때 놈이 내 유물을 몇 개 훔쳐 달아났네. 더 불행하게도, 자네 입장에선 그놈이 마력이 없는 공간이동의 돌을 훔쳐 갔다는 거지. 그 돌을 찾아다 주면 자네를 기꺼이 도와주겠네.\n\n경비병들에게 마지막으로 들은 바로는 골드샤이어 바로 북쪽 언덕에서 마을을 정찰하는 놈을 봤다고 하더군. 자네가 놈에게 본때를 보여줘도 난 신경 쓰지 않을 테니."
  },
  [26782] = {
    ["T"] = "양조업자 형제들",
    ["O"] = "북넉샤이어 계곡에서 폭포를 찾아 공간이동의 돌을 사용해 정상에 도달해야 합니다.",
    ["D"] =
    "이제 성가신 일은 끝났으니 자네가 찾고 있는 에일의 출처를 발견할 수 있을 게야. 이걸 북넉샤이어 계곡에 있는 폭포 밑동으로 가져가서 사용하면 위로 올라갈 수 있네. 자네가 원하는 것을 찾길 바라지."
  },
  [26783] = {
    ["T"] = "후회는 없다! 음, 아마 조금은",
    ["O"] = "북넉샤이어 폭포에 있는 드로물 오드링크를 찾으십시오.",
    ["D"] =
    "나와 내 동료 드로물은 던 모로에서 이곳까지 왔다네. 오직 이 외진 계곡에서 부를 움켜쥐겠다는 일념으로 불타는 평원을 가로지르며 처절하게 싸웠지.\n\n그래, 하지만 마침내 우리가 보상을 받으려고 도착했을 때 우리는 사이가 틀어지고 말았어... 녀석이 내 도구를 가져가고 나는 녀석의 양조 장비 대부분을 차지했지... 그래서 우린 둘 다 이 모양 이 꼴로 발이 묶인 셈이네!\n\n그 에일은 내가 빚은 게 아니네 $N. 그 실력을 가진 건 상류에 있는 드로물이지. 내가 그 녀석에게 퍼부었던 말들을 생각하면 다시는 나와 말도 섞지 않으려 들겠지만... 녀석이 무사한지 확인해 줄 수 있겠나?"
  },
  [26784] = {
    ["T"] = "마운틴스타우트 에일",
    ["O"] = "북넉샤이어 갈대 6개와 반짝이는 폭포수 6파인트를 수집하여 드로물 오드링크가 갓 빚어낸 마운틴스타우트 에일을 만들 수 있게 해야 합니다.",
    ["D"] =
    "무룬이 걱정하고 있다고? 나를? 하! 그 고집불통이 마음을 돌리는 걸 내 살아서 보게 될 줄이야 꿈에도 생각 못했네.\n\n며칠 전에 내가 녀석에게 사과의 선물을 주려고 직접 배를 저어 녀석의 진영으로 내려간 적이 있네. 그 선물은 내가 새롭게 발명한 술이었고 그 녀석 가문의 문장을 새겨 두었지. 이름하야 마운틴스타우트 에일일세.\n\n자네가 찾은 게 그거라면, 무룬이 보기도 전에 강을 따라 휩쓸려 내려간 게 틀림없군. <곰곰이 생각하는 드로물.>\n\n망설이는 것도 이제 끝이야! 강 주변에 있는 저 정령들에게서 마법이 깃든 물을 좀 얻어오게. 그 근처에서 자라는 갈대도 한 움큼 구해오고. 그러면 내가 아주 신선한 에일을 한 다발 만들어주지."
  },
  [26785] = {
    ["T"] = "진정한 친구",
    ["O"] = "북넉샤이어 폭포에 있는 무룬 골드로어에게 마운틴스타우트 에일을 가져다주어야 합니다.",
    ["D"] =
    "이거야말로 자네, 나, 그리고 무룬이 다 같이 에일을 마시면서 실컷 수다나 떨면서 이 지긋지긋한 언쟁을 끝내버릴 시간이라는 뜻이지. 그놈과 나는 서로 알게 된 지 아주 오래되어서 놈이 없는 인생은 도무지 상상할 수가 없어. 창조주에 맹세코 우린 서로 매형 매제지간이라고! 그러니 녀석에게 돌아가세나."
  },
  [26786] = {
    ["T"] = "스톰윈드의 기물 파손",
    ["O"] = "스톰윈드 항구에 있는 형사 말로위와 대화해야 합니다.",
    ["D"] =
    "아, 또 만났군요 $N. 들러주어 고마워요 -- 전에 당신이 우릴 위해 훌륭하게 일을 처리해 주었었죠. 이번엔 우리 고향에서 사건이 하나 터졌습니다. 예전에 조사하셨던 데피아즈단 활동과는 관련이 없는 것 같아요 -- 스톰윈드에서 활동하는 새로운 불순 세력이 있거든요.\n\n항구 부두에서 뻔뻔스러운 기물 파손 행위가 일어났습니다. 인명 피해는 없었지만, 이곳에 새로 정착한 부부의 마차가 총에 맞고 불태워졌죠. 아내는 너무 놀라 이성을 잃을 정도였지만, 남편은 이상하게도 굳게 입을 다물고 있었습니다. 눈에 보이는 것보다 더 큰 문제가 얽혀있는 게 분명하므로 제가 당신을 지원군으로 파견하는 겁니다. 말로위 형사와 만나 지금까지 그가 알아낸 게 무엇인지, 당신이 어떻게 그를 도울 수 있을지 확인해 보세요. 건투를 빕니다!"
  },
  [26787] = {
    ["T"] = "스톰윈드의 기물 파손",
    ["O"] = "스톰윈드 항구 브래드포드의 마차 주변에 있는 사람들에게서 단서를 심문하고 형사 말로위에게 보고해야 합니다.",
    ["D"] =
    "나는 이 사건이 고의적 방화라는 것을 확인했고, 지난밤 근무를 서던 경비병들도 누군가 전력으로 도망치는 형체를 보긴 했습니다만 - 용의자를 추격하기보다 불이 더 번지기 전에 불을 끄는 데 더 급급했습니다.\n\n제가 비비안과 데릭 브래드포드 부부를 심문해 보았습니다. 비비안은 완전히 얼떨떨해 보였지만, 저는 데릭이 무언가 숨기고 있다고 의심하고 있습니다. 구체적으로 말하자면, 이것은 표적이 명확한 범행이었고 그는 그 이유를 알고 있다고 생각합니다. 하지만 그는 우리에게 아무 말도 하지 않을 겁니다 - 적어도 지금은 말이죠.\n\n부두 주위에 있는 다른 사람들에게 혹시 목격한 것이 없는지 물어봐 주시겠습니까? 그동안 저는 이 잿더미 속에서 추가 단서들을 걸러내 보겠습니다."
  },
  [26788] = {
    ["T"] = "스톰윈드의 기물 파손",
    ["O"] = "스톰윈드의 여관과 술집들을 뒤져 수상한 여자를 찾고 그 여자와 마주해야 합니다.",
    ["D"] =
    "스톰윈드에는 6개의 여관과 술집이 있습니다. 당신은 이 미스테리한 인물에 대해 알아내려면 그 모든 장소를 다 수색해야 할지도 모릅니다.\n\n저는 구시가지에 있는 돼지와 휘파람부터 시작해 보길 권해드리고 싶습니다 - 그쪽엔 거친 부류의 인간들이 많으니까요. 드워프 지구에는 수염난 술집 아가씨가, 상업 지구에는 금빛 장미가, 마법사 지구에는 푸른 은둔자와 도살된 양이 있고, 공원에는 시트린 독수리 여관이 있습니다. 그곳들을 확인해 보시고, 술집 주인이나 바텐더에게서 그녀의 인상착의에 대해 들어본 적이 있는지 알아보십시오.\n\n도살된 양에 가야 하는 당신이 전혀 부럽지 않군요. 그곳은 항상 절 소름 돋게 만드니까요."
  },
  [26789] = {
    ["T"] = "스톰윈드의 기물 파손",
    ["O"] = "알터랙 군단에 대해 알아보기 위해 사우스쇼어의 헬름스워스 소령을 찾으러 떠나야 합니다.",
    ["D"] =
    "50년 전만 해도 알터랙 군단은 전설이었습니다. 하지만 불행히도, 그들의 대부분이 알터랙 공성전이나 그 이후의 혼란 속에서 목숨을 잃었습니다. 그들이 살아남았다면, 스컬지의 진격을 막는 데 그들의 힘을 빌릴 수도 있었을 텐데 말입니다....\n\n데릭 브래드포드가 무언가 숨기고 있는 것 같으니 다른 곳에서 정보를 얻는 편이 현명하겠군요. 살아남은 알터랙 군단 출신 중 제가 아는 유일한 생존자는 한 명뿐입니다. 사우스쇼어로 가 헬름스워스 소령과 이야기하십시오. 그라면 데릭 브래드포드와 비밀결사대, 혹은 그 군단 사이의 연관성에 대해 무언가 힌트를 줄 수 있을 것입니다."
  },
  [26790] = {
    ["T"] = "잃어버린 깃발",
    ["O"] = "스톰윈드 성의 스톰윈드 항구에 있는 데릭 브래드포드와 대화해야 합니다.",
    ["D"] =
    "<헬름스워스 소령은 당신이 상황을 설명하는 동안 경청합니다.>\n\n저를 찾아오셔서 다행이군요, $C님. 이 일에 대해 당신을 도울 수 있는 사람은 극소수일 것입니다.\n\n데릭 브래드포드는 알터랙이 무너질 때 살아남은 소수의 군단병 중 한 명입니다. 몇 달 전 그는 내게 편지를 보내, 군단이 참전했던 주요 전투들에서 오랜 시간에 걸쳐 잃어버린 우리 부대의 독수리 깃발 세 개를 되찾고 싶다는 의사를 전했습니다. 깃발들은 금전적인 가치는 없지만, 알터랙의 자부심을 상징하는 강력한 매개체입니다. 비밀결사대가 이 계획의 낌새를 채고 그 깃발을 자신들이 챙기려고 하는 것 같습니다. 그들이 이 깃발을 손에 넣으면, 자신들만의 뒤틀린 알터랙 군단을 재건하기 위한 신병들을 모으려 할 것입니다.\n\n데릭은 암살 시도를 겪은 이후로 그 누구도 믿지 않을 겁니다. 하지만 당신이 알아낸 사실로 그를 설득한다면, 아마도 당신의 도움을 받아들일 것이라 믿습니다."
  },
  [26791] = {
    ["T"] = "잃어버린 깃발",
    ["O"] = "알터랙의 폐허, 달라란의 폐허, 그리고 스트롬가드의 폐허에서 명예의 깃발들을 찾아 힐스브래드 구릉지 사우스쇼어에 있는 헬름스워스 소령에게 가져가야 합니다.",
    ["D"] =
    "알터랙 군단의 깃발들이 어디서 분실되었는지에 대해 몇 가지 조사를 마쳤네.\n\n군단은 당연히 공성전 기간 동안 알터랙 성 방어의 일원이었고, 그들의 가장 중요한 깃발은 그곳에서 잃어버렸다네. 군단의 생존자들은 스컬지의 진격으로부터 달라란을 보호하기 위해 애썼지만, 결국 그 근처 어딘가에서 자신들의 마지막 깃발마저 잃고 말았지.\n\n가장 찾기 어려운 깃발은 알터랙이 스트롬가드를 기습할 때 잃어버린 것이네. 그것은 너무 오래전 일이라 깃발이 온전하게 남아 있을지조차 장담할 수 없지만, 나의 짐작으로는 트롤베인 가문이 우리의 오랜 원한을 기념하기 위한 전리품으로 그것을 보관해 두었을 거라 믿네.\n\n만약 자네가 이 깃발들을 찾아낸다면, 우린 비밀결사대의 계획에 큰 타격을 줄 수 있을 것이네. 깃발들을 찾아 안전하게 보관할 수 있도록 헬름스워스 소령에게 가져가 주게. 비밀결사대는 날 지켜보고 있는 게 분명해."
  },
  [26792] = {
    ["T"] = "잃어버린 깃발",
    ["O"] = "스톰윈드의 스톰윈드 항구에 있는 데릭 브래드포드에게 헬름스워스 소령의 보상금을 전해주어야 합니다.",
    ["D"] =
    "하나 남은 일 처리가 있네, $C. 데릭의 가족은 화재로 모든 걸 잃었어. 이 보상금을 그 친구에게 좀 전해주었으면 좋겠네. 그는 적선받는 걸 원하지 않겠지만, 깃발을 회수하는 데 도움을 준 것에 대한 대가라고 꼭 강조하게. 그러면 받아들이기 한결 수월해질 테니까.\n\n남쪽에서 새 삶을 시작하는 그에게 행운을 빌어주게나. 내가 휴가를 얻으면 꼭 들르겠다고 전해주고."
  },
  [26793] = {
    ["T"] = "잃어버린 깃발",
    ["O"] = "스톰윈드의 스톰윈드 항구에 있는 형사 말로위와 대화해야 합니다.",
    ["D"] =
    "형사 말로위 씨가 확인 차 몇 번이나 다녀갔습니다. 그분에게 수사를 종결해도 된다고 전해주실 수 있나요?\n\n이제 깃발을 확보했으니 비밀결사대도 저를 지켜볼 이유가 없어졌고, SI:7 요원들도 더 중요한 임무에 투입될 수 있을 겁니다.\n\n만약 비밀결사대가 저를 노리고 온다고 해도, 이제 전 준비가 되어 있습니다."
  },
  [26794] = {
    ["T"] = "수배: 빅 블루",
    ["O"] = "빅 블루의 날개를 엘윈 숲 아조라의 탑에 있는 진저 맥거빈스에게 가져가야 합니다. 빅 블루는 오직 밤에만 모습을 드러냅니다.",
    ["D"] =
    "아조라 탑의 대마법사들은 뛰어날지 몰라도, 그들의 위험 관리 능력은... 빵점이에요.\n\n불행하게도, 나비 한 마리가 마법사의 실험에 너무 가까이 다가갔다가 돌연변이가 되어 통제 불능의 끔찍한 생명체로 변해버렸죠.\n\n거의 매일 밤 그 괴물이 나타나 정원을 헤집어 놓는 바람에 음식의 질까지 엉망이 되고 있다고요!\n\n그 괴물을 해치우고 그 날개를 아조라 탑에 있는 진저 맥거빈스에게 가져다주세요! 녀석이 마지막으로 발견된 곳은 탑 북동쪽, 돌무더기 호수 해안가입니다."
  },
  [26795] = {
    ["T"] = "길을 잃은 전사",
    ["O"] = "던홀드 요새에서 토그타르의 흔적을 찾아야 합니다. 크루스크가 그가 하수도에 있을 것이라고 말했던 것을 기억합니다.",
    ["D"] =
    "나와 내 형제 토그타르는 대족장님의 명령을 받고 던홀드 요새에서 물건을 되찾고 요새를 점령한 소위 \"비밀결사대\"라는 자들을 조사하기 위해 왔네.\n\n요새를 수색하기 위해 들어갔지만, 엄청난 수의 인간 무리에게 기습을 당했지. 우리는 용감하게 싸웠지만 그들의 숫자에 압도당하고 말았네.\n\n난 간신히 탈출했지만 내 동생은 그렇지 못했어. 그놈들이 동생을 끌고 요새 동쪽에 있는 그들의 감옥인 하수도로 내려가는 것을 보았네.\n\n그곳에 가서 동생을 찾아주지 않겠나, $N? 내 동생을 무사히 돌려보내 준다면 영원히 잊지 않겠네."
  },
  [26796] = {
    ["T"] = "길을 잃은 전사",
    ["O"] = "던홀드 하수도의 교도관 에스턴에게서 에스턴의 열쇠를 획득하여 토그타르에게 돌아가야 합니다.",
    ["D"] =
    "진짜 누가 올 줄은 몰랐소! 우리 형님이 보냈소?\n\n당신이 와서 안심은 되지만, 유감스럽게도 이 족쇄를 풀지 않고는 여기서 한 발짝도 나갈 수 없소. 족쇄 열쇠는 교도관 에스턴이 가지고 있지. 그놈이 방금 하수도 반대편으로 가는 걸 똑똑히 보았소.\n\n가서 열쇠를 가져오시오... 필요하다면 무슨 수를 써서라도. 난 여기서 죽고 싶지 않소!"
  },
  [26797] = {
    ["T"] = "길을 잃은 전사",
    ["O"] = "토그타르와 함께 던홀드 요새에서 탈출해야 합니다. 성공하면 타렌 제분소의 크루스크에게 보고하십시오.",
    ["D"] =
    "이제 이곳을 빠져나갈 시간이오, $N. 하지만 명심하시오, 이 망할 비밀결사대 놈들이 가만히 있진 않을 거요!\n\n떨어지지 마시오, 헤어지면 끝장이니까. 내가 돌아갔을 때 우리 형님이 지을 표정이 정말 기대되는군."
  },
  [26798] = {
    ["T"] = "어려움에 처한 정찰병",
    ["O"] = "비밀결사대 갑옷 조각 10개를 모아 사우스쇼어의 대장 탈렌에게 돌아가야 합니다.",
    ["D"] =
    "반갑소, $N! 나는 지금 당신의 도움이 절실히 필요하다오. 내 정찰병 중 한 명에게 북동쪽에 있는 요새인 던홀드 요새를 감시하라고 명령했소. 최근 비밀결사대 조직이 그곳을 점령했거든. 그러나 정찰병은 복귀하지 않았고, 대장으로서 내 의무는 그에게 무슨 일이 일어났는지 알아내는 것이오.\n\n요새에 비밀결사대원들이 증가하고 있어서 정면 대결의 위험을 감수할 수는 없소. 이 작전은 은밀히 진행해야 하오.\n\n요새 근처에 하급 비밀결사대원 일부가 기지로 사용하고 있는 망가진 탑이 있소. 그곳에서 그들의 갑옷을 수집해 변장용으로 사용하는 거요. 그 탑은 사우스쇼어에서 북쪽 길을 따라가면 찾을 수 있을 거요. 교차로에서 오른쪽으로 돌아 탑이 보일 때까지 동쪽으로 계속 가시오."
  },
  [26799] = {
    ["T"] = "어려움에 처한 정찰병",
    ["O"] = "비밀결사대 변장을 착용하고 던홀드 요새에서 정찰병 베르나도를 찾아야 합니다.",
    ["D"] =
    "자 $N, 이제 위장 임무에 나설 때요. 이 변장 도구를 걸치고 던홀드 요새로 바로 진입하시오. 들리는 소문에 의하면 비밀결사대가 요새의 동쪽에 있는 하수도를 감옥으로 쓰고 있다 하더군. 십중팔구 그곳에 잃어버린 우리 정찰병이 있을 거요.\n\n변장하더라도 비밀결사대 놈들에게 너무 시비를 걸진 마시오, 위기 상황에서 그 변장이 잘 버텨줄지 확신할 수가 없거든. 만약 변장 도구가 더 필요하면 날 찾아오시오. 수리가 가능할 수도 있으니 말이오.\n\n던홀드 요새를 찾으려면, 당신이 갑옷 조각을 얻은 탑을 지나서 길을 조금만 더 가면 나오오. 행운을 비오!"
  },
  [26800] = {
    ["T"] = "어려움에 처한 정찰병",
    ["O"] = "교도관 에스턴을 설득하여 감방 열쇠를 받은 다음 던홀드 요새에 있는 정찰병 베르나도에게 돌아가야 합니다.",
    ["D"] =
    "탈렌 대장님이 보내셨나요? 오셔서 다행입니다만, 이 수갑을 풀기 전까지 전 여기서 한 발짝도 못 나갑니다!\n\n이곳 하수도를 감시하는 경비병인 교도관 에스턴이 열쇠를 가지고 있습니다. 방금 자리를 떴으니 아마 하수도 반대편을 순찰하고 있을 겁니다.\n\n에스턴에게 던홀드의 지배자인 베브 페레놀드가 날 심문하려 한다고 말하세요. 절 요새로 끌고 가려면 열쇠가 필요할 겁니다.\n\n에스턴도 베브를 겁내고 있을 테니, 틀림없이 열쇠를 내줄 겁니다. 열쇠를 구하면 바로 돌아오세요. 여기서 소란 피우지 않고 몰래 빠져나가자고요!"
  },
  [26801] = {
    ["T"] = "어려움에 처한 정찰병",
    ["O"] = "정찰병 베르나도와 함께 던홀드 요새를 탈출해야 합니다. 성공하면, 사우스쇼어의 탈렌 대장에게 보고하십시오.",
    ["D"] =
    "여기서 나갈 준비가 다 되었습니다. 눈치채지 못하게, 평소처럼 행동하세요.\n\n비밀결사대가 보기에 당신은 그저 자기 일을 하는 평범한 조직원일 테니, 우리가 같이 나간다 해도 의심하지 않을 겁니다."
  },
  [26802] = {
    ["T"] = "맹독 치료제",
    ["O"] = "이끼 맹독 8개를 모아 사우스쇼어의 수습생 하니웰에게 돌아가야 합니다.",
    ["D"] =
    "반갑습니다, $N 님. 전 연금술을 깊이 연구하기 위해 사우스쇼어로 이사 왔습니다. 제가 다음으로 배우고 싶은 건 독의 해독제를 만드는 방법이죠.\n\n마을 주민 몇 명이 거미에 물려 앓아 누워 있습니다. 절 위해 그 거미들의 독을 좀 수집해 주시겠습니까? 거미들은 힐스브래드 곳곳에 흩어져 있습니다."
  },
  [26803] = {
    ["T"] = "무기고 파괴",
    ["O"] = "던홀드 요새에서 던홀드 무장 10개를 회수하여 사우스쇼어에 있는 쿤드릭 잔덴에게 돌아가야 합니다.",
    ["D"] =
    "던홀드 요새에 머물고 있는 비밀결사대 놈들이 골칫거리가 되고 있어요. 여행자들을 향한 지속적인 공격에 세력 확장까지... 얼라이언스가 아직도 저놈들에게 선전포고를 안 했다는 게 신기할 정도라니까요!\n\n우리 지역의 안전은 우리 사우스쇼어의 책임입니다. 요새에 잠입해 놈들의 무기들을 훔쳐내 주셨으면 합니다. 무기가 없으면 당분간 저들의 세력 확장을 늦출 수 있을 테니까요. 요새는 여기서 길을 따라 북동쪽으로 가시면 나옵니다."
  },
  [26804] = {
    ["T"] = "잿더미로",
    ["O"] = "던홀드 요새의 막사 안에 있는 비밀결사대 식량을 불태워야 합니다. 완료하면 탈로우에게 돌아가야 합니다.",
    ["D"] =
    "나는 평생을 타렌 제분소에서 살았소, $c. 이 마을이 그 악당 놈들 때문에 잿더미가 되는 꼴은 절대 두고 볼 수 없소. 네, 물론 남동쪽에 있는 던홀드 요새로 최근에 옮겨온 비밀결사대 놈들을 두고 하는 말입니다. 그놈들이 우리 식량을 훔쳐 갔단 말이오.\n\n더는 참을 수 없소! 눈에는 눈, 이에는 이... 아니 식량에는 식량으로 갚아줄 때요. 놈들 막사에 있는 식량들을 전부 태워버리시오.\n\n내 친구에게 영원의 횃불이라는 선물을 받았소. 이걸 챙겨서 그놈들 식량을 남김없이 잿더미로 만들어 주시오."
  },
  [26805] = {
    ["T"] = "여관 장식",
    ["O"] = "사우스쇼어의 여관주인 앤더슨을 위해 곰 가죽 10장을 모아야 합니다.",
    ["D"] =
    "며칠 생각해 봤는데, 우리 여관을 새단장해야겠다고 마음먹었어요. 입구에 양탄자를 깔고 싶거든요!\n\n제게 빚을 진 재봉사를 알고 있으니, 당신은 가죽만 구해주시면 돼요. 여기 근처에 있는 곰들의 가죽이면 충분할 겁니다."
  },
  [26806] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "던 가록의 경비병 에밀리, 청금석 광산의 경비병 팩스턴, 힐스브래드 농장의 경비병 트리스탄으로부터 보고서를 수집해 사우스쇼어의 탈렌 대장에게 돌아가야 합니다.",
    ["D"] =
    "반갑소, $c. 사우스쇼어 수비대의 대장으로서 나는 이 땅의 평화를 수호할 책임을 안고 있다오. 호드 놈들이 언제 우리 코앞에서 파티를 벌이려 들지 모르는 일이니까 말이오.\n\n힐스브래드 곳곳에 배치해 둔 병사들에게서 보고서를 받아올 자가 필요하오. 남동쪽 던 가록에는 경비병 에밀리가, 서쪽 청금석 광산 외곽엔 경비병 팩스턴이, 그리고 북서쪽 농장의 마을회관 근처엔 경비병 트리스탄이 대기 중일 거요.\n\n여기 마구간에 있는 다렌과 대화해 내가 자네를 보냈다고 전하게. 녀석이 자네에게 그 임무를 수행할 수 있게 말을 빌려줄 거요. $N, 자네만 믿겠네! 서두르게, 기다리는 건 질색이니까."
  },
  [26807] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "저습지의 메네실 항구에 있는 스타우트피스트 경비대장에게 탈렌의 보고서를 전달해야 합니다.",
    ["D"] =
    "$N... 자네가 내게 가져온 이 보고서들엔 불길한 소식들로 가득하군. 힐스브래드 전역에서 호드의 침략군이 증가하고 있다는구먼. 우리가 타렌 제분소의 총공세를 막아내기에 수적으로 우세하다고 생각하진 않는다네.\n\n사우스쇼어가 살아남으려면 신속하게 움직여야 해. 메네실 항구로 가서 요새 안에 있는 스타우트피스트 경비대장과 대화하게. 난 이곳의 상황을 알리는 보고서를 작성하겠네. 그에게 지원을 요청해 주게... 부대, 무기, 뭐든 다가올 전투에 도움이 될 만한 것들로 말이야. 부디 서두르게, 사우스쇼어는 자네에게 달려있으니."
  },
  [26808] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "저습지의 은빛바람 동굴에서 유령이 깃든 광석 8개를 채굴하여 스타우트피스트 경비대장에게 돌아가야 합니다.",
    ["D"] =
    "호드가 사우스쇼어에 대한 공격을 준비하고 있다고? 이거... 참으로 곤란한 소식이로군. 메네실이 할 수 있는 한 최대한 돕겠지만, 장담할 수 있는 게 많지 않네. 당장은 병력을 파견할 여유가 없지만 자네가 정말 절실하다면 묘책이 하나 있긴 하지. 우린 아이언포지를 제외하고 최고의 대장장이들을 보유하고 있다네. 그게 아무짝에도 쓸모없다면 내 손에 장을 지지지! \n\n모단 호수의 폭포가 끝나는 던 알가즈 남동쪽으로 가면 은빛바람 동굴이 있을 걸세. 유령이 출몰하는 곳이라 원정대를 보낸 적은 없지만, 이런 시기에는 그런 용기 있는 행동이 필요한 법이라네. 소문에 의하면 동굴 안에는 검조차 파괴되지 않게 만들 정도로 엄청난 마력이 깃든 광석이 있다더군.\n\n동굴로 가게, $N. 내가 제일 튼튼한 곡괭이를 주지. 용기 있게 받아주리라 믿네. 돌아오게 되면 이 광석을 무기제작자인 브라크 더나드에게 전해주게. 그는 이곳 대장간 건물 안에서 찾을 수 있을 걸세."
  },
  [26809] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "",
    ["D"] = "",
  },
  [26810] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "힐스브래드 구릉지 사우스쇼어에 있는 탈렌 대장에게 청동, 철, 강철, 그리고 유령이 깃든 무기 상자를 가져가야 합니다.",
    ["D"] =
    "좋아, 자네가 가져온 유령이 깃든 광석으로 만든 무기 상자들이 여기 있네. 내가 기대했던 결과물은 아니지만, 이 물질의 밀도가 부족해서 일반 검을 만드는 데 생각보다 훨씬 많은 광석이 들어갔지. \n\n이걸 자네한테 주고 싶진 않았지만, 이것도 함께 가져가게. 청동, 철, 강철 무기가 든 상자들인데, 원래는 스팀휘들 항구로 보내서 팔 생각이었어. 사우스쇼어가 더 중요하니 어쩔 수 없지. 이제 어서 가!"
  },
  [26811] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "사우스쇼어의 북서쪽에 있는 힐스브래드 농장의 경비병 트리스탄과 대화해야 합니다.",
    ["D"] =
    "우린 무기를 즉시 배포할 걸세. 그동안 자네는 힐스브래드 농장으로 가줘야겠어. 그곳에서 증원 요청이 들어왔네. 하지만 편지의 내용으로 보아 임박한 침공에 대한 내용은 아닌 것 같더군. 사우스쇼어 방어 준비로 우린 눈코 뜰 새 없이 바쁠 테니, 자네가 우리 대신 가서 뭘 어떻게 도와줘야 할지 살펴봐 주게.\n\n농장에 도착하면 마을회관 근처에 있는 경비병 트리스탄과 대화하게나. 혹시 어딘지 잊어버렸다면, 그냥 사우스쇼어 밖으로 나가는 길을 따라 서쪽으로 쭉 가다 보면 농장이 나올 게야. 신의 가호가 있길 바라네, $N."
  },
  [26812] = {
    ["T"] = "하루 사과 한 개면...",
    ["O"] = "힐스브래드 농장의 과수원에서 사과를 수집한 후, 힐스브래드 농장 북쪽 끝 정자 아래에 있는 사과 착즙기로 사과 사이다를 만드십시오. 그 후, 사과 사이다를 착즙기 근처 통에 붓습니다.",
    ["D"] =
    "증원을 요청했는데 이런 일이 생겨서 이상하게 생각하실 수 있지만, 사실 식량과 물도 무기와 방어구만큼이나 우리 생존에 직결되는 문제입니다. 힐스브래드 농장은 사과와 사과 사이다의 주요 생산지인데, 호드의 공격 때문에 작업 일정이 늦어지고 있습니다.\n\n과수원으로 가서 사과를 수집해 주세요. 그런 다음 농장 북쪽 덩굴 아래에 있는 사과 착즙기로 가서 사이다를 만드시면 됩니다. 끝나시면 그걸 통에 보관해 두시면 되고요. 걱정 마세요, 당신의 수고에 대한 보상은 확실히 해 드릴 테니까요."
  },
  [26813] = {
    ["T"] = "호드의 접근을 막아라",
    ["O"] = "힐스브래드 농장 외곽에 있는 호드 정찰병 6마리를 처치해야 합니다. 작업이 끝나면 힐스브래드 구릉지 힐스브래드 농장에 있는 경비병 트리스탄에게 보고해야 합니다.",
    ["D"] =
    "우리 농장 외곽을 따라 호드 정찰병들이 수 차례 목격되었습니다. 놈들이 고의로 눈에 띈 건지 아니면 단지 정찰에 서툴러서인지는 모르겠지만, 아무튼 처리해야 합니다. 당신이 정찰병 몇 마리를 처치한다면, 남은 놈들도 겁을 먹고 도망치거나 힐스브래드 농장이 만만한 상대가 아니라고 보고할 것입니다.\n\n행운을 빕니다."
  },
  [26814] = {
    ["T"] = "분쟁의 들판",
    ["O"] = "힐스브래드 농장에서 호드 플레이어 1명을 처치하십시오.",
    ["D"] =
    "순찰을 도는 동안, 호드 모험가들이 있는지 계속 주시하십시오. 놈들은 때때로 이곳에 나타나 우리 병사들과 농부들을 학살하곤 합니다. 그들을 찾아내 제거하는 것이 당신의 의무입니다. 이를 완수하면 제게 다시 보고해 주십시오."
  },
  [26815] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "힐스브래드 구릉지 사우스쇼어에 있는 탈렌 대장과 대화해야 합니다.",
    ["D"] =
    "당신을 이 외진 곳으로 보내게 되어 사과드립니다. 전 경비병들이 좀 더 지원될 줄 알았거든요. 당신같이 뛰어난 실력을 가진 분이 오실 줄은 몰랐습니다. 그래서 제 생각엔 이 사실을 사우스쇼어의 탈렌 대장에게 직접 보고하시는 편이 좋을 것 같습니다.\n\n다음번 보고서를 쓸 때 당신의 공로를 잘 적어서 올려드리겠습니다. 앞으로의 모험에 행운이 깃들기를 바랍니다, $N."
  },
  [26816] = {
    ["T"] = "사우스쇼어 방어전",
    ["O"] = "힐스브래드 구릉지 사우스쇼어에 있는 사우스쇼어 포고꾼과 대화하여 다가오는 호드의 공격으로부터 사우스쇼어를 방어해야 합니다.",
    ["D"] =
    "믿을 만한 소식통에 의하면 호드가 곧 공격을 개시한다고 하오. 이제 우리가 세운 방어 계획을 시험해 볼 때요!\n\n마법이든, 무기 연마든, 강화 효과든, 당신이 필요로 하는 모든 준비를 마치시오. 만반의 채비가 끝나면, 우리 쪽 그리핀 조련사 달라 근처에 있는 사우스쇼어 포고꾼에게 보고하시오. 얼라이언스를 위하여!"
  },
  [26817] = {
    ["T"] = "집행되지 않은 정의",
    ["O"] = "알터랙 산맥 로르다미어 호수 기슭에 있는 그의 집에서 폴 \"그랜파\" 비샤스를 찾아 정의의 심판을 내려야 합니다.",
    ["D"] =
    "내가 집정관이 되었을 때 폴 비샤스에 대한 체포 영장이 미결 상태로 남아 있다는 사실을 발견했소. 들리는 바로는 비샤스는 약 20년 전에 저지른 살인 사건으로 지명수배 중이더군. 왜 이게 한 번도 집행되지 않았는지는 나도 잘 모르겠소; 폴 비샤스는 수년 동안 이 지역에서 목격되었소.\n\n그의 아들 시드니는 로르다미어 호수 기슭에 집을 한 채 가지고 있지. 어쩌면 비샤스가 그곳에 숨어 있을지도 모르겠군. \n\n제발 가서 그를 체포하시오 $C. 만약 녀석이 얌전히 굴지 않는다면, 당신이 직접 정의를 집행하여 이 사건을 장부에서 영원히 지워버려도 좋소."
  },
  [26818] = {
    ["T"] = "만을 가로지르는 노 젓기",
    ["O"] = "저습지의 메네실 항구 동쪽 다리에 있는 앤드류 포터와 대화해야 합니다.",
    ["D"] =
    "사우스쇼어에 가보신 적이 있습니까, $C? 대륙에 남아 있는 가장 북쪽의 얼라이언스 도시 중 하나입니다. 사우스쇼어는 예전엔 붐비는 항구였는데, 거기 무슨 일이 생겼는지 도통 모르겠습니다. 들리는 소문으로는 암초나 다른 쓸데없는 것들 때문에 여기에서 사우스쇼어까지 가는 배들이 곤란을 겪고 있다고 합니다.\n\n아무튼, 포터 형제들이 우리 두 도시 사이에 작은 배편을 하나 마련했습니다. 힐스브래드로 가시려거든 다리 근처 아래에 있는 앤드류 포터와 대화해 보십시오."
  },
  [26819] = {
    ["T"] = "사자의 대지 정화",
    ["O"] = "굶주린 산사자 10마리를 처치하고 사우스쇼어의 치안대장 레드패스에게 돌아가야 합니다.",
    ["D"] =
    "자네가 와줘서 정말 다행이군, $c. 최근 들어 근방의 산사자들이 동요하며 점점 거칠어지더니, 우리 시민 몇 명에게 부상을 입혔다네. 당장 조치를 취해야 해!\n\n부디 이 지역의 산사자들을 처치해, 우리 사우스쇼어 시민들이 다시 안심하고 살 수 있게 도와주게. 녀석들은 보통 마을 바로 북쪽에서 어슬렁거리고 있다네."
  },
  [26820] = {
    ["T"] = "힐스브래드 강습",
    ["O"] = "중앙 탑이 얼라이언스의 통제하에 있을 때 탑을 점령해야 합니다.",
    ["D"] =
    "힐스브래드 중앙에 위치한 탑은 이 지역을 통제하기 위한 호드의 핵심 거점이다. 밴시 여왕께서 얼라이언스가 이 탑을 차지할 때마다 즉시 탈환해야 한다는 명을 내리셨다.\n\n병력을 모아 그녀의 명을 따르라, $n."
  },
  [26821] = {
    ["T"] = "힐스브래드 방어",
    ["O"] = "중앙 탑이 호드의 통제하에 있을 때 방어해야 합니다.",
    ["D"] =
    "힐스브래드 중앙에 위치한 탑은 이 지역을 통제하기 위한 호드의 핵심 거점이다. 밴시 여왕께서 얼라이언스가 이 탑의 점령을 시도할 때마다 무슨 일이 있어도 사수하라는 명을 내리셨다.\n\n병력을 모아 그녀의 명을 따르라, $n."
  },
  [26822] = {
    ["T"] = "힐스브래드 강습",
    ["O"] = "중앙 탑이 호드의 통제하에 있을 때 탑을 점령해야 합니다.",
    ["D"] =
    "힐스브래드 중앙에 위치한 탑은 이 지역을 통제하기 위한 얼라이언스의 핵심 거점입니다. 여군주 프레스톨께서 호드가 이 탑을 차지할 때마다 즉시 탈환해야 한다는 명을 내리셨습니다.\n\n병력을 모아 그녀의 명을 따르십시오, $n."
  },
  [26823] = {
    ["T"] = "힐스브래드 방어",
    ["O"] = "중앙 탑이 얼라이언스의 통제하에 있을 때 방어해야 합니다.",
    ["D"] =
    "힐스브래드 중앙에 위치한 탑은 이 지역을 통제하기 위한 얼라이언스의 핵심 거점입니다. 여군주 프레스톨께서 호드가 이 탑의 점령을 시도할 때마다 무슨 일이 있어도 사수하라는 명을 내리셨습니다.\n\n병력을 모아 그녀의 명을 따르십시오, $n."
  },
  [26824] = {
    ["T"] = "수배: 대마법사 자이고르",
    ["O"] = "던홀드 요새에 있는 대마법사 자이고르를 처치하십시오. 그 후 타렌 제분소의 고위집행관 다살리아에게 돌아가 보상을 받으십시오.",
    ["D"] =
    "실바나스 여왕님의 권위에 따라, 대마법사 자이고르를 즉시 처형할 것을 명한다. 자이고르는 비밀결사대라는 위험한 조직에 흑마법을 가르치고 훈련시킨 혐의를 받고 있다.\n\n그는 던홀드 요새, 십중팔구 마법사의 탑에서 발견할 수 있을 것이다. 놈들의 행위를 심판했다는 증거를 타렌 제분소의 고위집행관 다살리아에게 가져오는 자에게는 두둑한 포상금을 지급할 것이다."
  },
  [26825] = {
    ["T"] = "비밀결사대의 마법",
    ["O"] = "비밀결사대 구슬 5개를 모아 사우스쇼어의 핀 오델릭에게 돌아가야 합니다.",
    ["D"] =
    "나는 마법의 기예를 연구하며 항상 그 기예에 대해 더 많이 알아가려고 노력한다오. 집정관님은 비밀결사대가 사악한 음모를 위해 흑마법을 원동력으로 쓰고 있다고 굳게 믿고 계시지만, 나는 그 주장에 동의할 수가 없소.\n\n나를 위해 던홀드 요새로 가서 그들의 마법사들이 사용하고 있는 구슬을 좀 가져와 주겠소? 요새는 여기서 북동쪽으로 조금만 가면 찾을 수 있소. 하지만 철통같이 경비가 삼엄한 곳이니, 각별히 조심하시오."
  },
  [26826] = {
    ["T"] = "비밀결사대원 처치",
    ["O"] = "비밀결사대 도적 5명과 비밀결사대 경비병 5명을 처치해야 합니다. 임무를 마치고 타렌 제분소에 있는 고위집행관 다살리아에게 돌아가야 합니다.",
    ["D"] =
    "어둠의 여왕님께서 비밀결사대원들을 모조리 소탕하라는 명을 내리셨다. 그들은 약자를 짓밟고 모든 것을 약탈하는 아주 위험한 무법자 집단이다.\n\n놈들의 무리 중 일부가 이 근방 남동쪽의 탑을 점거하고 있다. 남쪽 길을 따라가다가 교차로에서 왼쪽으로 돌면 탑을 발견할 것이다. 보이는 족족 놈들을 쓸어버려라, $N - 그놈들이 또 무슨 흉계를 꾸밀지 아무도 모르니 말이다."
  },
  [26827] = {
    ["T"] = "던홀드 소탕 작전",
    ["O"] = "비밀결사대 감독원 10명과 비밀결사대 감독관 10명을 처치해야 합니다. 임무를 마치고 타렌 제분소에 있는 고위집행관 다살리아에게 돌아가야 합니다.",
    ["D"] =
    "자네에게 맡길 임무가 하나 더 있네, $n. 비밀결사대가 이곳 남동쪽 던홀드 요새를 장악했네. 이 땅을 무법자들로부터 지켜내는 것은 호드의 최우선 목표이지. 그러니 저 불결한 놈들을 이 땅에서 깨끗이 씻어내야만 해.\n\n던홀드 요새를 찾으려면 자네가 발견했던 탑을 지나 길을 따라 좀 더 가보게. 그 길을 따라 계속 가다 보면 요새를 발견하게 될 거야."
  },
  [26828] = {
    ["T"] = "진흙주둥이 혼합물",
    ["O"] = "진흙주둥이 체액 8개를 모아 사우스쇼어의 난다르 브랜슨에게 돌아가야 합니다.",
    ["D"] =
    "던홀드 요새에 자리 잡은 저 비밀결사대 놈들은 틈만 나면 우리 밭을 약탈하는 걸로 악명 높소. 뭐라도 조치를 취해야지 않겠소. 사우스쇼어 경비병들만으로는 역부족일까 봐, 내가 포세이큰 식의 묘책을 하나 꺼내 들기로 했소. 놈들의 식량 창고에 독을 풀 거요!\n\n가혹하게 들릴지 몰라도, 비상시엔 비상 대책이 필요한 법이오. 나를 돕고 싶다면, 여기서 동쪽 강 건너 네단더 장원에 득실거리는 놀들에게서 체액을 좀 구해다 주시오. 그걸로 놈들의 움직임을 단단히 늦춰 줄 강력한 독을 만들 테니!"
  },
  [26829] = {
    ["T"] = "비밀결사대에게 독을",
    ["O"] = "던홀드 요새에 있는 비밀결사대 식량에 독을 푼 다음 사우스쇼어의 난다르 브랜슨에게 돌아가야 합니다.",
    ["D"] =
    "독이 준비되었소, $N. 이제 가서 놈들의 식량에 이 독을 풀 사람만 있으면 되오. 던홀드 요새는 여기서 북동쪽 길을 따라가면 놓칠 수가 없을 거요. 하지만 명심하시오. 비밀결사대원들은 자신들의 요새를 지키기 위해 무척 예민해져 있으니 동료들을 데려가는 편이 현명할 거요.\n\n요새 안으로 들어가면 놈들의 막사를 찾아보시오. 그 안에 놈들의 식량이 보관되어 있을 것이 틀림없소. 막사 주변에 독을 퍼뜨리고 식량을 찾아 오염시킨 뒤, 이곳으로 돌아오시오."
  },
  [26830] = {
    ["T"] = "수배: 베브 페레놀드",
    ["O"] = "베브 페레놀드를 처치하고 그녀의 머리를 사우스쇼어에 있는 대장 탈렌에게 가져가야 합니다.",
    ["D"] =
    "사우스쇼어의 탈렌 대장의 명령으로 베브 페레놀드에게 사형이 선고되었다. 이 위험천만한 범죄자는 던홀드 요새를 통제하는 감독관이며, 이 지역 비밀결사대를 철권으로 지배하고 있다.\n\n그녀는 사우스쇼어 북동쪽에 위치한 요새의 중심부에서 발견될 가능성이 높다. 그녀의 머리를 탈렌 대장에게 가져오면 보상을 받을 수 있다."
  },
  [26831] = {
    ["T"] = "비밀결사대 계획",
    ["O"] = "사우스쇼어에 있는 대장 탈렌에게 비밀결사대 계획을 전달해야 합니다.",
    ["D"] =
    "당신은 베브 페레놀드의 호주머니에서 떨어진 편지 한 장을 발견합니다. 봉인되어 알리덴 페레놀드 경에게 보내진 이 편지는 꽤 중요해 보입니다.\n\n사우스쇼어에 있는 탈렌 대장이 이 편지에 큰 관심을 보일 것입니다. 편지에는 비밀결사대의 향후 계획이 상세히 적혀 있을지도 모릅니다."
  },
  [26832] = {
    ["T"] = "비밀결사대 계획",
    ["O"] = "타렌 제분소에 있는 고위집행관 다살리아에게 비밀결사대 계획을 전달해야 합니다.",
    ["D"] =
    "당신은 베브 페레놀드의 호주머니에서 떨어진 편지 한 장을 발견합니다. 봉인되어 알리덴 페레놀드 경에게 보내진 이 편지는 꽤 중요해 보입니다.\n\n타렌 제분소에 있는 고위집행관 다살리아가 이 편지에 큰 관심을 보일 것입니다. 이 편지에는 비밀결사대의 향후 세부 계획이 담겨 있을지도 모릅니다."
  },
  [26833] = {
    ["T"] = "찔레가시 치료제",
    ["O"] = "잿빛 골짜기에 있는 거미에게서 찔레가시 연고 8개를 수집하여 사우스쇼어에 있는 제나 썬더브루에게 돌아가야 합니다.",
    ["D"] =
    "제 남편이 몹시 아파요, $N. 제가 아는 모든 치료법을 다 써봤지만 어떤 것도 소용이 없어요.\n\n얼마 전, 한 여행자가 지나가다 머나먼 땅에 사는 거미에 대해 말해주더군요. 그 거미들은 아무리 지독한 상처라도 치유할 수 있는 연고를 만들어 낸다고 했어요.\n\n그 거미의 이름은 찔레가시라고 불리며, 아득히 먼 칼림도어 대륙의 잿빛 골짜기에 숨어 산다고 했어요. 너무 무리한 부탁인 건 알지만... 만약 칼림도어에 가시게 된다면, 제 남편을 고칠 수 있게 찔레가시 연고를 좀 구해 주시겠어요?"
  },
  [26834] = {
    ["T"] = "제나를 돕기",
    ["O"] = "힐스브래드 구릉지에서 제나 썬더브루를 찾아야 합니다.",
    ["D"] =
    "우리 지역 치료사인 제나 썬더브루에게 긴급한 편지를 받았네. 남편이 몹시 아파 당장 도움이 필요하다더군.\n\n사우스쇼어는 시민을 저버리지 않으니 자네가 가서 상황을 좀 확인해 줬으면 하네. 그녀는 서쪽 공터에 있는 자기 집 오두막에 살고 있어."
  },
  [26835] = {
    ["T"] = "원소 마스터",
    ["O"] = "고를룬드 스노우비어드를 위해 바람, 불, 대지, 물의 샘플을 각각 하나씩 모아야 합니다.",
    ["D"] =
    "와일드해머 부족의 고를룬드 스노우비어드가 당신처럼 뛰어난 주술사를 찾고 있습니다. 그는 당신이 준비가 되었음을 증명하기 위해 원소의 샘플을 각각 하나씩 가져와 달라고 요청했습니다.\n\n맹금의 봉우리에서 그를 찾을 수 있을 겁니다."
  },
  [26836] = {
    ["T"] = "마법수호 영혼",
    ["O"] = "고를룬드 스노우비어드를 위해 두꺼운 검은 발톱과 핏발선 거미 눈알을 모아야 합니다.",
    ["D"] =
    "이 동부 내륙지의 흉측한 트롤 녀석들이 악랄한 정령 마법으로 우리 요새를 공격해 온다오. 그 녀석들의 혼령을 물리칠 토템을 만들 재료를 알고는 있지만, 나도 이제 예전 같지 않아 늙은 드워프일 뿐이라오.\n\n여기서 동쪽으로 신디거의 야영지까지 길을 따라간 다음, 북쪽으로 가면 지금은 서부 역병지대로 불리는 곳에 도착할 거요. 거기서 마법수호 토템에 쓸 흑곰의 발톱과 거미 눈알을 좀 구해 주시오. 잘 찾아보면 그곳을 배회하는 청소부 동물들에게서도 얻을 수 있을지 모르오."
  },
  [26837] = {
    ["T"] = "트롤 마법",
    ["O"] = "가라앉은 사원에서 호박빛, 푸른빛, 녹색 부두 깃털을 모아오십시오.",
    ["D"] =
    "아악! 힘이 부족하군! 이럴 줄 알았어. 트롤들의 저주받은 부두술 자체가 아니면 그놈들의 혼령 마법을 무력화시킬 수가 없겠어.\n\n머나먼 남쪽 슬픔의 늪에 가라앉은 사원이라는 곳이 있다오. 그곳의 미잔, 졸로, 줄로, 로로, 게이셔, 후쿠라는 트롤들이 자신들의 그 끔찍한 부두 마법이 깃든 깃털을 가지고 있다더군. 그 쥐새끼 같은 놈들을 처치하고, 그 깃털들을 내게 가져오시오."
  },
  [26838] = {
    ["T"] = "장례를 부탁해요",
    ["O"] = "은빛개울 광산에서 본두르의 뼈를 회수하여 텔사마의 야니 스타우트하트에게 돌아가야 합니다.",
    ["D"] =
    "제 남편 본두르는 북쪽의 은빛개울 광산에서 일하던 광부였습니다. 그는 가족을 먹여 살리기 위해 힘든 노동도 마다하지 않는, 따뜻하고 헌신적인 사람이었어요.\n\n하지만 트로그들이 광산을 덮치자, 그곳에 있던 이들에게 어떤 자비도 베풀지 않았습니다. 사랑하는 제 남편 본두르는 그들에게 처참하게 찢겨 죽고 말았어요.\n\n이제 그가 떠났다는 사실은 받아들였지만, 그의 뼈는 아직도 광산에 남아 있습니다. 남편을 이곳 묘지에 제대로 묻어주고 싶어요.\n\n슬픔에 빠진 과부를 위해 제발 도와주시겠어요, $N? 은빛개울 광산으로 가서 본두르의 뼈를 수습해 텔사마 묘지에 묻어 주실 수 있나요?"
  },
  [26839] = {
    ["T"] = "호드의 보고서",
    ["O"] = "호드의 보고서를 텔사마로 가져가서 이 내용에 관심 가질 만한 사람을 찾아야 합니다.",
    ["D"] =
    "당신은 죽은 오크의 시체에서 공식적인 문서로 보이는 보고서를 발견했습니다. 분명 이 보고서에 흥미를 가질 만한 사람이 있을 거라는 확신이 들지만, 과연 누구일까요?\n\n텔사마에는 아이언포지의 경비병들이 다수 주둔해 있습니다. 그들 중 누군가가 분명 이 물건을 제대로 처리할 적임자일 것입니다."
  },
  [26840] = {
    ["T"] = "호드 사절",
    ["O"] = "모단 호수와 저습지 사이의 산길을 차지한 용아귀 오크 무리 중에서 호드 사절을 찾아 처치해야 합니다.",
    ["D"] =
    "이 보고서 수신인은 처음 들어보는 호드 사절이군. 하지만 모단 호수와 저습지 사이의 산등성이에 터를 잡은 용아귀 오크 무리들과 모종의 거래를 성사시키려는 속셈이 분명하구먼. 어떻게 이럴 수가 있지?! 바로 우리 턱밑에 호드가 우글거리고 있다니!\n\n그런 수작질을 놔둘 수는 없네, $N. 저습지로 가는 남쪽 길을 따라 용아귀 야영지에 숨어있는 그 사절 놈을 찾아내게. 그놈이 우리의 취약점을 호드 측에 보고하지 못하도록 영영 입을 다물게 해버리게!"
  },
  [26841] = {
    ["T"] = "잃어버린 유물",
    ["O"] = "아이언밴드의 발굴현장에서 잃어버린 유물 5개를 회수하여 모단 호수의 알드렌 코든에게 돌아가야 합니다.",
    ["D"] =
    "망할 트로그 녀석들, 언제나 일을 엉망으로 만들지! 그 녀석들이 나타나기 전까지만 해도 발굴 작업은 아주 순조로웠는데 말이야. 왜 항상 나한테만 이런 일이 생기는 걸까?\n\n허둥지둥 대피하느라 발굴 현장에 소중한 유물들을 좀 남겨두고 왔지 뭡니까. 이 발굴은 마그니 국왕께서 직접 지시하신 건데, 만약 유물들을 잃어버리면 우린 정말 큰일 날 겁니다! 혹시 저희를 위해 유물 몇 개만 되찾아주시겠습니까?"
  },
  [26842] = {
    ["T"] = "의약품 보충",
    ["O"] = "호수에서 호수 물풀 8개를 수집하여 텔사마의 칼리 힐터치에게 돌아가야 합니다.",
    ["D"] =
    "와 주셔서 정말 기뻐요, $N! 의약품이 부족해서 도움이 꼭 필요했거든요.\n\n트레샤돈들이 점점 사나워지면서, 물속에서 자라는 호수 물풀을 구하기가 점점 힘들어지고 있어요. 경비병들도 호수로 가길 꺼려하고 있고요. 혹시, 제가 물약을 채울 수 있도록 대신 물풀을 가져다주실 수 있을까요?"
  },
  [26843] = {
    ["T"] = "호수 안전 확보",
    ["O"] = "새끼 트레샤돈 10마리를 처치하고 텔사마의 산악경비대 오즈모크에게 돌아가야 합니다.",
    ["D"] =
    "안녕하신가, 뭔가 해결해야 할 골칫거리가 생겼네, $c. 내 임무는 땅만 지키는 게 아니라 물도 지키는 거라네!\n\n호수에 위험한 일이 벌어졌어. 이 일대에 큰 골칫거리지. 호수에 사는 트레샤돈들이 마치 뭔가에 자극받기라도 한 듯 최근 눈에 띄게 난폭해졌다네. 바로 며칠 전엔 텔사마 주민 한 명이 호수에서 낚시를 하다가 녀석들의 공격을 받고 죽을 뻔했어! 자네가 가서 그 녀석들 수를 좀 줄여주게. 그래야 호수가 우리 주민들에게 다시 안전해질 수 있을 테니 말이야."
  },
  [26844] = {
    ["T"] = "이상한 우상",
    ["O"] = "아이언포지의 탐험가의 전당에 있는 발굴조사단장 스톰파이크에게 이상한 우상을 가져가야 합니다.",
    ["D"] =
    "이 우상들이 트로그를 광분하게 만든 이유를 알아내려면 연구가 필요하겠지만... 잠깐, 이 우상은 다른 것들과는 많이 다르군.\n\n이것에는 뭔가 기묘한 게 있소. 딱 꼬집어 말할 순 없지만. 양식은 다른 우상들과 동일한데 훨씬 더 최신 것 같아 보이거든. 마치 이 유적지가 애초에 우리가 추정했던 것보다 훨씬 오랫동안 사용되었던 것처럼 말이오.\n\n이건 내 능력 밖의 일이오. 아이언포지의 스톰파이크 발굴조사단장님께 가져가 보시는 게 어떻소? 그분에게 당신의 도움으로 발굴에 진전이 생겼다는 점도 분명히 전할 수 있을 거요."
  },
  [26845] = {
    ["T"] = "수배: 엄마 테사",
    ["O"] = "엄마 테사를 처치하고 그녀의 머리를 텔사마의 집정관 블런트노즈에게 가져가야 합니다.",
    ["D"] =
    "텔사마 집정관의 명령:\n\n호수를 배회하는 위험한 트레샤돈, 일명 '엄마 테사'에게 사형을 선고한다. 여러 건의 끔찍한 사망 사건이 발생한바, 주민들은 이 위협이 해결될 때까지 호수에서 낚시하지 않기를 경고한다.\n\n엄마 테사의 현상금을 노리는 모험가들은 놈이 일반적인 트레샤돈보다 훨씬 거대하고 강력하다는 점을 명심해야 할 것이다. 텔사마에 있는 집정관 블런트노즈에게 처치 증거를 제출하면 보상을 지급할 것이다."
  },
  [26846] = {
    ["T"] = "종류별로 하나씩",
    ["O"] = "붉은마루 산맥에 있는 모든 종류의 멀록을 한 마리씩 처치해야 합니다.",
    ["D"] =
    "어이, 친구!\n\n믿기 힘들겠지만, 난 내 첫 사냥을 바로 이곳 붉은마루 산맥에서 했지. 사실 지금도 내 바로 머리 위쪽 언덕을 돌아다니고 있어! 아, 그 기억이란... 내가 가끔 이곳으로 다시 돌아오는 이유이기도 해. 물론 최근 내가 이룬 큰 성과들에 비하면 아무것도 아니지만, 누구나 처음이라는 게 있는 법이잖아!\n\n말이 나왔으니 말인데, 스스로 실력을 증명하고 싶다면 꽤 재미있는 도전거리를 하나 주지. 이 근방의 다양한 멀록들을 찾아내 처치해 봐. 이 끈적이는 물고기 녀석들은 종마다 특징이 달라서, 각기 다른 전술이 필요할 거야. 네 다재다능함을 증명할 완벽한 기회지!\n\n더구나 그 녀석들이 불어나고 있다는 소문도 도니까, 넌 지금 이 마을 주민들에게 큰 호의를 베푸는 셈이 될 거야!\n어때, 이 도전에 응할 텐가?"
  },
  [26847] = {
    ["T"] = "진창발 아르도",
    ["O"] = "진창발 아르도를 처치하고 그의 앞발을 레이크샤이어에 있는 버팔로 윌에게 가져가야 합니다.",
    ["D"] =
    "또 다른 도전을 하러 돌아왔나? 그럼 단단히 각오해, 파트너. 이번 놈은 대충 상대하다간 네 명줄이 먼저 끊어질 테니까!\n\n놈의 이름은 진창발 아르도. 이 근방에서 아주 골칫거리인 녀석이지. 내가 그 악당 놈을 북쪽 레이크샤이어 뒤편 언덕에 있는 동굴까지 쫓아갔어. 놈의 그 유명한 앞발을 내게 가져온다면 도전에 성공한 것으로 인정하고, 내 최고의 사냥용품들을 보상으로 주지!\n행운을 비네!"
  },
  [26848] = {
    ["T"] = "클라이드의 특별한 실",
    ["O"] = "붉은마루 산맥의 클라이드 랜덜에게서 클라이드의 특별한 실을 구해 레이크샤이어의 에이미 데이븐포트에게 가져가야 합니다.",
    ["D"] =
    "저기, 부탁 하나만 해도 될까요? 전 클라이드 랜덜이 파는 특별한 실이 하나 필요한데, 그가 붉은마루 산맥의 가장 동쪽 산꼭대기에 가게를 차렸지 뭐예요. 오크와 놀들 때문에 길이 너무 험해서 직접 갈 엄두가 나지 않지만, 당신이라면 해낼 수 있을 것 같네요!\n\n특별한 실에 대해 반드시 그에게 직접 물어보셔야 해요. 일반 상품 목록에는 없을 테니까요. 실 구매 비용에 당신의 노고에 대한 보답까지 넉넉하게 얹어서 드릴게요."
  },
  [26849] = {
    ["T"] = "놀 순찰대",
    ["O"] = "잿빛가죽일족 투사 7명과 잿빛가죽일족 전사 7명을 처치하고 붉은마루 산맥에 있는 클라이드 랜덜에게 돌아가야 합니다.",
    ["D"] =
    "제 특별한 실이요? 만약 당신이 일갈라의 탑 근처를 순찰하는 저 악랄한 놀 놈들을 없애 주시면, 공짜로 드리죠!\n\n여기서 장사 좀 해보려는데 최근 저 망할 짐승들 때문에 골칫거리가 한둘이 아니라고요. 놈들은 상도의라고는 눈곱만큼도 없는 것 같아요!"
  },
  [26850] = {
    ["T"] = "눈에는 눈",
    ["O"] = "검은바위부족 소환사 6명과 검은바위부족 추적자 6명을 죽인 후 레이크샤이어의 치안대장 매리스에게 돌아가야 합니다.",
    ["D"] =
    "끔찍한 소식입니다, $N! 우리 연대 중 하나가 검은바위 오크들의 매복에 당했습니다. 살아서 돌아온 병사도 거의 없고 많은 이가 영영 실종되었습니다. 이 악랄하고 흉포한 짓을 결코 용서할 수 없지만, 안타깝게도 반격에 나설 여력이 없고 사기도 땅에 떨어진 상태입니다.\n\n당신의 도움이 필요합니다. 검은바위 부족에게도 공격에는 대가가 따른다는 것을 보여주어야 합니다. 적의 가장 아픈 곳을 타격하여 전술적인 타격을 가해야 합니다, $N. 그들의 추적자와 소환사를 없애버리십시오. 그러면 놈들은 두 번 다시 우리를 매복 공격할 엄두를 내지 못할 겁니다.\n\n불타는 평원으로 향하는 길 서쪽, 북쪽에 있는 그들의 야영지에서 놈들을 찾을 수 있을 겁니다."
  },
  [26851] = {
    ["T"] = "모건스에 대한 첩보",
    ["O"] = "엘윈 숲 아조라의 탑에 있는 테오크리투스에게 쪽지를 전달하십시오.",
    ["D"] =
    "반갑습니다, 친구여! 제가 사슬에 묶인 모습을 보면 꽤나 곤란한 상황이라 생각하시겠죠! 하지만 모든 게 제 계획대로 되고 있습니다! 제 주변에 있는 오크들의 대화를 엿들으면서, 모건스에 관한 아주 소중한 정보를 캐내고 있거든요. 하! 제가 좀 천재적이지 않습니까?\n\n주인님께선 제가 알아낸 모든 것을 당장 알고 싶어 하실 겁니다. 이 쪽지를 주인님께 전달해 주십시오. 그동안 전 더 많은 정보를 찾아보겠습니다. 당신의 수고에 걸맞은 보상을 해주실 겁니다!"
  },
  [26852] = {
    ["T"] = "카르가스의 도난당한 보급품",
    ["O"] = "이글거리는 협곡의 가마솥과 잿가루 구덩이에 있는 검은무쇠단 드워프들로부터 호드 보급품 상자 8개를 되찾아야 합니다.",
    ["D"] =
    "이글거리는 협곡에 있는 검은무쇠단 드워프들이 우리가 떨어뜨린 보급품을 훔쳐 달아나고 있다는 보고를 받았습니다. 황야의 땅에서 우리의 교두보를 지키려면 그 보급품들이 필요합니다.\n\n카르가스 바로 남쪽 고개를 거쳐 서쪽으로 향하십시오. 그러면 이글거리는 협곡 중심부에 위치한 가마솥과 잿가루 구덩이, 그리고 검은무쇠단 광산들을 발견할 수 있을 겁니다. 가능한 한 많은 보급품 상자를 되찾아 오십시오."
  },
  [26853] = {
    ["T"] = "이글거리는 정령",
    ["O"] = "검댕가루 발굴지로 인해 깨어난 정령들을 찾아 안식에 들게 해야 합니다.",
    ["D"] =
    "검댕가루 발굴지 때문에 오래전 죽은 생물들의 영혼이 깨어난 것 같소. 이글거리는 정령들이 발굴지 남쪽의 언덕과 평원을 배회하고 있다는 보고를 받았소. 그 정령들을 다시 흙으로 돌려보내 영원한 안식을 취하게 해주면 좋겠소. 그게 내 형제가 저지른 만행을 수습하기 위해 내가 할 수 있는 최소한의 일일 테니."
  },
  [26854] = {
    ["T"] = "황혼의 전술",
    ["O"] = "이글거리는 협곡 북서쪽 황혼의 야영지에서 황혼의망치단 화염경비병 8명과 황혼의망치단 풍수사 8명을 처치해야 합니다.",
    ["D"] =
    "토륨 대장조합은 황혼의 망치단이 검은바위 산 내부 섀도포지 도시에 있는 우리 형제들에게 밀사들을 보냈다는 사실을 들었소. 라그나로스의 부하들은 오랫동안 잠들어있던 옛 힘을 위해 동맹을 얻으려 하고 있지만, 우리 대장조합은 놈들이 이글거리는 협곡에 발을 들이도록 놔두지 않겠소!\n\n이 이교도들을 모조리 척살하여 그들의 그 끔찍한 의... *딸꾹*... 의식... *딸꾹*... 의식들을 끝장내시오."
  },
  [26855] = {
    ["T"] = "황혼의 전술",
    ["O"] = "이글거리는 협곡 북서쪽에 있는 황혼의망치단 동굴을 수색하여 의식의 제단을 찾아내고 섀도포지 도시에서 도난당한 타우릿산의 유물을 회수해야 합니다.",
    ["D"] =
    "아주 오래전, 우리 다그란 타우릿산 제왕님의 조상께서 끔찍한 마법으로 라그나로스를 이곳에 소환하셨소. *딸꾹* 두려운 건, 황혼의 망치단이 그자를 다시 깨우려 한다는 것이오.\n\n섀도포지 도시에 잠입한 그들의 밀사들이 마술사왕 타우릿산의 유물을 몰래 빼돌렸다오. 그들이 그걸로 무얼 꾸미려는지는 알 수 없소... *딸꾹*... 하지만 내 생각엔 동굴 안에 있는 의식의 장소에 그걸 보관해 둔 것 같소. 당신이 침투해서... *딸꾹*... 조사... *딸꾹*... 이 유물을 되찾아와야 하오."
  },
  [26856] = {
    ["T"] = "황혼의 전술",
    ["O"] = "황혼의망치단 밀사 모갈리와 감독관 위프트의 접선을 저지하고 그들이 소지한 문서를 회수해야 합니다.",
    ["D"] =
    "내 정보원들의 보고서에 따르면 곧 이 근방에서 황혼의 망치단 밀사와 가마솥의 감독관 한 놈 사이의 접선이 있을 거요. 우리는 그 밀회를 당장 막고, 그 반역자 놈들이 가지고 있는 모든 문서를 회수해야만 하오.\n\n정보에 의하면, 접선 장소는 여기서 남동쪽 검은바위 산 입구 근처에 있는 검은재 동굴 근처라오. 지체할 시간이 없소, $C! *딸꾹*"
  },
  [26857] = {
    ["T"] = "문서를 아이언포지로!",
    ["O"] = "황혼의 동맹 문서를 아이언포지에 있는 메리다 스타우트포지에게 가져가야 합니다.",
    ["D"] =
    "이제 이 문서들을 손에 넣었으니...<*딸꾹*>... 당신이 직접 이 서류들을 아이언포지에 있는 메리다 스타우트포지에게 전해주시길 부탁하오. 그녀는 지금 국왕 폐하를 알현하기 위해 기다리고 있고, 이 문서가 그녀의 주장을 뒷받침하는 결정적인 증거가 될 것이오."
  },
  [26858] = {
    ["T"] = "토륨 대장조합",
    ["O"] = "이글거리는 협곡의 토륨 거점에 있는 망꾼 롤로 롱스트라이커와 대화해야 합니다.",
    ["D"] =
    "$C! 네, 당신이오! 제발, 아이언포지의 다른 수많은 이들처럼 저를 무시하지 말아주십시오.\n\n저는 이글거리는 협곡에 있는 토륨 대장조합 주둔지에서 왔소. 검은무쇠 부족과 브론즈비어드 부족 사이의 관계가 껄끄럽긴 하지만, 섀도포지 도시 안에는 황혼의 망치단과 결탁하기 시작한 자들이 있소. $C, 난 마그니 국왕께 당장 이 사실을 경고해야 하는데, 폐하를 알현할 약속이 계속 미뤄지고 있소.\n\n토륨 거점은 지금 당장 도움이 필요하오! 당신이 진정한 모험가라면, 망꾼 롤로 롱스트라이커를 찾아가 그를 돕겠다고 자원해 주시오."
  },
  [26859] = {
    ["T"] = "정령, 타락하다",
    ["O"] = "이글거리는 협곡에서 그을린 오염물에게서 타락한 물의 핵을, 불지옥 정령에게서 타락한 불의 핵을, 용암 정령에게서 타락한 대지의 핵을, 연기 정령에게서 타락한 바람의 핵을 하나씩 모아야 합니다.",
    ["D"] =
    "경계하시오, $R. 이곳은 분노로 가득한 땅이오. 이백 년 전 검은바위 산을 만들어낸 지각 변동이, 어쩌면 이곳의 원소의 힘마저 알아볼 수 없게 타락시켰을지도 모르는 일이지.\n\n라그나로스의 등장으로 겪은 끔찍한 상흔이 협곡의 토착 정령들에게 전이된 건 아닐까 염려되오. 내가 이 현상을 연구할 수 있도록 장비들을 세팅하는 동안, 정령 각 종류의 핵들을 모아다 줄 자가 필요하오. 혹시 당신이 적임자요?"
  },
  [26860] = {
    ["T"] = "검댕가루 작업현장",
    ["O"] = "이글거리는 협곡의 검댕가루 작업현장에서 검은무쇠단 지질학자 4명을 죽이고 유물 상자를 회수해야 합니다.",
    ["D"] =
    "검은무쇠 드워프들은 검은바위 산 깊숙한 섀도포지 도시에서 여간해서는 밖으로 나오는 법이 없는데, 무슨 이유인지 이글거리는 협곡 서부 경계에 있는 검댕가루 작업현장으로 지질학자 팀을 파견했소. 그곳에서 일하던 아이언포지 팀도 쫓아내고 말이오!\n\n무엇이 이 드워프들의 흥미를 끌었는지 반드시 알아내야만 하오. 이 발굴 작업을 중단시키고 그들이 수집하고 있는 유물 상자를 가져오시오."
  },
  [26861] = {
    ["T"] = "이글거리는 정령",
    ["O"] = "검댕가루 발굴지로 인해 깨어난 영혼들을 찾아, 그들의 불타오르는 정수 6개를 수집해야 합니다.",
    ["D"] =
    "검댕가루 작업현장 때문에 오래전 죽은 생물들의 혼이 깨어난 것 같소. 이제 그들의 영혼이 작업현장 남쪽 언덕과 평원을 떠돌고 있지. 내 연구를 위해 이 혼령들의 정수를 수집해 줬으면 하오.\n\n걱정 마시오, 당신이라면 충분히 해낼 수 있을 거요."
  },
  [26862] = {
    ["T"] = "섀도포지 도서관 사서",
    ["O"] = "섀도포지 도서관 사서 빈데롤을 쓰러뜨리고 '타우릿산의 역사'를 회수하여 황야의 땅 카르가스에 있는 어둠마법사 비비안 라그레이브에게 가져가야 합니다.",
    ["D"] =
    "드문 기회가 찾아왔소, $c. 이 기회를 살릴 수 있는 적임자가 필요하오.\n\n섀도포지 도서관 사서 빈데롤은 뛰어난 작가이자 지독한 은둔자라오. 그런데 무슨 일인지 잿가루 구덩이로 출장을 와서 지금은 검은무쇠막사에 머물고 있소. 어쩌면 그가 쓴 \"타우릿산의 역사\" 원고 복사본을 손에 넣을 유일한 기회일지도 모르오.\n\n난 그 책이 필요하오. 무슨 수를 써서라도 그걸 가져오시오!"
  },
  [26863] = {
    ["T"] = "섀도포지 도서관 사서",
    ["O"] = "섀도포지 도서관 사서 빈데롤을 처치하고 '타우릿산의 역사'를 되찾아 아이언포지 탐험가의 전당에 있는 사서 메이 페일더스트에게 가져가야 합니다.",
    ["D"] =
    "드문 기회가 찾아왔습니다, $c. 이 기회를 살릴 수 있는 사람이 필요합니다.\n\n섀도포지 도서관 사서 빈데롤은 뛰어난 작가이자 소문난 은둔자입니다. 그런데 무슨 일인지 잿가루 구덩이로 여행을 와서 지금은 검은무쇠막사에 머물고 있죠. 어쩌면 그의 \"타우릿산의 역사\" 원고 사본을 손에 넣을 유일한 기회일지도 모릅니다.\n\n폭력은 옹호하고 싶지 않지만, 전 그 책이 꼭 필요합니다. 부디 저를 위해 그 책을 손에 넣을 방법을 찾아봐 주시겠습니까?"
  },
  [26864] = {
    ["T"] = "노예상인들이 기록을 보관할까?",
    ["O"] = "검은무쇠단 노예상인들로부터 노예상 기록을 확보한 후 이글거리는 협곡의 부린드 스타우트포지에게 돌아가야 합니다.",
    ["D"] =
    "우리 가문에게 아주 소중한 이가 노예상인들에게 납치되어 그를 되찾기 위해 여기까지 왔네. 자네, 가마솥에 있는 노예상인들을 알고 있나? 그자들이 몇몇 노예들을 어떻게 처리했는지 기록해 둔 장부가 분명 있을 거라고 확신하네.\n\n나를 위해 그들의 시체를 뒤져서 뭐라도 좀 찾아주게."
  },
  [26865] = {
    ["T"] = "그랜피의 가설",
    ["O"] = "이글거리는 협곡 북서쪽에서 접선 장소를 찾아야 합니다. 밀사들을 모두 처치하고 노예상인의 기록을 그랜피 스타우트포지에게 가져가야 합니다.",
    ["D"] =
    "<그랜피가 덥수룩한 눈썹 너머로 당신을 노려봅니다.>\n\n황혼의 망치단 놈들. 북서쪽에서 노예상인들과 은밀히 만나는 걸 내 두 눈으로 똑똑히 봤네. 필시 조만간 또 접선하겠지. 그놈들을 모조리 쓸어버리고 무슨 단서를 가지고 있는지 뒤져 보게.\n\n<생각에 잠긴 듯 수염을 쓰다듬는 늙은 드워프.>"
  },
  [26866] = {
    ["T"] = "레이사",
    ["O"] = "불망루 마루에서 레이사를 구출한 후 이글거리는 협곡의 부린드 스타우트포지에게 돌아가야 합니다.",
    ["D"] =
    "저기 북서쪽에 있는 불망루 마루 안에는 동굴이 하나 있는데, 거긴 황혼의 망치단 놈들이 우글거린다네. 그 짐승 같은 놈들이 레이사를 그곳에 가둬놓고 제물로 바치기만 기다리고 있을 게 틀림없네! 아니, 그보다 더 끔찍한 짓을 꾸미고 있을지도 몰라...!\n\n당장 그 동굴로 가서 그녀를 구해주게! 노예상인 놈들이 내가 자리를 비운 틈에 그랜피를 낚아채지 못한다는 확신이 서면 자네를 곧 따라가겠네."
  },
  [26867] = {
    ["T"] = "고위 심문관",
    ["O"] = "검은바위 나락의 대심문관 게르스탄을 처치한 후, 이글거리는 협곡의 그랜피 스타우트포지에게 돌아가야 합니다.",
    ["D"] =
    "<그랜피가 대견해하는 표정으로 당신을 바라봅니다.>\n\n정말 잘해주었네. 레이사는 회복 중이야. 마을로 돌아가기 전에 내 아들 녀석과 나에게 그동안 있었던 일들을 장황하게 다 털어놓았지. 간단히 말하자면, 검은바위 나락 감금 구역 안에 끔찍한 괴물이 있다는 거라네. 그녀는 그 괴물을 없애고 싶어 했지만, 지금 몸 상태로는 도저히 무리야. 하지만 그녀는 자네라면 능히 해낼 수 있을 거라 확신하더군. 녀석의 이름은 게르스탄이고, 종족은 인간일세.\n\n어떤가? 레이사의 복수를 대신 끝내고 보상을 두둑이 챙겨보지 않겠나?"
  },
  [26868] = {
    ["T"] = "그랜피 스타우트포지",
    ["O"] = "이글거리는 협곡 남서쪽 야영지에 있는 그랜피 스타우트포지를 찾으십시오.",
    ["D"] =
    "그랜피 스타우트포지는 드워프 중에서도 상당히 나이가 많은 편입니다. 그는 마스터 대장장이로, 누구의 기억보다 오래전부터 토륨 대장조합 소속으로 활동해 왔습니다.\n\n최근에 그는 그의 아들 부린드와 함께 남쪽으로 떠났습니다. 목적은 밝히지 않았지만, 그의 행동에는 어딘지 이상한 점이 있었습니다. 당신이 직접 가서 그들이 무슨 일을 벌이고 있는지, 도움이 필요한 건 아닌지 확인해 보는 게 어떻겠습니까?"
  },
  [26869] = {
    ["T"] = "사후의 해부학",
    ["O"] = "공동묘지에 있는 연금술사 렌퍼럴을 위해 돌연변이의 머리 1개, 기형적인 가슴 1개, 씹다 남은 팔 2개, 훼손된 다리 2개를 수집해야 합니다.",
    ["D"] =
    "공동묘지는 자네의 도움이 필요하네, $N! 우리 경비병들을 죽이고 다니는 위험한 회색곰이 나타났네. 우리의 무기나 마법으로는 그 야수를 처치할 수가 없어서 언더시티는 내게 그 짐승을 베어버릴 수 있는 끔찍한 괴물을 창조하라는 임무를 맡겼다네.\n\n누더기골렘은 살점들을 꿰매어 만든 돌연변이 창조물이네. 불행히도 신체 부위가 다 떨어져서 그것들을 모으는 데 자네 도움이 절실하네. 근처에 있는 늑대인간의 머리와 놀의 가슴, 그리고 이 동쪽에 있는 언데드에게서 두 팔을, 호수 근처 멀록에게서 두 다리를 구해주면 좋겠네.\n\n이것들을 모아서 내게 가져오면 누더기골렘을 꿰매는 주문을 시작할 수 있네. 제발 서둘러주게나. 회색곰이 우리 경비병들을 더 죽이기 전에 말이네."
  },
  [26870] = {
    ["T"] = "사후의 해부학",
    ["O"] = "공동묘지에 있는 연금술사 렌퍼럴을 위해 호박색 농장의 인간들에게서 농축된 피 10개를 수집해야 합니다.",
    ["D"] =
    "자네가 내게 가져온 이 신체 부위들은 우리 누더기골렘에 완벽하게 맞을 걸세. 하지만 단 한 가지 더 필요한 게 있네. 자네가 외출한 사이, 마을에서 발생한... 어떤 사건 때문에 내가 인간의 피를 몽땅 써버리고 말았거든. 누더기골렘을 완성하기 위해 마지막으로 필요한 건 신선한 인간의 피라네.\n\n이 지역에서 가장 질 좋은 피는 호박색 농장에 있는 인간들한테서 구할 수 있네. 이 마을 남쪽으로 난 길을 따라가다가 마을 쪽인 동쪽으로 꺾으면 호박색 농장을 찾을 수 있을 걸세. 하지만 조심하게, 그 인간들은 지난번에도 엄청나게 저항했으니 말이네!"
  },
  [26871] = {
    ["T"] = "사후의 해부학",
    ["O"] = "누더기골렘을 소환하고 통제한 뒤, 공동묘지 남쪽의 아카기를 처치하는 데 사용해야 합니다. 임무가 완료되면 연금술사 렌퍼럴에게 돌아가야 합니다.",
    ["D"] =
    "보통은 언더시티에서 누더기골렘을 만들지만 이 위급한 상황엔 여기서라도 대충 얼버무려 만들어야 하네. 언더시티에 있는 재료들이 다 구비된 게 아니라서 안타깝게도 이 녀석에겐 자아 따윈 없을 걸세. 그러니 자네가 녀석을 조종해야 하네. 내가 그 주문의 영창을 적어두었지. 내가 끝마치자마자 누더기골렘의 정신은 자네의 통제 아래 놓이게 될 걸세.\n\n방금 전 경비병들한테서 우리가 찾던 회색곰이 바로 남쪽에서 목격되었다는 보고를 받았네. 놈의 이름은 아카기일세.\n\n비행 조련사 옆에 난 험한 샛길로 따라가다가 처음 나오는 공터에서 우회전하게. 그 야수를 그곳에서 찾을 수 있을 걸세. 단, 서둘러야 하네. 마법은 불과 몇 분밖에 지속되지 않을 테니까!"
  },
  [26872] = {
    ["T"] = "까마귀발톱 체액",
    ["O"] = "까마귀발톱 체액 샘플을 공동묘지에 있는 연금술사 렌퍼럴에게 가져가야 합니다.",
    ["D"] =
    "이 언데드의 몸에서 펜리스 섬에서 발견되는 썩은가죽 체액과 비슷한 짭짤한 회색 물질의 찌꺼기가 들어 있는 샘플 병을 찾았습니다. 공동묘지에 있는 연금술사 렌퍼럴이라면 이 물질에 흥미를 가질 것입니다."
  },
  [26873] = {
    ["T"] = "실종된 수련생",
    ["O"] = "호박색 농장에서 케빈 윈터를 찾아야 합니다.",
    ["D"] =
    "번거롭게 해서 죄송합니다만, $C님. 당신의 도움이 절실히 필요합니다.\n\n저는 은빛소나무 숲이 초행이라 지리를 잘 모르는데, 이곳 공동묘지에서 지식의 파수꾼 신입 단원과 만나기로 되어 있었습니다. 그런데 그가 아직 도착하지 않았습니다. 그가 여관주인에게 남긴 쪽지를 보니 우리 모임 전에 호박색 농장을 잠시 둘러보겠다고 적혀 있더군요. 여관주인은 호박색 농장이 여기서 남쪽에 있다고 했지만, 제가 그를 찾아 떠난 사이 그가 여길 도착해 버린다면 상황만 더 복잡하게 만들 것 같아서 제가 직접 나설 수가 없습니다. 혹시 그를 찾아봐 주시겠습니까? 그의 이름은 케빈 윈터입니다."
  },
  [26874] = {
    ["T"] = "실종된 수련생",
    ["O"] = "마법사 다르노를 죽이고 호박색 농장 철창 열쇠를 케빈 윈터에게 가져다주십시오.",
    ["D"] =
    "이곳엔 책임자가 한 명 있습니다 - 제 생각엔 다르노였던 것 같습니다. 그가 이 철창 열쇠를 가지고 있죠. 만약 당신이 그를 설득해 열쇠를 받아내 주실 수만 있다면, 이 철창에서 당장 나가고 싶습니다."
  },
  [26875] = {
    ["T"] = "실종된 수습생",
    ["O"] = "공동묘지로 돌아가 현자 그린혼과 대화하십시오.",
    ["D"] =
    "이 마법사들의 이야기를 엿들으니 흥미로운 사실을 몇 가지 알게 되었습니다. 그래서 공동묘지에서 현자 그린혼을 만나기 전에 처리해야 할 작은 심부름이 생겼습니다. 하지만 당신이 먼저 돌아가서 제가 곧 갈 것이라고 그녀에게 전해주시면 감사하겠습니다.",
  },
  [26876] = {
    ["T"] = "흥미로운 고서",
    ["O"] = "호박색 농장 북쪽이나 베렌의 동굴 근처에 있는 달라란 마술사에게서 낡은 고서 5권을 수집하십시오.",
    ["D"] =
    "새 수습생에게 부탁하려던 일이 있었는데 당신이 더 적합할 것 같군요.\n\n달라란의 지식 대부분은 도시와 함께 파괴되었지만, 그곳의 마법사들 중 일부가 호박색 농장으로 피신한 것 같습니다. 그들이 도시에서 가져온 낡은 고서가 있다면 몇 권 수집하고 싶습니다.\n\n그러한 지식은 얼라이언스 마법사들이 숨겨둘 것이 아니라 모든 이와 공유해야 합니다.",
  },
  [26877] = {
    ["T"] = "흥미로운 고서",
    ["O"] = "병든 피난민 4명을 처치하고 그레이메인 성벽의 피난민들에게서 길니아스 고서 5권을 수집하십시오.",
    ["D"] =
    "스컬지가 로데론을 휩쓸고 지나간 후 길니아스 생존자들이 은빛소나무 숲 남쪽 경계에 있는 그레이메인 성벽에 모였다고 들었습니다. 그들은 역병을 퍼뜨릴까 두려워 고향으로 돌아가는 것이 거부되었습니다.\n\n병든 양을 돌보는 목자처럼, 때로는 전체를 구하기 위해 도태가 필요합니다. 그들이 역병 매개체라면 질병을 더 퍼뜨리기 전에 제거하는 것이 현명할 것입니다.\n\n이 피난민들은 길니아스의 기록물을 가지고 있을지도 모르며, 그렇다면 제가 그것들을 수집하고 싶습니다.",
  },
  [26878] = {
    ["T"] = "흥미로운 고서",
    ["O"] = "은빛소나무 숲 남쪽의 버려진 집에서 \"역사 이론\"을 수집하십시오.",
    ["D"] =
    "마지막으로 찾아주셨으면 하는 고서가 한 권 있습니다, $C.\n\n이곳 경비병들에 따르면 로데론의 유명한 역사학자가 그레이메인 성벽 동쪽, 은빛소나무 숲 남쪽에 오두막을 가지고 있었다고 합니다. 그 오두막에 \"역사 이론\"의 사본이 있을지도 모릅니다. 이 책은... 뭐 당신이 그 세부 내용에 관심이 있을 거란 생각은 안 드네요. 그곳에 가서 책을 가져와 주시겠습니까?\n\n아, 경비병들이 주의를 당부했다는 걸 명심하세요. 오두막 주변 지역에서 강력한 늑대인간이 목격되었다고 합니다. 친구 몇 명과 함께 가는 것이 현명할 겁니다.",
  },
  [26879] = {
    ["T"] = "사만다 스위프트후프의 메시지",
    ["O"] = "사만다 스위프트후프의 메시지를 가시덤불 골짜기의 그롬골 주둔지에 있는 킨윌레이에게 가져가십시오.",
    ["D"] =
    "오래전 우리 타우렌은 광활한 멀고어의 평원을 달리는 코도만큼이나 빠르게 달리는 고대의 평원질주 기술을 연마했습니다. 우리 종족이 짐승을 길들이는 법을 배우게 되면서 그 관습은 버려졌지만, 아주 어릴 적부터 이 오래된 기술이 저를 불렀습니다. 저는 달리기에는 타고났고 많은 경주에서 우승했습니다.\n\n하지만 슬프게도 부상을 입었고 다시는 뛰지 못할까 봐 두렵습니다. 저는 정글에 숨겨져 있다는 소문이 도는 치료법을 찾아 가시덤불 골짜기에 왔지만, 다리를 저는 터라 길에서 멀리 벗어날 수가 없습니다.\n\n이 편지를 그롬골 주둔지에 있는 킨윌레이에게 전해주시겠습니까? 비록 치료법을 찾는 데는 실패했지만 그의 도움에 감사를 표하고 싶습니다.",
  },
  [26880] = {
    ["T"] = "사만다를 위한 연고",
    ["O"] = "가시덤불 골짜기 북동쪽 쿠르젠 주둔지에 있는 쿠르젠 사냥꾼에게서 활력을 주는 정글 연고 4개를 수집하십시오.",
    ["D"] =
    "사만다는 고귀한 영혼을 가졌지만 위험으로부터 자신을 지켜줄 빠른 속도가 없어진 탓에 자신감을 잃었습니다. 그녀의 자신감을 되찾아준다면 치료법을 계속 찾을지도 모릅니다.\n\n정글의 북동쪽 끝에 인간들이 야영지를 세웠습니다. 그곳의 쿠르젠 사냥꾼들은 자신들이 훈련시키는 전투 퓨마의 기운을 돋우기 위해 연고를 가지고 다닙니다. 이 침입자들을 처치하고 연고를 조금 가져오십시오.",
  },
  [26881] = {
    ["T"] = "사만다를 위한 연고",
    ["O"] = "가시덤불 골짜기 북쪽에 있는 안개계곡고릴라에게서 따뜻한 피가 담긴 약병 6개를 수집하십시오.",
    ["D"] =
    "북쪽 길을 따라 쿠르젠 주둔지로 가다 보면 안개계곡고릴라의 영역을 지나게 될 것입니다. 이 호전적인 짐승들의 피는 우리 연고의 또 다른 중요한 재료가 됩니다. \n\n그들을 처치하고 따뜻한 피가 담긴 약병 6개를 가져오십시오! 빨리 돌아올수록 사만다를 더 빨리 도울 수 있습니다.",
  },
  [26882] = {
    ["T"] = "사만다를 위한 연고",
    ["O"] = "그롬골 주둔지 북쪽의 검은아가미멀록 채집꾼과 검은아가미멀록 사냥꾼에게서 전력질주엉겅퀴를 수집하십시오.",
    ["D"] =
    "잠깐만요, $N! 킨윌레이가 이 연고에 대해 한 말을 우연히 들었습니다. 전 진정한 연금술사는 아니지만 재료에 대해서는 잘 아는데, 당신이 만든 것은 사만다를 구하는 게 아니라 오히려 독이 될 것입니다!\n\n이 연고를 성공적으로 완성하려면 한 가지 재료가 더 필요합니다. 마을 바로 북쪽에서 검은아가미 멀록의 둥지를 찾을 수 있을 겁니다. 그들의 채집꾼은 전력질주엉겅퀴라는 희귀한 약초에 끌립니다. 진심으로 사만다를 돕고 싶다면 그들을 처치하고 전력질주엉겅퀴를 수집해 오십시오.",
  },
  [26883] = {
    ["T"] = "사만다를 위한 연고",
    ["O"] = "가시덤불 골짜기의 큰길을 배회하는 사만다 스위프트후프에게 완성된 연고를 가져다주십시오.",
    ["D"] =
    "잠시만 기다려주십시오, $N.\n\n<앵그런이 전력질주엉겅퀴를 잘게 빻아 연고에 섞습니다.>\n\n이제 이 연고는 사만다가 사용해도 안전할 것입니다. 부디 그녀에게 가져다주십시오. 두 분 모두에게 행운이 있기를.",
  },
  [26884] = {
    ["T"] = "약탈자를 약탈하기",
    ["O"] = "붉은머리부족 지하묘지에서 달트리의 소지품 4개를 회수하십시오.",
    ["D"] =
    "우리 주위의 이 폐허가 보이십니까, $C? 제 할아버지가 정글에 집을 지으려 했던 흔적의 전부입니다. 여기서 뭐라도 건질 게 있는지 보러 내려왔죠.\n\n수십 년 전, 붉은머리부족 트롤들이 농장을 습격해서 가족 대부분을 학살했습니다. 그들은 귀중품도 모두 훔쳐갔죠. 문제는 트롤들이 죽은 자를 묻을 때 전리품의 일부를 함께 묻는다는 소문을 들었다는 겁니다. 붉은머리부족은 줄다이아 폐허 북쪽에 큰 지하묘지를 가지고 있습니다. 저는 가난한 농부일 뿐이지만, 제 가족의 도둑맞은 소지품이 있는지 그 지하묘지를 확인해 주신다면 기꺼이 보답해 드리겠습니다.",
  },
  [26885] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "가시덤불 골짜기 북서쪽의 붉은머리부족 트롤들 사이 어딘가에서 현자 이츨리의 친구 투텍을 찾으십시오.",
    ["D"] =
    "이봐 형제, 도움이 절실하게 필요해.\n\n우리 공동의 역사를 기록하는 걸 돕기 위해 다른 정글 부족들에게 연락을 취하려고 시도 중이었고, 마침내 백골가루부족 트롤과 친구가 됐어. 그는 그롬골 주둔지 밖 길에서 날 만나기로 되어 있었는데 나타나지 않았어.\n\n그러는 동안 백골가루부족 전투 부대가 붉은머리부족을 습격했다가 패배했다는 보고가 들어왔지. 킨윌레이는 내 친구의 영혼이 영혼의 세계에 없다고 했어. 그러니 틀림없이 붉은머리부족의 포로가 된 걸 거야.\n\n부디 그를 찾아줘, $C. 그리고 그에게 어떤 도움이 필요한지 알아봐 줘. 그의 이름은 투텍이야.",
  },
  [26886] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "그롬골 주둔지에 있는 현자 이츨리에게 투텍의 영혼 부적을 가지고 돌아가십시오.",
    ["D"] =
    "내 부족, 백골가루부족은 완전히 패배했어. 전사하는 대신 포로가 되었지. 난 혈신에게 제물로 바쳐질 거야. 우리가 이겼더라도 패배자들에게 똑같이 했을 테니 다를 건 없어.\n\n난 부족의 명예를 위해 죽을 거야. 네 도움은 필요 없어, $R. 하지만 내 우정의 징표로 이 부적을 이츨리에게 가져가 줘.",
  },
  [26887] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "가시덤불 골짜기 그롬골 주둔지에 있는 현자 이츨리를 위해 야생덩굴 6개, 커다란 뾰족송곳니 4개, 붉은머리부족 주술사의 정수를 수집하십시오.",
    ["D"] =
    "혈신은 죽었어, $C. 투텍은 개죽음을 당하는 거야. 하지만 그가 부족의 명예를 지키면서 나를 계속 돕도록 만들 수 있는 오래된 방법이 하나 있지.\n\n먼저 재료를 모아야 해. 이 계곡 전역에 자생하는 야생덩굴이 좀 필요해. 다음은 커다란 뾰족송곳니야 - 랩터나 호랑이를 노려봐. 마지막으로 붉은머리부족 주술사의 정수가 필요해. 여기서 북쪽 해변에 있는 발랄 폐허에서 찾을 수 있을 거야.",
  },
  [26888] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "발랄, 트카시, 줄다이아, 칼아이 폐허를 수색하여 피의 화로를 찾고 그롬골 주둔지에 있는 현자 이츨리에게 가져가십시오.",
    ["D"] =
    "이제 재료가 모였으니, 붉은머리부족 폐허에서 다른 걸 가져와 줘야겠어. 피의 화로 말이야.\n\n우리 트롤들은 수만 년 동안 존재해 왔고 버려진 옛 방식이 한두 가지가 아니지. 학카르가 패배하기 전부터 정글 트롤들은 피의 화로 사용을 중단했어. 하지만 그들이 아직 화로를 보관하고 있다는 건 알아.\n\n여기서 북쪽 해변과 정글에 있는 발랄, 트카시, 줄다이아, 칼아이의 붉은머리부족 폐허를 방문해 피의 화로를 찾아. 어디에든 있을 수 있어.",
  },
  [26889] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "줄맘웨 폐허의 지하묘지로 현자 이츨리의 물품을 가져가십시오.",
    ["D"] =
    "북서쪽 해안의 줄다이아 폐허 북쪽에는 붉은머리부족이 존경하는 전사자들을 모시는 지하묘지가 있어. 네가 가져온 재료로 특별한 향을 만들었지. 이 화로와 투텍의 부적, 그리고 정수를 지하묘지로 가져가. 중앙 방에서 정수에 불을 붙여.\n\n투텍의 몸은 붉은머리부족에게 남아있겠지만, 그의 영혼은 나타날 거야.\n\n왜? 아예 친구가 없는 것보단 영혼 친구라도 있는 게 낫잖아, 안 그래?",
  },
  [26890] = {
    ["T"] = "내 친구, 백골가루부족",
    ["O"] = "의식을 완료한 후, 그롬골 주둔지에 있는 현자 이츨리에게 돌아가십시오.",
    ["D"] =
    "당신은 다음에 무슨 일이 일어날지 모른 채 향에 불을 붙입니다. 분명 붉은머리부족은 이 의식을 달가워하지 않을 것입니다.",
  },
  [26891] = {
    ["T"] = "모래톱 약탈하기",
    ["O"] = "비열한 모래톱 내의 가라앉은 배에서 물에 젖은 무기 10개를 수집하십시오.",
    ["D"] =
    "그롬골 주둔지 주변 해역은 비열한 모래톱으로 알려져 있습니다. 위험한 해역이지만, 한때 무법항에서 스톰윈드로 물건을 밀반입해 한몫 챙기려는 밀수업자들의 통로이기도 했죠. 하지만 바다는 잔인한 여주인과 같아서 모두가 무사히 빠져나간 것은 아닙니다.\n\n이곳 바다 밑바닥에는 각종 난파선들이 흩어져 있고, 그 안에는 제가 호드를 위해 녹여 새롭게 벼려낼 수 있는 무기들이 있습니다. 이 무기 10개를 가져와 우리 병사들을 무장시킬 수 있게 해주십시오.",
  },
  [26892] = {
    ["T"] = "야수 동맹",
    ["O"] = "안개계곡에서 안개계곡 밀렵꾼 8명을 찾아 제거하십시오.",
    ["D"] =
    "달의 숲에서 자랄 때 어머니는 안개계곡 고릴라 이야기를 들려주셨어요. 그녀가 돌아가셨을 때, 저는 그들을 보러 와야만 한다고 느꼈죠. 그리고 여기서 발견한 것은 말로 다 표현할 수 없을 정도로 충격적이었습니다.\n\n한때 흔했던 이 짐승들이 멸종 위기에 처할 정도로 밀렵당하고 있었어요! 고기나 방한용 모피를 위해서가 아니라, 단순한 오락거리로 말이에요!\n\n아래 계곡에 있는 밀렵꾼들을 사냥하고, 이 배후에 누가 있는지 알아내도록 도와주세요.\n\n이 위대한 유인원들에게 당신이 필요합니다, $N.",
  },
  [26893] = {
    ["T"] = "야수 동맹",
    ["O"] = "가시덤불 골짜기 동쪽 해안에서 밀렵꾼 우두머리를 찾아 배후의 구매자에 대한 증거를 더 찾아내십시오.",
    ["D"] =
    "섬? 거물 구매자? 우두머리? 이 모든 게 너무 벅차군요! 다시 당신의 도움이 필요합니다, $N. 동쪽 해안을 따라 이 야영지를 추적하여 당신만의 사냥을 조금 더 해주십시오. 이 W.P.라는 자들이 무슨 변명을 하는지 보고, 그들의 구매자에 대해 더 알아내십시오. 우리는 이 나무를 뿌리째 뽑아버려야 합니다.",
  },
  [26894] = {
    ["T"] = "야수 동맹",
    ["O"] = "무법항에서 시디스 파인트스나이프를 매복 공격하십시오.",
    ["D"] =
    "드디어 두목의 이름과 그가 있는 곳을 알아냈습니다: 무법항이군요. 전혀 놀랍지 않아요. 자, 이 호루라기를 가져가서 그를 찾으십시오. 그를 찾으면 호루라기를 부세요. 그러면 제 친구들이 그 탐욕스러운 모피 상인에게 복수하러 갈 것입니다.",
  },
  [26895] = {
    ["T"] = "힘의 투기장: 부러진 뿔",
    ["O"] = "부러진 뿔을 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "첫 전투를 치를 준비가 되셨습니까? 준비가 끝났다면 알려주십시오. 바로 시작하도록 하죠. 당신은 힘의 투기장에서 상대가 도착하기를 기다리기만 하면 됩니다.\n\n이번 상대는 부러진 뿔이라는 사나운 코도입니다.\n\n행운을 빕니다! 친구들을 데려오셨기를 바랍니다.\n\n그리고 명심하십시오, 이 전투는 당신이나 상대 중 한 명이 투기장 바닥에 쓰러져야만 끝납니다.",
  },
  [26896] = {
    ["T"] = "힘의 투기장: 쌍둥이",
    ["O"] = "나가 쌍둥이를 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "이번 전투는 이인조 - 정확히 말하면 쌍둥이 자매입니다.\n\n지금 겁먹고 도망쳐도 늦지 않았습니다, $n. 충분히 이해할 수 있으니까요.\n\n하지만 전투할 준비가 되셨다면 힘의 투기장으로 들어가 쌍둥이가 오기를 기다리십시오.\n\n최후에 살아남는 자가 승자입니다!",
  },
  [26897] = {
    ["T"] = "힘의 투기장: 돌눈길",
    ["O"] = "돌눈길을 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "아주 잘 싸워주고 있소, 애송이. 하지만 오우거들이 다음 시합을 위해 대타를 준비했지. 바실리스크인가 뭔가 하는 괴물이라더군.... 자기네 챔피언과 당신이 싸우게 두지 않으려는 속셈이지. 베팅 금액이 천정부지로 치솟고 있어!\n\n투기장에 들어가서 이 녀석을 빨리 해치워버리라고!",
  },
  [26898] = {
    ["T"] = "힘의 투기장: 윈스턴",
    ["O"] = "윈스턴을 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "이번 싸움은 꽤 고통스러울 거요, $n. 당신을 도와줄 만큼 용감한 친구들이 있소? 우리는 윈스턴이라는 거대한 유인원을 데려왔지! 내 말 명심하시오, 이건 정말 이길 수 없을 것처럼 보이니 친구들이 꼭 필요할 거요! 이 녀석은 바위처럼 단단하다고!\n\n그래도 싸우고 싶다면, 힘의 투기장으로 들어가 그가 오기를 기다리시오.",
  },
  [26899] = {
    ["T"] = "힘의 투기장: 데케드",
    ["O"] = "투기장 챔피언을 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "놈들이 줄아만의 검투사 구덩이에서 챔피언을 데려왔어. 산악 거인을 상대로 훈련받은 놈인데 - 한 번에 세 마리씩 상대했다고 하더군.\n\n이번 시합에서 이기면 네가 새로운 챔피언이 되는 거야. 네 승산이 어느 정도라고 생각하나, 꼬맹이? 해볼 만한가? 네가 하겠다고만 하면 내 전 재산을 네게 걸겠어.\n\n자, 들어가서 이겨버려!",
  },
  [26900] = {
    ["T"] = "힘의 투기장: 마지막 도전",
    ["O"] = "전쟁군주 루르그를 처치하십시오. 승리하면 하수인 운자에게 말을 걸어 보상을 받으십시오.",
    ["D"] =
    "<픽은 엄청난 양의 금화를 세고 있습니다.>\n\n네 덕에 돈을 많이 벌었어, 꼬맹이. 루르그를 이길 수 있다면 네 수고에 대한 충분한 보답을 약속하지. 힘의 투기장에서 겪은 모든 고통이 보상받을 거야.\n\n자, 이제 들어가서 네 진가를 보여줘!",
  },
  [26901] = {
    ["T"] = "상어 지느러미 수프",
    ["O"] = "비열한 모래톱 안에 있는 비열한 상어들에게서 온전한 상어 지느러미 8개를 수집하십시오.",
    ["D"] =
    "이곳 현지인들은 상어 지느러미 수프라는 것을 엄청나게 좋아한다고 합니다. 만드는 과정이 꽤 번거롭긴 하지만 그 결과물은 육체 건강에 매우 좋다고 하더군요.\n\n산호초 쪽으로 가서 상어들의 지느러미를 제게 가져와 주십시오. 그럼 제가 수프를 만들어 보겠습니다.",
  },
  [26902] = {
    ["T"] = "머리 축소 막기",
    ["O"] = "줄쿤다 폐허에 있는 붉은머리부족 트롤들에게서 얼라이언스 모험가 8명을 풀어주십시오.",
    ["D"] =
    "이곳 남서쪽에서 가시덤불 골짜기 전역에 축소된 머리를 만드는 기술로 악명 높은 줄쿤다의 붉은머리부족 트롤들을 찾을 수 있을 겁니다. 하지만 누구도 누구의 머리가 축소되고 있는지에 대해서는 이야기하지 않더군요!\n\n그들은 가시덤불 골짜기 곳곳에서 모험가들을 잡아 의술사들에게 데려가고 있었습니다. 제발 모험가들이 붉은머리부족 트롤의 목에 매달리는 신세가 되기 전에 갇혀 있는 곳에서 풀어주십시오.",
  },
  [26903] = {
    ["T"] = "머리 축소 막기",
    ["O"] = "줄쿤다 폐허에 있는 붉은머리부족 트롤들에게서 호드 모험가 8명을 풀어주십시오.",
    ["D"] =
    "이곳 북서쪽에서 가시덤불 골짜기 전역에 축소된 머리를 만드는 기술로 악명 높은 줄쿤다의 붉은머리부족 트롤들을 찾을 수 있을 겁니다. 하지만 누구도 누구의 머리가 축소되고 있는지에 대해서는 이야기하지 않더군요!\n\n그들은 가시덤불 골짜기 곳곳에서 모험가들을 잡아 의술사들에게 데려가고 있었습니다. 제발 모험가들이 붉은머리부족 트롤의 목에 매달리는 신세가 되기 전에 갇혀 있는 곳에서 풀어주십시오.",
  },
  [26904] = {
    ["T"] = "엉성한 헬멧",
    ["O"] = "실험용 정신 지배 헬멧을 조잡하게나마 이해할 수 있는 무법항의 누군가에게 가져가십시오.",
    ["D"] =
    "낡은 금속 헬멧에 철사, 안테나, 그리고 왠지 모를 스프링이 덕지덕지 조잡하게 붙어있는 것을 발견했습니다.\n\n이것을 무법항의 재능 있는 기계공학자에게 가져가면 그가 어떻게 해야 할지 알지 않을까요?",
  },
  [26905] = {
    ["T"] = "엉성한 헬멧",
    ["O"] = "무법항 북쪽의 덩치 큰 안개계곡고릴라 8마리에게 실험용 정신 지배 헬멧을 시험하십시오.",
    ["D"] =
    "이런, 이런... 이거 참 독특한 물건이군요. 이건 투자개발회사가 정신 지배 헬멧을 만들기 위해 시도한 것이 분명합니다. 제가 본 최악의 시도이면서 동시에 어쩐지 기발한 점도 있네요.\n\n전 이거 절대 안 써볼 겁니다. 그리고 당신도 저한테 이걸 조준하게 내버려두진 않을 테니, 이걸 들고 무법항 북쪽에 있는 덩치 큰 안개계곡 고릴라들에게 가서 한번 시도해 보십시오.\n\n어떤 성능을 내는지 제게 보고해 주십시오.",
  },
  [26906] = {
    ["T"] = "줄다이아 석판",
    ["O"] = "줄다이아 석판을 무법항에 있는 크랭크 피즐버브에게 가져가십시오.",
    ["D"] =
    "어째서인지 요즘 트롤의 역사에 대해 알아내는 게 대유행이란 말이죠. 그 말은 즉, 거기서 돈을 벌 수 있다는 겁니다!\n\n줄다이아 폐허 북쪽에 붉은머리부족 트롤들의 지하묘지가 있습니다. 그 안에 줄다이아의 역사를 담은 석판이 있을 겁니다. 관심 있어 하는 구매자가 있으니, 그걸 구해온다면 수익금의 일부를 떼어 드리겠습니다.",
  },
  [26907] = {
    ["T"] = "야생 튤립",
    ["O"] = "튤립의 일기장을 이용해 그녀의 추억 상자를 찾으십시오.",
    ["D"] =
    "저는 제 절친한 친구 튤립과 달리 해적이 아닙니다. 그녀는 대단해요! 한 번은 밧줄을 이빨로 한 번에 물어 끊는 것도 봤다니까요. 정말 사납죠! 약혼자 다니엘과 함께 있을 때만 빼고요....\n\n다니엘과 그녀는 약혼했고, 둘이 어떻게 만나 사랑에 빠졌는지에 대한 이야기가 잔뜩 적힌 이 아름다운 일기장을 그녀가 제게 보내왔습니다. 심지어 결혼식 주례까지 부탁했죠. 정말 영광스러운 일입니다.\n\n하지만... 보시다시피... 결혼식은 3일 전에 열릴 예정이었지만, 그들은 나타나지 않았고 전 계속 걱정하고 있습니다.\n\n튤립이 일기장에 소중한 기념품들을 묻었다고 적었더군요. 그들의 추억 상자를 찾아서 단서가 될 만한 걸 제게 가져와 주시겠어요?",
  },
  [26908] = {
    ["T"] = "야생 튤립",
    ["O"] = "튤립의 일기장을 이용해 묻혀 있는 기념품을 찾고 그녀가 있는 곳을 알아내십시오.",
    ["D"] =
    "뭔가 더 있을 거라 기대했는데, 그들이 소중하게 여기는 추억에 대한 묘사만 들어있는 것 같군요.\n\n이것들을 당신이 사용할 수 있도록 일기장에 첨부해 드리겠습니다. 제가 보기엔 다른 두 곳에 중요한 기념품을 남긴 것 같습니다. 어쩌면 그게 튤립을 추적하는 데 도움이 되지 않을까요?",
  },
  [26909] = {
    ["T"] = "야생 튤립",
    ["O"] = "마력 깃든 나침반을 이용해 튤립과 다니엘을 찾으십시오.",
    ["D"] =
    "자... 이 나침반이 튤립과 다니엘이 있는 곳으로 당신을 인도할 것입니다. 무슨 수를 써서라도 그들을 무사히 집으로 데려와서, 마침내 결혼식을 올릴 수 있게 해주세요!\n\n튤립의 기억이 가장 강력하니 나침반이 당신을 그녀에게 먼저 인도할 것이고, 그 다음 다니엘에게로 인도할 것입니다. 그들을 무사히 제게 데려와 주세요, $n!",
  },
  [26910] = {
    ["T"] = "야생 튤립",
    ["O"] = "마력 깃든 나침반을 이용해 다니엘을 찾으십시오.",
    ["D"] =
    "언제나 너였어, 다니엘.\n\n테우타가 널 내게서 빼앗으려 우리를 쫓아왔지. 난 정말 너무 화가 났어! 너에게 닿아야 한다는 생각밖에 없어서 베고 찌르고 썰었어. 만약 내가 조금만 더 주의를 기울였다면 내 뒤에 있던 그녀의 기척을 들었을지도 몰라.\n\n내 펜던트가 내 손안에서 빛나고 있어. 얼음처럼 차갑고 산보다 무겁게 느껴져. 죽음이 뭔지는 알지만 이건 죽음과는 달라. 오늘이 우리 결혼식이어야 했는데. 날 용서해 줄래?\n\n다니엘, 제발 무사히 도망쳐. 널 사...",
  },
  [26911] = {
    ["T"] = "야생 튤립",
    ["O"] = "켈 문우드의 의식을 목격하십시오.",
    ["D"] =
    "당신이 절 위해 해준 모든 일에 감사드립니다만, 지금부터 일어나는 일에는 절대 간섭하시면 안 됩니다.\n\n제가 시도할 수 있는 마지막 의식이 하나 있습니다만, 엘룬께서 금지하신 것입니다. 왜냐하면... 그 고통을 견딜 수 있는 자가 거의 없기 때문이죠. 하지만 제가 살아남지 못하더라도... 튤립은요? 음... 그녀라도 저를 위해 똑같이 했을 테니까요.",
  },
  [26912] = {
    ["T"] = "맹독 치료제",
    ["O"] = "맹독타란툴라의 독이 든 약병 8개를 수집하여 스토나드의 툴타조르에게 돌아가십시오.",
    ["D"] =
    "제가 두목의 심기를 건드렸는지, 오크들이 스토나드라고 부르는 이 악취 나는 시골 구석으로 저를 보냈습니다! 그들은 이 지역의 빌어먹을 야생동물 문제를 해결할 연금술사가 필요했던 모양입니다. 그게 바로 당신이 필요한 이유입니다.\n\n최근 이곳 남동쪽 지역에서 거대한 거미 둥지가 부화했습니다. 독에 쏘이는 심각한 사건이 몇 번 있었기에 그들에게 물렸을 때 사용할 치료제를 개발하기 위해 그 거미들의 독을 조사하고 싶습니다. 전 전투원이 아닙니다, $N. 제가 필요한 독을 가져다주시겠습니까?",
  },
  [26913] = {
    ["T"] = "오크니르의 소중한 낚시대",
    ["O"] = "오레보르 피난처 남쪽의 낚싯배에서 오크니르가 버려두고 온 낚시대를 수집하십시오.",
    ["D"] =
    "얼마 전, 아주 친절한 인간이 이곳을 지나가다가 우리의 작은 카약보다 이론적으로 훨씬 안정적인 낚싯배를 만드는 법을 가르쳐주었습니다. 며칠 동안 수고한 끝에 그 인간과 저는 마침내 배를 몰고 나갔죠. 믿으실 수 있겠습니까? 악어가 이 빌어먹을 배를 물어뜯었고, 배가 가라앉기 시작했습니다! 우리는 간신히 살아서 돌아왔죠!\n\n우리는 이곳 남쪽에 배를 버렸는데, 정신을 차려보니 그 인간이 내 특별히 닦아둔 낚시대를 찾도록 도와주지도 않고 마을을 떠나버렸습니다! 절 위해 그 배를 찾아서 제 낚시대들을 회수해 주실 수 있습니까?",
  },
  [26914] = {
    ["T"] = "오크니르의 소중한 낚시대",
    ["O"] = "오레보르 피난처 동쪽의 드레노어 난민 낚시꾼에게서 온전하고 윤나는 낚시대를 하나 수집하십시오.",
    ["D"] =
    "이봐요, 여긴 늪지대입니다. 이 부근에서 낚시하는 사람이 별로 없으니, 제 낚시대를 가져갔을 만한 자들은 동쪽에 있는 드레노어 난민들뿐일 겁니다. 그들 무리 중 조잡한 낚시꾼들이 있는데 그중 한 명이 제 낚시대를 가지고 있을 거라고 확신합니다. 드레노어 난민들을 조사해서 낚시대를 제게 찾아주실 수 있습니까?",
  },
  [26915] = {
    ["T"] = "늪지대의 공포",
    ["O"] = "덩굴늪괴물 10마리와 덩치 큰 늪괴물 3마리를 처치하고 스토나드의 준다르사에게 돌아가십시오.",
    ["D"] =
    "북서쪽에는 한때 아름답고 우거진 생명체들의 보금자리였던 안개 계곡이 있습니다. 최근에 정령의 공포가 이 계곡을 뒤덮어 버렸죠.\n\n얼라이언스는 스토나드를 공격하기 위한 전초기지로 이 계곡을 사용할 수 있기 때문에, 이 지역을 우리가 통제하는 것이 가장 좋습니다. 안개 계곡으로 가서 정령들을 정화하십시오, $N. 스토나드를 위하여!",
  },
  [26916] = {
    ["T"] = "카라보르 스튜",
    ["O"] = "슬픔의 늪 동쪽 해안을 따라 서식하는 늪지게에게서 거대한 게 집게발 10개를 수집하십시오.",
    ["D"] =
    "먹여 살려야 할 입이 너무 많아서 카라보르 스튜를 제대로 끓여 낼 여력이 없습니다. 충분히 많이 만들 수만 있다면 사람들을 며칠 동안 든든하게 먹일 수 있죠. 제게 재료를 구해주시겠습니까? 동쪽 해안가를 따라가면 늪지게를 찾을 수 있습니다. 그것들에게서 가장 크고 즙이 많은 집게발을 구해주십시오.",

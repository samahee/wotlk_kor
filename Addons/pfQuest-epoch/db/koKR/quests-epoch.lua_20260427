  },
  [26409] = {
    ["T"] = "사냥꾼의 길",
    ["O"] = "골드샤이어의 제임스 코베트와 대화하십시오.",
    ["D"] =
    "안녕하신가, 젊은 사냥꾼이여. 자네는 짐승을 다루고 동반자로 훈련시킬 만큼 솜씨가 뛰어나 보이는군.\n\n골드샤이어에 있는 제임스 코베트를 찾아가 보게. 그가 자네만의 야수를 길들이는 길로 이끌어 줄 걸세.",
  },
  [26410] = {
    ["T"] = "야수 길들이기",
    ["O"] = "야수 조련 막대를 사용하여 돌가죽멧돼지를 길들이십시오. 당신의 기술을 연습한 다음, 골드샤이어에 있는 제임스 코베트에게 야수 조련 막대를 돌려주십시오.",
    ["D"] =
    "이보게, $G소년:소녀;! 그래, 자네만의 야수를 얻으려면 어떻게 해야 하는지 알고 싶은가?\n\n음, 자네가 아주 흥미로워할 만한 것에 집중해보자고: 바로 야수 말일세!\n\n가장 좋은 학습 방법은 여러 동물을 동반자로 시험해보고 마음에 드는 것을 찾는 거지. 그러니 돌가죽멧돼지를 찾아 야수 조련 막대를 사용해 길들여 보게나.",
  },
  [26411] = {
    ["T"] = "야수 길들이기",
    ["O"] = "야수 조련 막대를 사용하여 굶주린 늑대를 길들이십시오. 당신의 기술을 연습한 다음, 골드샤이어에 있는 제임스 코베트에게 야수 조련 막대를 돌려주십시오.",
    ["D"] =
    "돌가죽멧돼지는 꽤 건장하지만, 조금 더 기교가 있는 짐승을 원하나? 좋네, 안성맞춤인 녀석이 있지. 여기서 동쪽으로 가면 굶주린 늑대라는 커다란 늑대들을 볼 수 있을 거네. 우아하게 조각된 활처럼, 그 아름다운 겉모습 뒤에는 강력한 전사가 숨어 있어 엄청난 피해를 입힐 수 있지. 자네가 길들였던 멧돼지보다 훨씬 민첩하고 빠를 거야.\n\n이 야수 조련 막대를 가져가서 굶주린 늑대가 마음에 드는지 확인해 보게나.",
  },
  [26412] = {
    ["T"] = "야수 길들이기",
    ["O"] = "야수 조련 막대를 사용하여 새끼곰을 길들이십시오. 당신의 기술을 연습한 다음, 골드샤이어에 있는 제임스 코베트에게 야수 조련 막대를 돌려주십시오.",
    ["D"] =
    "단순한 무식한 힘 이상의 것을 가진 생물을 원할지도 모르겠군. 새끼곰은 자네 같은 풋내기 사냥꾼에게 훌륭한 동반자이며, 골드샤이어 동쪽에서 찾을 수 있지. 여기 조련 막대가 있네. 이 동물을 야수로 시험해보고 마음에 드는지 확인해 보게!\n\n돌아오면 원하는 동물을 길들이는 데 필요한 기술을 알려주겠네. 이 동물은 자네가 겪는 시련을 함께 마주하며 자네 곁에서 경험을 쌓게 될 거네. 또한 원할 때 야수를 부르고 해제하는 방법도 알려주지.",
  },
  [26413] = {
    ["T"] = "야수 훈련",
    ["O"] = "스톰윈드의 하위 힐과 대화하십시오.",
    ["D"] =
    "$N, 이제 야수를 길들일 수 있게 되었지만, 야수를 훈련시킬 기술도 익혀야 하네.\n\n스톰윈드로 이동하여 드워프 지구를 찾게. 그곳에서 우리의 가장 존경받는 동물 조련사 중 한 명인 하위 힐과 이야기해야 하네. 그가 새로운 야수를 훈련시킬 수 있는 능력을 자네에게 줄 것이니 어서 가게, $G소년:소녀;!\n\n하위는 다정한 성격이라서 그의 인정을 받는 데 큰 어려움은 없을 걸세. 행운을 비네, $N.",
  },
  [26414] = {
    ["T"] = "너덜너덜한 편지",
    ["O"] = "너덜너덜한 편지를 읽고 북넉샤이어 수도원의 세세 허버트와 대화하십시오.",
    ["D"] =
    "당신이 코볼트 야영지에서 돌아오자마자 이 편지를 보여달라는 부탁을 받았습니다, $N. 마을의 사냥꾼 전문가인 세세가 보낸 편지 같더군요. 북넉샤이어 수도원 안에서 다른 볼일을 보기 전에 주저 말고 이 편지부터 읽어보세요.",
  },
  [26415] = {
    ["T"] = "문양 룬",
    ["O"] = "앤빌마 내부의 마렉 스톰누르와 대화하십시오.",
    ["D"] =
    "당신이 절 도와주는 동안 이 룬을 당신에게 전해달라고 받았소. 시간 날 때 읽어보시오. 아마도 마법사 전문가 마렉이 보낸 것 같소. 한 번 훑어보고 시간이 될 때 앤빌마 안에 있는 그를 찾아가 보시오.",
  },
  [26416] = {
    ["T"] = "테라모어로 가는 관문",
    ["O"] = "저주받은 땅의 새 어둠의 문 근처에서 첫 번째 어둠의 문 파편 3개를 수집한 다음, 테라모어의 여군주 제이나 프라우드무어에게 돌아가십시오.",
    ["D"] =
    "다시 만나 반갑군요, $N. 제가 있는 이 도시가 때때로 순간이동하기에 꽤 유용한 장소였길 바랍니다. 그렇다면 차원의 문을 직접 만들어 보는 건 어떤가요? 이번 임무는 훨씬 더 어렵지만, 주문을 배우는 것 이상의 보상을 준비해 두었습니다.\n\n먼저, 저주받은 땅의 어둠의 문으로 여행해야 합니다. 그 저주받은 문은 오크의 고향인 드레노어로 가는 입구지만, 사실 그것은 두 번째 어둠의 문입니다. 원래 있던 문은 2차 대전쟁 당시 오크의 침략을 막기 위한 대마법사 카드가의 시도로 파괴되었죠. 새 문 근처에서 파괴된 문의 파편을 찾을 수 있을 겁니다. 저를 위해 작은 파편 세 개를 모아 오시면 임무를 계속할 수 있습니다.",
  },
  [26417] = {
    ["T"] = "테라모어로 가는 관문",
    ["O"] = "운고로 분화구 주변에서 녹색 마력의 수정 5개를 수집한 다음, 테라모어의 여군주 제이나 프라우드무어에게 돌아가십시오.",
    ["D"] =
    "잘하셨어요. 이 파편들은 당신의 왕관을 만드는 데 완벽하게 들어맞겠--\n\n<여군주 제이나 프라우드무어가 헛기침을 합니다.>\n\n비밀로 하려던 걸 깜빡할 뻔했네요! 다음으로, 우리는 운고로 분화구에서 녹색 마력의 수정 5개가 필요합니다. 그 일대에 널려 있을 거예요. 그곳에 가본 적이 없다면 타나리스 남서쪽에서 내려가는 길을 찾을 수 있을 겁니다. 아니면 저속 낙하 마법을 걸고 분화구로 뛰어내리는 게 훨씬 더 재미있을 수도 있겠네요!",
  },
  [26418] = {
    ["T"] = "테라모어로 가는 관문",
    ["O"] = "검은바위 나락으로 들어가 일곱 현자를 물리치고 세스렐의 고서를 획득한 후, 테라모어에 있는 여군주 제이나 프라우드무어에게 돌아가십시오.",
    ["D"] =
    "자, 이제 이 여행의 목적을 밝힐 때군요! 당신에게 테라모어 차원의 문을 여는 법을 가르쳐 주는 것 외에도, 저는 당신에게 머리 장식, 일종의 왕관을 선물할 생각입니다. 당신이 대부분의 재료를 모아야 했으니 대단한 선물이라고 할 수는 없겠지만, 제가 지금 재료가 부족해서 어쩔 수 없었답니다! 얼마 전 이 왕관에 대한 아이디어가 떠올랐는데, 황천의 기운이 닿은 돌을 이용해 으깬 마력의 수정으로 힘을 부여하는 것이죠. 잘 완성되면 좋겠네요!\n\n하지만 아직 한 가지 재료가 더 필요합니다. 이런 돌들을 결속시키는 것은 널리 알려진 지식이 아니지만, 한때 어둠괴철로단 도시 -- 즉 검은바위 나락 -- 에 살았던 세스렐이라는 강력한 마법사가 쓴 책에 상세한 설명이 있다고 읽었습니다. 만약 당신이 그곳으로 모험을 떠나 그 고서를 회수해 온다면, 이 왕관을 완성할 수 있을 것입니다.",
  },
  [26419] = {
    ["T"] = "스토나드로 가는 관문",
    ["O"] = "저주받은 땅의 새로운 어둠의 문 근처에서 첫 번째 어둠의 문 파편 3개를 수집한 다음, 스토나드의 로린 폭스파이어에게 돌아가십시오.",
    ["D"] =
    "아, $C! 당신을 만나서 반갑소. 내 제안이 하나 있소. 당신이 그저 스토나드로 순간이동만 하는 것보다, 동료들을 위해 차원의 문을 만들어 주는 것은 어떻소? 나를 도와 무언가 만드는 작업만 도와주면 되오. 내 이론대로 모든 것이 잘 진행된다면, 그 물건은 당신이 가지게 해 주겠소.\n\n이 제안이 괜찮게 들린다면, 여기서 남쪽으로 저주받은 땅으로 가서 현재 어둠의 문 근처 땅바닥에 흩어진 원래 어둠의 문 파편을 몇 개 주워 주시오. 죽고 싶은 게 아니라면 차원의 문에 너무 가까이 다가가지는 마시오.",
  },
  [26420] = {
    ["T"] = "스토나드로 가는 관문",
    ["O"] = "운고로 분화구 주변에서 녹색 마력의 수정 5개를 수집한 다음, 스토나드에 있는 로린 폭스파이어에게 돌아가십시오.",
    ["D"] =
    "당신의 다음 임무는 조금 더 멀리, 저 먼 칼림도어에서 진행되오. 운고로 분화구로 여행을 가서 녹색 마력의 수정 5개를 모아 오시오. 분화구 전체에 마력의 수정이 흩어져 있으니 어디서든 찾을 수 있을 거요. 이 수정들은 아직 잘 알려지지 않아서, 그것이 바로 내가 당신에게 이 일을 시키는 주요 이유요. 만약 한 번도 가본 적이 없다면 타나리스 남서쪽에서 분화구로 내려가는 길을 찾을 수 있을 거요. 또는 만약 당신이 무모한 성격이라면, 그저 저속 낙하 주문을 걸고 분화구로 뛰어내려도 무방하오.\n\n괴물들에게 잡아먹히지 않도록 조심하시오.",
  },
  [26421] = {
    ["T"] = "스토나드로 가는 관문",
    ["O"] = "검은바위 나락으로 진입하여 일곱 현자를 무찌르고 세스렐의 고서를 획득한 후, 스토나드에 있는 로린 폭스파이어에게 돌아가십시오.",
    ["D"] =
    "엄청난 황천의 마력과 으깬 마력의 수정이 스며든 이 돌들을 사용하여, 나는 당신이 쓸 수 있는 일종의 왕관을 만들길 원하오. 만약 이것이 제대로 작동한다면 당신에게 주려는 이유는 내가 딱히 이것을 사용할 일이 없기 때문이오. 나는 그저 내 이론이 맞는지 확인하고 싶을 뿐이오. 당신 같은 모험가라면 아주 유용하게 쓸 수 있을 거요. 정 원한다면 버려도 상관없소.\n\n하지만 마지막 구성 요소가 하나 더 필요하오. 내게 많은 재주가 있지만, 유감스럽게도 돌을 결속하는 것은 그중 하나가 아니오. 나는 한때 어둠괴철로단 도시에 살았던 세스렐이라는 드워프 마법사를 알고 있소. 혹시 모를까 봐 말하지만, 그곳은 검은바위 나락에 있소. 세스렐은 내가 필요로 하는 정보가 담긴 고서를 소유하고 있소. 만약 당신이 그곳으로 가서 그 고서를 되찾아 온다면, 우리는 이 왕관을 완성할 수 있을 거요.",
  },
  [26422] = {
    ["T"] = "음식 창조의 의식",
    ["O"] = "스칼로맨스에서 잔다이스 바로브를 처치하고, 베소르 아이스샤드의 비전 다과에 대한 노트를 되찾으십시오.",
    ["D"] =
    "안녕하시오 $N. 사적인 부탁을 하나 해도 되겠소?\n 3차 대전쟁이 일어나기 오래전, 나는 상당한 재능을 지닌 요술사 잔다이스 바로브와 개인적으로 가까운 사이였소. 스컬지 군대가 로데론에 강림했을 때, 내 개인 소지품 중 일부가 잔다이스의 손에 남겨지게 되었소. 우리가 헤어지게 된 상황을 생각하면, 나는 그녀의 분노와 다시 마주하고 싶지 않소.\n 하지만 비전 마법에 대한 당신의 숙달은 나와 맞먹으니 당신이라면 그녀와 정면으로 맞설 수 있으리라 믿소. 기꺼이 그녀에게서 내 비전 다과에 대한 노트를 되찾아 준다면, 그 노트의 내용을 당신과 함께 기쁘게 나누겠소. 아마 음식 창조의 의식이 상당한 시간을 절약해 준다는 것을 알게 될 거요!\n 당신과 당신의 동료들은 서부 역병지대의 스칼로맨스 지하실에서 자니스 바로브를 찾을 수 있소.",
  },
  [26423] = {
    ["T"] = "음식 창조의 의식",
    ["O"] = "언더시티 마법 지구에 있는 베소르 아이스샤드와 대화하십시오.",
    ["D"] =
    "반갑소, $N. 수련을 통해 꽤 강해진 것 같군. 이제 내가 더 가르쳐 줄 것이 많이 남아있지 않은 것 같소. 당신도 동료들을 위해 음식과 음료를 소환하는 일에 지쳤을 테지, 그렇지 않소? 내 생각이 맞다면 스톰윈드의 고위마술사 안드로매스와 대화해 보는 게 좋겠소. 그가 더 나은 방법을 알고 있을 것이오.",
  },
  [26424] = {
    ["T"] = "테라모어를 위한 눈",
    ["O"] = "동부 왕국의 슬픔의 늪 해안가를 따라 서식하는 늪지게에게서 늪지게 눈 14개를 구한 후, 테라모어의 여군주 제이나 프라우드무어에게 돌아가십시오.",
    ["D"] =
    "아, 안녕 $C! 내게 좋은 제안이 있는데, 테라모어로 순간이동 할 수 있게 되면 좋지 않겠어요? 당신이 비교적 학식 있고 여행을 많이 한 마법사라는 것을 알고 있으니 가르치는 것은 분명 쉬울 겁니다.\n\n먼저 동부 왕국 저 멀리 있는 슬픔의 늪, 그 해안가까지 여행을 가셔야 해요. 그곳에서 늪지게들을 찾을 수 있을 겁니다. 그 녀석들의 눈을 14개 모아 오세요, 손상되지 않도록 조심하시고요! 돌아오시면 다음 임무를 위해 이것들이 왜 필요한지 설명해 드리겠습니다.",
  },
  [26425] = {
    ["T"] = "비전의 결합체",
    ["O"] = "테라모어 거점 요새 지하실에서 비전 시야의 영약을 사용하고, 원소의 결합체를 처치하십시오. 그 후 테라모어의 여군주 제이나 프라우드무어에게 돌아가십시오.",
    ["D"] =
    "훌륭해요, $N. 자, 이 눈들을 어디에 써야 하는지 설명하죠. 원소의 결합체에 대해 들어본 적 있나요? 당신이 들어봤을 가능성은 아주 낮을 것 같군요! 그것들은 원소의 에너지가 주입된 비전 피조물들로, 정령의 형태를 취할 수 있습니다. 그들 자신이 정령은 아니지만 구분하기 매우 어렵죠.\n\n그런데, 여기 테라모어의 거점 요새 지하실에 그중 하나가 있습니다. 누가 거기에 둔 건지 모르겠지만 결국 문제가 될까 두렵습니다. 당신이 모은 이 눈들이 그 \"정령\"의 정체를 드러내 당신이 처치할 수 있게 해 줄 겁니다. 나 혼자서도 처치할 수 있지만 당신이 그 괴물과 싸우며 유용한 통찰력을 얻을 수 있을 거라 생각합니다. 행운을 빕니다! 당신을 온전히 믿습니다.",
  },
  [26426] = {
    ["T"] = "변두리 악취 구덩이",
    ["O"] = "칼림도어의 먼지진흙 습지대 남쪽에서 늪지악어에게 늪지악어 눈 14개를 구한 다음, 스토나드의 로린 폭스파이어에게 돌아가십시오.",
    ["D"] =
    "이보시오, 당신은 꽤 학식 있는 $c 같군. 드디어 지루한 오크가 아닌 사람을 만났어! 혹시 원소의 결합체라는 것에 대해 아는 바가 있소? 아니라고? 흠, 그렇게 유식한 건 아니었군...\n\n<로린이 잠시 멈추고 책상 위의 물건들을 몇 개 옮깁니다.>\n\n이러면 어떻겠소. 만약 아무 묻지도 따지지도 않고 날 도와준다면, 스토나드로 순간이동 하는 법을 가르쳐 주겠소. 콜? 이 곳이 구석진 악취 구덩이이긴 하지만, 그래도 위치만큼은 꽤 쓸만하니까.\n\n저 먼 먼지진흙 습지대로 가서 부패물 늪지악어 눈 14개를 모아오시오. 상태가 아주 좋아야 하오! 늪지대 남쪽 구역에서 그것들을 찾을 수 있을 거요.",
  },
  [26427] = {
    ["T"] = "비전의 결합체",
    ["O"] = "스토나드 외곽에 있는 남쪽 오크 지하 동굴에서 비전 시야의 영약을 사용하고 원소의 결합체를 물리치십시오. 임무를 마치면 스토나드에 있는 로린 폭스파이어에게 돌아가십시오.",
    ["D"] =
    "당신이 수집한 눈들을 사용해 비전 시야의 영약을 제조했소. 이 영약을 여기서 바로 서쪽에 있는 남쪽 오크 지하 동굴에서 사용해 보시오. 원소의 결합체라 불리는 비전 피조물을 소환할 것이오. 당신의 임무는 그것을 처치하는 거요.\n\n살아서 돌아온다면 그 녀석의 정체가 무엇인지 설명해 주도록 하겠소. 혹시 내가 그것을 거기 두었는지 궁금하다면, 난 아니라고 대답해 두겠소. 누가 그랬는지는 모른다오.",
  },
  [26428] = {
    ["T"] = "축복받은 두루마리",
    ["O"] = "축복받은 두루마리를 읽고 죽음의 종소리 마을에 있는 다넬과 대화하십시오.",
    ["D"] = "가기 전에, 방금 전령으로부터 이 두루마리를 받았소. 근처에 있는 성기사 전문가 다넬이 보낸 거요. 한 번 살펴보시오. 포세이큰 진영에 성기사가 그리 많지는 않으니까.",
  },
  [26429] = {
    ["T"] = "희생에 대한 강조",
    ["O"] = "썬더 블러프로 여행하여 정령의 봉우리에 있는 뮬른 어스퓨리에게서 정령의 토템을 획득하십시오. 이를 위해서는 150 골드의 기부금이 필요합니다.",
    ["D"] =
    "나는 당신이 무엇을 찾고 있는지 알고 있소, $C $N. 그리고 내가 할 수 있는 한 최선을 다해 당신을 돕겠소. 이 일은 전통적인 방법으로는 이루어질 수 없기 때문에 약간 이례적인 동맹의 도움을 구해야 하오.\n\n이 임무를 준비하기 위해 당신은 먼저 희생의 의식을 치러야 하오.\n\n다음에 일어날 일을 위해 우리는 정령의 토템이 필요하오. 선하고 정당한 이유로 사용될지라도 주술사에게서 그것을 가져가는 대가는 치러야만 하오.\n\n썬더 블러프로 가서 도시 서쪽의 정령의 봉우리에 있는 뮬른 어스퓨리와 대화하시오. 토템을 잃는 대가로 충분한 금화를 챙겨가는 것이 세속적인 부를 기꺼이 희생하여 정의를 추구하고자 하는 당신의 의지를 보여주게 될 거요.",
  },
  [26430] = {
    ["T"] = "정당한 심판을 보여주기 위해",
    ["O"] = "언더시티의 타락한 기사에게 정기의 토템을 가지고 돌아가십시오.",
    ["D"] =
    "나의 축복이 깃든 정기의 토템을 가져가시오, $C. 나 역시 장막 너머를 응시하기 위해 그것을 사용해 왔으며, 앞으로 당신이 마주하게 될 그 어떤 임무에도 큰 도움이 될 것이오.\n\n여기서 당신의 용무는 끝난 것 같군. 전리품을 가지고 언더시티의 타락한 기사에게 돌아가시오.",
  },
  [26431] = {
    ["T"] = "영혼 퇴마",
    ["O"] = "붉은십자군 수도원 뒤편의 평온의 정원으로 들어가, 정기의 토템을 사용하여 유적에 출몰하는 유령들을 보이게 하십시오. 타락한 성기사의 영혼을 찾아 쓰러뜨리십시오.",
    ["D"] =
    "이 토템을 통해 당신은 삶과 죽음의 경계에 갇힌 존재들의 영혼--유령--을 볼 수 있을 것이오. 그들 중 한 존재가 당신을 도울 것이나, 그 전에 당신은 그가 생전에 저지른 행동에 대한 심판을 내려야만 하오.\n\n평온의 정원이라 불리는 붉은십자군 수도원 뒤편의 뜰에 정기의 토템을 꽂으시오. 그것은 우리 필멸자의 눈으로는 볼 수 없는 것을 볼 수 있게 해 줄 거요. 타락한 성기사의 영혼을 찾으시오. 이 영혼과 전투를 벌이면 그는 당신에게 무인의 예로서 빚을 지게 될 것이오. 당신의 임무가 끝나면, 그 영혼이 당신에게 말을 걸 거요.",
  },
  [26432] = {
    ["T"] = "장인의 작품",
    ["O"] = "타락한 기사에게 호드 내에서 마구를 만들어 줄 수 있을 만큼 숙련된 자가 누구인지 물어보십시오.",
    ["D"] =
    "전투를 함께할 군마를 소환하고 싶다고? 자격을 얻은 성기사라면 누구나 꿈꾸는 일이지.\n\n당신 같은 괴물들이 어떻게 그런 자격을 얻을 수 있는지 도저히 이해할 순 없지만, 꼭 도전해 보겠다면 마구가 필요할 것이오.\n\n내 마구는 스트라솔름의 최고 대장장이들이 만들어 주었지. 당신이 그들의 대장간을 이용할 수 있을 거란 생각은 안 들지만, 죽은 자들 중에도 솜씨 좋은 자가 한 명쯤은 있을 거요.",
  },
  [26433] = {
    ["T"] = "진홍빛 도면",
    ["O"] = "스트라솔름으로 들어가 진홍십자군 대장장이를 처치하고 진홍빛 마구 도면을 회수하십시오. 그것을 희망의 빛 예배당에 있는 병참장교 미란다 브리치락에게 가져가십시오.",
    ["D"] =
    "그래서 붉은십자군의 대장장이들이 스트라솔름에서 자신들의 마구를 만들고 있다고? 붉은십자군 요새 안에는 꽤 이름난 대장장이가 한 명 있지. 그자가 필시 이 일을 맡고 있을 거요. 적어도, 도면을 구하기 위해 찾아볼 수 있는 우리의 최선의 선택이오.\n\n도면을 손에 넣게 되면 그것을 희망의 빛 예배당으로 가져가야 할 것이오. 도면은 인간의 언어로 쓰여 있을 테니 -- 아투르크가 도움 없이 읽어내지는 못할 테니까.",
  },
  [26434] = {
    ["T"] = "번역된 도면",
    ["O"] = "오그리마의 명예의 골짜기에 있는 무쇠모루 아투르크에게 번역된 도면을 가져가십시오.",
    ["D"] =
    "당신을 위한 번역을 끝냈습니다. 이 도면은 성기사의 마구에 대한 것 같군요. 당신이 세운 기념비적인 업적을 축하합니다, $C. 앞으로도 행운이 따르길. 이 땅을 떠도는 악에 맞서 일격을 가하는 당신의 모습을 이곳에서 다시 볼 수 있기를 바랍니다.",
  },
  [26435] = {
    ["T"] = "재료 수집",
    ["O"] = "오그리마의 명예의 골짜기에 있는 무쇠모루 아투르크에게 룬무늬 옷감 40개, 아케이나이트 주괴 6개, 아서스의 눈물 10개, 스트라솔름 성수 5병, 그리고 150골드를 가져가십시오.",
    ["D"] =
    "도면에 따르면 이 마구를 만드는 데는 네 가지 재료가 필요하군: 안감을 댈 룬무늬 옷감, 판금을 댈 아케이나이트 주괴, 영적인 조율을 위한 아서스의 눈물, 그리고 영적인 기운을 불어넣을 스트라솔름 성수.\n\n거기다 한 가지 더 -- 나도 이 작업에 대한 대가를 받아야 해. 네 수수료에는 수제 안장과 등자를 포함한 노동력이 포함될 거다.\n\n네가 물건을 전달해주면 나는 마구를 완성할 수 있어. 안장 작업은 당장 시작하지.",
  },
  [26436] = {
    ["T"] = "아투르크 최고의 작품",
    ["O"] = "티리스팔 숲의 평온의 정원에 있는 붉은 십자군 성기사에게 아케이나이트 마구를 가져가십시오. 그들을 보려면 정기의 토템이 필요합니다.",
    ["D"] =
    "<아투르크가 자부심에 차 활짝 웃으며 이마의 땀을 닦아냅니다.>\n\n드레노어에서 견습 생활을 시작했을 때만 해도, 신성한 전사를 위해 말의 갑옷을 만들 줄은 꿈에도 몰랐어. 하지만, 나의 포세이큰 친구여, 이것은 내 최고의 작품 중 하나야. 최고의 결과물을 제공할 수 있도록 날 믿어줘서 고맙다.\n\n의심의 여지 없이, 널 이끌어준 자가 이 장인 정신의 질을 스스로 판단하고 싶어 할 거다. 마구를 가져가서 문제가 있으면 다시 찾아와.",
  },
  [26437] = {
    ["T"] = "준마의 영혼들",
    ["O"] =
    "안돌할 폐허로 여행하여 그곳 외양간에 갇힌 군마의 영혼들을 해방시키십시오. 군마의 영혼들과 대화하여 아케이나이트 마구를 축복받으십시오. 그런 다음 티리스팔 숲의 평온의 정원에 있는 붉은 십자군 성기사에게 돌아가십시오. 영혼을 보려면 정기의 토템이 필요합니다.",
    ["D"] =
    "당신의 마구에는 특별한 축복, 즉 적절한 영혼으로부터 받는 축복이 필요하오. 멀지 않은 곳에 있는 안돌할 폐허에서, 도시가 무너질 때 그곳에 갇혀 버린 말들의 영혼이 느껴지오. 그들을 해방해주면, 당신의 마구를 축복해 줌으로써 당신에게 보답할 것이오.\n\n전부 해방시켜야만 하오, $N. 그러지 않으면 축복은 실패할 테니까. 당신 같은 흉물에게는 아마도 실패할 것이라 예상하지만 말이오.",
  },
  [26438] = {
    ["T"] = "점술용 수정구",
    ["O"] = "아제로스 다이아몬드와 온전한 검은 다이아몬드를 티리스팔 숲의 평온의 정원에 있는 붉은 십자군 성기사에게 가져가십시오. 그를 보려면 정기의 토템이 필요합니다.",
    ["D"] =
    "진정 이 일을 끝내고자 한다면, 타락한 군마를 되살릴 방법이 필요하오. 나와 대화할 때 사용하는 정기의 토템이 그 장치의 토대가 될 것이오.\n\n그 밖에 필요한 재료는 다이아몬드 두 개요. 빛으로 장막을 꿰뚫으려면 두 보석의 광채를 병치시켜야 하오. 그러니 아제로스 다이아몬드 하나와 온전한 검은 다이아몬드 하나가 필요하오. 이 보석들을 집중제로 삼아 정기의 토템은 당신의 신성한 의지를 담아낼 봉화 역할을 하게 될 것이오.\n\n<붉은 십자군 성기사가 몸서리를 칩니다.>\n\n당신이 가치 있는 존재라도 되는 양 떠들고 있는 내 꼴을 보라지.",
  },
  [26439] = {
    ["T"] = "심판과 구원",
    ["O"] =
    "스칼로맨스의 거대한 납골당 지하실 중심부에서 점술용 수정구를 사용하십시오. 그렇게 하면 당신이 심판해야 할 영혼들이 나타납니다. 이 영혼들을 처치하면 죽음의 기사 다크리버가 소환됩니다. 그를 처치하고 타락한 군마의 잃어버린 영혼을 되찾으십시오.\n\n구원받은 군마의 영혼과 축복받은 마법 마구를 다크리버의 타락한 군마에게 주십시오.",
    ["D"] =
    "이 가방을 가져가시오 -- 안에는 당신의 임무에 필요한 물건들이 들어있소.\n\n거대한 납골당의 지하실 한가운데서 점술용 수정구를 사용하여 당신이 심판해야 할 저주받은 영혼들을 불러내시오. 이 시련 동안 당신의 심판을 현명하게 사용하시오 -- 그것들이 당신이 생각하는 것보다 훨씬 더 강력하다는 것을 증명하게 될 거요. 영혼들이 사라진 후에 죽음의 기사가 나타날 것이오; 그를 처치하고 군마의 잃어버린 영혼을 되찾으시오. 그런 뒤에야, $N, 군마를 구원하고 새로운 탈것에 당신의 마구를 채울 수 있을 것이오!",
  },
  [26440] = {
    ["T"] = "타락한 기사",
    ["O"] = "언더시티 깊은 곳에 있는 타락한 기사와 대화하십시오.",
    ["D"] =
    "$N, 당신의 여정 내내 의심의 여지 없이 생각해 왔던 것... 즉, 군마를 획득하기 위해 무엇이 필요한지 배워야 할 때가 왔습니다.\n\n언더시티에 있는 타락한 기사와 이야기하십시오. 그녀가 당신에게 필요한 임무를 안내할 것입니다.\n\n이 시련에 행운이 함께하기를 바랍니다. 빛을 위하여, 고귀한 $g형제:자매;여!",
  },
  [26441] = {
    ["T"] = "고귀한 준마",
    ["O"] = "언더시티에 있는 타락한 기사와 대화하십시오.",
    ["D"] =
    "다시 만나게 되어 반갑소, $N. 전보다 더 당신을 $g 형제로:자매로; 부르게 되어 자랑스럽소--당신의 헌신은 우리 모두에게 칭송받을 만하오.\n\n이제 내가 당신에게 위대한 선물을 하사할 때가 왔소. 하지만 이것만은 알아두시오. 지금은 당신에게 이것을 대가 없이 주지만, 나중에 시간이 허락된다면 내 임무를 수행하기로 선택한 모든 성기사에게 이것은 훨씬 더 위대한 시련이 될 것이오.\n\n내게 다시 말을 걸어주시오. 그러면 위대한 은총을 내려주겠소.",
  },
  [26442] = {
    ["T"] = "고귀한 군마",
    ["O"] = "언더시티에 있는 타락한 기사와 대화하십시오.",
    ["D"] =
    "반갑습니다, $N. 당신의 신앙심 못지않게 당신의 헌신도 여전히 굳건해 보이군요.\n\n이제 언더시티에 있는 타락한 기사와 대화할 때가 된 것 같습니다. 당신이 배워야 할 교훈이 몇 가지 더 있고, 당신은 충분히 준비가 되었다고 생각합니다.\n\n바깥쪽 고리에서 그들을 찾아보세요. 그리고 $N, 이 교훈을 진지하게 받아들이시길 바랍니다. 당신은 겸손과 땀으로 당신의 지위를 얻었으니, 오만해져서 우리를 실망시키지 마십시오.\n\n평안하시길.",
  },
  [26443] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프에 있는 시시카 어스혼과 대화하십시오.",
    ["D"] =
    "반갑소, $G형제:자매;여. 우리 태양길잡이 중 가장 영향력 있는 분인 시시카 어스혼 님께서 최근 자네에 대해 이야기하셨다네. 자네가 지금까지 얼마나 잘해왔는지에 대한 칭찬과 함께, 이제 자네를 시험해 볼 때가 되었다고 말씀하시는 걸 우연히 들었지.\n\n내가 자네라면 시간 날 때 썬더 블러프에 가서 그분과 대화해 볼 걸세. 필시 정기의 봉우리에 계실 거야 -- 대부분의 시간을 그곳에서 보내시니까.",
  },
  [26444] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "",
    ["D"] = "",
  },
  [26445] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프에 있는 시시카 어스혼과 대화하십시오.",
    ["D"] =
    "모든 일에서 태양길잡이는 우리의 힘을 보충해 주는 온기를 반영해야 한다네. 우리 동족 중 한 명이 신성해지려 노력한다는 것은 신이 되고자 노력한다는 의미가 아니라네 -- 우리는 모든 행동에서 선해지려 노력하는 것이지.\n\n비록 이 가혹한 시대에서 어둠을 몰아내라는 부름을 받았지만, 자네는 항상 타인을 돕는 것이 진정 자네를 남다르게 만든다는 것을 기억해야 하네. 자비, 인내, 용기 -- 이 모든 것들이 전투에서의 힘만큼이나 태양길잡이에게 의미 있는 것이라네.\n\n이것을 명심하고, 절대 잊지 말게.",
  },
  [26446] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프의 주 봉우리에서 테히야 스위프트토템을 찾으십시오.",
    ["D"] =
    "그렇다면 자네의 임무는 여기 썬더 블러프에서 도움이 필요한 사람을 찾는 것이네, $n. 마음과 동기가 순수한 자를 찾아보게나. 다른 이를 돕고 있는 사람일 수도 있고. 인도자가 필요한 사람일 수도 있지. 아무튼, 그 사람은 고귀한 의도를 가졌고 자네의 친절을 필요로 하는 사람이어야만 해.\n\n이 일을 끝내고 돌아오게. 그런 다음, 자네의 길과 태양 아래를 걷는다는 것이 무엇을 의미하는지 좀 더 이야기해 보도록 하지.",
  },
  [26447] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프의 테히야 스위프트토템에게 리넨 옷감 10개를 가져다주십시오.",
    ["D"] =
    "이 가엾고 어린아이들을 축복해 주세요. 켄타우로스의 습격과 우리 종족이 호드의 영토 전역으로 퍼져나간 탓에 대부분 가족이 없답니다.\n\n평소라면 옷을 만들 옷감과 가죽을 구할 수 있겠지만 점점 힘들어지고 있어요. 게다가 전 아이들을 따뜻하고 안전하게 지붕 아래 머물게 하는 것에만 온 신경을 집중하고 있거든요.\n\n아이들 옷을 지을 수 있게 리넨 옷감을 좀 가져다주시면 제게 정말 큰 도움이 될 거예요.",
  },
  [26448] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프의 시시카 어스혼과 대화하십시오.",
    ["D"] =
    "오늘이 가기 전에 아이들이 이것들을 입을 수 있도록 하겠습니다. 부디 무사하시길, 선량한 $c 님. 당신처럼 훌륭한 인품을 가진 분들이 도시에 모습을 드러내는 일이 흔치 않지만, 당신은 이곳 썬더 블러프에서 태양을 따르는 자들이 결코 다른 이들을 어둠 속으로 이끌지 않는다는 것을 증명하셨습니다.\n\n안녕히 가십시오.",
  },
  [26449] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프의 송가 클라우드라이더에게 생명의 앙크를 가져가십시오.",
    ["D"] =
    "이걸 받게, $n. 생명의 앙크라 불리는 물건이지.\n\n자네는 자비롭고 인내심이 있음을 증명했네. 이제 태양의 가장 위대한 선물 중 하나를 집중시킬 만큼 강력한지 확인할 때가 왔네.\n\n내 친구 송가가 최근 블러드후프 마을 근처에서 투자개발회사 무리와 마주쳤다가... 간신히 목숨만 건져 돌아왔지.\n\n앙크를 가지고 그와 대화해 보게. 자네가 그를 도울 수 있다면, 조만간 다시 이야기할 수 있겠지. 태양의 온기 속에서 흠뻑 젖어들기를.",
  },
  [26450] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "생명의 앙크를 가져가 멀고어에서 다코다 프리로어를 부활시키십시오.",
    ["D"] =
    "나와 다코다는 블러드후프 마을 바로 북동쪽에 있는 투자개발회사 광산까지 갔었소. 놈들이 우리 평원에 침투했다는 소문을 들었고 그 증거를 대족장님께 가져가고 싶었거든.\n\n우리는 문서를 훑어보던 쓰레기 놈들 몇 명을 발견하고 공격했지. 불행하게도 우리가 감당할 수 없을 정도로 많은 놈들이 몰려와 순식간에 압도당하고 말았소.\n\n다코다는 내가 도망칠 수 있도록 놈들을 막아주었소... 용감한 척하다니, 바보 같은 녀석.\n\n나는 그가 호숫가 해안을 따라 쓰러지는 것을 분명히 보았지만 다시 돌아갈 수가 없었소. 그는 지금 그곳에 있소, 우리를 도와줄 수 있겠소, $n?",
  },
  [26451] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "멀고어에 있는 투자개발회사 감독관의 무리에서 투자개발회사 문서를 되찾아 썬더 블러프의 송가 클라우드라이더에게 돌아가십시오.",
    ["D"] =
    "앙크에 대한 이야기는 나중에 시간이 있을 때 자세히 나누도록 하지. 중요한 것은 투자개발회사로부터 그 문서들을 빼내는 것이야. 그걸 손에 넣으면 놈들이 멀고어에 잠입했다는 사실과 배후가 누구인지에 대한 증거를 확보할 수 있을 걸세.\n\n나는 지금 당장 싸울 수 있는 상태가 아니야, $n. 자네라면 광산에 있는 감독관들에게서 그 문서를 빼앗을 만큼 강하다고 생각하나? 만약 문서를 손에 넣게 되면 송가에게 돌아가 내가 무사하다고 전해주게나.",
  },
  [26452] = {
    ["T"] = "신성함의 두루마리",
    ["O"] = "썬더 블러프의 시시카 어스혼과 대화하십시오.",
    ["D"] =
    "시시카가 문서들을 검토한 후 족장님께 가져갈 것이네. 끝에 적힌 그 이니셜들... 신경이 쓰이는군. 그동안 자네는 시시카와 이야기해 보게나. 그녀는 자네의 등을 토닥여주고 싶어 안달 났을 거야.\n\n다시 한번 고맙네, $n. 언젠가 다시 만나기를 바라네. 자네는 내가 진심으로 벗이라 부를 수 있는 자랑스러운 동맹이야.",
  },
  [26453] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "타락한 기사와 대화하여 그녀가 무슨 말을 하는지 들어보십시오.",
    ["D"] =
    "당신은 첫 번째 진짜 가르침을 받을 준비가 되었소, $C $N. 하지만 내가 당신이 읽을 신성함의 고서를 갖고 있지 않기 때문에, 이것은 살아있는 성기사가 할 일과는 사뭇 다를 것이오.\n\n\"연민, 인내, 용맹--이러한 것들은 성기사에게 전장의 힘만큼이나 의미가 깊다.\" 이 문구는 그 고서에 적힌 수많은 구절 중 하나로, 당신이 배워야만 하는 것이오. 우리는 죽었고 불경한 존재이며, 왜 빛이 우리에게 응답하는지 나는 이해하지 못하오. 우리의 영혼 자체가 우리가 추구해야 할 이상과 맞서 싸우고 있으니 말이오.\n\n쏟아지는 말들에 맞설 준비를 하고, 내게 다시 말을 거시오.",
  },
  [26454] = {
    ["T"] = "구원을 찾아서",
    ["O"] = "언더시티로 여행하여 군사 지구에 있는 타락한 기사와 대화하십시오.",
    ["D"] =
    "안녕하시오, $C. 이제 고향 언더시티로 돌아갈 시간인 것 같소.\n\n당신의 모험심은 존경하지만, 내가 가르쳐 줄 수 없는 교훈들이 있소. 군사 지구에 있는 타락한 기사를 찾으시오. 빛이 당신과 함께하기를.",
  },
  [26455] = {
    ["T"] = "구원을 찾아서",
    ["O"] = "언더시티로 여행하여 군사 지구에 있는 타락한 기사와 대화하십시오.",
    ["D"] =
    "반갑소, $g 형제:자매;여. 타락한 기사를 만나 보았소? 그녀는 살아생전 자신의 정체성에 대해 비밀이 많긴 하지만 어쨌든 강력한 성기사지. 그녀가 그렇게 불리는 이유이기도 하고. 나는 당신이 그녀에게 배울 준비가 되었다고 믿소. 내가 가르쳐 줄 수 없는 교훈들이 있으니까 말이오.\n\n언더시티의 군사 지구에서 그녀를 찾을 수 있을 거요. 그녀는 끔찍한 진흙 속에서 낚시를 하고 있을 텐데, 모른 척하고 싶군. 빛이 당신과 함께하길.",
  },
  [26456] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "언더시티의 군사 지구에 있는 알리사 블레예를 찾으십시오.",
    ["D"] =
    "이제 시작할 수 있겠군, $N. 평소라면 마음과 동기가 순수한 자를 찾아오라고 당신을 보냈겠지만, 솔직히 우리 모두 심장이 더 이상 뛰지 않는데 그건 무리한 요구라는 것을 인정해야겠군. 그러니 내가 당신을 올바른 길로 살짝 밀어주겠소.\n\n운하 건너편에서 훈련하고 있는 알리사 블레예를 찾아보시오 -- 사실 여기서도 그녀가 보일 거요. 스컬지가 들이닥치기 전에는 수도의 보육원 원장님이었소. 지금은 다시는 그런 비극이 일어나지 않게 막고자 자신의 모든 시간을 전투 훈련에 쏟아붓고 있지.\n\n그녀에게 아이들에 대해서는 묻지 마시오, $N.",
  },
  [26457] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "언더시티 군사 지구에 있는 알리사 블레예에게 리넨 옷감 10개를 가져다주십시오.",
    ["D"] =
    "아마 그 기사분께서 제가 여기 보육원 원장이었다고 말씀하셨겠죠. 스컬지가 공격해 왔을 때, 전...\n\n<알리사가 잠시 목이 메이다가, 이내 평정심을 되찾습니다.>\n\n이제 와서 그게 무슨 소용이겠어요, 중요한 건 이런 일이 두 번 다시 일어나지 않게 스컬지를 끝장내는 것뿐이죠.\n\n하지만 어쩌면... 당신이 제게 리넨 옷감을 좀 가져다주시면, 제가 오그리마의 고아들을 위한 옷을 지어줄 수 있을지도 모르겠네요. 전투 훈련 중 쉬는 시간 동안 제가 살아생전 가졌던 기술을 다시 한 번 뜻깊게 사용할 수 있을 테니까요.",
  },
  [26458] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "언더시티의 군사 지구에 있는 타락한 기사에게 돌아가십시오.",
    ["D"] =
    "<알리사가 허수아비를 공격하는 데 깊이 집중하고 있습니다.>\n\n당신의 스승에게 돌아가세요, 친애하는 $C. 당신의 임무는 끝났고, 제 하루는 밝아졌습니다. 빛이 당신과 함께하기를 바랄게요, 제 생각엔 말이죠.",
  },
  [26459] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "언더시티 도적의 지구에 있는 제이크 하트스톨렌을 찾아 대화하십시오.",
    ["D"] =
    "이것을 받으시오, $N. 이것은 생명의 징표라고 불리우오.\n\n이것은 나만의 개인적인 징표이니 부디 잃어버리지 마시오. 형제단에 새로 만들어달라고 요청하기가 곤란하니까. 당신이 진정으로 빛의 축복을 받았는지 확인해 볼 것이오.\n\n도적의 지구로 가서 제이크 하트스톨렌과 이야기하시오. 내 생각에 그는 응급치료사 곁에서 치료를 받고 있을 것이오.",
  },
  [26460] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] =
    "당신의 생명의 징표를 사용하여 브릴 동쪽, 발니르 농장 바로 북쪽에 있는 붉은십자군 전초기지 근처에서 랜스 하트스톨렌을 구하십시오.\n\n생명의 징표를 잃어버렸다면, 언더시티의 제이크 하트스톨렌에게서 새 것을 받을 수 있습니다.",
    ["D"] =
    "내 형제 랜스와 나는 브릴 동쪽에 있는 붉은십자군 전초기지 근처에 나갔었소. 우린 붉은십자군 몇 놈을 정찰하고 해치우고 있었는데, 우리 분수에 넘치는 일을 벌이고 말았지 뭐요. 우린 도망쳤지만, 뒤를 돌아보았을 때 동생은 거기 없었소! 제발, 그 녀석을 찾아주시오.\n\n나도 당신과 함께 가고 싶지만, 도망치면서 화살을 여러 발이나 맞았소. 어둠의 여왕님께서 당신을 보우하시길.",
  },
  [26461] = {
    ["T"] = "버려진 우리의 육신",
    ["O"] = "붉은십자군 전초기지 주변에서 붉은십자군 수사 3명과 붉은십자군 광신도 3명을 처치하고, 언더시티에 있는 타락한 기사에게 돌아가십시오.",
    ["D"] =
    "랜스 하트스톨렌의 시신 곁에 서 있으니 타락한 기사의 말이 떠오릅니다.\n\n\"하지만 시체와도 같은 우리 몸에 빛이 가져다주는 고통을 모든 이가 당신만큼 견뎌내는 것은 아니라는 점을 명심하시오.\"\n\n아무래도 이제 돌아가는 수밖에 없는 것 같습니다... 세상의 붉은십자군 수가 조금이라도 줄어든 후에 말입니다.",
  },
  [26462] = {
    ["T"] = "햇빛에 바랜 양피지",
    ["O"] = "햇빛에 바랜 양피지를 읽고 나라체 야영지의 카야와 대화하십시오.",
    ["D"] =
    "조금 전에 어떤 전령이 자네를 찾고 있었네, $N. 아마도 성기사 전문가인 카야 선메인이 보낸 것 같더군. 만약 이 쪽지가 태양길잡이에게서 온 것이라면, 지체 없이 그녀를 만나러 가는 것을 추천하네.",

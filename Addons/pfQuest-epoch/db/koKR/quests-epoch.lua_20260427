  [28404] = {
    ["T"] = "메릴 웬딜의 의뢰",
    ["O"] = "밴스 언더글룸이 마법부여 기술을 사용해 제공된 여사제의 망토에 망토 마법부여 - 최하급 저항을 주문한 뒤, 티리스팔 숲 브릴 묘지에 있는 메릴 웬딜에게 배달해 달라고 합니다.",
    ["D"] =
    "마법부여사여, 의뢰 하나 맡아주었으면 하네. 브릴 묘지의 메릴은 성기사들을 위해 스컬지석을 취급하고 있지. 난 그 멍청이들이 왜 아직도 성기사로 남으려 애쓰는지 이해할 수 없지만, 타락의 기운에서 몸을 지킬 수단 정도는 제공해 줄 수 있겠지. 이 여사제의 망토에 최하급 저항 마법을 부여해서 그들에게 가져가 주게.",

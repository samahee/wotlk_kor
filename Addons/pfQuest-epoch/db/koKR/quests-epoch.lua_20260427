    ["D"] =
    "난 무척 바쁜 사람이고 물약 따위보단 훨씬 중요한 일들이 많소. 그렇다 해도, 내 동포인 포세이큰을 돕고 싶긴 하군. 공동묘지 북쪽 도로에서 사고가 있었다고 들었네. 하급 치유 물약 몇 개를 만들어서 사고 지점에 있는 죽음의경비병 킷사펠에게 배달해 준다면, 그를 돕지 못한 내 죄책감도 한결 가벼워지겠지.",
  },
  [27618] = {
    ["T"] = "킬리안 사나타를 위한 의뢰",
    ["O"] = "연금술사 렌퍼럴은 당신의 연금술 기술을 사용해 아귀아귀 기름 5개를 제작하고 은빛소나무 숲의 북부 해안가에 있는 킬리안 사나타에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "도움 이야기가 나와서 말인데... 연금술사의 손길이 필요한 자가 한 명 더 있네. 암흑의 해안 너머 해안선 위쪽, 북부 해안가의 야영지에서 킬리안 사나타를 찾을 수 있을 거야. 녀석은 자기를 위해 아귀아귀 오일병 몇 개 만들어 줄 연금술사를 애타게 찾고 있는데... 어, 사실 내가 그 오일을 다른 데 써버려서 말이지. 관심이 있다면 찾아가봐, 보상도 확실할 테니.",
  },
  [27619] = {
    ["T"] = "팔라 세이지윈드를 위한 의뢰",
    ["O"] = "연금술사 헬브림은 당신의 연금술 기술을 사용해 지혜의 비약 5개를 제작하고 불모의 땅의 통곡의 동굴 위쪽에 있는 팔라 세이지윈드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "몇 달에 한 번씩 통곡의 동굴 꼭대기에 사는 은둔자 타우렌을 만나기 위해 여행하는 순례자들이 있습니다. 그녀의 지혜는 때론 이해하기 어렵죠. 그래서 그녀에게 줄 지혜의 비약을 좀 비축해 두려 합니다. 만들어서 전해주신다면, 그녀도 기쁜 마음으로 쓸 만한 보급품을 챙겨 줄 겁니다.",
  },
  [27620] = {
    ["T"] = "신질을 위한 의뢰",
    ["O"] = "연금술사 헬브림은 당신의 연금술 기술을 사용해 최하급 인내의 비약 5개를 제작하고 불모의 땅의 크로스로드 북쪽에 있는 신질의 집으로 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이 대륙에 사는 그 어떤 이상한 종족들 중에서도 트롤 녀석들이 가장 불쾌하단 말이야. 냄새나는 데다 수준 높은 문학을 즐기지도 않지... 아무튼 신질이라는 트롤이 최하급 인내의 비약을 달라고 요구하고 있네. 자네가 이 귀찮은 일을 대신 처리해준다면 아무 불만도 없겠네.",
  },
  [27621] = {
    ["T"] = "양조업자 드론을 위한 의뢰",
    ["O"] = "양조업자 드론은 당신의 연금술 기술을 사용해 수중 호흡의 비약 5개를 제작하고 불모의 땅 톱니항에 있는 양조업자 드론에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네 $C... 아니 연금술사 $N이라고 해야 할까? 자네도 알다시피 맥주 양조와 연금술은 그리 다르지 않지.\n\n나도 여기저기 떠돌면서 겪은 생명체들을 통해 양조법에 대해 꽤 많은 걸 배웠지만 아직 시도해보지 않은 재료 출처가 하나 있네. 바로 바다라네. 그래서 수중 호흡의 비약이 좀 필요한데, 혹시 자네가 좀 도와줄 수 있겠나?",
  },
  [27622] = {
    ["T"] = "양조업자 드론을 위한 의뢰",
    ["O"] = "양조업자 드론은 당신의 연금술 기술을 사용해 신속한 수영 물약 5개를 제작하고 불모의 땅 톱니항에 있는 양조업자 드론에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "양조에 쓸 재료를 찾으러 바다를 탐험하고 싶긴 하지만 난 멍청이가 아니지. 파도 밑에 상어나 다른 위험이 도사리고 있다는 걸 알고 있으니까. 그래서 신속한 수영 물약도 좀 구해다 주면 고맙겠어. 만약의 사태를 대비해 빨리 도망치--아니 헤엄쳐야 할 테니 말이야!",
  },
  [27623] = {
    ["T"] = "록케 오카르를 위한 의뢰",
    ["O"] = "크시리스는 당신의 연금술 기술을 사용해 치유 물약 5개를 제작하고 잿빛 골짜기의 토막나무 주둔지에 있는 록케 오카르에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "$C, 자네가 연금술사라는 얘기를 들었소. 대족장께서 이 초소를 정비하라며 나를 보내셨는데 상황이 예상했던 것보다 훨씬 끔찍하더군. 매일 얼라이언스 놈들에게 많은 병사들을 잃고 있네. 병사들에게 나누어줄 치유 물약을 자네에게 의뢰하고 싶은데, 해결해 주겠나?",
  },
  [27624] = {
    ["T"] = "연금술사 라이던을 위한 의뢰",
    ["O"] = "연금술사 라이던은 당신의 연금술 기술을 사용해 화염 오일 5개를 제작하고 힐스브래드 구릉지 타렌 제분소에 있는 연금술사 라이던에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "오... 연금술사시로군요. 제 독에 대한 관심도 좋게 보시겠네요. 결국엔 연금술과 별반 다르지 않으니까요.\n\n사실, 당신 도움이 필요합니다. 힐스브래드를 위해 또 다른 약을 만들려고 하는데... 불의 기운이 감도는 독을 만들고 싶거든요... 타오르는 느낌이 드는 그런 것 말이죠. 화염 오일을 좀 만들어주신다면, 나중 제작에 요긴한 재료들을 좀 챙겨드리죠.",
  },
  [27625] = {
    ["T"] = "엘루를 위한 의뢰",
    ["O"] = "엘루는 당신의 연금술 기술을 사용해 강한 트롤의 피 비약 5개를 제작하고 버섯구름 봉우리의 높새바람 봉우리에 있는 엘루에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳에서 연금술사를 만나게 되어 정말 다행이에요. 저는 지금 부상당한 와이번 새끼들을 치료 중인데, 강한 트롤의 피 물약이 한 움큼 있으면 녀석들의 상처를 부드럽게 씻어내고 치유하는 데 도움이 될 거예요. 저 좀 도와주시겠어요?",
  },
  [27626] = {
    ["T"] = "의술사 진질을 위한 의뢰",
    ["O"] = "지다는 당신의 연금술 기술을 사용해 하급 마나 물약 5개를 제작하고 돌발톱 산맥의 말라카진에 있는 의술사 진질에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "저는 연금술사는 아니에요... 그런 셈이죠. 하지만 제 스승이신 의술사 진질님은 제가 무에서 유를 창조하는 것처럼 물약을 뚝딱 만들어 낼 수 있다고 생각하시나 봐요.\n\n진질님이 쓰실 하급 마나 물약이 좀 필요해요. 혹시 절 도와주실 수 있나요? 조금만 만들어서 말라카진에 있는 진질님께 전해주세요. 그럼 절 내버려 두고 연구에나 집중하시겠죠.",
  },
  [27627] = {
    ["T"] = "님보야를 위한 의뢰",
    ["O"] = "님보야는 당신의 연금술 기술을 사용해 일발의 비약 5개를 제작하고 가시덤불 골짜기의 그롬골에 있는 님보야에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "다른 숲이나 정글 트롤 놈들에게 의술사들이 있는 한 우린 불리한 전투를 할 수밖에 없어. 그래서 우리도 우리만의 무기가 필요한 법이지.\n\n네게 일발의 비약 제작을 의뢰하고 싶다. 여기서 만들어서 내게 가져오도록 해. 그게 있다면 우리도 다른 트롤 놈들보다 우위를 점할 수 있을 테니까.",
  },
  [27628] = {
    ["T"] = "타베사를 위한 의뢰",
    ["O"] = "드자리블은 당신의 연금술 기술을 사용해 하급 투명 물약 5개를 제작하고 먼지진흙 습지대의 타베사 농장에 있는 타베사에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 숙련된 연금술사님! 당신 도움이 필요합니다!\n\n늪에 사는 타베사라는 은둔자가 있어요. 저희에게 사절을 보내어 하급 투명 물약이 절실하게 필요하다고 알렸는데, 우린 그런 걸 만들 수 있는 사람이 아무도 없답니다! 물약을 만들어 그녀에게 배달하는 것을 도와주실 수 있겠습니까? 우린 그분의 노여움을 사고 싶진 않아요. 이미 충분히 고통받았거든요.",
  },
  [27629] = {
    ["T"] = "타카타 스틸블레이드를 위한 의뢰",
    ["O"] = "마르윈 슈릴윌은 당신의 연금술 기술을 사용해 인내의 비약 5개를 제작하고 잊혀진 땅의 침묵의 초소에 있는 타카타 스틸블레이드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "나는 왕립 연금술사 학회의 명령에 따라 중요한 임무를 띠고 이곳에 왔소. 하지만 호드를 따라온 잡동사니 같은 녀석들은 내가 저들 심부름이나 들어주는 줄 아는구려.\n\n타카타 스틸블레이드라는 오크 전사가 있는데, 녀석은 관절이 쑤시고 곁을 맴도는 악마들의 지옥 마력 오염으로 피부가 스멀거린다고 칭얼댄다오. 당신이 연금술 실력이 제법 되는 듯하니 녀석을 위해 인내의 비약을 만들어주고 이 골칫거리 좀 해결해 주시오.",
  },
  [27630] = {
    ["T"] = "썬더하트를 위한 의뢰",
    ["O"] = "자칼 모스멜드는 당신의 연금술 기술을 사용해 묘약 5개를 제작하고 황야의 땅 카르가스에 있는 썬더하트에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "황야의 큰 고양이들은 대담해, $C. 우린 놈들의 사냥에 여러 정찰병을 잃었지. 문제는 놈들의 은신술이야. 놈들이 오는 걸 볼 수 있는 수단이 필요해.\n\n나도 연금술사지만 독학이라 묘약의 공식은 모른다네. 하지만 자네가 알고 있다면, 물약 몇 개만 만들어 줘도 여기 있는 녀석들에게는 엄청난 도움이 될 거야.",
  },
  [27631] = {
    ["T"] = "드럼 펠을 위한 의뢰",
    ["O"] = "토건은 당신의 연금술 기술을 사용해 상급 치유 물약 5개를 제작하고 아라시 고원 망치 주둔지에 있는 드럼 펠에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "여기 야영지의 오크들은 이곳에서 우리 형제자매들에게 닥친 끔찍한 일들에 대한 기억 때문에 짓눌려 있소. 정령들의 힘으로 그들의 기운을 북돋워 줄 순 있지만, 구식 연금술로 덕을 볼 자들도 있을 테지.\n\n가령, 드럼 펠을 예로 들겠소. 녀석은 인간들 손에 입은 상처를 숨기려 하오. 그를 위해 상급 치유 물약을 만들어주시오. 그러면 새로운 리더십이 깨어나는 걸 볼 수 있을 거요.",
  },
  [27632] = {
    ["T"] = "아키하를 위한 의뢰",
    ["O"] = "듀몬트 할로우크라이는 당신의 연금술 기술을 사용해 상급 수중 호흡의 비약 5개를 제작하고 타나리스 안제와타에 있는 아키하에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "난 트롤들과 그들의 한심한 로아 혼령 같은 건 말도 안 된다고 생각해! 저기 아키하 좀 봐. \"상어 신\"이라니? 얼마나 어리석은 생각이야!\n\n만약 이 그랄이란 놈이 진짜로 존재한다면, 상급 수중 호흡의 비약 몇 병을 만들어서 인사라도 하고 오는 게 어때? 마침 네가 연금술사니까, 진짜로 가서 그렇게 해보지그래?",
  },
  [27633] = {
    ["T"] = "즈랄을 위한 의뢰",
    ["O"] = "즈랄은 당신의 연금술 기술을 사용해 언데드 탐지의 비약 5개를 제작하고 페랄라스 글룩의 야영지에 있는 즈랄에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 연금술사. 내 친구 토르그는 자신이 죽지 않았다고 생각해. 다른 죽은 자들이 여기 주위에 머물기 때문에, 토르그도 자기가 죽었는데 여기에 머물러도 괜찮다고 생각하는 거 같아. 네가 죽은 사람을 보게 해주는 음료 만들어 줄 수 있어?",
  },
  [27634] = {
    ["T"] = "트룰 페일베인을 위한 의뢰",
    ["O"] = "트룰 페일베인은 당신의 연금술 기술을 사용해 상급 민첩의 비약 5개를 제작하고 악령숲 피멍울 초소에 있는 트룰 페일베인에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 연금술사. 난 그 특수한 과학에 대해선 잘 모르지만 그 진가는 높이 평가하지.\n\n사실, 상급 민첩의 비약이 좀 필요해. 이 숲에 스며든 지옥 마법이 내 뼛속까지 파고들어 온몸을 뻣뻣하게 만들거든. 그 비약들이 내 관절을 다시 움직이게 해줄 거야. 도와줄래?",
  },
  [27635] = {
    ["T"] = "수습생 사리나를 위한 의뢰",
    ["O"] = "수습생 사리나는 당신의 연금술 기술을 사용해 꿈 없는 수면의 물약 5개를 제작하고 아즈샤라 발로르모크에 있는 수습생 사리나에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "리앤더 스승님은 연금술의 천재지만, 우릴 뼛골 빠지게 부려먹어 -- 언데드 농담은 아니고. 수개월 동안 제대로 된 잠을 자본 기억이 없어.\n\n개인 연구를 위해 작업을 멈출 수는 없지만, 혹시 꿈 없는 수면의 물약 몇 개만 만들어 줄 수 있어? 그러면 진짜 서서 자면서도 생산성을 올릴 수 있을 거야. 좀 도와줄래?",
  },
  [27636] = {
    ["T"] = "치안대장 해거드를 위한 의뢰",
    ["O"] = "대장장이 아르거스는 당신의 대장기술을 사용하여 룬문자 구리 바지 1개와 룬문자 구리 팔보호구 1개를 제작하고 엘윈 숲 동쪽계곡 벌목지에 있는 치안대장 해거드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네, $C. 동료 대장장이의 손길을 알아보겠군. 내 의뢰 중 하나를 직접 맡아보는 건 어떤가?\n\n동쪽계곡 벌목지에 있는 치안대장 해거드가 룬문자 구리 바지와 룬문자 구리 팔보호구 세트를 요청해왔지. 관심 있다면 물건을 만들어서 직접 배달해 주게.\n\n벌목지는 골드샤이어 동쪽에 있네.",
  },
  [27637] = {
    ["T"] = "부관 레이너를 위한 의뢰",
    ["O"] = "대장장이 아르거스는 당신의 대장기술을 사용하여 구리 전투도끼 2개를 제작하고 엘윈 숲 웨스트브룩 주둔지에 있는 부관 레이너에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "인사하네, $C. 이 의뢰들 좀 더 빨리 보내야 하는데 도움이 필요하군. 부관 레이너가 그의 부대원들을 위해 구리 전투도끼를 요청했다네.\n\n이 의뢰를 마칠 생각이라면, 여기서 서쪽에 있는 웨스트브룩 주둔지의 부관에게 직접 배달해 주게.",
  },
  [27638] = {
    ["T"] = "레욜트 발리브루를 위한 의뢰",
    ["O"] = "코간 포지스톤은 당신의 대장기술을 사용하여 거친 연마석 10개를 제작하고 던 모로의 브루날 마을에 있는 레욜트 발리브루에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네, $C. 자네도 대장장이구먼. 여기 쌓인 주문들을 처리하는 데 자네의 망치를 보태볼 텐가?\n\n거친 연마석 한 무더기를 서쪽 브루날 마을의 레욜트 발리브루에게 가져다줄 사람이 필요해. 그가 새로 만드는 맥주에 그걸 쓴다나 봐. 관심 있나?",
  },
  [27639] = {
    ["T"] = "채석장주임 테스텐을 위한 의뢰",
    ["O"] = "코간 포지스톤은 당신의 대장기술을 사용하여 구리 철퇴 3개를 제작하고 던 모로의 골볼라 채석장에 있는 채석장주임 테스텐에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "같은 대장장이로서 말하자면, 언제든 내가 혼자 처리할 수 있는 양보다 일이 더 많이 밀려있다네. 혹시 도와줄 의향이 있다면, 동쪽 골볼라 채석장의 채석장주임 테스텐이 구리 철퇴를 의뢰해 두었어. 날 위해 그것들을 만들어 줄 수 있겠나?",
  },
  [27640] = {
    ["T"] = "메리 아이언위브를 위한 의뢰",
    ["O"] = "레이니 오크스멜터는 당신의 대장기술을 사용하여 무거운 구리 방패 1개와 구리 사슬 조끼 1개를 제작하고 텔드랏실 돌라나르에 있는 메리 아이언위브에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이쉬누알라, $C. 아쉽게도 이야기 나눌 시간이 없군요 -- 이 작업장을 연 이후로 물밀 듯 들어온 수많은 주문들 때문에 눈코 뜰 새가 없거든요.\n\n저기 -- 당신도 모루를 다루는 데 재능이 있어 보이네요. 절 돕고 싶으시다면, 무거운 구리 방패와 구리 사슬 조끼를 만들어서 돌라나르의 방어구 상인인 메리 아이언위브에게 전해주세요.",
  },
  [27641] = {
    ["T"] = "에렐라스 앰버스카이를 위한 의뢰",
    ["O"] = "레이니 오크스멜터는 당신의 대장기술을 사용하여 룬문자 구리 반지 2개를 제작하고 텔드랏실의 루테란 마을에 있는 에렐라스 앰버스카이에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "에렐라스 앰버스카이로부터 온 주문이 있는데 절 대신해 맡아주시면 어떨까요. 그는 룬문자 구리 반지 두 개를 원하고 있습니다. 반지 제작을 마치면 텔드랏실 기슭의 루테란 마을에서 그를 찾을 수 있습니다. 은행 뒤쪽 포탈을 통과하면 거기로 가실 수 있습니다.",
  },
  [27642] = {
    ["T"] = "병참장교 루이스를 위한 의뢰",
    ["O"] = "병참장교 루이스는 당신의 대장기술을 사용하여 일반 연마석 5개를 제작하고 서부 몰락지대 감시의 언덕에 있는 병참장교 루이스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "안녕하시오, $C. 마을에서 대장장이를 만나게 되어 기쁘군. 우리의 무기와 갑옷을 녹과 먼지로부터 보호하기 위해 일반 연마석 보충분이 좀 필요하오. 다섯 개를 만들어 내게 배달해 준다면 고맙겠소.",
  },
  [27643] = {
    ["T"] = "파수꾼 에반젤린을 위한 의뢰",
    ["O"] = "병참장교 루이스는 당신의 대장기술을 사용하여 룬문자 구리 흉갑 1개와 룬문자 구리 팔보호구 1개를 제작하고 서부 몰락지대의 남쪽 도로에 있는 파수꾼 에반젤린에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "일거리를 더 찾고 있다면, 서부 몰락지대 민병대에 갓 들어온 새내기 하나가 갑옷을 완성하기 위해 룬문자 구리 흉갑과 룬문자 구리 팔보호구를 원한다고 들었소. 이것들을 만들어 줄 수 있다면, 파수꾼 에반젤린에게 가져다주시오. 그녀는 감시의 언덕 남쪽 도로를 순찰하고 있소.",
  },
  [27644] = {
    ["T"] = "울란나를 위한 의뢰",
    ["O"] = "델프룸 플린트비어드는 당신의 대장기술을 사용하여 일반 숫돌 3개와 일반 무게추 3개를 제작하고 어둠해안 남쪽 고대정령의 숲에 있는 울란나에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 멀리서도 동료 대장장이를 알아볼 수 있지! 멀리라는 말이 나와서 말인데, 남쪽 고대정령의 숲에 있는 울란나가 숫돌과 무게추를 더 보내달라고 전갈을 보냈어. 내가 직접 그 의뢰를 처리할 시간이 안 났는데, 마을에 있는 김에 자네의 기술을 발휘해 주겠다면 이 의뢰를 맡겨도 좋네.",
  },
  [27645] = {
    ["T"] = "로어난 골드리프를 위한 의뢰",
    ["O"] =
    "델프룸 플린트비어드는 당신의 대장기술을 사용하여 암흑석 펜던트 1개와 조율된 구리 다리보호구 1개를 제작하고 잿빛 골짜기 경계선에 있는 골드리프 은거지의 로어난 골드리프에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "어둠해안과 그 너머에는 자네같이 진취적인 젊은 대장장이를 위한 일거리가 산더미처럼 많아. 자 보게, 아득히 먼 남쪽의 잿빛 골짜기 경계선 도로 옆에 사는 은둔자 로어난 골드리프의 의뢰가 아직 남아 있거든. 자네가 암흑석 펜던트와 조율된 구리 다리보호구를 만들어서 이 주문을 처리해 준다면 내 어깨가 한결 가벼워질 텐데 말이야.",
  },
  [27646] = {
    ["T"] = "토르발트 딥포지를 위한 의뢰",
    ["O"] = "모한 카퍼텅은 당신의 대장기술을 사용하여 은 해골 열쇠 4개를 제작하고 남동쪽 모단 호수 왕의 계곡에 있는 토르발트 딥포지에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네 모험가... 아니 대장장이라고 해야 하나! 자네 도움이 필요하네.\n\n왕의 계곡 전초기지에 있는 토르발트 딥포지가 최근 오래된 금고 더미를 발견했는데 힘으로 열고 싶어하진 않더군. 그를 위해 은 해골 열쇠 몇 개를 만들어주면, 자네의 수고에 걸맞은 보상을 해줄 걸세.",
  },
  [27647] = {
    ["T"] = "산악경비대 스톰파이크를 위한 의뢰",
    ["O"] = "모한 카퍼텅은 당신의 대장기술을 사용하여 두꺼운 전투도끼 2개를 제작하고 모단 호수 북쪽 알가즈 주둔지에 있는 산악경비대 스톰파이크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "모단 호수 이쪽 편에서 가장 이름난 산악대원 중 한 명의 의뢰를 맡아보겠나? 알가즈 주둔지의 산악경비대 스톰파이크가 자신의 신병들에게 줄 도끼 몇 자루가 필요하다더군. 자네가 두꺼운 전투도끼 2자루를 만들어서 배달해 주면 그도 몹시 기뻐할 걸세.",
  },
  [27648] = {
    ["T"] = "지터스를 위한 의뢰",
    ["O"] = "가빈 나알트리는 당신의 대장기술을 사용하여 무거운 청동 철퇴 1개와 무거운 무게추 2개를 제작하고 그늘숲 서쪽의 까마귀 언덕에 있는 지터스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "어이, 너 이 마을에 새로 온 대장장이야? 어둠의순찰대 주문이 꽉 차서 이 민간인 주문은 도무지 손을 못 대고 있어. 날 도와줄 의향이 있다면, 무거운 청동 철퇴랑 무거운 무게추 몇 개 만들어서 까마귀 언덕으로 가져다줘. 주문한 사람이 계속 그 주위를 어슬렁거리고 있거든.",
  },
  [27649] = {
    ["T"] = "경비병 파커를 위한 의뢰",
    ["O"] = "베르너 오스구드는 당신의 대장기술을 사용하여 순은 방패 1개를 제작하고 붉은마루 산맥 동쪽의 세갈래 삼거리에 있는 경비병 파커에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "당신 혹시 대장장이 아니쇼? 오, 맞구려! 당신 도움이 필요하오.\n\n오크들이 쳐들어왔을 때 여기 있던 마지막 대장장이가 도망쳐 버려서, 우리 경비병들은 남은 찌끄러기로 연명하고 있소. 경비병 파커를 위한 순은 방패를 주문하고 싶은데, 골드샤이어에 요청하려니 도착하기까지 시간이 너무 오래 걸릴 것 같소. 만약 당신이 방패를 만들어 배달까지 해준다면 파커가 교환할 만한 물건들을 잘 챙겨줄 거요.",
  },
  [27650] = {
    ["T"] = "울샨을 위한 의뢰",
    ["O"] = "사이안데르는 당신의 대장기술을 사용하여 신속의 청동 단검 2개를 제작하고 잿빛 골짜기 중앙의 은빛바람 피난처에 있는 울샨에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 대장장이시군요! 절 도와주실 수 있겠어요 -- 은빛바람 피난처의 울샨이 새 단검이 들어온 거 없냐며 계속 절 성가시게 굴고 있답니다. 칼날표범 스테이크를 저미기 딱 좋은 무언가를 원하나 본데, 제가 만든 건 영 성에 차지 않는다더군요. 숙련된 대장장이라면 울샨의 목적에 딱 맞는 신속의 청동 단검을 만들 수 있다고 들었습니다. 그를 위해 단검 한 쌍을 만들어서 전달해 주신다면 그도 절 좀 내버려 둘지도 모릅니다!",
  },
  [27651] = {
    ["T"] = "결의의 롱브레이드를 위한 의뢰",
    ["O"] = "브란마르는 당신의 대장기술을 사용하여 은도금한 청동 건틀릿 3개를 제작하고 북부 습지대 던 모드르에 있는 결의의 롱브레이드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "내 사촌 롱브레이드는 던 모드르에서 검은무쇠단에 맞서 싸우는 민병대의 일원이지. 자기 부하들을 위해 은도금한 청동 건틀릿 3개를 요청했지만, 테라모어에서 들어오는 주문들 때문에 그걸 만들 틈이 없었어. 자네 꽤 유능해 보이는 대장장이인데--이 주문을 끝내서 배달해 주면 내 개인적인 감사를 표하지.",
  },
  [27652] = {
    ["T"] = "부관 도렌을 위한 의뢰",
    ["O"] = "부관 도렌은 당신의 대장기술을 사용하여 청동 전투도끼 1개, 청동 대검 1개, 청동 전투망치 1개를 제작하고 북부 가시덤불의 반란군 야영지에 있는 부관 도렌에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳에서 대장장이를 보게 되어 다행이군요. 보시다시피 아직 제대로 된 보급선을 갖추지 못했습니다. 그렇다고 자체적으로 무기를 대량 생산할 대장간이 있는 것도 아니고요. 제게 청동 전투도끼, 청동 대검, 청동 전투망치를 만들어 달라고 의뢰한다면, 당신이 대장기술에 더욱 정진할 수 있도록 기꺼이 물자를 지원하겠습니다.",
  },
  [27653] = {
    ["T"] = "대장 다릴을 위한 의뢰",
    ["O"] =
    "마리 홀드스턴은 당신의 대장기술을 사용하여 녹색 철제 투구 1개, 녹색 철제 팔보호구 1개, 녹색 철제 다리보호구 1개를 제작하고 먼지진흙 습지대의 북부 경비탑에 있는 대장 다릴에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "환영해요, 모험가님 -- 아니 동료 대장장이라 불러야 할까요?\n\n우린 테라모어 경비병 주문 때문에 일이 산더미인데, 저기 위 북부 경비탑의 대장 다릴에게서 특별 주문이 들어왔거든요. 이 주문에 신경 쓰느라 다른 주문들에 들인 공을 허투루 버리고 싶진 않네요. 이 일을 대신 맡아보실 생각 있나요? 그분은 녹색 철제 투구, 녹색 철제 다리보호구, 그리고 녹색 철제 팔보호구가 필요하대요.",
  },
  [27654] = {
    ["T"] = "모틀리 헤비브래스를 위한 의뢰",
    ["O"] = "맥스턴 스트랑은 당신의 대장기술을 사용하여 빛나는 강철 단검 2개를 제작하고 잊혀진 땅의 스퀴글코드 전초기지에 있는 모틀리 헤비브래스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "황무지에 온 걸 환영한다, 대장장이. 저기 문 앞의 악마들 때문에라도, 난 이 작은 전초기지에 무기와 갑옷을 원활히 공급하기 위해 손가락이 부서져라 일하고 있지!\n\n스퀴글코드 전초기지의 노움들도 주문을 넣기 시작했지만 도무지 짬이 안 나. 부탁 하나 들어주겠다면 빛나는 강철 단검을 몇 자루 만들어서 그곳에 있는 모틀리 헤비브래스에게 가져다줘.",
  },
  [27655] = {
    ["T"] = "소령 헬름스워시를 위한 의뢰",
    ["O"] = "다렌 말뷰는 당신의 대장기술을 사용하여 녹색 철제 사슬갑옷 1개를 제작하고 힐스브래드 구릉지의 사우스쇼어 근처 탑에 있는 소령 헬름스워시에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳엔 대장장이가 없어서 새 편자를 구하기 어렵지만, 사우스쇼어 경비병들을 생각하면 더 기가 막힙니다. 그들은 몇 년이나 묵은 낡은 갑옷과 무기로 간신히 연명하고 있어요.\n\n당신이 대장장이라고요? 음, 혹시 도울 생각이 있다면, 소령 헬름스워시가 입을 만한 새 녹색 철제 사슬갑옷을 만들어 주십시오. 그가 직접 부탁하진 않겠지만, 그를 단단한 갑옷으로 보호해야 합니다. 소령을 잃으면 다음 호드 공격을 어떻게 막아낼지 짐작조차 가지 않거든요!",
  },
  [27656] = {
    ["T"] = "관리인 알라리크를 위한 의뢰",
    ["O"] = "스쿼토는 당신의 대장기술을 사용하여 날렵한 황수정 아뮬렛 1개를 제작하고 아라시 고원 스트롬가르드 내부의 납골당에 있는 관리인 알라리크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "대장간은 있지만 대장장이는 없다는 사실을 눈치채셨을 겁니다. 당신이 기꺼이 이 상황을 바꿔주신다면, 관리인 알라리크가 부탁한 새 날렵한 황수정 아뮬렛 제작 주문서를 드릴게요. 제작이 끝나면 스트롬가르드 납골당의 알라리크에게 배달해 주시면 됩니다. 근처에 매복한 호드를 조심하시길!",
  },
  [27657] = {
    ["T"] = "샨드리스 페더문을 위한 의뢰",
    ["O"] = "샨드리스 페더문은 당신의 대장기술을 사용하여 강철 흉갑 6개를 제작하고 페랄라스의 페더문 요새에 있는 샨드리스 페더문에게 주문품을 가져가기를 원합니다.",
    ["D"] = "파수대에는 제작자가 거의 없으니 당신의 실력이 필요하군요, 대장장이. 새로운 파수꾼 신병들을 위해 당신에게 강철 흉갑 6벌 제작을 의뢰하고 싶습니다. 완성되면 부디 저에게 가져와 주십시오.",
  },
  [27658] = {
    ["T"] = "사령관 아쉬람 발러피스트를 위한 의뢰",
    ["O"] = "사령관 아쉬람 발러피스트는 당신의 대장기술을 사용하여 거대한 검은색 철퇴 2개를 제작하고 서부 역병지대 서리바람 야영지에 있는 사령관 아쉬람 발러피스트에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 대장장이라. 자네의 기술이 필요하네.\n\n스컬지가 후퇴했다 하더라도 전투를 계속하기 위해서는 새 무기가 필요하다네. 거대한 검은색 철퇴가 언데드를 상대하기 아주 좋은 무기라고 들었네만. 자네가 두 자루를 만들어 가져다주면, 그 무기에 관한 소문이 과연 사실인지 시험해 보겠네.",
  },
  [27659] = {
    ["T"] = "대족장 운갈을 위한 의뢰",
    ["O"] = "웬디 워블스미스는 당신의 대장기술을 사용하여 진은 해골 열쇠 4개를 제작하고 아즈샤라 북부 검은아귀 마을에 있는 대족장 운갈에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이봐요! 당신 대장장이 맞죠?\n\n검은아귀 펄볼그들에게 우리가 위협적인 존재가 아니라는 것을 보여주기 위해 상징적인 선물을 주면 어떨까 곰곰이 생각해보았어요. 딱 좋은 게 떠올랐죠. 진은 해골 열쇠예요. 알다시피, 우정의 열쇠 뭐 그런 뜻으로 말이에요. 우리 대신 열쇠를 제작해서 전달해 줄 대장장이의 도움이 필요해요. 관심 있으세요?",
  },
  [27660] = {
    ["T"] = "말리니 프로스트문을 위한 의뢰",
    ["O"] = "말리니 프로스트문은 당신의 대장기술을 사용하여 미스릴 코이프 1개와 미스릴 미늘 바지 1개를 제작하고 악령숲의 갈퀴가지 숲에 있는 말리니 프로스트문에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑습니다, $C. 당신 역시 노련한 대장장이라는 게 느껴지는군요. 악령숲의 지옥 마력이 제 지난 갑옷을 다 갉아먹었습니다. 새 미스릴 미늘 바지와 미스릴 코이프가 필요해요. 그것들을 만들어 주실 수 있다면 제가 가진 물건 일부를 대가로 드리겠습니다.",
  },
  [27661] = {
    ["T"] = "라르 프라울터스크를 위한 의뢰",
    ["O"] = "우아크는 당신의 대장기술을 사용하여 룬문자 구리 바지 1개와 룬문자 구리 팔보호구 1개를 제작하고 듀로타 센진 마을에 있는 라르 프라울터스크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네, $C. 동료 대장장이의 손길을 알아보겠군. 내 의뢰 중 하나를 직접 맡아보는 건 어떤가?\n\n저 아래 센진 마을의 라르 프라울터스크가 룬문자 구리 바지와 룬문자 구리 팔보호구 세트를 요청했다네. 관심 있다면 물건을 만들어서 직접 배달해 주게.\n\n칼바위 언덕 남쪽이니 오면서 봤을 게야.",
  },
  [27662] = {
    ["T"] = "감독관 힌크를 위한 의뢰",
    ["O"] = "우아크는 당신의 대장기술을 사용하여 구리 전투도끼 2개를 제작하고 듀로타의 오그리마 외곽 비행선 탑에 있는 감독관 힌크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "인사하네, $C. 이 의뢰들 좀 더 빨리 보내야 하는데 도움이 필요하군. 감독관 힌크가 일꾼들이 비행선 탑에서 전갈들을 내쫓는 데 사용할 구리 전투도끼를 요청해왔네.\n\n이 의뢰를 마칠 생각이라면, 여기서 북쪽에 있는 오그리마 외곽 비행선 탑의 감독관에게 도끼를 배달해 주게.",
  },
  [27663] = {
    ["T"] = "현자 레인토템을 위한 의뢰",
    ["O"] = "마흐노트 러프운드는 당신의 대장기술을 사용하여 거친 연마석 10개를 제작하고 멀고어 북동쪽 붉은바위에 있는 현자 레인토템에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑소, $C. 대장장이인 것 같구려. 혹시 전승지기님 중 한 분에게서 받은 의뢰를 대신 처리해 줄 수 있겠소?\n\n거친 연마석을 좀 만들어서 북동쪽 붉은바위의 현자 레인토템님께 가져다줄 사람이 필요하오. 망자를 위한 신성한 의식에 쓰시는 건데, 마침 내 재고가 뚝 떨어졌거든. 도와줄 의향이 있소?",
  },
  [27664] = {
    ["T"] = "이얀 이글탈론을 위한 의뢰",
    ["O"] = "마흐노트 러프운드는 당신의 대장기술을 사용하여 구리 철퇴 3개를 제작하고 멀고어의 썬더 블러프에 있는 이얀 이글탈론에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "얼마 전 이얀 이글탈론이 형제의 다가오는 의식을 축하하기 위해 구리 철퇴 몇 개를 찾으러 왔었소. 그는 철퇴 세 자루를 의뢰했지만 내 재고가 부족했고 썬더 블러프의 대장장이들은 제시간에 만들기에는 너무 바빴소. 자네가 이 주문을 빠르게 처리해 준다면 그도 몹시 고마워할 거요.",
  },
  [27665] = {
    ["T"] = "죽음의경비병 시머를 위한 의뢰",
    ["O"] =
    "아베 윈터스는 당신의 대장기술을 사용하여 무거운 구리 방패 1개와 구리 사슬 조끼 1개를 제작하고 티리스팔 숲 죽음의 종소리 마을 입구에 있는 죽음의경비병 시머에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "미안하지만 수다 떨 시간이 없군 -- 붉은십자군 놈들의 작전이 활발해지면서 물밀 듯 들어온 수많은 주문들 때문에 눈코 뜰 새가 없거든.\n\n저기 -- 당신도 모루를 다루는 데 재능이 있어 보이는데. 절 돕고 싶으시다면, 무거운 구리 방패와 구리 사슬 조끼를 만들어서 죽음의 종소리 마을 입구 밖에 주둔하고 있는 죽음의경비병 시머에게 전해주시오.",
  },
  [27666] = {
    ["T"] = "죽음의경비병 리니아를 위한 의뢰",
    ["O"] = "아베 윈터스는 당신의 대장기술을 사용하여 룬문자 구리 반지 2개를 제작하고 티리스팔 숲의 브릴 동쪽 도로 야영지에 있는 죽음의경비병 리니아에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "죽음의경비병 리니아로부터 온 주문이 있는데 날 대신해 맡아주면 어떨까 하오. 그녀는 룬문자 구리 반지 두 개를 원하고 있소. 반지 제작을 마치면 브릴을 빠져나가는 길을 따라 동쪽으로 향하면 그녀를 찾을 수 있소. 킷사펠 광산까지 갔다면 너무 멀리 간 거요.",
  },
  [27667] = {
    ["T"] = "세바스티안 멜로체를 위한 의뢰",
    ["O"] = "세바스티안 멜로체는 당신의 대장기술을 사용하여 일반 연마석 5개를 제작하고 은빛소나무 숲 공동묘지에 있는 세바스티안 멜로체에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "안녕하시오, $C. 마을에서 대장장이를 만나게 되어 기쁘군. 우리의 무기와 갑옷을 녹과 먼지로부터 보호하기 위해 일반 연마석 보충분이 좀 필요하오. 다섯 개를 만들어 내게 배달해 준다면 고맙겠소.",
  },
  [27668] = {
    ["T"] = "레인 요릭을 위한 의뢰",
    ["O"] = "세바스티안 멜로체는 당신의 대장기술을 사용하여 룬문자 구리 흉갑 1개와 룬문자 구리 팔보호구 1개를 제작하고 은빛소나무 숲 이바르 농장에 있는 레인 요릭에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "일거리를 더 찾고 있다면, 저기 이바르 농장의 레인 요릭이 오빠의 훼손된 갑옷을 대신할 룬문자 구리 흉갑과 룬문자 구리 팔보호구를 필요로 하고 있소. 이것들을 만들어 줄 수 있다면, 거기 있는 레인에게 가져다주시오. 이바르 농장은 공동묘지 북쪽에 있소.",
  },
  [27669] = {
    ["T"] = "우제크를 위한 의뢰",
    ["O"] = "트라우그는 당신의 대장기술을 사용하여 일반 숫돌 3개와 일반 무게추 3개를 제작하고 불모의 땅 북동쪽 천리길 경비초소에 있는 우제크에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 멀리서도 동료 대장장이를 알아볼 수 있지! 멀리라는 말이 나와서 말인데, 천리길 경비초소의 우제크가 숫돌과 무게추를 더 보내달라고 전갈을 보냈소. 내가 직접 그 의뢰를 처리할 시간이 안 났는데, 마을에 있는 김에 당신의 기술을 발휘해 주겠다면 이 의뢰를 맡겨도 좋소.",
  },
  [27670] = {
    ["T"] = "크라날 피스를 위한 의뢰",
    ["O"] = "트라우그는 당신의 대장기술을 사용하여 암흑석 펜던트 1개와 조율된 구리 다리보호구 1개를 제작하고 불모의 땅 그롤돔 농장에 있는 크라날 피스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "크로스로드와 그 너머에는 당신같이 진취적인 젊은 대장장이를 위한 일거리가 산더미처럼 많소. 자 보시오, 북쪽 도로 옆, 잿빛 골짜기 경계에서 멀지 않은 곳에 사는 은둔자 크라날 피스의 의뢰가 아직 남아 있소. 당신이 암흑석 펜던트와 조율된 구리 다리보호구를 만들어서 이 주문을 처리해 준다면 내 어깨가 한결 가벼워질 텐데 말이오.",
  },
  [27671] = {
    ["T"] = "브린을 위한 의뢰",
    ["O"] = "테터낵 스틸포지는 당신의 대장기술을 사용하여 은 해골 열쇠 4개를 제작하고 남부 불모의 땅 검은가시 마루 꼭대기에 있는 브린에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "반갑네 모험가... 게다가 대장장이이기도 하군! 자네 도움이 필요하네.\n\n브린이라는 은둔 주술사가 나한테 은 해골 열쇠 몇 개를 만들어달라고 요청했는데 은이 다 떨어져서 말이야. 만약 자네가 은을 구해서 그 주문을 처리해 준다면, 대족장께서 명하신 이 새 무기들을 만드는 데에 집중할 수 있을 것 같군.",
  },
  [27672] = {
    ["T"] = "갠 스톤스파이어를 위한 의뢰",
    ["O"] = "테터낵 스틸포지는 당신의 대장기술을 사용하여 두꺼운 전투도끼 2개를 제작하고 불모의 땅 남부 황금길에 있는 갠 스톤스파이어에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "어떤 타우렌 하나가 가시멧돼지들이 그 대상단을 습격한 이후로 남쪽 황금길을 계속 여행하고 있네. 그 끈기는 존경할 만하지만 더 나은 무장을 한다면 더 오래 버틸 수 있을 텐데 말이지.\n\n아직 그를 위해 두꺼운 전투도끼 2개를 만들 시간은 없었지만, 자네라면 해낼 수 있을 거네. 제작을 끝내고 남쪽으로 뻗은 도로를 순찰하는 그를 찾아보게.",
  },
  [27673] = {
    ["T"] = "토렉을 위한 의뢰",
    ["O"] = "작업반장 바란은 당신의 대장기술을 사용하여 무거운 청동 철퇴 1개와 무거운 무게추 2개를 제작하고 잿빛 골짜기 은빛날개 전초기지 동쪽 언덕에 있는 토렉에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "어이, 너 이 마을에 새로 온 대장장이야? 전쟁노래 부족의 주문이 꽉 차서 이 최우선 주문은 도무지 손을 못 대고 있어. 날 도와줄 의향이 있다면, 무거운 청동 철퇴랑 무거운 무게추 몇 개 만들어서 은빛날개 전초기지 근처 언덕의 토렉에게 가져다줘. 녀석은 지금 저기 위에서 분대와 함께 기습 공격을 준비하고 있거든.",
  },
  [27674] = {
    ["T"] = "죽음의추적자 레시를 위한 의뢰",
    ["O"] = "오트는 당신의 대장기술을 사용하여 순은 방패 1개를 제작하고 남서부 힐스브래드 구릉지 남쪽초소에 있는 죽음의추적자 레시에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "당신 혹시 대장장이 아니쇼? 오, 맞구려! 당신 도움이 필요하오.\n\n타렌 제분소의 마지막 대장장이가 3차 대전쟁 때 죽어버려서, 우리 경비병 중 일부는 남은 찌끄러기로 연명하고 있소. 죽음의추적자 레시를 위한 순은 방패를 주문하고 싶은데, 언더시티에 갑옷을 요청하려니 도착하기까지 시간이 너무 오래 걸릴 것 같소. 만약 당신이 방패를 만들어 배달까지 해준다면 레시가 교환할 만한 물건들을 잘 챙겨줄 거요.",
  },
  [27675] = {
    ["T"] = "위즐로 베어링샤이너를 위한 의뢰",
    ["O"] = "위즐로 베어링샤이너는 당신의 대장기술을 사용하여 신속의 청동 단검 2개를 제작하고 버섯구름 봉우리 하얀여울 주둔지에 있는 위즐로 베어링샤이너에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 대장장이시군요! 절 도와주실 수 있겠어요 -- 짐마차가 또 공격받을 때를 대비해야 해요, 그래서 좀 괜찮은 단검 두어 자루가 있었으면 좋겠어요. 재빠른 걸로요, 아시죠? 반짝이고, 재빠른 거. 처리해 주실 수 있나요?",
  },
  [27676] = {
    ["T"] = "다른 탈론그립을 위한 의뢰",
    ["O"] = "딧시 스프링소켓은 당신의 대장기술을 사용하여 은도금한 청동 건틀릿 3개를 제작하고 남부 돌발톱 산맥 말라카진에 있는 다른 탈론그립에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "야, 너 대장장이야? 어떤 오크 녀석이 대장간에 쪽지를 남겼어. 지나가는 대장장이가 있으면 은도금한 청동 건틀릿 3켤레를 구해 달라고 말이지. 관심 있으면 만들어서 말라카진에 있는 다른 탈론그립에게 가져가 봐.",
  },
  [27677] = {
    ["T"] = "헤멧 네싱워리를 위한 의뢰",
    ["O"] = "바르는 당신의 대장기술을 사용하여 청동 전투도끼 1개, 청동 대검 1개, 청동 전투망치 1개를 제작하고 북부 가시덤불 네싱워리 원정대에 있는 헤멧 네싱워리에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳에서 대장장이를 또 보게 되어 다행이군. 드워프 사냥꾼 헤멧 네싱워리한테서 온 제작 의뢰가 하나 있는데. 내 생각에 얼라이언스가 아직 제대로 된 보급선을 갖추지 못한 모양이야. 녀석의 무기를 지원해 주지 못하는 걸 보면.\n\n나 혼자 얼라이언스 영토 가까이 가고 싶지는 않네. 그러니 자네에게 청동 전투도끼, 청동 대검, 청동 전투망치를 만들어 녀석의 야영지에 있는 헤멧에게 가져다달라고 의뢰하겠네, 부탁할게.",
  },
  [27678] = {
    ["T"] = "\"늪지눈알\" 자를을 위한 의뢰",
    ["O"] =
    "줄르그는 당신의 대장기술을 사용하여 녹색 철제 투구 1개, 녹색 철제 팔보호구 1개, 녹색 철제 다리보호구 1개를 제작하고 먼지진흙 습지대의 늪지기 오두막에 있는 \"늪지눈알\" 자를에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "너 금속 두드리는 녀석이냐?\n\n인간 갑옷 달란다. 난 인간 몸에 맞출 줄 모른다. 오로지 무기뿐. 그 녀석 녹색 철제 투구, 녹색 철제 다리보호구, 녹색 철제 팔보호구 필요하단다. 너 금속 두드리면 마녀의 언덕에 있는 늪지눈알 녀석에게 갖다줘라.",
  },
  [27679] = {
    ["T"] = "애니 그림을 위한 의뢰",
    ["O"] = "타카타 스틸블레이드는 당신의 대장기술을 사용하여 빛나는 강철 단검 2개를 제작하고 잊혀진 땅의 그늘수렵마을에 있는 애니 그림에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "황무지에 온 걸 환영한다, 대장장이. 내 동생도 대장장이인데, 지금 그녀의 솜씨가 여기서 꼭 필요하다. 언더시티의 그 연금술사 녀석이 단검을 좀 사고 싶어 하던데, 그늘수렵마을의 트롤들은 주로 도끼만 거래하거든. 빛나는 강철 단검을 만들 실력이 된다면 그늘수렵마을의 애니 그림이 널 반갑게 맞이해 줄 거다.",
  },
  [27680] = {
    ["T"] = "고른을 위한 의뢰",
    ["O"] = "니카 블러드스카는 당신의 대장기술을 사용하여 녹색 철제 사슬갑옷 1개를 제작하고 황야의 땅 카르가스에 있는 고른에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳엔 대장장이가 없어서 새 갑옷을 구하기 어렵지만, 고른 같은 아웃라이더들을 생각하면 더 기가 막힙니다. 그 녀석은 드레노어에서 가져온 갑옷과 무기로 간신히 연명하고 있어요!\n\n당신이 대장장이라고요? 음, 혹시 도울 생각이 있다면, 고른이 입을 만한 새 녹색 철제 사슬갑옷을 만들어 주십시오. 녀석이 직접 부탁하진 않겠지만, 그를 단단한 갑옷으로 보호해야 합니다. 아웃라이더를 잃으면 다음 얼라이언스 공격을 어떻게 막아낼지 짐작조차 가지 않거든요!",
  },
  [27681] = {
    ["T"] = "선장 스틸구트를 위한 의뢰",
    ["O"] = "고르멀은 당신의 대장기술을 사용하여 날렵한 황수정 아뮬렛 1개를 제작하고 아라시 고원 남쪽 팔디르의 만에 있는 선장 스틸구트에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "나는 대장장이지만 요즘엔 영 대장간에서 일할 맘이 나질 않는군.\n\n선장 스틸구트가 오랫동안 떨어져 지낸 부인에게 사과 선물로 줄 날렵한 황수정 아뮬렛을 만들어줄 수 없냐며 해머폴에 전갈을 보내왔소. 그분의 부탁을 무시하고 싶진 않으니, 당신이 이 의뢰를 좀 채워주시겠소? 선장은 팔디르의 만에 정박해 있소.",
  },
  [27682] = {
    ["T"] = "로크 올한을 위한 의뢰",
    ["O"] = "로크 올한은 당신의 대장기술을 사용하여 강철 흉갑 6개를 제작하고 페랄라스의 모자케 야영지에 있는 로크 올한에게 주문품을 가져가기를 원합니다.",
    ["D"] = "모자케 야영지에는 제작자가 거의 없으니 당신의 실력이 필요하군요, 대장장이. 새로운 신병들을 위해 당신에게 강철 흉갑 6벌 제작을 의뢰하고 싶습니다. 완성되면 부디 저에게 가져와 주십시오.",
  },
  [27683] = {
    ["T"] = "눈테지 투벤드를 위한 의뢰",
    ["O"] = "눈테지 투벤드는 당신의 대장기술을 사용하여 거대한 검은색 철퇴 2개를 제작하고 타나리스 안제와타에 있는 눈테지 투벤드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 대장장이라. 당신의 기술이 필요하군.\n\n실리시드가 물러났다 하더라도 전투를 계속하기 위해서는 새 무기가 필요하다오. 거대한 검은색 철퇴가 그 생물들을 상대하기 아주 좋은 무기라고 들었지. 당신이 두 자루를 만들어 가져다주면 그 무기에 관한 소문이 과연 사실인지 시험해 보겠소.",
  },
  [27684] = {
    ["T"] = "그룰 다크블레이드를 위한 의뢰",
    ["O"] = "그룰 다크블레이드는 당신의 대장기술을 사용하여 진은 해골 열쇠 4개를 제작하고 아즈샤라 발로르모크에 있는 그룰 다크블레이드에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "록타르! 당신 대장장이 맞지?\n\n이 바다를 강타하는 위험한 폭풍 속에서 여러 난파선의 상자와 상자들이 아즈샤라 기슭으로 밀려오고 있다. 그것들 중 일부를 열어보고 싶은데 진은 해골 열쇠가 필요해. 여기에 만들어 배달해 주면 이 기지에 보급품을 대는 데 도움이 될 거다 -- 그리고 얼라이언스 손에 그 보물이 들어가는 것도 막을 수 있지.",
  },
  [27685] = {
    ["T"] = "드레카술을 위한 의뢰",
    ["O"] = "드레카술은 당신의 대장기술을 사용하여 미스릴 코이프 1개와 미스릴 미늘 바지 1개를 제작하고 악령숲 피멍울 초소에 있는 드레카술에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "대장장이야? 너의 능력이 필요해.\n\n남편의 죽음을 안 이상 남편의 발자취를 따라 악마를 무찌르고 이 땅을 더 안전한 곳으로 만들려고 해. 그이가 이룬 업적의 절반이라도 달성하려면 방어구가 필요해. 미스릴 코이프와 미스릴 미늘 바지를 가져와 줘, 그럼 보상할게.",
  },
  [27782] = {
    ["T"] = "용서",
    ["O"] = "",
    ["D"] = "",
  },
  [27880] = {
    ["T"] = "전쟁노래 협곡 전투",
    ["O"] = "전쟁노래 협곡에서 3번 승리한 후 잿빛 골짜기의 은빛날개 숲에 있는 파수꾼 파송에게 돌아가십시오. (이 퀘스트는 매주 한 번씩 완료할 수 있습니다.)",
    ["D"] =
    "은빛날개 파수대는 오크들이 숲을 훼손하는 것을 막기 위해 전쟁노래 아웃라이더와 전쟁 중입니다. 하지만 단순히 자연을 사랑하는 마음 외에도 이 숲을 보호해야 할 더 큰 이유가 있습니다.\n\n이 숲은 잿빛 골짜기를 대규모 공격으로부터 지킬 수 있는 전략적 장벽입니다. 숲이 없었다면 아스트라나르는 불모의 땅에 합병되기까지 이틀도 버티지 못했을 것입니다.\n\n전쟁노래 아웃라이더에 맞서 당신의 몫을 다하십시오, $N! 얼라이언스를 위하여!",
  },
  [27881] = {
    ["T"] = "전쟁노래 협곡 전투",
    ["O"] = "전쟁노래 협곡에서 3번 승리한 후 잿빛 골짜기의 은빛날개 숲에 있는 파수꾼 파송에게 돌아가십시오. (이 퀘스트는 매주 한 번씩 완료할 수 있습니다.)",
    ["D"] =
    "은빛날개 파수대는 오크들이 숲을 훼손하는 것을 막기 위해 전쟁노래 아웃라이더와 전쟁 중입니다. 하지만 단순히 자연을 사랑하는 마음 외에도 이 숲을 보호해야 할 더 큰 이유가 있습니다.\n\n이 숲은 잿빛 골짜기를 대규모 공격으로부터 지킬 수 있는 전략적 장벽입니다. 숲이 없었다면 아스트라나르는 불모의 땅에 합병되기까지 이틀도 버티지 못했을 것입니다.\n\n전쟁노래 아웃라이더에 맞서 당신의 몫을 다하십시오, $N! 얼라이언스를 위하여!",
  },
  [27882] = {
    ["T"] = "전쟁노래 협곡 전투",
    ["O"] = "전쟁노래 협곡에서 3번 승리한 후 불모의 땅 몰샨 주둔지에 있는 부대장 쉐터스컬에게 돌아가십시오. (이 퀘스트는 매주 한 번씩 완료할 수 있습니다.)",
    ["D"] =
    "전쟁노래 협곡에서 은빛날개 파수대를 상대로 벌이는 전투는 대단히 중요합니다. 얼라이언스는 자기들 소유도 아닌 숲을 보호한다는 구실로, 우리 호드로부터 가장 큰 목재 공급원 중 하나를 빼앗으려 하고 있습니다.\n\n이런 일이 일어나게 내버려 둬서는 안 됩니다, $N! 호드를 섬기고 명예롭게 싸우십시오!",
  },
  [27883] = {
    ["T"] = "전쟁노래 협곡 전투",
    ["O"] = "전쟁노래 협곡에서 3번 승리한 후 불모의 땅 몰샨 주둔지에 있는 부대장 쉐터스컬에게 돌아가십시오. (이 퀘스트는 매주 한 번씩 완료할 수 있습니다.)",
    ["D"] =
    "전쟁노래 협곡에서 은빛날개 파수대를 상대로 벌이는 전투는 대단히 중요합니다. 얼라이언스는 자기들 소유도 아닌 숲을 보호한다는 구실로, 우리 호드로부터 가장 큰 목재 공급원 중 하나를 빼앗으려 하고 있습니다.\n\n이런 일이 일어나게 내버려 둬서는 안 됩니다, $N! 호드를 섬기고 명예롭게 싸우십시오!",
  },
  [27884] = {
    ["T"] = "생존의 의지",
    ["O"] = "스톰윈드의 빛의 대성당에 있는 대주교 베네딕투스에게 말하십시오.",
    ["D"] =
    "반갑습니다, $N. 대주교 베네딕투스 님의 서신을 가져왔습니다. 포세이큰 연구에 관심이 있는 사람을 찾고 계십니다. 당신이라면 관심이 있을 것 같군요.\n\n관심이 있다면 스톰윈드 대성당에서 그분을 찾아보십시오.",
  },
  [27885] = {
    ["T"] = "생존의 의지",
    ["O"] = "동부 역병지대의 구울과 누더기골렘에게서 부패한 장기 30개를 모아 아이언포지 땜장이 마을에 있는 라이다 크리스탈팝에게 가져가십시오.",
    ["D"] =
    "포세이큰은 가장 위험한 적임을 스스로 증명해 보였습니다, $C. 그들은 교활하고 교묘하며 믿을 수 없는 존재일 뿐만 아니라 자연의 질서와 빛 자체를 거스르는 범죄 행위입니다.\n\n하지만 리치 왕의 지배를 벗어날 때는 엄청난 의지력을 보여주기도 했습니다. 우리가 스컬지의 또 다른 공격에서 살아남으려면 포세이큰이 어떻게 그것을 해냈는지 가능한 한 많이 이해하는 것이 최우선 과제입니다. 동부 역병지대에 있는 그들의 사촌인 구울과 누더기골렘들을 도축하는 것부터 시작하십시오. 그들의 연약한 부위를 모아서 연금술사 라이다 크리스탈팝에게 가져가십시오. 아이언포지의 연금술 연구실에서 그녀를 찾을 수 있습니다.",
  },
  [27886] = {
    ["T"] = "생존의 의지",
    ["O"] = "라이다의 정신 차단 수정을 동부 역병지대의 저주의 밴시, 원한의 밴시, 죽음의 밴시에게 시험하십시오.",
    ["D"] =
    "포세이큰은 자신들이 리치 왕의 정신 지배에서 벗어났다고 말합니다. 만약 그렇다면 정신 공격을 차단해 대상을 지배로부터 떼어낼 수 있을 겁니다. 이론적으로 언데드는 이후 공격성을 잃고 호의적으로 변해야 합니다.\n\n제가 고안한 이 보석을 가져가서 동부 역병지대의 밴시들에게 시험해 주십시오. 대조를 위해 한 마리 이상 표본을 수집하셔야 합니다. 시험할 대상 목록을 준비했습니다. 결과를 제게 알려주십시오.",
  },
  [27887] = {
    ["T"] = "생존의 의지",
    ["O"] = "스톰윈드 빛의 대성당에 있는 수사 크롤리에게 보고하십시오.",
    ["D"] =
    "이 사실을 알아선 안 되겠지만, $N, 붉은십자군이 로데론의 옛 주민을 스톰윈드로 데려왔고 대주교가 그들을 대성당 지하에 가둬 두었습니다. 불쌍한 사람은 아직 스컬지의 일부지만 아직 구울로 변하지는 않았습니다. 그게 우리가 필요로 하는 단서 아닐까요?\n\n대성당에 있는 수사 크롤리와 이야기하여 죄수에게 정신 차단 수정을 실험할 수 있게 허락해줄 수 있는지 알아보세요. 성공한다면 녀석을 치유할 수 있을지도 모릅니다!",
  },
  [27888] = {
    ["T"] = "생존의 의지",
    ["O"] = "라이다의 정신 차단 수정을 나일스 버만에게 시험해본 후, 수사 크롤리에게 돌아가 결과를 보고하십시오.",
    ["D"] =
    "단 한 가지 조건만 지켜주신다면 포로에게 당신의 이론을 실험하게 해드리겠습니다. 그 결과를 다른 누구보다 먼저 저에게 보고하십시오. 우리 요원들이 이 녀석을 다치지 않게 생포하느라 상당한 노력을 기울였습니다. 내가 연구에서 소외되지 않도록 확실히 해주는 게 최소한의 예의일 텐데요.\n\n그렇게 하시겠습니까?",
  },
  [27889] = {
    ["T"] = "생존의 의지",
    ["O"] = "스톰윈드에 있는 기록관 로이와 이야기하십시오.",
    ["D"] =
    "실험이 완전한 낭비였다고 생각하진 않습니다. 대주교님이 아셔야 할 정보는 제가 알아서 보고하죠.\n\n만약 여기서 얻은 지식을 바탕으로 연구를 더 발전시키고 싶다면, 스톰윈드의 기록관 로이와 이야기해보십시오.\n\n이것으로 신세는 진 걸로 하겠습니다.",
  },
  [27890] = {
    ["T"] = "생사의 문제",
    ["O"] = "썬더 블러프의 장로의 봉우리에 있는 마가타 그림토템을 찾으십시오.",
    ["D"] =
    "반갑습니다, $N. 마가타 그림토템의 서신을 가져왔습니다. 그녀가 아무도 모르게 일을 맡아줄 사람을 찾고 있거든요. 포세이큰에 관련된 일입니다.\n\n당신은 신뢰할 수 있는 $C임을 알고 있기에 이 일에 적임자라고 생각합니다. 그녀는 썬더 블러프 장로의 봉우리에 있습니다. 그리고 $N, 누가 물어보면 제가 이 이야기를 했다고 하지 마십시오.",
  },
  [27891] = {
    ["T"] = "생사의 문제",
    ["O"] = "동부 역병지대의 구울과 누더기골렘에게서 부패한 장기 30개를 모아 언더시티의 연금술 실험실에 있는 홀카 그레이혼에게 가져가십시오.",
    ["D"] =
    "우리의 동맹인 포세이큰은 우리에게 여전히 수수께끼로 남아 있습니다. 의심스러우면서도 흥미로운데, 좀 더 이해하고 싶지 않으신가요?\n\n동부 역병지대에 있는 그들의 사촌인 구울과 누더기골렘을 도축하는 것부터 시작하십시오. 민감한 장기들을 모아 내 대리인인 홀카 그레이혼에게 가져가십시오. 그녀는 언데드시티의 연금술 실험실에 있습니다.",
  },
  [27892] = {
    ["T"] = "생사의 문제",
    ["O"] = "홀카의 정신 차단 수정을 동부 역병지대의 저주의 밴시, 원한의 밴시, 혹은 죽음의 밴시에게 시험하십시오.",
    ["D"] =
    "포세이큰은 자신들이 리치 왕의 정신 지배에서 벗어났다고 말합니다. 만약 그렇다면 정신 공격을 차단해 대상을 지배로부터 떼어낼 수 있을 겁니다. 이론적으로 언데드는 이후 공격성을 잃고 호의적으로 변해야 합니다.\n\n제가 고안한 이 보석을 가져가서 동부 역병지대의 밴시들에게 시험해 주십시오. 대조를 위해 여러 마리에게 시험해 보셔야 합니다. 결과를 제게 알려주십시오.",
  },
  [27893] = {
    ["T"] = "생사의 문제",
    ["O"] = "언더시티의 연금술 실험실에 있는 수석 연금술사 파라넬에게 홀카의 연구에 대해 이야기하십시오.",
    ["D"] =
    "포세이큰이라는 존재의 본질--생과 사의 경계에 있는 것--이 과학의 영역을 벗어난 것이 아니라면 지금 우리가 보고 있는 현상을 전혀 이해할 수 없군요. 누락된 퍼즐 조각이 있으니 포세이큰 일원을 연구에 참여시킬 수밖에 없겠습니다. 이 데이터를 수석 연금술사 파라넬에게 보여주고 그의 의견을 들어보십시오.",
  },
  [27894] = {
    ["T"] = "생사의 문제",
    ["O"] = "포세이큰에 대해 당신이 알게 된 사실을 가지고 썬더 블러프 장로의 봉우리에 있는 마가타 그림토템에게 돌아가십시오.",
    ["D"] =
    "그렇군, 그래서 홀카가 포세이큰을 직접 연구하고 있었던 거로군.\n\n당신은 내가 이 소식을 듣고 화를 낼 거라고 생각했겠지만, 그렇지 않아. 우리가 이렇게 살아가고 있음에도 우리가 왜 존재하는지에 대해선 대부분 수수께끼로 남아 있지. 적어도 나는 그렇게 느끼고, 난 대부분의 다른 이들보다 스컬지의 본질을 연구하는 데 많은 시간을 쏟았으니까.\n\n내가 내린 결론은 이렇소. 어둠의 여왕께서 직접 말씀하셨듯이 이 존재는 저주요. 누군가는 어둠의 축복이라 부를 테고 혜택도 확실히 있지만, 저주임에는 변함이 없지. 오직 어리석은 자만이 자발적으로 우리 대열에 합류하려 할 거요.\n\n다시 말해, 언데드로 깨어났다고 해서 모두가 삶을 이어나가는 데 성공하는 것은 아니란 얘기요. 포세이큰이 된다는 것은 생명 그 자체마저 당신을 버렸을 때조차 살아남으려는 의지력을 갖는 것이지. 그 메시지를 주인에게 전해주시오.",
  },
  [27895] = {
    ["T"] = "생사의 문제",
    ["O"] = "썬더 블러프에 있는 용사 시크를 찾으십시오.",
    ["D"] =
    "포세이큰에 대해 배울 것이 훨씬 더 많을 거라 생각합니다. 그들과 더 가까워지고 싶다면 지금까지 모은 기술을 활용하여 썬더 블러프의 용사 시크와 이야기해보는 것이 좋겠군요.\n\n자, 이제 물러가시오!",
  },
  [27896] = {
    ["T"] = "별의 징표",
    ["O"] = "동부 내륙지 맹금의 봉우리에 있는 폴스타트 와일드해머에게 말하십시오.",
    ["D"] =
    "반갑군 $N! 혹시 천문학에 관심 있나? 조만간 아주 특별한 천체 현상이 일어날 거라는 얘기를 들었는데 -- 맹금의 봉우리의 와일드해머 드워프들이 그와 관련된 중요한 의식을 도울 용감한 모험가를 찾고 있다는군.\n\n하지만 명심해 -- 와일드해머 부족은 저 야생의 타우렌 종족처럼 대지모신을 섬긴다네. 이 일을 맡는다면 자네도 그 소 녀석들과 어울려야 할 거야.\n\n자네는 어떨지 몰라도 나는 말대꾸하지 않는 스테이크가 더 좋거든.\n\n그래도 관심이 있다면 맹금의 봉우리로 가서 폴스타트를 찾아보게.",
  },
  [27897] = {
    ["T"] = "별의 징표",
    ["O"] = "멀고어와 불모의 땅 사이의 언덕에 있는 대지모신의 안식처에서 별의 예언자 나로와 말하십시오.",
    ["D"] =
    "거대한 깃털 그리핀이시여, 방금 저거 보았나? 하늘에서 떨어지는 유성을! 우리가 기다리던 바로 그 징조야 -- 마침내 대지모신의 안식처 동굴이 열렸다는 뜻이지. 별의 예언자 나로가 멀고어와 불모의 땅 사이 경계에 있는 썬더 블러프 북동쪽 언덕에서 그곳을 감시하고 있다네. 그곳은 호드 구역이라, 대지모신의 심장을 되찾기 위해 별의 예언자를 도와줄 용감무쌍한 모험가를 찾고 싶었어.\n\n내가 왜 우리 사람을 보내지 않나 궁금하겠지? 음, 이 모든 걸 예견한 예언에 따르면 오로지 이방인만이 대지모신의 보물을 무사히 옮길 수 있다더군. 그래서 자네가 할 의향이 있다면 칼림도어로 가는 다음 배편에 자네 이름을 적어놓겠어.",
  },
  [27898] = {
    ["T"] = "별의 징조",
    ["O"] = "썬더 블러프에 있는 잔겐 스톤후프와 대화하십시오.",
    ["D"] =
    "인사드립니다 $N님! 천문학에 관심이 있으신가요? 아주 특별한 천문 현상이 곧 일어날 것이라고 들었습니다. 주술사 잔겐 스톤후프가 이와 관련된 중요한 의식을 도와줄 대담한 모험가를 찾고 있다고 합니다.\n\n그는 썬더 블러프 중앙 봉우리에 있는 케른 블러드후프 근처에 있습니다.",
  },
  [27899] = {
    ["T"] = "별의 징조",
    ["O"] = "멀고어와 불모의 땅 사이의 언덕에 있는 대지모신의 안식처에서 별견자 나로와 대화하십시오.",
    ["D"] =
    "하늘에 떠 있는 그 빛을 보셨습니까? 징조입니다. 대지모신의 안식처에 있는 동굴이 드디어 열렸습니다. 별견자 나로가 썬더 블러프 북동쪽, 멀고어와 불모의 땅 사이의 경계 언덕에서 그곳을 지켜보고 있습니다. 예언에 따르면 외부인만이 별견자를 도와 대지모신 자녀들의 쌍둥이 심장을 되찾을 수 있다고 합니다. 우리를 기꺼이 돕고자 하신다면 지금이 바로 그때입니다. 붉은바위 북쪽 절벽을 따라 별견자에게 올라가는 길을 찾으실 수 있습니다.",
  },
  [27900] = {
    ["T"] = "대지모신의 은혜",
    ["O"] =
    "대지모신의 안식처에 있는 동굴에서 안쉬의 심장과 무샤의 심장을 되찾아 별견자 나로에게 가져가십시오.",
    ["D"] =
    "타우렌과 드워프가 존재하기 전, 성과 마을이 세워지기 아주 오래전, 대지모신께서 이 땅을 거니셨습니다. 그녀의 숨결은 바람을 일으키고, 웃음은 꽃을 피웠으며, 결국 그녀가 피조물들을 보호하기 위해 자신을 희생했을 때, 우리는 그녀가 다양한 형태로 여러 번 우리에게 돌아올 것임을 알았습니다. 그녀의 전갈은 별에 새겨지고, 바람에 실려오며, 대지에 묻혀 있습니다.\n\n불의 두 달이 하늘을 가로질러 달릴 때 외부인이 우리에게 올 것이라고 예언되었고, 당신이 바로 그 사람입니다. 당신의 임무는 간단합니다. 등 뒤, 언덕을 조금 내려가면 동굴이 있습니다. 어둠의 영혼들이 그곳에 들끓고 있을 것입니다. 그들을 처치하고, 대지모신께서 그곳에 남겨둔 두 가지 보물, 즉 그녀의 자녀들의 쌍둥이 심장을 되찾으십시오. 심장을 저에게 가져오시면 그것들을 어떻게 사용해야 할지 알려드리겠습니다.",
  },
  [27901] = {
    ["T"] = "대지모신의 은혜",
    ["O"] =
    "불모의 땅 대지모신의 제단에서 태양 빛으로 안쉬의 심장을 충전하고, 돌발톱 산맥 대지모신의 제단에서 달빛으로 무샤의 심장을 충전하십시오.",
    ["D"] =
    "대지모신께서 자신의 피조물이 어둠의 속삭임에 타락한 것을 보셨을 때, 그녀가 흘린 눈물 하나가 푸른 아이, 즉 로쇼가 되었습니다. 그녀가 창조를 위해 몸을 바쳤을 때 두 방울의 눈물을 더 흘렸는데, 그것이 지금 당신이 쥐고 있는 돌입니다.\n\n이것들을 제대로 사용하려면 대지모신의 자녀들의 빛으로, 그들 어머니에게 신성한 장소에서 충전되어야 합니다.\n\n진흙 늪 남동쪽 산 정상에 있는 제단으로 안쉬의 심장을 가져가십시오. 빛나는 한낮에 제단 위에 올려놓아 안쉬의 힘을 흡수하게 하십시오.\n\n마찬가지로 무샤의 심장은 해바위 야영지 북쪽 언덕, 돌발톱 동굴 근처 제단으로 가져가야 합니다. 그곳에 밤에 올려두어 무샤의 힘을 흡수하십시오.\n\n이 일을 마치고 나서야만 제게 돌아오십시오.",
  },
  [27902] = {
    ["T"] = "대지모신의 은혜",
    ["O"] = "쌍둥이 심장의 힘을 이용해 대지모신의 뼈를 정화하십시오.",
    ["D"] =
    "이제 당신은 대지모신의 쌍둥이 자녀, 안쉬와 무샤의 강화된 심장을 가지고 있습니다. 이것은 당신에게 오랫동안 남아있던 악을 물리칠 힘을 줄 것입니다.\n\n제 천막 남쪽 절벽을 따라 튀어나온 커다란 바위로 가십시오. 이것은 대지모신의 뼈이며, 어둠의 영혼이 공격할 때를 기다리며 그곳에 은신해 있습니다. 완전한 힘을 갖추기 전까지는 나타나지 않았지만, 그 때가 다가왔습니다. 그러나 쌍둥이 심장을 이용하면 그것을 물리칠 수 있습니다.\n\n안쉬의 심장은 대지모신이 자녀들에게 베푼 사랑으로 당신을 강화하여 체력을 증가시킵니다. 무샤의 심장은 적을 약화시키고 공격에 취약하게 만듭니다.\n\n이 임무를 완수하면 모든 대지모신의 자녀들에게 변함없는 존경을 받게 될 것입니다.",
  },
  [27903] = {
    ["T"] = "대지모신의 은혜",
    ["O"] = "다르나서스 달의 신전에 있는 역사가 디미트레스쿠와 대화하십시오.",
    ["D"] =
    "노력 덕분에 당신은 대지모신의 축복을 부를 권리를 얻었습니다. 당신의 동족 중에서도 그녀의 힘을 발동하는 방법을 아는 자가 몇 명 있을 겁니다. 더 자세히 알고 싶다면 다르나서스 시에 있는 역사가 디미트레스쿠와 대화하십시오.\n\n안녕히 가십시오, $N. 평화롭게 $R와 만나게 되어 기쁩니다.",
  },
  [27904] = {
    ["T"] = "대지모신의 은혜",
    ["O"] = "썬더 블러프 수렵의 봉우리에 있는 용사 사이크와 대화하십시오.",
    ["D"] =
    "노력 덕분에 당신은 대지모신의 축복을 부를 권리를 얻었습니다. 더 자세히 알고 싶다면 썬더 블러프 수렵의 봉우리에 있는 용사 사이크와 대화할 수 있습니다.\n\n안녕히 가십시오, $N. 평안히 가시길.",
  },
  [27905] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "먼지진흙 습지대 테라모어 섬에 있는 여군주 제이나 프라우드무어에게 오크에 대한 정보를 물어보십시오.",
    ["D"] =
    "오크에 대해 더 배우고 싶어 한다는 소문을 들었습니다. 그런 욕구를 누구와 나누는지 조심하는 것이 좋겠습니다. 전쟁에서 일어난 일을 모두가 용서한 것은 아니니까요.\n\n진정으로 오크에 대한 편견 없는 관점을 얻고 싶다면, 제가 믿을 수 있는 사람은 오직 여군주 제이나 프라우드무어뿐입니다.\n\n그녀는 먼지진흙 습지대의 테라모어 섬 총독이며, 오크들이 얼라이언스 내에서 친구라 부를 수 있는 가장 가까운 인물입니다.",
  },
  [27906] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "오그리마 스랄의 방에 있는 나즈그렐과 대화하여 오크에 대해 배우고 싶다는 관심을 표명하십시오.",
    ["D"] =
    "우리의 동맹인 오크에 대해 더 배우고 싶어 한다는 소문을 들었습니다. 그것이 사실이라면 나즈그렐과 대화해야 합니다. 오그리마 스랄의 방에서 그를 찾을 수 있습니다.",
  },
  [27907] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "슬픔의 늪으로 여행하여 대화할 수 있는 오크가 있는지 찾아보십시오.",
    ["D"] =
    "얼라이언스와 호드 간의 적대감을 식히는 것이 제 오랜 소망 중 하나였습니다. 당신이 자발적으로 오크를 이해하려 한다는 것은 시대가 변하고 있다는 반가운 신호입니다.\n\n불행하게도, 진짜 오크와 비교하면 저는 형편없는 선생일 것입니다. 일이 어떻게 끝났는지에 대한 저의 씁쓸함이 너무 생생합니다. 하지만 슬픔의 늪 네더가드 요새 근처에 오크 야영지가 있습니다. 얼라이언스에게 다소 우호적이라고 들었습니다. 그곳으로 여행하여 지역의 누군가 명예에 대한 오크의 개념을 설명해줄 사람이 있는지 알아보십시오. 그곳이 시작하기에 가장 좋은 곳입니다.",
  },
  [27908] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "슬픔의 늪으로 이동하여 저주받은 땅으로 향하는 길에 호드 영웅의 넋을 찾으십시오.",
    ["D"] =
    "우리 종족 중 하나처럼 생각하고 싸우는 것은 단순히 도끼를 특정 방식으로 휘두르는 문제가 아닙니다. 모든 일에서 명예를 받아들여야 합니다. 이 개념을 가르쳐 줄 최고의 스승을 알고 있다고 믿습니다.\n\n슬픔의 늪에서 당신은 명예롭게 살다 죽은 자의 영혼을 찾을 수 있을 것입니다. 저주받은 땅으로 가는 길에서 그를 찾아 교육을 시작하십시오.",
  },
  [27909] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "깊은굴 지하철의 일꾼 기념비로 이동하여 의식용 향을 사용하여 선조에게 경의를 표하십시오.",
    ["D"] =
    "내 동족에 대해 더 배우고자 합니까? 제가 다른 누구보다 좋은 선생이고, 또 더 기꺼이 가르쳐줄 수 있을 것 같군요. 어차피 저는 어디에도 가지 않으니까요.\n\n진정으로 우리 동족을 이해하고 싶다면, 명예가 당신의 말, 행동, 행위의 바탕이 된다는 것을 이해하는 데서 시작해야 합니다. 우리 부족들은 오랜 명예로운 행적의 역사로 묶여 있습니다. 우리의 행동이 단지 우리 자신 이상을 반영한다는 것을 이해합니다.\n\n다른 사람들을 어떻게 존중하는지 보여주십시오. 당신의 선조들이 쉬고 있는 곳에서 이 의식용 향을 사용한 다음 제게 돌아오십시오.",
  },

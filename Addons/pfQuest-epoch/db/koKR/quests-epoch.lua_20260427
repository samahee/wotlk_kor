  [9006] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "델리아나에게 용맹의 투구를 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군요, $N! 당신에게 감사드리며, 관련된 모든 이들의 진심 어린 감사를 전합니다. 이제 저도 두 눈을 감고 편히 잠들 수 있겠네요.\n\n보상으로 당신이 정말 좋아할 만한 몇 가지 물건을 준비했습니다.",
  },
  [9007] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "모크바르에게 야생의 정수 두건을 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군, $N! 자네에게 감사하며, 관련된 모든 이들의 진심 어린 감사를 전하네. 자네의 노력 덕분에 우리는 과거의 실수에서 벗어날 수 있게 되었어.\n\n보상에 대해서는 자네가 분명히 얻을 자격이 있고 진정으로 즐길 수 있는 몇 가지를 준비했네.",
  },
  [9008] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "모크바르에게 야수추적자의 모자와 야수추적자의 튜닉을 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군, $N! 자네에게 감사하며, 관련된 모든 이들의 진심 어린 감사를 전하네. 자네의 노력 덕분에 우리는 과거의 실수에서 벗어날 수 있게 되었어.\n\n보상에 대해서는 자네가 분명히 얻을 자격이 있고 진정으로 즐길 수 있는 몇 가지를 준비했네.",
  },
  [9009] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "모크바르에게 기원의 관을 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군, $N! 자네에게 감사하며, 관련된 모든 이들의 진심 어린 감사를 전하네. 자네의 노력 덕분에 우리는 과거의 실수에서 벗어날 수 있게 되었어.\n\n보상에 대해서는 자네가 분명히 얻을 자격이 있고 진정으로 즐길 수 있는 몇 가지를 준비했네.",
  },
  [9609] = {
    ["T"] = "순찰대원 비그스 돕기",
    ["O"] = "슬픔의 늪에서 순찰대원 비그스를 찾으십시오.",
    ["D"] =
    "막투르가 근처에 좌초된 순찰대원이 있다고 알려주었소. 다크샤이어에서 호위하던 짐마차가 드레노어 난민들의 공격을 받았나 보오. 그가 유일한 생존자인 것 같소.\n그는 남쪽 어딘가에 있소. 부탁이오, $c, 그를 도와주시오.",
  },
  [9610] = {
    ["T"] = "눈물의 연못",
    ["O"] = "아탈라이 유물 10개를 모아 슬픔의 늪 피난처에 있는 핀미르에게 가져가십시오.",
    ["D"] =
    "저는 아제로스의 과거를 연구하는 데 관심이 있는데, 혹시 도와주실 수 있나요?\n늪지대 안에 역사적으로 중요한 장소가 있어서 당신이 가보셨으면 합니다. 눈물의 연못은 남동쪽에 위치하고 있죠. 그 해안가와 깊은 곳에 아탈라이 트롤 문명의 유물들이 묻혀 있다고 전해집니다.\n하지만 조심하세요. 그곳은 고대 녹색용 솜누스와 그의 용혈족, 그리고 연못 자체에 사는 육식성 물고기들이 지키고 있으니까요!",
  },
  [11160] = {
    ["T"] = "돌망치 깃발",
    ["O"] = "돌망치 깃발을 찾아 브로그의 구덩이에 있는 브로그에게 가져가십시오.",
    ["D"] =
    "용들이 와서 브로그의 옛집을 점령했을 때, 돌망치 오우거들은 부족의 깃발을 포함한 모든 것을 버리고 도망쳤다.\n브로그는 깃발이 돌망치 오우거의 소굴 깊숙한 곳에 보관되어 있었다는 것을 알지만, 요즘은 화염의 굴로 불린다. 브로그는 친구들을 죽인 용들에게 복수하려면 반드시 부족 깃발을 가져야 한다.\n브로그 부족의 옛 소굴인 화염의 굴은 내 구덩이 북쪽에 있고 용기병들이 득실거린다. 깃발은 동굴 깊숙한 곳에 있을 것이다. 조심해라, $N.",
  },
  [14087] = {
    ["T"] = "멀고어에서 타기 배우기",
    ["O"] = "안내 책자를 멀고어 블러드후프 마을에 있는 카르 스톰싱어에게 가져가십시오.",
    ["D"] = "탈것 타기 훈련과 구매를 광고하는 이 팜플렛은 카르 스톰싱어가 보낸 것입니다.\n\n카르는 멀고어의 블러드후프 마을에 있습니다.",
  },
  [26100] = {
    ["T"] = "도시 속의 악어",
    ["O"] = "오그리마 안에서 새끼 악어를 잡아 아즈샤라 검은아귀 마을의 노인 발로에게 가져가십시오.",
    ["D"] =
    "안녕하신가 $C. 이렇게 늙은이와 이야기하러 들러주니 고맙구만... 실은 고향에 문제가 생겼다네.\n\n얼마 전 한 떠돌이 상인이 속기 쉬운 아이들에게 새끼 악어들을 팔아넘겼지. 악어는 야생 짐승이야. 게다가 그중 상당수가 도망쳐 지금은 도시 수로에 숨어 있다네.\n\n자네의 가장 튼튼한 낚싯대를 챙겨 대도시 아무 곳에나 낚싯줄을 드리우고 그 악마 같은 녀석들 중 하나를 내게 데려다주게. 그놈들 중 한 마리를 정말 보고 싶구만.",
  },
  [26101] = {
    ["T"] = "달숲의 달빛물고기",
    ["O"] = "달숲에서 달빛물고기 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "편안하게 낚시할 곳을 찾는다면 달숲만 한 곳이 없지. 칼림도어에서 그보다 더 고요한 물가는 찾지 못할 걸세.\n\n내 친구 위플라에게 내기에서 져서 생선을 줘야 하는데, 달숲으로 올라갈 시간이 없구만. 자네가 나 대신 낚시 좀 해주지 않겠나? 이 늙은이에게 큰 호의를 베푸는 셈 치고 말이야.",
  },
  [26102] = {
    ["T"] = "강속의 유령들",
    ["O"] = "저승바람 고개에서 유령물고기를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "예전에는 낡은 카라잔 근처에서 낚시하는 게 아주 즐거웠지. 그러다가 군단과 악마들, 메디브가 사라지는 그런 불쾌한 일들이 생겼어. 그곳은 내 늙은 뼈마저 덜덜 떨리게 한다네.\n\n내 친구 오르소하가 거기서 아직도 낚시를 할 수 있는지 궁금해하더군. 무섭다고 인정하기엔 창피해서 해보겠다고 큰소리쳤지. 하지만 그쪽으로 갈 엄두가 안 나네... 대부분의 어부가 그렇듯 미신을 믿거든.\n\n자네가 한번 가서 뭐가 잡히는지 오르소하에게 가져다주지 않겠나?",
  },
  [26103] = {
    ["T"] = "얼어붙은 물품",
    ["O"] = "여명의 설원에서 얼어붙은 덩어리 10개를 모아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "알다시피 낚시는 다음 식사를 잡는 것보다 더 많은 걸 할 수 있어. 더운 여름날에 아주 유용하게 쓰이기도 하지.\n\n여명의 설원의 물을 예로 들어보자고. 거긴 며칠이 지나도 꽁꽁 얼어있는 커다란 얼음덩어리를 낚을 수 있거든. 생선을 운반할 때 보관하기에도 좋고, 널 이상하게 쳐다보는 놈한테 던지기에도 딱이지.\n\n사실 나도 얼음이 거의 다 떨어졌어. 재고 좀 채워주겠나? 다 구하면 위플라에게 가져다주게.",
  },
  [26104] = {
    ["T"] = "순수 미술 낚시",
    ["O"] = "동부 역병지대에서 훌륭한 풍경화를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "세상에는 강이나 호수, 바다로 흘러드는 물건들이 정말 많다네. 그중에는 꽤 값나가는 것도 있지!\n\n예를 들면 지금은 동부 역병지대가 된 브라우만 제분소에서 생산하던 공예품이나 예술품들 말이야. 오르소하가 좋아할 만한 아주 아름다운 풍경화나 정교한 나무 조각 같은 멋진 작품들이 있었지. 아마도 그 물건들 중 일부가 그곳 호수 잔해 위로 떠올랐을지도 모르네. 한 번 찾아볼 만하지 않겠어?",
  },
  [26105] = {
    ["T"] = "끈질긴 텀프피쉬",
    ["O"] = "서부 역병지대에서 텀프피쉬 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "지금은 서부 역병지대가 된 다로우미어 호수로 흘러드는 토리달 강은 항상 낚시하기 힘든 곳이었어. 지금의 이 늙은 뼈로는 확실히 무리라네.\n\n도전할 만한 곳을 찾는다면 그 물에서 텀프피쉬를 낚아보게나. 위플라가 아주 감명받을 거라고 장담하지. 다만, 호수에 있는 트레샤돈을 조심하게. 요즘은 전부 역병에 걸렸다더군.",
  },
  [26106] = {
    ["T"] = "용암 방어 랍스터",
    ["O"] = "불타는 평원에서 용암 방어 랍스터 10마리를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "아, 불타는 평원... 유황과 맥주 냄새. 낚싯대를 들고 밖으로 나가기 딱 좋은 분위기지. 그곳엔 용암밖에 없지만 그래도 만찬거리를 낚을 수 있다네. 내가 말하는 건 그 유명한 용암 방어 랍스터야. 껍질이 쇠못만큼 단단하고 불에도 강하지만 껍질만 벗겨내면, 오! 그 안의 매콤하고 스모키한 맛은 이길 자가 없지.\n\n오르소하가 그걸 다듬을 집게를 가지고 있으니, 나눠 먹을 만큼 충분히 잡으면 그에게 가져다주게.",
  },
  [26107] = {
    ["T"] = "오 드 파르피쉬",
    ["O"] = "악령숲에서 향기로운 지옥물고기를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "나는 절대 패션을 이해하지 못할 거야, $N. 특히 펄볼그 패션 말이야. 위플라 말로는 검은아귀 부족이 예전에 악령숲에서 구하던 물고기로 향수를 만든다더군. 지독한 냄새가 나는데 말이지!\n\n하지만 우리 털복숭이 친구들에게 중요한 일이라면 내게도 중요한 일이네. 수로가 지옥 마법에 오염된 후에도 이 향기로운 짐승을 구할 수 있는지 알아보고 싶네. 한 번 해볼 텐가?",
  },
  [26108] = {
    ["T"] = "길들여지지 않은 운고로",
    ["O"] = "운고로 분화구에서 가시이빨 화염물고기 10마리를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "내가 낚시를 안 해본 곳은 몇 군데 없지만, 그중 하나가 바로 운고로 분화구의 황야라네. 이 늙은 뼈로 거길 내려갈 수만 있다면 기꺼이 그 길들여지지 않은 분화구의 물에서 릴을 던지겠지만. 아아, 자네 같은 젊은이들에게 의지할 수밖에 없겠군.\n\n오르소하가 희귀한 생선을 아주 잘 다루지. 혹시 자네가 10마리쯤 가져다주면 우리도 자네 덕에 맛좀 볼 수 있지 않을까?",
  },
  [26109] = {
    ["T"] = "오크와 남획",
    ["O"] = "저주받은 땅에서 오렌지 라피 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "저주받은 땅의 펠스톤 요새에 들끓는 군단 충성파 오크들이 만족을 모르는 악마 군대에게 먹이를 주려고 인근 해안의 물고기를 씨를 말리고 있다네. 그 해안에 서식하는 사랑스러운 오렌지 라피를 보호하기 위해 우리가 나서야 해!\n\n10마리를 낚아서 위플라에게 가져다주게. 그녀가 이곳에서 오렌지 라피가 평화롭게 살 수 있도록 돌봐줄 거야. 오크들을 물리치고 나면 더 많은 개체를 자연으로 돌려보낼 수 있을 테지.",
  },
  [26110] = {
    ["T"] = "가장 희귀한 것",
    ["O"] = "아즈샤라에서 사파이어 화살고기를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "아, 아즈샤라. 내겐 제2의 고향이자 친구들의 진짜 고향이지. 여긴 낚시할 곳이 너무 많아서 언제든 새로운 명당을 찾을 수 있다네.\n\n난 다른 어떤 곳보다 아즈샤라에서 낚시를 많이 했지만 아직도 날 피해 다니는 물고기가 하나 있지. 사파이어 화살고기 말일세. 펄볼그가 그걸 잡으면 냄비에 끓이는 대신 전리품 벽에 장식해둘 정도야! 자네도 한번 직접 잡아보는 게 어떤가? 어디에 있을지는 아무도 모르지...!",
  },
  [26111] = {
    ["T"] = "회중시계 건져내기",
    ["O"] = "이글거리는 협곡에서 발로의 회중시계를 건져 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "오 맙소사 $C, 큰일이 났어. 방금 이글거리는 협곡의 용암 웅덩이에 다녀왔는데 내 행운의 회중시계를 잃어버렸지 뭔가!\n\n이 늙은 뼈가 다시 길을 나서려면 좀 쉬어야 해. 하지만 너무 늦으면 마법이 풀려서 용암이 내 시계를 곤죽으로 녹여버릴 거야. 자네가 거기로 가서 나 대신 시계를 좀 건져주면 안 되겠나? 시계를 가져오면 위플라가 깨끗하게 닦아줄 걸세.",
  },
  [26112] = {
    ["T"] = "트롤 송어",
    ["O"] = "타나리스에서 긴 송어 10마리를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "안제와타의 트롤들이 민물 송어와 바다 농어를 이종 교배해서 '란그와' 또는 공용어로 '긴 송어'라고 알려진 새로운 품종의 물고기를 만들어냈어. 우리가 그걸 맛본 지도 꽤 됐군. 타나리스로 내려가서 뭘 낚을 수 있는지 확인해 보는 건 어떨까?",
  },
  [26113] = {
    ["T"] = "동화 같은 낚시",
    ["O"] = "동부 내륙지에서 황금비늘 농어 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "자, $C 앉아보게. 내가 이야기 하나 들려주지.\n\n옛날 옛적 동부 내륙지에 낚시할 줄 모르는 하이 엘프들이 살았어. 내가 그곳 마른나무껍질 트롤들과 싸움에 휘말렸는데, 자세한 얘기는 안 하겠지만, 그들이 날 구해준 대가로 낚시를 가르쳐주었지. 그리고 그들은 낚시를 아주 좋아했어! 적어도 내게는 그렇게 말했지.\n\n나중에 알고 보니 그건 그냥 내 기분을 맞춰준 거였어. 그 이후로는 그곳에 발길을 끊었지만, 혹시 자네가 그쪽으로 갈 일이 있다면 좀 부탁하네. 위플라가 황금비늘 농어 요리를 먹고 싶어 하거든.",
  },
  [26114] = {
    ["T"] = "페더문 낚시",
    ["O"] = "페랄라스에서 푸른가시 청새치를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "페더문 섬은 낚시터치고는 좀 외딴곳에 있지만, 제대로 된 자리만 찾는다면 물고기들이 아주 잘 무는 곳이지.\n\n바다가 선사하는 최고의 물고기들과 자네 실력을 겨루고 싶다면, 푸른가시 청새치를 찾아보게. 끌어올리는 데 꽤 애를 먹겠지만, 한 마리만 잡아도 살코기가 어마어마할 거야! 오르소하가 손질하는 걸 도와줄 걸세.",
  },
  [26115] = {
    ["T"] = "진흙 속에서 낚기",
    ["O"] = "슬픔의 늪에서 진흙주둥이 가자미 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "이보게, $C! 내 늙은 뼈마디에 지난날 낚시하던 이야기가 삐걱거리는군. 자네에게 제안할 게 하나 있어. 슬픔의 늪의 탁한 물에는 위플라가 아주 좋아하는 미끈거리는 생물들이 득실거리지. 이제 낚싯대를 던져서 뭘 건져 올릴 수 있는지 확인할 때가 된 것 같아. 하지만 조심하게, 늪에는 물고기만 사는 게 아니니까. 그 탁한 깊은 곳에 위험이 도사리고 있으니 정신 바짝 차리게나.",
  },
  [26116] = {
    ["T"] = "모래 거르기",
    ["O"] = "황야의 땅에서 모래 거르개 10마리를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "자네는 분명 황야의 땅은 낚시하기에 나쁜 곳이라고 생각하겠지. 고블린들이 스프링소켓에 자리를 잡기 전까지는 그 말이 맞았어. 하지만 알고 보니 사막 지하에 물이 있었고, 거기엔 물고기들도 살고 있었지 뭔가!\n\n그곳에 가본 적이 없다면 자네는 정말 좋은 낚시터를 놓치고 있는 거야! 어때? 낚싯줄을 던져서 뭐가 무는지 확인해 볼 준비가 되었나?",
  },
  [26117] = {
    ["T"] = "그림자 쫓기",
    ["O"] = "먼지진흙 습지대에서 산호 상어를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "들어봐 $C, 자네라면 낚시꾼이 도전할 수 있는 가장 힘든 목표, 바로 상어 낚시를 해낼 배짱과 투지가 충분하다고 생각하네.\n\n그렇다네, 먼지진흙 습지대의 어두컴컴한 깊은 곳엔 상어들이 수두룩하게 낚이기만을 기다리고 있지. 그놈들은 덩치도 크고 사나워서 잊지 못할 사투를 벌이게 될 거야. 심연의 턱과 씨름할 준비가 되었나?",
  },
  [26118] = {
    ["T"] = "가시덤불 줄무늬 물고기",
    ["O"] = "가시덤불 골짜기에서 줄무늬 거꾸로서기물고기 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "어이, $R! 줄무늬 거꾸로서기물고기에 대해 들어본 적 있나? 너무 예뻐서 다른 물고기들이 지느러미를 부러워할 정도지. 지금의 난 예전만큼 날렵하지 못하고 내 태클박스도 휴식이 필요하니, 자네에게 이 일을 넘기겠네. 가시덤불 골짜기로 가서 이 미끈거리는 악동 열 마리를 낚아 오게나. 걔들은 정글만의 수중 패션쇼 같거든!\n\n하지만 이게 핵심이야. 물고기를 다 잡으면 위플라를 찾아가게. 그녀에게 이 예쁜 물고기들을 보여주고 아제로스 수중 무리의 최고봉이라고 전하게. 누가 아나? 우리가 펄볼그들에게 낚시 한두 가지쯤 가르쳐주면서 아주 즐거운 시간을 보낼지! 자, 어서 가게. 줄무늬 거꾸로서기물고기들이 사탕 가게에 있는 노움처럼 말을 잘 들어주길 바라지!",
  },
  [26119] = {
    ["T"] = "심연의 조개",
    ["O"] = "잊혀진 땅에서 태양 조개 10개를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "있잖아, $N, 자네는 최고급 미각을 갖춘 훌륭한 $g어부:어부;가 될 소질이 보여!\n\n최고급 해산물을 찾고 있다면 잊혀진 땅 해안만 한 곳이 없지. 농어 잡듯이 쉽게 조개를 잡을 수 있거든. 그 태양 조개라는 녀석들은 정말 기이한 생물이야. 위플라에게 그걸 가져다주면 엄청 고마워할 걸세.",
  },
  [26120] = {
    ["T"] = "날카로움이 득실대는 물",
    ["O"] = "아라시 고원에서 날카로운이빨 스트롬피쉬를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "안녕하신가 $C. 약간의 평화와 고요함을 원한다면 아라시 고원을 확인해 보는 게 좋을 거야. 가까운 거리에서 양쪽 바다 모두 낚시를 즐길 수 있는 몇 안 되는 곳 중 하나니까!\n\n평온한 경치에 속지 말게, 여기 물고기들은 물어뜯거든 -- 말 그대로! 날카로운이빨 스트롬피쉬를 조심해. 놈들이 있는 웅덩이에 서 있으면 네 다리를 물어뜯을 테니까. 다행히 놈들은 혼자 다니기 때문에 그런 일이 일어날 확률은 낮아. 오르소하에게 표본 하나만 가져다줄 수 있겠나?",
  },
  [26121] = {
    ["T"] = "증기 피어오르는 해안",
    ["O"] = "버섯구름 봉우리에서 은빛증기 뱀장어를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "버섯구름 봉우리엔 물이 별로 없을 거야 $C. 사실, 난 내가 아는 유일한 곳인 그림토템 초소 아래의 증기 웅덩이에서 줄을 드리우려고 멈춰 본 적이 없어.\n\n네가 거기서 뭘 찾을지 궁금하군. 내 친구에게서 미끄러져 도망갔다는 회색 뱀장어에 대한 허풍을 들은 적이 있거든. 아마 존재하지 않을 테지만, 그래도 알아보고 싶지 않아? 네가 가져오는 건 위플라가 다 장식해 줄 거야.",
  },
  [26122] = {
    ["T"] = "습지대 방랑",
    ["O"] = "저습지에서 오랫동안 잃어버린 미끼를 건져 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "나는 저습지에서 많은 시간을 보내곤 했어. 거기엔 온갖 종류의 물고기가 풍부하거든. 연못, 호수, 강, 늪, 바다... 네가 이름만 대면 어디서든 낚시할 수 있지. 거기서 너무 많은 시간을 보낸 나머지 내가 가장 아끼는 미끼까지 두고 왔어.\n\n거기 갈 일이 있다면 내 미끼를 찾아봐 주지 않겠나? 오르소하가 미끼 수리를 아주 잘하니까 네가 미끼를 찾아오면 그가 고쳐줄 거야.",
  },
  [26123] = {
    ["T"] = "멀록 머드킵",
    ["O"] = "힐스브래드 구릉지에서 머드킵 맹글피쉬 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "힐스브래드 구릉지 남쪽 해안을 따라 멀록들이 아주 많이 있다네. 남녘해안에서 낚시를 하다가 특정 작은 머드킵이 멀록들이 남긴 살점 찌꺼기를 훔쳐 먹으려고 주변을 어슬렁거리는 걸 봤지. 그 머드킵은 먹기에 아주 좋고, 우리 비축량도 꽤 줄어들고 있다네.\n\n물론 힐스브래드 어디서든 머드킵을 찾을 수 있겠지만, 내가 아는 건 그게 다야. 어때, 낚싯대를 드리워서 우리에게 만찬거리를 가져다주지 않겠나?",
  },
  [26124] = {
    ["T"] = "아름다운 물길",
    ["O"] = "잿빛 골짜기에서 파리꼬리 화살고기 10마리를 낚아 아즈샤라 검은아귀 마을의 오르소하에게 가져가십시오.",
    ["D"] =
    "신록이 우거진 아름다운 잿빛 골짜기는 세상의 혼돈에서 벗어나 위안을 찾는 이들에게 완벽하고 평온한 안식처지. 이 고요함 속에는 낚시하기 딱 좋은 풍성한 물고기들이 있다네. 잿빛 골짜기의 강과 호수에는 생명력이 넘치니, 낚싯줄을 드리우고 자연의 선물을 누릴 때야.\n\n나는 나이트 엘프들의 자랑, 파리꼬리 달화살고기 -- 오르소하가 가장 좋아하는 물고기 -- 를 말하는 거네! 보름달이 떴을 때 수면 아래로 달화살고기 떼가 지나가는 걸 보는 것만큼 비교할 데가 없지. 우리를 위해 좀 낚아다 준다면 정말 고맙겠네!",
  },
  [26125] = {
    ["T"] = "돌고기 수프",
    ["O"] = "돌발톱 산맥에서 돌가죽 피라미 10마리를 낚아 아즈샤라 검은아귀 마을의 위플라에게 가져가십시오.",
    ["D"] =
    "환영하네 $C, 돌발톱 산맥의 험준한 봉우리와 굽이치는 협곡 사이에서 평화를 찾는다면 딱 맞는 처방이 있지. 위플라가 돌고기 수프라는 새 레시피를 시도해 보고 싶어 하는데, 돌발톱 산맥에서만 발견되는 주재료인 돌가죽 피라미가 필요해. 비늘은 못보다 단단하지만, 채찍뿌리와 부드러운 향신료를 넣고 끓이면 아주 훌륭한 맛이 나지.\n\n거기 가서 생선을 잔뜩 잡아다 주지 않겠나?",
  },
  [26126] = {
    ["T"] = "스프링소켓 뱀장어",
    ["O"] = "스프링소켓에 있는 지모에게 날 스프링소켓 뱀장어 10마리를 가져가십시오.",
    ["D"] =
    "믿거나 말거나, 스프링소켓은 아주 활발한 낚시터랍니다! 실제로 낚시를 즐기는 사람은 저 혼자뿐이지만, 언젠가는 다른 사람들도 올 거라 믿어 의심치 않아요. 아무튼, 당신이 이 일에 흥미가 있다면 당신을 위한 도전이 준비되어 있습니다.\n\n이 연못은 지하 깊은 곳에 있는 천연 동굴 시스템에서 물을 끌어옵니다. 그 아래에 있는 물고기들은 눈이 멀었는데, 가끔 위로 헤엄쳐 올라와 수면으로 길을 찾기도 하죠. 전 여기저기서 몇 마리 잡아본 적밖에 없지만, 제가 먹어본 물고기 중 가장 맛있는 물고기였어요!\n\n한번 낚시에 도전해서 몇 마리 잡아보는 게 어때요? 운이 좋다면 제게 가져오세요. 요리하는 법을 알려드릴 테니까요.",
  },
  [26127] = {
    ["T"] = "알터랙 실링",
    ["O"] = "무법항의 알타데나에게 알터랙 실링을 가져가십시오.",
    ["D"] =
    "알터랙 실링을 찾았습니다.\n\n이 동전은 약 20년 전, 아이덴 페레놀드 왕 치세의 마지막 무렵에 주조된 것입니다. 한쪽 면에는 닳아빠진 왕의 옆얼굴이 그려져 있습니다. 다른 면에는 별에 둘러싸여 하강하는 독수리, 즉 옛 알터랙 왕국의 상징이 새겨져 있습니다.\n\n희귀한 동전 수집가라면 이 물건에 관심이 있을 것입니다.",

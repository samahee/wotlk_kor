  [27612] = {
    ["T"] = "가르톡을 위한 의뢰",
    ["O"] = "미아오잔은 당신의 연금술 기술을 사용해 최하급 방어의 비약 5개를 제작하고 듀로타의 칼바위 언덕에 있는 가르톡에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "자네가 도와줄 수 있는 일이 또 있네 -- 아주 간단하고 기초적인 기술만 필요하지.\n\n동쪽으로 길을 따라가면 칼바위 언덕이 나오네. 가르톡은 이 지역 그런트들을 지휘하고 있으며, 바로 그곳에 주둔하고 있지. 그의 부하들을 위해 최하급 방어의 비약을 부탁해왔네. 이 일을 맡아줄 수 있겠나?",
  },
  [27613] = {
    ["T"] = "현자 레인토템을 위한 의뢰",
    ["O"] = "크레이는 당신의 연금술 기술을 사용해 최하급 마나 물약 5개를 제작하고 멀고어 동쪽 붉은바위에 있는 현자 레인토템에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "네 방어구에 묻은 평온꽃 자국만 봐도 연금술사란 걸 알겠네! 날 좀 도와줄래?\n\n연구도 밀렸는데 소화하지 못할 의뢰들이 쌓여가고 있어. 네가 도와준다면 난 다시 연구로 돌아갈 수 있고 실험실에서 쓸모가 생길 텐데. 돕고 싶으면 최하급 마나 물약을 만들어서 동쪽 붉은바위에 계신 현자 레인토템님께 배달해줘.",
  },
  [27614] = {
    ["T"] = "모린 클라우드스토커를 위한 의뢰",
    ["O"] = "크레이는 당신의 연금술 기술을 사용해 약한 트롤의 피 비약 5개를 제작하고 멀고어의 블러드후프 마을 남쪽 도로에 있는 모린 클라우드스토커에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "있잖아, 이 주위엔 연금술사가 할 일이 꽤 많아. 더 해볼 생각 있어?\n\n모린 클라우드스토커는 불모의 땅으로 이어지는 남쪽 도로를 순찰하는데, 잦은... 사고를 겪거든. 치유 물약을 쓸 정도는 아니지만 -- 네가 의뢰받을 생각이 있다면, 약한 트롤의 피 비약 5개를 만들어서 그녀에게 전해줘.",
  },
  [27615] = {
    ["T"] = "고르도를 위한 의뢰",
    ["O"] = "연금술사 요한은 당신의 연금술 기술을 사용해 사자의 힘 비약 5개를 제작하고 티리스팔 숲의 브릴 서쪽 도로에 있는 고르도에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "당신이 연금술사라는 사실을 알아차리지 않을 수 없군요. 현재 밀려드는 요청 때문에 이런 보잘것없는 일들에 허비할 시간이 없습니다. 만약 연습이 필요하시다면, 이 요청 몇 가지만 좀 맡아 주시겠습니까?\n\n죽음의 경비대에서 그 멍청하고 육중한 고르도를 위해 사자의 힘 비약 다섯 개를 징발했습니다. 비약을 만드신 후 브릴 서쪽 길 어딘가에서 녀석을 찾아 전해주시면 됩니다.",
  },
  [27616] = {
    ["T"] = "메릴 웬딜을 위한 의뢰",
    ["O"] = "연금술사 요한은 당신의 연금술 기술을 사용해 최하급 활력 물약 5개를 제작하고 티리스팔 숲의 브릴 묘지에 있는 메릴 웬딜에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "제가 받는 하찮은 요구들 중 그나마 가장 중요한 임무입니다. 메릴 웬딜은 정기적으로 스컬지석을 다루는데 그것이 육체와 정신을 좀먹는 것 같습니다. 최하급 활력 물약을 만들어 주신다면 메릴에게 큰 도움이 될 것입니다. 근처 묘지에서 그녀를 찾으실 수 있을 겁니다.",

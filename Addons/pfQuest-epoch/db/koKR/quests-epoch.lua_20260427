  [26917] = {
    ["T"] = "여덟 다리 살코기",
    ["O"] = "오레보르 피난처 남동쪽의 맹독타란툴라에게서 통통한 거미 고기 10개를 수집하십시오.",
    ["D"] =
    "아주 훌륭한 스튜를 만들려면 고기를 최대한 많이 구해야 합니다. 최상급 고기만이 경비병들의 기운을 회복시켜 줄 수 있습니다. 이곳 남동쪽에 맹독타란툴라가 있습니다. 그들의 고기는 육즙이 풍부하고 맛있죠. 크면 클수록 더 좋습니다! 절 위해 거미들을 좀 짓눌러버리고 그 살점들을 잘라와 주십시오.",
  },
  [26918] = {
    ["T"] = "진짜 강렬한 맛",
    ["O"] = "슬픔의 늪 주변에서 화염 불꽃 고추 8개를 수집하십시오.",
    ["D"] =
    "경비병들이 정신을 바짝 차리도록 스튜에 강렬한 자극을 주고 싶다면 아주 강한 향신료가 필요합니다. 우리가 어둠의 문을 통과해 올 때 제게 화염 불꽃 고추 씨앗 한 봉지가 있었습니다. 그런데 구멍이 나서 이곳 오레보르 피난처로 오는 동안 씨앗들이 바닥에 떨어졌죠. 그때부터 식물들이 싹을 틔우고 자랐습니다. 그 식물에서 나는 고추는 매운맛을 넘어서는 수준입니다. 절 위해 좀 구해주실 수 있습니까?",
  },
  [26919] = {
    ["T"] = "카라보르 화염 스튜",
    ["O"] = "오레보르 피난처의 시민들에게 카라보르 화염 스튜를 전달하십시오.",
    ["D"] =
    "최근 제가 만든 스튜 중 최고인 것 같군요. 이 스튜의 풍미와 열기가 우리 사람들에게 고향의 좋은 추억을 가져다줄 것입니다.\n\n이것을 제 동족 드레나이들에게 나누어 주시겠습니까? 당신이 스튜를 준비하는 데 많은 도움을 주었으니, 그들의 감사를 받는 것이 마땅합니다.",
  },
  [26920] = {
    ["T"] = "늪지대 가죽",
    ["O"] = "마사트 탄드르를 위해 두꺼운 악어 가죽 8장과 질긴 표범 가죽 8장을 수집하십시오.",
    ["D"] =
    "가끔 고향의 짐승들이 그리워집니다... 그들의 가죽... 털... 모든 게 정말 훌륭했죠. 이 행성은 제가 제 사업을 계속하기에 안성맞춤인 것 같습니다.\n\n하지만 재료가 아주 많이 부족합니다. 이 늪지대에 있는 짐승들에게서 가죽을 좀 구해주시겠습니까? 무두질하기 좋은 늪지재규어와 새끼 톱니악어가 이상적입니다.",
  },
  [26921] = {
    ["T"] = "늪지대 가죽",
    ["O"] = "슬픔의 늪에 있는 무쇠턱 톱니악어에게서 튼튼한 악어 가죽 8장, 그리고 그림자표범에게서 거친 표범 가죽 8장을 수집하십시오.",
    ["D"] =
    "쉿, 이봐요. 그래요, 당신 말입니다!\n\n아까 당신이 마사트에게 가죽 꾸러미를 가져다주는 걸 봤는데 제 작은 사업도 도와줄 수 있는지 궁금하군요. 마사트는 이 마을에서 가장 잘 나가는 가죽세공인이지만 그의 솜씨는 조잡하기 짝이 없죠. 품질 좋은 물건을 만들어 낸다면 제가 경비병들 장비를 다 맡을 수 있을 겁니다. 제게도 가죽을 좀 구해주실 수 있습니까? 마사트가 부탁한 쓰레기 같은 가죽보다 품질이 훨씬 좋아야 합니다.\n\n동쪽 멀리 무쇠턱 톱니악어와 그림자표범이 있을 겁니다. 그놈들의 가죽을 가져오십시오.",
  },
  [26922] = {
    ["T"] = "늪지 갈대",
    ["O"] = "늪지 갈대 8개를 채집하여 스토나드의 툴타조르에게 돌아가십시오.",
    ["D"] =
    "이 늪지대는 이국적인 약초와 야생동물들이 많이 서식하는 곳입니다. 그것들을 연구해서 스토나드에 의학적으로 도움이 될지 조사하는 게 제 일입니다.\n\n특히 북서쪽 안개 계곡에는 늪지 갈대라는 특정 약초가 자랍니다. 그것을 약재로 사용할 수 있을지 시험해 볼 수 있도록 그곳에서 자라는 표본을 좀 가져와 주십시오.",
  },
  [26923] = {
    ["T"] = "현상 수배: 맹독실거미",
    ["O"] = "오레보르 피난처 동쪽에 서식하는 맹독실거미를 찾아 제거하십시오.",
    ["D"] =
    "밤만 되면 소리 없이 우리 사람들이 납치되어 실종되고 있습니다. 끈적끈적한 찌꺼기가 남겨진 것으로 보아, 저는 범인이 이 늪지대에 사는 거대한 거미붙이일 것이라고 확신합니다. 이 악몽을 제거하는 데 성공하는 모험가에게는 큰 보상을 드리겠습니다!\n\n\n-- 파수꾼 마나아르",
  },
  [26924] = {
    ["T"] = "현상 수배: 타무라",
    ["O"] = "타무라를 처치하고 스토나드의 준다르사에게 그 머리를 가져가십시오.",
    ["D"] =
    "타무라로 알려진 치명적인 암사자가 배회하고 있으니 북쪽 늪지대를 조심하십시오. 이 잔인한 야수로 인해 스토나드에서는 무슨 수를 써서라도 그녀를 처치하라는 명령을 내렸습니다. 이 현상금을 쫓는 모험가들은 절대 그녀를 홀로 상대하지 마십시오. 성공한다면 스토나드의 준다르사에게 타무라의 머리를 가져가 보상을 받으십시오.",
  },
  [26925] = {
    ["T"] = "역사학자에게 전할 메시지",
    ["O"] = "브릴에 있는 역사학자 토드 페이지를 찾아 멀록들이 노스쇼어 광산을 점령했다고 알리십시오.",
    ["D"] =
    "반갑습니다 친구여... 혹시 브릴로 여행하시는 길이십니까? 만약 그렇다면 저 대신 전갈을 좀 전해주시겠습니까?\n\n제 이름은 재스퍼 그린이고 현자단의 수습생입니다. 제 상관인 역사학자 페이지가 브릴에서 제가 노스쇼어 광산의 유물들을 회수해서 돌아오길 기다리고 계십니다. 하지만 전 그분이 시킨 일을 할 수 없습니다 -- 멀록들이 광산 주변 지역을 완전히 점령해 버렸거든요.\n\n그분은 임무를 완수하기 전까진 돌아오지 말라고 하셨습니다. 당신이 이 문제에 대해 좀 설명해 주실 수 있겠습니까? 어쩌면 그분은 어떻게 해야 할지 아실지도 모릅니다.",
  },
  [26926] = {
    ["T"] = "유물이 담긴 상자",
    ["O"] = "노스쇼어 광산을 조사하여 브릴의 역사학자 토드 페이지를 위해 수집된 유물 상자를 회수하십시오.",
    ["D"] =
    "노스쇼어 광산은 로데론이 몰락하기 직전에 세워졌습니다. 솔리덴 농장 서쪽, 길이 끝나는 곳을 지나 속삭이는 해안에서 약간 뒤로 물러난 곳에서 찾으실 수 있을 겁니다.\n\n그 광산은 광물로 인한 이익을 본 적이 한 번도 없었지만, 한때 광부들이 기묘하고 고대의 유물들을 발견했다는 보고서가 수도로 보내진 적이 있습니다. 이 보고서는 최근 언더시티가 확보한 오래된 문서들 속에서 발견되었죠.\n\n제가 알기로는 그 상자는 한 번도 회수된 적이 없으며 아직 광산 어딘가에서 썩어가고 있을 겁니다.\n\n그러니 그곳으로 가서 찾아오십시오!",
  },
  [26927] = {
    ["T"] = "유물이 담긴 상자",
    ["O"] = "수집된 유물 상자를 언더시티 마법 지구에 있는 역사학자 에바 트렐레인에게 가져가십시오.",
    ["D"] =
    "당신은 제가 맡긴 임무를 적절하게 수행했으므로 다시 한번 이 유물 상자를 맡기겠습니다.\n\n브릴 밖으로 향하는 남쪽 길을 따라가십시오. 그 길은 언더시티로 바로 이어집니다. 마법 지구에서 현자단의 역사학자 에바 트렐레인을 찾으실 수 있을 겁니다. 그녀에게 이 상자를 가져가서 제 임무가 끝났다고 전해주십시오.",
  },
  [26928] = {
    ["T"] = "아루갈의 매복",
    ["O"] = "공동묘지 북쪽의 매복 장소 근처 다리 밑에서 마차 탑승자들의 흔적을 찾아보십시오.",
    ["D"] =
    "이 마차 행렬은 언더시티로 향하던 중 늑대인간이라는 사악한 짐승들의 공격을 받았습니다. 제가 이곳에 도착했을 무렵 경비병들과 일꾼들은 모두 숲으로 끌려갔거나, 더 끔찍한 일을 당한 후였습니다.\n\n늑대인간들은 마차에서 무언가를 찾고 있었고, 전 있는 힘을 다해 녀석들을 물리쳐야 했습니다. 주변을 둘러보고 녀석들이 공격한 이유가 있을지 찾아봐 주십시오. 녀석들의 발톱 자국과 발자국은 근처 다리 밑으로 선명하게 이어져 있습니다.",
  },
  [26929] = {
    ["T"] = "아루갈의 매복",
    ["O"] = "죽음의경비병 키차펠이 부상당한 말을 치료할 수 있도록 진균포자 8개와 늑대의 피 4리터를 수집하십시오.",
    ["D"] =
    "도대체 죽음의경비병들이 로데론의 이름으로 뭘 발견한 거지? 빨리 이걸 공동묘지로 가져가서 내가 어떻게 처리할지 결정해야겠어. 상자가 너무 무거워서 들고 갈 수가 없어. 말이 필요해.\n\n이 말들은 너무 다쳐서 겨우 서 있는 상태지만, 이 상자를 가져가려면 말 한 마리가 필요해. 근처 물가에서 진균포자를 구하고 북서쪽에 있는 늑대들에게서 피 4리터를 가져다줘. 그러면 내가 말을 치료할 수 있는지 볼 테니.",
  },
  [26930] = {
    ["T"] = "아루갈의 매복",
    ["O"] = "남은 마차 보급품을 공동묘지의 병참장교 코르에게 가져가십시오.",
    ["D"] =
    "전 이 상자를 남서쪽에 있는 공동묘지로 가져가서 병참장교 코르에게 안전하게 보관해 달라고 할 생각입니다.\n\n제가 이 호송대에서 간신히 모은 나머지 보급품들을 챙겨서 그곳에서 만납시다. 길가에서 썩어가는 것보다는 공동묘지에서 더 쓸모가 있을 겁니다.",
  },
  [26931] = {
    ["T"] = "아루갈의 매복",
    ["O"] = "죽음의경비병 키차펠에게 상자 안의 내용물을 보여주십시오.",
    ["D"] =
    "상자 너무 통통 튄다. 상자 안에 푹신한 거 있다. 상자가 내 손 핥았다. 코르가 몰래 엿볼 때 상자 무서워했다. 상자 나쁜 놈 아니다. 경비병 K에게 상자 보여줘라.",
  },
  [26932] = {
    ["T"] = "조여오는 검은늑대",
    ["O"] = "굶주린 검은늑대 5마리를 처치한 후 브릴과 티리스팔 숲 로데론 폐허 사이 어딘가를 걷고 있는 죽음의경비병 테렌스에게 돌아가십시오.",
    ["D"] =
    "아, 반갑소, $C. 당신은 푼돈이나 받고 다른 사람의 골칫거리를 대신 처리해 주는 걸 즐기는 타입인 것 같군. 우리 남서쪽 은빛소나무 숲 경계에서 늑대 떼가 끊임없이 넘어오고 있소. 살아있는 늑대들에게는 먹을 게 별로 없어서 가끔 언더시티로 향하는 마차나 행인들을 공격하곤 하지. 길을 보호하려면 우리가 조치를 취해야 하오.\n\n자, 가서 처리하시오!",
  },
  [26933] = {
    ["T"] = "새겨진 두루마리",
    ["O"] = "새겨진 두루마리를 읽고 죽음의 종소리 마을에 있는 아폴로스 데스샷과 대화하십시오.",
    ["D"] =
    "조금 전 누군가 내게 다가와서 이 두루마리를 건네주었소. 사냥꾼 조련사인 아폴로스 데스샷이 보낸 게 분명해. 아마 당신에게 전해주려던 것 같군. 읽어보시오.",
  },
  [26934] = {
    ["T"] = "무기고 채우기",
    ["O"] = "광석 상자 6개를 회수하여 브릴에 있는 올리버 드워에게 돌아가십시오.",
    ["D"] =
    "망할 인간 놈들! 우리 군인들을 죽이고 무덤에 침을 뱉더니 이제 우리 광산까지 빼앗았어! 틀림없이 그걸로 방어구와 무기를 만들고 있을 거야... 절대 그냥 놔둘 순 없어!\n\n$N, 이곳 남동쪽 발니르 농장 근처에 있는 키차펠 광산으로 가서 놈들이 채굴하는 광석을 좀 가져와 줘. 우리가 조치를 취하지 않으면 놈들은 그 광석으로 무기를 만들어서 브릴을 공격할지도 몰라!",
  },
  [26935] = {
    ["T"] = "제페타의 금고",
    ["O"] = "티리스팔 숲 비행선 탑 1층에서 제페타의 금고를 찾으십시오.",
    ["D"] =
    "제페타는 고블린 자이로를 가져다준 것에 대한 보답으로 이 열쇠를 당신에게 주었습니다. 그는 티리스팔 숲 비행선 탑 1층에 있는 보관함 열쇠라고 말했습니다.\n\n안에 무엇이 들어있을까요?",
  },
  [26936] = {
    ["T"] = "노스쇼어 광산",
    ["O"] = "역사학자 페이지의 메시지를 가지고 재스퍼 그린에게 돌아가십시오.",
    ["D"] =
    "광산이 멀록들로 붐빈다면, 그린이 좀 더 큰 좀비답게 용기를 내서 문제를 해결해야지! 간단한 임무를 완수하지 못한 게 벌써 두 번째야. 돌아가서 앞을 가로막는 광산 안의 모든 걸 해결하라고 전해.\n\n현장 업무는 위험천만한 일이고, 그 애가 그걸 감당하지 못한다면 지금 당장 알아야겠어.",
  },
  [26937] = {
    ["T"] = "노스쇼어 광산",
    ["O"] = "재스퍼 그린을 위해 노스쇼어 광산을 소탕하십시오.",
    ["D"] =
    "이보세요 $N, 가진 돈이 많진 않지만 당신이 광산에 내려가서 그곳을 좀 쓸어준다면 제가 가진 전부를 드리겠습니다. 제가 이 일을 해낸 걸로 해주시면 저는 얼른 다시 책 속으로 파묻힐 수 있을 겁니다. 그렇게 해주시면 영원한 현자단의 친구가 되실 겁니다.\n\n광산은 사람들이 다니는 길에서 벗어나, 길이 끝나는 곳을 지나 작은 연못 근처에 있습니다. 사람이 닦아놓은 길을 따라 서쪽으로 가시면 됩니다.",
  },
  [26938] = {
    ["T"] = "사냥꾼의 길",
    ["O"] = "칼바위 언덕의 소타르와 대화하십시오.",
    ["D"] =
    "안녕하신가, 젊은 사냥꾼이여. 자네는 짐승을 다루고 동반자로 훈련시킬 수 있을 만큼 충분한 기술을 갖춘 것 같군.\n\n만약 이 제안이 끌린다면 듀로타의 칼바위 언덕에 있는 소타르를 찾아가게나. 그가 자네만의 야수를 얻는 길로 안내해 줄 걸세.",
  },
  [26939] = {
    ["T"] = "죽음 속의 평화",
    ["O"] = "검은그물 거미굴 광산에서 조셉 스트린브로우의 소지품을 찾아 영혼을 안식하게 하십시오. 그런 다음 죽음의 종소리 마을 묘지에 있는 루나 스트린브로우에게 돌아가십시오.",
    ["D"] =
    "반갑소, $N. 내가 왜 이 무덤에 무릎을 꿇고 있는지 궁금하겠지. 이곳은 내 남편 조셉의 무덤이라오.\n\n조셉은 여기서 북서쪽에 있는 검은그물 거미굴 광산에서 일하던 광부였소. 거미에 물려 죽었지. 우린 역병이 돌기 전에 그의 시신을 수습하지 못했다오.\n\n이제 조셉의 영혼이 편히 쉬지 못하고 광산을 점령하려는 포세이큰들을 위협하고 있소. 그의 시신은 오래전에 사라졌지만 난 여전히 이곳을 그의 무덤이라 부른다오. 내 생각에 당신이 그의 유품을 하나 가져와 준다면, 그걸 여기에 묻고 그의 영혼을 편히 쉬게 할 수 있을 것 같소. 광산에서 그의 물건일 만한 것을 찾아봐 주겠소?",
  },
  [26940] = {
    ["T"] = "광산 되찾기",
    ["O"] = "붉은십자군 광부 10명과 붉은십자군 작업반장 3명을 처치하고 브릴의 퍼거스 키차펠에게 돌아가십시오.",
    ["D"] =
    "키차펠 광산에 대해 들어봤소? 티리스팔에서 가장 풍요로운 광산이라오! 역병이 돌기 전에는 내가 직접 소유하고 관리했지만, 역병이 닥치자 붉은십자군이 우리에게서 광산을 '해방'한답시고 빼앗아 갔소. 이제 그들에게 본때를 보여줄 때요.\n\n난 당신이 광산으로 가서 우리 포세이큰의 이름으로 그곳을 되찾아 주길 바라오! 브릴에서 남쪽 길을 따라가다 갈림길에서 왼쪽으로 꺾은 다음, 발니르 농장이 나올 때까지 계속 가시오. 농장 바로 남쪽 언덕을 따라가면 광산을 찾을 수 있을 거요. 조심하시오, $N. 붉은십자군은 싸우지 않고 광산을 넘겨주지는 않을 테니까.",
  },
  [26941] = {
    ["T"] = "붉은십자군의 정보",
    ["O"] = "부관 샌더를 처치하고, 봉인된 붉은십자군 문서를 수집하여 브릴의 죽음의경비병 키루스에게 돌아가십시오.",
    ["D"] =
    "붉은십자군을 상대로 꽤 성공적인 성과를 거뒀다고 들었소, $N. 혹시 일자리를 찾고 있다면 당신에게 맡길 임무가 있소.\n\n먼 동쪽에는 맹독거미 계곡이 있소. 붉은십자군이 그곳에 작은 전초기지를 세웠는데 확실한 소식통에 의하면 놈들이 무언가 사악한 짓을 꾸미고 있다고 하더군. 놈들이 무슨 계획인지 알아야 하니 가장 좋은 방법은 놈들의 부관을 죽이고 내게 명령서를 가져오는 거요.",
  },
  [26942] = {
    ["T"] = "청정 호수 뱀장어",
    ["O"] = "청정 연못에서 청정 호수 뱀장어 10마리를 낚아 브릴에 있는 거날 버치에게 돌아가십시오.",
    ["D"] =
    "죽어서도 우린 밥을 먹어야 해, $N! 네가 지금까지 긁어모아 먹던 딱딱한 빵부스러기에는 지쳤을 거라고 생각해. 이제 제대로 된 식사를 할 때야!\n\n네가 재료만 가져다주면 맛있는 걸 좀 요리해 줄 수 있지. 서쪽에 있는 청정 연못에 가서 뱀장어 좀 낚아오는 게 어때? 그걸 가져오면 우리 둘 다 먹을 맛있는 음식을 만들어 줄게.",
  },
  [26943] = {
    ["T"] = "야수 길들이기",
    ["O"] = "조련용 막대를 사용하여 거대한 그늘박쥐를 길들이십시오. 훈련을 마친 후 브릴의 다나 워드에게 조련용 막대를 반납하십시오.",
    ["D"] =
    "안녕하신가, 젊은 사냥꾼이여. 자네는 이제 모험에 도움이 될 자네만의 야수를 길들이는 법을 배울 준비가 된 것 같군.\n\n우리는 비록 죽은 몸이지만 동물들의 존중과 신뢰를 얻을 수 있지. 살아있는 자들보다도 더 큰 신뢰를 받을 수도 있다네. 이 길들이기 막대를 가져가 거대한 그늘박쥐를 길들이는 데 사용해 보게. 이름만 듣고 놀라지 말게. 앞으로 자네가 마주칠 다른 박쥐들에 비하면 꽤 얌전한 편이니까. 길들이기에 성공하면 다시 돌아오게.",
  },
  [26944] = {
    ["T"] = "야수 길들이기",
    ["O"] = "조련용 막대를 사용하여 굶주린 검은늑대를 길들이십시오. 훈련을 마친 후 브릴의 다나 워드에게 조련용 막대를 반납하십시오.",
    ["D"] =
    "다음 시험으로는 굶주린 검은늑대를 길들여보게. 그렇게 배고픈 짐승은 배가 부른 짐승보다 다루기 수월할 거네. 언데드 고기를 어쩔 수 없이 자주 먹어야 해서 그런지 싸울 기력이 없는 경우도 많거든. 티리스팔과 은빛소나무 숲을 잇는 길목, 브릴 남서쪽에서 녀석들을 찾을 수 있을 거네.",
  },
  [26945] = {
    ["T"] = "야수 길들이기",
    ["O"] = "조련용 막대를 사용하여 흉포한 검은그물거미를 길들이십시오. 훈련을 마친 후 브릴의 다나 워드에게 조련용 막대를 반납하십시오.",
    ["D"] =
    "마침내 마지막 시험 시간이군. 장난은 그만하지. 자네를 거미 소굴 한가운데로 보낼 셈이네. 별일 없을 거야. 아마도.\n\n산맥 근처 먼 동쪽으로 가서 흉포한 검은그물거미를 길들여보게. 등 뒤를 조심하고 근처에 주둔하고 있는 붉은십자군을 주의하게.\n\n행운을 비네, $N.",
  },
  [26946] = {
    ["T"] = "야수 훈련시키기",
    ["O"] = "언더시티의 스티븐 캐롤과 대화하십시오.",
    ["D"] =
    "이제 자네는 야수를 길들이고 소환할 수 있는 능력을 갖췄지만, 녀석을 훈련시키는 법도 배워야 하네.\n\n언더시티로 가시게. 전사 지구에 우리 포세이큰 군대 내에서도 손꼽히는 훌륭한 사냥꾼인 스티븐 캐롤이 있네. 그가 자네를 지도해 줄 걸세.\n\n먼 훗날, 자네 이름이 사람들 입에 오르내리기를 바라겠네, $C.",
  },
  [26947] = {
    ["T"] = "사냥꾼의 길",
    ["O"] = "티리스팔 숲 브릴에 있는 다나 워드와 대화하십시오.",
    ["D"] =
    "안녕하신가, 젊은 사냥꾼이여. 자네는 짐승을 다루고 동반자로 훈련시킬 수 있을 만큼 충분한 기술을 갖춘 것 같군.\n\n브릴의 다나 워드를 찾아가 보게. 그녀가 자네만의 야수를 얻는 길로 안내해 줄 걸세.",
  },
  [26948] = {
    ["T"] = "사냥꾼의 길",
    ["O"] = "티리스팔 숲 브릴에 있는 다나 워드와 대화하십시오.",
    ["D"] =
    "안녕하신가, 젊은 사냥꾼이여. 자네는 짐승을 다루고 동반자로 훈련시킬 수 있을 만큼 충분한 기술을 갖춘 것 같군.\n\n브릴의 다나 워드를 찾아가 보게. 그녀가 자네만의 야수를 얻는 길로 안내해 줄 걸세.",

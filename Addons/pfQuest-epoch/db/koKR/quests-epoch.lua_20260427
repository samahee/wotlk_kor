pfDB["quests"]["enUS-epoch"] = {
  [11] = {
    ["T"] = "갈퀴발 놀 현상금",
    ["O"] = "병영에 있는 부관 레이너에게 색칠된 놀 완장 8개를 가져가십시오.",
    ["D"] =
    "이 땅에서 아무런 쓸모가 없는 야만적인 생물인 놀들이 엘윈 숲의 경계 지역에서 목격되었습니다. 우리 혼자서는 감당할 수 없을 정도로 큰 무리가 저 멀리 경비탑 남쪽 숲에 들끓고 있습니다. 다른 무리는 동쪽의 돌무덤 호수 근처 지역에 퍼져 있습니다.\n\n스톰윈드 군대는 놀을 처치하는 데 도움을 주는 누구에게나 표창을 할 것입니다. 당신의 공로를 증명할 색칠된 놀 완장을 가져오십시오.",
  },
  [76] = {
    ["T"] = "석영 광산",
    ["O"] = "코볼트 광부 10명과 코볼트 흙점쟁이 5명을 처치하고 석영 광산을 탐험하십시오. 임무를 마치면 골드샤이어의 치안대장 더그한에게 돌아가십시오.",
    ["D"] =
    "당신 덕분에 개미굴 광산에 코볼트가 들끓고 있다는 사실을 알게 되었습니다. 이제 더 멀리 있는 석영 광산을 조사할 정찰병이 필요합니다.\n\n석영 광산을 탐험하고 코볼트가 있는지 확인하십시오. 그곳에 있는 동안 코볼트가 보이면 처치하십시오. 광산에 가려면 아조라의 탑에 도달할 때까지 길을 따라 동쪽으로 이동하십시오. 탑에서 북쪽으로 가면 산기슭에서 광산을 찾을 수 있습니다.",
  },
  [109] = {
    ["T"] = "그라이언 스타우트맨틀에게 보고",
    ["O"] = "그라이언 스타우트맨틀과 대화하십시오. 그는 보통 서부 몰락지대 중앙, 길 바로 옆 감시의 언덕에 있는 돌탑에서 찾을 수 있습니다.",
    ["D"] =
    "당신은 그동안 전투를 꽤 많이 겪은 것 같군요, $c. 아직 하지 않았다면 그라이언 스타우트맨틀에게 보고해야 합니다. 그는 서부 몰락지대의 농토를 보호하기 위해 결성된 민병대를 이끌고 있습니다. 당신의 도움이 필요할 것입니다. 그는 보통 서부 몰락지대 중앙, 길 바로 옆 감시의 언덕에 있는 돌탑에서 찾을 수 있습니다.",

  [27599] = {
    ["T"] = "제랄드 크롤리를 위한 의뢰",
    ["O"] = "제랄드 크롤리는 당신의 연금술 기술을 사용해 화염 오일 5개를 제작하고 붉은마루 산맥의 레이크샤이어에 있는 제랄드 크롤리에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "오... 연금술사시로군요. 제 독에 대한 관심도 좋게 보시겠네요. 결국엔 연금술과 별반 다르지 않으니까요.\n\n사실, 당신 도움이 필요합니다. 불의 기운이 감도는 독을 만들고 싶거든요... 타오르는 느낌이 드는 그런 것 말이죠. 화염 오일을 좀 만들어주신다면, 나중 제작에 요긴한 재료들을 좀 챙겨드리죠.",
  },
  [27600] = {
    ["T"] = "파수꾼 파송을 위한 의뢰",
    ["O"] = "킬란나는 당신의 연금술 기술을 사용해 강한 트롤의 피 비약 5개를 제작하고 잿빛 골짜기의 은빛날개 숲에 있는 파수꾼 파송에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "이곳에서 동료 연금술사를 만나니 반갑군요. 저는 은빛날개 파수대 주문이 밀려 있어 일손이 하나라도 더 필요한 상황이랍니다.\n\n강한 트롤의 피 비약 5개를 만들어 은빛날개 숲의 파수꾼 파송에게 배달해 주시겠어요? 우린 우리 파수대원들이 전쟁노래 협곡 전투에 필요한 물자를 충분히 갖추도록 도와야 해요.",
  },
  [27601] = {
    ["T"] = "케이틀린 그라스만을 위한 의뢰",
    ["O"] = "케이틀린 그라스만은 당신의 연금술 기술을 사용해 하급 마나 물약 5개를 제작하고 습지대의 메네실 항구에 있는 케이틀린 그라스만에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "저는 연금술사는 아니에요... 그런 셈이죠. 하지만 제 등 뒤로 보글거리는 약병들을 보시면 아시겠지만, 전 물약이나 비약 갖고 장난치는 걸 꽤 좋아하거든요.\n\n전 주로 하급 마나 물약을 제 혼합물의 베이스로 쓰는데 그게 다 떨어졌어요! 혹시 절 위해 물약 좀 더 만들어주신다면 제 보급품을 흔쾌히 좀 나눠 드릴게요.",
  },
  [27602] = {
    ["T"] = "하사관 요화를 위한 의뢰",
    ["O"] = "하사관 요화는 당신의 연금술 기술을 사용해 일발의 비약 5개를 제작하고 가시덤불 골짜기의 반란군 야영지에 있는 하사관 요화에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "쿠르젠 대령이 그쪽 약사들의 비약과 물약을 보급받는 한 우린 질 수밖에 없는 전투를 하고 있습니다. 이 보급선을 끊으려는 임무도 준비되어 있지만, 우리만의 이점도 필요합니다.\n\n당신에게 일발의 비약 제작을 의뢰하고 싶습니다. 만든 비약을 이곳의 저에게 전해주십시오. 그것이 있으면 우리는 쿠르젠의 정글전사들에 맞설 우위를 점할 수 있을 것입니다.",
  },
  [27603] = {
    ["T"] = "타베사를 위한 의뢰",
    ["O"] = "우마 발툼은 당신의 연금술 기술을 사용해 하급 투명 물약 5개를 제작하고 먼지진흙 습지대의 타베사 농장에 있는 타베사에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "아, 숙련된 연금술사님! 당신 도움이 필요해요!\n\n늪에 사는 타베사라는 은둔자가 있어요. 절실하게 하급 투명 물약이 필요하다며 제게 전령을 보냈는데, 제게는 남은 수량도 없고 만들 줄도 몰라요! 절 도와 물약을 만든 뒤 그녀에게 전해주실 수 있나요?",
  },
  [27604] = {
    ["T"] = "수호자 마란디스를 위한 의뢰",
    ["O"] = "수호자 마란디스는 당신의 연금술 기술을 사용해 인내의 비약 5개를 제작하고 잊혀진 땅의 나이젤의 야영지에 있는 수호자 마란디스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "나는 세나리온 의회의 명령에 따라 중요한 임무를 띠고 이곳에 왔소. 하지만 이 땅은 나와 맞지 않소이다. 관절이 쑤시고, 곁을 맴도는 악마들의 지옥 마력 오염으로 내 가죽이 스멀거린단 말이오.\n\n당신이 숙련된 연금술사임을 눈치챘소. 만일 내게 인내의 비약을 공급해 준다면, 임무를 완수할 때까지 이 땅의 사악함을 견뎌내는 데 도움이 될 거요. 어떻게 생각하오?",
  },
  [27605] = {
    ["T"] = "치안대장 레드패스를 위한 의뢰",
    ["O"] = "수습생 하니웰은 당신의 연금술 기술을 사용해 묘약 5개를 제작하고 힐스브래드 구릉지의 사우스쇼어에 있는 치안대장 레드패스에게 주문품을 가져가기를 원합니다.",
    ["D"] =
    "비밀결사대놈들 대담해졌어, $N. 심지어 전 사우스쇼어 집정관을 암살하기도 했어!\n\n경비병들이 그 은신한 도적들을 볼 수 있도록 내가 묘약을 만들 수 있다면 좋을 텐데, 아직 내겐 그만한 실력이 없다네.\n\n자넨 실력이 있어 보이는데! 이곳 마을에 있는 치안대장 레드패스에게 묘약을 좀 전해주는 선행을 베풀어보지 않겠나?",
  },
  [27606] = {
    ["T"] = "키넬로리를 위한 의뢰",

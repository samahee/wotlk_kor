    ["O"] = "선장 스틸구트가 당신의 요리 기술을 사용해 묘하게 맛있는 오믈렛 10개를 만들어 아라시 고원 팔디르의 만에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "잠깐 쉬러 이 작은 만에 닻을 내렸는데, $N, 이제 블랙스톤 함대가 이 해협을 배회하지 않는다는 확신이 서기 전까진 선원들이 바다로 나가려 하질 않아. 게다가 식량까지 부족해져서 네 도움이 필요해.\n\n듣자 하니 고원엔 랩터가 득실대고, 랩터는 알을 낳는다더군. 하지만 우린 뱃사람이지 사냥꾼이 아니야. 그러니 네가 그 알들을 가져와 요리를 해줘야겠어. 선원들에게 묘하게 맛있는 오믈렛 한 무더기를 배달해 준다면 이 은혜는 절대 잊지 않겠어.",
  },
  [28073] = {
    ["T"] = "선장 허클베리 스모츠의 의뢰",
    ["O"] = "선장 허클베리 스모츠가 당신의 요리 기술을 사용해 대합 구이 10개를 만들어 가시덤불 골짜기 무법항에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "난 지금 큰일 났어, $C. 네골라쉬라는 괴물 놈한테 선장의 커틀러스를 잃어버린 것도 모자라, 무법항에 도착하면 선원들에게 특별한 만찬을 대접하겠다고 약속했거든. 그런데 그 약속을 못 지켰으니 선원들이 점점 불안해하고 있단 말이야.\n\n도와주겠다면 대합 구이 한가득 가져다줘. 해적들이 바다로 나가기 전 입맛 돋우기에 아주 딱 좋은 요리지!",
  },
  [28074] = {
    ["T"] = "나라인 수스팬시의 의뢰",
    ["O"] = "나라인 수스팬시가 당신의 요리 기술을 사용해 미스릴송어 구이 10개를 만들어 타나리스 스팀휘들 항구 근처 자신의 집으로 배달해 주길 원합니다.",
    ["D"] =
    "아, 손님이군! 고블린들이 이 해안에 세운 멋진 도시를 보니 어떤가, 흠? 스팀휘들은 정말 눈부시게 발전했지! 옛날엔 부두 옆에 오두막 몇 채가 전부였는데 말이야. 마치 전생의 일 같군... 어쨌든 넌 내가 과거를 회상하는 걸 들으러 온 게 아니지. 나한테 맛있는 미스릴송어 구이를 요리해주러 온 거잖아, 안 그래? 난 사람들이 무엇을 할지 항상 다 꿰뚫어 보고 있지!",
  },
  [28075] = {
    ["T"] = "시몬 캔트렐의 의뢰",
    ["O"] = "시몬 캔트렐이 당신의 요리 기술을 사용해 훈제 세이지 10개를 만들어 알터랙 산맥 라벤홀트 장원에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "동부 왕국이 내 기술을 절실히 필요로 한다는 걸 알게 되었지. 이곳에 오게 되어 참 다행이야. 단 하나 바라는 게 있다면, 음식이 좀 더... 입맛에 맞았으면 좋겠다는 거야. 예전 아스트라나르에서 먹던 가볍고 섬세한 맛의 훈제 세이지 요리가 몹시도 그립다네.\n\n혹시 모닥불 좀 다룰 줄 아나? 만약 그렇다면 갓 구운 훈제 세이지를 요리해 오게. 합당한 보상을 하겠네.",
  },
  [28076] = {
    ["T"] = "\"늪지눈알\" 자를의 의뢰",
    ["O"] = "\"늪지눈알\" 자를이 당신의 요리 기술을 사용해 거미 소시지 10개를 만들어 먼지진흙 습지대 늪지기 오두막에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "난 개구리 뒷다리를 엄청 좋아하지만 개구리 뒷다리만 평생 먹고 살 순 없어. 뭐, 어쩌면 그럴 수도 있겠지만. 넌 그럴 수 있냐?\n\n어쨌든 난 개구리 말고 다른 게 좀 먹고 싶어. 거미는 별로 안 좋아하는데 거미 고기는 꽤 맛있거든. 거미 소시지 좀 가져다줄래?",
  },
  [28077] = {
    ["T"] = "더크 스윈들의 의뢰",
    ["O"] = "더크 스윈들이 당신의 요리 기술을 사용해 용브레스 칠리 10개를 만들어 황야의 땅 용수철 거점에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "야 거기. 너 요리사지? 네 튜닉에 묻은 기름때를 보니까 척하면 척이군.\n\n저기 동쪽엔 용들이 우글거리고 그놈들 중엔 가끔 입에서 불을 뿜는 녀석들도 있단 말이지. 진짜 부럽더라! 근데 불 뿜는 거라면 방법이 아주 없는 것도 아니야.\n\n용브레스 칠리라고 들어봤어? 그거 나한테 좀 만들어줘. 그럼 나도 용처럼 불을 뿜으면서 세상 행복한 고블린이 될 수 있을 거야.",
  },
  [28078] = {
    ["T"] = "피알 사일런트스트라이드의 의뢰",
    ["O"] = "피알 사일런트스트라이드가 당신의 요리 기술을 사용해 양념 늑대 구이 10개를 만들어 멀고어 블러드후프 마을에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "반갑네, $N! 자네가 요리에 관심이 많다니 도움이 필요하군. 요새 블러드후프 마을엔 배고픈 훈련생들이 차고 넘치는데 먹일 양념 늑대 구이가 똑떨어졌다네. 날 도와 늑대 구이를 더 만들어 준다면, 요리 실력을 닦는 데 유용한 재료들을 넉넉히 나눠주지! 좀 도와주겠나?",
  },
  [28079] = {
    ["T"] = "거널 버치의 의뢰",
    ["O"] = "거널 버치가 당신의 요리 기술을 사용해 빛나는 작은 물고기 구이 10개를 만들어 티리스팔 숲 브릴에 있는 여관으로 배달해 주길 원합니다.",
    ["D"] =
    "휴! 정말 바쁜 하루였어, 화덕 앞에 너무 오래 있었더니 나도 아직 밥 한 술 못 떴다니까.\n\n혹시 도와줄 수 있어? 보아하니 프라이팬 솜씨가 꽤 쓸 만한 것 같은데 나도 잘 구운 빛나는 작은 물고기 요리가 너무 먹고 싶거든. 이 부탁을 들어준다면, 내 특별한 요리용 날재료를 좀 나눠주지. 어때, 콜?",
  },
  [28080] = {
    ["T"] = "라르카의 의뢰",
    ["O"] = "라르카가 당신의 요리 기술을 사용해 삶은 조개 10개를 만들어 불모의 땅 크로스로드에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "술집 관리하는 것보다 더 배고픈 일이 또 있을까? 그 수많은 맛있는 술들을 보고 있자니 배에서 꼬르륵 소리가 멈추질 않아.\n\n근처 바다엔 입에 담기도 벅찰 정도로 온갖 맛있는 해산물들이 넘쳐나. $N, 혹시 삶은 조개 먹어본 적 있어? 난 지금 당장 그게 먹고 싶어 미치겠어. 날 위해 조금만 만들어 준다면 확실하게 보답할게.",
  },
  [28081] = {
    ["T"] = "마그그랜 어스바인더의 의뢰",
    ["O"] = "마그그랜 어스바인더가 당신의 요리 기술을 사용해 무지개날개다랑어 구이 10개를 만들어 돌발톱 산맥의 해바위 야영지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "반갑소, $C. 이 전초기지는 외딴곳에 있어서 투자개발회사나... 대지모신께서 굽어살피시길, 얼라이언스의 공격에 대비해 병력을 유지하는 수많은 업무를 도울 일손이 부족하오.\n\n요리사의 도움이 절실하오. 이곳에 주둔 중인 그런트들을 위해 무지개날개다랑어를 요리해 주실 수 있소? 사슴 고기와 와이번 알 대신 몸에 좋은 따뜻한 생선 요리를 먹으면 기분 전환이 될 거요.",
  },
  [28082] = {
    ["T"] = "카랑 아마카르의 의뢰",
    ["O"] = "카랑 아마카르가 당신의 요리 기술을 사용해 게살 케이크 10개를 만들어 잿빛 골짜기 조람가르 전초기지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "조람 해안에 온 것을 환영하오, $C. 바다의 풍요가 이렇게 가까운데, 참 멀게만 느껴지는군. 당신도 알다시피 나는 이 작은 전초기지의 지휘를 맡고 있는데 사방에서 우릴 위협하는 온갖 위험에 맞서 병력들을 지휘하느라 눈코 뜰 새 없이 바쁘오. 하지만 맛있는 게살 케이크가 너무 먹고 싶군!\n\n나를 위해 조금 만들어 주시면 정말 고맙겠지만 너무 바쁘시다면 이해하겠소. 난 그저 여기서 기다리겠소....",
  },
  [28083] = {
    ["T"] = "키르제 스턴혼의 의뢰",
    ["O"] = "키르제 스턴혼이 당신의 요리 기술을 사용해 마른돼지갈비 10개를 만들어 불모의 땅 타우라조 야영지에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "아, $N! 참 좋은 날씨 아니오? 햇볕은 쨍쨍하고 구름은 높이 떴고, 지금 딱 마른돼지갈비만 있으면 소원이 없겠군!\n\n뭐요, 내가 스테이크를 먹고 싶어 할 줄 알았소? 그건 정말 끔찍한 소리요!\n\n남쪽의 가시멧돼지들이 가시덤불 속에 돼지들을 많이 기르고 있지. 이 늙은 타우렌을 도와주시겠소?",
  },
  [28084] = {
    ["T"] = "도른 플레인스토커의 의뢰",
    ["O"] = "도른 플레인스토커가 당신의 요리 기술을 사용해 수염메기 구이 10개를 만들어 버섯구름 봉우리 바람계곡의 풍화된 골짜기에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "반갑소, $N. 바다가 너무 멀어서 생선이 간절히 먹고 싶구려. 하지만 여기서 맡은 임무 때문에 거길 여행할 시간도 없고, 변변찮은 내 솜씨로 요리할 엄두도 안 나는군.\n\n부탁 하나만 들어주겠소? 갓 구운 수염메기 요리가 먹고 싶어서 말이오. 자네 모닥불 다루는 솜씨가 제법인 것 같은데. 수고비는 두둑하게 쳐주겠소.",
  },
  [28085] = {
    ["T"] = "마윈 슈릴윌의 의뢰",
    ["O"] = "마윈 슈릴윌이 당신의 요리 기술을 사용해 큰곰 숯불구이 10개를 만들어 잊혀진 땅 그늘수렵 마을에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "왕실 연금술사 학회의 지시로 중요한 연구를 하러 이 잊혀진 땅에 왔지만, 고향이 몹시 그립소. 정확히 말하자면 따뜻하고 육즙이 넘치는 큰곰 숯불구이처럼 고향의 가장 맛있는 음식들이 사무치게 그립소.\n\n잊혀진 땅에 곰이 없다는 건 알지만 혹시라도 곰 고기를 들여와 스테이크를 구워준다면 이 지옥 같은 황무지도 조금은 견딜 만해질 거요.",
  },
  [28086] = {
    ["T"] = "죽음의 추적자 레시의 의뢰",
    ["O"] = "죽음의 추적자 레시가 당신의 요리 기술을 사용해 고블린식 매콤한 조개 요리 10개를 만들어 힐스브래드 구릉지 남쪽 경비탑에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "호드에서 최악의 부임지에 온 것을 환영한다, $C: 바로 남부 방벽 탑이지. 볼품없지만, 내 구역이다.\n\n전생에 난 바다 근처에서 많은 시간을 보냈는데 요새 그쪽 해산물 요리가 너무 그립군. 언더시티에서 보급해 주는 배급 식량엔 전혀 매력을 못 느끼겠어. 고블린식 매콤한 조개 요리 한 접시라면 뭐든지 다 내어줄 수 있다. 요리할 줄 안다면 좀 가져다줘라, 수고비는 두둑이 챙겨주지!",
  },
  [28087] = {
    ["T"] = "키타 파이어윈드의 의뢰",
    ["O"] = "키타 파이어윈드가 당신의 마법부여 기술을 사용해 룬이 새겨진 구리 마법막대 1개를 만들어 엘윈 숲 아조라의 탑에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "흠, 초보 마법부여사인가요? 진행 상황이 어떤지 볼까요. 룬이 새겨진 구리 마법막대를 하나 만들어서 보여주세요. 잘 해내신다면, 실력을 더 키운 후에 다시 뵙게 될지도 모르겠군요.",
  },
  [28366] = {
    ["T"] = "의무병의 의식",
    ["O"] = "오그리마 지혜의 골짜기에 있는 아이트리그와 대화하십시오.",
    ["D"] =
    "응급치료 수업을 마치셨군요. 훌륭합니다, $N.\n\n마침 잘 오셨습니다. 호드에 노련한 의무병이 필요합니다. 대족장님께서 직접 그의 오른팔 아이트리그에게 적임자를 찾으라 명하셨고, 저는 당신보다 이 일에 더 어울리는 자를 떠올릴 수 없습니다.\n\n부름에 응하시겠다면, 지혜의 골짜기에서 아이트리그를 찾으십시오.",
  },
  [28367] = {
    ["T"] = "의무병의 의식",
    ["O"] = "불타는 평원에서 요원 메리건과 하사관 그루말을 수색하십시오.",
    ["D"] =
    "신생 호드 합류를 거부한 검은바위 오크들이 어둠의 세력과 동맹을 맺었소. 얼라이언스는 그들의 근거지인 검은바위 산 침투를 우리에게 제안했고 우린 동의했지. 하지만 임무를 띠고 간 요원들이 아직 복귀 보고를 하지 않았소.\n\n불타는 평원으로 가서 그들에게 무슨 일이 생겼는지 알아볼 뛰어난 의료 기술을 가진 자가 필요하오. 당신이 찾아야 할 자들은 전쟁노래 부족의 그런트, 하사관 그루말과 변장한 인간인 요원 메리건이오. 그들이 죽었다면 즉시 돌아와 보고하시오. 만약 살아 있다면 그들이 임무를 완수할 수 있도록 당신이 도울 방법이 있을 거요.",
  },
  [28368] = {
    ["T"] = "의무병의 의식",
    ["O"] = "요원 메리건이 응급치료 기술을 사용해 강력한 해독제를 제작해 불타는 평원에 있는 그의 동굴로 가져와 달라고 합니다.",
    ["D"] =
    "임무에 대해선 곧 설명해 주지. 하지만 그 전에 시급한 상황부터 처리해야 해.\n\n내 위장은 꽤나 성공적이었지만 홀든을 향한 애정만큼은 숨기기 어렵더군. 홀든이 독에 당했어, 아마 검은바위 놈들이 내 결의를 시험해 보려 한 거겠지. 간신히 독이 퍼지는 속도를 늦춰놓긴 했지만, 강력한 해독제가 없으면 녀석은 죽고 말 거야.\n\n홀든을 구해줘. 그러면 네가 원하는 걸 모두 말해주겠어.",
  },
  [28369] = {
    ["T"] = "의무병의 의식",
    ["O"] = "검은바위 요새에서 우스모그 스파인브레이커를 처치하고, 그가 소지한 문서를 불타는 평원의 요원 메리건에게 가져가십시오.",
    ["D"] =
    "난 약속을 지키는 사람이다, $C. 이제 홀든이 회복하고 있으니 무슨 일이 있었는지 말해주지.\n\n검은바위 놈들은 우리가 나타난 걸 의심하지 않았어. 쉽게 부대 명부에 잠입했지만, 아뿔싸 서로 다른 순찰대에 배정받으면서 그루말 하사관과 떨어지고 말았지. 그 탓에 위장을 유지하는 게 더 힘들어졌지 뭐야. 겉모습이야 오크와 똑같을지 몰라도 세세한 부분까진 다 알 수 없으니까. 그래서 난 빠질 수밖에 없었어.\n\n그루말은 적응하는 데 아무 문제 없었을 테지만, 며칠째 녀석을 보지 못했어. 어디로 배치되었는지도 모르고. 그 정보를 알고 있는 건 검은바위 요새의 사령관, 우스모그 스파인브레이커뿐이야. 놈만이 부대 배치가 적힌 유일한 문서를 가지고 있어. 무리한 부탁이겠지만, 우리가 필요한 정보를 얻으려면 네가 놈을 처치해야 해.",
  },
  [28370] = {
    ["T"] = "의무병의 의식",
    ["O"] =
    "요원 메리건이 응급치료 기술을 사용하여 두꺼운 룬무늬 붕대 20개를 만들고 검은바위 산의 검은바위 첨탑 하층에 침투해 하사관 그루말을 찾아 달라고 합니다.",
    ["D"] =
    "흠, 적어도 그루말의 이름이 부대 명단에는 있군. 그건 그가 아직 살아있다는 뜻일 거야.\n\n하지만 나쁜 소식은 녀석이 검은바위 첨탑의 병참장교 경비병으로 배정되었다는 거야. 거긴 엄청나게 넓다고! 첨탑 어디에 있을지 몰라.\n\n홀든을 안으로 데려갈 순 없어. 어차피 난 스톰윈드로 복귀해서 이 환영 마법도 지워야 하고. 그루말을 구출할 팀을 짜는 건 네게 맡기도록 하지. 갈 때 두꺼운 룬무늬 붕대를 챙겨가도록 해. 그가 다쳤을지도 모르니 말이야.",
  },
  [28371] = {
    ["T"] = "의무병의 의식",
    ["O"] = "검은바위 첨탑 하층에 있는 하사관 그루말이 오그리마의 아이트리그나 스톰윈드의 렌직에게 해독제 샘플을 전해 달라고 합니다.",
    ["D"] =
    "아, 한결 낫군. 시간이 지나면 다 나을 거요.\n\n검은바위 놈들이 새로운 해독제를 만들었는데, 그걸 내 몸에다 시험해 보더군. 밤마다 전갈에 쏘이는 것에 신물이 난 모양이야.\n\n비록 우리가 아무것도 알아내지 못했어도, 이 의학적 돌파구일지도 모를 약에 대해서는 알게 되었소. 이 해독제 샘플을 당신 진영의 지도자에게 가져가시오. 나는 좀 쉬고 나면 혼자서도 검은바위 첨탑을 빠져나갈 수 있을 거요.",
  },
  [28372] = {
    ["T"] = "의무병의 의식",
    ["O"] = "실리더스에 서식하는 돌꼬리집게전갈의 독에 검은바위 해독제를 시험해본 후, 오그리마의 아이트리그나 스톰윈드의 렌직에게 돌아가십시오.",
    ["D"] =
    "이 해독제가 가장 강력한 전갈의 독에 쓰인다고 하니, 한번 시험해 봅시다.\n\n칼림도어 동남쪽 먼 끝, 실리더스라는 잊혀진 땅으로 떠난 탐험대에서 초기 보고가 들어왔소. 보고에 따르면 이전엔 보지 못한 아주 강력한 독을 품은 전갈을 포함해 공격적인 야수들이 있다더군.\n\n이 해독제의 효능을 시험하기에 그보다 완벽한 장소는 없을 것 같소. 그곳으로 여행을 떠나 이 해독제로 전갈의 독을 해독해 보시오. 그리고 약효가 어떤지 돌아와서 내게 알려주시오.",
  },
  [28373] = {
    ["T"] = "의무병의 의식",
    ["O"] = "스톰윈드의 구 시가지 지구에 있는 SI:7의 칼잡이 렌직과 대화하십시오.",
    ["D"] =
    "응급치료 수업을 마치셨군요. 훌륭합니다, $N.\n\n마침 잘 오셨습니다. 얼라이언스에 노련한 의무병이 필요합니다. 볼바르님께서 직접 SI:7에 적임자를 찾으라 명하셨고, 저는 당신보다 이 일에 더 어울리는 자를 떠올릴 수 없습니다.\n\n부름에 응하시겠다면, 구 시가지의 SI:7에서 칼잡이 렌직을 찾으십시오.",
  },
  [28374] = {
    ["T"] = "의무병의 의식",
    ["O"] = "불타는 평원에서 요원 메리건과 하사관 그루말을 수색하십시오.",
    ["D"] =
    "신생 호드 합류를 거부한 검은바위 오크들이 어둠의 세력과 동맹을 맺었소. 얼라이언스는 그들의 근거지인 검은바위 산 침투를 우리에게 제안했고 우린 동의했지. 하지만 임무를 띠고 간 요원들이 아직 복귀 보고를 하지 않았소.\n\n불타는 평원으로 가서 그들에게 무슨 일이 생겼는지 알아볼 뛰어난 의료 기술을 가진 자가 필요하오. 당신이 찾아야 할 자들은 전쟁노래 부족의 그런트, 하사관 그루말과 변장한 인간인 요원 메리건이오. 그들이 죽었다면 즉시 돌아와 보고하시오. 만약 살아 있다면 그들이 임무를 완수할 수 있도록 당신이 도울 방법이 있을 거요.",
  },
  [28375] = {
    ["T"] = "부관 레이너의 의뢰",
    ["O"] = "키타 파이어윈드가 마법부여 기술을 사용해 제공된 경비병 갑옷에 가슴 방어구 마법부여 - 최하급 생명력을 주문한 뒤, 엘윈 숲 서부 주둔지의 부관 레이너에게 가져다 달라고 합니다.",
    ["D"] =
    "스톰윈드 경비대에는 우리의 기술이 필요한 이들이 많지만, 마법 가루가 턱없이 부족해요. 여기, 이 경비병 갑옷에 가슴 방어구 마법부여 - 최하급 생명력을 부여해서 마법이 깃든 경비병 갑옷으로 만든 다음 서부 주둔지의 부관 레이너에게 가져다주세요.",
  },
  [28376] = {
    ["T"] = "산악경비대 발리브루의 의뢰",
    ["O"] = "틸리 시슬퍼즈가 마법부여 기술을 사용해 수호자의 팔보호구에 팔보호구 마법부여 - 최하급 체력을 주문한 뒤, 던 모로 남부 관문 전초기지의 산악경비대 발리브루에게 가져다 달라고 합니다.",
    ["D"] =
    "부탁받은 주문 몇 개를 처리하는 데 도움이 좀 필요해. 이건 남부 관문 전초기지의 산악경비대 발리브루를 위한 주문이야. 자신의 수호자의 팔보호구에 체력 마법부여를 해달라며 맡겨두었지. 마법부여가 끝난 팔보호구를 그에게 전해 줘.",
  },
  [28377] = {
    ["T"] = "원로원의원 메르 스톤할로우의 의뢰",
    ["O"] = "틸리 시슬퍼즈가 마법부여 기술을 사용해 웅변가의 로브에 가슴 방어구 마법부여 - 최하급 마법 흡수를 주문한 뒤, 던 모로 골볼라 채석장의 원로원의원 메르 스톤할로우에게 가져다 달라고 합니다.",
    ["D"] =
    "원로원의원을 기다리게 하고 싶지 않아. 그는 골볼라 채석장을 시찰 중인데, 그곳에 문제가 좀 있나 봐. 최하급 마법 흡수가 마법부여된 새 웅변가의 로브를 주문했어. 네가 이 주문을 처리해 줄 수 있겠지?",
  },
  [28378] = {
    ["T"] = "코리드라스 문레이지의 의뢰",
    ["O"] = "알란나 레이븐아이가 마법부여 기술을 사용해 하급 마술봉 1개를 제작한 후, 텔드랏실 돌라나르의 코리드라스 문레이지에게 배달해 달라고 합니다.",
    ["D"] =
    "이슈누, 친절한 마법부여사여. 의뢰 하나 맡아볼 텐가? 돌라나르의 코리드라스 문레이지가 예복이 완성되는 대로 근무지를 떠나 엘룬의 사제가 될 예정이라네. 그는 사제라는 새 직분에 걸맞은 마술봉이 필요하지. 자네가 하급 마술봉을 만들어 그에게 배달해 준다면, 그는 대단히 고마워할 테고 물론 그에 대한 보상도 지불될 걸세.",
  },
  [28379] = {
    ["T"] = "달의여사제 아마라의 의뢰",
    ["O"] =
    "알란나 레이븐아이가 마법부여 기술을 사용해 제공된 여사제의 망토에 망토 마법부여 - 최하급 저항을 주문한 뒤, 돌라나르와 다르나서스 사이의 길을 순찰하는 달의여사제 아마라에게 배달해 달라고 합니다.",
    ["D"] =
    "달의 여사제들이 길을 경비하고 있는데, 아마라가 자신의 여사제의 망토에 최하급 저항 마법부여를 해달라고 요청했다네. 자네도 연습이 좀 필요해 보이니 이 의뢰를 맡아보는 건 어떤가? 그녀는 돌라나르에서 다르나서스로 향하는 길을 순찰하고 있다네. 날 대신해 준 수고비는 물론 돌려주겠네. 안 그래도 오늘은 좀 쉬고 싶던 참이었거든.",
  },
  [28380] = {
    ["T"] = "레빌 코스트의 의뢰",
    ["O"] = "레빌 코스트가 마법부여 기술을 사용해 작고 반짝이는 결정 1개를 제작해 서부 몰락지대 감시의 언덕에 있는 자신에게 배달해 달라고 합니다.",
    ["D"] =
    "이전 일터에서 너무 급하게 떠나오는 바람에 몇 가지 물건을 두고 왔소. 당신 마법부여사 맞지? 나한테 작고 반짝이는 결정을 하나 양보해 줄 수 있소? 물론 대가는 지불하리다!",
  },
  [28381] = {
    ["T"] = "민병대원 가리엘의 의뢰",
    ["O"] = "레빌 코스트가 마법부여 기술을 사용해 제공된 민병대 팔보호구에 팔보호구 마법부여 - 최하급 민첩성을 주문한 뒤, 서부 몰락지대 감시의 언덕에 있는 민병대원 가리엘에게 배달해 달라고 합니다.",
    ["D"] =
    "사람들은 내가 신비한 잡일이나 처리해 줄 만큼 시간이 넘쳐나는 줄 아나 본데, 난 그렇게 한가하지 않다고. 여기, 민병대원 가리엘이 이 민병대 팔보호구에 최하급 민첩성 마법부여를 해달라고 부탁했는데, 이걸 네게 넘기도록 하지. 보아하니 네가 그런 선행을 베풀 만한 위인 같으니 말이야. 일이 끝나면 감시의 언덕에 있는 큰 탑에서 그녀를 찾을 수 있을 거다.",
  },
  [28382] = {
    ["T"] = "울란나의 의뢰",
    ["O"] = "테렌디스가 마법부여 기술을 사용해 제공된 솜털 망토에 망토 마법부여 - 최하급 보호를 주문한 뒤, 어둠해안 고대정령의 숲에 있는 울란나에게 배달해 달라고 합니다.",
    ["D"] =
    "어둠해안에서 타락의 징후가 발견되었으니, 미리 예방 조치를 취하는 것이 현명할 걸세. 내 사촌 울란나는 멀리 남쪽 고대정령의 숲에서 무역 보급소를 운영하고 있지. 이 솜털 망토에 최하급 보호 마법부여를 한 뒤 그녀에게 가져가 주게. 마을에서 너무 멀리 떨어져 있어서 그녀의 안전이 걱정되는구먼.",
  },
  [28383] = {
    ["T"] = "테렌디스의 의뢰",
    ["O"] = "테렌디스가 마법부여 기술을 사용해 룬이 새겨진 은마법막대 1개를 제작해 어둠해안 아우버다인에 있는 자신에게 배달해 달라고 합니다.",
    ["D"] =
    "미신일지도 모르지만 은이 타락을 막는 데 효과적이라고 하더군. 부디 룬이 새겨진 은마법막대를 만들어 주게나, 마법부여사여. 막대에 마법으로 새겨진 문양들이 내가 하는 일에 분명 어떻게든 도움이 될 거야.",

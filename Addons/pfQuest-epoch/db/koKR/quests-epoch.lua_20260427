  [26575] = {
    ["T"] = "암흑의 주술사",
    ["O"] = "정복 보고서를 가라앉은 주술사 제단에 가져가 멀리 있는 아트라시스와 대화하십시오.",
    ["D"] =
    "마른나무껍질 트롤의 시체에서 그들 지도자들 사이에 오고 간 것으로 보이는 구겨진 서신을 발견했습니다. 내용물을 읽어보면 불타는 언덕에서 일어나는 일에 대한 실마리를 찾을 수 있을지도 모릅니다. 아트라시스가 이것에 관심을 보일 것입니다.",

  [26176] = {
    ["T"] = "우아한 낙하",
    ["O"] = "전자동 낙하산 꾸러미를 팔스타드 와일드해머에게 전달하십시오.",
    ["D"] = "이것으로 우리가 와일드해머의 환심을 사지 못한다면, 무엇이 통할지 모르겠네요. 절 위해 이걸 팔스타드에게 전해주는 영광을 누리시겠어요?",
  },
  [26177] = {
    ["T"] = "뾰족부리그리핀 친구들",
    ["O"] = "그리핀 간식을 만들 농어 스테이크 8개와 우아한 입질 갈대 줄기 12개를 모으십시오.",
    ["D"] =
    "우리 부족은 그리핀을 신성한 동물로 숭배한다네. 하늘의 장엄한 피조물이자 단순한 짐승 그 이상이지. 지능이 높고 교활하기까지 해. 어떤 이들은 우리가 그리핀을 말처럼 부린다고 말하지만 우정에 더 가깝네.\n\n이곳의 와일드해머 부족과 친구가 되고 싶다면 먼저 우리 그리핀들과 친구가 되게나! 그들이 가장 좋아하는 간식은 흔치 않은 것이지. 아삭아삭한 갈대와 신선한 생선 스테이크를 섞은 것이라네. 이 녀석들은 거기에 환장하지.\n\n그들을 위한 간식을 만들려면 재료를 모아야 해. 여기서 동쪽으로 가면 아골와타 근처에서 시작해 해안을 따라 흐르는 강으로 이어지는 큰 냇물을 찾을 수 있을 거네. 바로 그곳에서 통통한 농어와 우아한 입질 갈대를 찾을 수 있지. 그것들을 구해 내게 가져오면 신선한 간식을 만들어 주겠네.",
  },
  [26178] = {
    ["T"] = "뾰족부리그리핀 친구들",
    ["O"] = "맹금의 봉우리 남동쪽에서 발견되는 길들인 뾰족부리그리핀에게 그리핀 간식을 주십시오.",
    ["D"] = "이 먹이 주머니를 가져가게. 아주 신선하고 맛있을 거야. 우리가 길들인 뾰족부리 그리핀들은 사육장 남동쪽 숲을 돌아다니지. 가서 몇 마리에게 먹이를 좀 주고 와주겠나?",
  },
  [26179] = {
    ["T"] = "동부 내륙지의 은둔자",
    ["O"] = "은둔자 우보를 찾으십시오. 레반터스크 마을의 경비병이었던 그는 마을에서 거북 고기를 식량으로 쓰는 것에 불만을 품고 떠났습니다.",
    ["D"] =
    "문제가 생겼는데, 해결해 줄 당신처럼 튼튼한 사람이 필요해요.\n\n우리 경비병 중 한 명인 은둔자 우보가 거북이 고기를 싫어해서 마을을 떠났죠. 지금은 여기서 북쪽에서 혼자 살고 있어요.\n\n우리는 우보와 그의 경비 실력이 그리워요. 그가 마을로 돌아왔으면 좋겠어요. 그를 찾아 데려오면 좋은 보상을 해 드릴게요. 우리를 위해 이 일을 해 주겠어요?",
  },
  [26180] = {
    ["T"] = "무쇠턱거북 간식",
    ["O"] = "무쇠턱거북 간식을 만들 농어 스테이크 8개와 우아한 입질 갈대 줄기 12개를 모으십시오.",
    ["D"] =
    "만약 로아가 거북이의 형상을 취했다면, 그들은 아주 특별한 존재임에 틀림없어. 난 잔달라 부족도 아니고 우리 엄마도 아니었지만, 모든 트롤들이 숭배하는 로아들에 대한 이야기를 듣는 걸 좋아했지.\n\n레반터스크 부족은 엄청난 양의 거북 고기를 먹어치우고, 심지어 재미로 죽이기까지 해. 정말 역겨운 일이야.\n\n난 이 거북이들에게 토르가조차 기뻐할 만한 제물을 주고 싶어. 그들이 상류 강에서 이곳 해안으로 휩쓸려 온 특이한 갈대와 물고기를 먹는 걸 본 적이 있지. 그것들과 생선 스테이크를 좀 모아다 주겠어? 거북이들에게 맛있는 간식을 만들어 주게.",
  },
  [26181] = {
    ["T"] = "간식 배급",
    ["O"] = "동부 내륙지의 해안을 따라 있는 무쇠턱거북들에게 간식을 먹이십시오.",
    ["D"] = "가져온 재료로 무쇠턱거북들을 위한 특별한 간식을 만들었지. 내 부탁 하나만 들어주게. 해안을 따라 늘어선 무쇠턱거북들에게 이 간식을 나눠주고 오게.",
  },
  [26182] = {
    ["T"] = "평화의 제물",
    ["O"] = "동부 내륙지의 해안을 따라 거북이 \"배설물\" 8개를 수집하십시오.",
    ["D"] =
    "이제 내가 왜 이 거북이들을 그토록 사랑하고 다시는 마을로 돌아가지 않으려는지 알겠나? 레반터스크 부족이 자네 같은 모험가를 보내서 돌아오라고 설득하는 꼴에도 신물이 났네. 이 골칫거리를 영원히 잠재울 완벽한 메시지가 생각났어.\n\n자네가 나눠준 간식에는 부수적인 효과가 있네. 거북이들의 소화관을 아주 빠르게 통과한다는 거지. 그 말인즉슨, 우리가 레반터스크 놈들에게 선물 포장을 해줄 \"배설물\"이 넉넉하다는 뜻이야.\n\n가서 그것들을 수집해 내게 가져오게. 아직 따끈따끈할 때 서둘러 돌아오는 게 좋을 거야.",
  },
  [26183] = {
    ["T"] = "평화의 제물",
    ["O"] = "우보의 오두막 북쪽의 섬에서 우보의 장식용 상자를 회수하십시오.",
    ["D"] =
    "다음 단계는 근사하고 화려한 상자를 구해서 놈들이 진짜 좋은 선물인 줄 알게 만드는 거네. 지금 생각해 보니, 먼저 자네 손에 똥을 묻히기 전에 상자부터 구하게 할 걸 그랬군... 뭐 어쩔 수 없지!\n\n여기 북쪽 작은 섬에 어머니가 돌아가신 후 유골을 담아 안치했던 화려한 상자가 있어. 훌륭한 수공예품이라 이 계획에 딱 맞을 테고, 더 중요한 건 우리 어머니도 이 상황을 무척 재미있어하실 거라는 점이지.",
  },
  [26184] = {
    ["T"] = "평화의 제물",
    ["O"] = "우보의 평화 제물을 동부 내륙지의 레반터스크 마을에 있는 감시자 오웨이에게 가져가십시오.",
    ["D"] =
    "이 \"평화 제물\"을 마을에 있는 감시자 오웨이에게 가져가게나. 그러면 그가 나와 이야기하라고 자네 같은 모험가들을 더 이상 보내지 않을 거라 생각하네.\n\n가봐 - 그리고 자네가 제발 마지막이기를 바라네.",
  },
  [26185] = {
    ["T"] = "라드의 잃어버린 구슬",
    ["O"] = "동부 내륙지 해안을 순찰하는 것으로 자주 목격되는 상어 채터조에게서 라드의 구슬을 수집하십시오.",
    ["D"] =
    "가끔 라드는 부두에 가서 바다에 돌멩이를 던지는 걸 좋아해. 라드는 물수제비를 세 번이나 띄운 적도 있다고!\n\n라드가 너무 신나서 그만 구슬을 물에 던져버렸지... 그리고 다음 순간, 못된 상어 채터조가 헤엄쳐 와서는 구슬을 삼켜버린 거야! 채터조의 뱃속에서 라드의 구슬을 꺼내줄 수 있어?",
  },
  [26186] = {
    ["T"] = "먼 곳에서 온 부품",
    ["O"] = "간식이 든 바구니를 아이언포지의 마이올로 선더퓨리에게 가져가 공성 전차 부품으로 교환하십시오.",
    ["D"] =
    "아이언포지에서 이렇게나 멀리 떨어진 곳에서 공성 전차를 유지보수하기란 여간 지옥이 아닙니다. 우리는 공식적으로 얼라이언스 소속이 아니기 때문에 가장 최신형, 최고급 부품을 사용할 권한이 없습니다.\n\n밖에 있는 외교관에게 공식적인 지원을 요청할 수는 있겠지만, 그가 승낙한다 하더라도 번거로운 행정 절차와 헛소리에 휘말리게 될 겁니다. 내 아내가 우리에게 직접 보급품을 전달받을 수 있는 더 간단한 방법을 생각해 냈습니다. 바로 식량입니다! 모든 드워프는 음식에 약하니까요.\n\n이 간식이 든 바구니를 아이언포지의 마이올로 선더퓨리에게 가져다주고 교환품으로 부품을 좀 가져다주십시오.",
  },
  [26187] = {
    ["T"] = "먼 곳에서 온 부품",
    ["O"] = "공성 전차 부품 상자를 맹금의 봉우리의 선임기술자 우룰에게 돌려주십시오.",
    ["D"] =
    "보통은 아이언포지의 방어 시설에서 어떤 부품도 빠져나가게 두지 않겠지만, 당신이 내게 가져온 것을 생각하면... 뭐... 이번 한 번은 눈감아 줄 수도 있겠지? 빨리 먹어보고 싶군. 이 부품들을 와일드해머 쪽에 가져다주게. 그럼 이 문제는 해결된 것으로 하지.\n\n다음번엔 에일 맥주도 좀 던져 달라고 전하게나!",
  },
  [26188] = {
    ["T"] = "추적자 추적하기",
    ["O"] =
    "동부 내륙지 맹금의 봉우리의 그리핀 조련사 탈론액스가 은빛갈기 늑대 15마리와 은빛갈기 긴울음늑대 15마리를 죽이라고 합니다. 임무를 완료하면 그에게 돌아가십시오. 탈론액스는 늑대들이 동부 내륙지의 숲속에 숨어 있다고 언급했습니다.",
    ["D"] =
    "수많은 용감한 드워프들이 동부 내륙지의 혹독한 야생에서 목숨을 잃었소, $r. 은빛갈기 늑대는 우리 사냥꾼들에게 가장 큰 위협 중 하나요. 그들은 덤불과 지형지물 사이에 숨어 기다리다가 기회가 오면 공격을 가하오.\n\n이런 흉포함을 계속 방치해둘 수는 없소!\n\n은빛갈기를 찾으려면 그들처럼 생각해야 하오. 늑대와 긴울음늑대들을 추적하시오! 모조리 처치하시오!",
  },
  [26189] = {
    ["T"] = "최고의 진흙괴물",
    ["O"] = "거대 진흙괴물에게서 거대 진흙괴물 샘플을 수집하십시오.",
    ["D"] =
    "아는 드워프는 많지 않겠지만, 내 양조 기술의 진정한 묘미를 끌어내기 위해 나는 이 주변의 수액괴물을 약간 첨가한다네. 맞아, 자네 말이 맞아. 그 드워프를 잡아먹는 거대한 녹색 수액괴물들 말이야.\n\n하지만 이 맥주는 엄청난 자극이 필요해. 그래서 거대한 진흙괴물이 필요하다네! 저 아래 스컬크 바위에 가면 모든 수액괴물의 어미가 도사리고 있는데, 정말 엄청나게 크지... 우린 그걸 다이어글롭이라고 부른다네.\n\n자네가 그럴 자격이 있다면, 거기로 내려가 다이어글롭의 살점을 조금 떼어다 주게!",
  },
  [26190] = {
    ["T"] = "최고의 진흙괴물",
    ["O"] = "거대 진흙괴물에게서 거대 진흙괴물 샘플을 수집하십시오.",
    ["D"] =
    "미끌미끌한 수액괴물들을 조사하는 데 관심이 있소? 스컬크 바위의 수액괴물들은 장난이 아니오. 아무리 소탕해도 트롤들이 그런 것처럼 다시 재생해서 계속 되살아나는 것 같소... 뭐 그런 식이지.\n\n내 생각엔 저 아래 수액괴물을 끝없이 토해내는 근원이 있는 것 같소. 그게 뭔지 알아내고 싶소! 그러니 모험가여, 스컬크 바위로 내려가서 수액괴물들을 만들어내는 그 원흉의 표본을 내게 가져오시오. 그걸 연구하는 건 정말 흥미로운 일일 거요!",
  },
  [26191] = {
    ["T"] = "잔인한 임무",
    ["O"] = "맹금의 봉우리 동쪽에서 흉포한 올빼미야수 10마리를 처치하십시오.",
    ["D"] =
    "지역 내 트롤들과의 지속적인 불화는 종종 평화로운 교착 상태로 사그라지기도 하지만 평화는 결코 오래가지 않소.\n\n동부 내륙지 바깥에서는 지역의 올빼미야수들이 상황을 더 악화시키고 있소. 놈들은 가끔 트롤 무리를 습격하거나 와일드해머 보급 수레를 약탈하여 비난과 원성이 난무하는 전투로 확대되기도 하오.\n\n평화를 향해 나아가고 싶다면 그 올빼미야수들을 교란해야 하오. 동쪽으로 가서 놈들의 수를 줄여준다면 화난 마음도 가라앉을 거요.",
  },
  [26192] = {
    ["T"] = "원시적인 타격",
    ["O"] = "동부 내륙지의 중앙 지역에서 사나운 올빼미야수 10마리를 찾아 처치하십시오.",
    ["D"] =
    "동쪽으로 더 갈수록 올빼미야수들은 더 원시적이고 강인해진다네. 놈들의 수를 줄이는 건 점점 더 어려워지겠지만 와일드해머 부족을 위해 우리가 해야만 하는 일이라네.\n\n동부 내륙지의 중심부로 가서 올빼미야수의 숫자를 줄여주게. 네가 짐승을 베어 넘길 때마다 동부 내륙지는 한결 더 평화로워질 거야.",
  },
  [26193] = {
    ["T"] = "야만적인 일격",
    ["O"] = "광풍로 절벽 근처 먼 동쪽에서 포악한 올빼미야수 10마리를 찾아 처치하십시오.",
    ["D"] =
    "해안의 레반터스크 마을과 가장 가까운 곳에 있는 올빼미야수들이 가장 큰 피해를 주고 있습니다. 놈들이 최근 레반터스크 정찰대를 죽였다는 소식을 들었지만, 트롤들이 숨진 동료를 발견했을 때는 우리가 누명을 썼죠. 이런 부탁을 하게 되어 가슴이 아프지만, 그 올빼미야수들이 드워프와 트롤 사이의 긴장을 기하급수적으로 키우도록 놔둘 수는 없습니다.\n\n포악한 올빼미야수들은 더 강하고 겉보기에도 더 다혈질인 것 같으니 조심하세요 -- 하지만 우리는 그들을 진압해야 합니다.",
  },
  [26194] = {
    ["T"] = "올빼미야수의 지도자",
    ["O"] = "리레크의 형상을 찾아 불을 붙여 그를 깨우십시오. 그가 나타나면 그를 처치하십시오.",
    ["D"] =
    "이제 이 지역에 놈들의 수가 줄었으니 그들의 \"지도자\"를 제거해야 해. 놈들의 우두머리는 그저 이 일대에서 가장 덩치가 크고 사나운 올빼미야수일 뿐이야. 다른 녀석들은 그를 두려워하거나 존경하지... 둘 중 어느 쪽인지는 확실치 않지만.\n\n놈의 이름은 리레크고 진타알로 북쪽, 여기서 아득히 먼 동쪽에서 찾을 수 있어. 우리 정찰병들 말에 따르면 그는 매우 은밀한 짐승이지만 다른 녀석들보다 똑똑하다고 해. 자기가 사는 곳에 우상을 세우는 모습이 목격되기도 했지. 그를 유인해 내려면 우상 하나를 불태워 봐. 그럼 분명 은신처에서 기어 나올 거야.",
  },
  [26195] = {
    ["T"] = "올빼미야수의 지도자",
    ["O"] = "리레크의 형상을 찾아 불을 붙여 그를 깨우십시오. 그가 나타나면 그를 처치하십시오.",
    ["D"] =
    "이제 이 지역에 놈들의 수가 줄었으니 그들의 \"지도자\"를 제거해야 해. 놈들의 우두머리는 그저 이 일대에서 가장 덩치가 크고 사나운 올빼미야수일 뿐이야. 다른 녀석들은 그를 두려워하거나 존경하지... 둘 중 어느 쪽인지는 확실치 않지만.\n\n놈의 이름은 리레크고 진타알로 북쪽, 여기서 아득히 먼 동쪽에서 찾을 수 있어. 우리 정찰병들 말에 따르면 그는 매우 은밀한 짐승이지만 다른 녀석들보다 똑똑하다고 해. 자기가 사는 곳에 우상을 세우는 모습이 목격되기도 했지. 그를 유인해 내려면 우상 하나를 불태워 봐. 그럼 분명 은신처에서 기어 나올 거야.",
  },
  [26196] = {
    ["T"] = "거북의 힘",
    ["O"] = "동부 내륙지 동쪽 해안의 광풍로 절벽을 따라 있는 거북이들에게서 거북 살코기 10개를 수집하십시오.",
    ["D"] =
    "거친 와일드해머 부족원이 긴 하루를 보낸 후 가장 먼저 찾는 것은 맛있는 에일 맥주 한 잔과 먹을거리라네. 이 근방에서 가장 맛있는 요리는 훌륭한 거북이 스튜지.\n\n슬프게도 맹금의 봉우리는 동부 내륙지에서 거대 거북이들과 가장 멀리 떨어진 곳이라네. 광풍로 절벽으로 가서 나를 위해 거북이를 사냥해주게. 내가 요리를 시작할 수 있도록 놈들의 살코기를 좀 가져다주게나!",
  },
  [26197] = {
    ["T"] = "거북의 힘",
    ["O"] = "",
    ["D"] = "",
  },
  [26198] = {
    ["T"] = "수배: 파울크레스트",
    ["O"] = "용맹바람 호수 주변을 순찰하는 파울크레스트를 찾아 그를 고통에서 해방시켜 주십시오.",
    ["D"] =
    "몇 달 전, 일상적인 하늘 순찰 중에 용감한 와일드해머 부족원이 쏟아지는 트롤 창에 맞아 하늘에서 떨어졌습니다. 그의 충직한 그리핀 동료 파울크레스트는 이 죽음을 무척 슬퍼했습니다. 그 이후로 파울크레스트는 야생동물, 트롤, 드워프를 가리지 않고 마주치는 모든 것을 죽임으로써 자신의 분노를 표출해 오고 있습니다. 그 불쌍한 짐승을 편안하게 안락사시켜 주어야 합니다. 파울크레스트가 최후를 맞이했다는 증거를 맹금의 봉우리에 있는 그리핀 조련사들에게 가져오십시오.",
  },
  [26199] = {
    ["T"] = "수배: 파울크레스트",
    ["O"] = "용맹바람 호수 주변을 순찰하는 파울크레스트를 찾아 그를 처치하십시오.",
    ["D"] =
    "몇 달 전에 와일드해머 부족 놈 하나가 우리 창 세례를 맞고 하늘에서 떨어졌어. 그놈의 그리핀인 파울크레스트가 몹시 분노했지. 그 이후로 그놈은 피의 광란에 빠져 야생동물, 트롤, 드워프를 가리지 않고 마구잡이로 죽여대고 있어. 그놈이 최후를 맞이했다는 증거를 레반터스크 마을의 감시자 오웨이에게 가져와.",
  },
  [26200] = {
    ["T"] = "숲의 균형",
    ["O"] = "어린 달빛야수 5마리와 달빛야수 10마리를 처치하고 아우버다인의 파수꾼 글린다 날셰에게 돌아가십시오.",
    ["D"] =
    "이쉬누 알라, $N. 삶의 모든 것에는 균형이 있으며, 엘룬께서는 숲이 그 균형을 유지할 수 있도록 굽어살피십니다. 최근 그 균형이 흔들리고 있어서 뭔가 조치를 취하지 않으면 아제로스의 기반 자체가 뒤흔들릴까 걱정스럽습니다. 우리는 엘룬께 우리를 도와줄 이를 보내 달라고 기도했고, 마침 당신이 도착했군요.\n\n현재 이 불균형의 주된 원인은 동쪽의 달빛야수 군락에 있습니다. 텔드랏실에서도 평화롭던 올빼미야수 군락이 무법천지로 변하는 비슷한 일이 일어났다는 보고를 받았습니다. 달빛야수들은 보이는 모든 것을 공격하며 자연의 섭리를 파괴하고 있습니다. 부디, 가셔서 그 군락을 처리하고 숲의 균형을 되찾아주십시오.",
  },
  [26201] = {
    ["T"] = "숲의 균형",
    ["O"] = "달빛야수 현자 3마리와 사나운 달빛야수 10마리를 처치한 뒤, 아우버다인의 파수꾼 글린다 날셰에게 돌아가십시오.",
    ["D"] =
    "안타깝게도 우리가 정화한 구역은 군락의 작은 일부에 불과했던 모양입니다. 나이가 더 많은 달빛야수들은 숲의 더 깊은 동쪽에 살고 있습니다. 이 야생 생물들을 파괴해야 한다는 것이 가슴 아프지만 해야 할 일은 해야만 합니다.\n\n달빛야수 군락으로 돌아가서 더 깊은 곳을 수색해 주십시오. 아우버다인이 안전하게 유지되고 균형이 회복되도록 이 위협을 완전히 제거해야 합니다.",
  },
  [26202] = {
    ["T"] = "황혼의 망치단",
    ["O"] = "황혼의 망치단 암살단원 8명과 황혼의 망치단 신도 8명을 처치하고 아우버다인의 알란다리안 나이트송에게 돌아가십시오.",
    ["D"] =
    "아우버다인에 중대한 위협이 닥쳤습니다, $N. 그들은 스스로를 황혼의 망치단이라고 부릅니다. 혼돈과 불안을 퍼뜨리고 숲의 균형을 파괴하는 이교도 집단이죠. 그들은 고대 신들을 숭배하고 신들을 다시 깨우려 하며, 아제로스 전역에 파멸이 임박하기를 원하고 있습니다.\n\n그들을 막아야만 합니다! 그들은 아쉔발 국경 근처, 머나먼 남쪽의 지배자의 고대검에 전초기지를 두고 있습니다. 가세요, $N, 어둠해안에 드리운 이 이교도의 얼룩을 지워버리십시오.",
  },
  [26203] = {
    ["T"] = "아우버다인에 온 것을 환영합니다",
    ["O"] = "아우버다인에 있는 병참장교 나냐에게 보고하십시오.",
    ["D"] =
    "아우버다인에 오신 것을 환영합니다, 무탈하게 오셨기를 바랍니다. 이곳엔 해야 할 일이 아주 많으며, 당신의 도움을 받을 수 있다면 무척 감사하겠습니다. 달빛야수, 펄볼그, 멀록, 이교도, 나가... 말썽꾼 목록은 끝이 없으니까요!\n\n병참장교 나냐와 먼저 친분을 쌓는 것이 좋을 것 같습니다. 그녀는 마을회관에 상주하며, 여러 보고서를 읽고 현재 진행 중인 다양한 상황을 주시하고 있습니다. 당신을 다시 만나길 고대하며, 엘룬의 축복이 당신에게 임하기를.",
  },
  [26204] = {
    ["T"] = "잿빛안개 멀록의 위협",
    ["O"] = "빌 윌랜드를 위해 아우버다인 남쪽의 잿빛안개멀록을 처치하십시오.",
    ["D"] =
    "저는 원래 서부 몰락지대에 살았지만, 황금해안 채석장 근처 해안가에 멀록이 들끓기 시작하면서 그곳을 떠나야 했죠. 그 비늘 덮인 똥개 같은 놈들의 기억을 지워버리려고 이곳 어둠해안까지 오게 되었습니다. 하지만 소용이 없더군요, $C! 이 마을 바로 남쪽 해안가에도 멀록들이 사방에 깔려 있습니다!\n\n조금이라도 자비로운 마음이 있다면, 놈들이 우리를 압도할 만큼 큰 위협으로 자라나기 전에 놈들을 쓰러뜨려 주십시오. 내 악몽 속에 놈들의 울음소리가 울려 퍼진단 말입니다....",
  },
  [26205] = {
    ["T"] = "잿빛안개 멀록의 위협",
    ["O"] = "아우버다인의 빌 윌랜드를 위해 어둠해안의 남쪽 해안을 따라 있는 잿빛안개멀록을 처치하십시오.",
    ["D"] =
    "이 위협이 도사리는 한 난 잠을 이룰 수 없네, $C, 그래서 해안을 따라 남쪽으로 더 걸어가 보았지. 어둠해안의 아주 먼 남쪽 해안을 따라 훨씬 더 강한 멀록들이 있다는 걸 믿을 수 있겠나?\n\n놈들은 분명 어디선가 오고 있는 게 틀림없어. 자네가 놈들의 위협에 종지부를 찍는 동안 나는 조사를 좀 해야겠네.\n\n날 위해 이 일을 처리해 주겠지, 그렇지?",
  },
  [26206] = {
    ["T"] = "숄비어드",
    ["O"] = "숄비어드를 죽인 후 아우버다인의 빌 윌랜드에게 돌아가십시오.",
    ["D"] =
    "서부 몰락지대에는 멀록들의 우두머리가 있었을지도 몰라 -- 알아낼 수 있을 만큼 오래 머무르지 않았거든. 하지만 어둠해안의 멀록들에게는 확실하게 우두머리가 있어.\n\n해안을 따라 잿빛 골짜기에 거의 다다를 때까지 남쪽으로 계속 가다 보면, 어린 바다 거인을 목격하게 될 거야. 그놈이 바로 이 멀록들의 침략 배후에 있는 괴물이지! 그놈을 막지 않으면 놈의 끈적끈적한 군대에게 짓밟히고 말 거야!",
  },
  [26207] = {
    ["T"] = "수배: 미스트핀",
    ["O"] = "아메스아란의 폐허 동쪽 깊은 바다에서 미스트핀이라는 트레샤돈을 찾아서 처치하십시오. 아우버다인에 있는 파수꾼 글린다 날셰에게 현상금을 청구하십시오.",
    ["D"] =
    "주목!\n\n\"미스트핀\"이라는 트레샤돈의 목숨에 보상금이 걸려 있다. 이 생물은 인근의 낚싯배들을 공격하여 어부 최소 두 명을 죽게 했다.\n\n미스트핀은 아메스아란 폐허의 동쪽 깊은 물가 가장자리를 배회하는 것으로 알려져 있다. 이 현상금의 보상 청구는 아우버다인에 있는 파수꾼 글린다 날셰에게 해야 한다.\n\n아우버다인 마을 의회.",
  },
  [26208] = {
    ["T"] = "수배: 그리즐투스",
    ["O"] = "그리즐투스라고 알려진 곰을 찾아서 처치하십시오. 아우버다인의 파수꾼 글린다 날셰에게 보상금을 청구하십시오.",
    ["D"] =
    "주목!\n\n\"그리즐투스\"라고 알려진 곰의 죽음에 보상금이 걸렸다. 검은나무 펄볼그들이 잿빛 골짜기 곰을 잿빛 골짜기 국경 근처 남쪽의 검은나무 소굴로 유인했다. 우리는 이 어린 곰이 검은나무 부족의 통제를 받는 괴물로 자라나기 전에 처치해야만 한다.\n\n이 현상금의 보상 청구는 아우버다인에 있는 파수꾼 글린다 날셰에게 제시해야 한다.\n\n아우버다인 마을 의회.",
  },
  [26209] = {
    ["T"] = "와일드해머 뼈",
    ["O"] = "진타알로에서 와일드해머 뼈 10개를 되찾으십시오. 이 임무가 완료되면 맹금의 봉우리의 팔스타드 와일드해머에게 돌아가십시오.",
    ["D"] =
    "진타알로의 썩은가지 트롤들은 우리 무덤에서 훔쳐낸 드워프 뼈를 사용해 오랫동안 불경한 의식을 거행해 왔소. 그들은 타락한 여사제 헥스의 요청에 따라 뼈를 훔치지.\n\n진타알로로 가서 숭고한 우리 조상들의 뼈를 되찾아 오시오. 뼈는 도시 안 트롤들의 힘의 원천인 곳에 있을 것이오.",
  },
  [26210] = {
    ["T"] = "채용 공고: 맹금의 봉우리 경비대장",
    ["O"] =
    "진타알로로 가서 썩은가지부족 전사 20명, 썩은가지부족 흑마술사 20명, 썩은가지부족 암살자 20명, 아만자시 경비병 20명을 처치하십시오. 이 임무를 완수하면, 동부 내륙지의 맹금의 봉우리에 있는 칼라 해머플라이트에게 말하십시오.",
    ["D"] =
    "와일드해머 부족은 트롤 도시 진타알로로 병력을 이끄는 데 관심이 있는 강력한 전사를 모집하고 있습니다. 관심 있는 지원자는 다음의 과업을 완료해야 합니다:\n\n썩은가지부족 전사 섬멸\n\n썩은가지부족 흑마술사 섬멸\n\n썩은가지부족 암살자 섬멸\n\n썩은가지부족 아만자시 경비병 섬멸",
  },
  [26211] = {
    ["T"] = "전술적 타격",
    ["O"] = "진타알로에 침투하여 타락한 여사제 헥스와 수호자 히타야를 처치하십시오.",
    ["D"] =
    "와일드해머 부족은 동부 내륙지에 오랫동안 살아왔고 썩은가지 트롤들과도 오랫동안 싸워왔소. 트롤들은 이곳 남동쪽에 진타알로라는 거대한 도시를 건설했지. 우리가 그 요새에서 놈들을 쓸어버리는 것은 무리겠지만, 놈들이 다시는 우리를 공격할 엄두를 내지 못하도록 타격을 입힐 수는 있소.\n\n진타알로에 잠입하여 그들의 지도자인 타락한 여사제 헥스와 수호자 히타야를 처치하시오! 놈들은 필시 도시의 맨 꼭대기에 있을 거요.",
  },
  [26212] = {
    ["T"] = "부두교의 비밀",
    ["O"] = "진타알로의 트롤들에게서 부두교 융제 8개를 모아 동부 내륙지의 맹금의 봉우리에 있는 칼라 해머플라이트에게 가져가십시오.",
    ["D"] =
    "마을의 많은 이들처럼 저도 썩은가지 트롤들과 싸우며 그들 무기의 질에 감탄한 적이 있습니다. 썩은가지 트롤들은 마법을 이용해 자신들의 나무와 강철을 강화한다고 믿고 있는데, 그 마법은 바로 무기를 주조하고 제작할 때 사용하는 특수한 융제의 형태입니다.\n\n진타알로로 가서 융제를 조금 가져와 주신다면 유용하게 쓸 수 있을 것입니다.",
  },
  [26213] = {
    ["T"] = "호윈의 은밀한 낚시터",
    ["O"] = "맹금의 봉우리에서 머나먼 동쪽, 광풍로 절벽을 따라 흐르는 폭포 꼭대기에 있는 그가 즐겨 찾던 낚시터에서 호윈이 아끼는 미끼를 되찾으십시오.",
    ["D"] =
    "$R님, 꽤 유능해 보이시네요. 부탁 하나 드려도 될까요?\n\n먼 동쪽의 광풍로 폭포 꼭대기에 있는 제가 제일 좋아하는 낚시터에서 낚시를 하고 있었는데, 배회하던 썩은가지 트롤 무리의 공격을 받았어요. 저는 낚시 도구를 모두 내팽개치고 목숨을 걸고 도망쳤죠.\n\n혹시 광풍로 폭포로 돌아가서 그 도구들을 좀 찾아주시겠어요? 전부 다 찾지 못하셔도 괜찮아요 -- 사실 제일 아끼는 미끼만 돌려받고 싶을 뿐이니까요.",
  },
  [26214] = {
    ["T"] = "호윈의 은밀한 낚시터",
    ["O"] = "광풍로 폭포의 밑바닥에서 호윈이 가장 아끼는 미끼를 회수하십시오.",
    ["D"] =
    "낚시용 의자 주변 지역을 샅샅이 수색했지만, 호윈의 미끼나 다른 낚시 도구의 흔적은 전혀 보이지 않습니다. 다른 물건들도 폭포 아래로 휩쓸려 내려갔을 거란 의심이 듭니다. 운이 좋다면 폭포 밑바닥 진흙 속에서 찾을 수 있을지도 모릅니다.",
  },
  [26215] = {
    ["T"] = "호윈의 은밀한 낚시터",
    ["O"] = "성난 바다에서 호윈이 가장 좋아하는 미끼를 회수하십시오.",
    ["D"] =
    "폭포에서 동쪽 성난 바다로 강한 해류가 흐르고 있습니다.\n\n호윈의 태클 박스에서 빠져나온 물건들이 이 해류에 휩쓸렸다면, 동쪽 바다의 대륙붕으로 떠내려갔을 수도 있습니다.\n\n호윈에게 돌아가 미끼를 잃어버렸다고 말하기 전에 한번 찾아볼 만한 가치는 있습니다.",
  },
  [26216] = {
    ["T"] = "호윈의 은밀한 낚시터",
    ["O"] = "맹금의 봉우리로 호윈이 아끼는 미끼를 가지고 돌아가십시오.",
    ["D"] = "사소한 기적이네요! 이곳의 유목 조각에 낚시 미끼가 걸려 있습니다. 조심스럽게 미끼를 풀면서, 이것이 호윈이 찾고 있던 바로 그 미끼이길 바래봅니다.",
  },
  [26217] = {
    ["T"] = "호수에서의 실종",
    ["O"] = "로데론 호수 바닥에서 얀스가의 가보를 되찾으십시오.",
    ["D"] =
    "아서스가 로데론에서 배신을 저지른 후 도시에 대규모 공황이 발생했습니다. 제 가족과 저도 로데론 호수를 가로질러 배를 타고 도망친 많은 사람 중 하나였죠.\n\n저는 다른 가족들보다 운이 없었습니다 -- 공동묘지 동쪽 부두에서 얼마 떨어지지 않은 곳에서 뒤집히는 낡은 배 두 척에 올라탔거든요. 제가 인간으로서의 삶에서 기억하는 마지막 것은 물보다 더 차가운 손이 저를 해안으로 끌어당기는 것이었습니다....\n\n아무튼, 제 가보들은 호수 바닥에 가라앉았고 오늘날까지 그곳에 남아 있습니다. 그 물건들을 회수해 주신다면 기꺼이 보수를 지불하겠습니다.",
  },
  [26218] = {
    ["T"] = "케스트렐호의 잔해",
    ["O"] = "공동묘지 북쪽의 북부 밀물 동굴에 있는 케스트렐호의 잔해에서 스모키우드 목장조합 운송 상자를 수색하십시오.",
    ["D"] =
    "몇 달 전 스모키우드 목장조합에 수공예 재료를 대량으로 주문한 적이 있습니다. 보급품은 칼림도어에서 케스트렐이라는 배를 타고 배송되고 있었죠. 불행히도 그 배는 공동묘지 북쪽 해안을 따라 짙은 안개 속에서 좌초되고 말았습니다.\n\n배가 갇혀 있는 북부 밀물 동굴 근처 숲에는 적대적인 늑대인간들이 서식하고 있어 아직 잔해를 확인하러 가지 못했습니다. 당신이 저를 위해 케스트렐호의 화물칸에서 운송 상자를 회수해 주신다면, 그 안에 든 물자 중 일부를 기꺼이 나누어 드리겠습니다.",
  },
  [26219] = {
    ["T"] = "정당한 보상",
    ["O"] = "아이언포지의 델리아나에게 야생의 정수 장갑을 가져가십시오.",
    ["D"] =
    "먹스가 만든 장치를 가져오겠다는 약속을 지켰군요. 당신이 내 목숨을 구하는 일에 계속 흥미를 느끼도록 하려면 보상이 필요할 것 같소. 당신이 업그레이드하고 싶은 허리띠와 장갑 세트를 가져오시오. 내가 돌려줄 물건이 훨씬 더 뛰어날 것이라고 약속하오.",
  },
  [26220] = {
    ["T"] = "정당한 보상",
    ["O"] = "오그리마에 있는 모크바르에게 야생의 정수 장갑 세트를 가져가십시오.",
    ["D"] =
    "자네는 아주 믿을 만한 사람임을 증명했네, $N. 자네가 이 곤경을 헤쳐나가도록 도와줄 것이라 믿는 만큼, 자네의 성과에 맞게 보상하는 것이 현명한 처사겠지.\n\n당분간은 자네의 허리띠와 장갑을 교환해 주겠네. 우리가 이 일을 끝까지 해낸다면 나머지 부위도 자네가 이용할 수 있도록 해주겠네.",
  },
  [26221] = {
    ["T"] = "안시온의 작별 인사",
    ["O"] = "아이언포지에 있는 델리아나에게 야생의 정수 어깨갑옷 세트를 가져가십시오.",
    ["D"] =
    "발타라크의 영혼은 이 부적에 봉인되어 있었소. 우리는 우리를 기다리는 저주를 모른 채 탐욕에 눈이 멀어 어리석게도 그것을 세 조각으로 나누었지.\n\n발타라크의 마법을 멈출 유일한 방법은 메달을 다시 하나로 합치는 것이오. 델리아나에게 돌아가서 남은 조각을 찾을 유일한 희망은 보들리뿐이라고 전하시오. 당신이 약속받은 보상에 대해 그녀와 상의하시오.\n\n나는 이제야 비로소 평화롭게 쉴 수 있게 되었소. 행운을 비오. 행운이 아주 많이 필요할 테니까!",
  },
  [26222] = {
    ["T"] = "안시온의 작별 인사",
    ["O"] = "오그리마에 있는 모크바르에게 야생의 정수 어깨갑옷을 가져가십시오.",
    ["D"] =
    "발타라크의 영혼은 이 부적에 봉인되어 있었소. 우리는 우리를 기다리는 저주를 모른 채 탐욕에 눈이 멀어 어리석게도 그것을 세 조각으로 나누었지.\n\n발타라크의 마법을 멈출 유일한 방법은 부적을 다시 하나로 합치는 것이오. 모크바르에게 돌아가서 남은 조각을 찾을 유일한 희망은 보들리뿐이라고 전하시오. 당신이 약속받은 보상에 대해 그와 상의하시오.\n\n나는 이제야 비로소 평화롭게 쉴 수 있게 되었소. 행운을 비오. 행운이 아주 많이 필요할 테니까!",
  },
  [26223] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "델리아나에게 야생의 정수 조끼를 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군요, $N! 당신에게 감사드리며, 관련된 모든 이들의 진심 어린 감사를 전합니다. 이제 저도 두 눈을 감고 편히 잠들 수 있겠네요.\n\n보상으로 당신이 정말 좋아할 만한 몇 가지 물건을 준비했습니다.",
  },
  [26224] = {
    ["T"] = "가장 좋은 건 마지막에",
    ["O"] = "모크바르에게 야생의 정수 조끼를 주십시오.",
    ["D"] =
    "정말 놀라운 이야기군, $N! 자네에게 감사하며, 관련된 모든 이들의 진심 어린 감사를 전하네. 자네의 노력 덕분에 우리는 과거의 실수에서 벗어날 수 있게 되었어.\n\n보상에 대해서는 자네가 분명히 얻을 자격이 있고 진정으로 즐길 수 있는 몇 가지를 준비했네.",
  },
  [26225] = {
    ["T"] = "안시온의 작별 인사",
    ["O"] = "아이언포지의 델리아나에게 야생의 정수 킬트를 가져가십시오.",
    ["D"] =
    "발타라크의 영혼은 이 부적에 봉인되어 있었소. 우리는 우리를 기다리는 저주를 모른 채 탐욕에 눈이 멀어 어리석게도 그것을 세 조각으로 나누었지.\n\n발타라크의 마법을 멈출 유일한 방법은 메달을 다시 하나로 합치는 것이오. 델리아나에게 돌아가서 남은 조각을 찾을 유일한 희망은 보들리뿐이라고 전하시오. 당신이 약속받은 보상에 대해 그녀와 상의하시오.\n\n나는 이제야 비로소 평화롭게 쉴 수 있게 되었소. 행운을 비오. 행운이 아주 많이 필요할 테니까!",
  },

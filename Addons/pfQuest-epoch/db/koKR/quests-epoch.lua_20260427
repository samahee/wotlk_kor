  [28401] = {
    ["T"] = "현자 레인토템의 의뢰",
    ["O"] = "모트 돈스트라이더가 당신의 마법부여 기술을 사용해 수호자의 팔보호구에 팔보호구 마법부여 - 최하급 체력을 주문한 뒤, 멀고어 붉은바위에 있는 현자 레인토템에게 배달해 달라고 합니다.",
    ["D"] =
    "의뢰 몇 개를 처리해야 하는데 도움이 좀 필요하네, 마법부여사. 이건 붉은바위에 있는 현자 레인토템을 위한 의뢰일세. 그가 수호자의 팔보호구를 남겨두고 체력을 마법부여해 달라고 부탁했어. 마법이 부여된 팔보호구를 그에게 전해주면 충분한 보상을 받을걸세.",
  },
  [28402] = {
    ["T"] = "마가타 그림토템의 의뢰",
    ["O"] =
    "모트 돈스트라이더가 당신의 마법부여 기술을 사용해 웅변가의 로브에 가슴 방어구 마법부여 - 최하급 마법 흡수를 주문한 뒤, 썬더 블러프 장로의 봉우리에 있는 마가타 그림토템에게 배달해 달라고 합니다.",
    ["D"] =
    "마법부여사님, 장로님을 기다리게 하고 싶지 않으니 절 좀 도와주십시오. 썬더 블러프의 마가타 그림토템이 최하급 마법 흡수 마법이 깃든 새 웅변가의 로브를 요청했습니다. 이 주문을 처리해 주실 수 있나요?",
  },
  [28403] = {
    ["T"] = "콘스턴스 브리스부아즈의 의뢰",
    ["O"] = "밴스 언더글룸이 마법부여 기술을 사용해 하급 마술봉 1개를 제작해 티리스팔 숲 브릴 서쪽 버려진 장원에 있는 콘스턴스 브리스부아즈에게 배달해 달라고 합니다.",
    ["D"] =
    "흠, 자네 마법부여사인 것 같군, 맞나? 버려진 장원의 브리스부아즈 일가가 자기들 밭에서 하급 스컬지들이 나타나고 있다고 보고했어. 하급 마술봉을 하나 만들어서 그들이 스스로 방어할 수 있도록 콘스턴스에게 가져다주게. 물론 이건 자네가 맡게 될 정식 의뢰일세.",

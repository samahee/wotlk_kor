  [26466] = {
    ["T"] = "정의의 시련",
    ["O"] = "부두교 깃털을 방벽에 있는 조나단 베레스포드에게 가져가십시오.",
    ["D"] =
    "이 비활성 스컬지석으로, 스컬지에 맞서 그들의 힘을 역이용할 무기를 제작할 수 있습니다. 하지만, 우리의 목적에 맞게 악의 힘을 그들 자신에게 돌리려면 강력한 마법이 필요합니다.\n\n마침 가라앉은 사원이라는 곳이 이 작업을 수행하는 데 필요한 바로 그 마법을 지니고 있습니다. 당신의 시련의 마지막 단계로, 그 사원으로 모험을 떠나 이 마법을 소유한 트롤들을 제거해야 합니다. 그들의 이름은 가셔, 후쿠, 로로, 미잔, 졸로, 그리고 줄로입니다.",
  },
  [26467] = {
    ["T"] = "회수하지 못한 자들",
    ["O"] = "톱니항 주변을 돌아다니며 그 성기사에 대한 정보를 수소문하십시오.",
    ["D"] =
    "당신에 대해 들어본 적이 있소, $N. 죽어서조차 당신은 은빛 성기사단을 위해 다시 한번 이름을 떨치고 있소. 우리가 산 자들에게 외면받을지는 몰라도, 우리의 목표 중 많은 부분은 스컬지로부터 살아남은 성기사들과 뜻을 같이하오.\n\n나의 오랜 친구가 편지를 보내왔소, 칼림도어의 얼라이언스 원정대에 대해 내가 아는 바를 물으면서. 그녀는 어느 인간 성기사가 공작 라이온하트에 대한 정보를 얻으려고 돈을 지불하고 있으며, 직접 조사하기 위해 톱니항으로 갈 것이라고 말했소. 유감스럽게도 난 지금은 도울 수 없지만, 만약 이 성기사가 고 라이온하트 공작을 추적하고 있다면, 우리가 할 수 있는 모든 도움을 주는 것이 우리의 의무라 믿소. 톱니항으로 가서 이 성기사를 찾아보시오.",
  },
  [26468] = {
    ["T"] = "회수하지 못한 자들",
    ["O"] = "아즈샤라에서 지평선 정찰대를 찾으십시오.",
    ["D"] =
    "음. 아니, 나한테는 최근 톱니항에 유명한 성기사가 도착했다는 기록이 없어, 너 말고는. 일주일 전에 도착했어야 할 여객선이 연착됐는데; 아마 그 성기사가 거기에 타고 있었을지도 모르지.\n\n그 배는 북쪽 바다를 가로질러, 메네실에서 아즈샤라 남쪽 해안을 거쳐 톱니항으로 내려오고 있었어. 아즈샤라 남쪽 해안은 거친 곳이야. 만약 그들에게 무슨 일이 생겼다면, 거기에 닻을 내렸을 수도 있겠지. 내가 해줄 수 있는 말은 이게 다야.",
  },
  [26469] = {
    ["T"] = "회수하지 못한 자들",
    ["O"] = "오그리마의 그롬마쉬 요새에 있는 나즈그렐과 대화하십시오.",
    ["D"] =
    "공작 라이온하트는 잿빛 골짜기로 향했던 인간 원정대의 일원이었소. 그 당시, 얼라이언스와 호드는 스컬지와 불타는 군단에 맞서 싸우기 위해 힘을 합치고 있었소. 그러나 나이트 엘프들이 외부인들을 공격했고 원정대 소속의 많은 이들을 죽였소 -- 그 공작도 포함해서 말이오.\n\n나는 원래 그를 죽인 자 중 하나인 깃털달 장군을 찾아갈 계획이었소. 하지만 지금은 우리 둘 다에게 불가능한 일이 된 것 같군. 대안으로, 잿빛 골짜기에서 원정대와 함께 일했던 오크들이 몇 명 있소. 나즈그렐이 그중 하나였던 것으로 아오, 그는 하이잘 산 전투에도 참전했으니까. 그를 찾는 것이 얼마나 어려울지는 모르겠지만, 만약 그를 찾을 수 있다면, 라이온하트 공작에 대해 아는 것이 있는지 물어보시오.",
  },
  [26470] = {
    ["T"] = "회수하지 못한 자들",
    ["O"] = "아즈샤라에 있는 패트릭 밀스에게 공작 라이온하트의 망토를 가져가서 그가 망토로부터 무엇을 알아낼 수 있는지 보십시오.",
    ["D"] =
    "호드는 얼라이언스를 신뢰했고 잿빛 골짜기로 들어갈 때 인간들과 함께 섰소. 하지만 나는 이 공작 라이온하트에게서 배신의 징후가 보이지 않는지 감시했었지. 그가 죽자마자, 스컬지와 불타는 군단이 곧바로 기지의 남은 병력들을 덮쳤소.\n\n나는 스컬지가 손을 대기 전에 그 인간의 시신을 수습하려 했지만, 내가 그가 쓰러진 곳에 도착했을 땐 이미 사라진 뒤였소. 남은 것이라곤 그의 망토뿐이었소. 훗날 인간들이 신뢰할 수 있음을 증명하면 돌려줄 생각으로 내가 챙겨 두었지. 하지만 대신 이것을 당신에게 주겠소. 이것을 가지고 떠나시오.",
  },
  [26471] = {
    ["T"] = "회수하지 못한 자들",
    ["O"] =
    "서부 역병지대의 카엘 다로우 섬으로 여행하십시오. 성채 2층 주 방에 싸인 성서를 놓아 라이온하트 공작을 유인하고 그를 안식에 들게 하십시오.\n\n성공하면 언더시티의 로레인 할포드에게 돌아가십시오.",
    ["D"] =
    "공작 라이온하트가 언데드로 부활했다면, 그는 강력한 적이 될 겁니다. 그가 포세이큰 진영에서 발견되었다면 또 모르겠지만, 스컬지의 노예로서 그가 강요받았을 끔찍한 일들을 상상조차 하기 어렵군요. 저는 카엘 다로우로 가야 합니다.\n\n<패트릭이 자신의 성서를 집어 공작의 망토로 단정하게 싼 후, 당신에게 건넵니다.>\n\n부탁입니다, 저와 함께 이 퀘스트를 끝까지 완수하고자 한다면 동맹을 모아 카엘 다로우로 여행하십시오. 바로브 영주의 폐허가 된 전당 안에, 공작의 망토로 싼 제 성서를 놓아주십시오. 모든 것이 계획대로 된다면, 그는 자신의 망토와 제 성서에 이끌려 나타날 것입니다. 우리는 함께 그를 끝장낼 수 있습니다.",
  },
  [26472] = {
    ["T"] = "태양을 받들며",
    ["O"] = "멀고어에 있는 마르 소프투프와 대화하십시오.",
    ["D"] =
    "$N, 붉은구름 고원에서의 임무를 마치면 블러드후프 마을로 여행을 떠나야 합니다. 그곳에서 마르 소프투프를 만나게 될 것입니다. 그녀는 당신에게 영원한 태양, 안쉬와 대지모신에 대해 더 깊은 가르침을 전해줄 것입니다. 또한, 당신의 여정에 도움이 될 의복도 보상으로 받게 될 것입니다.",
  },
  [26473] = {
    ["T"] = "태양의 의복",
    ["O"] = "용사 모닝듀를 찾아 하급 치유 (2 레벨)를 사용하여 그의 상처를 치료하십시오. 그 후, 그에게 신의 권능: 인내를 부여한 다음 블러드후프 마을의 마르 소프투프에게 돌아가십시오.",
    ["D"] =
    "사제로서 우리의 의무는 동료의 상처를 치유하고 남은 하루를 견뎌낼 인내를 축복해 주는 것이네.\n\n용사 모닝듀를 찾아 자네의 치유 능력으로 그를 돕고, 그 후 인내의 축복을 내려주게나. 그는 북쪽, 다리 건너편에서 찾을 수 있을 거야.",
  },
  [26474] = {
    ["T"] = "거룩한 쪽지",
    ["O"] = "거룩한 쪽지를 읽고 붉은구름 고원에 있는 마그룸 미스트러너와 대화하십시오.",
    ["D"] = "방금 당신 앞으로 이 편지를 받았어요, $N. 아마도 우리 사제 전문가인 마그룸이 보낸 것 같군요. 사실이라면 내용을 읽어보시고 가능한 한 빨리 그를 만나보시는 게 좋을 거예요.",
  },
  [26475] = {
    ["T"] = "대규모 정화",
    ["O"] = "스트라솔름의 붉은십자군 초소로 들어가 진홍십자군 종교재판관을 처치하고 그들이 대규모 정화의 비밀을 알고 있는지 확인하십시오.",
    ["D"] =
    "구덩이에 시체가 쌓이는 날이 계속되고 있습니다. 죽은 자들도 질병의 매개체가 될 수 있지요, $C. 이들을 모두 구덩이에 던져 넣었다간 희망의 빛 예배당에 있는 다른 사람들까지 병들게 할까 두렵습니다.\n\n한 번의 강력한 주문으로 그들을 한꺼번에 정화할 방법이 있다면 좋을 텐데요.\n\n붉은십자군도 분명 이 문제에 부딪혔을 것입니다. 붉은십자군 초소의 사제 중 대규모 정화의 비밀을 간직한 자가 있지 않을까요?",
  },
  [26476] = {
    ["T"] = "그림자의 망토",
    ["O"] = "라벤홀트 장원에 있는 칼로 아우렐리우스에게 보고하십시오.",
    ["D"] =
    "이제 당신이 여정의 다음 단계로 나아가, 수많은 $C의 목숨을 구했던 기술을 배울 때가 왔습니다. 힐스브래드 구릉지에 있는 라벤홀트 장원으로부터 연락을 받았습니다.\n\n그 장원의 거주자들은 매우 비밀스러운 조직이기 때문에 이것은 꽤 이례적인 일입니다. 혹시 당신이 특정 어둠의 인물들에게 어떤 인상을 남긴 적이 있습니까? 열린 불꽃 위로 비춰야만 내용을 읽을 수 있는 이 편지를 확인하시고, 지시된 대로 이동하십시오.",
  },
  [26477] = {
    ["T"] = "그림자의 망토",
    ["O"] = "라벤홀트 장원의 칼로 아우렐리우스를 위해 비단 옷감 12개, 암흑석 4개, 어둠의 비단 4개를 모으십시오.",
    ["D"] =
    "약속한 대로 내가 오랜 세월에 걸쳐 개발한 귀중한 능력을 기꺼이 자네에게 가르쳐 주겠네. 이 능력은 독이나 저주 같은 해로운 효과를 자네에게서 제거해 주지. 자네의 앞으로의 여정에 대단히 유용할 걸세.\n\n하지만 이 능력을 가르쳐 주기에 앞서 자네에게 부탁 하나 하겠네. 내 은신 능력을 향상시켜 줄 최고 품질의 망토를 만들기 위해 희귀한 재료가 필요하거든. 자네의 솜씨와 인맥이라면 이 재료를 구하기에 충분하리라 믿고, 자네의 도움에 대한 대가로 이 능력을 전수할 생각이라네.\n\n내게 필요한 재료는 비단 옷감, 암흑석, 그리고 어둠의 비단일세. 이 재료들을 모두 구해서 내게 가져오면, 이 귀중한 능력을 가르쳐 주지. 자네의 시간과 노력이 헛되지 않을 거라 장담하네.",
  },
  [26478] = {
    ["T"] = "깊은 대지의 룬",
    ["O"] = "깊은 대지의 룬을 읽고 눈마루 골짜기의 울파른 볼드브레이드와 대화하십시오.",
    ["D"] = "네가 날 돕는 동안 이 룬을 너에게 전해달라더군. 시간 날 때 틈틈이 읽어봐라. 아마 주술사 전문가 울파른이 보낸 것 같아. 기회가 되면 앤빌마 안에 있는 그를 찾아가 보거라.",
  },
  [26479] = {
    ["T"] = "바람의 부름",
    ["O"] = "아라시 고원에서 텐린 트윈해머를 찾으십시오.",
    ["D"] =
    "칼림도어의 바람이 당신을 맞이하기 위해 불어오니, 당신은 우리의 가장 강력한 $G 형제:자매;들 중 하나로 꼽힐 것입니다. 당신이 여기까지 온 것을 매우 자랑스럽게 생각하며, 당신의 앞날이 무척 유망해 보입니다.\n\n바람의 정령을 제어하는 것은 무척 까다로운 일이지만, 당신의 기술이라면 눈앞에 놓인 어떤 장애물이라도 극복할 수 있으리라 믿습니다.\n\n임시 주둔지 서쪽에 있는 아라시 고원의 최북단으로 가서 텐린 와일드해머를 찾으십시오. 그녀가 당신을 가르칠 것입니다.",
  },
  [26480] = {
    ["T"] = "대지의 부름",
    ["O"] = "모조 그릇 2개를 앤빌마에 있는 울파른 볼드브레이드에게 가져오십시오.",
    ["D"] =
    "바로 지금일세, 젊은 $c. 자네는 강해졌고 자네의 영혼은 대지처럼 인내하고 있어. 주술사의 길을 걷는다는 것은 자네 스스로를 증명하기도 전에 이미 지혜를 지녔음을 보여주는 것이지.\n\n자네가 준비되었다면, 대지의 정령이 자네의 운명을 인도하고 자네의 일부가 될 걸세. 하지만 자네는 반드시 대지 그 자체 앞에 서야만 해. 준비가 끝난다면, 오직 주술사만이 알 수 있는 것들을 보게 될 걸세.\n\n남서쪽으로 가서 서리갈기 덩치들을 찾아 모조 그릇 두 개를 가져오게. 그리고 내게 돌아오면 자네의 미래에 대해 더 이야기해 보도록 하지.",
  },
  [26481] = {
    ["T"] = "대지의 부름",
    ["O"] = "숫양 바위를 찾아 대지의 영약을 마시십시오.",
    ["D"] =
    "영약은 우리의 영혼을 정령들과 결속하기 위해 만든 음료라네. 마법이 깃든 이 약은 열린 마음을 가진 자가 이전엔 누구도 보지 못했던 정령들을 볼 수 있게 해주지. 자네의 영혼은 이 영약을 만든 대상이 되는 정령과 영원히 결속될 것이며, 우리 일족 중 극소수만이 그 제조의 비밀을 알고 있다네.\n\n영약은 항상 신성한 장소에서 마셔야 하며, 다른 곳에서는 절대 안 된다네.\n\n이곳 서쪽에 있는 주술사 제단으로 가서 영약을 마시게나.",
  },
  [26482] = {
    ["T"] = "대지의 부름",
    ["O"] = "앤빌마에 있는 울파른 볼드브레이드에게 거친 석영을 가져오십시오.",
    ["D"] =
    "이 거친 석영을 가져가 우리가 만났다는 증거로 울파른 볼드브레이드에게 전해주시오. 그가 당신을 위해 토템을 만들 것이며, 이 작은 돌이 그 중심이 될 거요. 아주 작아 보일지 몰라도, 크기는 중요하지 않으며 아주 작은 것조차 산보다 더 오래 살아남을 수 있다는 것을 알게 될 거요.\n\n인내하시오, $N. 강인함을 유지하고 지혜를 구하시오. 이것이 대지가 당신에게 요구하는 바요. 마침내 당신은 대지와 하나가 될 것이오 -- 대지가 당신을 존중하듯 당신도 대지를 존중하시오.",
  },
  [26483] = {
    ["T"] = "불의 부름",
    ["O"] = "던 모로 남부 관문 전초기지에서 오르곤 스트롱브로우를 찾으십시오.",
    ["D"] =
    "불꽃이 자네와 함께하네, $n. 자네는 이미 대지의 길에 강한 것 같으니, 이제 오르곤과 대화할 준비가 된 것 같군.\n\n그는 현재 던 모로를 탐험 중이며, 마지막으로 목격된 곳은 남부 관문 전초기지라네. 그는 정령의 길에 매우 능통해서 불의 길을 자네에게 가르쳐 줄 수 있을 걸세... 자네가 준비되었다고 생각한다면 말이야.\n\n앰버스틸 목장 동쪽에 있으니 찾기 쉬울 거야. 하지만 조심하게, 너무 멀리 가서 황야의 땅까지 들어가지 않도록!",
  },
  [26484] = {
    ["T"] = "불의 부름",
    ["O"] = "휴면 중인 불꽃의 횃불을 모단 호수의 줄두그스 파이어테일에게 가져가십시오.",
    ["D"] =
    "불의 토템을 다룰 만큼 충분히 강력해졌지만, 그렇다고 완전히 준비된 것은 아니지.\n\n모단 호수의 텔사마 남쪽에서 호수에서 가장 높은 봉우리 중 하나로 이어지는 숨겨진 오솔길을 찾을 수 있을 거야. 주술사 돌들이 그 길을 표시하고 있지. 정상까지 길을 찾아 올라가면, 우리 신성한 성소 중 하나인 지상에 속박된 불꽃의 제단을 지키고 있는 줄두그스 파이어테일을 발견할 거네.\n\n이 횃불을 그에게 가져가게 -- 자네가 불을 다스리려 한다는 표식이 될 테니까. 불타오르는 제단에 불을 붙여 내게 돌아오면, 불의 토템을 건네받는 모습을 보게 될 것이야.",
  },
  [26485] = {
    ["T"] = "불의 부름",
    ["O"] = "모단 호수에 있는 줄두그스 파이어테일에게 불의 타르 1개와 시약 주머니 1개를 가져가십시오.",
    ["D"] =
    "역사 수업이나 들으려고 여기 온 건 아니겠지? 영원의 불꽃과 불의 토템을 가지러 온 게로군.\n\n첫 번째 단계는 영약을 만들어 자네와 불꽃을 결속시키는 거야.\n\n두 가지 재료만 가져온다면 자네를 위해 불의 영약을 만들어 줄 수 있지. 첫 번째는 불의 타르야. 주로 남쪽과 북서쪽에서 발견되는 가루바위일족 정찰병들이 지니고 다니는 흔한 물건이지.\n\n두 번째 물건은 조금 더 위험할 거야. 검은무쇠단 소속 중 한 명에게서 구해야 하는 시약 주머니지. 그놈들은 던 모로 남동쪽, 아이언밴드 야영지에 있어.",
  },
  [26486] = {
    ["T"] = "불의 부름",
    ["O"] = "하급 불의 현신을 물리치고, 빛나는 불씨를 지상에 속박된 불꽃의 제단 꼭대기에 있는 화로에 놓으십시오.",
    ["D"] =
    "불의 영약이 완성되었네. 이제 자네가 불꽃을 마주할 때야. 제단에서 영약을 마시고 산 정상으로 향해 그곳에 있는 현신을 대면하게. 그 녀석은 자네가 준비될 때까지 공격하진 않겠지만, 자네가 자신을 볼 수 있다는 것을 눈치챌 거야.\n\n신속하게 쓰러뜨리게나, $n. 녀석은 자네가 처치하는 시간이 길어질수록 더욱 강해질 테니까. 녀석이 패배하면 그의 빛나는 불씨를 화로 안에 넣고 횃불에 불을 붙이게.",
  },
  [26487] = {
    ["T"] = "불의 부름",
    ["O"] = "영원한 불꽃의 횃불을 던 모로 남부 관문 전초기지에 있는 오르곤 스트롱브로우에게 가져가십시오.",
    ["D"] =
    "횃불을 단단히 쥐고 화로에서 돌아서서 모단 호수를 내다봅니다. 바람이 거세지며 불꽃이 격렬하게 춤을 추자 영혼을 끌어당기는 듯한 흥분감이 느껴집니다.\n\n당신은 오르곤 스트롱브로우를 찾기 위해 남부 관문 전초기지로 돌아가는 길을 나섭니다.",
  },
  [26488] = {
    ["T"] = "물의 부름",
    ["O"] = "저습지에서 기르나 블레스드브루어를 찾으십시오.",
    ["D"] =
    "자네의 미래에 물이 있다는 건 부정할 수 없군. 이미 불의 길에 강해진 걸 보니, 이제 기르나와 이야기할 준비가 된 것 같아.\n\n기르나는 메네실 항구 남서쪽 저습지 해안을 따라 살고 있네. 놓칠 수 없을 거야 -- 머리 위를 날고 있는 장엄한 그리핀과 집, 그리고 부두를 찾아보게.\n\n그녀는 정령의 길에 아주 강하고, 만약 자네가 준비가 되었다고 생각한다면 물의 길을 가르쳐 줄 수 있지. 근처를 배회하는 멀록들을 조심하게. 그들은 물을 받아들이고 물이 자신들의 것이라고 주장하니까.",
  },
  [26489] = {
    ["T"] = "물의 부름",
    ["O"] = "비어 있는 갈색 물주머니를 기르나의 부두 아래 갈라진 틈에서 채운 뒤, 저습지에 있는 그녀에게 가져다주십시오.",
    ["D"] =
    "나에게서 깨달음을 얻고 영약을 구하려면 오직 가장 순수한 형태의 물만을 찾아야 하네. 내게 줄 샘물을 채울 때 주변을 잘 살펴보게. 물에 의존하고 물을 보호하는 피조물들을 주의 깊게 관찰하게나. 물이 숲과 사막에 어떤 영향을 미치는지 살펴보게. 생명을 유지시키는 바로 그 물질이 어째서 생물들로 하여금 생명을 빼앗게 만드는지 목격하게나.\n\n간단한 임무부터 시작하지: 여기서 북서쪽 바다 밑에 귀중한 천연 샘물이 바다로 새어나오는 틈이 있네. 이 주머니에 그 샘물을 채워서 내게 돌아오게.",
  },
  [26490] = {
    ["T"] = "물의 부름",
    ["O"] = "돌발톱 산맥의 바위웅덩이 호수에서 빈 빨간색 물주머니를 채우십시오.",
    ["D"] =
    "칼림도어의 돌발톱 산맥 깊숙한 곳에는 원주민들이 바위웅덩이라 부르는 오염된 호수가 있네. 투자개발회사가 이 지역에 엄청난 피해를 입혔지. 한때 내가 이 문제를 해결하려 했지만 헛수고였어.\n\n잿빛 골짜기의 남쪽 산맥을 따라 깊숙이 들어가 갈퀴자국 고개에 도달하게나. 거기서부터 돌발톱 산맥으로 들어설 수 있을 걸세. 바위웅덩이 호수 안의 갈라진 샘물 틈에서 표본을 가져다주면, 영약 완성에 한 걸음 더 다가서게 될 걸세.",
  },
  [26491] = {
    ["T"] = "물의 부름",
    ["O"] = "까마귀 언덕의 우물에서 빈 파란색 물주머니를 채워 저습지의 기르나에게 돌아가십시오.",
    ["D"] =
    "오래전 나는 동료들을 따라 그늘숲 깊은 곳으로 들어갔지. 우리는 그곳을 떠도는 끈질긴 좀비들로부터 스스로를 방어했고, 좀비들이 점령하지 못한 작은 정착지에 도달했네: 바로 까마귀 언덕이었지.\n\n그곳에서 아주 기이한 것을 발견했어: 정착지 중앙에 맑은 샘물이 솟아나는 작은 우물이 있었던 거야. 근처 마을 주민들이 그 우물의 가치를 알고 있는지는 확신할 수 없네 -- 그것은 불경스러운 바다 속 작고 성스러운 흔적이었어.\n\n이 물주머니에 그 물을 좀 담아다 주게.",
  },
  [26492] = {
    ["T"] = "물의 부름",
    ["O"] = "어둠해안에서 오염된 물의 현신을 쓰러뜨리고 현신의 손목보호구와 가장 순수한 물이 담긴 남은 물방울을 봄샘의 화로에 올리십시오.",
    ["D"] =
    "어둠해안의 해안가에서 떨어진 섬, 아우버다인에서 아득히 북동쪽으로 떨어진 곳에 지옥의 기운으로 오염된 제단이 하나 있소. 그곳의 영혼들은 더 이상 우리 사람들에게 말을 걸지 않으니, 현신을 쓰러뜨리고 웅덩이를 정화하는 일은 당신 몫이 될 거요.\n\n그 길을 따라 끝까지 북쪽으로 웅덩이를 향해 가시오. 정령과 싸우고, 녀석의 손목보호구와 기르나가 준 물약의 남은 방울들을 가져와 화로 위에 올려놓으시오. 이 의식이면 당신이 대화할 수 있는 순수한 영혼을 소환하기에 충분할 거요.\n\n임무를 마쳤다는 증거를 내게 가져오면, 보상으로 당신의 토템을 주겠소.",
  },
  [26493] = {
    ["T"] = "물의 부름",
    ["O"] = "어둠해안에 있는 하급 물의 현신과 대화하십시오.",
    ["D"] = "당신이 주문을 마치자 빛이 폭발합니다. 물방울이 불꽃에 부딪히는 소리가 잦아들고, 당신 주위의 오염된 영혼들이 파괴되면서 당신의 감각이 압도당합니다.",
  },
  [26494] = {
    ["T"] = "물의 부름",
    ["O"] = "물의 파편을 저습지의 기르나 블레스드브루어에게 가져가십시오.",
    ["D"] =
    "파편을 받으시오. 파편을 받고 생명을 내어주시오.\n\n생명을 내어주고 이해하시오. 물이 곧 생명이며... 오염은 생명을 멈춘다는 것을 이해하시오.\n\n당신은 물의 힘으로 생명을 보호하고 나누어 주시오.",
  },
  [26495] = {
    ["T"] = "공포마",
    ["O"] = "",
    ["D"] = "<런칭 당일의 스포일러를 방지하기 위해 전체 퀘스트가 비활성화되었습니다.>",
  },
  [26496] = {
    ["T"] = "의식의 지식",
    ["O"] = "검은바위 첨탑 하층으로 들어가 방패부대 흑마법사, 횃불부대 공포술사, 도끼부대 소환사에게서 인쿨라의 일지를 수집하십시오. 그 일지들을 불타는 평원에 있는 주나리에게 가져가십시오.",
    ["D"] =
    "검은바위 첨탑 하층으로 밀고 들어간 오크 부족들의 대열에는 여러 종류의 흑마법사가 있소. 방패부대는 다방면의 능력을 뽐내고, 횃불부대는 공포를, 도끼부대는 자신들의 악마들을 전담하지.\n\n그들의 공통점은 모든 흑마법사가 여군주 인쿨라에게 보고를 올렸다는 것이오. 적어도 내가 그녀를 만나기 전까진 그랬지.\n\n인쿨라는 영혼석 웅덩이를 만들어낼 수 있는 의식을 고안해 낸 똑똑한 오크였소. 자신의 권력에 도전하는 자를 막기 위해, 그녀는 그 지식을 세 부족에 나누어 주었소.\n\n이런 의식이 있다면 참 편리하겠지, 안 그렇소, $N? 당신이 첨탑에서 그녀의 일지를 되찾아 온다면, 내 도움을 받아 그녀의 기록을 해독해야 할 것이오.",
  },
  [26497] = {
    ["T"] = "오염된 양피지",
    ["O"] = "오염된 양피지를 읽고 시험의 골짜기 굴 안에 있는 나르톡과 대화하십시오.",
    ["D"] =
    "아, 자네가 없는 동안 자네 앞으로 양피지가 한 장 왔네, $N.\n\n나는 웬만하면 흑마법사들과는 상종하지 않으려 하지만, 시간이 날 때 한 번 읽어보는 게 좋을 것 같네. 내 짐작이 맞다면, 자네의 새 담당인 나르톡이 보낸 것일세. 자네가 준비되었을 때 그가 할 말이 있다는군.",
  },
  [26498] = {
    ["T"] = "앨리슨을 위한 꽃",
    ["O"] = "알터랙 산맥에서 서리엉겅퀴 8개를 수집하여 사우스쇼어 묘지에 있는 앨리슨 몽클레어의 무덤에 놓으십시오.",
    ["D"] =
    "반갑습니다, 이방인. 사우스쇼어로 지나가는 길인가요? 그렇다면 제 부탁 하나만 들어주시겠습니까?\n\n전쟁이 일어나기 전, 저는 앨리슨 몽클레어라는 소녀를 사랑했습니다. 그러다 바다로 나갔고 스컬지가 들이닥쳤죠. 고향에 돌아왔을 때, 저는 앨리슨을 찾았습니다. 그녀는 사우스쇼어에 있는 묘지에 묻혀 있었습니다.\n\n그녀의 무덤을 다시 찾을 용기는 없지만 그녀를 추모하고 싶습니다. 알터랙 산맥에서 서리엉겅퀴를 구해 그녀의 무덤에 놓아주신다면, 평생 은혜를 잊지 않겠습니다.",
  },
  [26499] = {
    ["T"] = "마법 물자",
    ["O"] =
    "달라란 소환사와 대화하여 개방의 룬을 얻은 다음, 그것을 사용하여 달라란 주변에 있는 마법으로 봉인된 금고를 열고 그 안의 마법 물자를 수집하십시오. 마법 물자 30개를 알터랙 산맥의 달라란 근처에 있는 대마법사 앤자이럼 룬위버에게 가져가십시오.",
    ["D"] =
    "도와주고 싶다고? 잘 찾아왔네!\n\n보다시피 달라란 주위로 우리가 세운 마법의 돔 밖에는 폐허가 된 구조물들이 있네. 그 폐허 안에서 자네는 마법으로 봉인된 용기들을 찾을 수 있을 거야. 그 용기들의 비전 자물쇠는 개방의 룬으로 열 수 있지.\n\n이 근처에 있는 달라란 소환사들과 대화하여 개방의 룬을 빌려보게나. 그런 다음 상자를 수색해서 그 안에 있는 마법 물자를 수집해주게. 조심해 - 일부 상자에는 수호자를 소환하는 주문이 걸려 있을 수도 있으니까.",
  },
  [26500] = {
    ["T"] = "기묘한 고서",
    ["O"] = "스톰윈드 시의 스톰윈드 항구에 있는 웬델 스파크브라이트에게 강령술 고서를 가져가십시오.",
    ["D"] =
    "당신이 모은 비품 더미 속에서 신경 쓰이는 물건을 발견했습니다. 이것은 강령술 고서로, 우리 도시와 로데론을 몰락시킨 금지된 마법입니다. 어느 집에서 이 책을 가져왔는지 기억하지 못하시겠죠...?\n\n다행히도 이 고서에는 독자의 수호물이 새겨져 있습니다. 수호물이나 마법 방어막에 대해 듣는 것도 지겨우시겠지만, 마지막 설명 하나만 참고 들어주십시오. 이 수호물은 의도된 독자를 제외한 모두에게 책 속의 글자를 뒤섞어 버립니다. 우리는 누가 이 수호물을 적용했는지 알아낼 수 있고, 이를 통해 이 고서의 주인이 누구였는지 알 수 있습니다.\n\n스톰윈드에 있는 웬델 스파크브라이트에게 이 고서를 가져가십시오. 그는 스톰윈드 항구의 최남단 부두 근처에 자주 머뭅니다.",
  },
  [26501] = {
    ["T"] = "기묘한 고서",
    ["O"] = "알터랙 산맥의 달라란 근처에 있는 대마법사 앤자이럼 룬위버에게 강령술 고서를 돌려주십시오.",
    ["D"] =
    "쾅 쾅 쾅! 참 쉽죠! 제가 멀록의 겨드랑이에서나 겨우 찾을 법한 희귀한 마법 시약이라도 필요할 줄 알았나요? 아니죠! 이건 아주 간단한 주문이에요. 정말이요! 이 고서는 그렇게 단단하게 봉인된 것도 아니었어요.\n\n어쨌거나, 이 고서의 주인은 아르만 넨스톡이라는 자군요! 전 그가 누군지 전혀 모릅니다. 대마법사라면 알 수도 있겠죠. 이 책을 그에게 다시 가져다주고 제 안부도 전해주세요.",
  },
  [26502] = {
    ["T"] = "희귀한 고서들",
    ["O"] = "알터랙 폐허에 있는 타르그와 글롬무스를 처치하고 그들이 소지하고 있을지도 모르는 책들을 회수하십시오. 그런 다음 사우스쇼어의 현자 딥스에게 돌아가십시오.",
    ["D"] =
    "알터랙 왕국은 학문적 연구로 유명하지는 않았지만, 알터랙 시티의 도서관에는 몇 권의 희귀한 고서들이 있었지. 오우거들이 그 폐허가 된 도시를 점령한 지금, 그 고서들을 회수할 수 있지 않을까 싶네...\n\n오우거들은 글을 읽을 줄 모른다 해도 자신들이 보기에 가치 있다고 생각되는 책을 수집하는 걸 좋아해. 오우거 우두머리들은 금박을 입힌 고서들 - 특히 예쁜 그림이 그려진 것들 - 을 수집했을 거네. 그들을 처치하면 잃어버린 보물 몇 권쯤은 되찾을 수 있을지도 모르지.",
  },
  [26503] = {
    ["T"] = "희귀한 고서들",
    ["O"] = "알터랙 폐허에 있는 무그톨을 처치하고 그에게서 \"알터랙의 여명기\"를 획득한 후 사우스쇼어에 있는 현자 딥스에게 돌아가십시오.",
    ["D"] =
    "자네가 꼭 찾아주길 바라는 고서가 하나 있는데, 그것이 아직 폐허에 있을 거라고 확신하네. 이 책은 \"알터랙의 여명기\"라고 불리며 알터랙 부족이 왕국을 세우고 얼라이언스에 합류하기 전의 역사를 담은 유일하게 알려진 책이야. 황금 실로 표지가 묶여 있었으니 분명 오우거들이 보물처럼 소중히 여겼을 테지.\n\n어쩌면 그들의 우두머리인 무그톨이라는 야만적인 녀석이 그 책을 가지고 있을지도 모르지? 녀석이 책을 넘겨주도록 설득해 볼 수 있겠나?",
  },
  [26504] = {
    ["T"] = "비밀결사대 문서",
    ["O"] = "소페라 절벽과 코란의 비수에 있는 비밀결사대 야영지를 수색하여 그들의 계획을 폭로할 만한 문서를 찾으십시오.",
    ["D"] =
    "이전 사우스쇼어의 행정관이 비밀결사대에게 암살당한 것은 그들의 영향력이 침투할 수 있도록 힐스브래드를 불안정하게 만들려는 대담한 조치였습니다. 사우스쇼어의 다른 주민들은 물론이고 제 자신의 안전을 위해서라도 우리는 그들의 계획에 대해 더 알아야만 합니다.\n\n어차피 밖으로 나가 비밀결사대 조직원들을 처치하실 거라면, 그들이 무엇을 계획하고 있는지 암시를 줄 만한 문서가 있는지 야영지도 함께 수색해 주십시오!",
  },
  [26505] = {
    ["T"] = "라벤홀트에게 보내는 편지",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 집정관 헨리 말레브의 편지를 가져가십시오.",
    ["D"] =
    "우리는 비밀결사대의 고위 지도자 다수를 제거했다는 것을 알고 있지만, 과연 누가 이 조직을 운영하고 있는지는 여전히 의문입니다. 비밀결사대의 우두머리를 제거하기 전까지 사우스쇼어는 결코 안전하지 않을 것입니다.\n\n이제 지원을 요청할 때입니다. 던홀드 요새 북쪽 산기슭에 있는 조라크 라벤홀트 경의 장원으로 이 편지를 가져가십시오. 그 역시 알터랙 왕국의 귀족이었으므로, 우리 못지않게 이 깡패들을 소탕하는 데 큰 관심을 보일 것입니다.",
  },
  [26506] = {
    ["T"] = "스트란브래드 급사",
    ["O"] = "던홀드 요새와 스트란브래드 사이를 이동하는 비밀결사대 전령을 찾아 요격하십시오.",
    ["D"] =
    "<라벤홀트 경이 한숨을 쉽니다.>\n\n그래서 비밀결사대가 힐스브래드까지 손을 뻗쳤단 말이군. 놈들이 더 깊이 마수를 뻗기 전에 비밀결사대의 기원에 대한 나만의 조사를 마무리 짓고 싶었지만, 내 쪽의 자원도 여유롭지 못한 상황이네. 자네가 이 일을 도와준다면, 나에게도 사우스쇼어에 있는 자네 주인에게도 도움이 될 거야.\n\n현장에서 받은 마지막 보고에 따르면, 던홀드 요새에서 스트란브래드까지 정기적으로 이동하는 전령이 한 명 있다고 하네. 이 전령은 도로가 아니라 강줄기를 따라 이동하지.\n\n그 전령을 가로막고 그가 지닌 메시지를 내게 가져오게.",
  },
  [26507] = {
    ["T"] = "고지대에서의 의심스러운 활동",
    ["O"] = "고지대와 단드레드 장원 근처 언덕에 있는 정보 수집 장소를 찾으십시오.",
    ["D"] =
    "비밀결사대에 대해 예전부터 의심을 품고 있었고, 그래서 고지대에 있는 그들의 야영지를 조사하기 위해 요원을 한 명 보냈었소. 그 요원으로부터 아직 보고가 없는데, 아마도 영영 돌아오지 못할 것 같군.\n\n나는 요원에게 스트란브래드 북쪽, 산사태 오우거 소굴 동쪽, 그리고 슬로터 분지 북쪽 구릉지를 따라가면 발견할 수 있는 팻말 근처, 고지대 산기슭과 단드레드 장원 근처에 수집한 정보를 놓아두라고 지시했소. 혹시 그 팻말들을 찾아 수집된 정보가 있는지 회수해 주시겠소? 발견한 것을 가지고 신속히 돌아오시오. 나는 그 요원의 가족을 위한... 조치를 취해 놓겠소.",
  },
  [26508] = {
    ["T"] = "고지대에서의 의심스러운 활동",
    ["O"] = "라벤홀트 경의 이야기를 들으십시오.",
    ["D"] =
    "우리가 계속하기 전에, 비밀결사대에 대해 우리가 마주하고 있는 자가 누구이며 무엇이라고 의심하는지 자네에게 꼭 알려야 할 것 같네. 이것은 배신과 기만으로 점철된 기나긴 이야기지. 자, 부디 편히 앉아서 들어보게.",
  },
  [26509] = {
    ["T"] = "고지대에서의 의심스러운 활동",
    ["O"] = "고지대에서 비밀결사대 단원을 처치하고 앨리덴 페레놀드 경이 살아 있다는 증거를 찾으십시오.",
    ["D"] =
    "앨리덴 페레놀드가 진정 비밀결사대의 배후인지 확인해야 하네.\n\n자네는 스스로 유능함을 증명했으니 - 고지대로 가서 비밀결사대 조직원들을 처치하게. 그들의 지도자가 누구인지 증명할 어떤 증거라도 찾아보게나. 편지에 찍힌 밀랍 봉인, 왕실 문장이 새겨진 인장 반지, 문서에 서명된 서명 등 어떤 것이든 상관없어.\n\n무엇을 찾든 신속하게 이곳으로 가져오게.",
  },
  [26510] = {
    ["T"] = "앨리덴 페레놀드 경",
    ["O"] = "단드레드 장원에 있는 앨리덴 페레놀드 경을 찾아서 처치하십시오.",
    ["D"] =
    "<라벤홀트 경이 고개를 젓습니다.>\n\n한때 위대했던 페레놀드 가문이 이토록 몰락하다니. 그저 흔한 도둑질과 암살이나 일삼는 무리로 전락했구나!\n\n약간의 도둑질과 암살이 잘못됐다는 건 아닐세. 물론 올바른 이유로 행해져야겠지. 거기에는 기술과 요령이 필요해. 아, 말이 딴 데로 샜군.\n\n비밀결사대는 무너져야 해. 나는 알터랙의 왕좌를 차지하는 데 아무 관심이 없으므로 정치적 상황을 고려할 때 라벤홀트 가문이 그의 죽음에 직접 개입하지 않는 편이 더 나을 걸세. 그래서 자네에게 부탁하는 거네 - 앨리덴 페레놀드를 찾아서 그를 죽이게.",
  },
  [26511] = {
    ["T"] = "페레놀드의 유산",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 앨리덴 페레놀드의 죽음과, 하스 장군을 찾아달라는 엘리사의 요청을 보고하십시오.",
    ["D"] =
    "페레놀드 경의 저택에서 저를 풀어주셔서 감사합니다. 저는 걱정 마세요, 집으로 돌아가는 길은 제가 찾아갈 수 있으니까요.\n\n하지만 부탁 하나만 들어주시겠어요? 앨리덴은 항상 자신에게 무슨 일이 생기면 \"장군 하스\"라는 사람에게 알려야 한다고 제게 말하곤 했어요. 이 \"장군 하스\"가 누군지, 어디에 있는지는 전혀 모르지만, 그저 제 양심을 덜고 이 단순한 소망을 이뤄주고 싶을 뿐입니다. 이 분이 누구인지 찾아서 앨리덴이 죽었다고 전해 주실 수 있을까요?",
  },
  [26512] = {
    ["T"] = "페레놀드의 유산",
    ["O"] = "마을 역사학자인 쿤드릭 잔덴에게 하스라는 인물에 대한 정보가 있는지 물어 사우스쇼어에서 하스 장군을 수색하십시오.",
    ["D"] =
    "하스 장군은 알터랙 군대의 지도자였네. 그는 처음부터 에이든 왕이 호드와 엮이는 것을 반대했지. 그는 좋은 사람이었고, 무엇보다 훌륭한 군인이었네.\n\n그가 아직 살아 있다면, 아마도 현지 주민들 사이에 녹아들어 살아가는 방법을 찾았을 거로 생각하네. 사우스쇼어부터 확인해 보게 - 그곳의 마을 역사학자가 도움을 줄 수 있을지도 모르지.",
  },
  [26513] = {
    ["T"] = "페레놀드의 유산",
    ["O"] = "스톰윈드 시청에 있는 왕실조사원 바스릴로와 대화하여 하스 장군의 행방을 알고 있는지 물어보십시오.",
    ["D"] =
    "하스라는 이름은 제게 익숙하지 않지만, 이럴 때를 대비해 우리가 기록을 보관하고 있는 거죠! 잠시만 기다려주세요.\n\n<쿤드릭 잔덴이 두꺼운 원장을 훑어봅니다.>\n\n아 - 하스라는 사람이 있긴 했지만, 딸과 함께 여관에 딱 이틀만 묵었군요. 배를 타고 남쪽으로, 스톰윈드로 간 것 같습니다. 그곳에서 찾아보시는 게 좋을 것 같네요. 시청의 누군가는 분명 도움을 줄 수 있을 겁니다.",
  },
  [26514] = {
    ["T"] = "페레놀드의 유산",
    ["O"] = "스톰윈드의 정원 구역에 있는 황수정 독수리 주점에서 하스 장군을 찾으십시오.",
    ["D"] =
    "나는 이 도시에 있는 모든 장교와 경비병을 잘 알고 있어요 - 그들의 신원 조사를 전부 우리가 처리해야 하니까요. 스톰윈드 왕국에서 군무에 종사하는 자들 중 하스라는 이름은 없습니다.\n\n하지만 사촌에게 안내해 드릴 수는 있겠군요 - 엘리아스 하스는 정원 구역에서 선술집을 운영하고 있죠. 아마 황수정 독수리 주점이라고 불릴 겁니다. 어쩌면 그가 당신에게 더 자세히 안내해 줄지도 모르겠네요.",
  },
  [26515] = {
    ["T"] = "페레놀드의 유산",
    ["O"] = "하스 장군의 인장 반지를 서리바람 야영지 근처 묘지로 가져가 에이든 페레놀드와 함께 묻어 주십시오.",
    ["D"] =
    "그래서 앨리덴 페레놀드가 죽었고 그 사실을 내가 알기를 원했단 말이군? 어째서인지 궁금하군그래.\n\n당신이 찾는 사람이 바로 나요 $C.\n\n나는 페레놀드 가문과 좋지 않은 감정으로 헤어졌고, 그 앙금은 아직도 사라지지 않았소. 나는 그저 남은 인생을 평화롭게 살고 싶을 뿐이오. 트롤베인이 한때 말했듯, 배신은 결코 용서받을 수 없는 법이니까.\n\n당신은 다른 사람의 심부름을 기꺼이 도맡아 하는 것 같으니, 마지막으로 부탁 하나만 하겠소. 그 시절 내게 남은 유일한 유물인 이 인장 반지를 가져가, 알터랙 국경 너머 서리바람 야영지 묘지에 있는 에이든 왕의 무덤에 묻어 주시오. 그러고 나서, 우리 다시는 페레놀드에 대해 입에 올리지 맙시다.",
  },
  [26516] = {
    ["T"] = "어둠의 의회",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 아르거스의 주문서를 가져가십시오.",
    ["D"] =
    "이 아르거스재림회라는 집단은 내가 이전에 의심했던 것보다 훨씬 더 위험한 암흑의 세력과 동맹을 맺고 있는 비밀 조직일 가능성이 있다고 생각합니다. 이 주문서를 조라크 라벤홀트 경에게 가져가십시오. 그는 던홀드 요새 북쪽 기슭의 자신의 장원에 있습니다.\n\n어쩌면 그가 이 조직에 대해 들어본 적이 있을지도 모릅니다.",
  },
  [26517] = {
    ["T"] = "어둠의 의회",
    ["O"] = "나가즈를 처치하고 그에게서 아르거스재림회와 관련된 정보가 있는지 수색하십시오.",
    ["D"] =
    "비밀결사대에 대한 제 조사에 따르면, 아르거스재림회의 편지에서 언급된 나가즈라는 자가 앨리덴 페레놀드 경과 같은 장소에 있을 거라고 볼 만한 이유가 있습니다.\n\n단드레드 장원을 습격하고 나가즈를 처치하십시오. 아르거스재림회가 대체 누구의 지시를 받는지 알 수 있을 만한 문서가 있는지 나가즈의 몸과 그의 거처를 수색하십시오. 행운을 빕니다 $C.",
  },
  [26518] = {
    ["T"] = "마법에 걸린 양피지",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 마법에 걸린 양피지를 가져가십시오.",
    ["D"] = "이 양피지는 해독할 수 없도록 주문이 걸려 있습니다. 하지만 종이 맨 위에 있는 한 단어는 읽을 수 있습니다: 아르거스. 라벤홀트 경이 이것에 큰 관심을 보일 것입니다.",
  },
  [26519] = {
    ["T"] = "펠리시티의 해독",
    ["O"] = "펠리시티 페레놀드가 마법에 걸린 양피지를 해독할 때까지 기다리십시오.",
    ["D"] =
    "아래층에서 펠리시티 페레놀드를 찾으실 수 있습니다. 그녀는 옛 에이든 페레놀드 왕의 조카이자 이시덴 페레놀드의 누이입니다. 그녀는 거의 20년 동안 나의 피후견인이었고, 내가 가르칠 수 있는 모든 기술을 배웠고 그 이상도 배웠습니다.\n\n당신의 행동 덕분에 그녀는 마침내 장원을 떠날 수 있는 자유를 얻었습니다. 그녀의 사촌이 처리되었으니, 이제 그녀는 자신을 노리는 비밀결사대 암살자들의 두려움 없이 당당히 살아갈 수 있습니다.\n\n펠리시티는 특히 비전 마법에 능통한 전문가입니다. 이 문서를 그녀가 한 번 해독해 보도록 하십시오.",
  },
  [26520] = {
    ["T"] = "블러드스톤 장치",
    ["O"] = "알터랙 산맥의 달라란 근처에 있는 로다미어 포로수용소에 수감된 포세이큰 포로들에게서 4개의 블러드스톤 장치를 수집하십시오.",
    ["D"] =
    "이 아르거스재림회 조직은 혈마법, 특히 블러드스톤으로 수행할 수 있는 마법에 큰 관심을 보이고 있소. 비밀결사대가 포세이큰 소속의 일부를 매수하여 언더시티의 금고에서 블러드스톤 장치를 훔치게 한 뒤, 달라란으로 피신처를 찾게 한 모양이오. 이달 말 죄수들을 이송할 때 블러드스톤을 거래하기로 되어 있다고 하오.\n\n달라란 경비병들도 이 거래에 관여하고 있는 게 분명하오.\n\n눈에는 눈, 이에는 이! 당신이 포세이큰 도둑들을 소탕하고 블러드스톤 장치를 회수하는 동안, 달라란 경비병들이 눈감아 주도록 금화로 그들을 구워삶겠소.",
  },
  [26521] = {
    ["T"] = "아르거스재림회",
    ["O"] = "4명의 아르거스 어둠마법사를 처치한 다음 타렌 제분소의 크루스크에게 아르거스재림회에 대한 정보를 가져가십시오.",
    ["D"] =
    "앨리덴 페레놀드 경이 내게 말하길, 비밀결사대가 자신들의 대의를 위해 아주 강력한 동맹을 모았다고 했소. 아르거스재림회라는 들어본 적도 없는 어떤 조직이 어둠마법사들과 나가즈라는 오크를 파견해 그를 돕고 있다더군. 나가즈가 어디 있는지는 나도 모르지만 어둠마법사들은 스트란브래드와 고지대를 돌아다니고 있소. 그들을 몇 명 처치하고 이 정보를 크루스크에게 가져가시오.",
  },
  [26522] = {
    ["T"] = "아르거스재림회",
    ["O"] = "알터랙 산맥 단드레드 장원에 있는 나가즈를 처치하고, 힐스브래드 구릉지 타렌 제분소에 있는 크루스크에게 그의 머리를 가져가십시오.",
    ["D"] =
    "만약 비밀결사대가 불타는 군단과 동맹을 맺었다면, 이 상황은 내가 예상했던 것보다 훨씬 심각하오. 대족장님께서도 우리가 행동에 나서기를 원하실 거요.\n\n이 나가즈라는 자는 틀림없이 앨리덴 페레놀드 경과 가까운 곳에 있을 거요. 우리 정보에 따르면 페레놀드는 호수 위의 저택인 단드레드 장원에 있다고 하오. 그곳에서 나가즈를 찾아서 내게 녀석의 머리를 가져오시오.",
  },
  [26523] = {
    ["T"] = "마법에 걸린 양피지",
    ["O"] = "힐스브래드 구릉지 타렌 제분소에 있는 크루스크에게 마법에 걸린 양피지를 가져가십시오.",
    ["D"] = "나가즈의 몸에서, 내용을 알아볼 수 없도록 비전 룬이 얽혀 반짝이는 양피지 한 장을 발견합니다. 타렌 제분소의 크루스크가 이에 대해 알게 되면 매우 관심을 가질 것입니다.",
  },
  [26524] = {
    ["T"] = "라벤홀트 장원으로",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 마법에 걸린 양피지를 가져가십시오.",
    ["D"] =
    "이런! 이게 뭐지? 비전 마법이군! 나로선 이 물건에 아무것도 할 수 없소.\n\n나가즈가 이 양피지를 가지고 있었다면, 우리는 이것에 무엇이 쓰여 있는지 반드시 알아내야 하오. 여기서 멀지 않은 곳에 라벤홀트 장원이 있소. 비록 라벤홀트 경이 완전히 우리의 동맹이라고는 할 수 없지만, 그는 인간치고는 공정한 자로 알려져 있소. 그가 이 양피지의 암호를 해독할 수 있는지 알아보시오.\n\n라벤홀트 장원은 던홀드 요새 뒤편의 언덕에 있소.",
  },
  [26525] = {
    ["T"] = "펠리시티의 해독",
    ["O"] = "펠리시티 페레놀드가 마법에 걸린 양피지를 해독할 때까지 기다리십시오.",
    ["D"] =
    "옛 에이든 페레놀드 왕의 조카이자 이시덴 페레놀드의 여동생인 펠리시티 페레놀드를 소개하오. 그녀의 가문은 한때 알터랙 산맥을 통치했었고, 그녀는 이 땅을 타락시키고 찬탈하려는 모든 이들로부터 이 땅을 지키는 데 큰 관심을 가지고 있다오.\n\n그녀는 매우 재능 있는 마법사이기도 하지. 그녀가 양피지를 잠시 살펴보도록 주게나. 그러면 자네는 해답을 얻을 수 있을 거야.",
  },
  [26526] = {
    ["T"] = "블러드스톤 장치",
    ["O"] = "스트란브래드와 고지대에 있는 비밀결사대 단원들에게서 블러드스톤 목걸이 4개를 모으십시오.",
    ["D"] =
    "우리는 최근에 불타는 군단의 분파 집단인 아르거스재림회에 대해 알게 되었습니다. 그들은 불타는 칼날단이나 이글거리는 목걸이 같은 녀석들처럼 어둠의 의회에 보고를 합니다. 뭐, 그래도 이들의 이름이 훨씬 더 창의적이긴 하네요.\n\n혈마법은 블러드스톤을 집중제로 사용하는데, 이 양피지에 따르면 그들이 알터랙 산맥에 있는 비밀결사대 조직원들에게 블러드스톤 목걸이를 나누어 주고 있었다고 합니다. 고지대로 돌아가서 비밀결사대를 처치하고 그 목걸이를 네 개 구해오세요. 당신이 없는 동안 저는 그것들을 위한 의식을 준비하고 있겠습니다.",
  },
  [26527] = {
    ["T"] = "블러드스톤 장치",
    ["O"] = "라벤홀트 장원에서 블러드스톤 수정구 의식을 수행하는 펠리시티 페레놀드를 보호하십시오.",
    ["D"] =
    "블러드스톤은 주로 불타는 군단의 흑마법사나 어둠의 마법사들이 사용하는 더러운 광물입니다. 이 광물에는 마법의 오라가 남겨져 있는데, 충분히 강력한 블러드스톤이 있다면 이 오라를 통해 환영을 엿볼 수 있죠.\n\n아르거스재림회가 블러드스톤을 사용하고 있다고 가정한다면, 이 광물이 꽤 희귀하기 때문에 블러드스톤의 기운이 가장 강력한 곳을 엿볼 수 있을 거라 기대하고 있습니다.\n\n제가 이 의식을 수행할 수 있지만 온전한 집중이 필요합니다. 암흑 마법에 이끌린 불결한 피조물들이 황천에서 나타날 수 있습니다. 저를 지켜주시지 않으면 의식은 실패하고 말 겁니다!",
  },
  [26528] = {
    ["T"] = "모든 징후가 잊혀진 땅을 가리키다",
    ["O"] = "잊혀진 땅의 만노로크 소굴 근처에서 시야가 잘 확보된 곳에 있는 펠리시티 페레놀드를 만나십시오.",
    ["D"] =
    "$C, 잘 들으세요. 환영 속에서 저는 바다를 건너 칼림도어라 불리는 대륙으로 이끌렸습니다. 그곳 서쪽 해안에는 잊혀진 땅이라는 황량한 불모지가 있죠. 저는 한 무리의 흑마법사들이 소환의 차원문을 세우는 것을 보았습니다. 우리는 그곳에서 아르거스재림회에 대한 답을 찾을 수 있을 겁니다.\n\n저는 의식에서 회복되는 대로 칼림도어로 제 자신을 순간이동시킬 수 있습니다. 지금은 조금... 피곤하군요. 하지만 당신은 먼저 출발하십시오. 이 흑마법사들이 자리를 잡은 곳 근처에서 절 찾으시면 됩니다 - 시야가 잘 확보된 곳에 있을 테니까요!",
  },
  [26529] = {
    ["T"] = "잊혀진 땅의 아르거스재림회",
    ["O"] = "변이의 부적을 사용하여 잘라트리아를 제압하고, 잊혀진 땅의 펠리시티 페레놀드에게 돌아가십시오.",
    ["D"] =
    "제가 이 흑마법사들을 꽤 오랫동안 지켜봤는데, 이들은 아르거스재림회가 아니라 불타는 칼날단 소속입니다. 하지만 군단 내부에는 수많은 조직이 있으니, 이들 역시 잊혀진 땅에서 작전 중인 자신들의 자매 집단 위치를 알고 있을 가능성이 큽니다.\n\n크고 무시무시하게 생긴 악마가 지도자인 척 뽐내고 다니지만, 똑똑한 스파이는 겉모습 아래 숨겨진 진실을 보는 법입니다 (적어도 라벤홀트 경은 그렇게 말씀하셨죠). 악마가 거대한 칼을 쥐고 있긴 해도, 이 집단의 실질적인 배후 세력은 잘라트리아라는 이름의 흑마법사입니다. 저 아래, 무너진 사원 폐허에서 그녀를 찾을 수 있습니다.\n\n그녀에게 다가가는 길에는 잡것들이 좀 깔려 있으니 그들을 치우기 위해 당신의 힘이 필요합니다. 우리는 그녀가 산 채로 필요하니, 라벤홀트 경이 제게 주신 이 작은 부적을 사용하세요. 이 부적이 그녀를 다루기 쉽게 만들어 줄 겁니다. 당신이 일을 마치면 제가 직접 가서 그녀를 데려오겠습니다.\n\n<펠리시티가 가볍게 킥킥 웃습니다.>",
  },
  [26530] = {
    ["T"] = "잊혀진 땅의 아르거스재림회",
    ["O"] =
    "잊혀진 땅에 있는 펠리시티 페레놀드를 위해 언데드 약탈자에게서 얻은 골수 한 줌 4개, 공포의 식인독수리에게서 얻은 독수리 피 2병, 그리고 불타는 칼날단 소환사에게서 얻은 블러드스톤 가루 한 자루를 수집하십시오.",
    ["D"] =
    "잘라트리아에게서 진실을 알아내려면 특별한 진실의 약이 필요합니다. 장원을 떠나기 전에 약을 한 병 챙겨왔어야 했는데, 잊혀진 땅에서도 필요한 재료들을 구할 수 있을 겁니다.\n\n근처 계곡에 있는 해골들에게서 뼈의 골수 네 줌이 필요합니다 - 쉽게 얻을 수 있을 겁니다. 또 독수리 피도 두 병 필요하고요. 마지막으로 저기 아래 있는 소환사 중 한 명에게서 블러드스톤 가루 한 자루를 뺏어오세요.\n\n제가 블러드스톤은 아주 강력하고 나쁜 마법에 쓰인다고 했던 것 기억하시죠? - 걱정 마세요, 절 위해 쓰는 건 아니니까요. 뭐, 개인적으로 쓰려는 건 결코 아닙니다.",
  },
  [26531] = {
    ["T"] = "잊혀진 땅의 아르거스재림회",
    ["O"] = "잘라트리아를 심문하십시오.",
    ["D"] =
    "여기 있습니다. 변이 마법을 잠시 풀고 약을 투여할 테니, 날카로운 질문들은 당신이 던지세요. 준비됐나요?\n\n쭉 들이켜 잘라트리아! 비행선이 들어간다아아! 입 벌려! 안 그러면 평생 풀이나 뜯어 먹게 될 줄 알아!",
  },
  [26532] = {
    ["T"] = "잊혀진 땅의 아르거스재림회",
    ["O"] = "아르거스재림회의 동굴 은신처를 찾아내고 그 안의 적들을 뚫고 순간이동 마법진에 도달하십시오. 그런 다음 순간이동기를 이용해 스로진을 찾으십시오.",
    ["D"] =
    "이제 우리의 목표가 스로진으로 정해졌습니다. 그를 쓰러뜨리면 아르거스재림회는 스스로 붕괴할 겁니다. 아니면 군단 내의 다른 분파 집단들에게 산산조각 날 수도 있겠죠. 어느 쪽이든 당장의 문제는 해결됩니다.\n\n당신과 합류하기 전에 잘라트리아부터 처리해야 합니다. 아르거스재림회의 은신처를 돌파해서 이 순간이동 마법진을 찾아보세요. 제가 이 여자를 처리하고 나면, 당신이 마법진을 타고 간 곳이 어디든 찾아내 합류하겠습니다. 만약 이 일에 믿고 부를 만한 동료가 있다면, 지금이 바로 그들을 부를 때입니다. 제 부탁 하나만 들어주세요. 제가 도착할 때까지 스로진을 죽이면 안 됩니다!",
  },
  [26533] = {
    ["T"] = "아르거스재림회의 최후",
    ["O"] = "스로진을 처치하고 펠리시티 페레놀드를 찾아 탈출하십시오!",
    ["D"] =
    "여기 도착했습니다! 이제 큰 문제를 끝장낼 준비가 되었네요. 다들 진지하게 임할 시간입니다 - 이 주변을 정찰해 보았는데 스로진이 멀지 않은 낡은 폐허 속에 숨어 있습니다.\n\n하지만 아주 작고 사소한 문제가 하나 있습니다. 목표를 달성한 뒤에 신속한 탈출이 필요한데, 우리 둘 다 라벤홀트 장원으로 무사히 돌아가려면 제게 엄청난 양의 마력이 필요하다는 겁니다. 그러니 당신 혼자서 스로진을 처리해 주셔야겠어요. 일이 끝나면 저와 만나세요 - 저는 기지 반대편 근처에서 기다리고 있겠습니다.",
  },
  [26534] = {
    ["T"] = "아르거스재림회의 최후",
    ["O"] = "알터랙 산맥의 라벤홀트 장원에 있는 조라크 라벤홀트 경에게 임무 성공을 보고하십시오.",
    ["D"] = "준비되셨다면 이제 출발하겠습니다. 도착하고 나면 제가 완전히 지쳐버릴 테니, 당신이 라벤홀트 경에게 임무 성공을 보고해 주세요. 나중에 뵙죠. 엉덩이 꽉 붙잡으세요!",
  },
  [26535] = {
    ["T"] = "스트롬가드로 보내는 편지",
    ["O"] = "망치 주둔지에 있는 드럼 펠에게 스트롬가드에 있는 비밀결사대 요원들에 대해 경고하십시오.",
    ["D"] =
    "스로진이 쓴 이 편지의 수신인은 마레즈 코울이며, 목적지는 아라시 고원에 있는 스트롬가드입니다. 아르거스재림회가 아라시 고원의 비밀결사대와 손잡고 활동하고 있을 가능성이 있습니다. 망치 주둔지의 누군가 이 정보에 관심을 보일지도 모릅니다.",
  },
  [26536] = {
    ["T"] = "스트롬가드로 보내는 편지",
    ["O"] = "임시 주둔지에 있는 부대장 나이얼스에게 스트롬가드에 있는 비밀결사대 요원들에 대해 경고하십시오.",
    ["D"] =
    "스로진이 쓴 이 편지의 수신인은 마레즈 코울이며, 목적지는 아라시 고원에 있는 스트롬가드입니다. 아르거스재림회가 아라시 고원의 비밀결사대와 손잡고 활동하고 있을 가능성이 있습니다. 임시 주둔지의 누군가 이 정보에 관심을 보일지도 모릅니다.",

  [465] = {
    ["T"] = "구젝의 계략",
    ["O"] = "용아귀부족의 투석기를 파괴하십시오.",
    ["D"] =
    "당신이 용아귀부족과 싸우는 동안, 우리는 그들의 계획을 더 알아냈습니다.\n구젝이 투석기를 만들어 메네실을 공격할 계획입니다! 게다가 던 알가즈에서의 전투 때문에 증원군이 완전히 차단되었습니다!\n당신이 그 투석기들을 파괴해야 합니다. 투석기들은 용아귀부족 야영지에 있습니다.\n자, 이 부싯깃을 받으십시오. 투석기까지 돌파하여 부싯깃으로 불을 붙이십시오.\n그 일을 끝내면, 구젝을 찾아 처치하십시오. 우리는 이 용아귀 짐승의 목을 베어야 합니다.",
  },
  [474] = {
    ["T"] = "구젝 처치",
    ["O"] = "장군 구젝 처치\n구젝의 머리를 경비대장 스타우트피스트에게 가져가십시오.",
    ["D"] = "이제 투석기를 모두 불태웠으니, 장군 구젝을 찾아 처치하십시오.",

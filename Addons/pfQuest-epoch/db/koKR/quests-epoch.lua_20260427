  [27920] = {
    ["T"] = "피와 명예의 맹세",
    ["O"] = "오그리마 용맹의 투기장에서 최고사령관 조크를 찾으십시오.",
    ["D"] =
    "이제 오크의 명예에 대해 더 잘 알게 되었으니, 전투에서 당신을 이끌 그 원칙들을 사용할 수 있을 것입니다. 그것을 더욱 완전히 받아들이고 싶다면, 오그리마의 최고사령관 조크를 찾으십시오. 행운을 빕니다, $C.",
  },
  [27921] = {
    ["T"] = "아포니의 부탁",
    ["O"] = "썬더 블러프 장로의 봉우리에 있는 아포니 브라이트메인과 대화하십시오.",
    ["D"] =
    "$N, 아포니 브라이트메인으로부터 당신을 찾는 요청이 왔습니다.\n\n그녀는 썬더 블러프 장로 드루이드들을 대신하여 도움을 구하고 있습니다. 이 문제에 대해 더 이상 할 말은 없지만, 특히 나이트 엘프가 언급되었습니다.\n\n당신의 신중함이 매우 중요하다고 전하라고 하셨습니다. 썬더 블러프의 장로의 봉우리에서 그녀를 찾으십시오.",
  },
  [27922] = {
    ["T"] = "불길한 소문",
    ["O"] = "돌발톱 산맥의 땅거미 호수 주변 지역을 조사하십시오.",
    ["D"] =
    "내 부름에 응해 주어 고맙소, $N. 돌발톱에서 공격이 있었다는 소식이 도착했고, 최악의 사태가 우려되오. 당신의 능력을 강력히 추천받았소.\n\n우리 역사의 신성한 일부가 도난당했을지도 모릅니다. 내가 이리 말하지만, 그것은 나이트 엘프를 포함한 모든 드루이드들의 역사이기도 하오. 무샤, 즉 달의 축복을 받은 생명의 샘이 공격받았소. 호숫가 야영지인 아헵와 끝자락 동굴에 있소. 이 봉우리의 장로들은 그곳이 우리가 가장 신뢰하는 용사들에 의해 안전하게 지켜진다고 생각했소.\n\n<아포니는 말을 멈추고 밖의 그림토템들을 경계하며 오두막 입구를 노려봅니다.>\n\n난... 아니, 소문을 입에 올리지 않겠소. 돌발톱 산맥 중심부, 땅거미 호수 북동쪽 대지로 가 주시오. 무슨 일이, 왜 일어났는지 알아야 하오!",
  },
  [27923] = {
    ["T"] = "그림토템부족의 배신",
    ["O"] = "그림토템부족 약탈자 8명을 처치하고 사나 다크클라우드를 처치하십시오.",
    ["D"] =
    "<소문이 사실이었던 것 같습니다. 거류지가 그림토템 부족에 의해 전복되었습니다.>\n\n<이 변절자들은 그들의 범죄에 대한 대가를 치러야 합니다. 어쩌면 생존자들을 발견하고 그들이 왜 이 곳을 약탈했는지 그 이유를 알 수 있을지도 모릅니다.>",
  },
  [27924] = {
    ["T"] = "재생과 안식",
    ["O"] = "치유의 물 단지를 찾아 로라스린 파보우에게 가져가십시오.",
    ["D"] =
    "안 돼, 손을 치워! 난 무-무장하지 않았소, $R.\n\n<나이트 엘프는 두려워 보입니다. 끔찍한 머리 상처에서 피가 스며나와 동굴 바닥을 적십니다.>\n\n왜... 내가 여기.. ? 샘... 난... 제발...!\n\n<엘프는 기절할 지경입니다. 아포니는 이곳의 물이 치유 효과를 지녔고 근처에 단지가 있을지도 모른다고 언급했습니다. 엘프가 혼미하지 않다면 당신에게 더 많은 것을 말해줄 수 있을지도 모릅니다.>",
  },
  [27925] = {
    ["T"] = "아포니에게 돌아가기",
    ["O"] = "발견한 사실을 썬더 블러프 장로의 봉우리에 있는 아포니 브라이트메인에게 알리십시오.",
    ["D"] =
    "<나이트 엘프는 눈을 천천히 깜박이며 주위를 살핍니다. 그의 시선은 여기저기 돌아다니다가 항상 당신에게 멈춥니다.>\n\n우린... 타우렌과 이 샘을 연구하기 위해 이곳에 초대받았소. 처음엔 주저했지만... 우리가 세나리우스의 가르침을 공유하기에, 큰 호기심을 안고 왔소. 이런 화해의 제스처가 피로 물든 것을 보니 슬프지만 놀랍진 않군.\n\n내 말이 대단치 않겠지만, 호드를 겨냥한 음모는 없었소. 호드의 정치엔 개입하지 않을 것이며, 오직 북쪽으로 돌아가고 싶을 뿐이오.\n\n<그는 잠시 당신의 무기를 쳐다보다가 눈을 감습니다.>\n\n목숨을 구해줘서 고맙소. 평화롭게 헤어질 수 있겠소?",
  },
  [27926] = {
    ["T"] = "달의 은혜",
    ["O"] = "썬더 블러프의 용사 사이크와 대화하십시오.",
    ["D"] =
    "<엘프는 당신의 얼굴을 살피다가 부드럽게 헛기침을 합니다.>\n\n그 물. 당신은... 선물을 받았군요, $R...!\n\n<엘프는 불안함과 어리둥절함이 뒤섞인 표정으로 잠시 멈춥니다.>\n\n...당신이 그것을 받은 첫 번째 존재는 아니오. 또 다른 자가 이 샘에서 치유를 받고 그 기운에 휩싸였소, 어떤 타우렌이었지. 우린 그것이 여신의 축복이라는 것을 알게 되었고... 그녀의 뜻을 따르는 자로서 그 타우렌에게 우리의 가르침을 전수했소.\n\n숙달하기 어려운 길이라는 것을 명심하시오. 하지만 여신께서 당신을 향해 어떤 믿음을 가지고 있는 듯하오. 내가 더 해석할 일은 아니군.\n\n썬더 블러프의 용사 사이크를 찾으시오. 어쩌면 당신도 그 힘을 다루는 법을 배울지도 모르오.",
  },
  [27927] = {
    ["T"] = "피와 명예의 기억",
    ["O"] = "인간에 대해 더 알고자 하는 열의에 대해 아이트리그와 대화하십시오.",
    ["D"] =
    "당신이 우리의 주요 적인 인간에 대해 더 알고 싶어한다는 소문을 들었소. 우리 종족 사이의 긴장이 아직 높은 상황에서 이것은 현명한 선택으로 보이오 -- 적을 알고 나를 알라는 말도 있으니.\n\n많은 호드의 일원들이 여러 번의 전쟁에서 인간과 싸웠지만, 스랄과 아이트리그만큼 그들의 마음을 아는 자는 없소. 스랄은 요즘 매우 바쁘지만 아이트리그는 만날 수 있을지도 모르지. 오그리마의 스랄의 방에 있는 그를 찾으시오.",
  },
  [27928] = {
    ["T"] = "피와 명예의 기억",
    ["O"] =
    "불타는 평원으로 이동하여 로서의 명예를 기리기 위해 근처에 있는 검은바위부족 병사, 흑마술사, 학살자를 처치하십시오.",
    ["D"] =
    "나는 1차 및 2차 대전쟁에서 인간들과 싸웠소, $C. 그들은 만만치 않은 적이오. 나는 오그림 둠해머가 안두인 로서를 살해하는 것을, 그리고 얼라이언스가 지도자의 죽음 후 어떻게 다시 집결했는지를 지켜보았소. 놀랍도록 명예로운 모습이었소.\n\n얼라이언스는 불타는 평원에 로서의 조각상을 세웠지만, 아직도 군단에 충성하는 검은바위 오크들이 그 지역에 들끓고 있소. 로서의 용기에 대한 찬사이자 우리 자신의 방어를 위해 그들의 수를 줄여주시오.",
  },
  [27929] = {
    ["T"] = "피와 명예의 기억",
    ["O"] =
    "던홀드 요새로 여행하여 교수대를 찾으십시오. 도전의 뿔피리를 불어 아에델라스 블랙무어의 유령을 소환하여 처치하십시오.",
    ["D"] =
    "호드가 얼라이언스에게 패배한 후, 나는 사로잡힐 때까지 황야를 방황했소. 나는 단지 짧은 시간 동안만 인간들에게 억류되어 있었지만 스랄과 수많은 다른 이들은 던홀드 요새에서 수년 간 수감되었소.\n\n아에델라스 블랙무어가 관리하던 그 수용소에서 오크들에 대한 처우는 잔혹했소. 그것은 인간의 본성 중 최악의 측면을 대변했고 그들 스스로 자신들의 타락을 보지 못하는 눈먼 모습이었소. 스랄의 포획자는 그가 죽는 순간조차 자신의 잘못을 보지 못했소.\n\n블랙무어는 오래 전에 살해되었고 그의 시체는 요새 잔해 속에 묻혔소. 그 후 그 위에 새로운 수용소가 세워졌소. 이 도전의 뿔피리를 가져가 재건된 교수대 근처에서 부시오. 블랙무어의 유령이 나타날 것이고, 당신도 정의를 실현하는데 동참할 수 있을 것이오.",
  },
  [27930] = {
    ["T"] = "피와 명예의 기억",
    ["O"] = "오그리마 용맹의 투기장에서 최고사령관 조크를 찾으십시오.",
    ["D"] =
    "당신의 여행이 인간의 본성에 대한 빛과 어둠, 그 양면 모두를 어느 정도 조명해주었기를 바라오. 만약 당신이 그들에게 더욱 다가가길 원한다면 오그리마의 최고사령관 조크와 대화하시오.",
  },
  [27931] = {
    ["T"] = "파이어브루의 맥주",
    ["O"] = "아이언포지 대광장에 있는 썬더브루 선술집의 여관주인 파이어브루와 대화하십시오.",
    ["D"] =
    "$C, 아이언포지의 썬더브루 선술집에 있는 여관주인 파이어브루가 아주 특별한 맥주를 만들기 위해 당신의 도움을 구하고 있습니다!\n\n그가 말하기로는 보통의 드워프들처럼 당신 가슴에 털을 나게 하고 맷집을 더 키워줄 거라고 하더군요.\n\n이게 관심 있는 이야기라면, 썬더브루 선술집은 아이언포지 대광장에 있습니다.",
  },
  [27932] = {
    ["T"] = "최고급 시음",
    ["O"] = "그웨나 파이어브루, 트루크 와일드비어드, 감시대장 롤로 롱스트라이커와 대화하여 그들의 맥주를 시음하십시오.",
    ["D"] =
    "좋아, $C. 내가 조금 건방지게 들릴지 모르지만, 댁은 최고급 드워프 맥주 맛을 아직 잘 모르는 것 같군. 내 계획에 있는 맥주를 제대로 맛보고 싶다면 먼저 목구멍부터 조금 적셔 둬야 할 거야!\n\n우리 드워프들이 젖먹이 때부터 흑맥주를 먹고 자란다는 건 잘 알려진 사실이지! 다른 종족들이 아무리 내성을 길러봤자 우릴 따라올 순 없어. 내 맥주로 댁을 죽이고 싶진 않으니, 이걸 필수 과정이라고 생각하라고!\n\n자신들의 최고의 맥주 맛을 보여줄 수 있는 내 친구 목록이 있어. 먼저 여기 여관에 있는 내 어여쁜 그웨나에게 말을 걸어봐... 그녀가 내 맥주 한 잔을 제대로 줄 거야.\n\n다음엔 어디로 갈지 자유지만, 동부 내륙지의 맹금의 봉우리에 있는 트루크 와일드비어드와 이글거리는 협곡 토륨 거점에 있는 감시대장 롤로 롱스트라이커를 찾아봐. 이 두 녀석이 만드는 맥주는 정말 끝내주지, 내 장담하지!\n\n건배, $N!",
  },
  [27933] = {
    ["T"] = "지하 도시의 연금술",
    ["O"] =
    "서부 역병지대 농장 들판에서 30개의 역병걸린 잡초를 채집하십시오. 역병지대의 스컬지 가마솥에서 파이어브루의 약병을 채우십시오.",
    ["D"] =
    "자, 우리가 만들려는 이 맥주는 단순한 즐거움을 위한 게 아니야. 얼라이언스 동맹을 위한 실용적인 쓰임새가 있지. 난 애국자거든.\n\n우리 친구들이 독이나 질병 따위에 오염되지 않도록 하고 싶단 말이야... 게다가 양조 기술은 연금술과 다를 게 없어.\n\n우리끼리만 아는 비밀인데, 아제로스에서 가장 역겨운 재료들이 몇 개 필요해. 그걸 찾기에 역병지대보다 더 좋은 곳이 어디 있겠어? 그래 맞아. 제발 우리가 무슨 새로운 역병을 만들어내지 않기만을 바라야지!\n\n맛은 내가 책임질 테니 걱정 마! 당신은 그저 그곳 들판에서 자라는 식물들을 채집해 오기만 하면 돼. 아, 그리고 이 수정 약병을 가져가. 대지 곳곳에 무슨 솥단지가 널려 있다고 들었는데... 오, 그 안에 분명 더러운 것들이 가득 차 있겠지?!\n\n그 식물들을 구해 오고 그 가마솥에서 스컬지의 혼합물로 약병을 채워와. 그러면 우리만의 음료를 만들 수 있을 거야.",
  },
  [27934] = {
    ["T"] = "차가움 유지하기",
    ["O"] = "북부 여명의 설원에서 5개의 서리 수정을 채집하십시오.",
    ["D"] =
    "다른 대륙에 있는 여명의 설원에 가본 적 있나, $N? 거긴 카즈 모단과 비교할 수 없을 정도로 추워, 내 장담하지...\n\n북쪽으로 갈수록 더 추워지거든. 북부 여명의 설원 바위에서 서리 수정이 솟아나는데, 그 차가운 것이 우리 맥주에 들어가면 어떨지 궁금하지 않나, 엉?\n\n내 생각엔 말이지. 차가운 음료는 피를 늦춰주고, 가장 차가운 음료는 출혈을 완전히 멈추게 할 거야! 방문하는 것만으로도 당신의 냉기 저항력을 키울 수 있을걸.\n\n어때, $N? 그 수정들을 가져와서 맥주가 다 만들어지면 우리 탄산음료에 한 번 넣어보자고.",
  },
  [27935] = {
    ["T"] = "감정가의 미각",
    ["O"] = "썬더브루 선술집에 있는 여관주인 파이어브루 옆의 통에서 효과를 느낄 때까지 맥주를 마시십시오.",
    ["D"] =
    "정말 대단한 보물 사냥꾼이군, 그렇지 않아? 이리저리 돌아다니며 이것저것 모아오는 솜씨가... 예전에도 이런 일을 해본 솜씨야!\n\n이제 맥주 준비가 거의 끝났어. 이거 보여? 내 노움 친구가 준 '급속 발효 촉매제'야... 효과가 있는지 한 번 볼까.\n\n<여관주인 파이어브루가 거품이 일어나는 액체를 맥주통에 붓고 격렬하게 흔듭니다. 통에서 윙윙대고 꿀럭거리는 소리가 나더니 이내 잠잠해집니다.>\n\n자, 남은 건 한 번 시음해보는 것뿐이야! 건배, $C! 물론 당신을 위한 거지.",
  },
  [27936] = {
    ["T"] = "언제나 재고 있음",
    ["O"] = "아이언포지에 있는 기록관 던짐과 대화하십시오.",
    ["D"] =
    "벌써 우리의 여정이 끝났다니 믿기지가 않는군, $N... 당신과 일해서 정말 즐거웠어!\n\n난 이 맥주를 최대한 많이 만들기 시작할 거야. 하지만 언제든 필요한 만큼 당신에게도 공급해 줄게. 더 필요하면 기록관 던짐을 찾아가!\n\n말이 좀 늦었지만 축하해 $N -- 내 기준에선 당신도 명예 드워프야! 내 화롯가엔 언제든 환영이니 모르는 사람처럼 굴지 마.",
  },
  [27937] = {
    ["T"] = "안보의 슬픔",
    ["O"] = "슬픔의 늪 북동쪽 끝에 있는 외딴 연구소 근처에서 위글리 마글리저와 대화하십시오.",
    ["D"] =
    "유명한 고블린 과학자가 당신의 도움이 필요하다고 합니다, $C. 그녀는 슬픔의 늪에 있는 연구소에서 도둑들을 막아내려 고군분투 중인데, 몇 가지 새로운 방어 체계를 시험해 줄 사람을 찾고 있답니다.\n\n조금 과장되게 들리긴 하지만 참가하면 정신을 연마하고 어떤 상황에서도 탈출할 수 있는 능력을 얻게 될 거라고 하더군요 -- 마치 노움처럼 말이죠.\n\n진지한 모험가만 지원할 수 있다고 합니다. 관심 있으신가요?",
  },
  [27938] = {
    ["T"] = "시련의 장",
    ["O"] =
    "북쪽 절벽길에 있는 위글리 마글리저의 시련의 장을 통과한 후, 연구소 안에 있는 그녀와 대화하십시오.",
    ["D"] =
    "난 도둑들이 찾을 수 없게 이곳으로 이사 왔지. \"아무도 이 우울한 쓰레기통 같은곳엔 오지 않을거야!\"라고 생각했어. 정착한 지 몇 달 안 됐는데 그놈들이 메뚜기 떼처럼 몰려오고 있잖아!\n\n연구를 다 중단하고 먼저 방어할 방법을 고안해야 했어! 새로 만든 방어 체계를 시험해 보고 싶군.\n\n할 수 있겠어? 내가 꼼꼼히 지켜보며 기록할 테니까... 관찰당한다고 압박감에 무너지는 녀석이 아니길 바라.\n\n보수는 줄 테고, 새로운 것도 배울 수 있을 거야. 준비가 되면 북쪽 길로 올라가봐 -- 단, 서두르는 게 좋을걸! 시간 잴 거니까. 행운을 빌고, 죽는다고 해도 날 원망하러 돌아오진 마.",
  },
  [27939] = {
    ["T"] = "지능 측정",
    ["O"] = "언더시티 왕실에 있는 롤랜드 스티프스트라이크와 대화하십시오.",
    ["D"] =
    "끝났군! 정말 다정하고 큰 도움이 됐어. 너무 아프진 않았길 바라.\n\n언제든 돌아와서 다시 시도해 봐, $N. 다만 내 물건 훔칠 생각은 마, 알겠어?\n\n내 노트 요약본을 언더시티에 있는 동료 롤랜드 스티프스트라이크에게 보낼 거야. 당신도 언제든 검토할 수 있어... 정신을 연마하는 일에 도움이 될 거야.\n\n이제 여기서 나가. 난 일해야 해!",
  },
  [27940] = {
    ["T"] = "지능 측정",
    ["O"] = "스톰윈드 왕실 도서관에 있는 기록관 로이와 대화하십시오.",
    ["D"] =
    "끝났군! 정말 다정하고 큰 도움이 됐어. 너무 아프진 않았길 바라.\n\n언제든 돌아와서 다시 시도해 봐, $N. 다만 내 물건 훔칠 생각은 마, 알겠어?\n\n내 노트 요약본을 스톰윈드에 있는 동료 기록관 로이에게 보낼 거야. 당신도 언제든 검토할 수 있어... 정신을 연마하는 일에 도움이 될 거야.\n\n이제 여기서 나가. 난 일해야 해!",
  },
  [27941] = {
    ["T"] = "거미에서 만들어진 것",
    ["O"] = "타나리스의 안제와타 남서쪽 끝자락 해안에 있는 춘코와 대화하십시오.",
    ["D"] =
    "반갑습니다, $C. 춘코라는 트롤 주술사가 당신 같은 노련한 모험가를 찾고 있습니다. 드워프의 능력을 흉내 내는 방법을 고안하는 것을 돕기 위해서죠.\n\n질병을 스스로 씻어내는 그들의 능력과 관련된 일입니다. 주술사는 타나리스 남부의 안제와타 남서쪽 끝자락 해안에서 서식하는 독특한 종의 바실리스크를 연구 중입니다.\n\n보통 이런 기이한 요청은 멀리하겠지만... 춘코는 평판이 좋은 호드의 일원입니다.",
  },
  [27942] = {
    ["T"] = "보는 돌",
    ["O"] = "북쪽 동굴에 있는 쿠자즈라 거미로부터 20개의 쿠자즈라 눈을 모으십시오.",
    ["D"] =
    "이곳 바실리스크들이 드워프와 얼마나 많은 능력을 공유하는지 놀랍군. 반짝이는 것을 감지하는 예리한 눈이나 같은 저항력 말이야...\n\n춘코는 반짝이는 윤기가 흐르는 그 눈을 찾고 있어. 눈을 너무 오래 쳐다보지 않게 조심해라... 시선을 떼지 못하게 될 테니!\n\n빛나는 눈이 곧 보물이지. 가능하면 그것들을 가져와.",
  },
  [27943] = {
    ["T"] = "진정해",
    ["O"] = "북쪽 동굴에 있는 쿠자즈라 거미 근처에 얼어붙은 사냥감에서 15개의 얼어붙은 조각을 모으십시오.",
    ["D"] =
    "타나리스는 덥다, 형제여! 춘코에겐 너무 덥지... 하지만 바실리스크가 널 도와주는 건 원치 않아.\n\n바실리스크의 입김에 당한 모든 영혼들은 동굴에 전시되어 있지... 곧 보게 될 거다. 꽁꽁 얼어붙어 있지! 이런 곳에서 말이야!\n\n우리는 네가 발견한 자들의 유해가 필요해. 그것들을 부숴서 얼어붙은 덩어리들을 모아 와라 -- 정중하게 말이야.",
  },
  [27944] = {
    ["T"] = "역저주 금지!",
    ["O"] = "쉐이커를 이용해 북쪽 동굴에 있는 쿠자즈라 거미로부터 80개의 쿠자즈라 비늘을 채취하십시오.",
    ["D"] =
    "춘코는 육체의 저주를 알지. 우린 저주가 우리를 반대로 덮치는 건 원치 않는다고, 안 그래?\n\n바실리스크 비늘... 그건 우리가 부적에 써야 할 재료다. 정령들도 그렇게 말했으니 우린 따라야 해. 춘코에게 비늘을 아주 쉽게 떼어낼 수 있는 막대가 하나 있지...\n\n조심해라, 형제여. 쿠자즈라는 결코 가볍게 여길 적이 아니다!",
  },
  [27945] = {
    ["T"] = "불멸의 신앙",
    ["O"] = "춘코에게 준비가 되었다고 말한 후, 춘코의 부적을 사용하여 그의 칼에 베인 상처에서 살아남으십시오.",
    ["D"] =
    "좋아, 마지막 시험이다...!\n\n드워프에 대해 알고 있나? 냉기, 출혈, 독, 질병에 대한 내성... 그리고 두꺼운 피부까지, 하지만 그건 돌로 변했을 때만 그렇지.\n\n춘코에게 이 칼이 있다... 톱니 모양 칼날에 춘코가 찾을 수 있는 가장 치명적인 독을 발랐지. 타나리스 주변 시체들의 병든 피다.\n\n형제여, 부적을 쓰지 않으면 이건 널 죽일 거다. 하지만 결국엔 부적이 통할 거라고 영혼들이 말했지. 상처를 낼 준비가 되면 춘코에게 말해라.",
  },
  [27946] = {
    ["T"] = "부두교의 힘",
    ["O"] = "오그리마 용맹의 투기장에 있는 최고사령관 조크와 대화하십시오.",
    ["D"] =
    "너와 함께 일해서 좋았다, $N.\n\n그 눈이 너에게 보물도 보여줄 거다…\n\n오그리마의 최고사령관 조크를 찾아가라. 춘코의 일은 끝났다.",
  },
  [27947] = {
    ["T"] = "인간의 정신",
    ["O"] = "스톰윈드 구 시가지 구역에 있는 SI:7의 단장 마티아스 쇼와 대화하십시오.",
    ["D"] =
    "다시 만났군, $N. 인간들처럼 당신도 치즈의 광팬이라고 들었어.\n\n마티아스 쇼 단장이 자신을 위해 일을 해줄 특별한 사람을 찾고 있다고 공고를 냈어. 치즈와 관련된 일이지. 혹시 당신이 적임자가 아닐까?\n\n스톰윈드의 구 시가지에 있는 SI:7에서 쇼 단장을 찾을 수 있어.",
  },
  [27948] = {
    ["T"] = "인간의 정신",
    ["O"] =
    "스톰윈드 상업 지구에 있는 트리아스 치즈 상점의 엘링 트리아스에게 룬무늬 옷감 20개, 굵은 비단실, 황금 염료를 가져가십시오.",
    ["D"] =
    "그 일을 수락할 생각이 있다면 위장을 위한 재료가 필요할 거다. 룬무늬 옷감, 실, 그리고 스톰윈드 귀족들만 쓰는 특이한 황금 염료. 앞의 두 개는 구하기 쉽겠지만, 염료는 아델버트 페리에게서 얻어야 해. 페리는 공원에서 양복점을 위장으로 운영하는 데피아즈단 동료야. 페리를 제거하고 염료를 빼앗아... 들키지만 마.\n\n다 끝나면 상업 지구에 있는 엘링 트리아스에게 재료를 가져가.",
  },
  [27949] = {
    ["T"] = "인간의 정신",
    ["O"] =
    "비토 스톰윈디코, 남녘분노 강 블루치즈, 퀘소 오르코를 맛보십시오. 최고급 테라모어산 레드 와인 한 병과 곁들여 마시십시오. 그런 다음 스톰윈드 왕궁에 있는 테사 엘레리안과 대화하십시오.",
    ["D"] =
    "귀족의 신뢰를 얻으려면 최신 인간 트렌드와 패션에 대해 쉽게 대화할 수 있어야 해.\n\n일단 음식부터 시작하지. 가장 훌륭한 인간 치즈 목록을 만들었으니 어떤 게 마음에 드는지 맛을 봐. 최고급 와인과 곁들이는 것도 좋지. 마을 안 가게에서 맛볼 수 있을 거야. 그 후엔 테사 엘레리안과 대화하는 게 좋겠군.\n\n그녀도 오래 전에 궁정 에티켓을 배워야 했거든.",
  },
  [27950] = {
    ["T"] = "인간의 정신",
    ["O"] = "테사 엘레리안의 이야기를 들은 후, 상업 지구의 엘링 트리아스에게 돌아가십시오.",
    ["D"] =
    "엘링 트리아스가 당신을 보냈다고요? 데피아즈단 사건과 관련이 있다고요? 이게 진짜 에티켓에 관한 일인지 의심스럽군요. 그는 당신이 이 일을 왜 하는지 이해하길 바라는 겁니다.\n\n용서하세요, 길고 아직 고통스러운 이야기입니다. 하지만 당신이 듣고 싶다면 이야기해 드릴게요.",
  },
  [27951] = {
    ["T"] = "인간의 정신",
    ["O"] =
    "스톰윈드 궁정의 고급 예복을 입고, 스톰윈드 왕궁 왕실 회랑에 있는 파딘 레스코바르와 대화하십시오. 어떤 수를 써서라도 그녀에게서 데피아즈단 명부를 얻어내십시오.",
    ["D"] =
    "파딘 레스코바르 부인과 만나게 될 거다. 그녀의 아버지는 데피아즈단 지지자였으며, 그녀는 전직 데피아즈단원들의 명부를 가지고 있어. 그녀는 데피아즈단의 목적을 증진시키는 데 관심 있는 대리인과 만난다고 믿고 있지.\n\n정치적 감각과 세련된 취향으로 그녀를 감동시키면 순순히 명부를 넘겨줄 거야. 하지만 일이 잘못된다면, 어떤 방법을 써서라도 그것을 손에 넣어.",
  },
  [27952] = {
    ["T"] = "인간의 정신",
    ["O"] = "스톰윈드의 기록관 로이를 찾으십시오.",
    ["D"] =
    "이 정보는 왕국에 남은 데피아즈단 잔당을 소탕하는 우리 노력에 헤아릴 수 없이 큰 가치가 될 거요. 당신은 스톰윈드를 위해 훌륭히 봉사했소, $N. 감사를 표하오.\n\n다시 한번 인간의 정신을 체감하고 싶어진다면, 스톰윈드의 기록관 로이와 대화하시오.",
  },
  [27953] = {
    ["T"] = "기술의 마법",
    ["O"] = "저습지에 있는 웨일린 팅커스프링의 연구소에서 그와 대화하십시오.",
    ["D"] =
    "반갑습니다, $C. 어떤 노움 발명가가 모단 호수에서 저습지로 가는 길에 있는 던 알가즈의 자기 작업장에서 기계를 만드는 데 도움을 필요로 하고 있습니다.\n\n그는 당신같이 유능한 모험가를 찾고 있으며, 시제 기계를 보수로 주겠다고 하더군요.\n\n여기를 보면 은신, 빠른 반사신경, 그리고... 어, 제오사인... 아, 흠, 나이트 엘프와 비슷한 능력을 얻게 될 거라고 하네요.\n\n음, 꽤 흥미롭게 들립니다. 이 일에 관심이 있으신가요?",
  },
  [27954] = {
    ["T"] = "투명한 자",
    ["O"] = "밤에 아즈샤라 멘나르 호수에서 호수 정령을 처치해 영혼 찌꺼기를 모으십시오.",
    ["D"] =
    "'투명함'이라는 말을 들으면 뭐가 생각나? 도적인가? 아니면 어떤... 말도 안 되는 마법사 주문?!\n\n내가 뭘 생각하는지 말해주지. 유령이야! 유령은 자신들이 원할 때만 모습을 드러낸다는 사실을 알고 있어? 뭐, 대부분은 그렇다고 하더라고.\n\n아즈샤라에 있는 유령에 대해 읽어본 적이 있어 -- 슬픈 사연이지... 다음에 얘기해 줄게! 멘나르 호수 위를 맴돌고 있을 텐데, 햇빛이 비치지 않을 때만 나타나! 아주 중요한 거야 -- 밤에만 찾을 수 있어!\n\n녀석을 쓰러뜨리고 놈이 남긴 영혼 찌꺼기를 가져와. 분명 우리가 딱 필요로 하는 것일 거야!",
  },
  [27955] = {
    ["T"] = "빠른 반사신경!",
    ["O"] = "운고로 분화구 습지대 동굴에서 갈퀴발톱 라바사우루스 심장줄 12개를 가져오십시오.",
    ["D"] =
    "신체의 여러 관절에 착용하면 반사 신경을 강화해주는 기계 소매를 만들었어. 네가 무슨 생각을 하는지 알겠군... 이거 안전해?\n\n아직 모르겠지만 곧 알게 되겠지! 걱정 마, 부러진 뼈나 관절쯤이야 고쳐줄 수 있으니까.\n\n<웨일린이 구부러진 손가락을 눈앞에서 까딱거립니다. 손상이 심한데도 놀라울 만큼 섬세해 보입니다.>\n\n이제 필요한 건 갈퀴발톱 라바사우루스의 심장줄이야. 운고로 분화구 습지대의 동굴 안에서만 서식하는 희귀한 종이지. 녀석들은 찰나의 반응 속도로 유명해서, 그런 녀석의 심장이라면 틀림없이 질기고 탄력 있는 심장줄을 가졌을 거야!",
  },
  [27956] = {
    ["T"] = "정령의 모방",
    ["O"] = "나후벤과 일락나의 정령 핵을 가져오십시오.",
    ["D"] =
    "내 연구에 따르면 나이트 엘프들은 해와 달의 주기에 따라 축복을 받아.\n\n그리고 불과 물의 정령도 서로 대립하는 유사한 주기를 따른다는 글을 읽은 적이 있지! 그들의 핵심 핵은 강력하고 재생 가능한 부품으로 작동할 뿐만 아니라 기계의 효과를 조절하는 역할도 해 줄 거야.\n\n불타는 평원에 강한 불의 정령이 있다는 걸 알아... 공격적이기도 하지. 검은바위 산의 화산재 웅덩이 아래에서 녀석을 찾을 수 있을 거야. 그리고 또 보자... 가시덤불 골짜기 폭풍의 해안 근처 섬을 도는 강력한 물의 정령이 있다고 확신해. 섬 전체가 물의 정령으로 가득하니 놓칠 리 없겠지! 이런 녀석들에 대해 어떻게 알았냐고? 책에서 읽었지!\n\n녀석들의 핵을 가져오면 기계를 개조해 보자.",
  },
  [27957] = {
    ["T"] = "모두 조립하기",
    ["O"] = "저습지에 있는 웨일린 팅커스프링의 연구소 주변에서 노움 부품 5개를 수집하십시오.",
    ["D"] =
    "믿을 수가 없어, 거의 다 왔어 $N! 드디어 내 꿈이 실현되는 거야...!\n\n네가 쓸 수 있는 걸 손에 쥐고 싶어 할 테니 이제 마무리 작업을 하자! 부품들을 펼쳐 놓을 텐데 조립하려면 작업실 주변의 도구와 재료들이 필요해.\n\n좀 거들어 줄래? 이걸 완성하려면 남는 부품이 죄다 필요하니까 내 보물들 뒤질 때는 아무거나 집어 들지 말고. 살살 다뤄 줘!",
  },
  [27958] = {
    ["T"] = "첫 번째 시험",
    ["O"] = "웨일린의 발명품을 직접 사용해보고 무슨 일이 일어나는지 확인하십시오.",
    ["D"] =
    "자, $N. 다 조립했으니 직접 써봐!\n\n<웨일린이 상자에 가득 담긴 장비를 당신의 품에 안겨줍니다.>\n\n네 갑옷 안에 맞을 테니 모양새는 걱정하지 마!",
  },
  [27959] = {
    ["T"] = "수리가 필요하신가요?",
    ["O"] = "아이언포지의 기록관 던짐과 대화하십시오.",
    ["D"] =
    "다음 모험을 떠날 준비가 됐겠지, $N.\n\n난 여기 연구소가 마음에 들어. 시끄럽고 복잡한 곳에서 멀리 떨어져 있으니까! 장비가 고장 날 때마다 여기까지 오고 싶지는 않을 테니, 수리 키트는 필요할 때마다 쓸 수 있게 아이언포지의 기록관 던짐에게 보내둘게.\n\n너랑 같이 일해서 즐거웠어. 그냥 찾아오고 싶을 때 언제든 다시 와!",
  },
  [27960] = {
    ["T"] = "뾰족창 축제",
    ["O"] = "다르나서스 달의 신전에 있는 사절 크랄본과 대화하십시오.",
    ["D"] =
    "신나는 소식입니다! 어둠해안에 사는 은둔자 같은 뾰족창 트롤들이 축제를 여는데, 그들의 풍습을 지켜보고 참여할 수 있도록 처음으로 외부인을 환영하고 있습니다. 머리에 도끼가 날아올 위험 없이 트롤을 관찰할 수 있는 아주 드문 기회입니다.\n\n관심이 있다면 다르나서스 달의 신전에서 그들의 사절을 찾을 수 있습니다.",
  },
  [27961] = {
    ["T"] = "뾰족창 축제",
    ["O"] = "오그리마 정기의 골짜기에 있는 사절 발크론과 대화하십시오.",
    ["D"] =
    "신나는 소식입니다! 어둠해안에 사는 은둔자 같은 뾰족창 트롤들이 축제를 여는데, 그들의 풍습을 지켜보고 참여할 수 있도록 처음으로 외부인을 환영하고 있습니다. 머리에 도끼가 날아올 위험 없이 트롤을 관찰할 수 있는 아주 드문 기회입니다.\n\n관심이 있다면 오그리마 정기의 골짜기에서 그들의 사절을 찾을 수 있습니다.",
  },
  [27962] = {
    ["T"] = "뾰족창 축제",
    ["O"] = "도끼 던지기 대회에 출전하여 뾰족창 축제에 참여한 후, 뾰족창 마을의 우나 지로에게 돌아가십시오.",
    ["D"] =
    "뾰족창 축제에 온 걸 환영한다, $R! 외부인을 받아들이는 건 드문 일이니 영광으로 생각하라고. 집으로 돌아가고 싶으면 언제든 나한테 말해.\n\n가기 전에 축제를 즐겨. 음식과 음료도 맛보고... 용감하다면 불빛 아래서 춤을 춰도 좋고. 과녁에 도끼를 던져서 뾰족창 챔피언인 브루 주닐에게 도전해 봐도 좋아. 마을 안쪽으로 들어가면 전부 해볼 수 있을 거다.",
  },
  [27963] = {
    ["T"] = "초보자를 위한 광폭화",
    ["O"] = "부두 재료를 모아 뾰족창 축제의 의술사 할데에게 가져가십시오.",
    ["D"] =
    "아하 꼬맹이, 보아하니 브루에게 당한 희생양이 또 하나 늘었군. 브루를 쓰러뜨릴 수 있는 힘을 줄게. 그 녀석은 코를 좀 납작하게 해 줄 필요가 있거든.\n\n브루가 챔피언 자리를 지키는 비밀은 바로 모든 영웅들의 힘을 북돋는 내면의 분노와 연결되어 있기 때문이야. 트롤들은 태어날 때부터 그 연결고리를 배우지만, 너 같은 이방인이라도 제대로 훈련하면 그걸 이끌어 낼 수 있지.\n\n이 훈련을 수월하게 하려면 재료 몇 가지가 필요해. 정글 트롤에게서 모조가 담긴 약병을, 서리 트롤을 대표하는 여명의 설원 곰들에게서 이빨을, 그리고 우리의 적인 숲 트롤의 뼈를 구해와. 파괴된 동부 역병지대에 있는 이끼껍질 트롤 뼈면 될 거야.\n\n우나 지로와 각 대도시에 있는 사절을 통해 서로 오갈 수 있을 거다.",
  },
  [27964] = {
    ["T"] = "초보자를 위한 광폭화",
    ["O"] =
    "광폭화 상태의 버프를 받은 채로 뾰족창 마을의 동굴에 있는 뾰족창 부족 주술품을 파괴한 후, 의술사 할데에게 돌아가십시오.",
    ["D"] =
    "솔직히 말해서 네가 살아 돌아올 줄은 몰랐다, $R. 보기보다 훨씬 질긴 녀석이군.\n\n다행이야. 다음 단계에서는 우리 종족의 방식으로 널 시험할 테니 말이지. 길 위로 조금 올라가면 동굴이 있다. 네가 가져온 재료들로 만든 이 목걸이를 목에 걸어. 그럼 광전사의 속도를 축복해 줄 거다. 거부하지 말고 내맡겨라. 그리고 그 상자 안에서 발견하게 될 것을 무찌를 힘을 얻는 거다... 네게 그걸 열 용기가 있다면 말이지.",
  },
  [27965] = {
    ["T"] = "초보자를 위한 광폭화",
    ["O"] = "뾰족창 마을의 도끼 던지기 대회에서 브루 주닐을 이기고 의술사 할데에게 돌아가십시오.",
    ["D"] =
    "너는 광폭화 방식에 대해서 아직 초보지만 브루 주닐과의 대결에 쓸 만큼은 알아. 브루는 게을러졌고 그걸 예상치 못할 거다. 바로 치고 들어가면 네게 유리할 거야.\n\n너한테 걸겠다, $N. 도끼 던지기장으로 돌아가 브루에게 다시 도전해 봐. 녀석을 이기면 널 명예 뾰족창 챔피언으로 인정해 주지.",
  },
  [27966] = {
    ["T"] = "다르나서스로 돌아가기",
    ["O"] = "다르나서스의 달의 신전에 있는 역사가 디미트레스쿠와 대화하십시오.",
    ["D"] =
    "있지 친구, 분노를 조절하는 것보다 트롤이 되는 게 더 많은 법이다. 하지만 분노 조절에 대해 더 배우고 싶다면 다르나서스에서 더 많은 걸 가르쳐 줄 사람이 있을 거야.\n\n크랄본 대사 말로는 나이트 엘프인 디미트레스쿠가 우리 역사를 배우고 싶어 안달 났다고 하더군. 우리도 한때는 같은 편이었는데 말이야.\n\n하지만 그건 아주 오래 전, 살아있는 대부분이 기억하지 못하는 일이지.\n\n<당신에게 윙크하는 의술사 할데.>\n\n행운을 빌게, 모험가여.",
  },
  [27967] = {
    ["T"] = "오그리마로 돌아가기",
    ["O"] = "오그리마 용맹의 투기장에 있는 최고사령관 조크와 대화하십시오.",
    ["D"] =
    "있지 친구, 분노를 조절하는 것보다 트롤이 되는 게 더 많은 법이다. 하지만 분노 조절에 대해 더 배우고 싶다면 오그리마에서 더 많은 걸 가르쳐 줄 사람이 있을 거야.\n\n발크론 대사 말로는 타우렌 조크가 우리 역사를 배우고 싶어 안달 났다고 하더군. 아주 먼 옛날, 세상 곳곳에서 트롤의 지혜를 배우러 왔었지. 하지만 그건 아주 오래 전, 살아있는 대부분이 기억하지 못하는 일이지.\n\n<당신에게 윙크하는 의술사 할데.>\n\n행운을 빌게, 모험가여.",
  },
  [27968] = {
    ["T"] = "용서",
    ["O"] = "",
    ["D"] = "",
  },
  [27969] = {
    ["T"] = "작업장의 의식",
    ["O"] = "황야의 땅 용수철 거점에 있는 호위 카트스프로켓과 대화하십시오.",
    ["D"] =
    "처음 구리관과 구동부품을 조립하던 시절부터 꽤 많이 성장했군. 자네의 기계공학 실력을 시험해 볼 때가 된 것 같아.\n\n땜장이 조합 회의에서 만난 지인에게서 연락이 왔어. 기계 제작보다 역사에 더 푹 빠진 녀석이지 -- 호위가 가장 좋아하는 건 역사야. 아무튼 그 녀석이 기술 좋은 기계공학자의 도움이 절실하대. 호드, 얼라이언스 그딴 건 아무 상관없다는 거야! 정말 다급한 모양이야.\n\n호위를 잘 알지만 이 일은 돈이 되지는 않을 거야. 그래도 흥미로운 일이 될 게 분명해. 어때, 해볼 텐가?",
  },
  [27970] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "호위 카트스프로켓은 톨 바라드 섬의 바라딘 요새로 가서 바라딘 요새 경비병들에게 자신의 안전장치 노트를 받아온 후, 황야의 땅 용수철 거점에 있는 자신에게 전해 주길 원합니다. 아라시 고원 팔디르의 만에서 톨 바라드행 배를 탈 수 있습니다.",
    ["D"] =
    "탐험가 연맹은 티탄의 역사를 연구하기 위해 설립됐지만, 나는 그들의 기술에 대해 더 알고 싶어! 특히나 근본-조립-내부 연결-지맥 안정-비전-흐름 기계, 줄여서 F.A.I.L.S.A.F.E.(안전장치)라고 알려진 장치의 소문에 대해서 말이지. 이 장치는 행성의 재앙을 막기 위해 설계되었지만, 유지보수되지 않으면 수많은 문제를 초래할 수 있어.\n\n안전장치에 관한 내 연구 노트가 지금 바라딘 요새 감옥에 수감된 지인에게 도둑맞았지. 그곳 경비병에게 편지를 썼더니 언제든 와서 가져가도 좋다고 답장이 왔어. 아직 갈 시간이 없었는데 조수가 있으면 일을 동시에 진행할 수 있지 않겠어? 그러니 톨 바라드로 가서 내 노트를 가져다 줘!",
  },
  [27971] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "바라딘 요새 죄수 중 한 명에게서 호위 카트스프로켓의 노트를 되찾아 황야의 땅 용수철 거점에 있는 호위 카트스프로켓에게 돌려주십시오.",
    ["D"] =
    "바라딘 간수 중에 호위의 노트를 회수하는 데 도움을 줄 간수가 없기 때문에 당신이 직접 처리해야 할 것입니다.\n\n죄수들 중 한 명이 노트를 훔친 자일 겁니다. 그들을 심문하거나 감방을 조사하면 찾고 있는 걸 발견할 수 있지 않을까요?",
  },
  [27972] = {
    ["T"] = "작업장의 의식",
    ["O"] = "운고로 분화구 마샬의 야영지에 있는 J.D. 콜리와 대화하십시오.",
    ["D"] =
    "이제 노트를 찾았으니 내가 발견한 것을 떠올릴 수 있겠군. 아, 그래! 미지의 땅인 운고로 분화구로 탐험을 떠난 동료에게서 닳아빠진 편지를 한 통 받았지. 그녀는 분화구에서 안전장치와 관련된 티탄 기술의 흔적을 찾을 수 있을 거로 의심하고 있었어.\n\n있잖아, 내가 노트를 다 다시 읽으려면 시간이 좀 걸릴 텐데. 당신이 그녀를 찾아가는 게 어때? 노움에게서 직접 소식을 듣는 거지. 먼 곳이니 당신이 돌아올 때쯤이면 나도 다시 시작할 준비가 다 되어 있을 거야.",
  },
  [27973] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "운고로 분화구의 타르 정령을 처치해 티탄 기술의 파편을 회수하고 운고로 분화구 마샬의 야영지에 있는 J.D. 콜리에게 가져가십시오.",
    ["D"] =
    "호위가 티탄 기술에 관해 물어보려고 먼 곳까지 당신을 보냈다고요? 글쎄, 호위에게 해 줄 수 있는 말이 별로 없는데요! 저는 분화구 주변에 흩어져 있는 수정 철탑에 대해 연구하고 있지만 그것들이 티탄만큼이나 오래된 것인지는 잘 몰라요.\n\n굳이 짐작하자면, 이곳의 정령들은 매우 오래된 존재예요. 그리고 수많은 타르 구덩이도 있죠. 티탄의 기술 중 일부가 타르 정령들에게 빨려 들어간 건 아닐까요? 녀석들을 샅샅이 해부해 보면 아주 오래된 티탄 물건을 찾을 수 있을지도 몰라요!",
  },
  [27974] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "운고로 분화구 마샬의 야영지에 있는 J.D. 콜리가 정밀한 아케이나이트 변환기를 제작해달라고 합니다. 그것을 제작해 그녀에게 가져가십시오.",
    ["D"] =
    "분명히 이건 열리는 거예요! 그저 기계적으로 잠겨 있을 뿐이죠. 정밀한 아케이나이트 변환기만 있다면요.\n\n잠깐! 기계공학자라고 했죠? 하나 만들어 줄 수 있어요? 만들어서 제게 가져오시면, 제가 이걸 열 수 있을 것 같아요!",
  },
  [27975] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "실리더스에 있는 무리벌레, 거미벌레, 굴벌레, 일벌레를 이상한 고대 물품을 찾을 때까지 처치하고, 황야의 땅 용수철 거점에 있는 호위 카트스프로켓에게 가져가십시오.",
    ["D"] =
    "구체 안의 이 장치는.... \n\n<기침을 하며 물건에서 모래를 더 털어내는 J.D.>\n\n틀림없이 제겐 티탄 기술처럼 보입니다. 하지만 이 모래 좀 보세요! 여긴 운고로가 아니에요! 그리고 타나리스의 모래 같지도 않은걸요.\n\n하지만... 얼마 전 실리더스 사막으로 가려던 탐험대가 여기를 지나갔어요. 그 사막에서 땅을 파는 벌레 무리를 발견했다고 보고했었죠. 파고드는 벌레들이라면, 거기서 온 물건들을 더 많이 갖고 있지 않을까요?\n\n탐험대가 북서쪽 언덕으로 올라가는 길을 발견했어요. 한 번 시도해 볼 만합니다. 무언가를 찾는다면 호위에게 다시 가져가는 게 좋겠어요. 전 이걸 어떻게 해야 할지 모르겠거든요.\n\n행운을 빕니다!",
  },
  [27976] = {
    ["T"] = "작업장의 의식",
    ["O"] =
    "호위 카트스프로켓이 기계공학 기술을 이용해 야전수리로봇 1개, 일급 표적 허수아비 3개, 대규모 시포리움 폭약 1개, 토륨 수류탄 20개를 제작해달라고 합니다. 황야의 땅 용수철 거점으로 이것들을 가져가십시오.",
    ["D"] =
    "울둠은 고대 티탄의 연구 시설이야. 이 노드들은 참고문헌 같은 거고 그걸 읽어낼 장치는 그 시설 안에 있어야 해. 하지만 아주 단단하게 잠겨 있지.\n\n이 노드가 울둠을 열기 위한 우리 연구에 도움이 될지도 몰라. 용수철 거점에서 작업을 마치는 대로 그곳으로 가야겠어.\n\n떠나기 전에 진짜 사막 야영을 위한 준비를 해야 해 -- 게다가 타나리스는 황야의 땅보다 훨씬 험지라고 하더군! 그래서 널 내 조수로 둔 거야! 발굴 작업을 위한 야전수리로봇과 대규모 시포리움 폭약, 함정을 위한 일급 표적 허수아비 몇 개, 그리고 사나운 맹수들을 쫓아버릴 수많은 토륨 수류탄 등 물품이 좀 필요해!",
  },
  [27977] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 기계타조를 선택하십시오.",
    ["D"] = "",
  },
  [27978] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 산양을 선택하십시오.",
    ["D"] = "",
  },
  [27979] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 말을 선택하십시오.",
    ["D"] = "",
  },
  [27980] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 표범을 선택하십시오.",
    ["D"] = "",
  },
  [27981] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 늑대를 선택하십시오.",
    ["D"] = "",
  },
  [27982] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 코도를 선택하십시오.",
    ["D"] = "",
  },
  [27983] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 랩터를 선택하십시오.",
    ["D"] = "",
  },
  [27984] = {
    ["T"] = "교환권 사용",
    ["O"] = "탈것 교환권을 사용해 해골마를 선택하십시오.",
    ["D"] = "",
  },
  [27985] = {
    ["T"] = "연구소의 의식",
    ["O"] = "저승바람 고개 야영지에 있는 아리덴 엘리스와 대화하십시오.",
    ["D"] =
    "그동안 자네가 이곳을 숱하게 드나드는 것을 보아 왔고 자네의 연금술 숙련도를 매우 높게 평가하는 바이네. 사실 너무나 감명받은 나머지, 자네를 하나 추천하고 싶은 일이 있어.\n\n어떤 수수께끼를 풀어야 하는데, 거기에 연금술 장인의 기술이 필요하다며 옛 지인에게 연락이 왔다네. 자네의 모험심과 연금술 기술을 생각하면 이 일에 가장 적합할 거로 생각해.\n\n관심 있다면, 저승바람 고개로 가 보게. 그 황량한 계곡 어딘가에 야영하고 있는 아리덴을 찾을 수 있을 거야.",
  },
  [27986] = {
    ["T"] = "연구소의 의식",
    ["O"] =
    "아리덴 엘리스가 연금술 기술을 사용하여 일급 치유 물약 5개, 일급 마나 물약 5개, 돌비늘 오일 5개, 체력 회복의 물약 5개를 제작해달라고 합니다. 그것들을 저승바람 고개로 가져가십시오.",
    ["D"] =
    "저는 오랫동안 카라잔의 관리인으로 일했습니다. 내 스스로가 유능한 연금술사는 아닐지 몰라도 물약과 영약은 다룰 줄 안다오. 카라잔 연금술사들이 소유했던 지식을 되찾는 것이 제 의무이지만 고급 기술을 가진 누군가의 도움이 필요합니다.\n\n먼저, 당신이 그런 기술을 가졌다는 것을 제게 보여줘야 합니다. 여기 만들기가 꽤 까다로운 물약 목록이 있소. 이 물약들을 제조하여 능력을 증명해주시오. 그러면 여기서 무엇을 하려는지 당신에게 알려드리리다.",
  },
  [27987] = {
    ["T"] = "연구소의 의식",
    ["O"] = "남쪽에 있는 카라잔 폐허를 수색하여 연금술 책을 찾으십시오. 찾은 책은 저승바람 고개의 아리덴 엘리스에게 가져가십시오.",
    ["D"] =
    "그 시절, 제대로 돌아가던 카라잔의 연금술 연구소를 자네가 직접 보지 못했다는 건 정말 아쉬운 일이네. 난 서재에서 책을 빌려오곤 하며 연금술의 경이로움에 대해 읽곤 했다네. 비극이 일어났을 때, 나는 자리를 비웠었고 소중한 고서 하나만을 간직하고 있었어. 그 고서 덕에 다시 이곳으로 돌아와 다른 책들을 더 찾아야겠다는 영감을 받았지.\n\n폐허 어딘가에 자네가 찾을 수 있는 고서가 더 있을 거라 생각하네. 심지어 거길 헤매고 있는 영혼들의 손에 들어갔을 수도 있고 말이야. 부디, 폐허를 샅샅이 뒤져 연금술 고서를 찾는 대로 가져다주게나.",
  },
  [27988] = {
    ["T"] = "연구소의 의식",
    ["O"] =
    "서부 역병지대 카엘 다로우 섬에 있는 스칼로맨스 연구소에서 교사 유령을 처치하여 봉인 해제 연고를 수집한 뒤, 저승바람 고개의 아리덴 엘리스에게 가져가십시오.",
    ["D"] =
    "세상에, 도안의 개인 연금술 노트를 회수하다니 믿을 수가 없군요! 전쟁 후 그가 미쳐서 붉은십자군에 가입했다는 소식을 들었지만, 한때 카라잔에서 일하던 키린 토 수습생이었죠. 도안은 연금술에 재능이 있었고 창의적이었지만, 그의 진정한 관심은 순수한 비전 마법이었소.\n\n이 고서엔 내가 재현하고 싶은 바로 그 실험이 적혀 있지만, 아마 눈치채셨듯 결계로 보호받고 있소. 키린 토의 결계는 강력하지만 올바른 재료만 있으면 깰 수 있지. 생각 좀 해볼까요....\n\n스칼로맨스에 머무는 사악한 강령술사들에게 우리가 필요한 게 있을 거라고 짐작하오. 그들만의 연금술 연구소가 있다고 들었는데, 카라잔에 비할 바는 못 되겠지만 말이오. 저주받은 자들의 교단은 우리 모두에게 재앙이지. 그곳으로 가서 봉인 해제 연고를 좀 가져오시오.",
  },
  [27989] = {
    ["T"] = "연구소의 의식",
    ["O"] =
    "아리덴 엘리스가 연금술 기술을 사용하여 눈부신 빛의 영약 5개, 현자의 비약 5개, 최상급 방어의 비약 5개, 살쾡이의 비약 5개를 제작해달라고 합니다. 저승바람 고개 야영지로 이것들을 가져가십시오.",
    ["D"] =
    "좋소, 이제 이 책을 읽을 수 있군. 우린 엄청난 진전을 이뤘소, $N.\n\n내가 아는 도안의 연구는 여러 영약을 조합하여 일종의 강력한 궁극의 영약을 만들려는 시도였소. 그 시도는 몹시 위험한 것으로 판명되어 중단 명령을 받았고 -- 그때 그가 연금술에 흥미를 잃어버렸소. 지금은 우릴 말릴 사람이 아무도 없으니 그가 남긴 연구를 우리가 마저 이어갈 수 있소.\n\n도안이 추천한 영약 목록이 여기 있군: 눈부신 빛, 현자, 최상급 방어, 살쾡이. 5개씩 만들어오면 한번 시도해 볼까 하오.\n\n이것이 효과가 있다면, 카라잔 내부에 접근하고 악마의 타락마저 지워버릴 수 있는 영약을 만들어 낼지도 모른다오.",
  },
  [27990] = {
    ["T"] = "연구소의 의식",
    ["O"] =
    "실리더스에 있는 대기의 정령으로부터 10개의 정제된 유리 조각을 얻으십시오. 유리와 아케이나이트 주괴를 저승바람 고개 야영지에 있는 아리덴 엘리스에게 가져가십시오.",
    ["D"] =
    "도안의 가장 큰 난제는 이 영약들을 결합했을 때 생기는 강력한 혼합물을 담을 적절한 용기를 찾는 것이었어. 일반적인 수정 약병은 금이 가거나 심지어 폭발하기도 했지! 정말 놀라워!\n\n하지만, 나에게 묘안이 하나 있다네. 실리더스라는 먼 땅에 대해 읽은 적이 있네. 바람의 정령들이 그 땅을 배회하며 고운 고대의 모래를 집어 올린다고 해. 고대 나이트 엘프의 기록에 따르면 정령들이 요동치는 그들의 몸속에서 그 모래를 돌려 극도로 강한 유리 파편을 만들어 낸다고 하더군.\n\n뭐라고? 난 독서를 아주 많이 한다네.\n\n칼림도어의 저 머나먼 곳까지 가는 것이 긴 여행이라는 건 알지만, 그게 우리의 최선의 방책이야. 우리가 사용할 수 있는 이 튼튼한 유리 조각을 충분히 모을 때까지 정령들을 베어 주게나. 아, 유리를 보강하기 위한 아케이나이트 주괴도 필요하지만, 자네 실력이라면 문제도 아닐 거야.",
  },
  [27991] = {
    ["T"] = "연구소의 의식",
    ["O"] = "저승바람 고개에 있는 아리덴 엘리스와 함께 실험 결과를 지켜보십시오.",
    ["D"] =
    "얘기가 딴 데로 샜군. 향수에 젖은 늙은이의 횡설수설은 부디 용서해 주게.\n\n이제 실험에 필요한 모든 것이 준비되었소. 이제 도안의 노트 지시대로 재료들을 혼합하겠소. 부디, 이 미스터리의 결말에 저와 함께 해주십시오.",
  },
  [27992] = {
    ["T"] = "대장간의 의식",
    ["O"] = "가시덤불 골짜기 무법항에 있는 맥개번과 대화하십시오.",
    ["D"] =
    "당신 낯이 익군요. 대장간 근처에서 시간을 많이 보내지 않소? 네, 당신은 우리가 필요로 하는 기술을 가졌군.\n\n무법항에 맥개번이라는 제 친구가 있소. 이전에 그와 마주친 적이 있을지도 모르지만, 그렇지 않다면 그와 미스릴 대장조합의 모든 구성원들이 금속과 마법의 비밀을 푸는 데 깊은 관심을 가지고 있다는 것만 알아두시오. 만약 당신도 관심이 있다면, 맥개번의 대장간으로 가보시오. 그는 이 세상 너머에 있는 어떤 것을 연구하고 있소....",
  },
  [27993] = {
    ["T"] = "대장간의 의식",
    ["O"] = "가시덤불 골짜기 무법항에 있는 맥개번이 대장기술을 사용하여 칠흑의 단검 2개를 제작해 달라고 합니다.",
    ["D"] =
    "내 친구가 당신이 금속학의 미스터리를 푸는 데 필요한 기술을 가졌다고 하던가? 그럼 한 번 시험해 볼까.\n\n나한테 칠흑의 단검 두 개를 만들어 줘. 도면이 없다면, 죽을 고비를 좀 넘겨야만 그 도면을 배울 수 있을 거야. 우린 그런 것들을 연구해야 하니 이보다 완벽한 시험은 없지.\n\n여전히 헷갈려? 서부 역병지대에 있는 스칼로맨스에 가서 찔러봐. 거기서 도면을 구하려면 허드렛일 몇 가지를 해야 할지도 모르지만, 다가올 일들에 대비해 당신을 더 강하게 만들어 줄 뿐이니까.",
  },
  [27994] = {
    ["T"] = "대장간의 의식",
    ["O"] =
    "동부 역병지대의 스트라솔름에 들어가 검은호위대 검제작자를 처치하십시오. 부패의 검을 회수하여 가시덤불 골짜기 무법항에 있는 맥개번에게 가져가십시오.",
    ["D"] =
    "사령의 금속을 다뤄본 적이 있나? 아니, 그런 금속에 대해 들어본 적은 있고? 없지? 글쎄, 그런 게 존재하고, 난 그것이 어떻게 돌아가는지 이해하려고 해.\n\n금속은 생명이 아니니 애초에 죽을 수조차 없어야 하고, 하물며 언데드가 되는 건 말도 안 돼. 스컬지가 이걸로 만든 칼을 쓴다는 이야기를 들은 적이 있어. 그래서 첫 번째 단계는 바로 그 칼을 손에 넣는 거야.\n\n스트라솔름에 예전에 거대한 대장간 구역이 있었지. 스컬지는 어떻게든 거기서 무지성 전사들을 위해 무기를 만들고 있으니 틀림없이 그곳에 있을 거야. 동부 역병지대로 가서 폐허에서 무얼 건질 수 있는지 한 번 봐봐. 친구들도 몇 데려가는 게 좋을걸.",
  },
  [27995] = {
    ["T"] = "대장간의 의식",
    ["O"] = "실리더스 브론즈비어드 야영지에 있는 브란 브론즈비어드와 대화하십시오.",
    ["D"] =
    "나도 우연히 탐험가 브란 브론즈비어드와 조우하면서 이 물질에 대해 처음 알게 되었어. 그는 내가 물어본 몇 가지를 조사해 주겠다고 약속했지만, 마지막 편지 이후로는 소식이 없어.\n\n당신이라면 위험한 상황에서도 스스로를 잘 지킬 수 있을 것 같군. 내가 부패의 검을 조사하는 동안 칼림도어의 반대편에 있는 실리더스로 가 줘. 브론즈비어드는 그가 발견한 드워프 유적을 연구하느라 거기에 텐트를 쳤다고 편지를 보냈지. 내가 품고 있는 질문에 대한 대답을 구해 이리로 가져와 줘.",
  },
  [27996] = {
    ["T"] = "대장간의 의식",
    ["O"] =
    "브란의 잠긴 상자를 되찾을 때까지 실리더스의 바위거미를 처치하십시오. 이 상자와 아케이나이트 해골 열쇠를 가시덤불 골짜기의 무법항에 있는 맥개번에게 가져가십시오.",
    ["D"] =
    "야영지를 세우고 얼마 지나지 않아 거미들이 우리 물건을 뒤지기 시작해서 정말 애를 먹었어. 녀석들을 쫓아내긴 했지만 그중 몇 마리가 끈적끈적한 거미줄에 우리 개인 물품을 붙여 달아나 버렸지!\n\n브란은 금속에 대한 기록들을 잠긴 상자 안에 모두 보관했었어. 그 상자를 마지막으로 본 건 진영에서 도망치는 긴다리 바위거미 등 위에서였지. 녀석들을 꽤 많이 죽이다 보면 결국 상자와 노트를 찾을 수 있을 거야.\n\n상자를 열 브란이 지금 없으니까 아케이나이트 해골 열쇠가 필요할 텐데. 당신이 대장장이니 그 정도는 문제없겠지.",
  },
  [27997] = {
    ["T"] = "대장간의 의식",
    ["O"] = "가시덤불 골짜기 무법항에 있는 맥개번이 대장기술을 사용하여 검은무쇠 어깨갑옷과 화산 해머를 제작해 달라고 합니다.",
    ["D"] =
    "당신이 자리를 비운 동안 부패의 검을 분해했어. 하지만 브란의 노트를 보니 그럴 필요가 없었을지도 모르겠군. 사령의 에너지가 일반 금속에 작용해서 사령의 금속으로 변환된다는 게 브란의 이론이야!\n\n그 이론을 검증해 봐야 해. 브란은 바탕으로 쓰기 좋은 물건들을 몇 개 추천해 뒀어. 이 목록을 바탕으로... 검은무쇠 어깨갑옷과 화산 해머를 만들어 줘.\n\n이 도면들을 모른다면, 글쎄, 검은무쇠 어깨갑옷은 검은바위 산의 깊숙한 곳에서 나오고, 화산 해머의 도면은 토륨 대장조합의 누군가에게 살 수 있어.",
  },
  [27998] = {
    ["T"] = "대장간의 의식",
    ["O"] =
    "동부 역병지대나 여명의 설원에 있는 밴시에게서 6개의 유령 플라스마를 수집하여 가시덤불 골짜기 무법항에 있는 맥개번에게 가져가십시오.",
    ["D"] =
    "우리가 필요로 하는 이 유령 플라스마에 대해선 아는 게 없지만, 금속에 그걸 주입하는 방법은 알고 있어. 그러니 난 대장간을 준비할 테니 넌 플라스마를 가져와.\n\n브란의 노트를 보면 밴시의 영혼이 가장 효과가 좋을 거라고 하네. 여명의 설원 북쪽의 오랜 나이트 엘프 폐허에 밴시가 있을 거야. 아니면 한때 하이 엘프들이 살던 동부 역병지대에 있을지도 모르지? 어디서 구하든 녀석들의 플라스마를 가져오면 돼!",
  },
  [27999] = {
    ["T"] = "대장간의 의식",
    ["O"] = "맥개번이 사령의 금속을 만드는 과정을 관찰하십시오.",
    ["D"] =
    "좋아. 일반 무기와 방어구도, 유령 플라스마도 모였고, 용광로도 뜨거워. 연장과 실력은 내게 있지!\n\n뒤로 물러나는 게 좋을 거야, $N. 이게 얼마나 뜨거울지, 차가울지 전혀 알 수 없으니까.",
  },
  [28000] = {
    ["T"] = "불의 의식",
    ["O"] = "타나리스의 스팀휘들 항구에 있는 카렘과 대화하십시오.",
    ["D"] =
    "내 친구 카렘은 아제로스 최고의 주방장으로 널리 알려져 있지... 하지만 다음 요리 평론가가 그녀의 음식을 평가할 때 미슐룬 별점을 지키지 못한다면, 이자벨 픽맨에게 그 자리를 뺏길지도 몰라. 그래서 재능 있는 부주방장을 구한다고 나한테 연락을 했더라고. 마침 당신은 내 주방을 거쳐 간 최고의 요리사 중 하나지. 즉 당신이 전설적인 카렘과 함께 요리할 기회를 잡았다는 소리야!\n\n그녀는 스팀휘들 항구에 새 레스토랑을 열었어. 혹시 모른다면 그곳은 타나리스 남쪽에 있어.",
  },
  [28001] = {
    ["T"] = "불의 의식",
    ["O"] = "타나리스의 스팀휘들 항구에 있는 카렘이 요리 기술을 사용하여 10개의 단백질 셰이크를 요리해 달라고 합니다.",
    ["D"] =
    "부주방장이라고? 아! 내 메시지가 무사히 전해져서 다행이군.\n\n그래, 맞아. 위대한 카렘에게 부주방장이 필요해. 하지만 내 옛 친구인 이자벨 픽맨과 경쟁하려면 솜씨가 아주 좋아야 해.\n\n이자벨은 요리의 어두운 면에 물들어버렸지만, 그녀의 재능과... 독창성은 부인할 수 없지. 그녀의 시그니처 메뉴인 단백질 셰이크를 만들어 네가 내 주방에서 유용하다는 걸 증명해봐.\n\n아직 이걸 어떻게 만드는지 모른다면, 역병지대의 서부 역병지대 섬 카엘 다로우로 가서 그녀에게 먼저 배우고 와야 할걸.",
  },
  [28002] = {
    ["T"] = "불의 의식",
    ["O"] =
    "서부 역병지대에 있는 스칼로맨스에 들어가 이자벨 픽맨의 요리책을 찾아 타나리스의 스팀휘들 항구에 있는 카렘에게 가져가십시오.",
    ["D"] =
    "이자벨 픽맨은 이제 역병에 오염된 저 북쪽 스칼로맨스 아카데미인지 뭔지의 수석 요리사로 있어. 그 여자가 내가 개발한 수많은 요리법을 훔쳐 자기 것인 양 속이더니 그 엄청난 자리를 차지했지!\n\n뭐, 요리계에선 눈에는 눈, 이에는 이지. 그녀의 책을 훔쳐 와! 그녀에게 분명 요리책이 있을 거야. 거기로 가서 책을 빼앗아! 그녀가 무엇을 연구하는지 알아야 그걸 밟아버릴 메뉴를 내놓을 수 있잖아.",
  },
  [28003] = {
    ["T"] = "불의 의식",
    ["O"] = "타나리스 스팀휘들 항구에 있는 카렘을 위해 실리더스에 서식하는 벌레들에게서 10개의 부드러운 고기를 모으십시오.",
    ["D"] =
    "신성한 나무 맙소사! 이 책에 적힌 요리법들은 끔찍해! 거의 모든 요리에 인간 고기가 들어 있어... 역겨워라. 인간 고기는 퍽퍽하고 누린내가 난다고... 게다가 철도 아니잖아.\n\n하지만 봐, 여기 육지 고기와 바다 고기를 섞는 방법에 대한 노트가 있어. 우리도 이걸 응용할 수 있겠어. 바다는 바로 근처지만, 인간 고기와 흡사하면서도 그렇게 나쁘지는 않은 육지 고기를 어디서 구한담?\n\n생각났어! 저 남쪽 실리더스에 타나리스 벌레들의 더 거대한 변종들이 있어. 내가 현지 벌레들을 요리해 본 적이 있는데 맛이 비슷하거든. 더 거대한 벌레들은 스테이크로 쓸 수 있는 진짜 고기가 될 거야. 시장 가격이라도 좋으니 실리더스로 가서 그것들을 좀 가져다 줘.",
  },
  [28004] = {
    ["T"] = "불의 의식",
    ["O"] =
    "타나리스의 스팀휘들 항구에 있는 카렘이 요리 기술을 사용하여 랍스터 롤 10개, 스트라솔름 블랑 10개, 뱃사람의 물약 10개를 만들어 오라고 합니다.",
    ["D"] =
    "이 실리시드 스테이크로 육지는 처리했으니, 이젠 바다 차례야. 클래식한 메뉴로 가지 - 랍스터 롤. 만들어 본 적 있어? 해적들 사이에서 엄청 인기 있는 메뉴인데, 필요하면 요리법을 알려줄 수 있어.\n\n음료도 잊을 수 없지. 가벼운 입맛을 위해 뱃사람의 물약을 곁들이고, 고상한 미각을 위해서는 스트라솔름 블랑을 내자.\n\n그 요리법도 모른다고? 음, 뱃사람의 물약은 랍스터 롤과 같은 곳에서 구할 수 있고, 스트라솔름 블랑은 말할 것도 없이... 스트라솔름에서 나오겠지!",
  },
  [28005] = {
    ["T"] = "불의 의식",
    ["O"] = "타나리스의 동굴에 있는 잘라쉬지와 대화하십시오.",
    ["D"] =
    "바다와 그곳의 거주민들을 생각하면, 언젠가는 나가에 도달하게 돼. 나가들은 나의 아주 오랜 친척뻘이니까 당연히 나처럼 훌륭한 만찬 자리를 차려낼 줄 알겠지.\n\n해안을 따라 조금 내려가면 여기서 멀지 않은 곳에 추방당한 나가가 살고 있어. 그에게 가서 나가들이 테이블 세팅을 어떻게 하는지 물어봐 줘. 그들의 아이디어를 좀 빌릴 수 있지 않을까?",
  },
  [28006] = {
    ["T"] = "불의 의식",
    ["O"] =
    "아즈샤라의 레이븐크레스트 기념비 근처에 있는 나가를 처치하여 촛대, 냅킨, 테이블 매트, 식기류를 수집하고 타나리스 스팀휘들 항구의 카렘에게 가져가십시오.",
    ["D"] =
    "1만 년이 넘는 삶 동안 이런 이상한 요청은 들어본 적이 없지만, 인정하지, 꽤 재미있긴 하군. 우리는 문명화된 종족이므로 당연히 네가 찾는 물건을 가지고 있다.\n\n하지만 어떤 나가도 그들이 힘들게 쟁취한 식탁보를 쉽게 내놓지는 않을 거니 힘을 좀 써야 할 거다. 아즈샤라에 있는 레이븐크레스트 기념비로 가는 게 좋을 거야. 그자들은 우리 동족도 아닐뿐더러 너무 오랫동안 고립되어 지냈지. 당신이 나타나면 피가 끓어올라 난리가 날 거다. 문자 그대로 말이야.",
  },
  [28007] = {
    ["T"] = "불의 의식",
    ["O"] = "오그리마 골목길에 있는 잠자와 대화하여 당신의 성공을 알리십시오.",
    ["D"] =
    "이제 난 준비됐어. 요리 평론가들이 올 테지. 난 내 미슐룬 별점을 지킬 거고 이자벨은 무명 속에 계속 뒹굴게 될 거다.\n\n넌 이제 가도 좋아. 평론가들이 너를 내 성공의 열쇠로 착각하게 놔둘 순 없잖아! 너를 내게 보낸 친구 잠자도 어떻게 됐는지 궁금해할 테지.\n\n네가 내 인정을 받았다고 전해줘.",
  },
  [28008] = {
    ["T"] = "불의 의식",
    ["O"] = "아이언포지에 있는 엠룰 리크너선과 대화하여 성공을 보고하십시오.",
    ["D"] =
    "이제 난 준비됐어. 요리 평론가들이 올 테지. 난 내 미슐룬 별점을 지킬 거고 이자벨은 무명 속에 계속 뒹굴게 될 거다.\n\n넌 이제 가도 좋아. 평론가들이 너를 내 성공의 열쇠로 착각하게 놔둘 순 없잖아! 널 보낸 친구 엠룰도 진행 상황을 알고 싶어 하겠지.\n\n네가 내 지지를 얻었다고 전해도 좋아.",
  },
  [28009] = {
    ["T"] = "비전의 의식",
    ["O"] = "힐스브래드 구릉지 타렌 제분소에 있는 학자 워딘 보이드글레어와 대화하십시오.",
    ["D"] =
    "아, $N! 처음 이 일을 시작했을 때에 비하면 자네의 마법부여 실력이 정말 많이 늘었군. 깊이 감명받았네! 너무나 감명받은 나머지, 일거리 하나를 소개할까 하네만.\n\n학자 워딘 보이드글레어님이 대마법부여사를 찾아 언더시티로 전갈을 보내왔지. 난 도시를 떠날 생각이 추호도 없지만, 자네는 더... 모험을 즐기는 성격이니 말이야. 그렇다고 무모하다는 뜻은 아니니 오해는 말고!\n\n타렌 제분소로 박쥐를 타고 가면 바로 학자님께 도착할 거네. 그분이 무엇을 원하시는지 자못 궁금해지는군. 학자께서 도움을 요청하는 일은 극히 드물거든.",
  },
  [28010] = {
    ["T"] = "비전의 의식",
    ["O"] = "던홀드 요새 뒤편, 알터랙 산맥 기슭에 있는 라벤홀트 장원을 찾아 도착 후 펠리시티와 대화하십시오.",
    ["D"] =
    "거짓된 핑계로 당신을 이곳에 불렀소, $N. 제가 도움이 필요한 것이 아니라, 라벤홀트 장원이 필요로 하는 거요. 비록 라벤홀트 경은 인간이지만, 자신을 호드의 우방으로 자청해왔지.\n\n라벤홀트 경의 애완 마법사가 장원 쪽에서 혼자 감당할 수 없는 문제에 부딪혔다고, 마법부여사의 도움을 요청했소. 내겐 포세이큰의 비밀이 너무 많이 있어 직접 가기에는 위험이 따르지. 혹여나 이 일이 함정이라면 정말 끔찍한 일일 테니. 하지만 자네! 평범한 보병, 별반 대단치 않은 $C 병사일 뿐이니 말이네. 당신이 없어진다 한들 그리 아쉬워할 사람도 없을 거요.\n\n그러니 호드를 대표해 가주게나, $N. 그 장원에서 만나는 그 누구도 믿지 말게. 그곳은 온갖 비밀과 스파이, 그리고 고수로 가득 차 있지. 고수는 비누 맛이 난다네. 최악의 맛이지!",
  },
  [28011] = {
    ["T"] = "비전의 의식",
    ["O"] =
    "알터랙 산맥 라벤홀트 장원에 있는 펠리시티를 위해 검은바위 첨탑 하층의 방패부대 수행사제, 역술사, 흑마법사로부터 마력깃든 재 8개를 수집하십시오.",
    ["D"] =
    "단도직입적으로 말하죠, $N. 문제가 생겼습니다. 20년 전 키린 토의 마법사들이 스파이와 도적을 양성하는 로데론 얼라이언스의 훈련소인 라벤홀트 장원을 은폐하기 위해 장원에 불관찰의 문양을 새겼어요. 오래전에 효력을 잃은 계약의 산물인 그 문양이 지금은 점점 불안정해지고 있어서, 폭발하거나 황천으로 가는 포탈이 열리거나 다른 비전 사고가 나기 전에 제거해야만 해요.\n\n얼마 남지 않은 키린 토들과 논의한 결과, 검은바위 산에 있는 방패부대 오크들이 사용하는 물질인 마력깃든 재로 문양의 힘을 약화시킬 수 있다는 사실을 밝혀냈죠. 오직 마법부여사만이 이 재를 안전하게 다룰 수 있어요 -- 다른 이의 손에 들어가면 흔적도 없이 사라져 버리거든요.\n\n그래서... 당신의 도움을 기대해도 될까요?",
  },
  [28012] = {
    ["T"] = "비전의 의식",
    ["O"] =
    "알터랙 산맥 라벤홀트 장원에 있는 펠리시티가 당신의 마법부여 기술을 사용해 눈부신 큰 결정 4개, 상급 영원의 정수 6개, 환영 가루 20개를 가져다 달라고 합니다.",
    ["D"] =
    "마력깃든 재는 불관찰의 문양의 마력을 흡수하는 스펀지 역할을 할 거지만, 문양... 비누를 만들기 위해서는 다른 재료들도 수집해야 해요... 달리 마땅한 단어가 없네요. 더 정확히 말하자면, 이 재를 문양이 사용하는 마법의 종류에 맞추어 조정하려면 마법부여 재료가 다수 필요하죠.\n\n당신은 숙련된 마법부여사이니 눈부신 큰 결정, 상급 영원의 정수, 엄청난 양의 환영 가루를 모으는 게 그리 어려운 일은 아니겠죠.",
  },
  [28013] = {
    ["T"] = "비전의 의식",
    ["O"] =
    "악령숲 강철나무 숲의 나무정령에게서 강철나무 껍질 4개를 모으고, 저주받은 땅 펠스톤 농장의 흑마법사에게서 흑마법 문양 1개를 수집하여 알터랙 산맥 라벤홀트 장원에 있는 펠리시티에게 가져가십시오.",
    ["D"] =
    "이런 유형의 문양을 안전하게 흩어버리기 위해서는 마법 재료 이상의 무언가가 필요해요. 문양이 조율된 극성을 띠는 마법의 구성 요소를 사용해서 문양의 방향을 일치시켜야 하죠.\n\n이 문양은 저택이 알터랙 고원의 자연경관처럼 보이게 만들고 어둠의 의회의 마법을 막아내기 위해 고안되었어요. 그래서 악령숲에 자생하는 강철나무 껍질을 흙의 요소로 사용할 수 있죠 -- 이 나무는 어둠의 의회의 마법에 닿은 적이 있어서 군단을 뜻하는 흑마법 문양과 조화롭게 어울릴 거예요. 듣기로는 그 남은 군단 잔당들이 저주받은 땅에 요새를 재건하고 있다더군요. 거기 있는 흑마법사들에게서 흑마법 문양을 구할 수 있을 거예요.",
  },
  [28014] = {
    ["T"] = "비전의 의식",
    ["O"] = "실리더스의 황혼의망치단 신도에게서 황혼의 이교도 장갑 한 쌍을 구해 알터랙 산맥 라벤홀트 장원의 펠리시티에게 가져가십시오.",
    ["D"] =
    "아무리 마법부여 기술의 대가라 할지라도, 맨손으로 이 문양을 해제할 수는 없어요. 특별한 장갑이 필요하죠. 그렇지 않으면... 손의 피부가 몽땅 벗겨질 거예요, 제가 여기서 굳이 자세히 묘사하지 않아도 잘 아시겠죠.\n\n하지만 걱정 마세요, 이 작업에 꼭 맞는 장갑을 제가 찾아두었으니까요. 가서 구해 오기만 하면 돼요. 황혼의 이교도들한테서요. 실리더스에 있답니다. 지금 가기에 딱 좋은 계절이네요! 장갑을 구해 오시면 문양을 제거할 준비가 구십삼 퍼센트 완료될 거라고 거의 장담해요.",
  },
  [28015] = {
    ["T"] = "비전의 의식",
    ["O"] =
    "알터랙 산맥 라벤홀트 장원의 펠리시티가 마법부여 기술을 사용해 황혼의 이교도 장갑에 장갑 마법부여 - 하급 가속을 주문하고 자신에게 알려달라고 합니다.",
    ["D"] =
    "마지막이에요! 약속해요!\n\n그 장갑에 하급 가속 마법부여를 해주는 게 좋을 것 같아요. 문양을 제거하려면 당신의 손가락이 무척 재빨라야 하거든요. 당신의 실력을 믿어 의심치 않지만, 조금이라도 이점을 더 챙겨서 나쁠 건 없잖아요.",
  },
  [28016] = {
    ["T"] = "비전의 의식",
    ["O"] = "마법이 깃든 황혼의 이교도 장갑을 낀 채, 라벤홀트 장원의 지하로 내려가 불관찰의 문양을 제거하십시오.",
    ["D"] =
    "준비는 끝났어요. 바로 지금이에요. 마법이 깃든 황혼의 이교도 장갑을 끼고 내 오른편 계단으로 내려가세요. 바닥 한가운데 문양이 보일 겁니다. 당신이라면 이제 문제없이 제거할 수 있을 거예요!\n\n출발하세요! 장원을 불태우지 않을 거라고 믿어요!",
  },
  [28017] = {
    ["T"] = "비전의 의식",
    ["O"] = "알터랙 산맥 라벤홀트 장원에 있는 펠리시티에게 성공을 보고하십시오.",
    ["D"] =
    "문양이 제거되면서 라벤홀트 장원은 더 이상 비전 마법의 폭발 사고 위험에 처하지 않게 되었습니다.\n\n펠리시티가 당신의 성공에 몹시 기뻐할 것입니다.",
  },
  [28018] = {
    ["T"] = "비전의 의식",
    ["O"] = "엘윈 숲 아조라의 탑에 있는 키타 파이어윈드와 대화하십시오.",
    ["D"] =
    "아, $N! 처음 이 일을 시작했을 때에 비하면 자네의 마법부여 실력이 정말 많이 늘었군. 깊이 감명받았네! 너무나 감명받은 나머지, 일거리 하나를 소개할까 하네만.\n\n키타 파이어윈드님이 대마법부여사를 찾아 언더시티로 전갈을 보내왔지. 난 도시를 떠날 생각이 추호도 없지만, 자네는 더... 모험을 즐기는 성격이니 말이야. 그렇다고 무모하다는 뜻은 아니니 오해는 말고!\n\n수레를 타고 붉은마루 산맥으로 가면 키타가 작업 중인 아조라의 탑을 바로 지나게 될 거네. 그분이 무엇을 원하시는지 자못 궁금해지는군. 탑에서 외부의 도움을 요청하는 일은 극히 드물거든.",
  },
  [28019] = {
    ["T"] = "비전의 의식",
    ["O"] = "던홀드 요새 뒤편, 알터랙 산맥 기슭에 있는 라벤홀트 장원을 찾아 도착 후 펠리시티와 대화하십시오.",
    ["D"] =
    "난 아주 중요한 임무 때문에 당신을 불렀네, $N. 도움이 필요한 건 내가 아니라 라벤홀트 장원일세. 라벤홀트 영주가 온전한 얼라이언스 편은 아니지만, 여전히 우리의 오랜 벗이지.\n\n라벤홀트 경의 수양딸은 훌륭한 마법사지만, 마법부여사의 기술이 절실한 난관에 부딪혔다는군. 나는 테오크리투스를 위한 작업에 매달려 있어서 자네가 떠올랐지! 자네, 부디 시간 좀 내주지 않겠나?\n\n얼라이언스를 대표해 라벤홀트로 가 주게나, $N. 단, 그곳에서 발견하는 것들을 경계하게. 온갖 비밀, 첩자들, 그리고 고수가 난무하는 곳이니 말일세. 고수에서는 비누 맛이 나지. 아주 역겨운 놈들이야!",
  },
  [28020] = {
    ["T"] = "심연의 의식",
    ["O"] = "먼지진흙 습지대의 내트 페이글과 대화하십시오.",
    ["D"] =
    "물가에서 낚싯대를 쥐고 여유를 즐기는 것만큼 좋은 것도 없죠, 안 그래요 $N? 제 말에 동의하실 거라고 봅니다. 당신이야말로 제가 아는 가장 헌신적인 $g낚시꾼:낚시꾼;이니까요!\n\n아, 그러고 보니 얼마 전 내트 페이글한테 먼지진흙 습지대에서 함께 낚시하자는 초대장을 받았는데, 보아하니 자기랑 기술을 겨룰 뛰어난 낚시꾼을 찾고 있는 눈치더라고요. 당신이라면 어떤 낚시 대회든 무조건 참석해야죠. 먼지진흙 습지대로 가서 한번 확인해 보는 게 어때요?",
  },
  [28021] = {
    ["T"] = "심연의 의식",
    ["O"] = "먼지진흙 습지대에 있는 내트 페이글은 당신이 낚시 기술을 이용해 돌비늘뱀장어 20마리와 판금 갑옷물고기 10마리를 낚아 오길 바랍니다.",
    ["D"] =
    "요즘 좀이 쑤시네, $N. 내 기술을 한 단계 끌어올리고 싶었는데, 마침 자네가 와 줘서 반갑군. 어떻게 시작해야 할지 딱히 정하진 않았지만, 가볍게 우리끼리 시합이라도 한 번 해 볼까?\n\n돌비늘뱀장어랑 갑옷물고기를 나보다 더 많이 낚는 사람이 있을지 궁금하군. 자네 한번 내 기록에 도전해 보겠나?",
  },
  [28022] = {
    ["T"] = "심연의 의식",
    ["O"] = "아즈샤라 검은아귀 마을의 위플라와 대화하십시오.",
    ["D"] =
    "낚시광이시라면 예전에 검은아귀 마을에 가보셨겠죠. 아직 안 가보셨다면, 정말 안타까운 일입니다! 아즈샤라 북쪽 해안에 있는 펄볼그 마을인데, 그들은 낚시에 미쳐있거든요.\n\n아무튼 분위기를 띄울 새로운 루어가 필요할 것 같아요. 전 항상 검은아귀의 장인 정신에 감탄해 왔죠. 그 마을로 가서 루어 하나 구해주실 수 있나요?",
  },
  [28023] = {
    ["T"] = "심연의 의식",
    ["O"] =
    "검은아귀 마을의 위플라가 스내피쿠스 렉스라는 로브스트로크에게서 검은아귀 미끼를 되찾아 오라고 합니다. 미끼를 되찾으면 먼지진흙 습지대의 내트 페이글에게 전달하십시오.",
    ["D"] =
    "검은아귀 미끼 원한다? 그래, 우리 미끼 낚시에 아주 좋아. 근데 손으로 만든 미끼는 검은아귀에게 매우 소중해. 쉽게 주지 않아.\n\n위플라는 네가 그럴 자격이 있다면 검은아귀 미끼 가져갈 수 있다고 생각해. 위플라가 가장 좋아하던 미끼 크고 나쁜 로브스트로크가 가져갔어. 고블린들 그 로브스트로크 스내피쿠스 렉스라 불러. 걔 아즈샤라 온 동네 헤엄치며 다녀. 네가 스내피쿠스 찾아서 미끼 되찾아 오면, 너 가져도 돼.",
  },
  [28024] = {
    ["T"] = "심연의 의식",
    ["O"] =
    "동부 역병지대 스트라솔름 내부 베이베리 여관에서 존 킨케이드의 낚시 도구 상자를 찾아 먼지진흙 습지대의 내트 페이글에게 가져가십시오.",
    ["D"] =
    "스트라솔름 참사 때 목숨을 잃은 친구가 하나 있지. 존은 아주 좋은 녀석이었고 자네가 본 것 중 가장 놀라운 루어 컬렉션을 가지고 있었어. 가망이 없을진 몰라도 그 루어들이 아직 남아있을까 궁금하군.\n\n마을 북쪽에 존이 운영하던 베이베리 여관이 있었지. 마을의 절반이 불탔다고는 들었지만 존은 자신의 루어를 아주 튼튼한 태클 박스에 보관했거든. 어지간한 화재에는 끄떡없이 견뎠을 거야.\n\n물론 이 부탁이 너무 무리라는 건 이해해. 그 폐허는 필시 아직도 위험할 테니까.",
  },
  [28025] = {
    ["T"] = "심연의 의식",
    ["O"] = "내트 페이글이 당신의 낚시 기술을 이용해 날 용암 해골물고기 10마리를 낚아 먼지진흙 습지대로 가져오길 원합니다.",
    ["D"] =
    "이 태클 박스를 보니 옛 기억이 떠오르는군, 생각할 시간이 좀 필요해. 하지만 생각하는 동안 자네에게 한 가지 부탁을 하지.\n\n이 박스를 구했다는 건 불을 두려워하지 않는다는 걸 뜻하지. 용암 해골물고기는 바로 그 불 속에서 잡히는 녀석들이야. 그래 맞아-- 용암 낚시지.\n\n그 열기를 견딜 수 있는 낚싯대가 없다면, 더 좋은 장비를 구하기 위해 검은무쇠 드워프들과 함께 시간을 보내야 할 거네.",
  },
  [28026] = {
    ["T"] = "심연의 의식",
    ["O"] = "실리더스에 서식하는 생물들로부터 이국적인 실리시드 미끼 10개를 구한 다음 먼지진흙 습지대의 내트 페이글에게 가져가십시오.",
    ["D"] =
    "아, 그래. 미끼지!\n\n세상에서 가장 훌륭한 루어가 있다 한들 거기에 걸맞은 미끼가 없으면 아무 소용이 없어. 밤지렁이부터 불빛 벌레, 복잡한 기계 장치까지 별의별 걸 다 써봤지. 다 어느 정도는 효과가 있었지만, 더... 이국적인 게 필요한 것 같아. 아주 독특한 향을 풍기는 아주 머나먼 땅의 미끼 말일세. 참으로 특별한 미끼를 쓴다면 뭘 낚을 수 있을지 누가 알겠어. 짚이는 곳이라도 있나?",
  },
  [28027] = {
    ["T"] = "심연의 의식",
    ["O"] = "이국적인 실리시드 미끼로 내트 페이글과 함께 낚시를 하여 무엇을 낚을지 확인하십시오!",
    ["D"] =
    "음, 빨리 이 미끼를 써보고 싶어 못 참겠군. 자, 미끼를 루어에 달아둘 테니 준비되면 말해 주게나. 무엇이 잡힐지 그 누가 알겠나?",
  },
  [28028] = {
    ["T"] = "들판의 의식",
    ["O"] = "달숲 나이트헤이븐의 덴드리트 스타블레이즈와 대화하십시오.",
    ["D"] =
    "음, 약초채집 기술을 아주 훌륭하게 연마하셨군요, 안 그런가요? 당신 같은 재능을 가진 분이 방문하는 건 흔치 않은 일이죠.\n\n사실 부탁드리고 싶은 일이 있습니다. 달숲에 식물의 타락에 대한 영향을 연구하는 제 친구가 있습니다. 그는 악령숲과 역병지대를 오가는 데 지쳐, 일손을 도울 조수를 구하고 있습니다. 관심이 있으시다면 나이트헤이븐으로 가서 덴드리트 스타블레이즈와 대화해보세요.\n\n달숲에 한 번도 가본 적이 없다면, 악령숲에 있는 나무구렁 펄볼그 영토를 지나가야 합니다. 펄볼그들은 낯선 자들을 환영하지 않지만, 당신이라면 통과할 방법을 찾을 수 있을 거라 확신합니다.",
  },
  [28029] = {
    ["T"] = "들판의 의식",
    ["O"] =
    "덴드리트 스타블레이즈는 당신의 약초채집 숙련도를 사용하여 은초롱이 20개와 얼음송이 20개를 수집해 달숲의 나이트헤이븐에 있는 그에게 가져오길 원합니다.",
    ["D"] =
    "내 연구를 돕는 데 관심이 있다고? 훌륭하군. 내겐 해야 할 일이 아주 많지만 그 일을 모두 끝마칠 만큼 시간이 넉넉하진 않다네.\n\n자네의 의지는 고맙게 생각하지만, 먼저 자네의 기술을 확인해야겠네. 약초채집 능력을 발휘해 은초롱이와 얼음송이를 구해 오게나. 그걸 가져오면 앞으로 맡길 일들에 필요한 재능이 있는지 내 알 수 있을 테니.",
  },
  [28030] = {
    ["T"] = "들판의 의식",
    ["O"] =
    "동부 내륙지에 있는 진타알로로 여행하여 썩은가지 약초채집사에게서 썩은 낫을 획득하십시오. 이를 달숲의 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 가져오십시오.",
    ["D"] =
    "내가 연구하려는 표본을 수확하려면 이를 채집할 특수한 도구가 필요해. 줄구룹의 구루바시 트롤들이 위험한 식물들을 채집할 때 쓰는 특수 낫이 있다고 들었지만, 줄구룹은 지금 닫혀 있으니 그 다음으로 괜찮은 방법을 찾아보자구.\n\n진타알로의 썩은가지 트롤들 중 뛰어난 약초채집사들이 있다고 해. 구루바시의 사촌 뻘이니, 그 약초채집사들이라면 비슷한 도구를 지니고 있지 않을까?",
  },
  [28031] = {
    ["T"] = "들판의 의식",
    ["O"] =
    "실리더스 내의 군락과 동굴에서 진균초 10개를 채집하여 썩은 낫을 시험한 후, 달숲의 나이트헤이븐에 있는 덴드리트 스타블레이즈에게 가져가십시오.",
    ["D"] =
    "이제 썩은 낫을 얻었으니 이 낫으로 오염된 식물들을 시험해 봐야 해. 당신을 마지막 목적지로 보내기 전에 낫의 효과를 확실히 해두고 싶거든.\n\n저 남쪽 실리더스라는 지역엔 세나리온 의회가 지원하는 연구 탐험대가 있네. 그들은 그 지역의 동굴과 군락에서 자라나는 기이하게 변이된 버섯을 발견했다고 보고했지. 이 썩은 낫을 가져가서 그 균류를 채집해 주게. 탐험대는 그것을 진균초라 이름 지었지. 오염을 퍼뜨리지 않고 진균초를 안전하게 채집할 수 있는지 이 낫을 시험해 보게.",
  },
  [28032] = {
    ["T"] = "들판의 의식",
    ["O"] =
    "덴드리트 스타블레이즈가 당신이 약초채집 기술을 이용해 야생덩굴 20개, 실명초 20개, 검은 연꽃 1개를 채집한 다음 달숲의 나이트헤이븐에 있는 자신에게 가져오라고 합니다.",
    ["D"] =
    "자네를 아무 준비도 없이 사지로 몰아넣어선 안 되겠지. 그러니 마지막으로 한 가지 준비를 더 하세. 만일의 사태에 대비해 효과가 좋은 해독제를 만들어 두는 것이네.\n\n나이트헤이븐에는 필요한 재료가 거의 다 갖추어져 있지만, 이것을 달이려면 시간이 좀 걸리지. 이제 혼합물을 완성하기 위해 야생덩굴, 실명초, 검은 연꽃이 좀 필요하네. 뛰어난 약초채집사이니 그 정도 재료를 구하는 건 일도 아니겠지, 안 그런가?",
  },
  [28033] = {
    ["T"] = "들판의 의식",
    ["O"] = "서부 역병지대 스칼로맨스로 가서 달숲 나이트헤이븐의 덴드리트 스타블레이즈에게 가져갈 역병지대 파리지옥의 견본을 수집하십시오.",
    ["D"] =
    "해독제를 달이는 동안, 우리의 최종 목적을 밝히겠네.\n\n저주받은 자들의 교단이 서부 역병지대에서 끔찍한 일들을 꾸미고 있다네. 난 오랫동안 역병지대에서 그 토양을 연구했지. 치유할 수는 있지만, 저주받은 자들의 교단 놈들이 스칼로맨스 연구소에서 오염된 식물들을 계속 내보내는 한 그 땅은 결코 회복되지 못할 거야.\n\n그 오염된 식물들이 어떻게 뿌리를 내리고 퍼져나가는지를 알아내기 위해, 그 식물들의 견본이 절실히 필요하다네. 스칼로맨스로 침투하여 그 견본을 가져오고 단숨에 교단의 식물들을 제거해주게!",
  },
  [28034] = {
    ["T"] = "사냥의 의식",
    ["O"] = "불모의 땅 통곡의 동굴 근처 피즈너클의 야영지에서 피즈너클과 대화하십시오.",
    ["D"] =
    "만나서 반갑군, $N. 자네처럼 실력 좋은 가죽세공인을 찾고 있다는 전언을 가져왔네.\n\n피즈너클이라는 고블린이 불모의 땅 서쪽 통곡의 동굴 근처 야영지에서 외딴 상점을 운영하고 있지. 수수료를 받고 일할 능력 있는 가죽세공인을 찾고 있다더군. 자네가 관심이 있을지는 모르겠지만 일단 메시지를 전달해 두겠네.",
  },
  [28035] = {
    ["T"] = "사냥의 의식",
    ["O"] =
    "피즈너클이 당신의 가죽세공 기술을 이용해 정제된 깊은바다 소금 5개와 튼튼한 방어구 키트 20개를 제작한 후, 불모의 땅 서쪽 통곡의 동굴 근처 자신의 야영지로 가져오기를 원합니다.",
    ["D"] =
    "최고급 가죽 제품 공급업자로서, 나는 언제나 독특한 기술을 가진 공급자를 찾고 있지. 내 상점이 이렇게 먼 곳에 있으니 말이야... 뭐, 내가 더 이상 마을에서 환영받지 못하기 때문이기도 하지만... 이런저런 이유들 때문에 말이지.\n\n네가 와줘서 다행이군, $N. 최근 떠오르는 장인으로 네 이름이 자주 들리더군. 네가 내가 찾던 그 기술을 가졌는지 확인하고 싶은데, 정제된 깊은바다 소금 약간과 튼튼한 방어구 키트를 잔뜩 만들어 주지 않겠어?\n\n소금을 어떻게 만드는지 잘 모르겠다면, 글쎄, 기계공학자의 도움을 좀 받아야 할 거야.",
  },
  [28036] = {
    ["T"] = "사냥의 의식",
    ["O"] = "피즈너클이 가죽세공 기술을 사용하여 야생의 가죽 망토 4개를 만들어 악령숲의 에메랄드 성소에 있는 아이비 리프러너에게 전달해주기를 원합니다.",
    ["D"] =
    "네 실력을 확인했으니 첫 번째 계약을 주지.\n\n야생의 가죽 망토 만드는 법은 알겠지? 악령숲에 사는 별난 고객 하나가 그걸 4개나 원하더라고. 왜 4개나 필요한지는 나도 모르고 묻지도 않았어! 하지만 네게 그 망토들을 만들어 에메랄드 성소에 배달해 달라고 부탁하마.\n\n망토 만드는 법을 모른다면 페더문 요새의 프랫 맥그루벤이나 모자케 야영지의 장도르 스위프트스트라이더를 찾아봐. 아직 페랄라스에 한 번도 안 가봤다면 말이야, 둘 다 거기 있거든.",
  },
  [28037] = {
    ["T"] = "사냥의 의식",
    ["O"] = "악령숲의 에메랄드 성소에 있는 아이비 리프러너를 위해 여명의 설원의 눈사태 펄볼그에게서 눈사태 가죽 제품 6개를 수집하십시오.",
    ["D"] =
    "전 독특한 가죽 제품 수집가랍니다, $N. 역사나 제 동족에게 의미가 있는 물건일 땐 특히나 더요.\n\n칼도레이는 여명의 설원 펄볼그 부족과 우호적인 관계를 유지해 왔지만, 전쟁 후 펄볼그들은 타락의 길을 걸었습니다. 그들은 한때 명성 높았던 아름다운 가죽 공예품을 더 이상 만들지 않으며, 가지고 있던 것들도 심하게 망가졌죠.\n\n미래 언젠가 우리가 이 타락한 땅을 정화했을 때, 펄볼그들이 다시 따라 할 수 있는 본보기로 그 제품들을 일부 보존하고 싶습니다. 숙련된 가죽세공인이라면 뭘 찾아야 할지 잘 아실 겁니다. 저를 위해 대여섯 개 정도 구해다 주시겠어요?",
  },
  [28038] = {
    ["T"] = "사냥의 의식",
    ["O"] = "악령숲 에메랄드 성소의 아이비 리프러너를 위해 검은바위 첨탑 상층에 있는 성난발톱용혈족으로부터 용가죽 북 4개를 수집하십시오.",
    ["D"] =
    "수천 년 전, 검은용군단은 지도자 넬타리온과 함께 타락하기 전까지만 해도 건축가, 장인, 그리고 직조꾼들이었습니다. 그 시절과 그 뒤를 따르던 절망에 대해 생각한 지도 꽤 오래되었군요.\n\n동부 왕국에서 들어온 보고에 따르면 검은용군단은 검은바위 산 근처에 남은 구 호드 잔당과 동맹을 맺었다고 합니다. 그들이 여전히 가죽세공 기술을 사용하는지 알고 싶습니다. 만약 그렇다면 샘플을 몇 개 구하고 싶습니다. 그곳으로 가서 저를 위해 조사해주실 수 있겠습니까?",
  },
  [28039] = {
    ["T"] = "사냥의 의식",
    ["O"] = "불모의 땅에 있는 통곡의 동굴 서쪽 피즈너클의 야영지에서 피즈너클과 대화하십시오.",
    ["D"] =
    "아... 깜빡할 뻔했군요! 잠시 옛 기억에 너무 빠져 있었나 봅니다. 당신이 일하는 고블린이 메시지를 남겼어요. 당신이 되도록 빨리 야영지로 돌아오길 바란다더군요. \"오래전 잃어버린 가죽세공 도면\" 어쩌고 했는데 꽤 구미 당기는 말이더군요. 무얼 찾게 될지 꼭 말해주세요!",
  },
  [28040] = {
    ["T"] = "사냥의 의식",
    ["O"] = "불모의 땅의 피즈너클을 위해 실리더스의 남풍 마을에서 고통받는 드루이드들에게서 고대 도면의 조각 5개를 모으십시오.",
    ["D"] =
    "아주 따끈따끈한 소식이야, 저 머나먼 남쪽 사막을 탐험하던 멍청이들에게서 갓 들어온 보고서지. 보아하니 나이트 엘프 유령들로 가득 찬 마을을 발견했는데, 그중 일부가 고대 가죽세공 도면의 조각을 가지고 있다는 거야! 골동품에 얼마나 바가지를 씌울 수 있을지 상상해 봐!\n\n그러니 다른 녀석이 이 기회를 채가기 전에 당장 실리더스인가 하는 곳으로 직접 가봐. 그래, 넌 가죽세공인이지만 동시에 $C이기도 하잖아 -- 네 실력을 발휘할 때야.",
  },
  [28041] = {
    ["T"] = "비늘 제작자",
    ["O"] =
    "카라나가 전 세계에서 다양한 비늘을 모아 오라고 합니다. 당신은 전문가로서 검은 용비늘 5개, 두꺼운 전갈 비늘 5개, 무거운 바실리스크 비늘 5개, 거북이 비늘 5개가 적합할 것이라 판단했습니다. 이 비늘들을 모아 슬픔의 늪에 있는 피난처의 카라나에게 가져가십시오.",
    ["D"] =
    "아칼 헥타, 방랑자여. 보아하니 가죽세공인 같은데, 맞소? 그렇다면 우리 서로 이익이 될 만한 거래를 할 수 있겠군. 드레노어--지금은 아웃랜드로 불리는 곳에서 난 다양한 생물들로 아름다운 비늘 쇄자갑을 만들곤 했지. 대부분은 이제 존재하지 않겠지만. 하지만 이 세상엔 내가 가공할 만한 새로운 비늘이 넘쳐나더군.\n\n이 세상의 다양한 비늘을 내게 가져와 주길 원하오. 무리한 부탁인 줄은 알지만, 그 대가로 내 소중한 도안 중 하나를 주겠소.",
  },
  [28042] = {
    ["T"] = "산맥의 의식",
    ["O"] = "저주받은 땅에 있는 카에르나 시버스톤과 대화하십시오.",
    ["D"] =
    "$N! 방금 내 친구에게서 시급한 메시지를 받았네. 대지의 소리에 각별한 관심을 가지는 주술사지. 자네 숙련된 광부 맞지? 그 친구가 딱 자네 같은 사람이랑 상의할 일이 있다네.\n\n기꺼이 도와주겠다면 저주받은 땅 네더가드 요새의 카에르나 시버스톤을 찾아가 보게.",
  },
  [28043] = {
    ["T"] = "산맥의 의식",
    ["O"] = "저주받은 땅 네더가드 요새에 있는 카에르나 시버스톤을 위해 저주받은 땅 단층선에서 이글거리는 광석을 캐십시오.",
    ["D"] =
    "대지의 고통 때문에 광부의 도움을 청하는 게 좀 이상하게 들리겠지. 종종 우리 주술사들은 광업이 그 고통의 원인 중 하나라고 생각하니까. 하지만 이번엔 자네의 그 훌륭한 광업 기술이 꼭 필요할 거란 예감이 드는군.\n\n저주받은 땅에 있는 바위가 울부짖는 소리가 들려. 무언가 고대의 존재가 깊은 곳을 휘저어 놓고 있지. 땅의 틈새로 무언가 스며 나오기 시작했어. 저주받은 땅으로 가서 땅속에서 무엇이 솟구쳐 올랐는지 확인해 주게.",
  },
  [28044] = {
    ["T"] = "산맥의 의식",
    ["O"] = "저주받은 땅 네더가드 요새에 있는 카에르나 시버스톤에게 아케이나이트 수정 1개, 아제로스 다이아몬드 1개, 거대한 오팔 1개, 검은무쇠 주괴 10개를 가져가십시오.",
    ["D"] =
    "내가 말했듯, 이 광석은 지금까지 본 것과는 다르지만 검은바위 산 깊은 곳에서 발견되는 검은무쇠와 일부 유사한 점이 있소. 더 중요한 건 산을 따라 흐르는 용암이오. 그 용암에도 어두운 기운이 깃들어 있지. 샘플을 채취해 비교해 보고 싶지만, 먼저 그것을 담을 만한 도가니를 만들어야 하오.\n\n그 도가니를 만들기 위해선 당신만이 구할 수 있는 재료가 필요하오: 집중점 역할을 할 아케이나이트 수정, 내부를 감쌀 아제로스 다이아몬드와 거대한 오팔, 그리고 틀을 짤 검은무쇠 주괴가 필요하오.",
  },
  [28045] = {
    ["T"] = "산맥의 의식",
    ["O"] =
    "검은바위 산의 검은바위 나락에 들어가 검은무쇠 도가니를 사용해 검은 제련소 근처의 용암 샘플을 채취하십시오. 그런 다음 저주받은 땅 네더가드 요새의 카에르나 시버스톤에게 가져가십시오.",
    ["D"] =
    "이제 검은바위 산의 용암 샘플을 채취할 준비가 되었소. 검은무쇠 드워프들이 산의 심장부 근처에 자신들만의 대장간, 즉 검은 제련소를 보유하고 있다고 들었소. 제련소에 가까운 곳에서 샘플을 구할수록 더 좋소.\n\n그리고 조심하시오, $N. 요즘 어둠괴철로 도시는 배신자, 불한당, 도둑, 이교도들로 들끓는다고 하더군.",
  },
  [28046] = {
    ["T"] = "산맥의 의식",
    ["O"] = "운고로 분화구에서 얄루니 파이어와처를 찾으십시오.",
    ["D"] =
    "이 샘플을 모아준 당신의 수고에 감사하오만, 대지의 고통의 근원에 대한 의문은 여전히 풀리지 않았소. 다른 의견을 구해야겠소.\n\n운고로 분화구로 연구 원정을 떠난 동료가 한 명 있소. 얄루니가 지금 정확히 어디 있는지는 모르겠지만, 이 샘플을 평가하는 데는 내가 아는 사람 중 그가 최고라오.\n\n부탁하오, 이 이글거리는 광석을 가지고 그를 찾아가 주시오.",
  },
  [28047] = {
    ["T"] = "산맥의 의식",
    ["O"] = "운고로 분화구 마샬의 야영지에 있는 얄루니 플레임와처를 위해 실리더스에서 웅윙거리는 광석 10개를 채굴하십시오.",
    ["D"] =
    "칼림도어의 이 지역을 모험한 탐험대는 마샬 탐험대뿐만이 아니오. 여기서부터 실리더스라는 사막으로 계속 전진한 세나리온 의회의 일행이 있었지. 그들에게서 온 소식은 드물고 간헐적이었지만, 한 메시지에서 화난 망자들의 영혼과 웅웅거리는 벌레 군락으로 가득한 땅을 언급했소.\n\n저주받은 땅에서 그렇게 멀리 떨어진 그곳에서도 대지가 이와 같은 분노를 드러내는지 알고 싶소. 그쪽에서 무언가 기운이 뿜어져 나오는 게 느껴지지만 나는 대지보다는 불에 훨씬 더 강하게 연결되어 있지. 만약 당신이 실리더스에서 샘플을 몇 개 가져와 준다면 내가 더 많은 걸 알아낼 수 있을 텐데.",
  },
  [28048] = {
    ["T"] = "산맥의 의식",
    ["O"] =
    "운고로 분화구 마샬의 야영지에 있는 얄루니 플레임와처는 당신이 저주받은 땅 네더가드 요새에 있는 카에르나 시버스톤에게 웅윙거리는 광석 샘플을 가져가 주길 원합니다.",
    ["D"] =
    "카에르나가 직접 비교해 볼 수 있도록 이 샘플을 그녀에게 돌려주어야 하오. 대지와 맺은 그녀의 결속은 내 것보다 훨씬 깊으니.\n\n이 미스터리를 내게 가져와 주어 고맙소, $N. 대지고리회는 앞으로 우리가 취해야 할 행동이 무엇인지, 만약 있다면 말이지, 논의할 것이오.",
  },
  [28049] = {
    ["T"] = "야생의 의식",
    ["O"] = "가시덤불 골짜기 네싱워리 원정대의 헤멧 네싱워리와 대화하십시오.",
    ["D"] =
    "그 소식 들었어, $N? 전설적인 사냥꾼 헤멧 네싱워리가 사냥 전리품을 다듬어줄 엘리트 무두장이를 찾고 있대!\n\n네 이력서에 남길 엄청난 기회잖아! 관심 있으면 가시덤불 골짜기에 있는 네싱워리의 야영지로 직접 가서 지원해 봐.",
  },
  [28050] = {
    ["T"] = "야생의 의식",
    ["O"] =
    "검은 용비늘, 푸른 용비늘, 녹색 용비늘, 붉은 용비늘을 각각 1개씩 가시덤불 골짜기 네싱워리 원정대에 있는 헤멧 네싱워리에게 가져가십시오.",
    ["D"] =
    "아무 무두장이한테나 이 일을 맡길 순 없네, $N. 그래서 자네의 능력을 증명할 증표가 좀 필요해.\n\n나는 아제로스에서 가장 위험한 야수들을 사냥해 왔고, 그중 가장 교활한 건 단연 용들이지. 용을 직접 사냥할 필요는 없지만, 용 몇 마리 가죽을 벗기고 네가 무두장이 칼을 제대로 다룰 줄 안다는 증거로 그 용비늘들을 가져와야 해. 검은색, 푸른색, 녹색, 붉은색 용들에게서 각각 하나씩 가져오면 좋겠군.",
  },
  [28051] = {
    ["T"] = "야생의 의식",
    ["O"] =
    "헤멧 네싱워리는 당신이 무두질 기술을 사용해 여명의 설원에 있는 눈호랑이에게서 두꺼운 눈호랑이 가죽 6개를 모아 가시덤불 골짜기 그의 야영지로 가져오기를 원합니다.",
    ["D"] =
    "몇 가지 최고급 야수 가죽을 구매하려 하면서 자신의 신분을 숨기고 싶어 하는 고객이 있어. 신분이 드러나면 경쟁이 생길까 봐 걱정하는 것 같군.\n\n고객이 처음으로 요구한 물건은 여명의 설원에서 나는 최고급 눈호랑이 가죽이야. 아무 가죽이나 가져와선 안 돼. 이 고객은 가장 두껍고 따뜻한 가죽만을 원하거든. 이거 할 수 있겠어? 목록 중에선 이게 제일 쉬운 건데 말이야.",
  },
  [28052] = {
    ["T"] = "야생의 의식",
    ["O"] = "헤멧 네싱워리가 무두질 기술을 사용해 실리더스의 오물벌레에게서 오물벌레 가죽 6개를 모아 가시덤불 골짜기 자신의 야영지로 가져오기를 원합니다.",
    ["D"] =
    "이번 임무는 자네가 조금 부러워지려 하는군. 머나먼 서쪽에 실리더스라는 새롭게 발견된 땅이 있지. 들리는 바에 의하면 우리 고객이 그곳 생물들로부터 얻을 수 있는 희귀한 가죽에 대한 정보를 입수했다는군. 녀석들은 \"벌레 같은\" 형태를 띤다고 해.\n\n나도 직접 가보고 싶을 만큼 구미가 당기지만, 다른 곳으로 떠나기 전에 골짜기에서 마쳐야 할 일이 남아서 말이야. 게다가 실리더스는 극도로 위험한 곳이라더군. 뭐, 가끔씩 스스로를 한계로 밀어붙이지 않는다면 그게 사냥꾼이겠어?",
  },
  [28053] = {
    ["T"] = "야생의 의식",
    ["O"] = "헤멧 네싱워리가 당신의 무두질 기술을 이용해 검은바위 첨탑 하층에서 할리콘의 가죽을 모아 가시덤불 골짜기 야영지로 가져오기를 원합니다.",
    ["D"] =
    "이 고객이 대체 어디서 이런 정보를 얻어오는지 모르겠지만, 검은바위 첨탑의 오크들이 늑대 기수들을 태울 엄청나게 큰 늑대들을 사육하고 있다는군. 그리고 그 고객은 그 늑대의 가죽을 원해. 더 정확히 말하자면 할리콘이라는 늑대의 가죽이지.\n\n자네가 어떻게 검은바위 첨탑에 침투해서 이 늑대를 찾아 가죽을 벗겨 올진 모르겠지만, 만약 해낸다면 우리 둘 다에게 아주 짭짤한 보상이 돌아올 거네.",
  },
  [28054] = {
    ["T"] = "야생의 의식",
    ["O"] = "가죽 꾸러미를 가시덤불 골짜기 무법항에 있는 남작 레빌가즈에게 배달하십시오.",
    ["D"] =
    "네가 자리를 비운 동안 고객에게 연락해서 네가 얼마나 일을 잘했는지 말해줬어. 음, 그가 널 직접 만나서 고맙다는 인사를 전하고 싶다더군.\n\n짐작했겠지만 그는 고블린이야. 바로 남쪽의 무법항에 머물고 있지. 남작 레빌가즈라는 이름을 쓴다네. 내 생각에 그는 스팀휘들 무역회사의 거물인 것 같아. 무법항으로 가는 길에 네가 모은 이 가죽들도 배달해 주는 게 좋겠어.",
  },
  [28055] = {
    ["T"] = "베틀의 의식",
    ["O"] = "타나리스의 스팀휘들 항구에 있는 거만한 의류상과 대화하십시오.",
    ["D"] =
    "아, $N! 때마침 잘 와주었군요. 최근 아제로스 최고의 디자이너 중 한 명인 거만한 의류상이 숙련된 재봉술 조수를 찾고 있다는 소식을 들었어요. 당신의 솜씨를 본 적이 있어서, 이 소식에 흥미를 느낄 거라 생각했어요.\n\n의류상님은 지금 타나리스 아래의 스팀휘들 항구에 자리 잡고 있으니, 관심 있다면 한번 가보세요.",
  },
  [28056] = {
    ["T"] = "베틀의 의식",
    ["O"] = "거만한 의류상이 당신의 재봉 기술을 이용해 룬무늬 가방 4개를 제작하여 타나리스 스팀휘들 항구로 가져오길 원합니다.",
    ["D"] =
    "네가 그 조수야? 뭐, 아쉬운 사람이 찬밥 더운밥 가릴 처지는 아니지.\n\n도움이 필요하다고 인정하기는 싫지만, 상황이 그래. 상점을 열려고 붉은해적단한테서 자본을 좀 빌렸는데, 내 수익보다 빚 갚을 날이 더 빨리 다가오고 있단 말이지. 패션계의 최첨단을 유지하려면 수익을 계속 쏟아부어야 해 -- 네가 필요한 이유가 바로 그거고.\n\n내 일을 무료로 도와준다면, 네 이력서에 그 전설적인 거만한 의류상과 일했다고 쓸 수 있게 해줄게! 우선 이 룬무늬 가방 주문부터 처리해 봐.",
  },
  [28057] = {
    ["T"] = "베틀의 의식",
    ["O"] =
    "타나리스 스팀휘들 항구에 있는 거만한 의류상을 위해 역병지대의 거미들로부터 강철그물 거미줄 5개와 괴저 거미줄 5개를 수집하십시오.",
    ["D"] =
    "그건 쉬운 주문이었지! 다음으로 처리해야 할 주문은 거미에 미친 트롤들을 위한 거야. 자기들 옷에 거미줄을 넣어 달라는데 재고가 다 떨어졌어. 역병지대로 가서 거미줄 좀 더 구해오는 게 어때? 거기 거미들은 아주 거대해서 질 좋은 거미줄이 나온다더라고. 나는 아주 튼튼하면서도 특이한 거미줄이 필요해. 할 수 있겠어?",
  },
  [28058] = {
    ["T"] = "베틀의 의식",
    ["O"] = "톨 바라드 섬에 있는 바라딘 요새로 들어가 글라구트를 처치한 후, 타나리스 스팀휘들 항구의 거만한 의류상에게 돌아가십시오.",
    ["D"] =
    "그래서, 이 거래에는... 너의 도움과 $C로서의 능력이 필요할 거야.\n\n붉은해적단이 골칫거리 하나만 해결해 주면 내 빚의 절반을 탕감해 주겠다고 했어. 그 골칫거리가 뭐냐고? 다른 함대에 붙으려고 붉은해적단을 배신한 글라구트라는 변절자 오우거지. 해적들은 배신자에게 자비를 베풀지 않는 모양이야, 그렇지?\n\n어쨌든, 글라구트의 새 함대는 아라시 고원 앞바다의 톨 바라드 섬 주위를 항해하고 있다는군. 이런 모험적인 일은 내 전문이 아니니, 네게 맡길게.",
  },
  [28059] = {
    ["T"] = "베틀의 의식",
    ["O"] = "거만한 의류상이 재봉 기술을 이용해 영혼의 주머니 2개와 달빛옷감 2개를 제작해 타나리스의 스팀휘들 항구로 가져오기를 원합니다.",
    ["D"] =
    "이 다음 주문을 넣은 커플은 정말 귀여웠어! 완전히 반대되는 매력이었지... 나이트 엘프는 딱 봐도 사제였고, 달빛옷감을 원했어. 하지만 그의 여자친구는? 영락없는 흑마법사 스타일이었지. 영혼의 주머니를 두 개나 주문하더라고.\n\n이 일은 네게 맡길게. 나도 빚에서 거의 자유로워졌고 네가 끝까지 이 일을 마무리해 준다면, 네가 나를 도와주었다고 분명히 다른 사람들에게 말할 테니까.",
  },
  [28060] = {
    ["T"] = "베틀의 의식",
    ["O"] = "타나리스의 스팀휘들 항구에 있는 거만한 의류상을 위해 실리더스의 황혼의 이교도에게서 일렁이는 어둠의 옷감 8개를 전리품으로 획득하십시오.",
    ["D"] =
    "난 실리더스 사막이 정확히 어딘지는 몰라. 붉은해적단 말로는 타나리스에서 서쪽으로 아주, 아주 멀리 가면 있다고 하더군. 듣자 하니 해적들이 그곳에 사는 어떤 이교도 무리와 원한 관계인 모양이야. 비밀의 바다에서 야생의 심연 정령들을 소환해 배를 통째로 삼켰다나 뭐라나... 패션 이야기가 아니면 난 금방 흥미를 잃곤 하거든.\n\n내 흥미를 끈 건, 그 이교도들이 자신들만의 옷감을 직접 짠다는 사실이야. 붉은해적단 놈들은 그걸 '일렁이는 어둠의 옷감'이라고 불렀어. 해적들은 자신들의 원한을 풀기 위해 내가 이교도를 처치해 주길 원하고, 난 이 옷감이 탐나. 그러니 네가 일렁이는 어둠의 옷감 8장을 얻을 때까지 이교도들을 없애버리면, 내 빚을 완전히 청산할 수 있을 거야!",
  },
  [28061] = {
    ["T"] = "베틀의 의식",
    ["O"] = "거만한 의류상이 당신의 재봉 기술을 이용해 제독의 모자를 제작하여 타나리스의 스팀휘들 항구로 가져오기를 원합니다.",
    ["D"] =
    "그러니까... 붉은해적단이 내가 아주 작은 일 하나만 더 해주면 빚을 완전히 갚은 것으로 쳐주겠대. 그 일이란, 그들 우두머리 녀석을 위해 제독의 모자를 만들어 주는 거야.\n\n문제는 내가 이 모자가 대체 어떻게 생긴 건지 전혀 모른다는 거지! 가시덤불 골짜기에 사는 해적 재봉사가 도면을 판다는데 난 동부 왕국엔 한 번도 가본 적이 없고... 야생 정령이 배를 집어삼킨단 얘기를 듣고 나니 배는 절대 안 탈 거거든.\n\n그러니까 이건 네게 달렸어, $N. 나에게 이 제독의 모자를 만들어 줘. 그럼 난 자유로워질 거고, 넌 조금 더 유명해지겠지.",
  },
  [28062] = {
    ["T"] = "그렘록 필스노르의 의뢰",
    ["O"] = "그렘록 필스노르가 당신의 요리 기술을 사용해 양념 늑대 구이 10개를 만들고 던 모로 카라노스에 있는 자신에게 배달해 주길 원합니다.",
    ["D"] =
    "안녕하신가, $N! 든든한 식사와 에일 한 잔 하러 여관에 오셨나? 아, 안타깝게도 나쁜 소식이 있네 -- 오늘의 특별 메뉴인 양념 늑대 구이가 다 떨어졌거든.\n\n듣자 하니 요리 좀 하신다지? 만약 날 도와 오늘의 특별 메뉴를 요리해 준다면 자네 몸무게만큼의 날고기를 주지! 어떤가, 해보겠나?",

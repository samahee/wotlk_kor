  [28515] = {
    ["T"] = "덴니카의 의뢰",
    ["O"] =
    "덴니카는 당신의 낚시 숙련도를 사용해 불지느러미통돔 20마리를 모아 돌발톱 산맥의 말라카진에 있는 덴니카에게 배달하길 원합니다.",
    ["D"] =
    "고기는 넉넉해 -- 멧돼지, 코도, 말만 해. 하지만 이젠 뼈를 부러뜨리고 기름기를 씹는 것도 질렸어.\n\n생선을 원해. 불지느러미통돔 20마리 가져와. 매콤하고 신선한 걸로. 제대로 잡아 오면 짭짤하게 쳐주지.",
  },
  [28516] = {
    ["T"] = "위크타르의 의뢰",
    ["O"] =
    "위크타르는 당신의 낚시 숙련도를 사용해 표범메기 20마리를 모아 잿빛 골짜기의 조람가르 전초기지에 있는 위크타르에게 배달하길 원합니다.",
    ["D"] =
    "이봐, 이 숲 계곡에 표범메기라는 물고기가 산다며. 미끌거리고 영악한데다 옛 마법을 품고 있다고 들었어... 아니면 최소한 그런 맛이 나든가.\n\n표범메기 20마리 가져와 줄 수 있나? 그 이야기가 사실인지 내 두 눈으로 확인해 보고 싶어. 그리고 소문만큼 맛이 좋은지도.",
